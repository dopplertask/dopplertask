{
  "name": "poll-test",
  "label": "Poll test",
  "hosts": [
    "api.poll-test.example"
  ],
  "credential": {
    "fields": {
      "key": {
        "label": "Key",
        "secret": true
      }
    },
    "headers": {
      "Authorization": "Bearer {{credential.key}}"
    }
  },
  "actions": {
    "noop": {
      "label": "Nothing",
      "request": {
        "url": "https://api.poll-test.example/noop"
      }
    }
  },
  "triggers": {
    "new_order": {
      "label": "New order",
      "request": {
        "url": "https://api.poll-test.example/orders"
      },
      "items": "$.orders",
      "newBy": "time",
      "key": "$.created"
    },
    "new_contact": {
      "label": "New contact",
      "request": {
        "url": "https://api.poll-test.example/contacts"
      },
      "items": "$.data",
      "newBy": "lastItem",
      "key": "$.id"
    },
    "new_event": {
      "label": "New event",
      "inputs": {
        "list_id": {
          "label": "List"
        }
      },
      "webhook": {
        "subscribe": {
          "method": "POST",
          "url": "https://api.poll-test.example/hooks",
          "body": {
            "url": "{{webhookUrl}}",
            "list": "{{list_id}}"
          }
        },
        "id": "$.hook.id",
        "unsubscribe": {
          "method": "DELETE",
          "url": "https://api.poll-test.example/hooks/{{webhookId}}"
        }
      },
      "afterResponse": "return response.type === 'created' ? [response.data] : [];",
      "items": "$"
    }
  }
}
