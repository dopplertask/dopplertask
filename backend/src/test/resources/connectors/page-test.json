{
  "name": "page-test",
  "label": "Page test",
  "hosts": [
    "graph.page-test.example"
  ],
  "credential": {
    "fields": {
      "token": {
        "label": "Token",
        "secret": true
      }
    },
    "headers": {
      "Authorization": "Bearer {{credential.token}}"
    },
    "session": {
      "request": {
        "url": "https://graph.page-test.example/{{page}}",
        "query": {
          "fields": "access_token"
        }
      },
      "token": "$.access_token",
      "query": {
        "access_token": "{{session}}"
      }
    }
  },
  "lists": {
    "pages": {
      "request": {
        "url": "https://graph.page-test.example/me/accounts"
      },
      "items": "$.data",
      "label": "$.name",
      "value": "$.id"
    }
  },
  "actions": {
    "post": {
      "label": "Post",
      "inputs": {
        "page": {
          "label": "Page",
          "list": "pages"
        },
        "message": {
          "label": "Message"
        }
      },
      "request": {
        "method": "POST",
        "url": "https://graph.page-test.example/{{page}}/feed",
        "body": {
          "message": "{{message}}"
        }
      }
    }
  }
}
