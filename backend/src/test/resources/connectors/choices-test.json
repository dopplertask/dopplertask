{
  "name": "choices-test",
  "label": "Choices test",
  "hosts": ["api.choices-test.example"],
  "credential": { "fields": { "key": { "label": "Key", "secret": true } }, "headers": { "Authorization": "Bearer {{credential.key}}" } },
  "actions": {
    "send": {
      "label": "Send",
      "inputs": {
        "list_id": { "label": "List", "optionsFrom": { "request": { "url": "https://api.choices-test.example/lists" }, "list": "$.data", "label": "$.title", "value": "$.id" } }
      },
      "request": { "method": "POST", "url": "https://api.choices-test.example/lists/{{list_id}}/send" }
    }
  }
}
