{
  "name": "choices-test",
  "label": "Choices test",
  "hosts": [
    "api.choices-test.example"
  ],
  "credential": {
    "fields": {
      "key": {
        "label": "Key",
        "secret": true
      }
    },
    "headers": {
      "Authorization": "Bearer {{credential.key}}"
    }
  },
  "lists": {
    "lists": {
      "request": {
        "url": "https://api.choices-test.example/lists"
      },
      "items": "$.data",
      "label": "$.title",
      "value": "$.id"
    },
    "rows": {
      "request": {
        "url": "https://api.choices-test.example/lists/{{list_id}}/rows"
      },
      "items": "$.data",
      "label": "$.title",
      "value": "$.id"
    }
  },
  "actions": {
    "send": {
      "label": "Send",
      "inputs": {
        "list_id": {
          "label": "List",
          "list": "lists"
        },
        "row": {
          "label": "Row",
          "fieldsFrom": {
            "request": {
              "url": "https://api.choices-test.example/columns"
            },
            "list": "$.columns",
            "key": "$.id",
            "label": "$.title",
            "type": "$.kind",
            "types": {
              "num": "number",
              "text": "string"
            }
          }
        },
        "row_id": {
          "label": "Row",
          "list": "rows"
        }
      },
      "request": {
        "method": "POST",
        "url": "https://api.choices-test.example/lists/{{list_id}}/send"
      }
    }
  },
  "triggers": {
    "new_row": {
      "label": "New row",
      "inputs": {
        "list_id": {
          "label": "List",
          "list": "lists"
        }
      },
      "request": {
        "url": "https://api.choices-test.example/lists/{{list_id}}/rows"
      },
      "items": "$.data",
      "newBy": "lastItem",
      "key": "$.id"
    }
  }
}
