{
  "name": "wait-test",
  "label": "Wait test",
  "hosts": ["api.wait-test.example"],
  "actions": {
    "ask": {
      "label": "Ask for approval",
      "inputs": {"text": {"label": "Text", "required": true}},
      "request": {"method": "POST", "url": "https://api.wait-test.example/ask", "body": {"text": "{{text}}", "link": "{{resumeUrl}}/confirm"}},
      "afterResponse": "return {approved: false, asked: inputs.resumeUrl.length > 0};",
      "resume": "return {approved: received.query.action === 'approve', signedIn: 'cookie' in received.headers};",
      "outputs": {"approved": "$.approved", "signedIn": "$.signedIn"}
    }
  }
}
