{
  "name": "session-test",
  "label": "Session test",
  "hosts": [
    "api.session-test.example"
  ],
  "baseUrl": "https://api.session-test.example",
  "credential": {
    "fields": {
      "key": {
        "label": "Key",
        "secret": true
      },
      "user": {
        "label": "User"
      },
      "password": {
        "label": "Password",
        "secret": true
      }
    },
    "headers": {
      "X-Key": "{{credential.key}}"
    },
    "session": {
      "request": {
        "method": "POST",
        "url": "https://api.session-test.example/logon",
        "body": {
          "username": "{{credential.user}}",
          "password": "{{credential.password}}"
        }
      },
      "token": "$.token",
      "headers": {
        "Authorization": "Session {{session}}"
      }
    }
  },
  "actions": {
    "items": {
      "label": "Items",
      "request": {
        "url": "https://api.session-test.example/items"
      },
      "afterResponse": "return {first: response, more: call({url: '/more'}), seen: request.headers};"
    }
  },
  "triggers": {
    "new_item": {
      "label": "New item",
      "request": {
        "url": "https://api.session-test.example/items"
      },
      "items": "$.data",
      "newBy": "lastItem",
      "key": "$.id"
    }
  }
}
