{
  "name": "app-test",
  "label": "App test",
  "hosts": [
    "api.app-test.example"
  ],
  "credential": {
    "fields": {
      "token": {
        "label": "Token",
        "secret": true
      },
      "secret": {
        "label": "Signing secret",
        "secret": true
      }
    },
    "headers": {
      "Authorization": "Bearer {{credential.token}}"
    }
  },
  "events": {
    "reply": "return response.challenge ? response.challenge : null;",
    "event": "$.event.type",
    "identifier": "$.team_id",
    "signature": {
      "header": "x-signature",
      "key": "{{credential.secret}}",
      "text": "v0:{{headers.x-timestamp}}:{{text}}",
      "prefix": "v0="
    }
  },
  "actions": {
    "noop": {
      "label": "Nothing",
      "request": {
        "url": "https://api.app-test.example/noop"
      }
    }
  },
  "triggers": {
    "new_message": {
      "label": "New message",
      "webhook": {
        "app": true,
        "events": [
          "message"
        ],
        "subscribe": {
          "url": "https://api.app-test.example/auth.test"
        },
        "id": "$.team_id"
      },
      "afterResponse": "return [response.event];",
      "items": "$"
    }
  }
}
