{
  "name": "files-test",
  "label": "Files test",
  "hosts": [
    "api.files-test.example"
  ],
  "credential": {
    "fields": {
      "key": {
        "label": "Key",
        "secret": true
      }
    },
    "headers": {
      "Authorization": "Bearer {{credential.key}}"
    }
  },
  "actions": {
    "upload": {
      "label": "Upload",
      "inputs": {
        "document": {
          "label": "Document",
          "type": "file",
          "required": true
        },
        "title": {
          "label": "Title"
        }
      },
      "request": {
        "method": "POST",
        "url": "https://api.files-test.example/upload",
        "headers": {
          "Content-Type": "multipart/form-data"
        },
        "body": {
          "file": "{{document}}",
          "title": "{{title}}"
        }
      }
    },
    "attach": {
      "label": "Attach",
      "inputs": {
        "document": {
          "label": "Document",
          "type": "file",
          "required": true
        }
      },
      "request": {
        "method": "POST",
        "url": "https://api.files-test.example/attach",
        "body": {
          "content": "{{document}}"
        }
      }
    },
    "download": {
      "label": "Download",
      "inputs": {
        "fileName": {
          "label": "Keep as",
          "defaultValue": "report.pdf"
        }
      },
      "request": {
        "method": "GET",
        "url": "https://api.files-test.example/report"
      },
      "download": "{{fileName}}"
    },
    "replace": {
      "label": "Replace content",
      "inputs": {
        "document": {
          "label": "Document",
          "type": "file",
          "required": true
        }
      },
      "request": {
        "method": "PUT",
        "url": "https://api.files-test.example/content",
        "body": "{{document}}"
      }
    },
    "upload_related": {
      "label": "Upload with metadata",
      "inputs": {
        "document": {
          "label": "Document",
          "type": "file",
          "required": true
        },
        "title": {
          "label": "Title"
        }
      },
      "request": {
        "method": "POST",
        "url": "https://api.files-test.example/related",
        "headers": {
          "Content-Type": "multipart/related"
        },
        "body": {
          "metadata": {
            "name": "{{title}}"
          },
          "media": "{{document}}"
        }
      }
    },
    "send_csv": {
      "label": "Send CSV",
      "inputs": {
        "rows": {
          "label": "Rows",
          "type": "multiline"
        }
      },
      "request": {
        "method": "PUT",
        "url": "https://api.files-test.example/csv",
        "headers": {
          "Content-Type": "text/csv"
        },
        "body": "{{rows}}"
      }
    },
    "read_csv": {
      "label": "Read CSV",
      "request": {
        "url": "https://api.files-test.example/report.csv"
      },
      "afterResponse": "return {status: received.status, csv: response};"
    },
    "attachment": {
      "label": "Attachment",
      "request": {
        "url": "https://api.files-test.example/attachment"
      },
      "afterResponse": "return {file: keepFile('scan.pdf', response.data)};"
    }
  }
}
