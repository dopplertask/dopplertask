{
  "name": "files-test",
  "label": "Files test",
  "hosts": ["api.files-test.example"],
  "credential": { "fields": { "key": { "label": "Key", "secret": true } }, "headers": { "Authorization": "Bearer {{credential.key}}" } },
  "actions": {
    "upload": {
      "label": "Upload",
      "inputs": { "document": { "label": "Document", "type": "file", "required": true }, "title": { "label": "Title" } },
      "request": { "method": "POST", "url": "https://api.files-test.example/upload", "headers": { "Content-Type": "multipart/form-data" }, "body": { "file": "{{document}}", "title": "{{title}}" } }
    },
    "attach": {
      "label": "Attach",
      "inputs": { "document": { "label": "Document", "type": "file", "required": true } },
      "request": { "method": "POST", "url": "https://api.files-test.example/attach", "body": { "content": "{{document}}" } }
    },
    "download": {
      "label": "Download",
      "inputs": { "fileName": { "label": "Keep as", "defaultValue": "report.pdf" } },
      "request": { "method": "GET", "url": "https://api.files-test.example/report" },
      "download": "{{fileName}}"
    }
  }
}
