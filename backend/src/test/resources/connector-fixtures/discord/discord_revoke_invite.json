{
  "package": "@activepieces/piece-discord",
  "version": "0.8.5",
  "action": "discord_revoke_invite",
  "auth": {
    "type": "SECRET_TEXT",
    "secret_text": "discord-test-token"
  },
  "inputs": {
    "invite_code": "abc"
  },
  "credential": {
    "token": "discord-test-token"
  },
  "answers": [
    {
      "status": 200,
      "body": {
        "code": "abc"
      }
    }
  ],
  "exchanges": [
    {
      "request": {
        "method": "DELETE",
        "url": "https://discord.com/api/v9/invites/abc",
        "headers": {
          "authorization": "Bot discord-test-token",
          "content-type": "application/json"
        },
        "body": null
      }
    }
  ],
  "output": {
    "success": true,
    "code": "abc"
  }
}
