{
  "package": "@activepieces/piece-discord",
  "version": "0.8.5",
  "action": "discord_create_dm",
  "auth": {
    "type": "SECRET_TEXT",
    "secret_text": "discord-test-token"
  },
  "inputs": {
    "user_id": "333333333333333333"
  },
  "credential": {
    "token": "discord-test-token"
  },
  "answers": [
    {
      "status": 200,
      "body": {
        "id": "999999999999999999",
        "type": 1
      }
