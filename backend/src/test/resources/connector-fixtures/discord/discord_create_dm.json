  ],
  "exchanges": [
    {
      "request": {
        "method": "POST",
        "url": "https://discord.com/api/v9/users/@me/channels",
        "headers": {
          "authorization": "Bot discord-test-token",
          "content-type": "application/json"
        },
        "body": {
          "recipient_id": "333333333333333333"
        }
      }
    }
  ],
  "output": {
    "success": true,
    "channel_id": "999999999999999999"
  }
