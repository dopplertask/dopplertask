{
  "package": "@activepieces/piece-discord",
  "version": "0.8.5",
  "action": "discord_create_thread_from_message",
  "auth": {
    "type": "SECRET_TEXT",
    "secret_text": "discord-test-token"
  },
  "inputs": {
    "channel_id": "222222222222222222",
    "message_id": "555555555555555555",
    "name": "Follow-up",
    "auto_archive_duration": 60
  },
  "credential": {
    "token": "discord-test-token"
  },
  "answers": [
    {
      "status": 201,
      "body": {
        "id": "888888888888888888",
        "name": "Follow-up"
      }
    }
  ],
  "exchanges": [
    {
      "request": {
        "method": "POST",
        "url": "https://discord.com/api/v9/channels/222222222222222222/messages/555555555555555555/threads",
        "headers": {
          "authorization": "Bot discord-test-token",
          "content-type": "application/json"
        },
        "body": {
          "name": "Follow-up",
          "auto_archive_duration": 60
        }
      }
    }
  ],
  "output": {
    "success": true,
    "thread": {
      "id": "888888888888888888",
      "name": "Follow-up"
    }
  }
