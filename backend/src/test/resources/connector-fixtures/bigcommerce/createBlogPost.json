{
  "package": "@activepieces/piece-bigcommerce",
  "version": "0.2.2",
  "action": "createBlogPost",
  "auth": {
    "type": "CUSTOM_AUTH",
    "props": {
      "storeHash": "abcd1234",
      "accessToken": "test-token"
    }
  },
  "inputs": {
    "title": "Welcome",
    "body": "<p>Hello</p>",
    "author": "Jane",
    "url": "/blog/welcome/",
    "published_date": "2026-01-10T15:39:15.000Z",
    "meta_description": "Intro post",
    "meta_keywords": "welcome,store",
    "tags": [
      "news",
      "intro"
    ],
    "is_published": true
  },
  "credential": {
    "storeHash": "abcd1234",
    "accessToken": "test-token"
  },
  "answers": [
    {
      "status": 200,
      "body": {
        "id": 9,
        "title": "Welcome",
        "url": "/blog/welcome/",
        "author": "Jane",
        "tags": [
          "news",
          "intro"
        ],
        "is_published": true
      }
    }
  ],
  "exchanges": [
    {
      "request": {
        "method": "POST",
        "url": "https://api.bigcommerce.com/stores/abcd1234/v2/blog/posts",
        "headers": {
          "content-type": "application/json",
          "x-auth-token": "test-token"
        },
        "body": {
          "title": "Welcome",
          "body": "<p>Hello</p>",
          "author": "Jane",
          "tags": [
            "news",
            "intro"
          ],
          "is_published": true,
          "meta_description": "Intro post",
          "meta_keywords": "welcome,store",
          "published_date": "2026-01-10T15:39:15.000Z",
          "url": "/blog/welcome/"
        }
      }
    }
  ],
  "output": {
    "id": 9,
    "title": "Welcome",
    "url": "/blog/welcome/",
    "author": "Jane",
    "tags": [
      "news",
      "intro"
    ],
    "is_published": true
  }
}
