{
  "package": "@activepieces/piece-calendly",
  "version": "0.7.2",
  "trigger": "invitee_canceled",
  "webhook": true,
  "auth": {
    "type": "SECRET_TEXT",
    "secret_text": "cal-test-token"
  },
  "inputs": {
    "scope": "user"
  },
  "credential": {
    "token": "cal-test-token"
  },
  "answers": [
    {
      "status": 200,
      "body": {
        "resource": {
          "uri": "https://api.calendly.com/users/U1",
          "current_organization": "https://api.calendly.com/organizations/O1"
        }
      }
    },
    {
      "status": 201,
      "body": {
        "resource": {
          "uri": "https://api.calendly.com/webhook_subscriptions/W1"
        }
      }
    }
  ],
  "event": {
    "event": "invitee.canceled",
    "created_at": "2026-01-03T10:00:00.000000Z",
    "payload": {
      "email": "ada@example.com",
      "name": "Ada",
      "status": "canceled",
      "cancellation": {
        "canceler_type": "invitee",
        "canceled_by": "Ada",
        "reason": "Conflict"
      }
    }
  },
  "exchanges": [
    {
      "request": {
        "method": "GET",
        "url": "https://api.calendly.com/users/me",
        "headers": {
          "authorization": "Bearer cal-test-token"
        },
        "body": null
      }
    },
    {
      "request": {
        "method": "POST",
        "url": "https://api.calendly.com/webhook_subscriptions",
        "headers": {
          "authorization": "Bearer cal-test-token",
          "content-type": "application/json"
        },
        "body": {
          "url": "https://tasks.example.com/hooks/test-key",
          "organization": "https://api.calendly.com/organizations/O1",
          "user": "https://api.calendly.com/users/U1",
          "scope": "user",
          "events": [
            "invitee.canceled"
          ]
        }
      }
    }
  ],
  "output": [
    {
      "event": "invitee.canceled",
      "created_at": "2026-01-03T10:00:00.000000Z",
      "payload": {
        "email": "ada@example.com",
        "name": "Ada",
        "status": "canceled",
        "cancellation": {
          "canceler_type": "invitee",
          "canceled_by": "Ada",
          "reason": "Conflict"
        }
      }
    }
  ]
}
