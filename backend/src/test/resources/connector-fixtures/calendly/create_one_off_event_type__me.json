        "body": {
          "name": "Chat",
          "host": "https://api.calendly.com/users/u-1",
          "duration": 30,
          "date_setting": {
            "type": "date_range",
            "start_date": "2027-01-01",
            "end_date": "2027-01-05"
          }
        }
      }
    }
  ],
  "output": {
    "uri": "https://api.calendly.com/r/1",
    "name": "N"
  }
