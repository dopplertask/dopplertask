  "action": "create_one_off_event_type",
  "inputs": {
    "name": "Chat",
    "duration": 30,
    "startDate": "2027-01-01",
    "endDate": "2027-01-05"
  },
  "credential": {
    "token": "test-key"
  },
  "answers": [
    {
      "status": 200,
      "body": {
        "resource": {
          "uri": "https://api.calendly.com/users/u-1",
          "current_organization": "https://api.calendly.com/organizations/o-1"
        }
      }
    },
    {
      "status": 200,
      "body": {
        "resource": {
          "uri": "https://api.calendly.com/r/1",
          "name": "N"
        }
      }
    }
  ],
  "exchanges": [
    {
      "request": {
        "method": "GET",
        "url": "https://api.calendly.com/users/me",
        "headers": {
          "authorization": "Bearer test-key"
        },
        "body": null
      }
    },
    {
      "request": {
        "method": "POST",
        "url": "https://api.calendly.com/one_off_event_types",
        "headers": {
          "authorization": "Bearer test-key",
          "content-type": "application/json"
