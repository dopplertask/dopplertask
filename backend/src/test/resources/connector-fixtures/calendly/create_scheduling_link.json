{
  "package": "@activepieces/piece-calendly",
  "version": "0.7.2",
  "action": "create_scheduling_link",
  "auth": {
    "type": "SECRET_TEXT",
    "secret_text": "test-key"
  },
  "inputs": {
    "eventType": "et-1"
  },
  "credential": {
    "token": "test-key"
  },
  "answers": [
    {
      "status": 200,
      "body": {
        "resource": {
          "booking_url": "https://calendly.com/d/abc-123/intro-call",
