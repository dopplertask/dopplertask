        "headers": {
          "authorization": "Basic Y2tfdGVzdDpjc190ZXN0",
          "content-type": "application/json"
        },
        "body": {
          "note": "Packed and ready",
          "customer_note": true
        }
      }
    }
  ],
  "output": {
    "id": 7,
    "note": "Packed and ready",
    "customer_note": true
  }
