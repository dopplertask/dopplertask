    "type": "CUSTOM_AUTH",
    "props": {
      "baseUrl": "https://shop.example.com",
      "consumerKey": "ck_test",
      "consumerSecret": "cs_test"
    }
  },
  "inputs": {
    "id": "42",
    "note": "Packed and ready",
