{
  "package": "@activepieces/piece-woocommerce",
  "version": "0.5.1",
  "trigger": "$woocommerce_trigger_order_deleted",
  "webhook": true,
  "auth": {
    "type": "CUSTOM_AUTH",
    "props": {
      "baseUrl": "https://shop.example.com",
      "consumerKey": "ck_test",
      "consumerSecret": "cs_test"
    }
  },
  "inputs": {},
  "credential": {
    "baseUrl": "https://shop.example.com",
    "consumerKey": "ck_test",
    "consumerSecret": "cs_test"
  },
  "answers": [
    {
      "status": 201,
      "body": {
        "id": 9,
        "name": "Order Deleted",
        "status": "active",
        "topic": "order.deleted",
        "delivery_url": "https://tasks.example.com/hooks/test-key"
      }
    },
    {
      "status": 200,
      "body": {
        "id": 17,
        "status": "trash",
        "total": "2.00",
        "currency": "USD"
      }
    }
  ],
  "event": {
    "id": 17
  },
  "exchanges": [
    {
      "request": {
        "method": "POST",
        "url": "https://shop.example.com/wp-json/wc/v3/webhooks",
        "headers": {
          "authorization": "Basic Y2tfdGVzdDpjc190ZXN0",
          "content-type": "application/json"
        },
        "body": {
          "name": "Order Deleted",
          "topic": "order.deleted",
          "delivery_url": "https://tasks.example.com/hooks/test-key"
        }
      }
    },
    {
      "request": {
        "method": "GET",
        "url": "https://shop.example.com/wp-json/wc/v3/orders/17?per_page=10",
        "headers": {
          "authorization": "Basic Y2tfdGVzdDpjc190ZXN0"
        },
        "body": null
      }
    }
  ],
  "output": [
    {
      "id": 17,
      "status": "trash",
      "total": "2.00",
      "currency": "USD"
    }
  ]
}
