{
  "package": "@activepieces/piece-woocommerce",
  "version": "0.5.1",
  "action": "list_product_reviews",
  "auth": {
    "type": "CUSTOM_AUTH",
    "props": {
      "baseUrl": "https://shop.example.com",
      "consumerKey": "ck_test",
      "consumerSecret": "cs_test"
    }
  },
  "inputs": {
    "product_id": 11,
    "status": "hold",
    "reviewer_email": "ada@example.com",
    "search": "great",
    "page": 1,
    "per_page": 10
  },
  "credential": {
    "baseUrl": "https://shop.example.com",
    "consumerKey": "ck_test",
    "consumerSecret": "cs_test"
  },
  "answers": [
    {
      "status": 200,
      "body": [
        {
          "id": 5
        }
      ]
    }
  ],
  "exchanges": [
    {
      "request": {
        "method": "GET",
        "url": "https://shop.example.com/wp-json/wc/v3/products/reviews?product=11&status=hold&reviewer_email=ada%40example.com&search=great&page=1&per_page=10",
        "headers": {
          "authorization": "Basic Y2tfdGVzdDpjc190ZXN0"
        },
        "body": null
      }
    }
  ],
  "output": [
    {
      "id": 5
    }
  ]
}
