{
  "package": "@activepieces/piece-woocommerce",
  "version": "0.5.1",
  "action": "update_product_review",
  "auth": {
    "type": "CUSTOM_AUTH",
    "props": {
      "baseUrl": "https://shop.example.com",
      "consumerKey": "ck_test",
      "consumerSecret": "cs_test"
    }
  },
  "inputs": {
    "review_id": 5,
    "status": "approved"
  },
  "credential": {
    "baseUrl": "https://shop.example.com",
    "consumerKey": "ck_test",
    "consumerSecret": "cs_test"
  },
  "answers": [
    {
      "status": 200,
      "body": {
        "id": 5,
        "status": "approved"
      }
    }
  ],
  "exchanges": [
    {
      "request": {
        "method": "PUT",
        "url": "https://shop.example.com/wp-json/wc/v3/products/reviews/5",
        "headers": {
          "authorization": "Basic Y2tfdGVzdDpjc190ZXN0",
          "content-type": "application/json"
        },
        "body": {
          "status": "approved"
        }
      }
    }
  ],
  "output": {
    "id": 5,
    "status": "approved"
  }
}
