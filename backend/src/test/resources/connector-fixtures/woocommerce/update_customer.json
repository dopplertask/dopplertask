{
  "package": "@activepieces/piece-woocommerce",
  "version": "0.5.1",
  "action": "update_customer",
  "auth": {
    "type": "CUSTOM_AUTH",
    "props": {
      "baseUrl": "https://shop.example.com",
      "consumerKey": "ck_test",
      "consumerSecret": "cs_test"
    }
  },
  "inputs": {
    "id": "25",
    "email": "ada@example.org",
    "first_name": "Ada",
    "last_name": "King",
    "city": "Paris",
    "postcode": "75001",
    "country": "FR",
    "phone": "+33 1 00 00 00 00"
  },
  "credential": {
    "baseUrl": "https://shop.example.com",
    "consumerKey": "ck_test",
    "consumerSecret": "cs_test"
  },
  "answers": [
    {
      "status": 200,
      "body": {
        "id": 25
      }
    }
  ],
  "exchanges": [
    {
      "request": {
        "method": "PUT",
        "url": "https://shop.example.com/wp-json/wc/v3/customers/25",
        "headers": {
          "authorization": "Basic Y2tfdGVzdDpjc190ZXN0",
          "content-type": "application/json"
        },
        "body": {
          "email": "ada@example.org",
          "first_name": "Ada",
          "last_name": "King",
          "billing": {
            "phone": "+33 1 00 00 00 00",
            "city": "Paris",
            "postcode": "75001",
            "country": "FR"
          }
        }
      }
    }
  ],
  "output": {
    "id": 25
  }
}
