{
  "package": "@activepieces/piece-woocommerce",
  "version": "0.5.1",
  "trigger": "$woocommerce_trigger_coupon_deleted",
  "webhook": true,
  "auth": {
    "type": "CUSTOM_AUTH",
    "props": {
      "baseUrl": "https://shop.example.com",
      "consumerKey": "ck_test",
      "consumerSecret": "cs_test"
    }
  },
  "inputs": {},
  "credential": {
    "baseUrl": "https://shop.example.com",
    "consumerKey": "ck_test",
    "consumerSecret": "cs_test"
  },
  "answers": [
    {
      "status": 201,
      "body": {
        "id": 9,
        "name": "Coupon Deleted",
        "status": "active",
        "topic": "coupon.deleted",
        "delivery_url": "https://tasks.example.com/hooks/test-key"
      }
    },
    {
      "status": 404,
      "body": {
        "code": "woocommerce_rest_invalid_id",
        "message": "Invalid ID.",
        "data": {
          "status": 404
        }
      }
    }
  ],
  "event": {
    "id": 22
  },
  "exchanges": [
    {
      "request": {
        "method": "POST",
        "url": "https://shop.example.com/wp-json/wc/v3/webhooks",
        "headers": {
          "authorization": "Basic Y2tfdGVzdDpjc190ZXN0",
          "content-type": "application/json"
        },
        "body": {
          "name": "Coupon Deleted",
          "topic": "coupon.deleted",
          "delivery_url": "https://tasks.example.com/hooks/test-key"
        }
      }
    },
    {
      "request": {
        "method": "GET",
        "url": "https://shop.example.com/wp-json/wc/v3/coupons/22?per_page=10",
        "headers": {
          "authorization": "Basic Y2tfdGVzdDpjc190ZXN0"
        },
        "body": null
      }
    }
  ],
  "output": [
    {
      "id": 22
    }
  ]
}
