{
  "package": "@activepieces/piece-woocommerce",
  "version": "0.5.1",
  "action": "create_order",
  "auth": {
    "type": "CUSTOM_AUTH",
    "props": {
      "baseUrl": "https://shop.example.com",
      "consumerKey": "ck_test",
      "consumerSecret": "cs_test"
    }
  },
  "inputs": {
    "line_items": [
      {
        "product_id": "11",
        "quantity": 2
      },
      {
        "product_id": "12",
        "quantity": "1"
      }
    ],
    "customer_id": "25",
    "status": "processing",
    "billing_email": "ada@example.com",
    "payment_method": "bacs",
    "payment_method_title": "Direct bank transfer"
  },
  "credential": {
    "baseUrl": "https://shop.example.com",
    "consumerKey": "ck_test",
    "consumerSecret": "cs_test"
  },
  "answers": [
    {
      "status": 201,
      "body": {
        "id": 42,
        "status": "processing"
      }
    }
  ],
  "exchanges": [
    {
      "request": {
        "method": "POST",
        "url": "https://shop.example.com/wp-json/wc/v3/orders",
        "headers": {
          "authorization": "Basic Y2tfdGVzdDpjc190ZXN0",
          "content-type": "application/json"
        },
        "body": {
          "line_items": [
            {
              "product_id": 11,
              "quantity": 2
            },
            {
              "product_id": 12,
              "quantity": 1
            }
          ],
          "customer_id": 25,
          "status": "processing",
          "billing": {
            "email": "ada@example.com"
          },
          "payment_method": "bacs",
          "payment_method_title": "Direct bank transfer"
        }
      }
    }
  ],
  "output": {
    "id": 42,
    "status": "processing"
  }
}
