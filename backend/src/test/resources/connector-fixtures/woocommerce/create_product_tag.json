{
  "package": "@activepieces/piece-woocommerce",
  "version": "0.5.1",
  "action": "create_product_tag",
  "auth": {
    "type": "CUSTOM_AUTH",
    "props": {
      "baseUrl": "https://shop.example.com",
      "consumerKey": "ck_test",
      "consumerSecret": "cs_test"
    }
  },
  "inputs": {
    "name": "Gift",
    "slug": "gift",
    "description": "Gift ideas"
  },
  "credential": {
    "baseUrl": "https://shop.example.com",
    "consumerKey": "ck_test",
    "consumerSecret": "cs_test"
  },
  "answers": [
    {
      "status": 201,
      "body": {
        "id": 3,
        "name": "Gift"
      }
    }
  ],
  "exchanges": [
    {
      "request": {
        "method": "POST",
        "url": "https://shop.example.com/wp-json/wc/v3/products/tags",
        "headers": {
          "authorization": "Basic Y2tfdGVzdDpjc190ZXN0",
          "content-type": "application/json"
        },
        "body": {
          "name": "Gift",
          "slug": "gift",
          "description": "Gift ideas"
        }
      }
    }
  ],
  "output": {
    "id": 3,
    "name": "Gift"
  }
}
