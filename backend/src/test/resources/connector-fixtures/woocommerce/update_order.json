{
  "package": "@activepieces/piece-woocommerce",
  "version": "0.5.1",
  "action": "update_order",
  "auth": {
    "type": "CUSTOM_AUTH",
    "props": {
      "baseUrl": "https://shop.example.com",
      "consumerKey": "ck_test",
      "consumerSecret": "cs_test"
    }
  },
  "inputs": {
    "id": "42",
    "status": "completed",
    "customer_note": "Leave at door",
    "transaction_id": "txn-123"
  },
