{
  "package": "@activepieces/piece-woocommerce",
  "version": "0.5.1",
  "trigger": "$woocommerce_trigger_customer_deleted",
  "webhook": true,
  "auth": {
    "type": "CUSTOM_AUTH",
    "props": {
      "baseUrl": "https://shop.example.com",
      "consumerKey": "ck_test",
      "consumerSecret": "cs_test"
    }
  },
  "inputs": {},
  "credential": {
    "baseUrl": "https://shop.example.com",
    "consumerKey": "ck_test",
    "consumerSecret": "cs_test"
  },
  "answers": [
    {
      "status": 201,
      "body": {
        "id": 9,
        "name": "Customer Deleted",
        "status": "active",
        "topic": "customer.deleted",
        "delivery_url": "https://tasks.example.com/hooks/test-key"
      }
    },
    {
      "status": 200,
      "body": {
        "id": 1,
        "email": "buyer@example.com",
        "first_name": "First",
        "last_name": "Last"
      }
    }
  ],
  "event": {
    "id": 1
  },
  "exchanges": [
    {
      "request": {
        "method": "POST",
        "url": "https://shop.example.com/wp-json/wc/v3/webhooks",
        "headers": {
          "authorization": "Basic Y2tfdGVzdDpjc190ZXN0",
          "content-type": "application/json"
        },
        "body": {
          "name": "Customer Deleted",
          "topic": "customer.deleted",
          "delivery_url": "https://tasks.example.com/hooks/test-key"
        }
      }
    },
    {
      "request": {
        "method": "GET",
        "url": "https://shop.example.com/wp-json/wc/v3/customers/1?per_page=10",
        "headers": {
          "authorization": "Basic Y2tfdGVzdDpjc190ZXN0"
        },
        "body": null
      }
    }
  ],
  "output": [
    {
      "id": 1,
      "email": "buyer@example.com",
      "first_name": "First",
      "last_name": "Last"
    }
  ]
}
