{
  "package": "@activepieces/piece-woocommerce",
  "version": "0.5.1",
  "action": "create_order_refund",
  "auth": {
    "type": "CUSTOM_AUTH",
    "props": {
      "baseUrl": "https://shop.example.com",
      "consumerKey": "ck_test",
      "consumerSecret": "cs_test"
    }
  },
  "inputs": {
    "order_id": 42,
    "amount": " 10.00 ",
    "reason": "Damaged",
    "refund_via_gateway": true
  },
  "credential": {
    "baseUrl": "https://shop.example.com",
    "consumerKey": "ck_test",
    "consumerSecret": "cs_test"
  },
  "answers": [
    {
      "status": 201,
      "body": {
        "id": 90,
        "amount": "10.00"
      }
    }
  ],
  "exchanges": [
    {
      "request": {
        "method": "POST",
        "url": "https://shop.example.com/wp-json/wc/v3/orders/42/refunds",
        "headers": {
          "authorization": "Basic Y2tfdGVzdDpjc190ZXN0",
          "content-type": "application/json"
        },
        "body": {
          "amount": "10.00",
          "reason": "Damaged",
          "api_refund": true
        }
      }
    }
  ],
  "output": {
    "id": 90,
    "amount": "10.00"
  }
}
