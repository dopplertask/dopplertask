{
  "package": "@activepieces/piece-woocommerce",
  "version": "0.5.1",
  "action": "create_product_category",
  "auth": {
    "type": "CUSTOM_AUTH",
    "props": {
      "baseUrl": "https://shop.example.com",
      "consumerKey": "ck_test",
      "consumerSecret": "cs_test"
    }
  },
  "inputs": {
    "name": "Mugs",
    "parent_id": 15,
    "slug": " mugs ",
    "description": "All mugs"
  },
  "credential": {
    "baseUrl": "https://shop.example.com",
    "consumerKey": "ck_test",
    "consumerSecret": "cs_test"
  },
  "answers": [
    {
      "status": 201,
      "body": {
        "id": 16,
        "name": "Mugs"
      }
    }
  ],
  "exchanges": [
    {
      "request": {
        "method": "POST",
        "url": "https://shop.example.com/wp-json/wc/v3/products/categories",
        "headers": {
          "authorization": "Basic Y2tfdGVzdDpjc190ZXN0",
          "content-type": "application/json"
        },
        "body": {
          "name": "Mugs",
          "parent": 15,
          "slug": "mugs",
          "description": "All mugs"
        }
      }
    }
  ],
  "output": {
    "id": 16,
    "name": "Mugs"
  }
}
