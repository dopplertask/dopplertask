{
  "package": "@activepieces/piece-woocommerce",
  "version": "0.5.1",
  "trigger": "$woocommerce_trigger_product_deleted",
  "webhook": true,
  "auth": {
    "type": "CUSTOM_AUTH",
    "props": {
      "baseUrl": "https://shop.example.com",
      "consumerKey": "ck_test",
      "consumerSecret": "cs_test"
    }
  },
  "inputs": {},
  "credential": {
    "baseUrl": "https://shop.example.com",
    "consumerKey": "ck_test",
    "consumerSecret": "cs_test"
  },
  "answers": [
    {
      "status": 201,
      "body": {
        "id": 9,
        "name": "Product Deleted",
        "status": "active",
        "topic": "product.deleted",
        "delivery_url": "https://tasks.example.com/hooks/test-key"
      }
    },
    {
      "status": 200,
      "body": {
        "id": 20,
        "name": "My Product",
        "status": "trash",
        "date_created": "2026-01-02T10:00:00"
      }
    }
  ],
  "event": {
    "id": 20
  },
  "exchanges": [
    {
      "request": {
        "method": "POST",
        "url": "https://shop.example.com/wp-json/wc/v3/webhooks",
        "headers": {
          "authorization": "Basic Y2tfdGVzdDpjc190ZXN0",
          "content-type": "application/json"
        },
        "body": {
          "name": "Product Deleted",
          "topic": "product.deleted",
          "delivery_url": "https://tasks.example.com/hooks/test-key"
        }
      }
    },
    {
      "request": {
        "method": "GET",
        "url": "https://shop.example.com/wp-json/wc/v3/products/20?per_page=10",
        "headers": {
          "authorization": "Basic Y2tfdGVzdDpjc190ZXN0"
        },
        "body": null
      }
    }
  ],
  "output": [
    {
      "id": 20,
      "name": "My Product",
      "status": "trash",
      "date_created": "2026-01-02T10:00:00"
    }
  ]
}
