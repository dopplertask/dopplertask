{
  "package": "@activepieces/piece-woocommerce",
  "version": "0.5.1",
  "action": "batch_update_products",
  "auth": {
    "type": "CUSTOM_AUTH",
    "props": {
      "baseUrl": "https://shop.example.com",
      "consumerKey": "ck_test",
      "consumerSecret": "cs_test"
    }
  },
  "inputs": {
    "updates": [
      {
        "id": 11,
        "regular_price": "19.99",
        "sale_price": " 14.99 ",
        "stock_quantity": 5,
        "status": "publish"
      },
      {
        "id": "12",
        "sale_price": "9.50",
        "stock_quantity": ""
      }
    ]
  },
  "credential": {
    "baseUrl": "https://shop.example.com",
    "consumerKey": "ck_test",
    "consumerSecret": "cs_test"
  },
  "answers": [
    {
      "status": 200,
      "body": {
        "update": [
          {
            "id": 11
          },
          {
            "id": 12
          }
        ]
      }
    }
  ],
  "exchanges": [
    {
      "request": {
        "method": "POST",
        "url": "https://shop.example.com/wp-json/wc/v3/products/batch",
        "headers": {
          "authorization": "Basic Y2tfdGVzdDpjc190ZXN0",
          "content-type": "application/json"
        },
        "body": {
          "update": [
            {
              "id": 11,
              "regular_price": "19.99",
              "sale_price": "14.99",
              "manage_stock": true,
              "stock_quantity": 5,
              "status": "publish"
            },
            {
              "id": 12,
              "sale_price": "9.50"
            }
          ]
        }
      }
    }
  ],
  "output": {
    "update": [
      {
        "id": 11
      },
      {
        "id": 12
      }
    ]
  }
}
