{
  "package": "@activepieces/piece-invoiceninja",
  "version": "0.5.3",
  "action": "convert_quote_to_invoice",
  "auth": {
    "type": "CUSTOM_AUTH",
    "props": {
      "base_url": "https://credential000z.example.com",
      "access_token": "credential001z"
    }
  },
  "inputs": {
    "id": "sample000z"
  },
  "credential": {
    "base_url": "credential000z.example.com",
    "access_token": "credential001z"
  },
  "answers": [
    {
      "status": 200,
      "body": {}
    }
  ],
  "exchanges": [
    {
      "request": {
        "method": "POST",
        "url": "https://credential000z.example.com/api/v1/quotes/bulk",
        "headers": {
          "content-type": "application/json",
          "x-api-token": "credential001z",
          "x-requested-with": "XMLHttpRequest"
        },
        "body": {
          "action": "convert_to_invoice",
          "ids": [
            "sample000z"
          ]
        }
      }
    }
  ],
  "output": {
    "error": "Invoice Ninja did not return the quote sample000z; it may not exist or the action does not apply to it."
  }
}
