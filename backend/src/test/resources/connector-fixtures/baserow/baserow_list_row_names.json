        "headers": {
          "authorization": "Token test-key"
        },
        "body": null
      }
    }
  ],
  "output": {
    "rows": [
      {
        "id": 7,
        "name": "Acme"
      },
      {
        "id": 8,
        "name": "Globex"
      }
    ]
