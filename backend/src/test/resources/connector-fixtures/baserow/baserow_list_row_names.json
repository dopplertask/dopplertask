{
  "package": "@activepieces/piece-baserow",
  "version": "0.12.3",
  "action": "baserow_list_row_names",
  "auth": {
    "type": "CUSTOM_AUTH",
    "props": {
      "authType": "database_token",
      "apiUrl": "https://api.baserow.io",
      "token": "test-key"
    }
  },
  "inputs": {
    "table_id": 12,
    "row_ids": [
      7,
      8
    ]
  },
  "credential": {
    "apiUrl": "api.baserow.io",
    "token": "test-key"
  },
  "answers": [
