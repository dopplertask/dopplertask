{
  "package": "@activepieces/piece-baserow",
  "version": "0.12.3",
  "action": "baserow_upload_file",
  "auth": {
    "type": "CUSTOM_AUTH",
    "props": {
      "authType": "database_token",
      "apiUrl": "https://api.baserow.io",
      "token": "test-key"
    }
  },
  "inputs": {
    "url": "https://example.com/invoice.pdf"
  },
  "credential": {
    "apiUrl": "api.baserow.io",
    "token": "test-key"
  },
  "answers": [
    {
      "status": 200,
      "body": {
        "url": "https://files.baserow.io/user_files/abc_invoice.pdf",
        "thumbnails": {},
        "name": "abc_invoice.pdf",
        "size": 1024,
        "mime_type": "application/pdf",
        "is_image": false,
        "image_width": null,
        "image_height": null,
        "uploaded_at": "2026-01-31T14:30:00Z",
        "original_name": "invoice.pdf"
      }
    }
  ],
  "exchanges": [
    {
      "request": {
        "method": "POST",
        "url": "https://api.baserow.io/api/user-files/upload-via-url/",
        "headers": {
          "authorization": "Token test-key",
          "content-type": "application/json"
        },
        "body": {
          "url": "https://example.com/invoice.pdf"
        }
      }
    }
  ],
  "output": {
    "url": "https://files.baserow.io/user_files/abc_invoice.pdf",
    "thumbnails": {},
    "name": "abc_invoice.pdf",
    "size": 1024,
    "mime_type": "application/pdf",
    "is_image": false,
    "image_width": null,
    "image_height": null,
    "uploaded_at": "2026-01-31T14:30:00Z",
    "original_name": "invoice.pdf"
  }
}
