{
  "package": "@activepieces/piece-ninety",
  "version": "0.1.2",
  "action": "update_rock",
  "auth": {
    "type": "SECRET_TEXT",
    "secret_text": "test-key"
  },
  "inputs": {
    "rockId": "rock-1",
    "additionalTeamIds": [
      "team-3"
    ],
    "clearAdditionalTeams": true,
    "archived": "any"
  },
  "credential": {
    "token": "test-key"
  },
  "answers": [
    {
      "status": 200,
      "body": {
        "_id": "rock-1",
        "title": "Cut onboarding time to 14 days",
        "teamId": "team-1"
      }
    }
  ],
  "exchanges": [
    {
      "request": {
        "method": "PATCH",
        "url": "https://api.public.ninety.io/v1/rocks/rock-1",
        "headers": {
          "authorization": "Bearer test-key",
          "content-type": "application/json"
        },
        "body": {
          "additionalTeamIds": []
        }
      }
    }
  ],
  "output": {
    "_id": "rock-1",
    "title": "Cut onboarding time to 14 days",
    "teamId": "team-1"
  }
}
