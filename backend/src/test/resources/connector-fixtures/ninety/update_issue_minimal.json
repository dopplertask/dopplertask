{
  "package": "@activepieces/piece-ninety",
  "version": "0.1.2",
  "action": "update_issue",
  "auth": {
    "type": "SECRET_TEXT",
    "secret_text": "test-key"
  },
  "inputs": {
    "issueId": "issue-1",
    "completed": "no",
    "priority": "0"
  },
  "credential": {
    "token": "test-key"
  },
  "answers": [
    {
      "status": 200,
      "body": {
        "_id": "issue-1"
      }
    }
  ],
  "exchanges": [
    {
      "request": {
        "method": "PATCH",
        "url": "https://api.public.ninety.io/v1/issues/issue-1",
        "headers": {
          "authorization": "Bearer test-key",
          "content-type": "application/json"
        },
        "body": {
          "priority": 0,
          "completed": false
        }
      }
    }
  ],
  "output": {
    "_id": "issue-1"
  }
}
