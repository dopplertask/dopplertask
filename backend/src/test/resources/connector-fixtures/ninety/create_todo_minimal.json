    {
      "request": {
        "method": "POST",
        "url": "https://api.public.ninety.io/v1/todos",
        "headers": {
          "authorization": "Bearer test-key",
          "content-type": "application/json"
        },
        "body": {
          "title": "Call the bank",
          "dueDate": "2026-09-11"
        }
      }
    }
  ],
  "output": {
    "_id": "todo-2",
    "title": "Call the bank"
  }
}
