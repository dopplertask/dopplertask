{
  "package": "@activepieces/piece-ninety",
  "version": "0.1.2",
  "action": "create_todo",
  "auth": {
    "type": "SECRET_TEXT",
    "secret_text": "test-key"
  },
  "inputs": {
    "title": "Call the bank",
    "dueDate": "2026-09-11"
  },
  "credential": {
    "token": "test-key"
  },
  "answers": [
    {
      "status": 200,
      "body": {
        "_id": "todo-2",
        "title": "Call the bank"
      }
    }
  ],
