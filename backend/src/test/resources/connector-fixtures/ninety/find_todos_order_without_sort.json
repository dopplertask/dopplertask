{
  "package": "@activepieces/piece-ninety",
  "version": "0.1.2",
  "action": "find_todos",
  "auth": {
    "type": "SECRET_TEXT",
    "secret_text": "test-key"
  },
  "inputs": {
    "scope": "personal",
    "userIds": [],
    "completed": "any",
    "order": "asc"
  },
  "credential": {
    "token": "test-key"
  },
  "answers": [
    {
      "status": 200,
      "body": {
        "items": [
          {
            "_id": "todo-2"
          }
        ],
        "totalCount": 7
      }
    }
  ],
  "exchanges": [
    {
      "request": {
        "method": "POST",
        "url": "https://api.public.ninety.io/v1/todos/query",
        "headers": {
          "authorization": "Bearer test-key",
          "content-type": "application/json"
        },
        "body": {
          "isPersonal": true
        }
      }
    }
  ],
  "output": {
    "todos": [
      {
        "_id": "todo-2"
      }
    ],
    "count": 1,
    "totalCount": 7
  }
}
