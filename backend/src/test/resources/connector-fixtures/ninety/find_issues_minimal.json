{
  "package": "@activepieces/piece-ninety",
  "version": "0.1.2",
  "action": "find_issues",
  "auth": {
    "type": "SECRET_TEXT",
    "secret_text": "test-key"
  },
  "inputs": {
    "sortField": "createdDate",
    "sortDirection": "DESC"
  },
  "credential": {
    "token": "test-key"
  },
  "answers": [
    {
      "status": 200,
      "body": [
        {
          "_id": "issue-1"
        }
      ]
    }
  ],
  "exchanges": [
    {
      "request": {
        "method": "POST",
        "url": "https://api.public.ninety.io/v1/issues/query",
        "headers": {
          "authorization": "Bearer test-key",
          "content-type": "application/json"
        },
        "body": {
          "sortField": "createdDate",
          "sortDirection": "DESC"
        }
      }
    }
  ],
  "output": {
    "issues": [
      {
        "_id": "issue-1"
      }
    ],
    "count": 1,
    "totalCount": 1
  }
}
