{
  "package": "@activepieces/piece-clockify",
  "version": "0.3.3",
  "action": "clockify_list_users",
  "auth": {
    "type": "SECRET_TEXT",
    "secret_text": "test-key"
  },
  "inputs": {
    "workspaceId": "ws-1",
    "email": "ada@",
    "name": "Ada",
    "status": "ACTIVE",
    "projectId": "p-1",
    "userGroupIds": [
      "g-1"
    ],
    "roles": [
      "TEAM_MANAGER"
    ],
    "includeRoles": true,
    "page": 2,
    "pageSize": 20
  },
  "credential": {
    "apiKey": "test-key"
  },
  "answers": [
    {
      "status": 200,
      "body": [
        {
          "id": "u-1",
          "name": "Ada",
          "email": "ada@example.com"
        }
      ]
    }
  ],
  "exchanges": [
    {
      "request": {
        "method": "POST",
        "url": "https://api.clockify.me/api/v1/workspaces/ws-1/users/info",
        "headers": {
          "content-type": "application/json",
          "x-api-key": "test-key"
        },
        "body": {
          "email": "ada@",
          "name": "Ada",
          "status": "ACTIVE",
          "projectId": "p-1",
          "userGroups": [
            "g-1"
          ],
          "roles": [
            "TEAM_MANAGER"
          ],
          "includeRoles": true,
          "page": 2,
          "pageSize": 20
        }
      }
    }
  ],
  "output": {
    "users": [
      {
        "id": "u-1",
        "name": "Ada",
        "email": "ada@example.com"
      }
    ],
    "count": 1
  }
}
