{
  "package": "@activepieces/piece-clockify",
  "version": "0.3.3",
  "action": "clockify_create_client",
  "auth": {
    "type": "SECRET_TEXT",
    "secret_text": "test-key"
  },
  "inputs": {
    "workspaceId": "ws-1",
    "name": "Acme",
    "email": "billing@example.com",
    "address": "1 Main St",
    "note": "Key account"
  },
  "credential": {
    "apiKey": "test-key"
  },
  "answers": [
    {
      "status": 200,
      "body": {
        "id": "c-1",
        "name": "Acme",
        "email": "billing@example.com",
        "address": "1 Main St",
        "note": "Key account",
        "workspaceId": "ws-1",
        "archived": false
      }
    }
  ],
  "exchanges": [
    {
      "request": {
        "method": "POST",
        "url": "https://api.clockify.me/api/v1/workspaces/ws-1/clients",
        "headers": {
          "content-type": "application/json",
          "x-api-key": "test-key"
        },
        "body": {
          "name": "Acme",
          "email": "billing@example.com",
          "address": "1 Main St",
          "note": "Key account"
        }
      }
    }
  ],
  "output": {
    "id": "c-1",
    "name": "Acme",
    "email": "billing@example.com",
    "address": "1 Main St",
    "note": "Key account",
    "workspaceId": "ws-1",
    "archived": false
  }
}
