{
  "package": "@activepieces/piece-clockify",
  "version": "0.3.3",
  "action": "clockify_create_template",
  "auth": {
    "type": "SECRET_TEXT",
    "secret_text": "test-key"
  },
  "inputs": {
    "workspaceId": "ws-1",
    "name": "Weekly",
    "projectIds": [
      "p-1",
      "p-2"
    ]
  },
  "credential": {
    "apiKey": "test-key"
  },
  "answers": [
    {
      "status": 200,
      "body": [
        {
          "id": "tp-1",
          "name": "Weekly",
          "projectsAndTasks": [
            {
              "projectId": "p-1"
            },
            {
              "projectId": "p-2"
            }
          ]
        }
      ]
    }
  ],
  "exchanges": [
    {
      "request": {
        "method": "POST",
        "url": "https://api.clockify.me/api/v1/workspaces/ws-1/templates",
        "headers": {
          "content-type": "application/json",
          "x-api-key": "test-key"
        },
        "body": [
          {
            "name": "Weekly",
            "projectsAndTasks": [
              {
                "projectId": "p-1"
              },
              {
                "projectId": "p-2"
              }
            ]
          }
        ]
      }
    }
  ],
  "output": {
    "id": "tp-1",
    "name": "Weekly",
    "projectsAndTasks": [
      {
        "projectId": "p-1"
      },
      {
        "projectId": "p-2"
      }
    ]
  }
}
