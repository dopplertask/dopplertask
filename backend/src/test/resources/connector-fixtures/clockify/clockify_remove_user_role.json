{
  "package": "@activepieces/piece-clockify",
  "version": "0.3.3",
  "action": "clockify_remove_user_role",
  "auth": {
    "type": "SECRET_TEXT",
    "secret_text": "test-key"
  },
  "inputs": {
    "workspaceId": "ws-1",
    "userId": "u-1",
    "role": "TEAM_MANAGER",
    "entityId": "g-1",
    "entityIsUserGroup": true
  },
  "credential": {
    "apiKey": "test-key"
  },
  "answers": [
    {
      "status": 200,
      "body": {}
    }
  ],
  "exchanges": [
    {
      "request": {
        "method": "DELETE",
        "url": "https://api.clockify.me/api/v1/workspaces/ws-1/users/u-1/roles",
        "headers": {
          "content-type": "application/json",
          "x-api-key": "test-key"
        },
        "body": {
          "role": "TEAM_MANAGER",
          "entityId": "g-1",
          "sourceType": "USER_GROUP"
        }
      }
    }
  ],
  "output": {
    "removed": true,
    "userId": "u-1",
    "role": "TEAM_MANAGER",
    "entityId": "g-1"
  }
}
