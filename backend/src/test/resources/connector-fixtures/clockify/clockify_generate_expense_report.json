{
  "package": "@activepieces/piece-clockify",
  "version": "0.3.3",
  "action": "clockify_generate_expense_report",
  "auth": {
    "type": "SECRET_TEXT",
    "secret_text": "test-key"
  },
  "inputs": {
    "workspaceId": "ws-1",
    "dateRangeStart": "2026-10-01T00:00:00Z",
    "dateRangeEnd": "2026-10-31T23:59:59Z",
    "projectIds": [
      "p-1"
    ],
    "userIds": [
      "u-1"
    ],
    "page": 2,
    "pageSize": 20
  },
  "credential": {
    "apiKey": "test-key"
  },
  "answers": [
    {
      "status": 200,
      "body": {
        "expenses": {
          "expenses": [
            {
              "id": "e-1",
              "total": 1500
            }
          ]
        },
        "totals": {
          "expensesCount": 1
        }
      }
    }
  ],
  "exchanges": [
    {
      "request": {
        "method": "POST",
        "url": "https://reports.api.clockify.me/v1/workspaces/ws-1/reports/expenses/detailed",
        "headers": {
          "content-type": "application/json",
          "x-api-key": "test-key"
        },
        "body": {
          "dateRangeStart": "2026-10-01T00:00:00Z",
          "dateRangeEnd": "2026-10-31T23:59:59Z",
          "exportType": "JSON",
          "projects": {
            "ids": [
              "p-1"
            ],
            "contains": "CONTAINS",
            "status": "ALL"
          },
          "users": {
            "ids": [
              "u-1"
            ],
            "contains": "CONTAINS",
            "status": "ALL"
          },
          "page": 2,
          "pageSize": 20
        }
      }
    }
  ],
  "output": {
    "expenses": {
      "expenses": [
        {
          "id": "e-1",
          "total": 1500
        }
      ]
    },
    "totals": {
      "expensesCount": 1
    }
  }
}
