{
  "package": "@activepieces/piece-clockify",
  "version": "0.3.3",
  "action": "clockify_create_project",
  "auth": {
    "type": "SECRET_TEXT",
    "secret_text": "test-key"
  },
  "inputs": {
    "workspaceId": "ws-1",
    "name": "Website",
    "clientId": "c-1",
    "color": "#03A9F4",
    "note": "Relaunch",
    "billable": true,
    "isPublic": false,
    "billableRate": 5000
  },
  "credential": {
    "apiKey": "test-key"
  },
  "answers": [
    {
      "status": 200,
      "body": {
        "id": "p-1",
        "name": "Website",
        "clientId": "c-1",
        "billable": true
      }
    }
  ],
  "exchanges": [
    {
      "request": {
        "method": "POST",
        "url": "https://api.clockify.me/api/v1/workspaces/ws-1/projects",
        "headers": {
          "content-type": "application/json",
          "x-api-key": "test-key"
        },
        "body": {
          "name": "Website",
          "clientId": "c-1",
          "color": "#03A9F4",
          "note": "Relaunch",
          "billable": true,
          "isPublic": false,
          "hourlyRate": {
            "amount": 5000
          }
        }
      }
    }
  ],
  "output": {
    "id": "p-1",
    "name": "Website",
    "clientId": "c-1",
    "billable": true
  }
}
