      "request": {
        "method": "PATCH",
        "url": "https://api.clockify.me/api/v1/workspaces/ws-1/member-profile/u-1",
        "headers": {
          "content-type": "application/json",
          "x-api-key": "test-key"
        },
        "body": {
          "name": "Ada L",
          "weekStart": "MONDAY",
          "workCapacity": "PT7H",
          "workingDays": [
            "MONDAY",
            "WEDNESDAY"
          ]
        }
      }
    }
  ],
  "output": {
    "name": "Ada L",
    "weekStart": "MONDAY",
    "workCapacity": "PT7H",
    "workingDays": [
      "MONDAY",
      "WEDNESDAY"
    ]
  }
