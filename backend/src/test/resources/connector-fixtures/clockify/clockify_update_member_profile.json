{
  "package": "@activepieces/piece-clockify",
  "version": "0.3.3",
  "action": "clockify_update_member_profile",
  "auth": {
    "type": "SECRET_TEXT",
    "secret_text": "test-key"
  },
  "inputs": {
    "workspaceId": "ws-1",
    "userId": "u-1",
    "name": "Ada L",
    "weekStart": "MONDAY",
    "workCapacity": "PT7H",
    "workingDays": [
      "MONDAY",
      "WEDNESDAY"
    ]
  },
  "credential": {
    "apiKey": "test-key"
  },
  "answers": [
    {
      "status": 200,
      "body": {
        "name": "Ada L",
        "weekStart": "MONDAY",
        "workCapacity": "PT7H",
        "workingDays": [
          "MONDAY",
          "WEDNESDAY"
        ]
      }
    }
  ],
  "exchanges": [
