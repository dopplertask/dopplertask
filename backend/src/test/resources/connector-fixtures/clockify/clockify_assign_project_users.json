{
  "package": "@activepieces/piece-clockify",
  "version": "0.3.3",
  "action": "clockify_assign_project_users",
  "auth": {
    "type": "SECRET_TEXT",
    "secret_text": "test-key"
  },
  "inputs": {
    "workspaceId": "ws-1",
    "projectId": "p-1",
    "userIds": [
      "u-1",
      "u-2"
    ],
    "remove": true
  },
  "credential": {
    "apiKey": "test-key"
  },
  "answers": [
    {
      "status": 200,
      "body": {
        "id": "p-1",
        "name": "Website",
        "workspaceId": "ws-1",
        "memberships": [
          {
            "userId": "u-3"
          }
        ]
      }
    }
  ],
  "exchanges": [
    {
      "request": {
        "method": "POST",
        "url": "https://api.clockify.me/api/v1/workspaces/ws-1/projects/p-1/memberships",
        "headers": {
          "content-type": "application/json",
          "x-api-key": "test-key"
        },
        "body": {
          "userIds": [
            "u-1",
            "u-2"
          ],
          "remove": true
        }
      }
    }
  ],
  "output": {
    "id": "p-1",
    "name": "Website",
    "workspaceId": "ws-1",
    "memberships": [
      {
        "userId": "u-3"
      }
    ]
  }
}
