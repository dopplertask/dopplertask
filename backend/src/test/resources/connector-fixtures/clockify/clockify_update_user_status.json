{
  "package": "@activepieces/piece-clockify",
  "version": "0.3.3",
  "action": "clockify_update_user_status",
  "auth": {
    "type": "SECRET_TEXT",
    "secret_text": "test-key"
  },
  "inputs": {
    "workspaceId": "ws-1",
    "userId": "u-1",
    "status": "INACTIVE"
  },
  "credential": {
    "apiKey": "test-key"
  },
  "answers": [
    {
      "status": 200,
      "body": {
        "id": "u-1",
        "name": "Ada",
        "status": "INACTIVE"
      }
    }
  ],
  "exchanges": [
    {
      "request": {
        "method": "PUT",
        "url": "https://api.clockify.me/api/v1/workspaces/ws-1/users/u-1",
        "headers": {
          "content-type": "application/json",
          "x-api-key": "test-key"
        },
        "body": {
          "status": "INACTIVE"
        }
      }
    }
  ],
  "output": {
    "id": "u-1",
    "name": "Ada",
    "status": "INACTIVE"
  }
}
