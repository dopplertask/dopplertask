{
  "package": "@activepieces/piece-clockify",
  "version": "0.3.3",
  "action": "clockify_update_template",
  "auth": {
    "type": "SECRET_TEXT",
    "secret_text": "test-key"
  },
  "inputs": {
    "workspaceId": "ws-1",
    "templateId": "tp-1",
    "name": "Weekly v2"
  },
  "credential": {
    "apiKey": "test-key"
  },
  "answers": [
    {
      "status": 200,
      "body": {
        "id": "tp-1",
        "name": "Weekly v2"
      }
    }
  ],
  "exchanges": [
    {
      "request": {
        "method": "PATCH",
        "url": "https://api.clockify.me/api/v1/workspaces/ws-1/templates/tp-1",
        "headers": {
          "content-type": "application/json",
          "x-api-key": "test-key"
        },
        "body": {
          "name": "Weekly v2"
        }
      }
    }
  ],
  "output": {
    "id": "tp-1",
    "name": "Weekly v2"
  }
}
