{
  "package": "@activepieces/piece-clockify",
  "version": "0.3.3",
  "action": "clockify_create_project_from_template",
  "auth": {
    "type": "SECRET_TEXT",
    "secret_text": "test-key"
  },
  "inputs": {
    "workspaceId": "ws-1",
    "templateProjectId": "p-tpl",
    "name": "New site",
    "clientId": "c-1",
    "color": "#03A9F4",
    "isPublic": true
  },
  "credential": {
    "apiKey": "test-key"
  },
  "answers": [
    {
      "status": 200,
      "body": {
        "id": "p-2",
        "name": "New site",
        "clientId": "c-1",
        "color": "#03A9F4",
        "public": true,
        "workspaceId": "ws-1"
      }
    }
  ],
  "exchanges": [
    {
      "request": {
        "method": "POST",
        "url": "https://api.clockify.me/api/v1/workspaces/ws-1/projects/from-template",
        "headers": {
          "content-type": "application/json",
          "x-api-key": "test-key"
        },
        "body": {
          "templateProjectId": "p-tpl",
          "name": "New site",
          "clientId": "c-1",
          "color": "#03A9F4",
          "isPublic": true
        }
      }
    }
  ],
  "output": {
    "id": "p-2",
    "name": "New site",
    "clientId": "c-1",
    "color": "#03A9F4",
    "public": true,
    "workspaceId": "ws-1"
  }
}
