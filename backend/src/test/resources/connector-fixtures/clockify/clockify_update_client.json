{
  "package": "@activepieces/piece-clockify",
  "version": "0.3.3",
  "action": "clockify_update_client",
  "auth": {
    "type": "SECRET_TEXT",
    "secret_text": "test-key"
  },
  "inputs": {
    "workspaceId": "ws-1",
    "clientId": "c-1",
    "name": "Acme AB",
    "email": "billing@acme.example",
    "address": "Main St 1",
    "note": "VIP",
    "archived": "true",
    "archiveProjects": true,
    "markTasksAsDone": true
  },
  "credential": {
    "apiKey": "test-key"
  },
  "answers": [
    {
      "status": 200,
      "body": {
        "id": "c-1",
        "name": "Acme",
        "email": null,
        "address": "Old St",
        "note": "",
        "archived": false,
        "currencyId": "cur-1",
        "ccEmails": [
          "cc@acme.example"
        ]
      }
    },
    {
      "status": 200,
      "body": {
        "id": "c-1",
        "name": "Acme AB",
        "archived": true
      }
    }
  ],
  "exchanges": [
    {
      "request": {
        "method": "GET",
        "url": "https://api.clockify.me/api/v1/workspaces/ws-1/clients/c-1",
        "headers": {
          "x-api-key": "test-key"
        },
        "body": null
      }
    },
    {
      "request": {
        "method": "PUT",
        "url": "https://api.clockify.me/api/v1/workspaces/ws-1/clients/c-1?archive-projects=true&mark-tasks-as-done=true",
        "headers": {
          "content-type": "application/json",
          "x-api-key": "test-key"
        },
        "body": {
          "name": "Acme AB",
          "email": "billing@acme.example",
          "address": "Main St 1",
          "note": "VIP",
          "archived": true,
          "currencyId": "cur-1",
          "ccEmails": [
            "cc@acme.example"
          ]
        }
      }
    }
  ],
  "output": {
    "id": "c-1",
    "name": "Acme AB",
    "archived": true
  }
}
