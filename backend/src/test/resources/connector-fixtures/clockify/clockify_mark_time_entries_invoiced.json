{
  "package": "@activepieces/piece-clockify",
  "version": "0.3.3",
  "action": "clockify_mark_time_entries_invoiced",
  "auth": {
    "type": "SECRET_TEXT",
    "secret_text": "test-key"
  },
  "inputs": {
    "workspaceId": "ws-1",
    "timeEntryIds": [
      "te-1",
      "te-2"
    ],
    "invoiced": true
  },
  "credential": {
    "apiKey": "test-key"
  },
  "answers": [
    {
      "status": 200,
      "body": {}
    }
  ],
  "exchanges": [
    {
      "request": {
        "method": "PATCH",
        "url": "https://api.clockify.me/api/v1/workspaces/ws-1/time-entries/invoiced",
        "headers": {
          "content-type": "application/json",
          "x-api-key": "test-key"
        },
        "body": {
          "timeEntryIds": [
            "te-1",
            "te-2"
          ],
          "invoiced": true
        }
      }
    }
  ],
  "output": {
    "success": true,
    "invoiced": true,
    "timeEntryIds": [
      "te-1",
      "te-2"
    ]
  }
}
