{
  "package": "@activepieces/piece-clockify",
  "version": "0.3.3",
  "action": "clockify_generate_weekly_report",
  "auth": {
    "type": "SECRET_TEXT",
    "secret_text": "test-key"
  },
  "inputs": {
    "workspaceId": "ws-1",
    "dateRangeStart": "2026-10-01T00:00:00Z",
    "dateRangeEnd": "2026-10-31T23:59:59Z",
    "projectIds": [
      "p-1"
    ],
    "userIds": [
      "u-1"
    ],
    "clientIds": [
      "c-1"
    ],
    "tagIds": [
      "t-1"
    ],
    "billable": "true",
    "group": "USER"
  },
  "credential": {
    "apiKey": "test-key"
  },
  "answers": [
    {
      "status": 200,
      "body": {
        "totals": [
          {
            "totalTime": 7200
          }
        ],
        "groupOne": [
          {
            "_id": "u-1",
            "name": "Ada"
          }
        ]
      }
    }
  ],
  "exchanges": [
    {
      "request": {
        "method": "POST",
        "url": "https://reports.api.clockify.me/v1/workspaces/ws-1/reports/weekly",
        "headers": {
          "content-type": "application/json",
          "x-api-key": "test-key"
        },
        "body": {
          "dateRangeStart": "2026-10-01T00:00:00Z",
          "dateRangeEnd": "2026-10-31T23:59:59Z",
          "exportType": "JSON",
          "projects": {
            "ids": [
              "p-1"
            ],
            "contains": "CONTAINS",
            "status": "ALL"
          },
          "users": {
            "ids": [
              "u-1"
            ],
            "contains": "CONTAINS",
            "status": "ALL"
          },
          "clients": {
            "ids": [
              "c-1"
            ],
            "contains": "CONTAINS",
            "status": "ALL"
          },
          "tags": {
            "ids": [
              "t-1"
            ],
            "contains": "CONTAINS",
            "status": "ALL"
          },
          "billable": true,
          "weeklyFilter": {
            "group": "USER",
            "subgroup": "TIME"
          }
        }
      }
    }
  ],
  "output": {
    "totals": [
      {
        "totalTime": 7200
      }
    ],
    "groupOne": [
      {
        "_id": "u-1",
        "name": "Ada"
      }
    ]
  }
}
