{
  "package": "@activepieces/piece-clockify",
  "version": "0.3.3",
  "action": "clockify_update_project_memberships",
  "auth": {
    "type": "SECRET_TEXT",
    "secret_text": "test-key"
  },
  "inputs": {
    "workspaceId": "ws-1",
    "projectId": "p-1",
    "userIds": [
      "u-1",
      "u-2"
    ]
  },
  "credential": {
    "apiKey": "test-key"
  },
  "answers": [
    {
      "status": 200,
      "body": {
        "id": "p-1",
        "name": "Website",
        "memberships": [
          {
            "userId": "u-1"
          },
          {
            "userId": "u-2"
          }
        ]
      }
    }
  ],
  "exchanges": [
    {
      "request": {
        "method": "PATCH",
        "url": "https://api.clockify.me/api/v1/workspaces/ws-1/projects/p-1/memberships",
        "headers": {
          "content-type": "application/json",
          "x-api-key": "test-key"
        },
        "body": {
          "memberships": [
            {
              "userId": "u-1"
            },
            {
              "userId": "u-2"
            }
          ]
        }
      }
    }
  ],
  "output": {
    "id": "p-1",
    "name": "Website",
    "memberships": [
      {
        "userId": "u-1"
      },
      {
        "userId": "u-2"
      }
    ]
  }
}
