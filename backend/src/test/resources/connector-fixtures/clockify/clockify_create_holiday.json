{
  "package": "@activepieces/piece-clockify",
  "version": "0.3.3",
  "action": "clockify_create_holiday",
  "auth": {
    "type": "SECRET_TEXT",
    "secret_text": "test-key"
  },
  "inputs": {
    "workspaceId": "ws-1",
    "name": "Founders Day",
    "startDate": "2026-12-01",
    "endDate": "2026-12-02",
    "userIds": [
      "u-1"
    ],
    "userGroupIds": [
      "g-1"
    ],
    "everyone": false,
    "occursAnnually": true
  },
  "credential": {
    "apiKey": "test-key"
  },
  "answers": [
    {
      "status": 200,
      "body": {
        "id": "h-1",
        "name": "Founders Day",
        "datePeriod": {
          "startDate": "2026-12-01",
          "endDate": "2026-12-02"
        }
      }
    }
  ],
  "exchanges": [
    {
      "request": {
        "method": "POST",
        "url": "https://api.clockify.me/api/v1/workspaces/ws-1/holidays",
        "headers": {
          "content-type": "application/json",
          "x-api-key": "test-key"
        },
        "body": {
          "name": "Founders Day",
          "datePeriod": {
            "startDate": "2026-12-01",
            "endDate": "2026-12-02"
          },
          "occursAnnually": true,
          "everyoneIncludingNew": false,
          "users": {
            "ids": [
              "u-1"
            ],
            "contains": "CONTAINS",
            "status": "ALL"
          },
          "userGroups": {
            "ids": [
              "g-1"
            ],
            "contains": "CONTAINS",
            "status": "ALL"
          }
        }
      }
    }
  ],
  "output": {
    "id": "h-1",
    "name": "Founders Day",
    "datePeriod": {
      "startDate": "2026-12-01",
      "endDate": "2026-12-02"
    }
  }
}
