{
  "package": "@activepieces/piece-clockify",
  "version": "0.3.3",
  "trigger": "new-task",
  "webhook": true,
  "auth": {
    "type": "SECRET_TEXT",
    "secret_text": "test-key"
  },
  "inputs": {
    "workspaceId": "ws-1",
    "projectId": "p-1"
  },
  "credential": {
    "apiKey": "test-key"
  },
  "answers": [
    {
      "status": 201,
      "body": {
        "id": "wh-1",
        "name": "hook",
        "url": "https://tasks.example.com/hooks/test-key"
      }
    }
  ],
  "event": {
    "id": "t-1",
    "name": "Design",
    "projectId": "p-1",
    "workspaceId": "ws-1",
    "assigneeIds": [],
    "status": "ACTIVE",
    "billable": true,
    "estimate": "PT0S"
  },
  "exchanges": [
    {
      "request": {
        "method": "POST",
        "url": "https://api.clockify.me/api/v1/workspaces/ws-1/webhooks",
        "headers": {
          "content-type": "application/json",
          "x-api-key": "test-key"
        },
        "body": {
          "url": "https://tasks.example.com/hooks/test-key",
          "webhookEvent": "NEW_TASK",
          "triggerSourceType": "PROJECT_ID",
          "triggerSource": [
            "p-1"
          ]
        }
      }
    }
  ],
  "output": [
    {
      "id": "t-1",
      "name": "Design",
      "projectId": "p-1",
      "workspaceId": "ws-1",
      "assigneeIds": [],
      "status": "ACTIVE",
      "billable": true,
      "estimate": "PT0S"
    }
  ]
}
