{
  "package": "@activepieces/piece-clockify",
  "version": "0.3.3",
  "action": "clockify_update_workspace_billable_rate",
  "auth": {
    "type": "SECRET_TEXT",
    "secret_text": "test-key"
  },
  "inputs": {
    "workspaceId": "ws-1",
    "amount": 5000,
    "currency": "USD",
    "since": "2026-01-01T00:00:00Z",
    "includeApproved": false
  },
  "credential": {
    "apiKey": "test-key"
  },
  "answers": [
    {
      "status": 200,
      "body": {
        "id": "ws-1",
        "name": "Studio",
        "hourlyRate": {
          "amount": 5000,
          "currency": "USD"
        }
      }
    }
  ],
  "exchanges": [
    {
      "request": {
        "method": "PUT",
        "url": "https://api.clockify.me/api/v1/workspaces/ws-1/hourly-rate",
        "headers": {
          "content-type": "application/json",
          "x-api-key": "test-key"
        },
        "body": {
          "amount": 5000,
          "currency": "USD",
          "since": "2026-01-01T00:00:00Z",
          "includeApproved": false
        }
      }
    }
  ],
  "output": {
    "id": "ws-1",
    "name": "Studio",
    "hourlyRate": {
      "amount": 5000,
      "currency": "USD"
    }
  }
}
