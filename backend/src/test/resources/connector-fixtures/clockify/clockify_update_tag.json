{
  "package": "@activepieces/piece-clockify",
  "version": "0.3.3",
  "action": "clockify_update_tag",
  "auth": {
    "type": "SECRET_TEXT",
    "secret_text": "test-key"
  },
  "inputs": {
    "workspaceId": "ws-1",
    "tagId": "tag-1",
    "name": "Urgent",
    "archived": "true"
  },
  "credential": {
    "apiKey": "test-key"
  },
  "answers": [
    {
      "status": 200,
      "body": {
        "id": "tag-1",
        "name": "Hot",
        "archived": false
      }
    },
    {
      "status": 200,
      "body": {
        "id": "tag-1",
        "name": "Urgent",
        "archived": true
      }
    }
  ],
  "exchanges": [
    {
      "request": {
        "method": "GET",
        "url": "https://api.clockify.me/api/v1/workspaces/ws-1/tags/tag-1",
        "headers": {
          "x-api-key": "test-key"
        },
        "body": null
      }
    },
    {
      "request": {
        "method": "PUT",
        "url": "https://api.clockify.me/api/v1/workspaces/ws-1/tags/tag-1",
        "headers": {
          "content-type": "application/json",
          "x-api-key": "test-key"
        },
        "body": {
          "name": "Urgent",
          "archived": true
        }
      }
    }
  ],
  "output": {
    "id": "tag-1",
    "name": "Urgent",
    "archived": true
  }
}
