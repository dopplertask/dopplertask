{
  "package": "@activepieces/piece-clockify",
  "version": "0.3.3",
  "action": "clockify_update_project_estimate",
  "auth": {
    "type": "SECRET_TEXT",
    "secret_text": "test-key"
  },
  "inputs": {
    "workspaceId": "ws-1",
    "projectId": "p-1",
    "timeEstimate": "PT120H",
    "budgetEstimate": 500000,
    "resetOption": "MONTHLY",
    "disableTimeEstimate": false,
    "disableBudgetEstimate": false
  },
  "credential": {
    "apiKey": "test-key"
  },
  "answers": [
    {
      "status": 200,
      "body": {
        "id": "p-1",
        "name": "Website",
        "timeEstimate": {
          "estimate": "PT120H",
          "active": true
        }
      }
    }
  ],
  "exchanges": [
    {
      "request": {
        "method": "PATCH",
        "url": "https://api.clockify.me/api/v1/workspaces/ws-1/projects/p-1/estimate",
        "headers": {
          "content-type": "application/json",
          "x-api-key": "test-key"
        },
        "body": {
          "timeEstimate": {
            "active": true,
            "estimate": "PT120H",
            "type": "MANUAL",
            "resetOption": "MONTHLY",
            "includeNonBillable": true
          },
          "budgetEstimate": {
            "active": true,
            "estimate": 500000,
            "type": "MANUAL",
            "resetOption": "MONTHLY"
          }
        }
      }
    }
  ],
  "output": {
    "id": "p-1",
    "name": "Website",
    "timeEstimate": {
      "estimate": "PT120H",
      "active": true
    }
  }
}
