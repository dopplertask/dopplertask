{
  "package": "@activepieces/piece-clockify",
  "version": "0.3.3",
  "action": "clockify_update_shared_report",
  "auth": {
    "type": "SECRET_TEXT",
    "secret_text": "test-key"
  },
  "inputs": {
    "workspaceId": "ws-1",
    "sharedReportId": "sr-1",
    "name": "Monthly",
    "isPublic": "true",
    "fixedDate": "false",
    "visibleToUsers": [
      "u-1"
    ],
    "visibleToUserGroups": [
      "g-1"
    ]
  },
  "credential": {
    "apiKey": "test-key"
  },
  "answers": [
    {
      "status": 200,
      "body": {
        "reports": [
          {
            "id": "sr-0",
            "name": "Other"
          },
          {
            "id": "sr-1",
            "name": "Weekly",
            "isPublic": false,
            "fixedDate": true,
            "visibleToUsers": [
              {
                "id": "u-2"
              }
            ],
            "visibleToUserGroups": []
          }
        ],
        "count": 2
      }
    },
    {
      "status": 200,
      "body": {
        "id": "sr-1",
        "name": "Monthly"
      }
    }
  ],
  "exchanges": [
    {
      "request": {
        "method": "GET",
        "url": "https://reports.api.clockify.me/v1/workspaces/ws-1/shared-reports?sharedReportsFilter=ALL&page=1&pageSize=1000",
        "headers": {
          "x-api-key": "test-key"
        },
        "body": null
      }
    },
    {
      "request": {
        "method": "PUT",
        "url": "https://reports.api.clockify.me/v1/workspaces/ws-1/shared-reports/sr-1",
        "headers": {
          "content-type": "application/json",
          "x-api-key": "test-key"
        },
        "body": {
          "name": "Monthly",
          "isPublic": true,
          "fixedDate": false,
          "visibleToUsers": [
            "u-1"
          ],
          "visibleToUserGroups": [
            "g-1"
          ]
        }
      }
    }
  ],
  "output": {
    "id": "sr-1",
    "name": "Monthly"
  }
}
