{
  "package": "@activepieces/piece-clockify",
  "version": "0.3.3",
  "action": "clockify_add_user_to_group",
  "auth": {
    "type": "SECRET_TEXT",
    "secret_text": "test-key"
  },
  "inputs": {
    "workspaceId": "ws-1",
    "userGroupId": "ug-1",
    "userId": "u-1"
  },
  "credential": {
    "apiKey": "test-key"
  },
  "answers": [
    {
      "status": 200,
      "body": {
        "id": "ug-1",
        "name": "Designers",
        "workspaceId": "ws-1",
        "userIds": [
          "u-1"
        ]
      }
    }
  ],
  "exchanges": [
    {
      "request": {
        "method": "POST",
        "url": "https://api.clockify.me/api/v1/workspaces/ws-1/user-groups/ug-1/users",
        "headers": {
          "content-type": "application/json",
          "x-api-key": "test-key"
        },
        "body": {
          "userId": "u-1"
        }
      }
    }
  ],
  "output": {
    "id": "ug-1",
    "name": "Designers",
    "workspaceId": "ws-1",
    "userIds": [
      "u-1"
    ]
  }
}
