{
  "package": "@activepieces/piece-clockify",
  "version": "0.3.3",
  "action": "clockify_add_user_role",
  "auth": {
    "type": "SECRET_TEXT",
    "secret_text": "test-key"
  },
  "inputs": {
    "workspaceId": "ws-1",
    "userId": "u-1",
    "role": "TEAM_MANAGER",
    "entityId": "g-1",
    "entityIsUserGroup": true
  },
  "credential": {
    "apiKey": "test-key"
  },
  "answers": [
    {
      "status": 200,
      "body": {
        "role": "TEAM_MANAGER",
        "entities": [
          {
            "id": "g-1",
            "name": "Design"
          }
        ]
      }
    }
  ],
  "exchanges": [
    {
      "request": {
        "method": "POST",
        "url": "https://api.clockify.me/api/v1/workspaces/ws-1/users/u-1/roles",
        "headers": {
          "content-type": "application/json",
          "x-api-key": "test-key"
        },
        "body": {
          "role": "TEAM_MANAGER",
          "entityId": "g-1",
          "sourceType": "USER_GROUP"
        }
      }
    }
  ],
  "output": {
    "role": "TEAM_MANAGER",
    "entities": [
      {
        "id": "g-1",
        "name": "Design"
      }
    ]
  }
}
