{
  "package": "@activepieces/piece-openai",
  "version": "0.13.2",
  "action": "delete_file",
  "auth": {
    "type": "SECRET_TEXT",
    "secret_text": "sk-test-key"
  },
  "inputs": {
    "fileId": "file-abc123"
  },
  "credential": {
    "apiKey": "sk-test-key"
  },
  "answers": [
    {
      "status": 200,
      "body": {
        "id": "file-abc123",
        "object": "file",
