{
  "package": "@activepieces/piece-pocketbase",
  "version": "0.1.0",
  "action": "pocketbase_preview_view_query",
  "auth": {
    "type": "CUSTOM_AUTH",
    "props": {
      "host": "https://credential000z.example.com",
      "email": "credential001z",
      "password": "credential002z"
    }
  },
  "inputs": {
    "query": "sample000z"
  },
  "credential": {
    "host": "credential000z.example.com",
    "email": "credential001z",
    "password": "credential002z"
  },
  "answers": [
    {
      "status": 200,
      "body": {}
    }
  ],
  "exchanges": [
    {
      "request": {
        "method": "POST",
        "url": "https://credential000z.example.com/api/collections/_superusers/auth-with-password",
        "headers": {
          "content-type": "application/json"
        },
        "body": {
          "identity": "credential001z",
          "password": "credential002z"
        }
      }
    }
  ],
  "output": {
    "error": "Authentication failed: no token returned from PocketBase."
  }
