{
  "package": "@activepieces/piece-google-calendar",
  "version": "0.13.4",
  "action": "google_calendar_get_colors",
  "auth": {
    "access_token": "test-token",
    "data": {}
  },
  "inputs": {},
  "credential": {
    "oauthAccessToken": "test-token"
  },
  "answers": [
    {
      "status": 200,
      "body": {
        "kind": "calendar#colors",
        "event": {
          "1": {
            "background": "#a4bdfc",
            "foreground": "#1d1d1d"
          }
        },
        "calendar": {
          "1": {
            "background": "#ac725e",
            "foreground": "#1d1d1d"
          }
        }
      }
    }
  ],
  "exchanges": [
    {
      "request": {
        "method": "GET",
        "url": "https://www.googleapis.com/calendar/v3/colors",
        "headers": {
          "authorization": "Bearer test-token"
        },
        "body": null
      }
    }
  ],
  "output": {
    "kind": "calendar#colors",
    "event": {
      "1": {
        "background": "#a4bdfc",
        "foreground": "#1d1d1d"
      }
    },
    "calendar": {
      "1": {
        "background": "#ac725e",
        "foreground": "#1d1d1d"
      }
    }
  }
}
