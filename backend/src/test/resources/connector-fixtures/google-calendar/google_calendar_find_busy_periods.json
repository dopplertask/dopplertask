{
  "package": "@activepieces/piece-google-calendar",
  "version": "0.13.4",
  "action": "google_calendar_find_busy_periods",
  "auth": {
    "access_token": "test-token",
    "data": {}
  },
  "inputs": {
    "calendar_ids": [
      "cal-1@group.calendar.google.com"
    ],
    "start_date": "2026-01-05T08:00:00.000Z",
    "end_date": "2026-01-05T18:00:00.000Z"
  },
  "credential": {
    "oauthAccessToken": "test-token"
  },
  "answers": [
    {
      "status": 200,
      "body": {
        "kind": "calendar#freeBusy",
        "calendars": {
          "cal-1@group.calendar.google.com": {
            "busy": [
              {
                "start": "2026-01-05T09:00:00Z",
                "end": "2026-01-05T10:00:00Z"
              }
            ]
          }
        }
      }
    }
  ],
  "exchanges": [
    {
      "request": {
        "method": "POST",
        "url": "https://www.googleapis.com/calendar/v3/freeBusy",
        "headers": {
          "authorization": "Bearer test-token",
          "content-type": "application/json"
        },
        "body": {
          "timeMin": "2026-01-05T08:00:00.000Z",
          "timeMax": "2026-01-05T18:00:00.000Z",
          "items": [
            {
              "id": "cal-1@group.calendar.google.com"
            }
          ]
        }
      }
    }
  ],
  "output": {
    "kind": "calendar#freeBusy",
    "calendars": {
      "cal-1@group.calendar.google.com": {
        "busy": [
          {
            "start": "2026-01-05T09:00:00Z",
            "end": "2026-01-05T10:00:00Z"
          }
        ]
      }
    }
  }
}
