{
  "package": "@activepieces/piece-google-calendar",
  "version": "0.13.4",
  "action": "create_quick_event",
  "auth": {
    "access_token": "test-token",
    "data": {}
  },
  "inputs": {
    "calendar_id": "cal-1@group.calendar.google.com",
    "text": "Lunch with Sam tomorrow at 1pm",
    "send_updates": "externalOnly"
  },
  "credential": {
    "oauthAccessToken": "test-token"
  },
  "answers": [
    {
      "status": 200,
      "body": {
        "kind": "calendar#event",
        "id": "ev1",
        "summary": "Lunch with Sam",
        "status": "confirmed"
      }
    }
  ],
  "exchanges": [
    {
      "request": {
        "method": "POST",
        "url": "https://www.googleapis.com/calendar/v3/calendars/cal-1@group.calendar.google.com/events/quickAdd?text=Lunch+with+Sam+tomorrow+at+1pm&sendUpdates=externalOnly",
        "headers": {
          "authorization": "Bearer test-token",
          "content-type": "application/json"
        },
        "body": {}
      }
    }
  ],
  "output": {
    "status": 200,
    "headers": {
      "content-type": "application/json"
    },
    "body": {
      "kind": "calendar#event",
      "id": "ev1",
      "summary": "Lunch with Sam",
      "status": "confirmed"
    }
  }
}
