{
  "package": "@activepieces/piece-google-calendar",
  "version": "0.13.4",
  "trigger": "new_calendar",
  "auth": {
    "access_token": "test-token",
    "data": {}
  },
  "credential": {
    "oauthAccessToken": "test-token"
  },
  "inputs": {
    "exclude_shared": true
  },
  "store": {
    "lastItem": "team-old@group.calendar.google.com",
    "calendars": [
      "team-old@group.calendar.google.com",
      "holidays@group.v.calendar.google.com"
    ]
  },
  "answers": [
    {
      "status": 200,
      "body": {
        "kind": "calendar#calendarList",
        "items": [
          {
            "kind": "calendar#calendarListEntry",
            "id": "team-new@group.calendar.google.com",
            "summary": "Team Launch",
            "description": "Shared with the team",
            "timeZone": "Europe/Stockholm",
            "accessRole": "writer",
            "backgroundColor": "#9fe1e7",
            "foregroundColor": "#000000"
          },
          {
            "kind": "calendar#calendarListEntry",
            "id": "team-old@group.calendar.google.com",
            "summary": "Team Old",
            "timeZone": "Europe/Stockholm",
            "accessRole": "owner"
          },
          {
            "kind": "calendar#calendarListEntry",
            "id": "ada@example.com",
            "summary": "ada@example.com",
            "description": "Team calendar",
            "timeZone": "Europe/Stockholm",
            "accessRole": "owner",
            "primary": true
          },
          {
            "kind": "calendar#calendarListEntry",
            "id": "holidays@group.v.calendar.google.com",
            "summary": "Team Holidays",
            "timeZone": "Europe/Stockholm",
            "accessRole": "reader"
          },
          {
            "kind": "calendar#calendarListEntry",
            "id": "other@group.calendar.google.com",
            "summary": "Gym",
            "timeZone": "Europe/Stockholm",
            "accessRole": "owner"
          }
        ]
      }
    }
  ],
  "exchanges": [
    {
      "request": {
        "method": "GET",
        "url": "https://www.googleapis.com/calendar/v3/users/me/calendarList?showDeleted=false",
        "headers": {
          "authorization": "Bearer test-token"
        },
        "body": null
      }
    }
  ],
  "output": [
    {
      "kind": "calendar#calendarListEntry",
      "id": "ada@example.com",
      "summary": "ada@example.com",
      "description": "Team calendar",
      "timeZone": "Europe/Stockholm",
      "accessRole": "owner",
      "primary": true,
      "isOwned": true,
      "isShared": false,
      "calendarType": "primary"
    },
    {
      "kind": "calendar#calendarListEntry",
      "id": "other@group.calendar.google.com",
      "summary": "Gym",
      "timeZone": "Europe/Stockholm",
      "accessRole": "owner",
      "isOwned": true,
      "isShared": false,
      "calendarType": "owned"
    }
  ],
  "storeAfter": {
    "lastItem": "ada@example.com",
    "calendars": [
      "team-old@group.calendar.google.com",
      "ada@example.com",
      "other@group.calendar.google.com"
    ]
  }
}
