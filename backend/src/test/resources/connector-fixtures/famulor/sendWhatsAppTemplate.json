{
  "package": "@activepieces/piece-famulor",
  "version": "0.2.6",
  "action": "send_whats_app_template",
  "auth": {
    "type": "SECRET_TEXT",
    "secret_text": "test-key"
  },
  "inputs": {
    "sender_id": 5,
    "template_id": 21,
    "recipient_phone": "+4915112345678",
    "recipient_name": " Anna Berg ",
    "variables": {
      "1": "Monday"
    }
  },
  "credential": {
    "apiKey": "test-key"
  },
  "answers": [
    {
      "status": 200,
      "body": {
        "success": true,
        "message_id": "wamid-1",
        "conversation_id": "conv-wa-1"
      }
    }
  ],
  "exchanges": [
    {
      "request": {
        "method": "POST",
        "url": "https://app.famulor.de/api/user/whatsapp/send",
        "headers": {
          "authorization": "Bearer test-key",
          "content-type": "application/json"
        },
        "body": {
          "sender_id": 5,
          "template_id": 21,
          "recipient_phone": "+4915112345678",
          "recipient_name": "Anna Berg",
          "variables": {
            "1": "Monday"
          }
        }
      }
    }
  ],
  "output": {
    "success": true,
    "message_id": "wamid-1",
    "conversation_id": "conv-wa-1"
  }
}
