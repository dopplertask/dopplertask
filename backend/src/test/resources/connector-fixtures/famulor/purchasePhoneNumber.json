{
  "package": "@activepieces/piece-famulor",
  "version": "0.2.6",
  "action": "purchase_phone_number",
  "auth": {
    "type": "SECRET_TEXT",
    "secret_text": "test-key"
  },
  "inputs": {
    "phone_number": "+4930300001"
  },
  "credential": {
    "apiKey": "test-key"
  },
  "answers": [
    {
      "status": 201,
      "body": {
        "message": "Phone number purchased",
        "phone_number": {
          "id": 8,
          "phone_number": "+4930300001"
        }
      }
    }
  ],
  "exchanges": [
    {
      "request": {
        "method": "POST",
        "url": "https://app.famulor.de/api/user/phone-numbers/purchase",
        "headers": {
          "authorization": "Bearer test-key",
          "content-type": "application/json"
        },
        "body": {
          "phone_number": "+4930300001"
        }
      }
    }
  ],
  "output": {
    "message": "Phone number purchased",
    "phone_number": {
      "id": 8,
      "phone_number": "+4930300001"
    }
  }
}
