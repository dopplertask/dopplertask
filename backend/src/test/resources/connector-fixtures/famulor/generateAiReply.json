{
  "package": "@activepieces/piece-famulor",
  "version": "0.2.6",
  "action": "generate_ai_reply",
  "auth": {
    "type": "SECRET_TEXT",
    "secret_text": "test-key"
  },
  "inputs": {
    "assistant_id": 33,
    "customer_identifier": "+4915112345678",
    "message": "Do you have time on Friday?",
    "variables": {
      "customer_name": "Anna",
      "empty_one": ""
    }
  },
  "credential": {
    "apiKey": "test-key"
  },
  "answers": [
    {
      "status": 200,
      "body": {
        "success": true,
