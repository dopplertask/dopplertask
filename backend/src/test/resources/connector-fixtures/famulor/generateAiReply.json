  ],
  "exchanges": [
    {
      "request": {
        "method": "POST",
        "url": "https://app.famulor.de/api/ai/generate-reply",
        "headers": {
          "authorization": "Bearer test-key",
          "content-type": "application/json"
        },
        "body": {
          "assistant_id": 33,
          "customer_identifier": "+4915112345678",
          "message": "Do you have time on Friday?",
          "variables": {
            "customer_name": "Anna"
          }
        }
      }
    }
  ],
  "output": {
    "success": true,
    "response": "Yes, Friday at 10:00 works.",
    "customer_identifier": "+4915112345678",
    "conversation_id": "conv-1"
  }
