{
  "package": "@activepieces/piece-famulor",
  "version": "0.2.6",
  "action": "search_available_phone_numbers",
  "auth": {
    "type": "SECRET_TEXT",
    "secret_text": "test-key"
  },
  "inputs": {
    "country_code": "DE",
    "contains": "30"
  },
  "credential": {
    "apiKey": "test-key"
  },
  "answers": [
    {
      "status": 200,
      "body": {
        "numbers": [
          {
            "phone_number": "+4930300001",
            "country_code": "DE",
            "monthly_price": 2.5
          }
        ]
      }
    }
  ],
  "exchanges": [
    {
      "request": {
        "method": "GET",
        "url": "https://app.famulor.de/api/user/phone-numbers/search?country_code=DE&contains=30",
        "headers": {
          "authorization": "Bearer test-key",
          "content-type": "application/json"
        },
        "body": null
      }
    }
  ],
  "output": {
    "numbers": [
      {
        "phone_number": "+4930300001",
        "country_code": "DE",
        "monthly_price": 2.5
      }
    ]
  }
}
