{
  "package": "@activepieces/piece-famulor",
  "version": "0.2.6",
  "action": "make_phone_call",
  "auth": {
    "type": "SECRET_TEXT",
    "secret_text": "test-key"
  },
  "inputs": {
    "assistant_id": 33,
    "phone_number": "+4915112345678",
    "variable": {
      "customer_name": "Anna Berg",
      "email": "anna@example.com"
    }
  },
  "credential": {
    "apiKey": "test-key"
  },
  "answers": [
    {
      "status": 200,
      "body": {
        "status": true,
        "message": "Call initiated",
        "call_id": 4001
      }
    }
  ],
  "exchanges": [
    {
      "request": {
        "method": "POST",
        "url": "https://app.famulor.de/api/user/make_call",
        "headers": {
          "authorization": "Bearer test-key",
          "content-type": "application/json"
        },
        "body": {
          "assistant_id": 33,
          "phone_number": "+4915112345678",
          "variable": {
            "customer_name": "Anna Berg",
            "email": "anna@example.com"
          }
        }
      }
    }
  ],
  "output": {
    "status": true,
    "message": "Call initiated",
    "call_id": 4001
  }
}
