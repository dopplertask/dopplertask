{
  "package": "@activepieces/piece-famulor",
  "version": "0.2.6",
  "action": "add_lead",
  "auth": {
    "type": "SECRET_TEXT",
    "secret_text": "test-key"
  },
  "inputs": {
    "campaign": 12,
    "phone_number": "+4915112345678",
    "variables": {
      "customer_name": "Anna Berg"
    },
    "allow_dupplicate": true,
    "num_secondary_contacts": 2,
    "secondary_contacts": {
      "contact_1_phone": " +4915187654321 ",
      "contact_1_variables": {
        "customer_name": "Ben Berg"
      },
      "contact_2_phone": "+4915100000002"
    }
  },
  "credential": {
    "apiKey": "test-key"
  },
  "answers": [
    {
      "status": 200,
      "body": {
        "message": "Lead created successfully",
        "data": {
          "id": 501,
          "phone_number": "+4915112345678",
          "status": "created"
        }
      }
    }
  ],
  "exchanges": [
    {
      "request": {
        "method": "POST",
        "url": "https://app.famulor.de/api/user/lead",
        "headers": {
          "authorization": "Bearer test-key",
          "content-type": "application/json"
        },
        "body": {
          "campaign_id": 12,
          "phone_number": "+4915112345678",
          "variables": {
            "customer_name": "Anna Berg"
          },
          "allow_dupplicate": true,
          "secondary_contacts": [
            {
              "phone_number": "+4915187654321",
              "variables": {
                "customer_name": "Ben Berg"
              }
            },
            {
              "phone_number": "+4915100000002",
              "variables": {
                "customer_name": ""
              }
            }
          ]
        }
      }
    }
  ],
  "output": {
    "message": "Lead created successfully",
    "data": {
      "id": 501,
      "phone_number": "+4915112345678",
      "status": "created"
    }
  }
}
