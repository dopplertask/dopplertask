{
  "package": "@activepieces/piece-famulor",
  "version": "0.2.6",
  "trigger": "inboundCall",
  "webhook": true,
  "auth": {
    "type": "SECRET_TEXT",
    "secret_text": "test-key"
  },
  "inputs": {
    "assistant_id": 33
  },
  "credential": {
    "apiKey": "test-key"
  },
  "answers": [
    {
      "status": 200,
      "body": {
        "status": true,
        "message": "Webhook enabled"
      }
    }
  ],
  "event": {
    "assistant_id": 33,
    "customer_phone": "+4915123456789",
    "assistant_phone": "+4912345678",
    "call_id": "call_abc123",
    "timestamp": "2026-01-02T10:30:00Z",
    "status": "incoming",
    "variables": {
      "customer_name": "Anna Berg"
    }
  },
  "exchanges": [
    {
      "request": {
        "method": "POST",
        "url": "https://app.famulor.de/api/user/assistants/enable-inbound-webhook",
        "headers": {
          "authorization": "Bearer test-key",
          "content-type": "application/json"
        },
        "body": {
          "assistant_id": 33,
          "webhook_url": "https://tasks.example.com/hooks/test-key"
        }
      }
    }
  ],
  "output": [
    {
      "assistant_id": 33,
      "customer_phone": "+4915123456789",
      "assistant_phone": "+4912345678",
      "call_id": "call_abc123",
      "timestamp": "2026-01-02T10:30:00Z",
      "status": "incoming",
      "variables": {
        "customer_name": "Anna Berg"
      }
    }
  ]
}
