{
  "package": "@activepieces/piece-famulor",
  "version": "0.2.6",
  "action": "campaign_control",
  "auth": {
    "type": "SECRET_TEXT",
    "secret_text": "test-key"
  },
  "inputs": {
    "campaign": 12,
    "campaign_id": 12,
    "action": "start"
  },
  "credential": {
    "apiKey": "test-key"
  },
  "answers": [
    {
      "status": 200,
      "body": {
        "message": "Campaign started successfully"
      }
    }
  ],
  "exchanges": [
    {
      "request": {
        "method": "POST",
        "url": "https://app.famulor.de/api/user/campaigns/update-status",
        "headers": {
          "authorization": "Bearer test-key",
          "content-type": "application/json"
        },
        "body": {
          "campaign_id": 12,
          "action": "start"
        }
      }
    }
  ],
  "output": {
    "message": "Campaign started successfully"
  }
}
