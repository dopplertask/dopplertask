{
  "package": "@activepieces/piece-famulor",
  "version": "0.2.6",
  "action": "create_campaign",
  "auth": {
    "type": "SECRET_TEXT",
    "secret_text": "test-key"
  },
  "inputs": {
    "name": "Spring outreach",
    "assistant_id": 33,
    "timezone": " Europe/Berlin ",
    "max_calls_in_parallel": 4,
    "allowed_hours_start_time": "08:30",
    "allowed_hours_end_time": "18:00",
    "allowed_days": [
      "monday",
      "wednesday"
    ],
    "max_retries": 2,
    "retry_interval": 90,
    "retry_on_voicemail": true,
    "retry_on_goal_incomplete": false,
    "goal_completion_variable": " booked ",
    "mark_complete_when_no_leads": true,
    "phone_number_ids": [
      7,
      8
    ]
  },
  "credential": {
    "apiKey": "test-key"
  },
  "answers": [
    {
      "status": 201,
      "body": {
        "message": "Campaign created",
        "data": {
          "id": 12,
          "name": "Spring outreach",
          "status": "draft"
        }
      }
    }
  ],
  "exchanges": [
    {
      "request": {
        "method": "POST",
        "url": "https://app.famulor.de/api/user/campaigns",
        "headers": {
          "authorization": "Bearer test-key",
          "content-type": "application/json"
        },
        "body": {
          "name": "Spring outreach",
          "assistant_id": 33,
          "timezone": "Europe/Berlin",
          "max_calls_in_parallel": 4,
          "allowed_hours_start_time": "08:30",
          "allowed_hours_end_time": "18:00",
          "allowed_days": [
            "monday",
            "wednesday"
          ],
          "max_retries": 2,
          "retry_interval": 90,
          "retry_on_voicemail": true,
          "retry_on_goal_incomplete": false,
          "goal_completion_variable": "booked",
          "mark_complete_when_no_leads": true,
          "phone_number_ids": [
            7,
            8
          ]
        }
      }
    }
  ],
  "output": {
    "message": "Campaign created",
    "data": {
      "id": 12,
      "name": "Spring outreach",
      "status": "draft"
    }
  }
}
