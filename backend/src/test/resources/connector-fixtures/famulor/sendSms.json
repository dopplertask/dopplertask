{
  "package": "@activepieces/piece-famulor",
  "version": "0.2.6",
  "action": "send_sms",
  "auth": {
    "type": "SECRET_TEXT",
    "secret_text": "test-key"
  },
  "inputs": {
    "from": 7,
    "to": "+4915112345678",
    "bodysuit": "Your appointment is confirmed for Monday."
  },
  "settings": {
    "from": 7,
    "to": "+4915112345678",
    "message": "Your appointment is confirmed for Monday."
  },
  "credential": {
    "apiKey": "test-key"
  },
  "answers": [
    {
      "status": 200,
      "body": {
        "message": "SMS sent successfully",
        "data": {
          "sms_id": 901,
          "segments": 1,
          "cost": 0.08
        }
      }
    }
  ],
  "exchanges": [
    {
      "request": {
        "method": "POST",
        "url": "https://app.famulor.de/api/user/sms",
        "headers": {
          "authorization": "Bearer test-key",
          "content-type": "application/json"
        },
        "body": {
          "from": 7,
          "to": "+4915112345678",
          "bodysuit": "Your appointment is confirmed for Monday."
        }
      }
    }
  ],
  "output": {
    "message": "SMS sent successfully",
    "data": {
      "sms_id": 901,
      "segments": 1,
      "cost": 0.08
    }
  }
}
