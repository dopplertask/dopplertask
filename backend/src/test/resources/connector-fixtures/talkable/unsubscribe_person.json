{
  "package": "@activepieces/piece-talkable",
  "version": "0.3.3",
  "action": "unsubscribe_person",
  "auth": {
    "type": "CUSTOM_AUTH",
    "props": {
      "site": "test-site",
      "api_key": "test-key"
    }
  },
  "inputs": {
    "email": "jane.doe"
  },
  "credential": {
    "site": "test-site",
    "api_key": "test-key"
  },
  "answers": [
    {
      "status": 200,
      "body": {
        "ok": true,
        "result": {
          "person": {
            "unsubscribed": true
          }
        }
      }
    }
  ],
  "exchanges": [
    {
      "request": {
        "method": "POST",
        "url": "https://www.talkable.com/api/v2/people/jane.doe/unsubscribe",
        "headers": {
          "authorization": "Bearer test-key",
          "content-type": "application/json"
        },
        "body": {
          "site_slug": "test-site"
        }
      }
    }
  ],
  "output": {
    "ok": true,
    "result": {
      "person": {
        "unsubscribed": true
      }
    }
  }
}
