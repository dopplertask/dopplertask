            }
          ]
        }
      }
    }
  ],
  "exchanges": [
    {
      "request": {
        "method": "GET",
        "url": "https://www.talkable.com/api/v2/people/jane.doe/rewards?site_slug=test-site",
        "headers": {
          "authorization": "Bearer test-key",
          "content-type": "application/json"
        },
        "body": null
      }
    }
  ],
  "output": {
    "ok": true,
    "result": {
      "rewards": [
        {
          "id": 1,
          "amount": 10
        }
      ]
    }
  }
