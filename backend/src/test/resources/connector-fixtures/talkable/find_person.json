{
  "package": "@activepieces/piece-talkable",
  "version": "0.3.3",
  "action": "find_person",
  "auth": {
    "type": "CUSTOM_AUTH",
    "props": {
      "site": "test-site",
      "api_key": "test-key"
    }
  },
  "inputs": {
    "email": "jane.doe",
    "scope": "rewards"
  },
  "credential": {
    "site": "test-site",
    "api_key": "test-key"
  },
  "answers": [
    {
      "status": 200,
      "body": {
        "ok": true,
