{
  "package": "@activepieces/piece-talkable",
  "version": "0.3.3",
  "action": "find_person",
  "auth": {
    "type": "CUSTOM_AUTH",
    "props": {
      "site": "test-site",
      "api_key": "test-key"
    }
  },
  "inputs": {
    "email": "jane.doe",
    "scope": "/"
  },
  "credential": {
    "site": "test-site",
    "api_key": "test-key"
  },
  "answers": [
    {
      "status": 200,
      "body": {
        "ok": true,
        "result": {
          "person": {
            "email": "jane.doe",
            "first_name": "Jane"
          }
        }
      }
    }
  ],
  "exchanges": [
    {
      "request": {
        "method": "GET",
        "url": "https://www.talkable.com/api/v2/people/jane.doe/?site_slug=test-site",
        "headers": {
          "authorization": "Bearer test-key",
          "content-type": "application/json"
        },
        "body": null
      }
    }
  ],
  "output": {
    "ok": true,
    "result": {
      "person": {
        "email": "jane.doe",
        "first_name": "Jane"
      }
    }
  }
}
