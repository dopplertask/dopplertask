{
  "package": "@activepieces/piece-talkable",
  "version": "0.3.3",
  "action": "update-referral-status",
  "auth": {
    "type": "CUSTOM_AUTH",
    "props": {
      "site": "test-site",
      "api_key": "test-key"
    }
  },
  "inputs": {
    "origin_slug": "ORD-1",
    "status": "approved"
  },
  "credential": {
    "site": "test-site",
    "api_key": "test-key"
  },
  "answers": [
    {
      "status": 200,
      "body": {
        "ok": true,
        "result": {
          "referral": {
            "status": "approved"
          }
        }
      }
    }
  ],
  "exchanges": [
    {
      "request": {
        "method": "POST",
        "url": "https://www.talkable.com/api/v2/origins/ORD-1/referral",
        "headers": {
          "authorization": "Bearer test-key",
          "content-type": "application/json"
        },
        "body": {
          "site_slug": "test-site",
          "status": "approved"
        }
      }
    }
  ],
  "output": {
    "ok": true,
    "result": {
      "referral": {
        "status": "approved"
      }
    }
  }
}
