{
  "package": "@activepieces/piece-talkable",
  "version": "0.3.3",
  "action": "claim-offer",
  "auth": {
    "type": "CUSTOM_AUTH",
    "props": {
      "site": "test-site",
      "api_key": "test-key"
    }
  },
  "inputs": {
    "advocate_email": "adv@example.com",
    "friend_email": "friend@example.com",
    "campaign_tag": "invite"
  },
  "credential": {
    "site": "test-site",
    "api_key": "test-key"
  },
  "answers": [
    {
      "status": 200,
      "body": {
        "ok": true,
        "result": {
          "offer_claim": {
            "id": 5
          }
        }
      }
    }
  ],
  "exchanges": [
    {
      "request": {
        "method": "POST",
        "url": "https://www.talkable.com/api/v2/offer_claims",
        "headers": {
          "authorization": "Bearer test-key",
          "content-type": "application/json"
        },
        "body": {
          "site_slug": "test-site",
          "advocate_email": "adv@example.com",
          "friend_email": "friend@example.com",
          "campaign_tag": "invite"
        }
      }
    }
  ],
  "output": {
    "ok": true,
    "result": {
      "offer_claim": {
        "id": 5
      }
    }
  }
}
