{
  "package": "@activepieces/piece-talkable",
  "version": "0.3.3",
  "action": "create_purchases_batch",
  "auth": {
    "type": "CUSTOM_AUTH",
    "props": {
      "site": "test-site",
      "api_key": "test-key"
    }
  },
  "inputs": {
    "create_offers": true,
    "purchases": [
      {
        "email": "jane@example.com",
        "order_number": "ORD-1",
        "subtotal": 20.5
      }
    ]
  },
  "credential": {
    "site": "test-site",
    "api_key": "test-key"
  },
  "answers": [
    {
      "status": 200,
      "body": {
        "ok": true,
        "result": {
          "origins": [
            {
              "id": 77
            }
          ]
        }
      }
    }
  ],
  "exchanges": [
    {
      "request": {
        "method": "POST",
        "url": "https://www.talkable.com/api/v2/origins/batch/purchases",
        "headers": {
          "authorization": "Bearer test-key",
          "content-type": "application/json"
        },
        "body": {
          "site_slug": "test-site",
          "data": [
            {
              "email": "jane@example.com",
              "order_number": "ORD-1",
              "subtotal": 20.5
            }
          ],
          "create_offers": true
        }
      }
    }
  ],
  "output": {
    "ok": true,
    "result": {
      "origins": [
        {
          "id": 77
        }
      ]
    }
  }
}
