{
  "package": "@activepieces/piece-gitlab",
  "version": "0.4.4",
  "action": "set_user_status",
  "auth": {
    "access_token": "test-token",
    "data": {}
  },
  "inputs": {
    "message": "Out for lunch",
    "clearMessage": false,
    "emoji": ":pizza:",
    "clearEmoji": false,
    "availability": "busy",
    "clearStatusAfter": "3_hours",
    "clearAll": false
  },
  "settings": {
    "message": "Out for lunch",
    "clearMessage": "false",
    "emoji": ":pizza:",
    "clearEmoji": "false",
    "availability": "busy",
    "clearStatusAfter": "3_hours",
    "clearAll": "false"
  },
  "credential": {
    "oauthAccessToken": "test-token"
  },
  "answers": [
    {
      "status": 200,
      "body": {
        "emoji": "coffee",
        "message": "In a meeting",
        "availability": "not_set",
        "clear_status_at": null
      }
    },
    {
      "status": 200,
      "body": {
        "emoji": "pizza",
        "message": "Out for lunch",
        "availability": "busy"
      }
    }
  ],
  "exchanges": [
    {
      "request": {
        "method": "GET",
        "url": "https://gitlab.com/api/v4/user/status",
        "headers": {
          "authorization": "Bearer test-token"
        },
        "body": null
      }
    },
    {
      "request": {
        "method": "PUT",
        "url": "https://gitlab.com/api/v4/user/status",
        "headers": {
          "authorization": "Bearer test-token",
          "content-type": "application/json"
        },
        "body": {
          "message": "Out for lunch",
          "emoji": "pizza",
          "availability": "busy",
          "clear_status_after": "3_hours"
        }
      }
    }
  ],
  "output": {
    "emoji": "pizza",
    "message": "Out for lunch",
    "availability": "busy"
  }
}
