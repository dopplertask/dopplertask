{
  "package": "@activepieces/piece-gitlab",
  "version": "0.4.4",
  "action": "unprotect_branch",
  "auth": {
    "access_token": "test-token",
    "data": {}
  },
  "inputs": {
    "projectId": "ada/demo",
    "name": "release/*"
  },
  "credential": {
    "oauthAccessToken": "test-token"
  },
  "answers": [
    {
      "status": 200,
      "body": ""
    }
  ],
  "exchanges": [
    {
      "request": {
        "method": "DELETE",
        "url": "https://gitlab.com/api/v4/projects/ada%2Fdemo/protected_branches/release%2F*",
        "headers": {
          "authorization": "Bearer test-token"
        },
        "body": null
      }
    }
  ],
  "output": {
    "unprotected": true,
    "alreadyUnprotected": false,
    "name": "release/*"
  }
}
