{
  "package": "@activepieces/piece-gitlab",
  "version": "0.4.4",
  "action": "create_file",
  "auth": {
    "access_token": "test-token",
    "data": {}
  },
  "inputs": {
    "projectId": "ada/demo",
    "filePath": "docs/read me.md",
    "branch": "main",
    "content": "# Hello\n",
    "commitMessage": "Add readme",
    "encoding": "text",
    "startBranch": "develop",
    "authorName": "Ada",
    "authorEmail": "ada@example.com"
  },
  "credential": {
    "oauthAccessToken": "test-token"
  },
  "answers": [
    {
      "status": 201,
      "body": {
        "file_path": "docs/read me.md",
        "branch": "main"
      }
    }
  ],
  "exchanges": [
    {
      "request": {
        "method": "POST",
        "url": "https://gitlab.com/api/v4/projects/ada%2Fdemo/repository/files/docs%2Fread%20me.md",
        "headers": {
          "authorization": "Bearer test-token",
          "content-type": "application/json"
        },
        "body": {
          "branch": "main",
          "content": "# Hello\n",
          "commit_message": "Add readme",
          "encoding": "text",
          "start_branch": "develop",
          "author_name": "Ada",
          "author_email": "ada@example.com"
        }
      }
    }
  ],
  "output": {
    "file_path": "docs/read me.md",
    "branch": "main"
  }
}
