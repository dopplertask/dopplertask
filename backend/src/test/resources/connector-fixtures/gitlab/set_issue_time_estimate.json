{
  "package": "@activepieces/piece-gitlab",
  "version": "0.4.4",
  "action": "set_issue_time_estimate",
  "auth": {
    "access_token": "test-token",
    "data": {}
  },
  "inputs": {
    "projectId": "ada/demo",
    "issueIid": 7,
    "duration": "2d"
  },
  "settings": {
    "projectId": "ada/demo",
    "issueIid": "7",
    "duration": "2d"
  },
  "credential": {
    "oauthAccessToken": "test-token"
  },
  "answers": [
    {
      "status": 200,
      "body": {
        "time_estimate": 5400,
        "total_time_spent": 3600,
        "human_time_estimate": "1h30m",
        "human_total_time_spent": "1h"
      }
    }
  ],
  "exchanges": [
    {
      "request": {
        "method": "POST",
        "url": "https://gitlab.com/api/v4/projects/ada%2Fdemo/issues/7/time_estimate",
        "headers": {
          "authorization": "Bearer test-token",
          "content-type": "application/json"
        },
        "body": {
          "duration": "2d"
        }
      }
    }
  ],
  "output": {
    "time_estimate": 5400,
    "total_time_spent": 3600,
    "human_time_estimate": "1h30m",
    "human_total_time_spent": "1h"
  }
}
