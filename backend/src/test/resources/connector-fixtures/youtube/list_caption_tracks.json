{
  "package": "@activepieces/piece-youtube",
  "version": "0.9.4",
  "action": "list_caption_tracks",
  "auth": {
    "access_token": "test-token",
    "data": {}
  },
  "inputs": {
    "videoId": "vid-1",
    "captionIds": "cap-1,cap-2",
    "onBehalfOfContentOwner": "owner-1"
  },
  "credential": {
    "oauthAccessToken": "test-token"
  },
  "answers": [
    {
      "status": 200,
      "body": {
        "kind": "youtube#captionListResponse",
        "etag": "etag-list",
        "pageInfo": {
          "totalResults": 1,
          "resultsPerPage": 25
        },
        "items": [
          {
            "kind": "youtube#caption",
            "etag": "e1",
            "id": "cap-1",
            "snippet": {
              "language": "en",
              "name": "English"
            }
          }
        ]
      }
    }
  ],
  "exchanges": [
    {
      "request": {
        "method": "GET",
        "url": "https://www.googleapis.com/youtube/v3/captions?part=id%2Csnippet&videoId=vid-1&id=cap-1%2Ccap-2&onBehalfOfContentOwner=owner-1",
        "headers": {
          "authorization": "Bearer test-token"
        },
        "body": null
      }
    }
  ],
  "output": {
    "kind": "youtube#captionListResponse",
    "etag": "etag-list",
    "pageInfo": {
      "totalResults": 1,
      "resultsPerPage": 25
    },
    "items": [
      {
        "kind": "youtube#caption",
        "etag": "e1",
        "id": "cap-1",
        "snippet": {
          "language": "en",
          "name": "English"
        }
      }
    ]
  }
}
