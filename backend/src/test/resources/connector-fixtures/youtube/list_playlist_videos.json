{
  "package": "@activepieces/piece-youtube",
  "version": "0.9.4",
  "action": "list_playlist_videos",
  "auth": {
    "access_token": "test-token",
    "data": {}
  },
  "inputs": {
    "playlistId": "",
    "itemIds": "item-1,item-2",
    "maxResults": 5,
    "pageToken": "",
    "videoId": ""
  },
  "credential": {
    "oauthAccessToken": "test-token"
  },
  "answers": [
    {
      "status": 200,
      "body": {
        "kind": "youtube#playlistItemListResponse",
        "etag": "etag-list",
        "pageInfo": {
          "totalResults": 1,
          "resultsPerPage": 25
        },
        "items": [
          {
            "kind": "youtube#playlistItem",
            "etag": "e1",
            "id": "item-1",
            "snippet": {
              "title": "First video",
              "position": 0
            }
          }
        ]
      }
    }
  ],
  "exchanges": [
    {
      "request": {
        "method": "GET",
        "url": "https://www.googleapis.com/youtube/v3/playlistItems?part=snippet%2CcontentDetails%2Cstatus&id=item-1%2Citem-2&maxResults=5",
        "headers": {
          "authorization": "Bearer test-token"
        },
        "body": null
      }
    }
  ],
  "output": {
    "kind": "youtube#playlistItemListResponse",
    "etag": "etag-list",
    "pageInfo": {
      "totalResults": 1,
      "resultsPerPage": 25
    },
    "items": [
      {
        "kind": "youtube#playlistItem",
        "etag": "e1",
        "id": "item-1",
        "snippet": {
          "title": "First video",
          "position": 0
        }
      }
    ]
  }
}
