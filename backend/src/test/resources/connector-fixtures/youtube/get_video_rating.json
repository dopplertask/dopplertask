{
  "package": "@activepieces/piece-youtube",
  "version": "0.9.4",
  "action": "get_video_rating",
  "auth": {
    "access_token": "test-token",
    "data": {}
  },
  "inputs": {
    "videoIds": "vid-1,vid-2"
  },
  "credential": {
    "oauthAccessToken": "test-token"
  },
  "answers": [
    {
      "status": 200,
      "body": {
        "kind": "youtube#videoGetRatingResponse",
        "etag": "e1",
        "items": [
          {
            "videoId": "vid-1",
            "rating": "like"
          },
          {
            "videoId": "vid-2",
            "rating": "none"
          }
        ]
      }
    }
  ],
  "exchanges": [
    {
      "request": {
        "method": "GET",
        "url": "https://www.googleapis.com/youtube/v3/videos/getRating?id=vid-1%2Cvid-2",
        "headers": {
          "authorization": "Bearer test-token"
        },
        "body": null
      }
    }
  ],
  "output": {
    "kind": "youtube#videoGetRatingResponse",
    "etag": "e1",
    "items": [
      {
        "videoId": "vid-1",
        "rating": "like"
      },
      {
        "videoId": "vid-2",
        "rating": "none"
      }
    ]
  }
}
