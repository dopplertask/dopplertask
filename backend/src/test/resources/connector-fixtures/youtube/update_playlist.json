{
  "package": "@activepieces/piece-youtube",
  "version": "0.9.4",
  "action": "update_playlist",
  "auth": {
    "access_token": "test-token",
    "data": {}
  },
  "inputs": {
    "playlistId": "PL-list-1",
    "title": "New title",
    "description": "",
    "tagsMode": "replace",
    "tags": [
      "padel",
      "tips"
    ],
    "privacyStatus": "public",
    "defaultLanguage": ""
  },
  "credential": {
    "oauthAccessToken": "test-token"
  },
  "answers": [
    {
      "status": 200,
      "body": {
        "kind": "youtube#playlistListResponse",
        "etag": "etag-list",
        "pageInfo": {
          "totalResults": 1,
          "resultsPerPage": 25
        },
        "items": [
          {
            "kind": "youtube#playlist",
            "etag": "etag-pl-1",
            "id": "PL-list-1",
            "snippet": {
              "title": "Old title",
              "description": "Old description",
              "defaultLanguage": "sv",
              "tags": [
                "old"
              ]
            },
            "status": {
              "privacyStatus": "private"
            }
          }
        ]
      }
    },
    {
      "status": 200,
      "body": {
        "kind": "youtube#playlist",
        "etag": "etag-pl-2",
        "id": "PL-list-1",
        "snippet": {
          "title": "New title"
        },
        "status": {
          "privacyStatus": "public"
        }
      }
    }
  ],
  "exchanges": [
    {
      "request": {
        "method": "GET",
        "url": "https://www.googleapis.com/youtube/v3/playlists?part=snippet%2Cstatus&id=PL-list-1",
        "headers": {
          "authorization": "Bearer test-token"
        },
        "body": null
      }
    },
    {
      "request": {
        "method": "PUT",
        "url": "https://www.googleapis.com/youtube/v3/playlists?part=snippet%2Cstatus",
        "headers": {
          "authorization": "Bearer test-token",
          "cache-control": "no-cache",
          "content-type": "application/json",
          "if-match": "etag-pl-1",
          "pragma": "no-cache"
        },
        "body": {
          "id": "PL-list-1",
          "snippet": {
            "title": "New title",
            "description": "Old description",
            "defaultLanguage": "sv",
            "tags": [
              "padel",
              "tips"
            ]
          },
          "status": {
            "privacyStatus": "public"
          }
        }
      }
    }
  ],
  "output": {
    "kind": "youtube#playlist",
    "etag": "etag-pl-2",
    "id": "PL-list-1",
    "snippet": {
      "title": "New title"
    },
    "status": {
      "privacyStatus": "public"
    }
  }
}
