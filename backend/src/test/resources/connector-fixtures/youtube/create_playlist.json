{
  "package": "@activepieces/piece-youtube",
  "version": "0.9.4",
  "action": "create_playlist",
  "auth": {
    "access_token": "test-token",
    "data": {}
  },
  "inputs": {
    "title": "Padel tips",
    "description": "Short padel lessons",
    "privacyStatus": "unlisted",
    "defaultLanguage": "en"
  },
  "credential": {
    "oauthAccessToken": "test-token"
  },
  "answers": [
    {
      "status": 200,
      "body": {
        "kind": "youtube#playlist",
        "etag": "e1",
        "id": "PL-new-1",
        "snippet": {
          "title": "Padel tips"
        },
        "status": {
          "privacyStatus": "unlisted"
        }
      }
    }
  ],
  "exchanges": [
    {
      "request": {
        "method": "POST",
        "url": "https://www.googleapis.com/youtube/v3/playlists?part=snippet%2Cstatus",
        "headers": {
          "authorization": "Bearer test-token",
          "content-type": "application/json"
        },
        "body": {
          "snippet": {
            "title": "Padel tips",
            "description": "Short padel lessons",
            "defaultLanguage": "en"
          },
          "status": {
            "privacyStatus": "unlisted"
          }
        }
      }
    }
  ],
  "output": {
    "kind": "youtube#playlist",
    "etag": "e1",
    "id": "PL-new-1",
    "snippet": {
      "title": "Padel tips"
    },
    "status": {
      "privacyStatus": "unlisted"
    }
  }
}
