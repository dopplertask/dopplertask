{
  "package": "@activepieces/piece-youtube",
  "version": "0.9.4",
  "action": "add_video_to_playlist",
  "auth": {
    "access_token": "test-token",
    "data": {}
  },
  "inputs": {
    "playlistId": "PL-list-1",
    "videoId": "vid-1",
    "position": 2
  },
  "credential": {
    "oauthAccessToken": "test-token"
  },
  "answers": [
    {
      "status": 200,
      "body": {
        "kind": "youtube#playlistItem",
        "etag": "e1",
        "id": "item-9",
        "snippet": {
          "playlistId": "PL-list-1",
          "position": 2,
          "resourceId": {
            "kind": "youtube#video",
            "videoId": "vid-1"
          }
        }
      }
    }
  ],
  "exchanges": [
    {
      "request": {
        "method": "POST",
        "url": "https://www.googleapis.com/youtube/v3/playlistItems?part=snippet",
        "headers": {
          "authorization": "Bearer test-token",
          "content-type": "application/json"
        },
        "body": {
          "snippet": {
            "playlistId": "PL-list-1",
            "resourceId": {
              "kind": "youtube#video",
              "videoId": "vid-1"
            },
            "position": 2
          }
        }
      }
    }
  ],
  "output": {
    "kind": "youtube#playlistItem",
    "etag": "e1",
    "id": "item-9",
    "snippet": {
      "playlistId": "PL-list-1",
      "position": 2,
      "resourceId": {
        "kind": "youtube#video",
        "videoId": "vid-1"
      }
    }
  }
}
