{
  "package": "@activepieces/piece-youtube",
  "version": "0.9.4",
  "action": "reply_to_comment",
  "auth": {
    "access_token": "test-token",
    "data": {}
  },
  "inputs": {
    "parentCommentId": "com-1",
    "text": "Thanks!"
  },
  "credential": {
    "oauthAccessToken": "test-token"
  },
  "answers": [
    {
      "status": 200,
      "body": {
        "kind": "youtube#comment",
        "etag": "e1",
        "id": "com-1.reply-1",
        "snippet": {
          "parentId": "com-1",
          "textOriginal": "Thanks!"
        }
      }
    }
  ],
  "exchanges": [
    {
      "request": {
        "method": "POST",
        "url": "https://www.googleapis.com/youtube/v3/comments?part=snippet",
        "headers": {
          "authorization": "Bearer test-token",
          "content-type": "application/json"
        },
        "body": {
          "snippet": {
            "parentId": "com-1",
            "textOriginal": "Thanks!"
          }
        }
      }
    }
  ],
  "output": {
    "kind": "youtube#comment",
    "etag": "e1",
    "id": "com-1.reply-1",
    "snippet": {
      "parentId": "com-1",
      "textOriginal": "Thanks!"
    }
  }
}
