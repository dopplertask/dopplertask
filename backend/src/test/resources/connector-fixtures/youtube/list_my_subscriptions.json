{
  "package": "@activepieces/piece-youtube",
  "version": "0.9.4",
  "action": "list_my_subscriptions",
  "auth": {
    "access_token": "test-token",
    "data": {}
  },
  "inputs": {
    "order": "alphabetical",
    "forChannelId": "UC-chan-2",
    "maxResults": 10,
    "pageToken": "page-2"
  },
  "credential": {
    "oauthAccessToken": "test-token"
  },
  "answers": [
    {
      "status": 200,
      "body": {
        "kind": "youtube#subscriptionListResponse",
        "etag": "etag-list",
        "pageInfo": {
          "totalResults": 1,
          "resultsPerPage": 25
        },
        "items": [
          {
            "kind": "youtube#subscription",
            "etag": "e1",
            "id": "sub-1",
            "snippet": {
              "title": "Other channel"
            }
          }
        ]
      }
    }
  ],
  "exchanges": [
    {
      "request": {
        "method": "GET",
        "url": "https://www.googleapis.com/youtube/v3/subscriptions?part=snippet%2CcontentDetails&mine=true&maxResults=10&order=alphabetical&forChannelId=UC-chan-2&pageToken=page-2",
        "headers": {
          "authorization": "Bearer test-token"
        },
        "body": null
      }
    }
  ],
  "output": {
    "kind": "youtube#subscriptionListResponse",
    "etag": "etag-list",
    "pageInfo": {
      "totalResults": 1,
      "resultsPerPage": 25
    },
    "items": [
      {
        "kind": "youtube#subscription",
        "etag": "e1",
        "id": "sub-1",
        "snippet": {
          "title": "Other channel"
        }
      }
    ]
  }
}
