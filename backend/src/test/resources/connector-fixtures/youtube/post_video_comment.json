{
  "package": "@activepieces/piece-youtube",
  "version": "0.9.4",
  "action": "post_video_comment",
  "auth": {
    "access_token": "test-token",
    "data": {}
  },
  "inputs": {
    "videoId": "vid-1",
    "text": "Great rally!"
  },
  "credential": {
    "oauthAccessToken": "test-token"
  },
  "answers": [
    {
      "status": 200,
      "body": {
        "kind": "youtube#commentThread",
        "etag": "e1",
        "id": "thread-9",
        "snippet": {
          "videoId": "vid-1"
        }
      }
    }
  ],
  "exchanges": [
    {
      "request": {
        "method": "POST",
        "url": "https://www.googleapis.com/youtube/v3/commentThreads?part=snippet",
        "headers": {
          "authorization": "Bearer test-token",
          "content-type": "application/json"
        },
        "body": {
          "snippet": {
            "videoId": "vid-1",
            "topLevelComment": {
              "snippet": {
                "textOriginal": "Great rally!"
              }
            }
          }
        }
      }
    }
  ],
  "output": {
    "kind": "youtube#commentThread",
    "etag": "e1",
    "id": "thread-9",
    "snippet": {
      "videoId": "vid-1"
    }
  }
}
