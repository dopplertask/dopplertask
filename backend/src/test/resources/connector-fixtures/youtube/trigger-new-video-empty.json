    "_seenVideoIds": [
      "yt:video:oldVideo0001"
    ],
    "seen": [
      "yt:video:oldVideo0001"
    ]
  },
  "auth": {
    "access_token": "test-token",
    "data": {}
  },
  "credential": {
    "oauthAccessToken": "test-token"
  },
  "answers": [
    {
      "status": 200,
      "body": "<?xml version=\"1.0\" encoding=\"UTF-8\"?>\n<feed xmlns:yt=\"http://www.youtube.com/xml/schemas/2015\" xmlns:media=\"http://search.yahoo.com/mrss/\" xmlns=\"http://www.w3.org/2005/Atom\">\n <title>Fake Channel</title>\n</feed>\n"
    }
  ],
  "exchanges": [
    {
      "request": {
        "method": "GET",
        "url": "https://www.youtube.com/feeds/videos.xml?channel_id=UCfakeChannel000000000001",
        "headers": {},
        "body": null
      }
    }
  ],
  "output": [],
  "storeAfter": {
    "channelId": "UCfakeChannel000000000001",
    "_seenVideoIds": [
      "yt:video:oldVideo0001"
    ],
    "seen": [
      "yt:video:oldVideo0001"
    ]
