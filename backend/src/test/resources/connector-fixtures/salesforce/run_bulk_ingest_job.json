{
  "package": "@activepieces/piece-salesforce",
  "version": "0.10.2",
  "action": "run_bulk_ingest_job",
  "auth": {
    "access_token": "test-token",
    "data": {
      "instance_url": "https://acme.my.salesforce.com"
    }
  },
  "inputs": {
    "object": " Account ",
    "operation": "upsert",
    "external_id_field": "External_Id__c",
    "csv": "External_Id__c,Name\r\nA-1,Acme\r\nA-2,Globex\r\n"
  },
  "credential": {
    "oauthAccessToken": "test-token",
    "instanceUrl": "acme.my.salesforce.com"
  },
  "answers": [
    {
      "status": 200,
      "body": {
        "id": "750000000000003AAA",
        "state": "Open",
        "object": "Account",
        "operation": "upsert"
      }
    },
    {
      "status": 201,
      "body": ""
    },
    {
      "status": 200,
      "body": {
        "id": "750000000000003AAA",
        "state": "UploadComplete",
        "object": "Account",
        "operation": "upsert"
      }
    }
  ],
  "exchanges": [
    {
      "request": {
        "method": "POST",
        "url": "https://acme.my.salesforce.com/services/data/v58.0/jobs/ingest",
        "headers": {
          "authorization": "Bearer test-token",
          "content-type": "application/json"
        },
        "body": {
          "object": "Account",
          "operation": "upsert",
          "contentType": "CSV",
          "lineEnding": "LF",
          "externalIdFieldName": "External_Id__c"
        }
      }
    },
    {
      "request": {
        "method": "PUT",
        "url": "https://acme.my.salesforce.com/services/data/v58.0/jobs/ingest/750000000000003AAA/batches",
        "headers": {
          "authorization": "Bearer test-token",
          "content-type": "text/csv"
        },
        "body": "External_Id__c,Name\nA-1,Acme\nA-2,Globex\n"
      }
    },
    {
      "request": {
        "method": "PATCH",
        "url": "https://acme.my.salesforce.com/services/data/v58.0/jobs/ingest/750000000000003AAA",
        "headers": {
          "authorization": "Bearer test-token",
          "content-type": "application/json"
        },
        "body": {
          "state": "UploadComplete"
        }
      }
    }
  ],
  "output": {
    "job_id": "750000000000003AAA",
    "state": "UploadComplete",
    "object": "Account",
    "operation": "upsert"
  }
}
