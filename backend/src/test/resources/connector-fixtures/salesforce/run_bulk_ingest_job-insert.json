{
  "package": "@activepieces/piece-salesforce",
  "version": "0.10.2",
  "action": "run_bulk_ingest_job",
  "auth": {
    "access_token": "test-token",
    "data": {
      "instance_url": "https://acme.my.salesforce.com"
    }
  },
  "inputs": {
    "object": "Contact",
    "operation": "insert",
    "csv": "LastName,Email\nDoe,doe@example.com\n"
  },
  "credential": {
    "oauthAccessToken": "test-token",
    "instanceUrl": "acme.my.salesforce.com"
  },
  "answers": [
    {
      "status": 200,
      "body": {
        "id": "750000000000004AAA",
        "state": "Open"
      }
    },
    {
      "status": 201,
      "body": ""
    },
    {
      "status": 200,
      "body": ""
    }
  ],
  "exchanges": [
    {
      "request": {
        "method": "POST",
        "url": "https://acme.my.salesforce.com/services/data/v58.0/jobs/ingest",
        "headers": {
          "authorization": "Bearer test-token",
          "content-type": "application/json"
        },
        "body": {
          "object": "Contact",
          "operation": "insert",
          "contentType": "CSV",
          "lineEnding": "LF"
        }
      }
    },
    {
      "request": {
        "method": "PUT",
        "url": "https://acme.my.salesforce.com/services/data/v58.0/jobs/ingest/750000000000004AAA/batches",
        "headers": {
          "authorization": "Bearer test-token",
          "content-type": "text/csv"
        },
        "body": "LastName,Email\nDoe,doe@example.com\n"
      }
    },
    {
      "request": {
        "method": "PATCH",
        "url": "https://acme.my.salesforce.com/services/data/v58.0/jobs/ingest/750000000000004AAA",
        "headers": {
          "authorization": "Bearer test-token",
          "content-type": "application/json"
        },
        "body": {
          "state": "UploadComplete"
        }
      }
    }
  ],
  "output": {
    "job_id": "750000000000004AAA",
    "state": "UploadComplete",
    "object": "Contact",
    "operation": "insert"
  }
}
