{
  "package": "@activepieces/piece-salesforce",
  "version": "0.10.2",
  "action": "get_current_user",
  "auth": {
    "access_token": "test-token",
    "data": {
      "instance_url": "https://acme.my.salesforce.com"
    }
  },
  "inputs": {},
  "credential": {
    "oauthAccessToken": "test-token",
    "instanceUrl": "acme.my.salesforce.com"
  },
  "answers": [
    {
      "status": 200,
      "body": {
        "user_id": "005000000000001AAA",
        "organization_id": "00D000000000001AAA",
        "preferred_username": "jane@example.com",
        "name": "Jane Doe",
        "email": "jane@example.com",
        "locale": "en_US",
        "zoneinfo": "Europe/Stockholm",
        "user_type": "STANDARD",
        "extra": 1
      }
    }
  ],
  "exchanges": [
    {
      "request": {
        "method": "GET",
        "url": "https://acme.my.salesforce.com/services/oauth2/userinfo",
        "headers": {
          "authorization": "Bearer test-token"
        },
        "body": null
      }
    }
  ],
  "output": {
    "user_id": "005000000000001AAA",
    "organization_id": "00D000000000001AAA",
    "username": "jane@example.com",
    "name": "Jane Doe",
    "email": "jane@example.com",
    "locale": "en_US",
    "zoneinfo": "Europe/Stockholm",
    "user_type": "STANDARD"
  }
}
