{
  "package": "@activepieces/piece-stripe",
  "version": "0.9.1",
  "action": "create_checkout_session",
  "auth": {
    "type": "SECRET_TEXT",
    "secret_text": "sk_test_fake123"
  },
  "inputs": {
    "mode": "payment",
    "line_items": [
      {
        "price": "price_1",
        "quantity": 2
      },
      {
        "price": "price_2",
        "quantity": 1
      }
    ],
    "success_url": "https://example.com/ok",
    "cancel_url": "https://example.com/cancel",
    "customer": "cus_1"
  },
  "credential": {
    "secretKey": "sk_test_fake123"
  },
  "answers": [
    {
      "status": 200,
      "body": {
        "id": "obj_1",
        "object": "thing",
        "livemode": false
      }
    }
  ],
  "exchanges": [
    {
      "request": {
        "method": "POST",
        "url": "https://api.stripe.com/v1/checkout/sessions",
        "headers": {
          "authorization": "Bearer sk_test_fake123",
          "content-type": "application/x-www-form-urlencoded"
        },
        "body": "mode=payment&success_url=https%3A%2F%2Fexample.com%2Fok&cancel_url=https%3A%2F%2Fexample.com%2Fcancel&customer=cus_1&line_items%5B0%5D%5Bprice%5D=price_1&line_items%5B0%5D%5Bquantity%5D=2&line_items%5B1%5D%5Bprice%5D=price_2&line_items%5B1%5D%5Bquantity%5D=1"
      }
    }
  ],
  "output": {
    "id": "obj_1",
    "object": "thing",
    "livemode": false
  }
}
