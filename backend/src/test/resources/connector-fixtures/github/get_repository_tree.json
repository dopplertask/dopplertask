{
  "package": "@activepieces/piece-github",
  "version": "0.11.1",
  "action": "get_repository_tree",
  "auth": {
    "access_token": "test-token",
    "data": {}
  },
  "inputs": {
    "owner": "octo",
    "repo": "hello",
    "tree_sha": "main",
    "recursive": true
  },
  "credential": {
    "oauthAccessToken": "test-token"
  },
  "answers": [
    {
      "status": 200,
      "body": {
        "sha": "tree1",
        "tree": [
          {
            "path": "README.md",
            "type": "blob"
          }
        ],
        "truncated": false
      }
    }
  ],
  "exchanges": [
    {
      "request": {
        "method": "GET",
        "url": "https://api.github.com/repos/octo/hello/git/trees/main?recursive=1",
        "headers": {
          "authorization": "Bearer test-token"
        },
        "body": null
      }
    }
  ],
  "output": {
    "sha": "tree1",
    "tree": [
      {
        "path": "README.md",
        "type": "blob"
      }
    ],
    "truncated": false
  }
}
