{
  "package": "@activepieces/piece-github",
  "version": "0.11.1",
  "action": "list_languages",
  "auth": {
    "access_token": "test-token",
    "data": {}
  },
  "inputs": {
    "owner": "octo",
    "repo": "hello"
  },
  "credential": {
    "oauthAccessToken": "test-token"
  },
  "answers": [
    {
      "status": 200,
      "body": {
        "TypeScript": 12000,
        "CSS": 800
      }
    }
  ],
  "exchanges": [
    {
      "request": {
        "method": "GET",
        "url": "https://api.github.com/repos/octo/hello/languages",
        "headers": {
          "authorization": "Bearer test-token"
        },
        "body": null
      }
    }
  ],
  "output": {
    "TypeScript": 12000,
    "CSS": 800
  }
}
