{
  "package": "@activepieces/piece-github",
  "version": "0.11.1",
  "action": "trigger_workflow_dispatch",
  "auth": {
    "access_token": "test-token",
    "data": {}
  },
  "inputs": {
    "repository": {
      "owner": "octo",
      "repo": "hello"
    },
    "workflow": {
      "id": 42,
      "path": ".github/workflows/deploy.yml"
    },
    "ref": "main",
    "inputs": {
      "environment": "staging"
    },
    "waitForCompletion": false
  },
  "settings": {
    "repository": "octo/hello",
    "workflow": "42",
    "ref": "main",
    "inputs": {
      "environment": "staging"
    }
  },
  "credential": {
    "oauthAccessToken": "test-token"
  },
  "answers": [
    {
      "status": 200,
      "body": {
        "workflow_run_id": 99
      }
    },
    {
      "status": 200,
      "body": {
        "id": 99,
        "status": "queued",
        "conclusion": null,
        "html_url": "https://github.com/octo/hello/actions/runs/99"
      }
    }
  ],
  "exchanges": [
    {
      "request": {
        "method": "POST",
        "url": "https://api.github.com/repos/octo/hello/actions/workflows/42/dispatches",
        "headers": {
          "authorization": "Bearer test-token",
          "content-type": "application/json"
        },
        "body": {
          "ref": "main",
          "inputs": {
            "environment": "staging"
          },
          "return_run_details": true
        }
      }
    },
    {
      "request": {
        "method": "GET",
        "url": "https://api.github.com/repos/octo/hello/actions/runs/99",
        "headers": {
          "authorization": "Bearer test-token"
        },
        "body": null
      }
    }
  ],
  "output": {
    "id": 99,
    "status": "queued",
    "conclusion": null,
    "html_url": "https://github.com/octo/hello/actions/runs/99"
  }
}
