{
  "package": "@activepieces/piece-github",
  "version": "0.11.1",
  "action": "remove_assignees_from_issue",
  "auth": {
    "access_token": "test-token",
    "data": {}
  },
  "inputs": {
    "owner": "octo",
    "repo": "hello",
    "issue_number": 7,
    "assignees": [
      "ada",
      "bob"
    ]
  },
  "credential": {
    "oauthAccessToken": "test-token"
  },
  "answers": [
    {
      "status": 200,
      "body": {
        "id": 1,
        "number": 7,
        "title": "Login fails",
        "state": "open",
        "assignees": [],
        "html_url": "https://github.com/octo/hello/issues/7"
      }
    }
  ],
  "exchanges": [
    {
      "request": {
        "method": "DELETE",
        "url": "https://api.github.com/repos/octo/hello/issues/7/assignees",
        "headers": {
          "authorization": "Bearer test-token",
          "content-type": "application/json"
        },
        "body": {
          "assignees": [
            "ada",
            "bob"
          ]
        }
      }
    }
  ],
  "output": {
    "id": 1,
    "number": 7,
    "title": "Login fails",
    "state": "open",
    "assignees": [],
    "html_url": "https://github.com/octo/hello/issues/7"
  }
}
