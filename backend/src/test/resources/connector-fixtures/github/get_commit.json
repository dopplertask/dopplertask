{
  "package": "@activepieces/piece-github",
  "version": "0.11.1",
  "action": "get_commit",
  "auth": {
    "access_token": "test-token",
    "data": {}
  },
  "inputs": {
    "owner": "octo",
    "repo": "hello",
    "ref": "abc123"
  },
  "credential": {
    "oauthAccessToken": "test-token"
  },
  "answers": [
    {
      "status": 200,
      "body": {
        "sha": "abc123",
        "commit": {
          "message": "Fix login"
        }
      }
    }
  ],
  "exchanges": [
    {
      "request": {
        "method": "GET",
        "url": "https://api.github.com/repos/octo/hello/commits/abc123",
        "headers": {
          "authorization": "Bearer test-token"
        },
        "body": null
      }
    }
  ],
  "output": {
    "sha": "abc123",
    "commit": {
      "message": "Fix login"
    }
  }
}
