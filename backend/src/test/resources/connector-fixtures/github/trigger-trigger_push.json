{
  "package": "@activepieces/piece-github",
  "version": "0.11.1",
  "auth": {
    "access_token": "test-token",
    "data": {}
  },
  "trigger": "trigger_push",
  "webhook": true,
  "inputs": {
    "repository": {
      "owner": "octo",
      "repo": "hello"
    }
  },
  "settings": {
    "owner": "octo",
    "repo": "hello"
  },
  "credential": {
    "oauthAccessToken": "test-token"
  },
  "event": {
    "ref": "refs/heads/main",
    "before": "aaa",
    "after": "bbb",
    "commits": [
      {
        "id": "bbb",
        "distinct": true
      }
    ],
    "repository": {
      "id": 61,
      "full_name": "octo/hello"
    }
  },
  "answers": [
    {
      "status": 201,
      "body": {
        "id": 9001,
        "name": "web",
        "active": true
      }
    }
  ],
  "exchanges": [
    {
      "request": {
        "method": "POST",
        "url": "https://api.github.com/repos/octo/hello/hooks",
        "headers": {
          "authorization": "Bearer test-token",
          "content-type": "application/json"
        },
        "body": {
          "name": "web",
          "active": true,
          "events": [
            "push"
          ],
          "config": {
            "url": "https://tasks.example.com/hooks/test-key",
            "content_type": "json",
            "insecure_ssl": "0"
          }
        }
      }
    }
  ],
  "output": [
    {
      "ref": "refs/heads/main",
      "before": "aaa",
      "after": "bbb",
      "commits": [
        {
          "id": "bbb",
          "distinct": true
        }
      ],
      "repository": {
        "id": 61,
        "full_name": "octo/hello"
      }
    }
  ],
  "storeAfter": {
    "github_push_trigger": {
      "webhookId": 9001,
      "owner": "octo",
      "repo": "hello"
    }
  }
}
