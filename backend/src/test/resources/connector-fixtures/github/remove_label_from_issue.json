{
  "package": "@activepieces/piece-github",
  "version": "0.11.1",
  "action": "remove_label_from_issue",
  "auth": {
    "access_token": "test-token",
    "data": {}
  },
  "inputs": {
    "owner": "octo",
    "repo": "hello",
    "issue_number": 7,
    "name": "needs review"
  },
  "credential": {
    "oauthAccessToken": "test-token"
  },
  "answers": [
    {
      "status": 200,
      "body": [
        {
          "id": 3,
          "name": "bug",
          "color": "f29513",
          "description": "Something is broken"
        }
      ]
    }
  ],
  "exchanges": [
    {
      "request": {
        "method": "DELETE",
        "url": "https://api.github.com/repos/octo/hello/issues/7/labels/needs%20review",
        "headers": {
          "authorization": "Bearer test-token"
        },
        "body": null
      }
    }
  ],
  "output": [
    {
      "id": 3,
      "name": "bug",
      "color": "f29513",
      "description": "Something is broken"
    }
  ]
}
