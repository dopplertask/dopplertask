{
  "package": "@activepieces/piece-github",
  "version": "0.11.1",
  "action": "lock_issue_ai",
  "auth": {
    "access_token": "test-token",
    "data": {}
  },
  "inputs": {
    "owner": "octo",
    "repo": "hello",
    "issue_number": 7,
    "lock_reason": "too heated"
  },
  "credential": {
    "oauthAccessToken": "test-token"
  },
  "answers": [
    {
      "status": 204
    }
  ],
  "exchanges": [
    {
      "request": {
        "method": "PUT",
        "url": "https://api.github.com/repos/octo/hello/issues/7/lock",
        "headers": {
          "authorization": "Bearer test-token",
          "content-type": "application/json"
        },
        "body": {
          "lock_reason": "too heated"
        }
      }
    }
  ],
  "output": {
    "success": true,
    "status": 204,
    "locked": true
  }
}
