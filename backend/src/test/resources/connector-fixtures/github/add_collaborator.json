{
  "package": "@activepieces/piece-github",
  "version": "0.11.1",
  "action": "add_collaborator",
  "auth": {
    "access_token": "test-token",
    "data": {}
  },
  "inputs": {
    "owner": "octo",
    "repo": "hello",
    "username": "ada",
    "permission": "push"
  },
  "credential": {
    "oauthAccessToken": "test-token"
  },
  "answers": [
    {
      "status": 201,
      "body": {
        "id": 51,
        "permissions": "write",
        "invitee": {
          "login": "ada"
        }
      }
    }
  ],
  "exchanges": [
    {
      "request": {
        "method": "PUT",
        "url": "https://api.github.com/repos/octo/hello/collaborators/ada",
        "headers": {
          "authorization": "Bearer test-token",
          "content-type": "application/json"
        },
        "body": {
          "permission": "push"
        }
      }
    }
  ],
  "output": {
    "id": 51,
    "permissions": "write",
    "invitee": {
      "login": "ada"
    }
  }
}
