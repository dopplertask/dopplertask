{
  "package": "@activepieces/piece-github",
  "version": "0.11.1",
  "action": "merge_pull_request",
  "auth": {
    "access_token": "test-token",
    "data": {}
  },
  "inputs": {
    "owner": "octo",
    "repo": "hello",
    "pull_number": 12,
    "merge_method": "squash",
    "commit_title": "Add login (#12)",
    "commit_message": "Adds the form.",
    "sha": "abc123"
  },
  "credential": {
    "oauthAccessToken": "test-token"
  },
  "answers": [
    {
      "status": 200,
      "body": {
        "sha": "def456",
        "merged": true,
        "message": "Pull Request successfully merged"
      }
    }
  ],
  "exchanges": [
    {
      "request": {
        "method": "PUT",
        "url": "https://api.github.com/repos/octo/hello/pulls/12/merge",
        "headers": {
          "authorization": "Bearer test-token",
          "content-type": "application/json"
        },
        "body": {
          "merge_method": "squash",
          "commit_title": "Add login (#12)",
          "commit_message": "Adds the form.",
          "sha": "abc123"
        }
      }
    }
  ],
  "output": {
    "sha": "def456",
    "merged": true,
    "message": "Pull Request successfully merged"
  }
}
