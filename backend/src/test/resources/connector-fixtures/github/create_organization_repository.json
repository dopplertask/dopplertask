{
  "package": "@activepieces/piece-github",
  "version": "0.11.1",
  "action": "create_organization_repository",
  "auth": {
    "access_token": "test-token",
    "data": {}
  },
  "inputs": {
    "org": "octo-org",
    "name": "hello",
    "description": "A test repo",
    "private": false
  },
  "credential": {
    "oauthAccessToken": "test-token"
  },
  "answers": [
    {
      "status": 201,
      "body": {
        "id": 8,
        "name": "hello",
        "full_name": "octo/hello",
        "private": false
      }
    }
  ],
  "exchanges": [
    {
      "request": {
        "method": "POST",
        "url": "https://api.github.com/orgs/octo-org/repos",
        "headers": {
          "authorization": "Bearer test-token",
          "content-type": "application/json"
        },
        "body": {
          "name": "hello",
          "description": "A test repo",
          "private": false
        }
      }
    }
  ],
  "output": {
    "id": 8,
    "name": "hello",
    "full_name": "octo/hello",
    "private": false
  }
}
