{
  "package": "@activepieces/piece-github",
  "version": "0.11.1",
  "action": "create_pull_request_review",
  "auth": {
    "access_token": "test-token",
    "data": {}
  },
  "inputs": {
    "owner": "octo",
    "repo": "hello",
    "pull_number": 12,
    "event": "REQUEST_CHANGES",
    "body": "Please rename.",
    "commit_id": "abc123",
    "comments": [
      {
        "path": "src/login.ts",
        "position": 4,
        "body": "Rename this."
      }
    ]
  },
  "credential": {
    "oauthAccessToken": "test-token"
  },
  "answers": [
    {
      "status": 200,
      "body": {
        "id": 14,
        "state": "CHANGES_REQUESTED"
      }
    }
  ],
  "exchanges": [
    {
      "request": {
        "method": "POST",
        "url": "https://api.github.com/repos/octo/hello/pulls/12/reviews",
        "headers": {
          "authorization": "Bearer test-token",
          "content-type": "application/json"
        },
        "body": {
          "event": "REQUEST_CHANGES",
          "body": "Please rename.",
          "commit_id": "abc123",
          "comments": [
            {
              "path": "src/login.ts",
              "position": 4,
              "body": "Rename this."
            }
          ]
        }
      }
    }
  ],
  "output": {
    "id": 14,
    "state": "CHANGES_REQUESTED"
  }
}
