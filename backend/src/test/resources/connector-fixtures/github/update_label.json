{
  "package": "@activepieces/piece-github",
  "version": "0.11.1",
  "action": "update_label",
  "auth": {
    "access_token": "test-token",
    "data": {}
  },
  "inputs": {
    "owner": "octo",
    "repo": "hello",
    "name": "needs review",
    "new_name": "review",
    "color": "0e8a16",
    "description": "Waiting for review"
  },
  "credential": {
    "oauthAccessToken": "test-token"
  },
  "answers": [
    {
      "status": 200,
      "body": {
        "id": 3,
        "name": "review",
        "color": "f29513",
        "description": "Something is broken"
      }
    }
  ],
  "exchanges": [
    {
      "request": {
        "method": "PATCH",
        "url": "https://api.github.com/repos/octo/hello/labels/needs%20review",
        "headers": {
          "authorization": "Bearer test-token",
          "content-type": "application/json"
        },
        "body": {
          "new_name": "review",
          "color": "0e8a16",
          "description": "Waiting for review"
        }
      }
    }
  ],
  "output": {
    "id": 3,
    "name": "review",
    "color": "f29513",
    "description": "Something is broken"
  }
}
