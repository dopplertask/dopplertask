{
  "package": "@activepieces/piece-github",
  "version": "0.11.1",
  "action": "update_repository",
  "auth": {
    "access_token": "test-token",
    "data": {}
  },
  "inputs": {
    "owner": "octo",
    "repo": "hello",
    "name": "hello-world",
    "description": "Renamed",
    "private": "yes",
    "default_branch": "main",
    "has_issues": "no",
    "archived": "unchanged"
  },
  "credential": {
    "oauthAccessToken": "test-token"
  },
  "answers": [
    {
      "status": 200,
      "body": {
        "id": 8,
        "name": "hello",
        "full_name": "octo/hello",
        "private": false
      }
    }
  ],
  "exchanges": [
    {
      "request": {
        "method": "PATCH",
        "url": "https://api.github.com/repos/octo/hello",
        "headers": {
          "authorization": "Bearer test-token",
          "content-type": "application/json"
        },
        "body": {
          "name": "hello-world",
          "description": "Renamed",
          "private": true,
          "default_branch": "main",
          "has_issues": false
        }
      }
    }
  ],
  "output": {
    "id": 8,
    "name": "hello",
    "full_name": "octo/hello",
    "private": false
  }
}
