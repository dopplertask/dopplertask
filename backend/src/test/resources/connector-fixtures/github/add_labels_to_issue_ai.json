{
  "package": "@activepieces/piece-github",
  "version": "0.11.1",
  "action": "add_labels_to_issue_ai",
  "auth": {
    "access_token": "test-token",
    "data": {}
  },
  "inputs": {
    "owner": "octo",
    "repo": "hello",
    "issue_number": 7,
    "labels": [
      "bug"
    ]
  },
  "credential": {
    "oauthAccessToken": "test-token"
  },
  "answers": [
    {
      "status": 200,
      "body": [
        {
          "id": 3,
          "name": "bug",
          "color": "f29513",
          "description": "Something is broken"
        }
      ]
    }
  ],
  "exchanges": [
    {
      "request": {
        "method": "POST",
        "url": "https://api.github.com/repos/octo/hello/issues/7/labels",
        "headers": {
          "authorization": "Bearer test-token",
          "content-type": "application/json"
        },
        "body": {
          "labels": [
            "bug"
          ]
        }
      }
    }
  ],
  "output": [
    {
      "id": 3,
      "name": "bug",
      "color": "f29513",
      "description": "Something is broken"
    }
  ]
}
