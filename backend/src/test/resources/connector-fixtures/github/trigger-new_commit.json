{
  "package": "@activepieces/piece-github",
  "version": "0.11.1",
  "auth": {
    "access_token": "test-token",
    "data": {}
  },
  "trigger": "new_commit",
  "webhook": true,
  "inputs": {
    "repository": {
      "owner": "octo",
      "repo": "hello"
    }
  },
  "settings": {
    "owner": "octo",
    "repo": "hello"
  },
  "credential": {
    "oauthAccessToken": "test-token"
  },
  "event": {
    "ref": "refs/heads/main",
    "deleted": false,
    "commits": [
      {
        "id": "c1",
        "message": "Fix login",
        "distinct": true
      },
      {
        "id": "c2",
        "message": "Merged",
        "distinct": false
      },
      {
        "id": "c3",
        "message": "Add test",
        "distinct": true
      }
    ],
    "repository": {
      "id": 61,
      "full_name": "octo/hello"
    }
  },
  "answers": [
    {
      "status": 201,
      "body": {
        "id": 9001,
        "name": "web",
        "active": true
      }
    }
  ],
  "exchanges": [
    {
      "request": {
        "method": "POST",
        "url": "https://api.github.com/repos/octo/hello/hooks",
        "headers": {
          "authorization": "Bearer test-token",
          "content-type": "application/json"
        },
        "body": {
          "name": "web",
          "active": true,
          "events": [
            "push"
          ],
          "config": {
            "url": "https://tasks.example.com/hooks/test-key",
            "content_type": "json",
            "insecure_ssl": "0"
          }
        }
      }
    }
  ],
  "output": [
    {
      "id": "c1",
      "message": "Fix login",
      "distinct": true
    },
    {
      "id": "c3",
      "message": "Add test",
      "distinct": true
    }
  ],
  "storeAfter": {
    "github_new_commit_trigger": {
      "webhookId": 9001,
      "repo": "hello",
      "owner": "octo"
    }
  }
}
