{
  "package": "@activepieces/piece-github",
  "version": "0.11.1",
  "action": "create_branch_ai",
  "auth": {
    "access_token": "test-token",
    "data": {}
  },
  "inputs": {
    "owner": "octo",
    "repo": "hello",
    "source_branch": "main",
    "new_branch_name": "feature/new-design"
  },
  "credential": {
    "oauthAccessToken": "test-token"
  },
  "answers": [
    {
      "status": 200,
      "body": {
        "name": "main",
        "commit": {
          "sha": "abc123"
        }
      }
    },
    {
      "status": 201,
      "body": {
        "ref": "refs/heads/feature/new-design",
        "object": {
          "sha": "abc123"
        }
      }
    }
  ],
  "exchanges": [
    {
      "request": {
        "method": "GET",
        "url": "https://api.github.com/repos/octo/hello/branches/main",
        "headers": {
          "authorization": "Bearer test-token"
        },
        "body": null
      }
    },
    {
      "request": {
        "method": "POST",
        "url": "https://api.github.com/repos/octo/hello/git/refs",
        "headers": {
          "authorization": "Bearer test-token",
          "content-type": "application/json"
        },
        "body": {
          "ref": "refs/heads/feature/new-design",
          "sha": "abc123"
        }
      }
    }
  ],
  "output": {
    "ref": "refs/heads/feature/new-design",
    "object": {
      "sha": "abc123"
    }
  }
}
