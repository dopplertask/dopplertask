{
  "package": "@activepieces/piece-github",
  "version": "0.11.1",
  "action": "create_release",
  "auth": {
    "access_token": "test-token",
    "data": {}
  },
  "inputs": {
    "owner": "octo",
    "repo": "hello",
    "tag_name": "v1.0.0",
    "name": "First",
    "body": "Notes",
    "target_commitish": "main",
    "draft": false,
    "prerelease": true
  },
  "credential": {
    "oauthAccessToken": "test-token"
  },
  "answers": [
    {
      "status": 201,
      "body": {
        "id": 5,
        "tag_name": "v1.0.0",
        "name": "First",
        "draft": false
      }
    }
  ],
  "exchanges": [
    {
      "request": {
        "method": "POST",
        "url": "https://api.github.com/repos/octo/hello/releases",
        "headers": {
          "authorization": "Bearer test-token",
          "content-type": "application/json"
        },
        "body": {
          "tag_name": "v1.0.0",
          "name": "First",
          "body": "Notes",
          "target_commitish": "main",
          "draft": false,
          "prerelease": true
        }
      }
    }
  ],
  "output": {
    "id": 5,
    "tag_name": "v1.0.0",
    "name": "First",
    "draft": false
  }
}
