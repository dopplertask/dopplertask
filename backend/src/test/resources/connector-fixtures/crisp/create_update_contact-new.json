{
  "package": "@activepieces/piece-crisp",
  "version": "0.2.3",
  "auth": {
    "type": "CUSTOM_AUTH",
    "props": {
      "identifier": "test-id",
      "token": "test-key"
    }
  },
  "credential": {
    "identifier": "test-id",
    "token": "test-key"
  },
  "action": "create_update_contact",
  "inputs": {
    "websiteId": "web-1",
    "email": "new@example.com",
    "name": "New Person"
  },
  "answers": [
    {
      "status": 404,
      "body": {
        "error": true,
        "reason": "people_not_found",
        "data": {}
      }
    },
    {
      "status": 201,
      "body": {
        "error": false,
        "reason": "added",
        "data": {
          "people_id": "p-2"
        }
      }
    },
    {
      "status": 200,
      "body": {
        "error": false,
        "reason": "resolved",
        "data": {
          "people_id": "p-2",
          "email": "new@example.com",
          "person": {
            "nickname": "New Person"
          }
        }
      }
    }
  ],
  "exchanges": [
    {
      "request": {
        "method": "PUT",
        "url": "https://api.crisp.chat/v1/website/web-1/people/profile/new@example.com",
        "headers": {
          "authorization": "Basic dGVzdC1pZDp0ZXN0LWtleQ==",
          "content-type": "application/json",
          "x-crisp-tier": "plugin"
        },
        "body": {
          "email": "new@example.com",
          "person": {
            "nickname": "New Person"
          }
        }
      }
    },
    {
      "request": {
        "method": "POST",
        "url": "https://api.crisp.chat/v1/website/web-1/people/profile",
        "headers": {
          "authorization": "Basic dGVzdC1pZDp0ZXN0LWtleQ==",
          "content-type": "application/json",
          "x-crisp-tier": "plugin"
        },
        "body": {
          "email": "new@example.com",
          "person": {
            "nickname": "New Person"
          }
        }
      }
    },
    {
      "request": {
        "method": "GET",
        "url": "https://api.crisp.chat/v1/website/web-1/people/profile/new@example.com",
        "headers": {
          "authorization": "Basic dGVzdC1pZDp0ZXN0LWtleQ==",
          "x-crisp-tier": "plugin"
        },
        "body": null
      }
    }
  ],
  "output": {
    "error": false,
    "reason": "resolved",
    "data": {
      "people_id": "p-2",
      "email": "new@example.com",
      "person": {
        "nickname": "New Person"
      }
    }
  }
}
