{
  "package": "@activepieces/piece-airtable",
  "version": "0.9.4",
  "action": "airtable_delete_record",
  "auth": {
    "type": "SECRET_TEXT",
    "secret_text": "test-key"
  },
  "inputs": {
    "base": "app1",
    "tableId": "tbl1",
    "recordId": "rec1"
  },
  "credential": {
    "token": "test-key"
  },
  "answers": [
    {
      "status": 200,
      "body": {
        "id": "rec1",
        "deleted": true
      }
    }
  ],
  "exchanges": [
    {
      "request": {
        "method": "DELETE",
        "url": "https://api.airtable.com/v0/app1/tbl1/rec1",
        "headers": {
          "authorization": "Bearer test-key"
        },
        "body": null
      }
    }
  ],
  "output": {
    "id": "rec1",
    "deleted": true
  }
}
