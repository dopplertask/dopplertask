{
  "package": "@activepieces/piece-airtable",
  "version": "0.9.4",
  "action": "update_field",
  "auth": {
    "type": "SECRET_TEXT",
    "secret_text": "test-key"
  },
  "inputs": {
    "base_id": "app1",
    "table_id": "tbl1",
    "field_id": "fld2",
    "name": "Summary",
    "description": "Short summary"
  },
  "credential": {
    "token": "test-key"
  },
  "answers": [
    {
      "status": 200,
      "body": {
        "id": "fld2",
        "name": "Summary",
        "type": "multilineText",
        "description": "Short summary"
      }
    }
  ],
  "exchanges": [
    {
      "request": {
        "method": "PATCH",
        "url": "https://api.airtable.com/v0/meta/bases/app1/tables/tbl1/fields/fld2",
        "headers": {
          "authorization": "Bearer test-key",
          "content-type": "application/json"
        },
        "body": {
          "name": "Summary",
          "description": "Short summary"
        }
      }
    }
  ],
  "output": {
    "id": "fld2",
    "name": "Summary",
    "type": "multilineText",
    "description": "Short summary"
  }
}
