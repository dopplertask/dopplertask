{
  "package": "@activepieces/piece-airtable",
  "version": "0.9.4",
  "action": "airtable_find_base",
  "auth": {
    "type": "SECRET_TEXT",
    "secret_text": "test-key"
  },
  "inputs": {
    "baseName": "CrM"
  },
  "credential": {
    "token": "test-key"
  },
  "answers": [
    {
      "status": 200,
      "body": {
        "bases": [
          {
            "id": "app1",
            "name": "Sales CRM",
            "permissionLevel": "create"
          },
          {
            "id": "app2",
            "name": "Ops",
            "permissionLevel": "read"
          }
        ],
        "offset": "o1"
      }
    },
    {
      "status": 200,
      "body": {
        "bases": [
          {
            "id": "app3",
            "name": "crm archive",
            "permissionLevel": "edit"
          }
        ]
      }
    }
  ],
  "exchanges": [
    {
      "request": {
        "method": "GET",
        "url": "https://api.airtable.com/v0/meta/bases",
        "headers": {
          "authorization": "Bearer test-key"
        },
        "body": null
      }
    },
    {
      "request": {
        "method": "GET",
        "url": "https://api.airtable.com/v0/meta/bases?offset=o1",
        "headers": {
          "authorization": "Bearer test-key"
        },
        "body": null
      }
    }
  ],
  "output": [
    {
      "id": "app1",
      "name": "Sales CRM",
      "permissionLevel": "create"
    },
    {
      "id": "app3",
      "name": "crm archive",
      "permissionLevel": "edit"
    }
  ]
}
