              "type": "application/pdf"
            }
          ]
        }
      }
    }
  ],
  "exchanges": [
    {
      "request": {
        "method": "POST",
        "url": "https://content.airtable.com/v0/app1/rec1/fld3/uploadAttachment",
        "headers": {
          "authorization": "Bearer test-key",
          "content-type": "application/json"
        },
        "body": {
          "contentType": "application/pdf",
          "file": "aGVsbG8=",
          "filename": "a.pdf"
        }
      }
    }
  ],
  "output": {
    "id": "rec1",
    "createdTime": "2024-03-05T10:30:00.000Z",
    "fields": {
      "fld3": [
        {
          "id": "att1",
          "url": "https://example.com/report.pdf",
          "filename": "Report.pdf",
          "size": 5,
          "type": "application/pdf"
        }
      ]
    }
  }
