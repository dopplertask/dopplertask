{
  "package": "@activepieces/piece-airtable",
  "version": "0.9.4",
  "action": "airtable_upload_file_to_column",
  "auth": {
    "type": "SECRET_TEXT",
    "secret_text": "test-key"
  },
  "inputs": {
    "base": "app1",
    "tableId": "tbl1",
    "attachment_column": "fld3",
    "recordId": "rec1",
    "file_content_type": "application/pdf"
  },
  "settings": {
    "base": "app1",
    "tableId": "tbl1",
    "attachmentFieldId": "fld3",
    "recordId": "rec1",
    "contentType": "application/pdf"
  },
  "files": {
    "file": {
      "name": "a.pdf",
      "base64": "aGVsbG8="
    }
  },
  "credential": {
    "token": "test-key"
  },
  "answers": [
    {
      "status": 200,
      "body": {
        "id": "rec1",
        "createdTime": "2024-03-05T10:30:00.000Z",
        "fields": {
          "fld3": [
            {
              "id": "att1",
