{
  "package": "@activepieces/piece-kapso",
  "version": "0.2.1",
  "action": "send_buttons",
  "auth": {
    "type": "SECRET_TEXT",
    "secret_text": "test-key"
  },
  "inputs": {
    "businessAccountId": "waba-1",
    "phoneNumberId": "pn-1",
    "to": "15551234567",
    "bodyText": "Pick one",
    "buttons": [
      {
        "id": "yes",
        "title": "Yes"
      },
      {
        "id": "no",
        "title": "No"
      }
    ],
    "footerText": "Thanks"
  },
  "credential": {
    "apiKey": "test-key"
  },
  "answers": [
    {
      "status": 200,
      "body": {
        "messaging_product": "whatsapp",
        "contacts": [
          {
            "input": "15551234567",
            "wa_id": "15551234567"
          }
        ],
        "messages": [
          {
            "id": "wamid.abc123"
          }
        ]
      }
    }
  ],
  "exchanges": [
    {
      "request": {
        "method": "POST",
        "url": "https://api.kapso.ai/meta/whatsapp/v23.0/pn-1/messages",
        "headers": {
          "content-type": "application/json",
          "x-api-key": "test-key"
        },
        "body": {
          "messaging_product": "whatsapp",
          "recipient_type": "individual",
          "to": "15551234567",
          "type": "interactive",
          "interactive": {
            "type": "button",
            "body": {
              "text": "Pick one"
            },
            "action": {
              "buttons": [
                {
                  "type": "reply",
                  "reply": {
                    "id": "yes",
                    "title": "Yes"
                  }
                },
                {
                  "type": "reply",
                  "reply": {
                    "id": "no",
                    "title": "No"
                  }
                }
              ]
            },
            "footer": {
              "text": "Thanks"
            }
          }
        }
      }
    }
  ],
  "output": {
    "messagingProduct": "whatsapp",
    "contacts": [
      {
        "input": "15551234567",
        "waId": "15551234567"
      }
    ],
    "messages": [
      {
        "id": "wamid.abc123"
      }
    ]
  }
}
