{
  "package": "@activepieces/piece-confluence",
  "version": "0.4.2",
  "action": "confluence_search_content",
  "auth": {
    "type": "CUSTOM_AUTH",
    "props": {
      "username": "ada@example.com",
      "password": "conf-test-token",
      "confluenceDomain": "https://acme.atlassian.net"
    }
  },
  "inputs": {
    "cql": "type = page AND space = \"DOCS\" AND text ~ \"release\"",
    "limit": 10,
    "cursor": "c1",
    "includeArchivedSpaces": true
  },
  "credential": {
    "username": "ada@example.com",
    "password": "conf-test-token",
    "confluenceDomain": "https://acme.atlassian.net"
  },
  "answers": [
    {
      "status": 200,
      "body": {
        "results": [
          {
            "id": "1"
          },
          {
            "id": "2"
          }
        ],
        "_links": {
          "next": "/wiki/api/v2/x?cursor=abc%2Bdef&limit=10"
        }
      }
    }
  ],
  "exchanges": [
    {
      "request": {
        "method": "GET",
        "url": "https://acme.atlassian.net/wiki/rest/api/search?cql=type+%3D+page+AND+space+%3D+%22DOCS%22+AND+text+%7E+%22release%22&limit=10&cursor=c1&includeArchivedSpaces=true&excerpt=highlight",
        "headers": {
          "authorization": "Basic YWRhQGV4YW1wbGUuY29tOmNvbmYtdGVzdC10b2tlbg=="
        },
        "body": null
      }
    }
  ],
  "output": {
    "results": [
      {
        "id": "1"
      },
      {
        "id": "2"
      }
    ],
    "count": 2,
    "nextCursor": "abc+def"
  }
}
