{
  "package": "@activepieces/piece-confluence",
  "version": "0.4.2",
  "action": "confluence_add_space_labels",
  "auth": {
    "type": "CUSTOM_AUTH",
    "props": {
      "username": "ada@example.com",
      "password": "conf-test-token",
      "confluenceDomain": "https://acme.atlassian.net"
    }
  },
  "inputs": {
    "spaceKey": "DOCS",
    "labels": [
      "alpha",
      "beta"
    ],
    "prefix": "team"
  },
  "credential": {
    "username": "ada@example.com",
    "password": "conf-test-token",
    "confluenceDomain": "https://acme.atlassian.net"
  },
  "answers": [
    {
      "status": 200,
      "body": {
        "results": [
          {
            "name": "alpha"
          }
        ]
      }
    }
  ],
  "exchanges": [
    {
      "request": {
        "method": "POST",
        "url": "https://acme.atlassian.net/wiki/rest/api/space/DOCS/label",
        "headers": {
          "authorization": "Basic YWRhQGV4YW1wbGUuY29tOmNvbmYtdGVzdC10b2tlbg==",
          "content-type": "application/json"
        },
        "body": [
          {
            "prefix": "team",
            "name": "alpha"
          },
          {
            "prefix": "team",
            "name": "beta"
          }
        ]
      }
    }
  ],
  "output": {
    "results": [
      {
        "name": "alpha"
      }
    ]
  }
}
