{
  "package": "@activepieces/piece-front",
  "version": "0.2.3",
  "action": "create_account",
  "auth": {
    "type": "SECRET_TEXT",
    "secret_text": "test-key"
  },
  "inputs": {
    "name": "Acme",
    "description": "Key customer",
    "domains": [
      {
        "domain": "acme.com"
      }
    ],
    "external_id": "ext-1",
    "custom_fields": {
      "tier": "gold"
    }
  },
  "credential": {
    "token": "test-key"
  },
  "answers": [
    {
      "status": 200,
      "body": {
        "id": "acc_654",
        "name": "Acme",
        "description": "Key customer",
        "domains": [
          "acme.com"
        ],
        "external_id": "ext-1",
        "custom_fields": {
          "tier": "gold"
        }
      }
    }
  ],
  "exchanges": [
    {
      "request": {
        "method": "POST",
        "url": "https://api2.frontapp.com/accounts",
        "headers": {
          "authorization": "Bearer test-key",
          "content-type": "application/json"
        },
        "body": {
          "name": "Acme",
          "description": "Key customer",
          "domains": [
            {
              "domain": "acme.com"
            }
          ],
          "external_id": "ext-1",
          "custom_fields": {
            "tier": "gold"
          }
        }
      }
    }
  ],
  "output": {
    "id": "acc_654",
    "name": "Acme",
    "description": "Key customer",
    "domains": [
      "acme.com"
    ],
    "external_id": "ext-1",
    "custom_fields": {
      "tier": "gold"
    }
  }
}
