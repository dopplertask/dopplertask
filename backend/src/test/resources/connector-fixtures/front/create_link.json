{
  "package": "@activepieces/piece-front",
  "version": "0.2.3",
  "action": "create_link",
  "auth": {
    "type": "SECRET_TEXT",
    "secret_text": "test-key"
  },
  "inputs": {
    "name": "Ticket 42",
    "external_url": "https://tickets.example.com/42",
    "pattern": "https://tickets.example.com/*"
  },
  "credential": {
    "token": "test-key"
  },
  "answers": [
    {
      "status": 200,
      "body": {
        "id": "top_987",
        "name": "Ticket 42",
        "type": "web",
        "external_url": "https://tickets.example.com/42"
      }
    }
  ],
  "exchanges": [
    {
      "request": {
        "method": "POST",
        "url": "https://api2.frontapp.com/links",
        "headers": {
          "authorization": "Bearer test-key",
          "content-type": "application/json"
        },
        "body": {
          "name": "Ticket 42",
          "external_url": "https://tickets.example.com/42",
          "pattern": "https://tickets.example.com/*"
        }
      }
    }
  ],
  "output": {
    "id": "top_987",
    "name": "Ticket 42",
    "type": "web",
    "external_url": "https://tickets.example.com/42"
  }
}
