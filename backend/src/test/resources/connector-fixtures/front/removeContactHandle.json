{
  "package": "@activepieces/piece-front",
  "version": "0.2.3",
  "auth": {
    "type": "SECRET_TEXT",
    "secret_text": "test-key"
  },
  "credential": {
    "token": "test-key"
  },
  "answers": [
    {
      "status": 200,
      "body": {}
    }
  ],
  "action": "removeContactHandle",
  "inputs": {
    "contact_id": "crd_456",
    "handle": "ada@example.com",
    "source": "email",
    "force": true
  },
  "exchanges": [
    {
      "request": {
        "method": "DELETE",
        "url": "https://api2.frontapp.com/contacts/crd_456/handles",
        "headers": {
          "authorization": "Bearer test-key",
          "content-type": "application/json"
        },
        "body": {
          "handle": "ada@example.com",
          "source": "email",
          "force": true
        }
      }
    }
  ],
  "output": {
    "success": true,
    "message": "Handle ada@example.com removed from contact crd_456"
  }
}
