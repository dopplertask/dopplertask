        "url": "https://api2.frontapp.com/links/top_987",
        "headers": {
          "authorization": "Bearer test-key",
          "content-type": "application/json"
        },
        "body": {
          "name": "Ticket 43",
          "external_url": "https://tickets.example.com/43"
        }
      }
    }
  ],
  "output": {
    "success": true,
