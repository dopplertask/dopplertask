{
  "package": "@activepieces/piece-front",
  "version": "0.2.3",
  "action": "add_contact_handle",
  "auth": {
    "type": "SECRET_TEXT",
    "secret_text": "test-key"
  },
  "inputs": {
    "contact_id": "crd_456",
    "handle_type": "email",
    "handle_value": "ada@example.com"
  },
  "credential": {
    "token": "test-key"
  },
  "answers": [
    {
      "status": 200,
      "body": {}
    }
  ],
  "exchanges": [
    {
      "request": {
        "method": "POST",
        "url": "https://api2.frontapp.com/contacts/crd_456/handles",
        "headers": {
          "authorization": "Bearer test-key",
          "content-type": "application/json"
        },
        "body": {
          "source": "email",
          "handle": "ada@example.com"
        }
      }
    }
  ],
  "output": {
    "success": true,
    "message": "Handle added successfully to crd_456"
  }
}
