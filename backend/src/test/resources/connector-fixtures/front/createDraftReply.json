          "content-type": "application/json"
        },
        "body": {
          "body": "Hello",
          "subject": "Your order",
          "author_id": "tea_789",
          "channel_id": "cha_321",
          "to": [
            "ada@example.com"
          ],
          "cc": [
            "bob@example.com"
          ],
          "bcc": [
            "eve@example.com"
          ],
          "mode": "private",
          "signature_id": "sig_1",
          "should_add_default_signature": false
        }
      }
    }
  ],
  "output": {
    "id": "msg_1",
    "type": "email",
    "is_draft": true,
    "draft_mode": "shared",
    "subject": "Your order",
    "body": "Hello"
  }
