{
  "package": "@activepieces/piece-front",
  "version": "0.2.3",
  "action": "createDraftReply",
  "auth": {
    "type": "SECRET_TEXT",
    "secret_text": "test-key"
  },
  "inputs": {
    "conversation_id": "cnv_123",
    "body": "Hello",
    "subject": "Your order",
    "author_id": "tea_789",
    "channel_id": "cha_321",
    "to": [
      "ada@example.com"
    ],
    "cc": [
      "bob@example.com"
    ],
    "bcc": [
      "eve@example.com"
    ],
    "mode": "private",
    "signature_id": "sig_1",
    "should_add_default_signature": false
  },
  "credential": {
    "token": "test-key"
  },
  "answers": [
    {
      "status": 200,
      "body": {
