{
  "package": "@activepieces/piece-front",
  "version": "0.2.3",
  "auth": {
    "type": "SECRET_TEXT",
    "secret_text": "test-key"
  },
  "credential": {
    "token": "test-key"
  },
  "action": "findAccount",
  "inputs": {
    "email_domain": "example.com",
    "limit": 5
  },
  "answers": [
    {
      "status": 200,
      "body": {
        "_results": [
          {
            "id": "a",
            "email_domain": "example.com"
          },
          {
            "id": "b",
            "email_domain": "x.com"
          }
        ]
      }
    }
  ],
  "exchanges": [
    {
      "request": {
        "method": "GET",
        "url": "https://api2.frontapp.com/accounts",
        "headers": {
          "authorization": "Bearer test-key",
          "content-type": "application/json"
        },
        "body": null
      }
    }
  ],
  "output": [
    {
      "id": "a",
      "email_domain": "example.com"
    }
  ]
}
