{
  "package": "@activepieces/piece-front",
  "version": "0.2.3",
  "action": "updateContact",
  "auth": {
    "type": "SECRET_TEXT",
    "secret_text": "test-key"
  },
  "inputs": {
    "contact_id": "crd_456",
    "name": "Ada King",
    "description": "VIP",
    "avatar_url": "https://example.com/ada.png",
    "links": [
      {
        "item": "https://example.com/ada"
      }
    ]
  },
  "credential": {
    "token": "test-key"
  },
  "answers": [
    {
      "status": 200,
      "body": {}
    }
  ],
  "exchanges": [
    {
      "request": {
        "method": "PATCH",
        "url": "https://api2.frontapp.com/contacts/crd_456",
        "headers": {
          "authorization": "Bearer test-key",
          "content-type": "application/json"
        },
        "body": {
          "name": "Ada King",
          "description": "VIP",
          "avatar_url": "https://example.com/ada.png",
          "links": [
            {
              "item": "https://example.com/ada"
            }
          ]
        }
      }
    }
  ],
  "output": {
    "success": true,
    "message": "Contact crd_456 updated successfully"
  }
}
