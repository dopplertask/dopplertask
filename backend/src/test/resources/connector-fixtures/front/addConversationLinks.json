{
  "package": "@activepieces/piece-front",
  "version": "0.2.3",
  "action": "addConversationLinks",
  "auth": {
    "type": "SECRET_TEXT",
    "secret_text": "test-key"
  },
  "inputs": {
    "conversation_id": "cnv_123",
    "link_ids": [
      "top_1",
      "top_2"
    ]
  },
  "credential": {
    "token": "test-key"
  },
  "answers": [
    {
      "status": 200,
      "body": {}
    }
  ],
  "exchanges": [
    {
      "request": {
        "method": "POST",
        "url": "https://api2.frontapp.com/conversations/cnv_123/links",
        "headers": {
          "authorization": "Bearer test-key",
          "content-type": "application/json"
        },
        "body": {
          "link_ids": [
            "top_1",
            "top_2"
          ]
        }
      }
    }
  ],
  "output": {
    "success": true,
    "message": "Links added to conversation cnv_123 successfully"
  }
}
