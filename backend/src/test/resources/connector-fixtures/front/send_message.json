{
  "package": "@activepieces/piece-front",
  "version": "0.2.3",
  "action": "send_message",
  "auth": {
    "type": "SECRET_TEXT",
    "secret_text": "test-key"
  },
  "inputs": {
    "channel_id": "cha_321",
    "to": [
      "ada@example.com"
    ],
    "cc": [
      "bob@example.com"
    ],
    "bcc": [
      "eve@example.com"
    ],
    "subject": "Welcome",
    "body": "Hello Ada",
    "tag_ids": [
      "tag_1"
    ]
  },
  "credential": {
    "token": "test-key"
  },
  "answers": [
    {
      "status": 200,
      "body": {
        "status": "accepted",
        "message_uid": "msg_uid_1"
      }
    }
  ],
  "exchanges": [
    {
      "request": {
        "method": "POST",
        "url": "https://api2.frontapp.com/channels/cha_321/messages",
        "headers": {
          "authorization": "Bearer test-key",
          "content-type": "application/json"
        },
        "body": {
          "channel_id": "cha_321",
          "to": [
            "ada@example.com"
          ],
          "body": "Hello Ada",
          "cc": [
            "bob@example.com"
          ],
          "bcc": [
            "eve@example.com"
          ],
          "subject": "Welcome",
          "tag_ids": [
            "tag_1"
          ]
        }
      }
    }
  ],
  "output": {
    "status": "accepted",
    "message_uid": "msg_uid_1"
  }
}
