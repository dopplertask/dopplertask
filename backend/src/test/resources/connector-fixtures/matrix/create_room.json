{
  "package": "@activepieces/piece-matrix",
  "version": "0.6.3",
  "action": "create_room",
  "auth": {
    "type": "CUSTOM_AUTH",
    "props": {
      "base_url": "https://credential000z.example.com",
      "access_token": "credential001z"
    }
  },
  "inputs": {
    "name": "sample000z",
    "topic": "sample001z",
    "aliasName": "sample004z"
  },
  "credential": {
    "base_url": "credential000z.example.com",
    "access_token": "credential001z"
  },
  "answers": [
    {
      "status": 200,
      "body": {}
    }
  ],
  "exchanges": [
    {
      "request": {
        "method": "POST",
        "url": "https://credential000z.example.com/_matrix/client/v3/createRoom",
        "headers": {
          "authorization": "Bearer credential001z",
          "content-type": "application/json"
        },
        "body": {
          "preset": "private_chat",
          "visibility": "private",
          "name": "sample000z",
          "topic": "sample001z",
          "room_alias_name": "sample004z"
        }
      }
    }
  ],
  "output": {
    "error": "The homeserver did not return a room ID."
  }
}
