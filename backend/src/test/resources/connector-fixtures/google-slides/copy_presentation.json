{
  "package": "@activepieces/piece-google-slides",
  "version": "0.4.4",
  "action": "copy_presentation",
  "auth": {
    "type": "OAUTH2",
    "access_token": "credential000z",
    "data": {}
  },
  "inputs": {
    "presentation_id": "sample000z",
    "name": "sample001z",
    "folder_id": "sample002z"
  },
  "credential": {
    "oauthAccessToken": "credential000z"
  },
  "answers": [
    {
      "status": 200,
      "body": {}
    }
  ],
  "exchanges": [
    {
      "request": {
        "method": "POST",
        "url": "https://www.googleapis.com/drive/v3/files/sample000z/copy?supportsAllDrives=true&fields=id%2Cname%2CcreatedTime",
        "headers": {
          "authorization": "Bearer credential000z",
          "content-type": "application/json",
          "x-goog-api-client": "gdcl/8.0.2 gl-node/26.13.0"
        },
        "body": {
          "name": "sample001z",
          "parents": [
            "sample002z"
          ]
        }
      }
    }
  ],
  "output": {
    "error": "Google Drive copied the presentation but returned no file ID."
  }
}
