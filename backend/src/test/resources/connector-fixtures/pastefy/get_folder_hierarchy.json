{
  "package": "@activepieces/piece-pastefy",
  "version": "0.4.2",
  "action": "get_folder_hierarchy",
  "auth": {
    "type": "CUSTOM_AUTH",
    "props": {
      "instance_url": "https://credential000z.example.com",
      "token": "credential001z"
    }
  },
  "inputs": {
    "parent_id": "sample000z"
  },
  "credential": {
    "instance_url": "credential000z.example.com",
    "token": "credential001z"
  },
  "answers": [
    {
      "status": 200,
      "body": {}
    }
  ],
  "exchanges": [
    {
      "request": {
        "method": "GET",
        "url": "https://credential000z.example.com/api/v2/user/folders?hide_pastes=true",
        "headers": {
          "authorization": "Bearer credential001z"
        },
        "body": null
      }
    }
  ],
  "output": {
    "error": "Folder sample000z was not found in your folders."
  }
}
