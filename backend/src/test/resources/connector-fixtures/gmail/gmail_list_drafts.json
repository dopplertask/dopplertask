{
  "package": "@activepieces/piece-gmail",
  "version": "0.18.6",
  "action": "gmail_list_drafts",
  "auth": {
    "type": "OAUTH2",
    "access_token": "test-token",
    "data": {}
  },
  "inputs": {
    "query": " subject:invoice ",
    "max_results": 5
  },
  "credential": {
    "oauthAccessToken": "test-token"
  },
  "answers": [
    {
      "status": 200,
      "body": {
        "drafts": [
          {
            "id": "r-200",
            "message": {
              "id": "m-1",
              "threadId": "t-100"
            }
          }
        ],
        "resultSizeEstimate": 1,
        "nextPageToken": "p2"
      }
    }
  ],
  "exchanges": [
    {
      "request": {
        "method": "GET",
        "url": "https://gmail.googleapis.com/gmail/v1/users/me/drafts?maxResults=5&q=subject%3Ainvoice",
        "headers": {
          "authorization": "Bearer test-token",
          "x-goog-api-client": "gdcl/8.0.2 gl-node/26.4.0"
        },
        "body": null
      }
    }
  ],
  "output": {
    "drafts": [
      {
        "id": "r-200",
        "message": {
          "id": "m-1",
          "threadId": "t-100"
        }
      }
    ],
    "count": 1,
    "resultSizeEstimate": 1,
    "nextPageToken": "p2"
  }
}
