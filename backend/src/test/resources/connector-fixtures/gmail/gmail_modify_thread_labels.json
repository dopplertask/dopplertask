{
  "package": "@activepieces/piece-gmail",
  "version": "0.18.6",
  "action": "gmail_modify_thread_labels",
  "auth": {
    "type": "OAUTH2",
    "access_token": "test-token",
    "data": {}
  },
  "inputs": {
    "thread_id": "t-100",
    "add_label_ids": [
      "STARRED"
    ],
    "remove_label_ids": []
  },
  "credential": {
    "oauthAccessToken": "test-token"
  },
  "answers": [
    {
      "status": 200,
      "body": {
        "id": "t-100",
        "messages": [
          {
            "id": "m-1",
            "threadId": "t-100",
            "labelIds": [
              "INBOX",
              "Label_7"
            ],
            "snippet": "Hello there"
          }
        ]
      }
    }
  ],
  "exchanges": [
    {
      "request": {
        "method": "POST",
        "url": "https://gmail.googleapis.com/gmail/v1/users/me/threads/t-100/modify",
        "headers": {
          "authorization": "Bearer test-token",
          "content-type": "application/json",
          "x-goog-api-client": "gdcl/8.0.2 gl-node/26.4.0"
        },
        "body": {
          "addLabelIds": [
            "STARRED"
          ]
        }
      }
    }
  ],
  "output": {
    "id": "t-100",
    "messages": [
      {
        "id": "m-1",
        "threadId": "t-100",
        "labelIds": [
          "INBOX",
          "Label_7"
        ],
        "snippet": "Hello there"
      }
    ]
  }
}
