{
  "package": "@activepieces/piece-notion",
  "version": "0.8.3",
  "action": "notion_add_comment",
  "auth": {
    "access_token": "test-token",
    "data": {}
  },
  "inputs": {
    "page_id": "page-1",
    "comment_text": "Ping"
  },
  "credential": {
    "oauthAccessToken": "test-token"
  },
  "answers": [
    {
      "status": 200,
      "body": {
        "object": "comment",
        "id": "c-10"
      }
    }
  ],
  "exchanges": [
    {
      "request": {
        "method": "POST",
        "url": "https://api.notion.com/v1/comments",
        "headers": {
          "authorization": "Bearer test-token",
          "content-type": "application/json",
          "notion-version": "2022-02-22"
        },
        "body": {
          "parent": {
            "page_id": "page-1"
          },
          "rich_text": [
            {
              "text": {
                "content": "Ping"
              }
            }
          ]
        }
      }
    }
  ],
  "output": {
    "success": true,
    "comment_id": "c-10",
    "note": "Limited comment details available. To see full comment content, ensure your Notion integration has \"Read comments\" capability enabled."
  }
}
