{
  "package": "@activepieces/piece-freshdesk",
  "version": "0.3.3",
  "auth": {
    "type": "CUSTOM_AUTH",
    "props": {
      "base_url": "https://acme.freshdesk.com/",
      "access_token": "fd-test-token"
    }
  },
  "action": "get_contact_from_id",
  "inputs": {
    "contactid": "4321"
  },
  "credential": {
    "base_url": "https://acme.freshdesk.com/",
    "access_token": "fd-test-token"
  },
  "answers": [
    {
      "status": 200,
      "body": {
        "id": 4321,
        "name": "Ada Lovelace",
        "email": "ada@example.com",
        "phone": "+46 8 123 45",
        "active": true
      }
    }
  ],
  "exchanges": [
    {
      "request": {
        "method": "GET",
        "url": "https://acme.freshdesk.com/api/v2/contacts/4321",
        "headers": {
          "authorization": "fd-test-token",
          "content-type": "application/json"
        },
        "body": null
      }
    }
  ],
  "output": {
    "id": 4321,
    "name": "Ada Lovelace",
    "email": "ada@example.com",
    "phone": "+46 8 123 45",
    "active": true
  }
}
