{
  "package": "@activepieces/piece-freshdesk",
  "version": "0.3.3",
  "auth": {
    "type": "CUSTOM_AUTH",
    "props": {
      "base_url": "https://acme.freshdesk.com/",
      "access_token": "fd-test-token"
    }
  },
  "action": "get_contacts",
  "inputs": {
    "per_page": 0
  },
  "credential": {
    "base_url": "https://acme.freshdesk.com/",
    "access_token": "fd-test-token"
  },
  "answers": [
    {
      "status": 200,
      "body": [
        {
          "id": 4321,
          "name": "Ada Lovelace",
          "email": "ada@example.com"
        }
      ]
    }
  ],
  "exchanges": [
    {
      "request": {
        "method": "GET",
        "url": "https://acme.freshdesk.com/api/v2/contacts/",
        "headers": {
          "authorization": "fd-test-token",
          "content-type": "application/json"
        },
        "body": null
      }
    }
  ],
  "output": [
    {
      "id": 4321,
      "name": "Ada Lovelace",
      "email": "ada@example.com"
    }
  ]
}
