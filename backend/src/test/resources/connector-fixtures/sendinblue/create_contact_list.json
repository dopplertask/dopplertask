{
  "package": "@activepieces/piece-sendinblue",
  "version": "0.6.1",
  "action": "create_contact_list",
  "auth": {
    "type": "SECRET_TEXT",
    "secret_text": "test-key"
  },
  "inputs": {
    "name": "Newsletter",
    "folder_id": 1
  },
  "credential": {
    "apiKey": "test-key"
  },
  "answers": [
    {
      "status": 200,
      "body": {
        "id": 9
      }
    }
  ],
  "exchanges": [
    {
      "request": {
        "method": "POST",
        "url": "https://api.brevo.com/v3/contacts/lists",
        "headers": {
          "api-key": "test-key",
          "content-type": "application/json"
        },
        "body": {
          "name": "Newsletter",
          "folderId": 1
        }
      }
    }
  ],
  "output": {
    "id": 9
  }
}
