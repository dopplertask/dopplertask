{
  "package": "@activepieces/piece-sendinblue",
  "version": "0.6.1",
  "action": "list_senders",
  "auth": {
    "type": "SECRET_TEXT",
    "secret_text": "test-key"
  },
  "inputs": {
    "ip": "1.2.3.4",
    "domain": "example.com"
  },
  "credential": {
    "apiKey": "test-key"
  },
  "answers": [
    {
      "status": 200,
