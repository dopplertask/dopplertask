        "url": "https://api.brevo.com/v3/senders?ip=1.2.3.4&domain=example.com",
        "headers": {
          "api-key": "test-key"
        },
        "body": null
      }
    }
  ],
  "output": {
    "senders": [
      {
        "id": 1,
        "name": "Example Shop",
        "email": "shop@example.com",
        "active": true
      }
    ]
  }
