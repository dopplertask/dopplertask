{
  "package": "@activepieces/piece-sendinblue",
  "version": "0.6.1",
  "action": "create_or_update_email_template",
  "auth": {
    "type": "SECRET_TEXT",
    "secret_text": "test-key"
  },
  "inputs": {
    "template_name": "Order shipped",
    "subject": "Your order has shipped",
    "sender_email": "shop@example.com",
    "sender_name": "Example Shop",
    "html_content": "<p>Your order is on its way.</p>",
    "reply_to_email": "support@example.com",
    "to_field": "Customer",
    "is_active": "yes",
    "tag": "orders",
    "attachment_url": "https://example.com/terms.pdf"
  },
  "credential": {
    "apiKey": "test-key"
  },
  "answers": [
    {
      "status": 200,
      "body": {
        "id": 12
      }
    }
  ],
  "exchanges": [
    {
      "request": {
        "method": "POST",
        "url": "https://api.brevo.com/v3/smtp/templates",
        "headers": {
          "api-key": "test-key",
          "content-type": "application/json"
        },
        "body": {
          "templateName": "Order shipped",
          "subject": "Your order has shipped",
          "sender": {
            "email": "shop@example.com",
            "name": "Example Shop"
          },
          "htmlContent": "<p>Your order is on its way.</p>",
          "replyTo": "support@example.com",
          "toField": "Customer",
          "isActive": true,
          "tag": "orders",
          "attachmentUrl": "https://example.com/terms.pdf"
        }
      }
    }
  ],
  "output": {
    "id": 12
  }
}
