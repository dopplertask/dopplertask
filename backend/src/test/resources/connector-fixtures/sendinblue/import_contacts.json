{
  "package": "@activepieces/piece-sendinblue",
  "version": "0.6.1",
  "action": "import_contacts",
  "auth": {
    "type": "SECRET_TEXT",
    "secret_text": "test-key"
  },
  "inputs": {
    "file_url": "https://example.com/contacts.csv",
    "json_body": [
      {
        "email": "jane@example.com",
        "attributes": {
          "FIRSTNAME": "Jane"
        }
      }
    ],
    "list_ids": [
      "2"
    ],
    "new_list_name": "Imported",
    "new_list_folder_id": 1,
    "notify_url": "https://example.com/import-done",
    "email_blacklist": false,
    "sms_blacklist": false,
    "update_existing_contacts": true,
    "empty_contacts_attributes": false
  },
  "credential": {
    "apiKey": "test-key"
  },
  "answers": [
    {
      "status": 200,
      "body": {
        "processId": 78
      }
    }
  ],
  "exchanges": [
    {
      "request": {
        "method": "POST",
        "url": "https://api.brevo.com/v3/contacts/import",
        "headers": {
          "api-key": "test-key",
          "content-type": "application/json"
        },
        "body": {
          "fileUrl": "https://example.com/contacts.csv",
          "jsonBody": [
            {
              "email": "jane@example.com",
              "attributes": {
                "FIRSTNAME": "Jane"
              }
            }
          ],
          "listIds": [
            2
          ],
          "newList": {
            "listName": "Imported",
            "folderId": 1
          },
          "notifyUrl": "https://example.com/import-done",
          "emailBlacklist": false,
          "smsBlacklist": false,
          "updateExistingContacts": true,
          "emptyContactsAttributes": false
        }
      }
    }
  ],
  "output": {
    "processId": 78
  }
}
