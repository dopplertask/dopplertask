{
  "package": "@activepieces/piece-sendinblue",
  "version": "0.6.1",
  "action": "unsubscribe_contact",
  "auth": {
    "type": "SECRET_TEXT",
    "secret_text": "test-key"
  },
  "inputs": {
    "email": "jane@example.com",
    "unsubscribe_email": true,
    "unsubscribe_sms": true,
    "unlink_list_ids": [
      "2",
      "5"
    ]
  },
  "credential": {
    "apiKey": "test-key"
  },
  "answers": [
    {
      "status": 200,
      "body": {}
    }
  ],
  "exchanges": [
    {
      "request": {
        "method": "PUT",
        "url": "https://api.brevo.com/v3/contacts/jane%40example.com",
        "headers": {
          "api-key": "test-key",
          "content-type": "application/json"
        },
        "body": {
          "emailBlacklisted": true,
          "smsBlacklisted": true,
          "unlinkListIds": [
            2,
            5
          ]
        }
      }
    }
  ],
  "output": {
    "success": true
  }
}
