{
  "package": "@activepieces/piece-buffer",
  "version": "0.1.5",
  "action": "create_idea",
  "auth": {
    "type": "SECRET_TEXT",
    "secret_text": "credential000z"
  },
  "inputs": {
    "organizationId": "sample000z",
    "title": "sample001z",
    "text": "sample002z"
  },
  "credential": {
    "token": "credential000z"
  },
  "answers": [
    {
      "status": 200,
      "body": {}
    }
  ],
  "exchanges": [
    {
      "request": {
        "method": "POST",
        "url": "https://api.buffer.com/",
        "headers": {
          "authorization": "Bearer credential000z",
          "content-type": "application/json"
        },
        "body": {
          "query": "\n  mutation CreateIdea($input: CreateIdeaInput!) {\n    createIdea(input: $input) {\n      __typename\n      ... on IdeaResponse {\n        idea {\n          id\n          organizationId\n          groupId\n          createdAt\n          updatedAt\n          content {\n            title\n            text\n            media { url type alt }\n            tags { id name color }\n          }\n        }\n        refreshIdeas\n      }\n      ... on MutationError {\n        message\n      }\n    }\n  }\n",
          "variables": {
            "input": {
              "organizationId": "sample000z",
              "content": {
                "title": "sample001z",
                "text": "sample002z"
              }
            }
          }
        }
      }
    }
  ],
  "output": {
    "error": "Buffer API returned no data"
  }
}
