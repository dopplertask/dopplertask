{
  "package": "@activepieces/piece-buffer",
  "version": "0.1.5",
  "action": "create_post",
  "auth": {
    "type": "SECRET_TEXT",
    "secret_text": "credential000z"
  },
  "inputs": {
    "organizationId": "sample000z",
    "channelIds": "sample001z",
    "text": "sample002z",
    "dueAt": "sample004z",
    "linkUrl": "sample008z"
  },
  "credential": {
    "token": "credential000z"
  },
  "answers": [
    {
      "status": 200,
      "body": {}
    }
  ],
  "exchanges": [
    {
      "request": {
        "method": "POST",
        "url": "https://api.buffer.com/",
        "headers": {
          "authorization": "Bearer credential000z",
          "content-type": "application/json"
        },
        "body": {
          "query": "\n  mutation CreatePost($input: CreatePostInput!) {\n    createPost(input: $input) {\n      __typename\n      ... on PostActionSuccess {\n        post {\n          id\n          text\n          status\n          dueAt\n          sentAt\n          channelId\n        }\n      }\n      ... on MutationError {\n        message\n      }\n    }\n  }\n",
          "variables": {
            "input": {
              "channelId": "s",
              "text": "sample002z",
              "assets": [
                {
                  "link": {
                    "url": "sample008z"
                  }
                }
              ]
            }
          }
        }
      }
    }
  ],
  "output": {
    "error": "Buffer API returned no data"
  }
}
