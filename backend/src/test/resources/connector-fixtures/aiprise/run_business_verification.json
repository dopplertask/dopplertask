{
  "package": "@activepieces/piece-aiprise",
  "version": "0.2.4",
  "action": "run_business_verification",
  "auth": {
    "type": "CUSTOM_AUTH",
    "props": {
      "secret_text": "test-key",
      "environment": "production"
    }
  },
  "inputs": {
    "template_id": "tpl-2",
    "business_profile_id": "bp-1"
  },
  "credential": {
    "apiKey": "test-key",
    "environment": "api"
  },
  "answers": [
    {
      "status": 200,
      "body": {
        "verification_session_id": "bvs-1",
        "status": "RUNNING"
      }
    }
  ],
  "exchanges": [
    {
      "request": {
        "method": "POST",
        "url": "https://api.aiprise.com/api/v1/verify/run_verification_for_business_profile_id",
        "headers": {
          "content-type": "application/json",
          "x-api-key": "test-key"
        },
        "body": {
          "template_id": "tpl-2",
          "business_profile_id": "bp-1"
        }
      }
    }
  ],
  "output": {
    "verification_session_id": "bvs-1",
    "status": "RUNNING"
  }
}
