{
  "package": "@activepieces/piece-aiprise",
  "version": "0.2.4",
  "action": "get_verification_url",
  "auth": {
    "type": "CUSTOM_AUTH",
    "props": {
      "secret_text": "test-key",
      "environment": "production"
    }
  },
  "inputs": {
    "template_id": "tpl-1",
    "redirect_uri": "https://example.com/thanks"
  },
  "credential": {
    "apiKey": "test-key",
    "environment": "api"
  },
  "answers": [
    {
      "status": 200,
      "body": {
        "verification_url": "https://verify.aiprise.com/s/abc",
        "verification_session_id": "vs-2"
      }
    }
  ],
  "exchanges": [
    {
      "request": {
        "method": "POST",
        "url": "https://api.aiprise.com/api/v1/verify/get_user_verification_url",
        "headers": {
          "content-type": "application/json",
          "x-api-key": "test-key"
        },
        "body": {
          "template_id": "tpl-1",
          "redirect_uri": "https://example.com/thanks"
        }
      }
    }
  ],
  "output": {
    "verification_url": "https://verify.aiprise.com/s/abc",
    "verification_session_id": "vs-2"
  }
}
