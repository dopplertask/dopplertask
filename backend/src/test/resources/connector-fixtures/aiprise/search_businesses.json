{
  "package": "@activepieces/piece-aiprise",
  "version": "0.2.4",
  "action": "search_businesses",
  "auth": {
    "type": "CUSTOM_AUTH",
    "props": {
      "secret_text": "test-key",
      "environment": "production"
    }
  },
  "inputs": {
    "name": "Acme",
    "country_code": "US",
    "state_code": "CA"
  },
  "credential": {
    "apiKey": "test-key",
    "environment": "api"
  },
  "answers": [
    {
      "status": 200,
      "body": {
        "results": [
          {
            "entity_id": "C123",
            "name": "Acme Inc",
            "type": "Corporation"
          }
        ]
      }
    }
  ],
  "exchanges": [
    {
      "request": {
        "method": "POST",
        "url": "https://api.aiprise.com/api/v1/data/business/search",
        "headers": {
          "content-type": "application/json",
          "x-api-key": "test-key"
        },
        "body": {
          "name": "Acme",
          "country_code": "US",
          "state_code": "CA"
        }
      }
    }
  ],
  "output": {
    "results": [
      {
        "entity_id": "C123",
        "name": "Acme Inc",
        "type": "Corporation"
      }
    ]
  }
}
