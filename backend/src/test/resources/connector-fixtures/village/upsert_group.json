{
  "package": "@activepieces/piece-village",
  "version": "0.4.6",
  "action": "upsert_group",
  "auth": {
    "type": "SECRET_TEXT",
    "secret_text": "test-key"
  },
  "inputs": {
    "name": "Founders",
    "group_id": "g-1",
    "logo": "https://example.com/logo.png"
  },
  "credential": {
    "token": "test-key"
  },
  "answers": [
    {
      "status": 200,
      "body": {
        "id": "g-1",
        "name": "Founders"
      }
    }
  ],
  "exchanges": [
    {
      "request": {
        "method": "POST",
        "url": "https://api.village.ai/v2/groups",
        "headers": {
          "authorization": "Bearer test-key",
          "content-type": "application/json"
        },
        "body": {
          "name": "Founders",
          "group_id": "g-1",
          "logo": "https://example.com/logo.png"
        }
      }
    }
  ],
  "output": {
    "id": "g-1",
    "name": "Founders"
  }
}
