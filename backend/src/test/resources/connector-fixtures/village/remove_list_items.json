{
  "package": "@activepieces/piece-village",
  "version": "0.4.6",
  "action": "remove_list_items",
  "auth": {
    "type": "SECRET_TEXT",
    "secret_text": "test-key"
  },
  "inputs": {
    "id": "l-1",
    "item_ids": [
      "item-1",
      "item-2"
    ]
  },
  "credential": {
    "token": "test-key"
  },
  "answers": [
    {
      "status": 200,
      "body": {
        "success": true,
        "data": {
          "removed": 2
        }
      }
    }
  ],
  "exchanges": [
    {
      "request": {
        "method": "DELETE",
        "url": "https://api.village.ai/v2/lists/l-1/items",
        "headers": {
          "authorization": "Bearer test-key",
          "content-type": "application/json"
        },
        "body": {
          "item_ids": [
            "item-1",
            "item-2"
          ]
        }
      }
    }
  ],
  "output": {
    "success": true,
    "data": {
      "removed": 2
    }
  }
}
