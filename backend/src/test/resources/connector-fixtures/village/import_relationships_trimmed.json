{
  "package": "@activepieces/piece-village",
  "version": "0.4.6",
  "action": "import_relationships",
  "auth": {
    "type": "SECRET_TEXT",
    "secret_text": "test-key"
  },
  "inputs": {
    "people": [
      {
        "identifier": "  jane@example.com ",
        "score": null,
        "extra": 1
      },
      {
        "identifier": "john@example.com",
        "score": 3
      }
    ]
  },
  "credential": {
    "token": "test-key"
  },
  "answers": [
    {
      "status": 200,
      "body": {
        "success": true,
        "data": []
      }
    }
  ],
  "exchanges": [
    {
      "request": {
        "method": "POST",
        "url": "https://api.village.ai/v2/user/relationships",
        "headers": {
          "authorization": "Bearer test-key",
          "content-type": "application/json"
        },
        "body": {
          "people": [
            {
              "identifier": "jane@example.com"
            },
            {
              "identifier": "john@example.com",
              "score": 3
            }
          ]
        }
      }
    }
  ],
  "output": {
    "success": true,
    "data": []
  }
}
