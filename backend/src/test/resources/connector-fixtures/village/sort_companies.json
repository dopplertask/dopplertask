{
  "package": "@activepieces/piece-village",
  "version": "0.4.6",
  "action": "sort_companies",
  "auth": {
    "type": "SECRET_TEXT",
    "secret_text": "test-key"
  },
  "inputs": {
    "companies": [
      "acme.com",
      "https://linkedin.com/company/globex"
    ]
  },
  "credential": {
    "token": "test-key"
  },
  "answers": [
    {
      "status": 200,
      "body": {
        "success": true,
        "data": []
      }
    }
  ],
  "exchanges": [
    {
      "request": {
        "method": "POST",
        "url": "https://api.village.ai/v2/companies/sort",
        "headers": {
          "authorization": "Bearer test-key",
          "content-type": "application/json"
        },
        "body": {
          "companies": [
            "acme.com",
            "https://linkedin.com/company/globex"
          ]
        }
      }
    }
  ],
  "output": {
    "success": true,
    "data": []
  }
}
