{
  "package": "@activepieces/piece-village",
  "version": "0.4.6",
  "action": "add_list_items",
  "auth": {
    "type": "SECRET_TEXT",
    "secret_text": "test-key"
  },
  "inputs": {
    "id": "l/1",
    "items": [
      {
        "identifier": "acme.com",
        "note": "x"
      },
      {
        "identifier": "https://linkedin.com/in/johndoe",
        "type": "people"
      }
    ]
  },
  "credential": {
    "token": "test-key"
  },
  "answers": [
    {
      "status": 200,
      "body": {
        "success": true,
        "data": []
      }
    }
  ],
  "exchanges": [
    {
      "request": {
        "method": "POST",
        "url": "https://api.village.ai/v2/lists/l%2F1/items",
        "headers": {
          "authorization": "Bearer test-key",
          "content-type": "application/json"
        },
        "body": {
          "items": [
            {
              "identifier": "acme.com"
            },
            {
              "identifier": "https://linkedin.com/in/johndoe",
              "type": "people"
            }
          ]
        }
      }
    }
  ],
  "output": {
    "success": true,
    "data": []
  }
}
