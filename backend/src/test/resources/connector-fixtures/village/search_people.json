{
  "package": "@activepieces/piece-village",
  "version": "0.4.6",
  "action": "search_people",
  "auth": {
    "type": "SECRET_TEXT",
    "secret_text": "test-key"
  },
  "inputs": {
    "prompt": "CTOs in San Francisco",
    "filters": {
      "title": "CTO"
    },
    "limit": 25,
    "mode": "simple",
    "scope": "specific_list",
    "cursor": "c-1",
    "network_filters": {
      "degree": 2
    },
    "include_counts": "all",
    "specific_list_data": [
      "johndoe",
      {
        "id": "janedoe",
        "score": 5
      }
    ]
  },
  "credential": {
    "token": "test-key"
  },
  "answers": [
    {
      "status": 200,
      "body": {
        "success": true,
        "data": []
      }
    }
  ],
  "exchanges": [
    {
      "request": {
        "method": "POST",
        "url": "https://api.village.ai/v2/people/search",
        "headers": {
          "authorization": "Bearer test-key",
          "content-type": "application/json"
        },
        "body": {
          "prompt": "CTOs in San Francisco",
          "filters": {
            "title": "CTO"
          },
          "limit": 25,
          "mode": "simple",
          "scope": "specific_list",
          "cursor": "c-1",
          "network_filters": {
            "degree": 2
          },
          "include_counts": "all",
          "specific_list_data": [
            "johndoe",
            {
              "id": "janedoe",
              "score": 5
            }
          ]
        }
      }
    }
  ],
  "output": {
    "success": true,
    "data": []
  }
}
