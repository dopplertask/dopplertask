{
  "package": "@activepieces/piece-pipedrive",
  "version": "0.10.4",
  "action": "create-activity",
  "auth": {
    "access_token": "test-token",
    "data": {
      "api_domain": "https://acme.pipedrive.com"
    }
  },
  "inputs": {
    "subject": "Demo",
    "isDone": false
  },
  "credential": {
    "oauthAccessToken": "test-token",
    "companyDomain": "acme"
  },
  "answers": [
    {
      "status": 200,
      "body": {
        "success": true,
        "data": {
          "id": 77,
          "subject": "Demo"
        }
      }
    }
  ],
  "exchanges": [
    {
      "request": {
        "method": "POST",
        "url": "https://acme.pipedrive.com/api/v2/activities",
        "headers": {
          "authorization": "Bearer test-token",
          "content-type": "application/json"
        },
        "body": {
          "subject": "Demo",
          "done": false
        }
      }
    }
  ],
  "output": {
    "success": true,
    "data": {
      "id": 77,
      "subject": "Demo"
    }
  }
}
