{
  "package": "@activepieces/piece-pipedrive",
  "version": "0.10.4",
  "action": "create-product",
  "auth": {
    "access_token": "test-token",
    "data": {
      "api_domain": "https://acme.pipedrive.com"
    }
  },
  "inputs": {
    "name": "Widget",
    "code": "W-1",
    "description": "A widget",
    "unit": "pcs",
    "tax": 25,
    "isActive": true,
    "ownerId": 5,
    "currency": "EUR",
    "price": 10,
    "cost": 4,
    "overheadCost": 1,
    "visibleTo": 3,
    "customfields": {
      "hash1": 2
    }
  },
  "credential": {
    "oauthAccessToken": "test-token",
    "companyDomain": "acme"
  },
  "answers": [
    {
      "status": 200,
      "body": {
        "success": true,
        "data": [
          {
            "key": "hash1",
            "name": "Score",
            "field_type": "double",
            "edit_flag": true
          },
          {
            "key": "hash2",
            "name": "Tier",
            "field_type": "enum",
            "edit_flag": true,
            "options": [
              {
                "id": 7,
                "label": "Gold"
              },
              {
                "id": 8,
                "label": "Silver"
              }
            ]
          },
          {
            "key": "hash3",
            "name": "Renewal",
            "field_type": "date",
            "edit_flag": true
          },
          {
            "key": "name",
            "name": "Name",
            "field_type": "varchar",
            "edit_flag": false
          }
        ],
        "additional_data": {
          "pagination": {
            "start": 0,
            "limit": 500,
            "more_items_in_collection": false
          }
        }
      }
    },
    {
      "status": 200,
      "body": {
        "success": true,
        "data": {
          "id": 3,
          "name": "Widget",
          "custom_fields": {
            "hash1": 2
          }
        }
      }
    }
  ],
  "exchanges": [
    {
      "request": {
        "method": "GET",
        "url": "https://acme.pipedrive.com/api/v1/productFields?start=0&limit=500",
        "headers": {
          "authorization": "Bearer test-token"
        },
        "body": null
      }
    },
    {
      "request": {
        "method": "POST",
        "url": "https://acme.pipedrive.com/api/v2/products",
        "headers": {
          "authorization": "Bearer test-token",
          "content-type": "application/json"
        },
        "body": {
          "name": "Widget",
          "code": "W-1",
          "description": "A widget",
          "unit": "pcs",
          "tax": 25,
          "is_deleted": false,
          "prices": [
            {
              "price": 10,
              "currency": "EUR",
              "cost": 4,
              "direct_cost": 1
            }
          ],
          "visible_to": 3,
          "owner_id": 5,
          "custom_fields": {
            "hash1": 2
          }
        }
      }
    }
  ],
  "output": {
    "success": true,
    "data": {
      "id": 3,
      "name": "Widget",
      "Score": 2
    }
  }
}
