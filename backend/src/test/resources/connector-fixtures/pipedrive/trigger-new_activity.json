          "event_action": "create",
          "subscription_url": "https://tasks.example.com/hooks/test-key",
          "version": "2.0"
        }
      }
    },
    {
      "request": {
        "method": "GET",
        "url": "https://acme.pipedrive.com/api/v2/activities/41?include_fields=attendees",
        "headers": {
          "authorization": "Bearer test-token"
        },
        "body": null
      }
    }
  ],
  "output": [
    {
      "id": 41,
      "subject": "Call",
      "attendees": [
        {
          "email": "a@example.com"
        }
      ]
    }
  ]
