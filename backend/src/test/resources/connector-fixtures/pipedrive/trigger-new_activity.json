{
  "package": "@activepieces/piece-pipedrive",
  "version": "0.10.4",
  "trigger": "new_activity",
  "webhook": true,
  "auth": {
    "access_token": "test-token",
    "data": {
      "api_domain": "https://acme.pipedrive.com"
    }
  },
  "inputs": {},
  "credential": {
    "oauthAccessToken": "test-token",
    "companyDomain": "acme"
  },
  "answers": [
    {
      "status": 200,
      "body": {
        "success": true,
        "data": {
          "id": 77
        }
      }
    },
    {
      "status": 200,
      "body": {
        "success": true,
        "data": {
          "id": 41,
          "subject": "Call",
          "attendees": [
            {
              "email": "a@example.com"
            }
          ]
        }
      }
    }
  ],
  "event": {
    "data": {
      "id": 41,
      "subject": "Call"
    },
    "previous": null,
    "meta": {
      "action": "create",
      "entity": "activity"
    }
  },
  "exchanges": [
    {
      "request": {
        "method": "POST",
        "url": "https://acme.pipedrive.com/api/v1/webhooks",
        "headers": {
          "authorization": "Bearer test-token",
          "content-type": "application/json"
