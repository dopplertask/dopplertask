{
  "package": "@activepieces/piece-pipedrive",
  "version": "0.10.4",
  "action": "add-product-to-deal",
  "auth": {
    "access_token": "test-token",
    "data": {
      "api_domain": "https://acme.pipedrive.com"
    }
  },
  "inputs": {
    "dealId": 42,
    "productId": 3,
    "price": 99.5,
    "quantity": 2,
    "enableProduct": true
  },
  "credential": {
    "oauthAccessToken": "test-token",
    "companyDomain": "acme"
  },
  "answers": [
    {
      "status": 200,
      "body": {
        "success": true,
        "data": {
          "id": 5,
          "product_id": 3,
          "deal_id": 42,
          "item_price": 99.5
        }
      }
    }
  ],
  "exchanges": [
    {
      "request": {
        "method": "POST",
        "url": "https://acme.pipedrive.com/api/v2/deals/42/products",
        "headers": {
          "authorization": "Bearer test-token",
          "content-type": "application/json"
        },
        "body": {
          "product_id": 3,
          "item_price": 99.5,
          "quantity": 2,
          "comments": "",
          "is_enabled": true
        }
      }
    }
  ],
  "output": {
    "success": true,
    "data": {
      "id": 5,
      "product_id": 3,
      "deal_id": 42,
      "item_price": 99.5
    }
  }
}
