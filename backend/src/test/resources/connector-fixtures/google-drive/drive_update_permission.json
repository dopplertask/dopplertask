{
  "package": "@activepieces/piece-google-drive",
  "version": "0.13.3",
  "action": "drive_update_permission",
  "auth": {
    "access_token": "test-token",
    "data": {}
  },
  "inputs": {
    "file_id": "file-1",
    "user_email": "ada@example.com",
    "new_role": "reader"
  },
  "credential": {
    "oauthAccessToken": "test-token"
  },
  "answers": [
    {
      "status": 200,
      "body": {
        "permissions": [
          {
            "id": "perm-0",
            "type": "user",
            "role": "writer",
            "emailAddress": "bob@example.com"
          },
          {
            "id": "perm-1",
            "type": "user",
            "role": "writer",
            "emailAddress": "ada@example.com"
          }
        ]
      }
    },
    {
      "status": 200,
      "body": {
        "id": "perm-1",
        "type": "user",
        "role": "reader",
        "emailAddress": "ada@example.com",
        "kind": "drive#permission"
      }
    }
  ],
  "exchanges": [
    {
      "request": {
        "method": "GET",
        "url": "https://www.googleapis.com/drive/v3/files/file-1/permissions?fields=permissions%28id%2CemailAddress%2Crole%29&supportsAllDrives=true",
        "headers": {
          "authorization": "Bearer test-token",
          "x-goog-api-client": "gdcl/8.0.2 gl-node/26.4.0"
        },
        "body": null
      }
    },
    {
      "request": {
        "method": "PATCH",
        "url": "https://www.googleapis.com/drive/v3/files/file-1/permissions/perm-1?supportsAllDrives=true",
        "headers": {
          "authorization": "Bearer test-token",
          "content-type": "application/json",
          "x-goog-api-client": "gdcl/8.0.2 gl-node/26.4.0"
        },
        "body": {
          "role": "reader"
        }
      }
    }
  ],
  "output": {
    "updated": true,
    "permission": {
      "id": "perm-1",
      "type": "user",
      "role": "reader",
      "emailAddress": "ada@example.com",
      "kind": "drive#permission"
    }
  }
}
