{
  "package": "@activepieces/piece-google-drive",
  "version": "0.13.3",
  "action": "duplicate_file",
  "auth": {
    "access_token": "test-token",
    "data": {}
  },
  "inputs": {
    "fileId": "file-1",
    "name": "Report (copy)",
    "folderId": "folder-2",
    "mimeType": "application/vnd.google-apps.document",
    "include_team_drives": true
  },
  "credential": {
    "oauthAccessToken": "test-token"
  },
  "answers": [
    {
      "status": 200,
      "body": {
        "kind": "drive#file",
        "id": "file-copy-1",
        "name": "Report (copy)",
        "mimeType": "application/vnd.google-apps.document"
      }
    }
  ],
  "exchanges": [
    {
      "request": {
        "method": "POST",
        "url": "https://www.googleapis.com/drive/v3/files/file-1/copy?supportsAllDrives=true",
        "headers": {
          "authorization": "Bearer test-token",
          "content-type": "application/json",
          "x-goog-api-client": "gdcl/8.0.2 gl-node/26.4.0"
        },
        "body": {
          "name": "Report (copy)",
          "parents": [
            "folder-2"
          ],
          "mimeType": "application/vnd.google-apps.document"
        }
      }
    }
  ],
  "output": {
    "kind": "drive#file",
    "id": "file-copy-1",
    "name": "Report (copy)",
    "mimeType": "application/vnd.google-apps.document"
  }
}
