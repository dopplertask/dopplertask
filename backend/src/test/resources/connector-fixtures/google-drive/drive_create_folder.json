{
  "package": "@activepieces/piece-google-drive",
  "version": "0.13.3",
  "action": "drive_create_folder",
  "auth": {
    "access_token": "test-token",
    "data": {}
  },
  "inputs": {
    "folder_name": "Invoices 2026",
    "parent_folder_id": "folder-1"
  },
  "settings": {
    "folder_name": "Invoices 2026",
    "folder_id": "folder-1"
  },
  "credential": {
    "oauthAccessToken": "test-token"
  },
  "answers": [
    {
      "status": 200,
      "body": {
        "kind": "drive#file",
        "id": "new-folder-1",
        "name": "Invoices 2026",
        "mimeType": "application/vnd.google-apps.folder"
      }
    }
  ],
  "exchanges": [
    {
      "request": {
        "method": "POST",
        "url": "https://www.googleapis.com/drive/v3/files?supportsAllDrives=true",
        "headers": {
          "authorization": "Bearer test-token",
          "content-type": "application/json",
          "x-goog-api-client": "gdcl/8.0.2 gl-node/26.4.0"
        },
        "body": {
          "mimeType": "application/vnd.google-apps.folder",
          "name": "Invoices 2026",
          "parents": [
            "folder-1"
          ]
        }
      }
    }
  ],
  "output": {
    "kind": "drive#file",
    "id": "new-folder-1",
    "name": "Invoices 2026",
    "mimeType": "application/vnd.google-apps.folder"
  }
}
