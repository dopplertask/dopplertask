{
  "package": "@activepieces/piece-google-drive",
  "version": "0.13.3",
  "action": "drive_list_shared_drives",
  "auth": {
    "access_token": "test-token",
    "data": {}
  },
  "inputs": {
    "query": "name contains 'marketing'",
    "page_size": 10
  },
  "credential": {
    "oauthAccessToken": "test-token"
  },
  "answers": [
    {
      "status": 200,
      "body": {
        "kind": "drive#driveList",
        "drives": [
          {
            "kind": "drive#drive",
            "id": "drive-1",
            "name": "Marketing"
          }
        ]
      }
    }
  ],
  "exchanges": [
    {
      "request": {
        "method": "GET",
