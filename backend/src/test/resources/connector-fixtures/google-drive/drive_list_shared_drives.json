        "headers": {
          "authorization": "Bearer test-token",
          "x-goog-api-client": "gdcl/8.0.2 gl-node/26.4.0"
        },
        "body": null
      }
    }
  ],
  "output": {
    "drives": [
      {
        "kind": "drive#drive",
        "id": "drive-1",
        "name": "Marketing"
      }
    ],
    "count": 1
  }
