{
  "package": "@activepieces/piece-google-drive",
  "version": "0.13.3",
  "action": "drive_replace_file_content",
  "auth": {
    "access_token": "test-token",
    "data": {}
  },
  "inputs": {
    "file_id": "file-1",
    "mime_type": "application/pdf"
  },
  "files": {
    "file": {
      "name": "report.txt",
      "base64": "bmV3IHJlcG9ydCB0ZXh0"
    }
  },
  "credential": {
    "oauthAccessToken": "test-token"
  },
  "answers": [
    {
      "status": 200,
      "body": {
        "kind": "drive#file",
        "id": "file-1",
        "name": "report.txt",
        "mimeType": "text/plain"
      }
    }
  ],
  "exchanges": [
    {
      "request": {
        "method": "PATCH",
        "url": "https://www.googleapis.com/upload/drive/v3/files/file-1?uploadType=media&supportsAllDrives=true",
        "headers": {
          "authorization": "Bearer test-token",
          "content-type": "application/pdf"
        },
        "body": "new report text"
      }
    }
  ],
  "output": {
    "kind": "drive#file",
    "id": "file-1",
    "name": "report.txt",
    "mimeType": "text/plain"
  }
}
