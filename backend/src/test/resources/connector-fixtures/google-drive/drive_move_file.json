{
  "package": "@activepieces/piece-google-drive",
  "version": "0.13.3",
  "action": "drive_move_file",
  "auth": {
    "access_token": "test-token",
    "data": {}
  },
  "inputs": {
    "file_id": "file-1",
    "folder_id": "folder-2"
  },
  "credential": {
    "oauthAccessToken": "test-token"
  },
  "answers": [
    {
      "status": 200,
      "body": {
        "id": "file-1",
        "parents": [
          "old-1"
        ]
      }
    },
    {
      "status": 200,
      "body": {
        "kind": "drive#file",
        "id": "file-1",
        "name": "report.txt",
        "mimeType": "text/plain",
        "parents": [
          "folder-2"
        ]
      }
    }
  ],
  "exchanges": [
    {
      "request": {
        "method": "GET",
        "url": "https://www.googleapis.com/drive/v3/files/file-1?supportsAllDrives=true&fields=id%2Cparents",
        "headers": {
          "authorization": "Bearer test-token",
          "x-goog-api-client": "gdcl/8.0.2 gl-node/26.4.0"
        },
        "body": null
      }
    },
    {
      "request": {
        "method": "PATCH",
        "url": "https://www.googleapis.com/drive/v3/files/file-1?fields=%2A&removeParents=old-1&addParents=folder-2&supportsAllDrives=true",
        "headers": {
          "authorization": "Bearer test-token",
          "x-goog-api-client": "gdcl/8.0.2 gl-node/26.4.0"
        },
        "body": null
      }
    }
  ],
  "output": {
    "kind": "drive#file",
    "id": "file-1",
    "name": "report.txt",
    "mimeType": "text/plain",
    "parents": [
      "folder-2"
    ]
  }
}
