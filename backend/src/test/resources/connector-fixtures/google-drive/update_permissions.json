{
  "package": "@activepieces/piece-google-drive",
  "version": "0.13.3",
  "action": "update_permissions",
  "auth": {
    "access_token": "test-token",
    "data": {}
  },
  "inputs": {
    "fileId": "file-1",
    "user_email": "ada@example.com",
    "permission_name": "writer",
    "send_invitation_email": true,
    "include_team_drives": false
  },
  "credential": {
    "oauthAccessToken": "test-token"
  },
  "answers": [
    {
      "status": 200,
      "body": {
        "id": "perm-1",
        "type": "user",
        "role": "writer",
        "emailAddress": "ada@example.com",
        "kind": "drive#permission"
      }
    }
  ],
  "exchanges": [
    {
      "request": {
        "method": "POST",
        "url": "https://www.googleapis.com/drive/v3/files/file-1/permissions?sendNotificationEmail=true&supportsAllDrives=false",
        "headers": {
          "authorization": "Bearer test-token",
          "content-type": "application/json",
          "x-goog-api-client": "gdcl/8.0.2 gl-node/26.4.0"
        },
        "body": {
          "type": "user",
          "role": "writer",
          "emailAddress": "ada@example.com"
        }
      }
    }
  ],
  "output": {
    "id": "perm-1",
    "type": "user",
    "role": "writer",
    "emailAddress": "ada@example.com",
    "kind": "drive#permission"
  }
}
