{
  "package": "@activepieces/piece-google-drive",
  "version": "0.13.3",
  "action": "drive_update_shared_drive",
  "auth": {
    "access_token": "test-token",
    "data": {}
  },
  "inputs": {
    "drive_id": "drive-1",
    "name": "Marketing EU"
  },
  "credential": {
    "oauthAccessToken": "test-token"
