          "authorization": "Bearer test-token",
          "content-type": "application/json",
          "x-goog-api-client": "gdcl/8.0.2 gl-node/26.4.0"
        },
        "body": {
          "name": "Marketing EU"
        }
      }
    }
  ],
  "output": {
    "kind": "drive#drive",
    "id": "drive-1",
    "name": "Marketing EU"
  }
