{
  "package": "@activepieces/piece-linkedin",
  "version": "0.6.2",
  "auth": {
    "access_token": "test-token",
    "data": {}
  },
  "credential": {
    "oauthAccessToken": "test-token"
  },
  "action": "create_company_update",
  "inputs": {
    "company": "12345",
    "text": "Launch day (today) for @team_alpha",
    "link": "https://example.com/launch",
    "linkTitle": "Launch notes"
  },
  "answers": [
    {
      "status": 201,
      "body": ""
    }
  ],
  "exchanges": [
    {
      "request": {
        "method": "POST",
        "url": "https://api.linkedin.com/rest/posts",
        "headers": {
          "authorization": "Bearer test-token",
          "content-type": "application/json",
          "linkedin-version": "202511",
          "x-restli-protocol-version": "2.0.0"
        },
        "body": {
          "author": "urn:li:organization:12345",
          "lifecycleState": "PUBLISHED",
          "commentary": "Launch day \\(today\\) for \\@team\\_alpha",
          "distribution": {
            "feedDistribution": "MAIN_FEED"
          },
          "visibility": "PUBLIC",
          "isReshareDisabledByAuthor": false,
          "content": {
            "article": {
              "source": "https://example.com/launch",
              "title": "Launch notes"
            }
          }
        }
      }
    }
