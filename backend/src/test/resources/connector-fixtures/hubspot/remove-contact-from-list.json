{
  "package": "@activepieces/piece-hubspot",
  "version": "0.13.2",
  "action": "remove-contact-from-list",
  "auth": {
    "type": "OAUTH2",
    "access_token": "test-token",
    "data": {}
  },
  "inputs": {
    "listId": "123",
    "email": "ada@example.com"
  },
  "answers": [
    {
      "status": 200,
      "body": {
        "total": 1,
        "results": [
          {
            "id": "401",
            "properties": {},
            "createdAt": "2026-01-02T10:00:00.000Z",
            "updatedAt": "2026-01-03T10:00:00.000Z",
            "archived": false
          }
        ]
      }
    },
    {
      "status": 200,
      "body": {
        "updated": [
          401
        ],
        "discarded": [],
        "invalidVids": [],
        "invalidEmails": []
      }
    }
  ],
  "credential": {
    "oauthAccessToken": "test-token"
  },
  "exchanges": [
    {
      "request": {
        "method": "POST",
        "url": "https://api.hubapi.com/crm/v3/objects/contacts/search",
        "headers": {
          "authorization": "Bearer test-token",
          "content-type": "application/json"
        },
        "body": {
          "limit": 1,
          "filterGroups": [
            {
              "filters": [
                {
                  "propertyName": "email",
                  "value": "ada@example.com",
                  "operator": "EQ"
                }
              ]
            }
          ]
        }
      }
    },
    {
      "request": {
        "method": "POST",
        "url": "https://api.hubapi.com/contacts/v1/lists/123/remove",
        "headers": {
          "authorization": "Bearer test-token",
          "content-type": "application/json"
        },
        "body": {
          "vids": [
            "401"
          ]
        }
      }
    }
  ],
  "output": {
    "updated": [
      401
    ],
    "discarded": [],
    "invalidVids": [],
    "invalidEmails": []
  }
}
