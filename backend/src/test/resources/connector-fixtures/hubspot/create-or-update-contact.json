            }
          ]
        }
      }
    },
    {
      "request": {
        "method": "PATCH",
        "url": "https://api.hubapi.com/crm/v3/objects/contacts/401",
        "headers": {
          "authorization": "Bearer test-token",
          "content-type": "application/json"
        },
        "body": {
          "properties": {
            "firstname": "Ada",
            "hs_tags": "vip;beta"
          }
        }
      }
    }
  ],
  "output": {
    "createdAt": "2026-01-02T10:00:00.000Z",
