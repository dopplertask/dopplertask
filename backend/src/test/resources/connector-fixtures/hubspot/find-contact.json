{
  "package": "@activepieces/piece-hubspot",
  "version": "0.13.2",
  "action": "find-contact",
  "auth": {
    "type": "OAUTH2",
    "access_token": "test-token",
    "data": {}
  },
  "inputs": {
    "firstSearchPropertyName": "email",
    "firstSearchPropertyValue": "ada@example.com",
    "secondSearchPropertyName": "firstname",
    "secondSearchPropertyValue": "Ada",
    "additionalPropertiesToRetrieve": [
      "custom_a"
    ]
  },
  "answers": [
    {
      "status": 200,
      "body": {
        "total": 1,
        "results": [
          {
            "id": "201",
            "properties": {
              "name": "Acme"
            },
            "createdAt": "2026-01-02T10:00:00.000Z",
            "updatedAt": "2026-01-03T10:00:00.000Z",
            "archived": false
          }
        ]
      }
    }
  ],
  "credential": {
    "oauthAccessToken": "test-token"
  },
  "exchanges": [
    {
      "request": {
        "method": "POST",
        "url": "https://api.hubapi.com/crm/v3/objects/contacts/search",
        "headers": {
          "authorization": "Bearer test-token",
          "content-type": "application/json"
        },
        "body": {
          "limit": 200,
          "properties": [
            "firstname",
            "lastname",
            "email",
            "company",
            "website",
            "mobilephone",
            "phone",
            "fax",
            "address",
            "city",
            "state",
            "zip",
            "salutation",
            "country",
            "jobtitle",
            "hs_createdate",
            "hs_email_domain",
            "hs_object_id",
            "lastmodifieddate",
            "hs_persona",
            "hs_language",
            "lifecyclestage",
            "createdate",
            "numemployees",
            "annualrevenue",
            "industry",
            "custom_a"
          ],
          "filterGroups": [
            {
              "filters": [
                {
                  "propertyName": "email",
                  "value": "ada@example.com",
                  "operator": "EQ"
                },
                {
                  "propertyName": "firstname",
                  "value": "Ada",
                  "operator": "EQ"
                }
              ]
            }
          ]
        }
      }
    }
  ],
  "output": {
    "total": 1,
    "results": [
      {
        "createdAt": "2026-01-02T10:00:00.000Z",
        "archived": false,
        "id": "201",
        "properties": {
          "name": "Acme"
        },
        "updatedAt": "2026-01-03T10:00:00.000Z"
      }
    ]
  }
}
