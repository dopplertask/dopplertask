{
  "package": "@activepieces/piece-hubspot",
  "version": "0.13.2",
  "action": "create-blog-post",
  "auth": {
    "type": "OAUTH2",
    "access_token": "test-token",
    "data": {}
  },
  "inputs": {
    "contentGroupId": "77",
    "authorId": "88",
    "status": "PUBLISHED",
    "slug": "hello",
    "title": "Hello",
    "body": "<p>Hi</p>",
    "meta": "About hello",
    "imageUrl": "https://example.com/a.png"
  },
  "answers": [
    {
      "status": 200,
      "body": {
        "id": 999
      }
    },
    {
      "status": 200,
      "body": {}
    },
    {
      "status": 200,
      "body": {
        "id": 999,
        "name": "Hello"
      }
    }
  ],
  "credential": {
    "oauthAccessToken": "test-token"
  },
  "exchanges": [
    {
      "request": {
        "method": "POST",
        "url": "https://api.hubapi.com/content/api/v2/blog-posts",
        "headers": {
          "authorization": "Bearer test-token",
          "content-type": "application/json"
        },
        "body": {
          "blog_author_id": "88",
          "content_group_id": "77",
          "featured_image": "https://example.com/a.png",
          "use_featured_image": true,
          "name": "Hello",
          "slug": "hello",
          "meta_description": "About hello",
          "post_body": "<p>Hi</p>",
          "publish_immediately": true
        }
      }
    },
    {
      "request": {
        "method": "POST",
        "url": "https://api.hubapi.com/content/api/v2/blog-posts/999/publish-action",
        "headers": {
          "authorization": "Bearer test-token",
          "content-type": "application/json"
        },
        "body": {
          "action": "schedule-publish"
        }
      }
    },
    {
      "request": {
        "method": "GET",
        "url": "https://api.hubapi.com/content/api/v2/blog-posts/999",
        "headers": {
          "authorization": "Bearer test-token"
        },
        "body": null
      }
    }
  ],
  "output": {
    "id": 999,
    "name": "Hello"
  }
}
