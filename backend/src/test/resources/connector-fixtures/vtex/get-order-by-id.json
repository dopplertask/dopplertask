{
  "package": "@activepieces/piece-vtex",
  "version": "0.3.1",
  "action": "get-order-by-id",
  "auth": {
    "type": "CUSTOM_AUTH",
    "props": {
      "hostUrl": "mystore.vtexcommercestable.com.br",
      "appKey": "test-key",
      "appToken": "test-token"
    }
  },
  "inputs": {
    "OrderId": "1234567890123-01"
  },
  "settings": {
    "orderId": "1234567890123-01"
  },
  "credential": {
    "hostUrl": "mystore.vtexcommercestable.com.br",
    "appKey": "test-key",
    "appToken": "test-token"
  },
  "answers": [
    {
      "status": 200,
      "body": {
        "orderId": "1234567890123-01",
        "status": "invoiced",
        "value": 4990
      }
    }
  ],
  "exchanges": [
    {
      "request": {
        "method": "GET",
        "url": "https://mystore.vtexcommercestable.com.br/api/oms/pvt/orders/1234567890123-01",
        "headers": {
          "x-vtex-api-appkey": "test-key",
          "x-vtex-api-apptoken": "test-token"
        },
        "body": null
      }
    }
  ],
  "output": {
    "orderId": "1234567890123-01",
    "status": "invoiced",
    "value": 4990
  }
}
