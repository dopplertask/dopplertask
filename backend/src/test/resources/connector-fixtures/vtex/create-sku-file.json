{
  "package": "@activepieces/piece-vtex",
  "version": "0.3.1",
  "action": "create-sku-file",
  "auth": {
    "type": "CUSTOM_AUTH",
    "props": {
      "hostUrl": "mystore.vtexcommercestable.com.br",
      "appKey": "test-key",
      "appToken": "test-token"
    }
  },
  "inputs": {
    "SkuId": 310,
    "Url": "https://example.com/shirt.jpg",
    "Name": "shirt",
    "IsMain": true,
    "Label": "Front",
    "Text": "Shirt front"
  },
  "credential": {
    "hostUrl": "mystore.vtexcommercestable.com.br",
    "appKey": "test-key",
    "appToken": "test-token"
  },
  "answers": [
    {
      "status": 200,
      "body": {
        "Id": 501,
        "ArchiveId": 9001,
        "SkuId": 310,
        "Name": "shirt",
        "IsMain": true,
        "Label": "Front"
      }
    }
  ],
  "exchanges": [
    {
      "request": {
        "method": "POST",
        "url": "https://mystore.vtexcommercestable.com.br/api/catalog/pvt/stockkeepingunit/310/file",
        "headers": {
          "content-type": "application/json",
          "x-vtex-api-appkey": "test-key",
          "x-vtex-api-apptoken": "test-token"
        },
        "body": {
          "Url": "https://example.com/shirt.jpg",
          "Name": "shirt",
          "IsMain": true,
          "Label": "Front",
          "Text": "Shirt front"
        }
      }
    }
  ],
  "output": {
    "Id": 501,
    "ArchiveId": 9001,
    "SkuId": 310,
    "Name": "shirt",
    "IsMain": true,
    "Label": "Front"
  }
}
