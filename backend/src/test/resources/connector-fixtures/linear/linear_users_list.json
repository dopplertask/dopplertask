{
  "package": "@activepieces/piece-linear",
  "version": "0.9.3",
  "action": "linear_users_list",
  "auth": {
    "type": "SECRET_TEXT",
    "secret_text": "lin_api_test"
  },
  "inputs": {
    "email": "ada@example.com",
    "name_contains": "Ad",
    "include_disabled": true,
    "limit": 5,
    "cursor": "cursor-1"
  },
  "credential": {
    "apiKey": "lin_api_test"
  },
  "answers": [
    {
      "status": 200,
      "body": {
        "data": {
          "users": {
            "pageInfo": {
              "hasNextPage": false,
              "endCursor": null
            },
            "nodes": [
              {
                "id": "1a2b3c4d-0000-4000-8000-000000000006",
                "name": "Ada",
                "displayName": "ada",
                "email": "ada@example.com",
                "active": true,
                "admin": false,
                "guest": false,
                "url": "https://linear.app/acme/profiles/ada",
                "avatarUrl": null,
                "timezone": "Europe/Berlin",
                "createdAt": "2026-01-02T03:04:05.000Z"
              }
            ]
          }
        }
      }
    }
  ],
  "exchanges": [
    {
      "request": {
        "method": "POST",
        "url": "https://api.linear.app/graphql",
        "headers": {
          "authorization": "lin_api_test",
          "content-type": "application/json"
        },
        "body": {
          "query": "\n  query LinearAtomicUsersList($filter: UserFilter, $first: Int, $after: String, $includeDisabled: Boolean) {\n    users(filter: $filter, first: $first, after: $after, includeDisabled: $includeDisabled) {\n      pageInfo { hasNextPage endCursor }\n      nodes { \n  id\n  name\n  displayName\n  email\n  active\n  admin\n  guest\n  url\n  avatarUrl\n  timezone\n  createdAt\n }\n    }\n  }\n",
          "variables": {
            "filter": {
              "email": {
                "eqIgnoreCase": "ada@example.com"
              },
              "name": {
                "containsIgnoreCase": "Ad"
              }
            },
            "includeDisabled": true,
            "first": 5,
            "after": "cursor-1"
          }
        }
      }
    }
  ],
  "output": {
    "items": [
      {
        "id": "1a2b3c4d-0000-4000-8000-000000000006",
        "name": "Ada",
        "display_name": "ada",
        "email": "ada@example.com",
        "active": true,
        "admin": false,
        "guest": false,
        "url": "https://linear.app/acme/profiles/ada",
        "avatar_url": null,
        "timezone": "Europe/Berlin",
        "created_at": "2026-01-02T03:04:05.000Z"
      }
    ],
    "count": 1,
    "has_next_page": false,
    "end_cursor": null
  }
}
