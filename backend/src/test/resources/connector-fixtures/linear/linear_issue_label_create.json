{
  "package": "@activepieces/piece-linear",
  "version": "0.9.3",
  "action": "linear_issue_label_create",
  "auth": {
    "type": "SECRET_TEXT",
    "secret_text": "lin_api_test"
  },
  "inputs": {
    "name": " Bug ",
    "team_id": "1a2b3c4d-0000-4000-8000-000000000001",
    "color": "#EB5757",
    "description": "Something broke"
  },
  "credential": {
    "apiKey": "lin_api_test"
  },
  "answers": [
    {
      "status": 200,
      "body": {
        "data": {
          "issueLabels": {
            "pageInfo": {
              "hasNextPage": false,
              "endCursor": null
            },
            "nodes": []
          }
        }
      }
    },
    {
      "status": 200,
      "body": {
        "data": {
          "issueLabelCreate": {
            "success": true,
            "issueLabel": {
              "id": "1a2b3c4d-0000-4000-8000-000000000004",
              "name": "bug",
              "color": "#EB5757",
              "description": null,
              "isGroup": false,
              "createdAt": "2026-01-02T03:04:05.000Z",
              "team": {
                "id": "1a2b3c4d-0000-4000-8000-000000000001",
                "key": "ENG",
                "name": "Engineering"
              },
              "parent": null
            }
          }
        }
      }
    }
  ],
  "exchanges": [
    {
      "request": {
        "method": "POST",
        "url": "https://api.linear.app/graphql",
        "headers": {
          "authorization": "lin_api_test",
          "content-type": "application/json"
        },
        "body": {
          "query": "\n  query LinearAtomicIssueLabelsList($filter: IssueLabelFilter, $first: Int, $after: String) {\n    issueLabels(filter: $filter, first: $first, after: $after) {\n      pageInfo { hasNextPage endCursor }\n      nodes { \n  id\n  name\n  color\n  description\n  isGroup\n  createdAt\n  team { id key name }\n  parent { id name }\n }\n    }\n  }\n",
          "variables": {
            "first": 10,
            "filter": {
              "name": {
                "eqIgnoreCase": "Bug"
              },
              "or": [
                {
                  "team": {
                    "id": {
                      "eq": "1a2b3c4d-0000-4000-8000-000000000001"
                    }
                  }
                },
                {
                  "team": {
                    "null": true
                  }
                }
              ]
            }
          }
        }
      }
    },
    {
      "request": {
        "method": "POST",
        "url": "https://api.linear.app/graphql",
        "headers": {
          "authorization": "lin_api_test",
          "content-type": "application/json"
        },
        "body": {
          "query": "\n  mutation LinearAtomicIssueLabelCreate($input: IssueLabelCreateInput!) {\n    issueLabelCreate(input: $input) {\n      success\n      issueLabel { \n  id\n  name\n  color\n  description\n  isGroup\n  createdAt\n  team { id key name }\n  parent { id name }\n }\n    }\n  }\n",
          "variables": {
            "input": {
              "name": "Bug",
              "teamId": "1a2b3c4d-0000-4000-8000-000000000001",
              "color": "#EB5757",
              "description": "Something broke"
            }
          }
        }
      }
    }
  ],
  "output": {
    "created": true,
    "id": "1a2b3c4d-0000-4000-8000-000000000004",
    "name": "bug",
    "color": "#EB5757",
    "description": null,
    "is_group": false,
    "is_workspace_label": false,
    "team_id": "1a2b3c4d-0000-4000-8000-000000000001",
    "team_key": "ENG",
    "team_name": "Engineering",
    "parent_id": null,
    "parent_name": null,
    "created_at": "2026-01-02T03:04:05.000Z"
  }
}
