{
  "package": "@activepieces/piece-pushover",
  "version": "0.3.2",
  "action": "add_user_to_group",
  "auth": {
    "type": "CUSTOM_AUTH",
    "props": {
      "api_token": "test-key",
      "user_key": "test-user"
    }
  },
  "inputs": {
    "group_key": "gkey1",
    "user": "ukey1",
    "device": "iphone",
    "memo": "Primary on-call"
  },
  "credential": {
    "api_token": "test-key"
  },
  "answers": [
    {
      "status": 200,
      "body": {
        "status": 1,
        "request": "req-1"
      }
    }
  ],
  "exchanges": [
    {
      "request": {
        "method": "POST",
        "url": "https://api.pushover.net/1/groups/gkey1/add_user.json",
        "headers": {
          "content-type": "application/json"
        },
        "body": {
          "token": "test-key",
          "user": "ukey1",
          "device": "iphone",
          "memo": "Primary on-call"
        }
      }
    }
  ],
  "output": {
    "status": 1,
    "request": "req-1"
  }
}
