{
  "package": "@activepieces/piece-pushover",
  "version": "0.3.2",
  "action": "cancel_emergency_retries",
  "auth": {
    "type": "CUSTOM_AUTH",
    "props": {
      "api_token": "test-key",
      "user_key": "test-user"
    }
  },
  "inputs": {
    "receipt": "rcpt1"
  },
  "credential": {
    "api_token": "test-key"
  },
  "answers": [
    {
      "status": 200,
      "body": {
        "status": 1,
        "request": "req-1"
      }
    }
  ],
  "exchanges": [
    {
      "request": {
        "method": "POST",
        "url": "https://api.pushover.net/1/receipts/rcpt1/cancel.json",
        "headers": {
          "content-type": "application/json"
        },
        "body": {
          "token": "test-key"
        }
      }
    }
  ],
  "output": {
    "status": 1,
    "request": "req-1"
  }
}
