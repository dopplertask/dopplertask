{
  "package": "@activepieces/piece-intercom",
  "version": "0.9.4",
  "action": "add-note-to-user",
  "auth": {
    "type": "CUSTOM_AUTH",
    "props": {
      "accessToken": "ic-test-token",
      "region": "intercom"
    }
  },
  "inputs": {
    "email": "ada@example.com",
    "body": "Called her"
  },
  "credential": {
    "accessToken": "ic-test-token",
    "region": "intercom"
  },
  "answers": [
    {
      "status": 200,
      "body": {
        "type": "list",
        "data": [
          {
            "type": "contact",
            "id": "c1",
            "role": "user",
            "email": "ada@example.com",
            "name": "Ada"
          }
        ],
        "total_count": 1
      }
    },
    {
      "status": 200,
      "body": {
        "type": "note",
        "id": "n1",
        "body": "<p>Called her</p>"
      }
    }
  ],
  "exchanges": [
    {
      "request": {
        "method": "POST",
        "url": "https://api.intercom.io/contacts/search",
        "headers": {
          "authorization": "Bearer ic-test-token",
          "content-type": "application/json",
          "intercom-version": "2.11",
          "x-fern-language": "JavaScript",
          "x-fern-runtime": "node",
          "x-fern-runtime-version": "26.4.0",
          "x-fern-sdk-name": "intercom-client",
          "x-fern-sdk-version": "6.2.0"
        },
        "body": {
          "query": {
            "field": "email",
            "operator": "=",
            "value": "ada@example.com"
          }
        }
      }
    },
    {
      "request": {
        "method": "POST",
        "url": "https://api.intercom.io/contacts/c1/notes",
        "headers": {
          "authorization": "Bearer ic-test-token",
          "content-type": "application/json",
          "intercom-version": "2.11",
          "x-fern-language": "JavaScript",
          "x-fern-runtime": "node",
          "x-fern-runtime-version": "26.4.0",
          "x-fern-sdk-name": "intercom-client",
          "x-fern-sdk-version": "6.2.0"
        },
        "body": {
          "body": "Called her"
        }
      }
    }
  ],
  "output": {
    "type": "note",
    "id": "n1",
    "body": "<p>Called her</p>"
  }
}
