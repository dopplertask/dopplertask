{
  "package": "@activepieces/piece-intercom",
  "version": "0.9.4",
  "action": "send_message_to_contact",
  "auth": {
    "type": "CUSTOM_AUTH",
    "props": {
      "accessToken": "ic-test-token",
      "region": "intercom"
    }
  },
  "inputs": {
    "contactId": "c1",
    "email": "",
    "messageType": "in_app",
    "subject": "",
    "template": "plain",
    "body": "Hello",
    "adminId": "",
    "openConversation": false
  },
  "credential": {
    "accessToken": "ic-test-token",
    "region": "intercom"
  },
  "answers": [
    {
      "status": 200,
      "body": {
        "type": "contact",
        "id": "c1",
        "role": "user",
        "email": "ada@example.com",
        "name": "Ada"
      }
    },
    {
      "status": 200,
      "body": {
        "type": "admin",
        "id": "991",
        "name": "Ann",
        "email": "ann@example.com"
      }
    },
    {
      "status": 200,
      "body": {
        "type": "inapp",
        "id": "m4"
      }
    }
  ],
  "exchanges": [
    {
      "request": {
        "method": "GET",
        "url": "https://api.intercom.io/contacts/c1",
        "headers": {
          "authorization": "Bearer ic-test-token",
          "intercom-version": "2.11"
        },
        "body": null
      }
    },
    {
      "request": {
        "method": "GET",
        "url": "https://api.intercom.io/me",
        "headers": {
          "authorization": "Bearer ic-test-token",
          "intercom-version": "2.11"
        },
        "body": null
      }
    },
    {
      "request": {
        "method": "POST",
        "url": "https://api.intercom.io/messages",
        "headers": {
          "authorization": "Bearer ic-test-token",
          "content-type": "application/json",
          "intercom-version": "2.11"
        },
        "body": {
          "message_type": "inapp",
          "body": "Hello",
          "from": {
            "type": "admin",
            "id": 991
          },
          "to": {
            "type": "user",
            "id": "c1"
          },
          "create_conversation_without_contact_reply": false
        }
      }
    }
  ],
  "output": {
    "type": "inapp",
    "id": "m4"
  }
}
