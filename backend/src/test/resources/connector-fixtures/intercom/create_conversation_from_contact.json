{
  "package": "@activepieces/piece-intercom",
  "version": "0.9.4",
  "action": "create_conversation_from_contact",
  "auth": {
    "type": "CUSTOM_AUTH",
    "props": {
      "accessToken": "ic-test-token",
      "region": "intercom"
    }
  },
  "inputs": {
    "contactId": "l1",
    "body": "Hi"
  },
  "credential": {
    "accessToken": "ic-test-token",
    "region": "intercom"
  },
  "answers": [
    {
      "status": 200,
      "body": {
        "type": "contact",
        "id": "l1",
        "role": "lead",
        "email": "lee@example.com",
        "name": "Lee"
      }
    },
    {
      "status": 200,
      "body": {
        "type": "user_message",
        "id": "m5",
        "conversation_id": "124"
      }
    }
  ],
  "exchanges": [
    {
      "request": {
        "method": "GET",
        "url": "https://api.intercom.io/contacts/l1",
        "headers": {
          "authorization": "Bearer ic-test-token",
          "intercom-version": "2.11"
        },
        "body": null
      }
    },
    {
      "request": {
        "method": "POST",
        "url": "https://api.intercom.io/conversations",
        "headers": {
          "authorization": "Bearer ic-test-token",
          "content-type": "application/json",
          "intercom-version": "2.11"
        },
        "body": {
          "from": {
            "type": "lead",
            "id": "l1"
          },
          "body": "Hi"
        }
      }
    }
  ],
  "output": {
    "type": "user_message",
    "id": "m5",
    "conversation_id": "124"
  }
}
