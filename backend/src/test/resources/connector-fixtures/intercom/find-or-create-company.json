{
  "package": "@activepieces/piece-intercom",
  "version": "0.9.4",
  "action": "find-or-create-company",
  "auth": {
    "type": "CUSTOM_AUTH",
    "props": {
      "accessToken": "ic-test-token",
      "region": "intercom"
    }
  },
  "inputs": {
    "companyId": "acme-1",
    "name": "Acme",
    "plan": "pro",
    "size": 50,
    "website": "https://acme.example.com",
    "industry": "Tools",
    "customAttributes": {
      "tier": "gold"
    }
  },
  "credential": {
    "accessToken": "ic-test-token",
    "region": "intercom"
  },
  "answers": [
    {
      "status": 200,
      "body": {
        "type": "list",
        "data": [
          {
            "type": "company",
            "id": "co1",
            "company_id": "acme-1",
            "name": "Acme"
          }
        ]
      }
    }
  ],
  "exchanges": [
    {
      "request": {
        "method": "GET",
        "url": "https://api.intercom.io/companies?company_id=acme-1&per_page=1",
        "headers": {
          "authorization": "Bearer ic-test-token",
          "intercom-version": "2.11"
        },
        "body": null
      }
    }
  ],
  "output": {
    "created": false,
    "company": {
      "type": "company",
      "id": "co1",
      "company_id": "acme-1",
      "name": "Acme"
    }
  }
}
