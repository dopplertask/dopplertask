{
  "package": "@activepieces/piece-intercom",
  "version": "0.9.4",
  "action": "send_message_to_contact",
  "auth": {
    "type": "CUSTOM_AUTH",
    "props": {
      "accessToken": "ic-test-token",
      "region": "intercom"
    }
  },
  "inputs": {
    "contactId": "",
    "email": "lee@example.com",
    "messageType": "email",
    "subject": " Welcome ",
    "template": "personal",
    "body": "Hello",
    "adminId": "991",
    "openConversation": true
  },
  "credential": {
    "accessToken": "ic-test-token",
    "region": "intercom"
  },
  "answers": [
    {
      "status": 200,
      "body": {
        "type": "list",
        "data": [
          {
            "type": "contact",
            "id": "l1",
            "role": "lead",
            "email": "lee@example.com",
            "name": "Lee"
          }
        ],
        "total_count": 1
      }
    },
    {
      "status": 200,
      "body": {
        "type": "email",
        "id": "m3"
      }
    }
  ],
  "exchanges": [
    {
      "request": {
        "method": "POST",
        "url": "https://api.intercom.io/contacts/search",
        "headers": {
          "authorization": "Bearer ic-test-token",
          "content-type": "application/json",
          "intercom-version": "2.11"
        },
        "body": {
          "query": {
            "field": "email",
            "operator": "=",
            "value": "lee@example.com"
          },
          "pagination": {
            "per_page": 2
          }
        }
      }
    },
    {
      "request": {
        "method": "POST",
        "url": "https://api.intercom.io/messages",
        "headers": {
          "authorization": "Bearer ic-test-token",
          "content-type": "application/json",
          "intercom-version": "2.11"
        },
        "body": {
          "message_type": "email",
          "subject": "Welcome",
          "template": "personal",
          "body": "Hello",
          "from": {
            "type": "admin",
            "id": 991
          },
          "to": {
            "type": "lead",
            "id": "l1"
          },
          "create_conversation_without_contact_reply": true
        }
      }
    }
  ],
  "output": {
    "type": "email",
    "id": "m3"
  }
}
