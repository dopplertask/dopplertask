{
  "package": "@activepieces/piece-intercom",
  "version": "0.9.4",
  "action": "add_note_to_conversation_by_id",
  "auth": {
    "type": "CUSTOM_AUTH",
    "props": {
      "accessToken": "ic-test-token",
      "region": "intercom"
    }
  },
  "inputs": {
    "conversationId": "123",
    "body": "Note",
    "adminId": "992"
  },
  "credential": {
    "accessToken": "ic-test-token",
    "region": "intercom"
  },
  "answers": [
    {
      "status": 200,
      "body": {
        "type": "conversation",
        "id": "123",
        "state": "open",
        "title": "Help"
      }
    }
  ],
  "exchanges": [
    {
      "request": {
        "method": "POST",
        "url": "https://api.intercom.io/conversations/123/reply",
        "headers": {
          "authorization": "Bearer ic-test-token",
          "content-type": "application/json",
          "intercom-version": "2.11"
        },
        "body": {
          "message_type": "note",
          "type": "admin",
          "admin_id": "992",
          "body": "Note"
        }
      }
    }
  ],
  "output": {
    "type": "conversation",
    "id": "123",
    "state": "open",
    "title": "Help"
  }
}
