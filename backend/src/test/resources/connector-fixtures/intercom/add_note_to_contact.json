{
  "package": "@activepieces/piece-intercom",
  "version": "0.9.4",
  "action": "add_note_to_contact",
  "auth": {
    "type": "CUSTOM_AUTH",
    "props": {
      "accessToken": "ic-test-token",
      "region": "intercom"
    }
  },
  "inputs": {
    "contactId": "c1",
    "body": "VIP customer",
    "adminId": ""
  },
  "credential": {
    "accessToken": "ic-test-token",
    "region": "intercom"
  },
  "answers": [
    {
      "status": 200,
      "body": {
        "type": "admin",
        "id": "991",
        "name": "Ann",
        "email": "ann@example.com"
      }
    },
    {
      "status": 200,
      "body": {
        "type": "note",
        "id": "n2"
      }
    }
  ],
  "exchanges": [
    {
      "request": {
        "method": "GET",
        "url": "https://api.intercom.io/me",
        "headers": {
          "authorization": "Bearer ic-test-token",
          "intercom-version": "2.11"
        },
        "body": null
      }
    },
    {
      "request": {
        "method": "POST",
        "url": "https://api.intercom.io/contacts/c1/notes",
        "headers": {
          "authorization": "Bearer ic-test-token",
          "content-type": "application/json",
          "intercom-version": "2.11"
        },
        "body": {
          "body": "VIP customer",
          "admin_id": "991"
        }
      }
    }
  ],
  "output": {
    "type": "note",
    "id": "n2"
  }
}
