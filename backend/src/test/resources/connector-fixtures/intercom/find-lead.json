{
  "package": "@activepieces/piece-intercom",
  "version": "0.9.4",
  "action": "find-lead",
  "auth": {
    "type": "CUSTOM_AUTH",
    "props": {
      "accessToken": "ic-test-token",
      "region": "intercom"
    }
  },
  "inputs": {
    "searchField": "email",
    "searchValue": "lee@example.com"
  },
  "credential": {
    "accessToken": "ic-test-token",
    "region": "intercom"
  },
  "answers": [
    {
      "status": 200,
      "body": {
        "type": "list",
        "data": [
          {
            "type": "contact",
            "id": "l1",
            "role": "lead",
            "email": "lee@example.com",
            "name": "Lee"
          }
        ],
        "total_count": 1
      }
    }
  ],
  "exchanges": [
    {
      "request": {
        "method": "POST",
        "url": "https://api.intercom.io/contacts/search",
        "headers": {
          "authorization": "Bearer ic-test-token",
          "content-type": "application/json",
          "intercom-version": "2.11",
          "x-fern-language": "JavaScript",
          "x-fern-runtime": "node",
          "x-fern-runtime-version": "26.4.0",
          "x-fern-sdk-name": "intercom-client",
          "x-fern-sdk-version": "6.2.0"
        },
        "body": {
          "query": {
            "operator": "AND",
            "value": [
              {
                "field": "email",
                "operator": "=",
                "value": "lee@example.com"
              },
              {
                "field": "role",
                "operator": "=",
                "value": "lead"
              }
            ]
          },
          "pagination": {
            "per_page": 1
          }
        }
      }
    }
  ],
  "output": {
    "found": true,
    "lead": {
      "type": "contact",
      "id": "l1",
      "role": "lead",
      "email": "lee@example.com",
      "name": "Lee"
    }
  }
}
