{
  "package": "@activepieces/piece-intercom",
  "version": "0.9.4",
  "action": "update_contact",
  "auth": {
    "type": "CUSTOM_AUTH",
    "props": {
      "accessToken": "ic-test-token",
      "region": "intercom"
    }
  },
  "inputs": {
    "contactId": "c1",
    "role": "lead",
    "email": "ada@example.com",
    "name": "",
    "phone": " +46700000002 ",
    "externalId": "u-9",
    "ownerId": "991",
    "unsubscribed": "unsubscribed",
    "customAttributes": {
      "plan": "pro"
    },
    "clearFields": [
      "name"
    ]
  },
  "credential": {
    "accessToken": "ic-test-token",
    "region": "intercom"
  },
  "answers": [
    {
      "status": 200,
      "body": {
        "type": "contact",
        "id": "c1",
        "role": "user",
        "email": "ada@example.com",
        "name": "Ada"
      }
    }
  ],
  "exchanges": [
    {
      "request": {
        "method": "PUT",
        "url": "https://api.intercom.io/contacts/c1",
        "headers": {
          "authorization": "Bearer ic-test-token",
          "content-type": "application/json",
          "intercom-version": "2.11"
        },
        "body": {
          "role": "lead",
          "email": "ada@example.com",
          "phone": "+46700000002",
          "external_id": "u-9",
          "owner_id": 991,
          "unsubscribed_from_emails": true,
          "custom_attributes": {
            "plan": "pro"
          },
          "name": null
        }
      }
    }
  ],
  "output": {
    "type": "contact",
    "id": "c1",
    "role": "user",
    "email": "ada@example.com",
    "name": "Ada"
  }
}
