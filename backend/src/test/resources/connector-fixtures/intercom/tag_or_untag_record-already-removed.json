{
  "package": "@activepieces/piece-intercom",
  "version": "0.9.4",
  "action": "tag_or_untag_record",
  "auth": {
    "type": "CUSTOM_AUTH",
    "props": {
      "accessToken": "ic-test-token",
      "region": "intercom"
    }
  },
  "inputs": {
    "target": "contact",
    "recordId": "c1",
    "tagId": "17",
    "tagName": "",
    "remove": true
  },
  "credential": {
    "accessToken": "ic-test-token",
    "region": "intercom"
  },
  "answers": [
    {
      "status": 200,
      "body": {
        "type": "list",
        "data": [
          {
            "type": "tag",
            "id": "17",
            "name": "VIP"
          },
          {
            "type": "tag",
            "id": "18",
            "name": "Churn"
          }
        ]
      }
    },
    {
      "status": 404,
      "body": {
        "type": "error.list",
        "errors": [
          {
            "code": "tag_not_found",
            "message": "Tag not found"
          }
        ]
      }
    },
    {
      "status": 200,
      "body": {
        "type": "contact",
        "id": "c1",
        "role": "user",
        "email": "ada@example.com",
        "name": "Ada"
      }
    }
  ],
  "exchanges": [
    {
      "request": {
        "method": "GET",
        "url": "https://api.intercom.io/tags",
        "headers": {
          "authorization": "Bearer ic-test-token",
          "intercom-version": "2.11"
        },
        "body": null
      }
    },
    {
      "request": {
        "method": "DELETE",
        "url": "https://api.intercom.io/contacts/c1/tags/17",
        "headers": {
          "authorization": "Bearer ic-test-token",
          "intercom-version": "2.11"
        },
        "body": null
      }
    },
    {
      "request": {
        "method": "GET",
        "url": "https://api.intercom.io/contacts/c1",
        "headers": {
          "authorization": "Bearer ic-test-token",
          "intercom-version": "2.11"
        },
        "body": null
      }
    }
  ],
  "output": {
    "target": "contact",
    "record_id": "c1",
    "tag": {
      "id": "17",
      "name": "VIP"
    },
    "removed": true,
    "already_in_state": true
  }
}
