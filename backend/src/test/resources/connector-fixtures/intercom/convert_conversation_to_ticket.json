{
  "package": "@activepieces/piece-intercom",
  "version": "0.9.4",
  "action": "convert_conversation_to_ticket",
  "auth": {
    "type": "CUSTOM_AUTH",
    "props": {
      "accessToken": "ic-test-token",
      "region": "intercom"
    }
  },
  "inputs": {
    "conversationId": "123",
    "ticketTypeId": "tt1",
    "attributes": {
      "_default_title_": "From chat",
      "Urgent": true
    }
  },
  "credential": {
    "accessToken": "ic-test-token",
    "region": "intercom"
  },
  "answers": [
    {
      "status": 200,
      "body": {
        "type": "ticket_type",
        "id": "tt1",
        "name": "Bug",
        "ticket_type_attributes": {
          "type": "list",
          "data": [
            {
              "name": "_default_title_",
              "data_type": "string",
              "required_to_create": true
            },
            {
              "name": "_default_description_",
              "data_type": "string"
            },
            {
              "name": "Due",
              "data_type": "datetime"
            },
            {
              "name": "Count",
              "data_type": "integer"
            },
            {
              "name": "Urgent",
              "data_type": "boolean"
            }
          ]
        }
      }
    },
    {
      "status": 200,
      "body": {
        "type": "ticket",
        "id": "t1",
        "ticket_id": "42",
        "ticket_state": "submitted",
        "ticket_type": {
          "id": "tt1",
          "name": "Bug"
        }
      }
    }
  ],
  "exchanges": [
    {
      "request": {
        "method": "GET",
        "url": "https://api.intercom.io/ticket_types/tt1",
        "headers": {
          "authorization": "Bearer ic-test-token",
          "intercom-version": "2.11"
        },
        "body": null
      }
    },
    {
      "request": {
        "method": "POST",
        "url": "https://api.intercom.io/conversations/123/convert",
        "headers": {
          "authorization": "Bearer ic-test-token",
          "content-type": "application/json",
          "intercom-version": "2.11"
        },
        "body": {
          "ticket_type_id": "tt1",
          "attributes": {
            "_default_title_": "From chat",
            "Urgent": true
          }
        }
      }
    }
  ],
  "output": {
    "type": "ticket",
    "id": "t1",
    "ticket_id": "42",
    "ticket_state": "submitted",
    "ticket_type": {
      "id": "tt1",
      "name": "Bug"
    }
  }
}
