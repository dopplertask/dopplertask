{
  "package": "@activepieces/piece-intercom",
  "version": "0.9.4",
  "action": "reply_to_conversation_by_id",
  "auth": {
    "type": "CUSTOM_AUTH",
    "props": {
      "accessToken": "ic-test-token",
      "region": "intercom"
    }
  },
  "inputs": {
    "conversationId": "123",
    "body": "Thanks",
    "adminId": "",
    "attachmentUrls": [
      "https://example.com/a.png"
    ]
  },
  "credential": {
    "accessToken": "ic-test-token",
    "region": "intercom"
  },
  "answers": [
    {
      "status": 200,
      "body": {
        "type": "admin",
        "id": "991",
        "name": "Ann",
        "email": "ann@example.com"
      }
    },
    {
      "status": 200,
      "body": {
        "type": "conversation",
        "id": "123",
        "state": "open",
        "title": "Help"
      }
    }
  ],
  "exchanges": [
    {
      "request": {
        "method": "GET",
        "url": "https://api.intercom.io/me",
        "headers": {
          "authorization": "Bearer ic-test-token",
          "intercom-version": "2.11"
        },
        "body": null
      }
    },
    {
      "request": {
        "method": "POST",
        "url": "https://api.intercom.io/conversations/123/reply",
        "headers": {
          "authorization": "Bearer ic-test-token",
          "content-type": "application/json",
          "intercom-version": "2.11"
        },
        "body": {
          "message_type": "comment",
          "type": "admin",
          "admin_id": "991",
          "body": "Thanks",
          "attachment_urls": [
            "https://example.com/a.png"
          ]
        }
      }
    }
  ],
  "output": {
    "type": "conversation",
    "id": "123",
    "state": "open",
    "title": "Help"
  }
}
