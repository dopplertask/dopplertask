{
  "package": "@activepieces/piece-intercom",
  "version": "0.9.4",
  "action": "search_contacts",
  "auth": {
    "type": "CUSTOM_AUTH",
    "props": {
      "accessToken": "ic-test-token",
      "region": "intercom"
    }
  },
  "inputs": {
    "email": "",
    "nameContains": "",
    "role": "",
    "tagId": "",
    "segmentId": "",
    "updatedAfter": "",
    "updatedBefore": "",
    "customAttribute": "",
    "customValue": "",
    "startingAfter": ""
  },
  "credential": {
    "accessToken": "ic-test-token",
    "region": "intercom"
  },
  "answers": [
    {
      "status": 200,
      "body": {
        "type": "list",
        "data": []
      }
    }
  ],
  "exchanges": [
    {
      "request": {
        "method": "POST",
        "url": "https://api.intercom.io/contacts/search",
        "headers": {
          "authorization": "Bearer ic-test-token",
          "content-type": "application/json",
          "intercom-version": "2.11"
        },
        "body": {
          "query": {
            "field": "role",
            "operator": "IN",
            "value": [
              "user",
              "lead"
            ]
          },
          "pagination": {
            "per_page": 50
          }
        }
      }
    }
  ],
  "output": {
    "items": [],
    "total_count": 0,
    "has_more": false,
    "next_starting_after": null
  }
}
