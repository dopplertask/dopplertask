{
  "package": "@activepieces/piece-intercom",
  "version": "0.9.4",
  "action": "add-or-remove-tag-on-contact",
  "auth": {
    "type": "CUSTOM_AUTH",
    "props": {
      "accessToken": "ic-test-token",
      "region": "intercom"
    }
  },
  "inputs": {
    "contactId": "c1",
    "tagId": "17",
    "untag": true
  },
  "credential": {
    "accessToken": "ic-test-token",
    "region": "intercom"
  },
  "answers": [
    {
      "status": 200,
      "body": {
        "type": "tag",
        "id": "17",
        "name": "VIP"
      }
    }
  ],
  "exchanges": [
    {
      "request": {
        "method": "DELETE",
        "url": "https://api.intercom.io/contacts/c1/tags/17",
        "headers": {
          "authorization": "Bearer ic-test-token",
          "intercom-version": "2.11",
          "x-fern-language": "JavaScript",
          "x-fern-runtime": "node",
          "x-fern-runtime-version": "26.4.0",
          "x-fern-sdk-name": "intercom-client",
          "x-fern-sdk-version": "6.2.0"
        },
        "body": null
      }
    }
  ],
  "output": {
    "type": "tag",
    "id": "17",
    "name": "VIP"
  }
}
