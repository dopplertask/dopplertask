{
  "package": "@activepieces/piece-intercom",
  "version": "0.9.4",
  "action": "add-or-remove-tag-on-conversation",
  "auth": {
    "type": "CUSTOM_AUTH",
    "props": {
      "accessToken": "ic-test-token",
      "region": "intercom"
    }
  },
  "inputs": {
    "conversationId": "123",
    "tagId": "17",
    "untag": false
  },
  "credential": {
    "accessToken": "ic-test-token",
    "region": "intercom"
  },
  "answers": [
    {
      "status": 200,
      "body": {
        "type": "admin",
        "id": "991",
        "name": "Ann",
        "email": "ann@example.com"
      }
    },
    {
      "status": 200,
      "body": {
        "type": "tag",
        "id": "17",
        "name": "VIP"
      }
    }
  ],
  "exchanges": [
    {
      "request": {
        "method": "GET",
        "url": "https://api.intercom.io/me",
        "headers": {
          "authorization": "Bearer ic-test-token",
          "intercom-version": "2.11",
          "x-fern-language": "JavaScript",
          "x-fern-runtime": "node",
          "x-fern-runtime-version": "26.4.0",
          "x-fern-sdk-name": "intercom-client",
          "x-fern-sdk-version": "6.2.0"
        },
        "body": null
      }
    },
    {
      "request": {
        "method": "POST",
        "url": "https://api.intercom.io/conversations/123/tags",
        "headers": {
          "authorization": "Bearer ic-test-token",
          "content-type": "application/json",
          "intercom-version": "2.11",
          "x-fern-language": "JavaScript",
          "x-fern-runtime": "node",
          "x-fern-runtime-version": "26.4.0",
          "x-fern-sdk-name": "intercom-client",
          "x-fern-sdk-version": "6.2.0"
        },
        "body": {
          "id": "17",
          "admin_id": "991"
        }
      }
    }
  ],
  "output": {
    "type": "tag",
    "id": "17",
    "name": "VIP"
  }
}
