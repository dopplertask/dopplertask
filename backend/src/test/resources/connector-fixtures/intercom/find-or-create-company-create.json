{
  "package": "@activepieces/piece-intercom",
  "version": "0.9.4",
  "action": "find-or-create-company",
  "auth": {
    "type": "CUSTOM_AUTH",
    "props": {
      "accessToken": "ic-test-token",
      "region": "intercom"
    }
  },
  "inputs": {
    "companyId": "",
    "name": "Acme",
    "plan": "pro",
    "size": 50,
    "website": "https://acme.example.com",
    "industry": "Tools",
    "customAttributes": {
      "tier": "gold"
    }
  },
  "credential": {
    "accessToken": "ic-test-token",
    "region": "intercom"
  },
  "answers": [
    {
      "status": 200,
      "body": {
        "type": "list",
        "data": []
      }
    },
    {
      "status": 200,
      "body": {
        "type": "company",
        "id": "co1",
        "company_id": "acme-1",
        "name": "Acme"
      }
    }
  ],
  "exchanges": [
    {
      "request": {
        "method": "GET",
        "url": "https://api.intercom.io/companies?name=Acme&per_page=1",
        "headers": {
          "authorization": "Bearer ic-test-token",
          "intercom-version": "2.11"
        },
        "body": null
      }
    },
    {
      "request": {
        "method": "POST",
        "url": "https://api.intercom.io/companies",
        "headers": {
          "authorization": "Bearer ic-test-token",
          "content-type": "application/json",
          "intercom-version": "2.11"
        },
        "body": {
          "name": "Acme",
          "plan": "pro",
          "size": 50,
          "website": "https://acme.example.com",
          "industry": "Tools",
          "custom_attributes": {
            "tier": "gold"
          }
        }
      }
    }
  ],
  "output": {
    "created": true,
    "company": {
      "type": "company",
      "id": "co1",
      "company_id": "acme-1",
      "name": "Acme"
    }
  }
}
