{
  "package": "@activepieces/piece-intercom",
  "version": "0.9.4",
  "action": "create-conversation",
  "auth": {
    "type": "CUSTOM_AUTH",
    "props": {
      "accessToken": "ic-test-token",
      "region": "intercom"
    }
  },
  "inputs": {
    "contactType": "user",
    "contactId": "c1",
    "body": "Hi there"
  },
  "credential": {
    "accessToken": "ic-test-token",
    "region": "intercom"
  },
  "answers": [
    {
      "status": 200,
      "body": {
        "type": "user_message",
        "id": "m1",
        "conversation_id": "123"
      }
    }
  ],
  "exchanges": [
    {
      "request": {
        "method": "POST",
        "url": "https://api.intercom.io/conversations",
        "headers": {
          "authorization": "Bearer ic-test-token",
          "content-type": "application/json",
          "intercom-version": "2.11",
          "x-fern-language": "JavaScript",
          "x-fern-runtime": "node",
          "x-fern-runtime-version": "26.4.0",
          "x-fern-sdk-name": "intercom-client",
          "x-fern-sdk-version": "6.2.0"
        },
        "body": {
          "body": "Hi there",
          "from": {
            "type": "user",
            "id": "c1"
          }
        }
      }
    }
  ],
  "output": {
    "type": "user_message",
    "id": "m1",
    "conversation_id": "123"
  }
}
