{
  "package": "@activepieces/piece-intercom",
  "version": "0.9.4",
  "action": "attach_contact_to_company",
  "auth": {
    "type": "CUSTOM_AUTH",
    "props": {
      "accessToken": "ic-test-token",
      "region": "intercom"
    }
  },
  "inputs": {
    "contactId": "c1",
    "companyId": "co1"
  },
  "credential": {
    "accessToken": "ic-test-token",
    "region": "intercom"
  },
  "answers": [
    {
      "status": 200,
      "body": {
        "type": "company",
        "id": "co1",
        "company_id": "acme-1",
        "name": "Acme"
      }
    }
  ],
  "exchanges": [
    {
      "request": {
        "method": "POST",
        "url": "https://api.intercom.io/contacts/c1/companies",
        "headers": {
          "authorization": "Bearer ic-test-token",
          "content-type": "application/json",
          "intercom-version": "2.11"
        },
        "body": {
          "id": "co1"
        }
      }
    }
  ],
  "output": {
    "type": "company",
    "id": "co1",
    "company_id": "acme-1",
    "name": "Acme"
  },
  "settings": {
    "contactId": "c1",
    "intercomCompanyId": "co1"
  }
}
