{
  "package": "@activepieces/piece-intercom",
  "version": "0.9.4",
  "action": "reply_to_ticket",
  "auth": {
    "type": "CUSTOM_AUTH",
    "props": {
      "accessToken": "ic-test-token",
      "region": "intercom"
    }
  },
  "inputs": {
    "ticketId": "t1",
    "messageType": "comment",
    "body": "On it",
    "adminId": "991",
    "attachmentUrls": [
      "https://example.com/a.png",
      "https://example.com/b.png"
    ]
  },
  "credential": {
    "accessToken": "ic-test-token",
    "region": "intercom"
  },
  "answers": [
    {
      "status": 200,
      "body": {
        "type": "ticket_part",
        "id": "tp1"
      }
    }
  ],
  "exchanges": [
    {
      "request": {
        "method": "POST",
        "url": "https://api.intercom.io/tickets/t1/reply",
        "headers": {
          "authorization": "Bearer ic-test-token",
          "content-type": "application/json",
          "intercom-version": "2.11"
        },
        "body": {
          "message_type": "comment",
          "type": "admin",
          "admin_id": "991",
          "body": "On it",
          "attachment_urls": [
            "https://example.com/a.png",
            "https://example.com/b.png"
          ]
        }
      }
    }
  ],
  "output": {
    "type": "ticket_part",
    "id": "tp1"
  }
}
