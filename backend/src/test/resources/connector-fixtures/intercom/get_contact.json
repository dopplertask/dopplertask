{
  "package": "@activepieces/piece-intercom",
  "version": "0.9.4",
  "action": "get_contact",
  "auth": {
    "type": "CUSTOM_AUTH",
    "props": {
      "accessToken": "ic-test-token",
      "region": "intercom"
    }
  },
  "inputs": {
    "lookupBy": "email",
    "value": "ada@example.com"
  },
  "credential": {
    "accessToken": "ic-test-token",
    "region": "intercom"
  },
  "answers": [
    {
      "status": 200,
      "body": {
        "type": "list",
        "data": [
          {
            "type": "contact",
            "id": "c1",
            "role": "user",
            "email": "ada@example.com",
            "name": "Ada"
          }
        ],
        "total_count": 1
      }
    }
  ],
  "exchanges": [
    {
      "request": {
        "method": "POST",
        "url": "https://api.intercom.io/contacts/search",
        "headers": {
          "authorization": "Bearer ic-test-token",
          "content-type": "application/json",
          "intercom-version": "2.11"
        },
        "body": {
          "query": {
            "field": "email",
            "operator": "=",
            "value": "ada@example.com"
          },
          "pagination": {
            "per_page": 2
          }
        }
      }
    }
  ],
  "output": {
    "type": "contact",
    "id": "c1",
    "role": "user",
    "email": "ada@example.com",
    "name": "Ada"
  }
}
