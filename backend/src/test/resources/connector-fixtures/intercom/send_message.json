{
  "package": "@activepieces/piece-intercom",
  "version": "0.9.4",
  "action": "send_message",
  "auth": {
    "type": "CUSTOM_AUTH",
    "props": {
      "accessToken": "ic-test-token",
      "region": "intercom"
    }
  },
  "inputs": {
    "message_type": "email",
    "email_required_fields": {
      "subject": "Welcome",
      "template": "personal"
    },
    "from": "991",
    "to": "c1",
    "body": "Hello Ada",
    "create_conversation_without_contact_reply": true
  },
  "credential": {
    "accessToken": "ic-test-token",
    "region": "intercom"
  },
  "answers": [
    {
      "status": 200,
      "body": {
        "type": "contact",
        "id": "c1",
        "role": "user",
        "email": "ada@example.com",
        "name": "Ada"
      }
    },
    {
      "status": 200,
      "body": {
        "type": "email",
        "id": "m2"
      }
    }
  ],
  "exchanges": [
    {
      "request": {
        "method": "GET",
        "url": "https://api.intercom.io/contacts/c1",
        "headers": {
          "authorization": "Bearer ic-test-token",
          "intercom-version": "2.11",
          "x-fern-language": "JavaScript",
          "x-fern-runtime": "node",
          "x-fern-runtime-version": "26.4.0",
          "x-fern-sdk-name": "intercom-client",
          "x-fern-sdk-version": "6.2.0"
        },
        "body": null
      }
    },
    {
      "request": {
        "method": "POST",
        "url": "https://api.intercom.io/messages",
        "headers": {
          "authorization": "Bearer ic-test-token",
          "content-type": "application/json",
          "intercom-version": "2.11",
          "x-fern-language": "JavaScript",
          "x-fern-runtime": "node",
          "x-fern-runtime-version": "26.4.0",
          "x-fern-sdk-name": "intercom-client",
          "x-fern-sdk-version": "6.2.0"
        },
        "body": {
          "message_type": "email",
          "from": {
            "id": 991,
            "type": "admin"
          },
          "to": {
            "id": "c1",
            "type": "user"
          },
          "template": "personal",
          "subject": "Welcome",
          "create_conversation_without_contact_reply": true,
          "body": "Hello Ada"
        }
      }
    }
  ],
  "output": {
    "type": "email",
    "id": "m2"
  }
}
