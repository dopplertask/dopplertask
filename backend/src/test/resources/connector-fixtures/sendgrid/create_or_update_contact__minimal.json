{
  "package": "@activepieces/piece-sendgrid",
  "version": "0.6.4",
  "action": "create_or_update_contact",
  "auth": {
    "type": "SECRET_TEXT",
    "secret_text": "SG.test-key"
  },
  "inputs": {
    "email": "ada@example.com"
  },
  "credential": {
    "apiKey": "SG.test-key",
    "dataResidency": "api"
  },
  "answers": [
    {
      "status": 202,
      "body": {
        "job_id": "job-2"
      }
    }
  ],
  "exchanges": [
    {
      "request": {
        "method": "PUT",
        "url": "https://api.sendgrid.com/v3/marketing/contacts",
        "headers": {
          "authorization": "Bearer SG.test-key",
          "content-type": "application/json"
        },
        "body": {
          "contacts": [
            {
              "email": "ada@example.com"
            }
          ]
        }
      }
    }
  ],
  "output": {
    "job_id": "job-2"
  }
}
