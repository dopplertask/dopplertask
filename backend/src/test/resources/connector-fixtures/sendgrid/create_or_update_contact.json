{
  "package": "@activepieces/piece-sendgrid",
  "version": "0.6.4",
  "action": "create_or_update_contact",
  "auth": {
    "type": "CUSTOM_AUTH",
    "props": {
      "apiKey": "SG.eu-test-key",
      "dataResidency": "EU"
    }
  },
  "inputs": {
    "email": "ada@example.com",
    "first_name": "Ada",
    "last_name": "Lovelace",
    "list_ids": [
      "list-1",
      "list-2"
    ],
    "custom_fields": {
      "city": "London",
      "country": "UK"
    }
  },
  "credential": {
    "apiKey": "SG.eu-test-key",
    "dataResidency": "api.eu"
  },
  "answers": [
    {
      "status": 202,
      "body": {
        "job_id": "job-1"
      }
    }
  ],
  "exchanges": [
    {
      "request": {
        "method": "PUT",
        "url": "https://api.eu.sendgrid.com/v3/marketing/contacts",
        "headers": {
          "authorization": "Bearer SG.eu-test-key",
          "content-type": "application/json"
        },
        "body": {
          "list_ids": [
            "list-1",
            "list-2"
          ],
          "contacts": [
            {
              "city": "London",
              "country": "UK",
              "email": "ada@example.com",
              "first_name": "Ada",
              "last_name": "Lovelace"
            }
          ]
        }
      }
    }
  ],
  "output": {
    "job_id": "job-1"
  }
}
