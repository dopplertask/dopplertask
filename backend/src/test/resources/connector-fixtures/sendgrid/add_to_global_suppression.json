{
  "package": "@activepieces/piece-sendgrid",
  "version": "0.6.4",
  "action": "add_to_global_suppression",
  "auth": {
    "type": "SECRET_TEXT",
    "secret_text": "SG.test-key"
  },
  "inputs": {
    "emails": [
      " ada@example.com",
      "",
      "bob@example.com"
    ]
  },
  "credential": {
    "apiKey": "SG.test-key",
    "dataResidency": "api"
  },
  "answers": [
    {
      "status": 201,
      "body": {
        "recipient_emails": [
          "ada@example.com",
          "bob@example.com"
        ]
      }
    }
  ],
  "exchanges": [
    {
      "request": {
        "method": "POST",
        "url": "https://api.sendgrid.com/v3/asm/suppressions/global",
        "headers": {
          "authorization": "Bearer SG.test-key",
          "content-type": "application/json"
        },
        "body": {
          "recipient_emails": [
            "ada@example.com",
            "bob@example.com"
          ]
        }
      }
    }
  ],
  "output": {
    "success": true
  }
}
