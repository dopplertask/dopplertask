{
  "package": "@activepieces/piece-sendgrid",
  "version": "0.6.4",
  "action": "send_email",
  "auth": {
    "type": "SECRET_TEXT",
    "secret_text": "SG.test-key"
  },
  "inputs": {
    "to": [
      " ada@example.com",
      "bob@example.com "
    ],
    "from": "news@example.com",
    "from_name": "Example News",
    "reply_to": "replies@example.com",
    "subject": "Hello",
    "content_type": "html",
    "content": "<p>Hi there</p>"
  },
  "credential": {
    "apiKey": "SG.test-key",
    "dataResidency": "api"
  },
  "answers": [
    {
      "status": 202,
      "body": ""
    }
  ],
  "exchanges": [
    {
      "request": {
        "method": "POST",
        "url": "https://api.sendgrid.com/v3/mail/send",
        "headers": {
          "authorization": "Bearer SG.test-key",
          "content-type": "application/json"
        },
        "body": {
          "personalizations": [
            {
              "to": [
                {
                  "email": "ada@example.com"
                }
              ]
            },
            {
              "to": [
                {
                  "email": "bob@example.com"
                }
              ]
            }
          ],
          "from": {
            "email": "news@example.com",
            "name": "Example News"
          },
          "reply_to": {
            "email": "replies@example.com"
          },
          "subject": "Hello",
          "content": [
            {
              "type": "text/html",
              "value": "<p>Hi there</p>"
            }
          ]
        }
      }
    }
  ],
  "output": {
    "success": true
  }
}
