{
  "package": "@activepieces/piece-sendgrid",
  "version": "0.6.4",
  "action": "send_email",
  "auth": {
    "type": "CUSTOM_AUTH",
    "props": {
      "apiKey": "SG.eu-test-key",
      "dataResidency": "EU"
    }
  },
  "inputs": {
    "to": [
      "ada@example.com"
    ],
    "from": "news@example.com",
    "subject": "Hello",
    "content_type": "text",
    "content": "Hi there"
  },
  "credential": {
    "apiKey": "SG.eu-test-key",
    "dataResidency": "api.eu"
  },
  "answers": [
    {
      "status": 202,
      "body": ""
    }
  ],
  "exchanges": [
    {
      "request": {
        "method": "POST",
        "url": "https://api.eu.sendgrid.com/v3/mail/send",
        "headers": {
          "authorization": "Bearer SG.eu-test-key",
          "content-type": "application/json"
        },
        "body": {
          "personalizations": [
            {
              "to": [
                {
                  "email": "ada@example.com"
                }
              ]
            }
          ],
          "from": {
            "email": "news@example.com"
          },
          "reply_to": {
            "email": "news@example.com"
          },
          "subject": "Hello",
          "content": [
            {
              "type": "text/plain",
              "value": "Hi there"
            }
          ]
        }
      }
    }
  ],
  "output": {
    "success": true
  }
}
