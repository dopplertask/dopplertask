{
  "package": "@activepieces/piece-google-sheets",
  "version": "0.19.5",
  "action": "delete-multiple-rows",
  "auth": {
    "type": "OAUTH2",
    "access_token": "test-token",
    "data": {}
  },
  "inputs": {
    "spreadsheetId": "ss-1",
    "sheetId": 7,
    "includeTeamDrives": false,
    "mode": "list",
    "startingRow": 2,
    "endingRow": 4,
    "rowNumbers": "3, 5,5, x, 8"
  },
  "credential": {
    "oauthAccessToken": "test-token"
  },
  "answers": [
    {
      "status": 200,
      "body": {
        "spreadsheetId": "ss-1",
        "replies": [
          {},
          {},
          {}
        ]
      }
    }
  ],
  "exchanges": [
    {
      "request": {
        "method": "POST",
        "url": "https://sheets.googleapis.com/v4/spreadsheets/ss-1:batchUpdate",
        "headers": {
          "authorization": "Bearer test-token",
          "content-type": "application/json",
          "x-goog-api-client": "gdcl/8.0.2 gl-node/26.4.0"
        },
        "body": {
          "requests": [
            {
              "deleteDimension": {
                "range": {
                  "sheetId": 7,
                  "dimension": "ROWS",
                  "startIndex": 7,
                  "endIndex": 8
                }
              }
            },
            {
              "deleteDimension": {
                "range": {
                  "sheetId": 7,
                  "dimension": "ROWS",
                  "startIndex": 4,
                  "endIndex": 5
                }
              }
            },
            {
              "deleteDimension": {
                "range": {
                  "sheetId": 7,
                  "dimension": "ROWS",
                  "startIndex": 2,
                  "endIndex": 3
                }
              }
            }
          ]
        }
      }
    }
  ],
  "output": {
    "success": true,
    "deletedRanges": [
      {
        "startRow": 8,
        "endRow": 8
      },
      {
        "startRow": 5,
        "endRow": 5
      },
      {
        "startRow": 3,
        "endRow": 3
      }
    ],
    "replies": [
      {},
      {},
      {}
    ]
  }
}
