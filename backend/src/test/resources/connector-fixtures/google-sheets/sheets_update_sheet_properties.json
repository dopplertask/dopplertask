{
  "package": "@activepieces/piece-google-sheets",
  "version": "0.19.5",
  "action": "sheets_update_sheet_properties",
  "auth": {
    "type": "OAUTH2",
    "access_token": "test-token",
    "data": {}
  },
  "inputs": {
    "spreadsheetId": "ss-1",
    "sheet_id": 7,
    "frozen_row_count": 1,
    "frozen_column_count": 2,
    "tab_color": "#336699",
    "hidden": "no"
  },
  "credential": {
    "oauthAccessToken": "test-token"
  },
  "answers": [
    {
      "status": 200,
      "body": {
        "spreadsheetId": "ss-1",
        "replies": [
          {}
        ]
      }
    }
  ],
  "exchanges": [
    {
      "request": {
        "method": "POST",
        "url": "https://sheets.googleapis.com/v4/spreadsheets/ss-1:batchUpdate",
        "headers": {
          "authorization": "Bearer test-token",
          "content-type": "application/json",
          "x-goog-api-client": "gdcl/8.0.2 gl-node/26.4.0"
        },
        "body": {
          "requests": [
            {
              "updateSheetProperties": {
                "properties": {
                  "sheetId": 7,
                  "gridProperties": {
                    "frozenRowCount": 1,
                    "frozenColumnCount": 2
                  },
                  "tabColor": {
                    "red": 0.2,
                    "green": 0.4,
                    "blue": 0.6
                  },
                  "hidden": false
                },
                "fields": "gridProperties.frozenRowCount,gridProperties.frozenColumnCount,tabColor,hidden"
              }
            }
          ]
        }
      }
    }
  ],
  "output": {
    "success": true,
    "spreadsheetId": "ss-1",
    "replies": [
      {}
    ]
  }
}
