{
  "package": "@activepieces/piece-google-sheets",
  "version": "0.19.5",
  "action": "create-spreadsheet",
  "auth": {
    "type": "OAUTH2",
    "access_token": "test-token",
    "data": {}
  },
  "inputs": {
    "title": "Plan 2026",
    "includeTeamDrives": true,
    "folder": "folder-1"
  },
  "credential": {
    "oauthAccessToken": "test-token"
  },
  "answers": [
    {
      "status": 200,
      "body": {
        "kind": "drive#file",
        "id": "new-ss",
        "name": "Plan 2026"
      }
    }
  ],
  "exchanges": [
    {
      "request": {
        "method": "POST",
        "url": "https://www.googleapis.com/drive/v3/files?supportsAllDrives=true",
        "headers": {
          "authorization": "Bearer test-token",
          "content-type": "application/json",
          "x-goog-api-client": "gdcl/8.0.2 gl-node/26.4.0"
        },
        "body": {
          "name": "Plan 2026",
          "mimeType": "application/vnd.google-apps.spreadsheet",
          "parents": [
            "folder-1"
          ]
        }
      }
    }
  ],
  "output": {
    "id": "new-ss"
  }
}
