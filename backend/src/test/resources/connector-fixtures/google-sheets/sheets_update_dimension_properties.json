{
  "package": "@activepieces/piece-google-sheets",
  "version": "0.19.5",
  "action": "sheets_update_dimension_properties",
  "auth": {
    "type": "OAUTH2",
    "access_token": "test-token",
    "data": {}
  },
  "inputs": {
    "spreadsheet_id": "ss-1",
    "sheet_id": 7,
    "dimension": "COLUMNS",
    "start_index": 0,
    "end_index": 2,
    "pixel_size": 120,
    "hidden": "yes"
  },
  "credential": {
    "oauthAccessToken": "test-token"
  },
  "answers": [
    {
      "status": 200,
      "body": {
        "spreadsheetId": "ss-1",
        "replies": [
          {}
        ]
      }
    }
  ],
  "exchanges": [
    {
      "request": {
        "method": "POST",
        "url": "https://sheets.googleapis.com/v4/spreadsheets/ss-1:batchUpdate",
        "headers": {
          "authorization": "Bearer test-token",
          "content-type": "application/json",
          "x-goog-api-client": "gdcl/8.0.2 gl-node/26.4.0"
        },
        "body": {
          "requests": [
            {
              "updateDimensionProperties": {
                "range": {
                  "sheetId": 7,
                  "dimension": "COLUMNS",
                  "startIndex": 0,
                  "endIndex": 2
                },
                "properties": {
                  "pixelSize": 120,
                  "hiddenByUser": true
                },
                "fields": "pixelSize,hiddenByUser"
              }
            }
          ]
        }
      }
    }
  ],
  "output": {
    "success": true,
    "spreadsheetId": "ss-1",
    "replies": [
      {}
    ]
  }
}
