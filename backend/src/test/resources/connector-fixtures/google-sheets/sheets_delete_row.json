{
  "package": "@activepieces/piece-google-sheets",
  "version": "0.19.5",
  "action": "sheets_delete_row",
  "auth": {
    "type": "OAUTH2",
    "access_token": "test-token",
    "data": {}
  },
  "inputs": {
    "spreadsheet_id": "ss-1",
    "sheet_id": 7,
    "row_id": 2
  },
  "credential": {
    "oauthAccessToken": "test-token"
  },
  "answers": [
    {
      "status": 200,
      "body": {}
    }
  ],
  "exchanges": [
    {
      "request": {
        "method": "POST",
        "url": "https://sheets.googleapis.com/v4/spreadsheets/ss-1/:batchUpdate",
        "headers": {
          "authorization": "Bearer test-token",
          "content-type": "application/json"
        },
        "body": {
          "requests": [
            {
              "deleteDimension": {
                "range": {
                  "sheetId": 7,
                  "dimension": "ROWS",
                  "startIndex": 1,
                  "endIndex": 2
                }
              }
            }
          ]
        }
      }
    }
  ],
  "output": {
    "success": true
  }
}
