{
  "package": "@activepieces/piece-google-sheets",
  "version": "0.19.5",
  "action": "format-row",
  "auth": {
    "type": "OAUTH2",
    "access_token": "test-token",
    "data": {}
  },
  "inputs": {
    "spreadsheetId": "ss-1",
    "sheetId": 7,
    "includeTeamDrives": false,
    "startingRow": 2,
    "endingRow": 3,
    "bgColor": "#FD6",
    "textColor": "00ff00",
    "bold": true,
    "italic": false,
    "strikethrough": true
  },
  "credential": {
    "oauthAccessToken": "test-token"
  },
  "answers": [
    {
      "status": 200,
      "body": {
        "spreadsheetId": "ss-1",
        "replies": [
          {}
        ]
      }
    }
  ],
  "exchanges": [
    {
      "request": {
        "method": "POST",
        "url": "https://sheets.googleapis.com/v4/spreadsheets/ss-1:batchUpdate",
        "headers": {
          "authorization": "Bearer test-token",
          "content-type": "application/json",
          "x-goog-api-client": "gdcl/8.0.2 gl-node/26.4.0"
        },
        "body": {
          "requests": [
            {
              "repeatCell": {
                "range": {
                  "sheetId": 7,
                  "startRowIndex": 1,
                  "endRowIndex": 3
                },
                "cell": {
                  "userEnteredFormat": {
                    "backgroundColor": {
                      "red": 255,
                      "green": 221,
                      "blue": 102
                    },
                    "textFormat": {
                      "bold": true,
                      "italic": false,
                      "strikethrough": true,
                      "foregroundColor": {
                        "red": 0,
                        "green": 255,
                        "blue": 0
                      }
                    }
                  }
                },
                "fields": "userEnteredFormat(backgroundColor,textFormat)"
              }
            }
          ]
        }
      }
    }
  ],
  "output": {
    "success": true,
    "spreadsheetId": "ss-1",
    "replies": [
      {}
    ]
  }
}
