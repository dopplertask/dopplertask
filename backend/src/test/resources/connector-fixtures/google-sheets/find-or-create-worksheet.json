              "sheetType": "GRID",
              "gridProperties": {
                "rowCount": 1000,
                "columnCount": 26
              }
            }
          },
          {
            "properties": {
              "sheetId": 7,
              "title": "My Sheet",
              "index": 1,
              "sheetType": "GRID",
              "gridProperties": {
                "rowCount": 10,
                "columnCount": 5
              }
            }
          }
        ]
      }
    },
    {
      "status": 200,
      "body": {
