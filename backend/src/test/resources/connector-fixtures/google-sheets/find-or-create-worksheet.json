  "exchanges": [
    {
      "request": {
        "method": "GET",
        "url": "https://sheets.googleapis.com/v4/spreadsheets/ss-1",
        "headers": {
          "authorization": "Bearer test-token",
          "x-goog-api-client": "gdcl/8.0.2 gl-node/26.4.0"
        },
        "body": null
      }
    },
    {
      "request": {
        "method": "POST",
