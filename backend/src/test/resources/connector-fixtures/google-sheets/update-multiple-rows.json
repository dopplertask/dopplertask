{
  "package": "@activepieces/piece-google-sheets",
  "version": "0.19.5",
  "action": "update-multiple-rows",
  "auth": {
    "type": "OAUTH2",
    "access_token": "test-token",
    "data": {}
  },
  "inputs": {
    "spreadsheetId": "ss-1",
    "sheetId": 7,
    "includeTeamDrives": false,
    "values": {
      "values": [
        {
          "rowId": 2,
          "A": "x",
          "C": 5
        },
        {
          "A": "skip"
        },
        {
          "rowId": 4,
          "B": ""
        }
      ]
    },
    "as_string": false,
    "headerRow": 1
  },
  "credential": {
    "oauthAccessToken": "test-token"
  },
  "answers": [
    {
      "status": 200,
      "body": {
        "spreadsheetId": "ss-1",
        "properties": {
          "title": "Budget",
          "locale": "en_US",
          "timeZone": "Europe/Stockholm"
        },
        "spreadsheetUrl": "https://docs.google.com/spreadsheets/d/ss-1/edit",
        "sheets": [
          {
            "properties": {
              "sheetId": 1,
              "title": "Other",
              "index": 0,
              "sheetType": "GRID",
              "gridProperties": {
                "rowCount": 1000,
                "columnCount": 26
              }
            }
          },
          {
            "properties": {
              "sheetId": 7,
              "title": "My Sheet",
              "index": 1,
              "sheetType": "GRID",
              "gridProperties": {
                "rowCount": 10,
                "columnCount": 5
              }
            }
          }
        ]
      }
    },
    {
      "status": 200,
      "body": {
        "spreadsheetId": "ss-1",
        "totalUpdatedRows": 2
      }
    }
  ],
  "exchanges": [
    {
      "request": {
        "method": "GET",
        "url": "https://sheets.googleapis.com/v4/spreadsheets/ss-1",
        "headers": {
          "authorization": "Bearer test-token",
          "x-goog-api-client": "gdcl/8.0.2 gl-node/26.4.0"
        },
        "body": null
      }
    },
    {
      "request": {
        "method": "POST",
        "url": "https://sheets.googleapis.com/v4/spreadsheets/ss-1/values:batchUpdate",
        "headers": {
          "authorization": "Bearer test-token",
          "content-type": "application/json",
          "x-goog-api-client": "gdcl/8.0.2 gl-node/26.4.0"
        },
        "body": {
          "valueInputOption": "USER_ENTERED",
          "data": [
            {
              "range": "My Sheet!A2:ZZZ2",
              "majorDimension": "ROWS",
              "values": [
                [
                  "x",
                  null,
                  "5"
                ]
              ]
            },
            {
              "range": "My Sheet!A4:ZZZ4",
              "majorDimension": "ROWS",
              "values": [
                [
                  null,
                  null
                ]
              ]
            }
          ]
        }
      }
    }
  ],
  "output": {
    "spreadsheetId": "ss-1",
    "totalUpdatedRows": 2
  }
}
