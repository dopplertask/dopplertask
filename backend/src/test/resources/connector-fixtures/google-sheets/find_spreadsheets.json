{
  "package": "@activepieces/piece-google-sheets",
  "version": "0.19.5",
  "action": "find_spreadsheets",
  "auth": {
    "type": "OAUTH2",
    "access_token": "test-token",
    "data": {}
  },
  "inputs": {
    "includeTeamDrives": true,
    "spreadsheet_name": "Ada's Bud",
    "exact_match": false
  },
  "credential": {
    "oauthAccessToken": "test-token"
  },
  "answers": [
    {
      "status": 200,
      "body": {
        "files": [
          {
            "id": "s1",
            "name": "Budget"
          }
        ],
        "nextPageToken": "p2"
      }
    },
    {
      "status": 200,
      "body": {
        "files": [
          {
            "id": "s2",
            "name": "Budget 2"
          }
        ]
      }
    }
  ],
  "exchanges": [
    {
      "request": {
        "method": "GET",
        "url": "https://www.googleapis.com/drive/v3/files?q=mimeType%3D%27application%2Fvnd.google-apps.spreadsheet%27+and+trashed%3Dfalse+and+name+contains+%27Ada%5C%27s+Bud%27&includeItemsFromAllDrives=true&supportsAllDrives=true&corpora=allDrives&fields=files%28id%2Cname%2CwebViewLink%2CcreatedTime%2CmodifiedTime%29%2CnextPageToken",
        "headers": {
          "authorization": "Bearer test-token"
        },
        "body": null
      }
    },
    {
      "request": {
        "method": "GET",
        "url": "https://www.googleapis.com/drive/v3/files?q=mimeType%3D%27application%2Fvnd.google-apps.spreadsheet%27+and+trashed%3Dfalse+and+name+contains+%27Ada%5C%27s+Bud%27&includeItemsFromAllDrives=true&supportsAllDrives=true&corpora=allDrives&fields=files%28id%2Cname%2CwebViewLink%2CcreatedTime%2CmodifiedTime%29%2CnextPageToken&pageToken=p2",
        "headers": {
          "authorization": "Bearer test-token"
        },
        "body": null
      }
    }
  ],
  "output": {
    "found": true,
    "spreadsheets": [
      {
        "id": "s1",
        "name": "Budget"
      },
      {
        "id": "s2",
        "name": "Budget 2"
      }
    ]
  }
}
