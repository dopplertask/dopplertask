{
  "package": "@activepieces/piece-google-sheets",
  "version": "0.19.5",
  "action": "sheets_update_multiple_rows",
  "auth": {
    "type": "OAUTH2",
    "access_token": "test-token",
    "data": {}
  },
  "inputs": {
    "spreadsheet_id": "ss-1",
    "sheet_id": 7,
    "header_row": 1,
    "values": [
      {
        "rowId": 3,
        "B": {
          "n": 1
        },
        "A": "q"
      }
    ],
    "as_string": true
  },
  "credential": {
    "oauthAccessToken": "test-token"
  },
  "answers": [
    {
      "status": 200,
      "body": {
        "spreadsheetId": "ss-1",
        "properties": {
          "title": "Budget",
          "locale": "en_US",
          "timeZone": "Europe/Stockholm"
        },
        "spreadsheetUrl": "https://docs.google.com/spreadsheets/d/ss-1/edit",
        "sheets": [
          {
            "properties": {
              "sheetId": 1,
              "title": "Other",
              "index": 0,
              "sheetType": "GRID",
              "gridProperties": {
                "rowCount": 1000,
                "columnCount": 26
              }
            }
          },
          {
            "properties": {
              "sheetId": 7,
              "title": "My Sheet",
              "index": 1,
              "sheetType": "GRID",
              "gridProperties": {
                "rowCount": 10,
                "columnCount": 5
              }
            }
          }
        ]
      }
    },
    {
      "status": 200,
      "body": {
        "spreadsheetId": "ss-1",
        "totalUpdatedRows": 1
      }
    }
  ],
  "exchanges": [
    {
      "request": {
        "method": "GET",
        "url": "https://sheets.googleapis.com/v4/spreadsheets/ss-1",
        "headers": {
          "authorization": "Bearer test-token",
          "x-goog-api-client": "gdcl/8.0.2 gl-node/26.4.0"
        },
        "body": null
      }
    },
    {
      "request": {
        "method": "POST",
        "url": "https://sheets.googleapis.com/v4/spreadsheets/ss-1/values:batchUpdate",
        "headers": {
          "authorization": "Bearer test-token",
          "content-type": "application/json",
          "x-goog-api-client": "gdcl/8.0.2 gl-node/26.4.0"
        },
        "body": {
          "valueInputOption": "RAW",
          "data": [
            {
              "range": "My Sheet!A3:ZZZ3",
              "majorDimension": "ROWS",
              "values": [
                [
                  "q",
                  "{\n  \"n\": 1\n}"
                ]
              ]
            }
          ]
        }
      }
    }
  ],
  "output": {
    "spreadsheetId": "ss-1",
    "totalUpdatedRows": 1
  }
}
