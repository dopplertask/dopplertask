{
  "package": "@activepieces/piece-google-sheets",
  "version": "0.19.5",
  "trigger": "new-worksheet",
  "auth": {
    "type": "OAUTH2",
    "access_token": "test-token",
    "data": {}
  },
  "inputs": {
    "includeTeamDrives": false,
    "spreadsheetId": "ss-1"
  },
  "settings": {
    "spreadsheetId": "ss-1"
  },
  "credential": {
    "oauthAccessToken": "test-token"
  },
  "store": {
    "worksheets": "[111,222]",
    "seen": [
      "111",
      "222"
    ]
  },
  "answers": [
    {
      "status": 200,
      "body": {
        "spreadsheetId": "ss-1",
        "sheets": [
          {
            "properties": {
              "sheetId": 111,
              "title": "Bookings",
              "index": 0,
              "sheetType": "GRID",
              "gridProperties": {
                "rowCount": 1000,
                "columnCount": 26
              }
            }
          },
          {
            "properties": {
              "sheetId": 333,
              "title": "Courts",
              "index": 1,
              "sheetType": "GRID",
              "gridProperties": {
                "rowCount": 1000,
                "columnCount": 26
              }
            }
          },
          {
            "properties": {
              "sheetId": 222,
              "title": "Members",
              "index": 2,
              "sheetType": "GRID",
              "gridProperties": {
                "rowCount": 1000,
                "columnCount": 26
              }
            }
          },
          {
            "properties": {
              "sheetId": 444,
              "title": "Prices",
              "index": 3,
              "sheetType": "GRID",
              "gridProperties": {
                "rowCount": 500,
                "columnCount": 10
              }
            }
          }
        ]
      }
    }
  ],
  "exchanges": [
    {
      "request": {
        "method": "GET",
        "url": "https://sheets.googleapis.com/v4/spreadsheets/ss-1",
        "headers": {
          "authorization": "Bearer test-token",
          "x-goog-api-client": "gdcl/8.0.2 gl-node/26.4.0"
        },
        "body": null
      }
    }
  ],
  "output": [
    {
      "properties": {
        "sheetId": 333,
        "title": "Courts",
        "index": 1,
        "sheetType": "GRID",
        "gridProperties": {
          "rowCount": 1000,
          "columnCount": 26
        }
      }
    },
    {
      "properties": {
        "sheetId": 444,
        "title": "Prices",
        "index": 3,
        "sheetType": "GRID",
        "gridProperties": {
          "rowCount": 500,
          "columnCount": 10
        }
      }
    }
  ],
  "storeAfter": {
    "worksheets": "[333,444,111,222]",
    "seen": [
      "111",
      "222"
    ]
  }
}
