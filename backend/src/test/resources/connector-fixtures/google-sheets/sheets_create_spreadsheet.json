{
  "package": "@activepieces/piece-google-sheets",
  "version": "0.19.5",
  "action": "sheets_create_spreadsheet",
  "auth": {
    "type": "OAUTH2",
    "access_token": "test-token",
    "data": {}
  },
  "inputs": {
    "spreadsheet_title": "Plan",
    "parent_folder_id": "folder-9"
  },
  "credential": {
    "oauthAccessToken": "test-token"
  },
  "answers": [
    {
      "status": 200,
      "body": {
        "kind": "drive#file",
        "id": "new-ss-2",
        "name": "Plan"
      }
    }
  ],
  "exchanges": [
    {
      "request": {
        "method": "POST",
        "url": "https://www.googleapis.com/drive/v3/files?supportsAllDrives=true",
        "headers": {
          "authorization": "Bearer test-token",
          "content-type": "application/json",
          "x-goog-api-client": "gdcl/8.0.2 gl-node/26.4.0"
        },
        "body": {
          "name": "Plan",
          "mimeType": "application/vnd.google-apps.spreadsheet",
          "parents": [
            "folder-9"
          ]
        }
      }
    }
  ],
  "output": {
    "id": "new-ss-2"
  }
}
