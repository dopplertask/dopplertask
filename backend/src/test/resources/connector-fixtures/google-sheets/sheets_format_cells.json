{
  "package": "@activepieces/piece-google-sheets",
  "version": "0.19.5",
  "action": "sheets_format_cells",
  "auth": {
    "type": "OAUTH2",
    "access_token": "test-token",
    "data": {}
  },
  "inputs": {
    "spreadsheet_id": "ss-1",
    "sheet_id": 7,
    "starting_row": 4,
    "ending_row": 0,
    "bg_color": "#336699",
    "text_color": "zzz",
    "bold": false,
    "italic": true,
    "strikethrough": false
  },
  "settings": {
    "spreadsheetId": "ss-1",
    "sheetId": 7,
    "startingRow": 4,
    "endingRow": 0,
    "bg_color": "#336699",
    "text_color": "zzz",
    "bold": false,
    "italic": true,
    "strikethrough": false
  },
  "credential": {
    "oauthAccessToken": "test-token"
  },
  "answers": [
    {
      "status": 200,
      "body": {
        "spreadsheetId": "ss-1",
        "replies": [
          {}
        ]
      }
    }
  ],
  "exchanges": [
    {
      "request": {
        "method": "POST",
        "url": "https://sheets.googleapis.com/v4/spreadsheets/ss-1:batchUpdate",
        "headers": {
          "authorization": "Bearer test-token",
          "content-type": "application/json",
          "x-goog-api-client": "gdcl/8.0.2 gl-node/26.4.0"
        },
        "body": {
          "requests": [
            {
              "repeatCell": {
                "range": {
                  "sheetId": 7,
                  "startRowIndex": 3,
                  "endRowIndex": 4
                },
                "cell": {
                  "userEnteredFormat": {
                    "backgroundColor": {
                      "red": 0.2,
                      "green": 0.4,
                      "blue": 0.6
                    },
                    "textFormat": {
                      "bold": false,
                      "italic": true,
                      "strikethrough": false
                    }
                  }
                },
                "fields": "userEnteredFormat(backgroundColor,textFormat)"
              }
            }
          ]
        }
      }
    }
  ],
  "output": {
    "success": true,
    "spreadsheetId": "ss-1",
    "replies": [
      {}
    ]
  }
}
