{
  "package": "@activepieces/piece-google-sheets",
  "version": "0.19.5",
  "action": "sheets_add_row",
  "auth": {
    "type": "OAUTH2",
    "access_token": "test-token",
    "data": {}
  },
  "inputs": {
    "spreadsheet_id": "ss-1",
    "sheet_id": 7,
    "first_row_headers": true,
    "as_string": false,
    "values": {
      "A": "x",
      "C": "z"
    }
  },
  "credential": {
    "oauthAccessToken": "test-token"
  },
  "answers": [
    {
      "status": 200,
      "body": {
        "spreadsheetId": "ss-1",
        "properties": {
          "title": "Budget",
          "locale": "en_US",
          "timeZone": "Europe/Stockholm"
        },
        "spreadsheetUrl": "https://docs.google.com/spreadsheets/d/ss-1/edit",
        "sheets": [
          {
            "properties": {
              "sheetId": 1,
              "title": "Other",
              "index": 0,
              "sheetType": "GRID",
              "gridProperties": {
                "rowCount": 1000,
                "columnCount": 26
              }
            }
          },
          {
            "properties": {
              "sheetId": 7,
              "title": "My Sheet",
              "index": 1,
              "sheetType": "GRID",
              "gridProperties": {
                "rowCount": 10,
                "columnCount": 5
              }
            }
          }
        ]
      }
    },
    {
      "status": 200,
      "body": {
        "spreadsheetId": "ss-1",
        "tableRange": "'My Sheet'!A1:C4",
        "updates": {
          "spreadsheetId": "ss-1",
          "updatedRange": "'My Sheet'!A5:C5",
          "updatedRows": 1,
          "updatedColumns": 3,
          "updatedCells": 3
        }
      }
    }
  ],
  "exchanges": [
    {
      "request": {
        "method": "GET",
        "url": "https://sheets.googleapis.com/v4/spreadsheets/ss-1",
        "headers": {
          "authorization": "Bearer test-token"
        },
        "body": null
      }
    },
    {
      "request": {
        "method": "POST",
        "url": "https://sheets.googleapis.com/v4/spreadsheets/ss-1/values/My%20Sheet!A%3AA:append?valueInputOption=USER_ENTERED",
        "headers": {
          "authorization": "Bearer test-token",
          "content-type": "application/json"
        },
        "body": {
          "majorDimension": "COLUMNS",
          "range": "My Sheet!A:A",
          "values": [
            {
              "values": "x"
            },
            null,
            {
              "values": "z"
            }
          ]
        }
      }
    }
  ],
  "output": {
    "spreadsheetId": "ss-1",
    "tableRange": "'My Sheet'!A1:C4",
    "updates": {
      "spreadsheetId": "ss-1",
      "updatedRange": "'My Sheet'!A5:C5",
      "updatedRows": 1,
      "updatedColumns": 3,
      "updatedCells": 3
    },
    "row": 5
  }
}
