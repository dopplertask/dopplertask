{
  "package": "@activepieces/piece-google-sheets",
  "version": "0.19.5",
  "action": "sheets_get_row",
  "auth": {
    "type": "OAUTH2",
    "access_token": "test-token",
    "data": {}
  },
  "inputs": {
    "spreadsheet_id": "ss-1",
    "sheet_id": 7,
    "row_number": 2000,
    "header_row": 1,
    "use_header_names": true
  },
  "credential": {
    "oauthAccessToken": "test-token"
  },
  "answers": [
    {
      "status": 200,
      "body": {
        "spreadsheetId": "ss-1",
        "properties": {
          "title": "Budget",
          "locale": "en_US",
          "timeZone": "Europe/Stockholm"
        },
        "spreadsheetUrl": "https://docs.google.com/spreadsheets/d/ss-1/edit",
        "sheets": [
          {
            "properties": {
              "sheetId": 1,
              "title": "Other",
              "index": 0,
              "sheetType": "GRID",
              "gridProperties": {
                "rowCount": 1000,
                "columnCount": 26
              }
            }
          },
          {
            "properties": {
              "sheetId": 7,
              "title": "My Sheet",
              "index": 1,
              "sheetType": "GRID",
              "gridProperties": {
                "rowCount": 10,
                "columnCount": 5
              }
            }
          }
        ]
      }
    },
    {
      "status": 400,
      "body": {
        "error": {
          "code": 400,
          "message": "Range ('My Sheet'!A2000:ZZZ2000) exceeds grid limits. Max rows: 1000, max columns: 18278",
          "status": "INVALID_ARGUMENT"
        }
      }
    }
  ],
  "exchanges": [
    {
      "request": {
        "method": "GET",
        "url": "https://sheets.googleapis.com/v4/spreadsheets/ss-1",
        "headers": {
          "authorization": "Bearer test-token"
        },
        "body": null
      }
    },
    {
      "request": {
        "method": "GET",
        "url": "https://sheets.googleapis.com/v4/spreadsheets/ss-1/values/My%20Sheet!A2000%3AZZZ2000",
        "headers": {
          "authorization": "Bearer test-token"
        },
        "body": null
      }
    }
  ],
  "output": {
    "found": false,
    "row": null
  }
}
