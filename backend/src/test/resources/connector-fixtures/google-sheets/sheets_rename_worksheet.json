{
  "package": "@activepieces/piece-google-sheets",
  "version": "0.19.5",
  "action": "sheets_rename_worksheet",
  "auth": {
    "type": "OAUTH2",
    "access_token": "test-token",
    "data": {}
  },
  "inputs": {
    "spreadsheet_id": "ss-1",
    "sheet_id": 7,
    "new_name": "Q1"
  },
  "credential": {
    "oauthAccessToken": "test-token"
  },
  "answers": [
    {
      "status": 200,
      "body": {
        "spreadsheetId": "ss-1",
        "replies": [
          {}
        ]
      }
    }
  ],
  "exchanges": [
    {
      "request": {
        "method": "POST",
        "url": "https://sheets.googleapis.com/v4/spreadsheets/ss-1:batchUpdate",
        "headers": {
          "authorization": "Bearer test-token",
          "content-type": "application/json",
          "x-goog-api-client": "gdcl/8.0.2 gl-node/26.4.0"
        },
        "body": {
          "requests": [
            {
              "updateSheetProperties": {
                "properties": {
                  "sheetId": 7,
                  "title": "Q1"
                },
                "fields": "title"
              }
            }
          ]
        }
      }
    }
  ],
  "output": {
    "spreadsheetId": "ss-1",
    "replies": [
      {}
    ]
  }
}
