{
  "package": "@activepieces/piece-google-sheets",
  "version": "0.19.5",
  "action": "sheets_get_spreadsheet",
  "auth": {
    "type": "OAUTH2",
    "access_token": "test-token",
    "data": {}
  },
  "inputs": {
    "spreadsheet_id": "ss-1",
    "include_grid_data": true
  },
  "settings": {
    "spreadsheetId": "ss-1",
    "include_grid_data": true
  },
  "credential": {
    "oauthAccessToken": "test-token"
  },
  "answers": [
    {
      "status": 200,
      "body": {
        "spreadsheetId": "ss-1",
        "properties": {
          "title": "Budget",
          "locale": "en_US",
          "timeZone": "Europe/Stockholm"
        },
        "spreadsheetUrl": "https://docs.google.com/spreadsheets/d/ss-1/edit",
        "sheets": [
          {
            "properties": {
              "sheetId": 1,
              "title": "Other",
              "index": 0,
              "sheetType": "GRID",
              "gridProperties": {
                "rowCount": 1000,
                "columnCount": 26
              }
            }
          },
          {
            "properties": {
              "sheetId": 7,
              "title": "My Sheet",
              "index": 1,
              "sheetType": "GRID",
              "gridProperties": {
                "rowCount": 10,
                "columnCount": 5
              }
            }
          }
        ]
      }
    }
  ],
  "exchanges": [
    {
      "request": {
        "method": "GET",
        "url": "https://sheets.googleapis.com/v4/spreadsheets/ss-1?includeGridData=true",
        "headers": {
          "authorization": "Bearer test-token",
          "x-goog-api-client": "gdcl/8.0.2 gl-node/26.4.0"
        },
        "body": null
      }
    }
  ],
  "output": {
    "spreadsheet_id": "ss-1",
    "title": "Budget",
    "locale": "en_US",
    "time_zone": "Europe/Stockholm",
    "url": "https://docs.google.com/spreadsheets/d/ss-1/edit",
    "worksheets": [
      {
        "sheet_id": 1,
        "title": "Other",
        "index": 0,
        "sheet_type": "GRID",
        "row_count": 1000,
        "column_count": 26
      },
      {
        "sheet_id": 7,
        "title": "My Sheet",
        "index": 1,
        "sheet_type": "GRID",
        "row_count": 10,
        "column_count": 5
      }
    ],
    "worksheet_count": 2
  }
}
