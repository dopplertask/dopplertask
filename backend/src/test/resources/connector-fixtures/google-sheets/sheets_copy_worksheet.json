{
  "package": "@activepieces/piece-google-sheets",
  "version": "0.19.5",
  "action": "sheets_copy_worksheet",
  "auth": {
    "type": "OAUTH2",
    "access_token": "test-token",
    "data": {}
  },
  "inputs": {
    "spreadsheet_id": "ss-1",
    "sheet_id": 7,
    "destination_spreadsheet_id": "ss-2"
  },
  "credential": {
    "oauthAccessToken": "test-token"
  },
  "answers": [
    {
      "status": 200,
      "body": {
        "sheetId": 56,
        "title": "Copy of My Sheet"
      }
    }
  ],
  "exchanges": [
    {
      "request": {
        "method": "POST",
        "url": "https://sheets.googleapis.com/v4/spreadsheets/ss-1/sheets/7:copyTo",
        "headers": {
          "authorization": "Bearer test-token",
          "content-type": "application/json",
          "x-goog-api-client": "gdcl/8.0.2 gl-node/26.4.0"
        },
        "body": {
          "destinationSpreadsheetId": "ss-2"
        }
      }
    }
  ],
  "output": {
    "sheetId": 56,
    "title": "Copy of My Sheet"
  }
}
