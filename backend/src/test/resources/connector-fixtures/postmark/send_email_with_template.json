    ],
    "bcc": [
      "bcc@example.com"
    ],
    "replyTo": "reply@example.com",
    "templateId": 123456,
    "templateModel": {
      "name": "Ada",
      "items": [
        {
          "sku": "A1",
          "qty": 2
        }
      ]
    },
    "tag": "receipt",
    "trackOpens": true,
    "messageStream": "outbound"
  },
  "credential": {
    "token": "pm-test-token"
  },
  "answers": [
    {
      "status": 200,
      "body": {
        "To": "ada@example.com, bob@example.com",
