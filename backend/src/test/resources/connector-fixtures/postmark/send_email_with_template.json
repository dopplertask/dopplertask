{
  "package": "@activepieces/piece-postmark",
  "version": "0.1.2",
  "action": "send_email_with_template",
  "auth": {
    "type": "SECRET_TEXT",
    "secret_text": "pm-test-token"
  },
  "inputs": {
    "from": "news@example.com",
    "to": [
      "ada@example.com",
      "bob@example.com "
    ],
    "cc": [
