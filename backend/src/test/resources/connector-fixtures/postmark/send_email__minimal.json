{
  "package": "@activepieces/piece-postmark",
  "version": "0.1.2",
  "action": "send_email",
  "auth": {
    "type": "SECRET_TEXT",
    "secret_text": "pm-test-token"
  },
  "inputs": {
    "from": "news@example.com",
    "to": [
      "ada@example.com"
    ],
    "subject": "Hello",
    "htmlBody": "<p>Hi</p>",
    "trackOpens": true
  },
  "credential": {
    "token": "pm-test-token"
  },
  "answers": [
    {
      "status": 200,
      "body": {
        "To": "ada@example.com, bob@example.com",
        "SubmittedAt": "2026-01-02T10:00:00.0000000-05:00",
        "MessageID": "b7bc2f4a-e38e-4336-af7d-e6c392c2f817",
        "ErrorCode": 0,
        "Message": "OK"
      }
    }
  ],
  "exchanges": [
    {
      "request": {
        "method": "POST",
        "url": "https://api.postmarkapp.com/email",
        "headers": {
          "content-type": "application/json",
          "x-postmark-server-token": "pm-test-token"
        },
        "body": {
          "From": "news@example.com",
          "To": "ada@example.com",
          "Subject": "Hello",
          "HtmlBody": "<p>Hi</p>",
          "TrackOpens": true,
          "MessageStream": "outbound"
        }
      }
    }
  ],
  "output": {
    "success": true,
    "response": {
      "To": "ada@example.com, bob@example.com",
      "SubmittedAt": "2026-01-02T10:00:00.0000000-05:00",
      "MessageID": "b7bc2f4a-e38e-4336-af7d-e6c392c2f817",
      "ErrorCode": 0,
      "Message": "OK"
    }
  }
}
