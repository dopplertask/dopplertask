{
  "package": "@activepieces/piece-mailgun",
  "version": "0.1.3",
  "action": "add_mailing_list_member",
  "auth": {
    "props": {
      "api_key": "key-test123",
      "region": "us"
    }
  },
  "inputs": {
    "list": "news@mg.example.com",
    "address": "bob@example.com",
    "name": "Bob",
    "upsert": true,
    "subscribed": false,
    "vars": {
      "age": 30,
      "city": "Paris"
    }
  },
  "credential": {
    "api_key": "key-test123",
    "region": "api"
  },
  "answers": [
    {
      "status": 200,
      "body": {
        "member": {
          "address": "bob@example.com",
          "name": "Bob",
          "subscribed": false,
          "vars": {
            "age": 30,
            "city": "Paris"
          }
        },
        "message": "Mailing list member has been created"
      }
    }
  ],
  "exchanges": [
    {
      "request": {
        "method": "POST",
        "url": "https://api.mailgun.net/v3/lists/news@mg.example.com/members",
        "headers": {
          "authorization": "Basic YXBpOmtleS10ZXN0MTIz",
          "content-type": "application/x-www-form-urlencoded"
        },
        "body": "address=bob%40example.com&upsert=yes&subscribed=no&name=Bob&vars=%7B%22age%22%3A30%2C%22city%22%3A%22Paris%22%7D"
      }
    }
  ],
  "output": {
    "message": "Mailing list member has been created",
    "member_address": "bob@example.com",
    "member_name": "Bob",
    "member_subscribed": false,
    "member_vars": "{\"age\":30,\"city\":\"Paris\"}"
  }
}
