{
  "package": "@activepieces/piece-microsoft-outlook",
  "version": "0.7.6",
  "auth": {
    "type": "OAUTH2",
    "access_token": "test-token",
    "data": {},
    "props": {
      "cloud": "login.microsoftonline.com",
      "tenant": "common"
    }
  },
  "credential": {
    "oauthAccessToken": "test-token"
  },
  "action": "request_approval_in_mail",
  "inputs": {
    "recipients": "manager@example.com",
    "subject": "Approval needed: order 1042",
    "body": "Please approve <b>order 1042</b>."
  },
  "answers": [
    {
      "status": 202,
      "body": "",
      "headers": {
        "content-type": "text/plain"
      }
    }
  ],
  "answer": {
    "query": {
      "action": "disapprove"
    }
  },
  "exchanges": [
    {
      "request": {
        "method": "POST",
        "url": "https://graph.microsoft.com/v1.0/me/sendMail",
        "headers": {
          "authorization": "Bearer test-token",
          "content-type": "application/json",
          "sdkversion": "graph-js/3.0.7 (featureUsage=7)"
        },
        "body": {
          "message": {
            "subject": "Approval needed: order 1042",
            "body": {
              "content": "\n        <div>\n          <p>Please approve <b>order 1042</b>.</p>\n          <br />\n          <p>\n            <a href=\"https://tasks.example.com/hooks/resume/test-key/confirm\" style=\"display: inline-block; padding: 10px 20px; background-color: #6e41e2; color: white; text-decoration: none; border-radius: 4px;\">Review &amp; Respond</a>\n          </p>\n        </div>\n      ",
              "contentType": "html"
            },
            "toRecipients": [
              {
                "emailAddress": {
                  "address": "manager@example.com"
                }
              }
            ]
          },
          "saveToSentItems": true
        }
      }
    }
  ],
  "output": {
    "approved": false
  }
}
