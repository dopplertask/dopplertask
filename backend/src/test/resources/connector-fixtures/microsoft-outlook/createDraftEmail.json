{
  "package": "@activepieces/piece-microsoft-outlook",
  "version": "0.7.6",
  "action": "createDraftEmail",
  "auth": {
    "type": "OAUTH2",
    "access_token": "test-token",
    "data": {},
    "props": {
      "cloud": "login.microsoftonline.com",
      "tenant": "common"
    }
  },
  "inputs": {
    "recipients": [
      "ada@example.com"
    ],
    "ccRecipients": [
      "cc@example.com"
    ],
    "bccRecipients": [],
    "subject": "Draft one",
    "bodyFormat": "text",
    "body": "Body text"
  },
  "credential": {
    "oauthAccessToken": "test-token"
  },
  "answers": [
    {
      "status": 201,
      "body": {
        "id": "draft-2",
        "subject": "Draft one",
        "isDraft": true
      }
    }
  ],
  "exchanges": [
    {
      "request": {
        "method": "POST",
        "url": "https://graph.microsoft.com/v1.0/me/messages",
        "headers": {
          "authorization": "Bearer test-token",
          "content-type": "application/json",
          "sdkversion": "graph-js/3.0.7 (featureUsage=7)"
        },
        "body": {
          "subject": "Draft one",
          "body": {
            "content": "Body text",
            "contentType": "text"
          },
          "toRecipients": [
            {
              "emailAddress": {
                "address": "ada@example.com"
              }
            }
          ],
          "ccRecipients": [
            {
              "emailAddress": {
                "address": "cc@example.com"
              }
            }
          ],
          "bccRecipients": [],
          "attachments": []
        }
      }
    }
  ],
  "output": {
    "id": "draft-2",
    "subject": "Draft one",
    "isDraft": true
  }
}
