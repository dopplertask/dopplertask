{
  "package": "@activepieces/piece-microsoft-outlook",
  "version": "0.7.6",
  "action": "outlook_get_mail_tips",
  "auth": {
    "type": "OAUTH2",
    "access_token": "test-token",
    "data": {},
    "props": {
      "cloud": "login.microsoftonline.com",
      "tenant": "common"
    }
  },
  "inputs": {
    "emailAddresses": [
      "ada@example.com",
      "bob@example.com"
    ]
  },
  "credential": {
    "oauthAccessToken": "test-token"
  },
  "answers": [
    {
      "status": 200,
      "body": {
        "value": [
          {
            "emailAddress": {
              "address": "ada@example.com"
            },
            "mailboxFull": false
          }
        ]
      }
    }
  ],
  "exchanges": [
    {
      "request": {
        "method": "POST",
        "url": "https://graph.microsoft.com/v1.0/me/getMailTips",
        "headers": {
          "authorization": "Bearer test-token",
          "content-type": "application/json",
          "sdkversion": "graph-js/3.0.7 (featureUsage=7)"
        },
        "body": {
          "EmailAddresses": [
            "ada@example.com",
            "bob@example.com"
          ],
          "MailTipsOptions": "automaticReplies, mailboxFullStatus, customMailTip, externalMemberCount, maxMessageSize, deliveryRestriction, moderationStatus, recipientScope, totalMemberCount"
        }
      }
    }
  ],
  "output": {
    "mailTips": [
      {
        "emailAddress": {
          "address": "ada@example.com"
        },
        "mailboxFull": false
      }
    ],
    "count": 1
  }
}
