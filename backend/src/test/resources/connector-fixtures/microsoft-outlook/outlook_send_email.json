{
  "package": "@activepieces/piece-microsoft-outlook",
  "version": "0.7.6",
  "action": "outlook_send_email",
  "auth": {
    "type": "OAUTH2",
    "access_token": "test-token",
    "data": {},
    "props": {
      "cloud": "login.microsoftonline.com",
      "tenant": "common"
    }
  },
  "inputs": {
    "recipients": [
      "ada@example.com"
    ],
    "ccRecipients": [
      "cc@example.com"
    ],
    "bccRecipients": [
      "bcc@example.com"
    ],
    "subject": "Hello",
    "bodyFormat": "text",
    "body": "Plain body"
  },
  "credential": {
    "oauthAccessToken": "test-token"
  },
  "answers": [
    {
      "status": 202,
      "body": "",
      "headers": {
        "content-type": "text/plain"
      }
    }
  ],
  "exchanges": [
    {
      "request": {
        "method": "POST",
        "url": "https://graph.microsoft.com/v1.0/me/sendMail",
        "headers": {
          "authorization": "Bearer test-token",
          "content-type": "application/json",
          "sdkversion": "graph-js/3.0.7 (featureUsage=7)"
        },
        "body": {
          "message": {
            "subject": "Hello",
            "body": {
              "content": "Plain body",
              "contentType": "text"
            },
            "toRecipients": [
              {
                "emailAddress": {
                  "address": "ada@example.com"
                }
              }
            ],
            "ccRecipients": [
              {
                "emailAddress": {
                  "address": "cc@example.com"
                }
              }
            ],
            "bccRecipients": [
              {
                "emailAddress": {
                  "address": "bcc@example.com"
                }
              }
            ],
            "attachments": []
          },
          "saveToSentItems": "true"
        }
      }
    }
  ],
  "output": {
    "success": true,
    "message": "Email sent successfully.",
    "subject": "Hello",
    "recipients": [
      "ada@example.com"
    ]
  }
}
