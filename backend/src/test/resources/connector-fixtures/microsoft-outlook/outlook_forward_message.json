{
  "package": "@activepieces/piece-microsoft-outlook",
  "version": "0.7.6",
  "action": "outlook_forward_message",
  "auth": {
    "type": "OAUTH2",
    "access_token": "test-token",
    "data": {},
    "props": {
      "cloud": "login.microsoftonline.com",
      "tenant": "common"
    }
  },
  "inputs": {
    "messageId": "AAMkAGI2TG93AAA=",
    "recipients": [
      "ada@example.com",
      "bob@example.com"
    ],
    "comment": "See below"
  },
  "credential": {
    "oauthAccessToken": "test-token"
  },
  "answers": [
    {
      "status": 202,
      "body": "",
      "headers": {
        "content-type": "text/plain"
      }
    }
  ],
  "exchanges": [
    {
      "request": {
        "method": "POST",
        "url": "https://graph.microsoft.com/v1.0/me/messages/AAMkAGI2TG93AAA%3D/forward",
        "headers": {
          "authorization": "Bearer test-token",
          "content-type": "application/json",
          "sdkversion": "graph-js/3.0.7 (featureUsage=7)"
        },
        "body": {
          "comment": "See below",
          "toRecipients": [
            {
              "emailAddress": {
                "address": "ada@example.com"
              }
            },
            {
              "emailAddress": {
                "address": "bob@example.com"
              }
            }
          ]
        }
      }
    }
  ],
  "output": {
    "success": true,
    "message": "Message forwarded successfully.",
    "messageId": "AAMkAGI2TG93AAA=",
    "recipients": [
      "ada@example.com",
      "bob@example.com"
    ]
