{
  "package": "@activepieces/piece-convertkit",
  "version": "0.4.2",
  "trigger": "webhook_link_clicked",
  "webhook": true,
  "auth": {
    "type": "SECRET_TEXT",
    "secret_text": "test-secret"
  },
  "inputs": {
    "initiatorValue": "https://example.com/offer"
  },
  "settings": {
    "initiator_value": "https://example.com/offer"
  },
  "credential": {
    "apiSecret": "test-secret"
  },
  "answers": [
    {
      "status": 200,
      "body": {
        "rule": {
          "id": 7,
          "account_id": 3,
          "event": {
            "name": "link_click",
            "initiator_value": "https://example.com/offer"
          },
          "target_url": "https://tasks.example.com/hooks/test-key"
        }
      }
    }
  ],
  "event": {
    "subscriber": {
      "id": 11,
      "first_name": "Ada",
      "email_address": "ada@example.com",
      "state": "active",
      "created_at": "2026-01-02T10:00:00.000Z",
      "fields": {
        "company": "Example Co"
      }
    }
  },
  "exchanges": [
    {
      "request": {
        "method": "POST",
        "url": "https://api.convertkit.com/v3/automations/hooks?api_secret=test-secret",
        "headers": {
          "content-type": "application/json"
        },
        "body": {
          "event": {
            "name": "subscriber.link_click",
            "initiator_value": "https://example.com/offer"
          },
          "target_url": "https://tasks.example.com/hooks/test-key"
        }
      }
    }
  ],
  "output": [
    {
      "id": 11,
      "first_name": "Ada",
      "email_address": "ada@example.com",
      "state": "active",
      "created_at": "2026-01-02T10:00:00.000Z",
      "fields": {
        "company": "Example Co"
      }
    },
    "https://example.com/offer"
  ]
}
