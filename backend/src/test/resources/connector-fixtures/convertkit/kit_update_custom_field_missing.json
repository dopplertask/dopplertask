{
  "package": "@activepieces/piece-convertkit",
  "version": "0.4.2",
  "auth": {
    "type": "SECRET_TEXT",
    "secret_text": "test-secret"
  },
  "action": "kit_update_custom_field",
  "inputs": {
    "custom_field_id": "12",
    "label": "Company Name"
  },
  "credential": {
    "apiSecret": "test-secret"
  },
  "answers": [
    {
      "status": 200,
      "body": {}
    },
    {
      "status": 200,
      "body": {
        "custom_fields": []
      }
    }
  ],
  "exchanges": [
    {
      "request": {
        "method": "PUT",
        "url": "https://api.convertkit.com/v3/custom_fields/12?api_secret=test-secret",
        "headers": {
          "content-type": "application/json"
        },
        "body": {
          "label": "Company Name"
        }
      }
    },
    {
      "request": {
        "method": "GET",
        "url": "https://api.convertkit.com/v3/custom_fields?api_secret=test-secret",
        "headers": {},
        "body": null
      }
    }
  ],
  "output": {
    "id": 12,
    "label": "Company Name",
    "refreshed": false,
    "refresh_error": "The rename succeeded, but the field was not in the refreshed custom field list."
  }
}
