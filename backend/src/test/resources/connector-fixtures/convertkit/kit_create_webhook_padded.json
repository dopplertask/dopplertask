{
  "package": "@activepieces/piece-convertkit",
  "version": "0.4.2",
  "auth": {
    "type": "SECRET_TEXT",
    "secret_text": "test-secret"
  },
  "action": "kit_create_webhook",
  "inputs": {
    "target_url": " https://example.com/hook ",
    "event": "subscriber.form_subscribe",
    "form_id": "3"
  },
  "credential": {
    "apiSecret": "test-secret"
  },
  "answers": [
    {
      "status": 200,
      "body": {
        "rule": {
          "id": 7,
          "event": {
            "name": "form_subscribe",
            "form_id": 3
          },
          "target_url": "https://example.com/hook"
        }
      }
    }
  ],
  "exchanges": [
    {
      "request": {
        "method": "POST",
        "url": "https://api.convertkit.com/v3/automations/hooks?api_secret=test-secret",
        "headers": {
          "content-type": "application/json"
        },
        "body": {
          "target_url": "https://example.com/hook",
          "event": {
            "name": "subscriber.form_subscribe",
            "form_id": 3
          }
        }
      }
    }
  ],
  "output": {
    "id": 7,
    "event": {
      "name": "form_subscribe",
      "form_id": 3
    },
    "target_url": "https://example.com/hook"
  }
