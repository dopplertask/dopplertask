{
  "package": "@activepieces/piece-campaign-monitor",
  "version": "0.2.1",
  "action": "create_custom_field",
  "auth": {
    "type": "SECRET_TEXT",
    "secret_text": "test-key"
  },
  "inputs": {
    "clientId": "client-1",
    "listId": "list-1",
    "fieldName": " Favorite Color ",
    "dataType": "MultiSelectOne",
    "options": [
      "Red",
      " Blue "
    ],
    "visibleInPreferenceCenter": false
  },
  "credential": {
    "apiKey": "test-key"
  },
  "answers": [
    {
      "status": 201,
      "body": "\"[FavoriteColor]\""
    }
  ],
  "exchanges": [
    {
      "request": {
        "method": "POST",
        "url": "https://api.createsend.com/api/v3.3/lists/list-1/customfields.json",
        "headers": {
          "authorization": "Basic dGVzdC1rZXk6eA==",
          "content-type": "application/json"
        },
        "body": {
          "FieldName": "Favorite Color",
          "DataType": "MultiSelectOne",
          "Options": [
            "Red",
            "Blue"
          ],
          "VisibleInPreferenceCenter": false
        }
      }
    }
  ],
  "output": {
    "key": "[FavoriteColor]",
    "fieldName": "Favorite Color",
    "dataType": "MultiSelectOne",
    "listId": "list-1"
  }
}
