{
  "package": "@activepieces/piece-campaign-monitor",
  "version": "0.2.1",
  "action": "create_list",
  "auth": {
    "type": "SECRET_TEXT",
    "secret_text": "test-key"
  },
  "inputs": {
    "clientId": "client-1",
    "title": "Newsletter",
    "unsubscribeSetting": "OnlyThisList",
    "confirmedOptIn": true,
    "unsubscribePage": "https://example.com/bye",
    "confirmationSuccessPage": "https://example.com/thanks"
  },
  "credential": {
    "apiKey": "test-key"
  },
  "answers": [
    {
      "status": 201,
      "body": "\"list-new\""
    }
  ],
  "exchanges": [
    {
      "request": {
        "method": "POST",
        "url": "https://api.createsend.com/api/v3.3/lists/client-1.json",
        "headers": {
          "authorization": "Basic dGVzdC1rZXk6eA==",
          "content-type": "application/json"
        },
        "body": {
          "Title": "Newsletter",
          "UnsubscribePage": "https://example.com/bye",
          "UnsubscribeSetting": "OnlyThisList",
          "ConfirmedOptIn": true,
          "ConfirmationSuccessPage": "https://example.com/thanks"
        }
      }
    }
  ],
  "output": {
    "listId": "list-new",
    "title": "Newsletter"
  }
}
