        },
        "body": {
          "To": [
            "Ada <ada@example.com>"
          ],
          "CC": [
            "cc@example.com"
          ],
          "Data": {
            "firstName": "Ada"
          },
          "AddRecipientsToList": true,
          "ConsentToTrack": "Yes"
        }
      }
    }
