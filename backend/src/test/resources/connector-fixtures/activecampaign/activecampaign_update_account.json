{
  "package": "@activepieces/piece-activecampaign",
  "version": "0.1.9",
  "action": "activecampaign_update_account",
  "auth": {
    "type": "CUSTOM_AUTH",
    "props": {
      "apiUrl": "https://acme.api-us1.com",
      "apiKey": "test-key"
    }
  },
  "inputs": {
    "accountId": "7",
    "name": "Acme Corp",
    "accountUrl": "https://acme.example",
    "accountCustomFields": {
      "1": "Wholesale"
    }
  },
  "credential": {
    "apiUrl": "acme.api-us1.com",
    "apiKey": "test-key"
  },
  "answers": [
    {
      "status": 200,
      "body": {
        "account": {
          "name": "Acme Corp",
          "accountUrl": "https://acme.example",
          "id": "7"
        }
      }
    }
  ],
  "exchanges": [
    {
      "request": {
        "method": "PUT",
        "url": "https://acme.api-us1.com/api/3/accounts/7",
        "headers": {
          "api-token": "test-key",
          "content-type": "application/json"
        },
        "body": {
          "account": {
            "name": "Acme Corp",
            "accountUrl": "https://acme.example",
            "fields": [
              {
                "customFieldId": 1,
                "fieldValue": "Wholesale"
              }
            ]
          }
        }
      }
    }
  ],
  "output": {
    "account": {
      "name": "Acme Corp",
      "accountUrl": "https://acme.example",
      "id": "7"
    }
  }
}
