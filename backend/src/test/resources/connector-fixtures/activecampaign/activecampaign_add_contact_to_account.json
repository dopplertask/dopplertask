{
  "package": "@activepieces/piece-activecampaign",
  "version": "0.1.9",
  "action": "activecampaign_add_contact_to_account",
  "auth": {
    "type": "CUSTOM_AUTH",
    "props": {
      "apiUrl": "https://acme.api-us1.com",
      "apiKey": "test-key"
    }
  },
  "inputs": {
    "contactId": "12",
    "accountId": "7",
    "jobTitle": "CTO"
  },
  "credential": {
    "apiUrl": "acme.api-us1.com",
    "apiKey": "test-key"
  },
  "answers": [
    {
      "status": 200,
      "body": {
        "accountContact": {
          "contact": "12",
          "account": "7",
          "jobTitle": "CTO",
          "id": "3",
          "links": {}
        }
      }
    }
  ],
  "exchanges": [
    {
      "request": {
        "method": "POST",
        "url": "https://acme.api-us1.com/api/3/accountContacts",
        "headers": {
          "api-token": "test-key",
          "content-type": "application/json"
        },
        "body": {
          "accountContact": {
            "contact": 12,
            "account": 7,
            "jobTitle": "CTO"
          }
        }
      }
    }
  ],
  "output": {
    "accountContact": {
      "contact": "12",
      "account": "7",
      "jobTitle": "CTO",
      "id": "3",
      "links": {}
    }
  }
}
