{
  "package": "@activepieces/piece-activecampaign",
  "version": "0.1.9",
  "action": "activecampaign_create_account",
  "auth": {
    "type": "CUSTOM_AUTH",
    "props": {
      "apiUrl": "https://acme.api-us1.com",
      "apiKey": "test-key"
    }
  },
  "inputs": {
    "name": "Acme Inc",
    "accountUrl": "https://acme.example",
    "accountCustomFields": {
      "1": "Retail",
      "2": 42
    }
  },
  "credential": {
    "apiUrl": "acme.api-us1.com",
    "apiKey": "test-key"
  },
  "answers": [
    {
      "status": 200,
      "body": {
        "account": {
          "name": "Acme Inc",
          "accountUrl": "https://acme.example",
          "id": "7",
          "fields": [
            {
              "customFieldId": 1,
              "fieldValue": "Retail",
              "accountId": "7"
            }
          ]
        }
      }
    }
  ],
  "exchanges": [
    {
      "request": {
        "method": "POST",
        "url": "https://acme.api-us1.com/api/3/accounts",
        "headers": {
          "api-token": "test-key",
          "content-type": "application/json"
        },
        "body": {
          "account": {
            "name": "Acme Inc",
            "accountUrl": "https://acme.example",
            "fields": [
              {
                "customFieldId": 1,
                "fieldValue": "Retail"
              },
              {
                "customFieldId": 2,
                "fieldValue": 42
              }
            ]
          }
        }
      }
    }
  ],
  "output": {
    "account": {
      "name": "Acme Inc",
      "accountUrl": "https://acme.example",
      "id": "7",
      "fields": [
        {
          "customFieldId": 1,
          "fieldValue": "Retail",
          "accountId": "7"
        }
      ]
    }
  }
}
