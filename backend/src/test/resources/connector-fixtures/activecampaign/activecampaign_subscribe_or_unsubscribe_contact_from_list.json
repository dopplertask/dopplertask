{
  "package": "@activepieces/piece-activecampaign",
  "version": "0.1.9",
  "action": "activecampaign_subscribe_or_unsubscribe_contact_from_list",
  "auth": {
    "type": "CUSTOM_AUTH",
    "props": {
      "apiUrl": "https://acme.api-us1.com",
      "apiKey": "test-key"
    }
  },
  "inputs": {
    "listId": "2",
    "status": "1",
    "contactId": "12"
  },
  "credential": {
    "apiUrl": "acme.api-us1.com",
    "apiKey": "test-key"
  },
  "answers": [
    {
      "status": 200,
      "body": {
        "contacts": [
          {
            "email": "ada@example.com",
            "id": "12"
          }
        ],
        "contactList": {
          "contact": "12",
          "list": "2",
          "status": 1,
          "id": "30",
          "links": {}
        }
      }
    }
  ],
  "exchanges": [
    {
      "request": {
        "method": "POST",
        "url": "https://acme.api-us1.com/api/3/contactLists",
        "headers": {
          "api-token": "test-key",
          "content-type": "application/json"
        },
        "body": {
          "contactList": {
            "list": "2",
            "contact": "12",
            "status": "1"
          }
        }
      }
    }
  ],
  "output": {
    "contacts": [
      {
        "email": "ada@example.com",
        "id": "12"
      }
    ],
    "contactList": {
      "contact": "12",
      "list": "2",
      "status": 1,
      "id": "30",
      "links": {}
    }
  }
}
