{
  "package": "@activepieces/piece-microsoft-excel-365",
  "version": "0.8.5",
  "action": "get-worksheet-columns",
  "auth": {
    "type": "OAUTH2",
    "access_token": "test-token",
    "data": {},
    "props": {
      "cloud": "login.microsoftonline.com"
    }
  },
  "inputs": {
    "storageSource": "onedrive",
    "siteId": "contoso.sharepoint.com,1111,2222",
    "documentId": "b!lib01",
    "workbookId": "01WBK7XQ",
    "worksheetId": "Sheet1"
  },
  "credential": {
    "oauthAccessToken": "test-token"
  },
  "answers": [
    {
      "status": 200,
      "body": {
        "address": "Sheet1!A1:C1",
        "values": [
          [
            "ID",
            "Name",
            "Email"
          ]
        ]
      }
    }
  ],
  "exchanges": [
    {
      "request": {
        "method": "GET",
        "url": "https://graph.microsoft.com/v1.0/me/drive/items/01WBK7XQ/workbook/worksheets/Sheet1/range(address='A1:ZZ1')/usedRange",
        "headers": {
          "authorization": "Bearer test-token",
          "sdkversion": "graph-js/3.0.7 (featureUsage=7)"
        },
        "body": null
      }
    }
  ],
  "output": [
    "ID",
    "Name",
    "Email"
  ]
}
