{
  "package": "@activepieces/piece-clockodo",
  "version": "0.2.10",
  "action": "list_customers",
  "auth": {
    "type": "CUSTOM_AUTH",
    "props": {
      "email": "jane@example.com",
      "token": "test-key",
      "company_name": "Acme",
      "company_email": "it@example.com"
    }
  },
  "inputs": {
    "active_filter": true,
    "page": 1
  },
  "credential": {
    "email": "jane@example.com",
    "token": "test-key",
    "company_name": "Acme",
    "company_email": "it@example.com"
  },
  "answers": [
    {
      "status": 200,
      "body": {
        "paging": {
          "items_per_page": 50,
          "current_page": 1,
          "count_pages": 1,
          "count_items": 3
        },
        "customers": [
          {
            "id": 7,
            "name": "Globex",
            "active": true
          }
        ]
      }
    }
  ],
  "exchanges": [
    {
      "request": {
        "method": "GET",
        "url": "https://my.clockodo.com/api/v2/customers?page=1&filter%5Bactive%5D=true",
        "headers": {
          "x-clockodo-external-application": "Acme;it@example.com",
          "x-clockodoapikey": "test-key",
          "x-clockodoapiuser": "jane@example.com"
        },
        "body": null
      }
    }
  ],
  "output": {
    "pagination": {
      "items_per_page": 50,
      "current_page": 1,
      "count_pages": 1,
      "count_items": 3
    },
    "customers": [
      {
        "id": 7,
        "name": "Globex",
        "active": true
      }
    ]
  }
}
