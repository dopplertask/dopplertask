        "headers": {
          "x-clockodo-external-application": "Acme;it@example.com",
          "x-clockodoapikey": "test-key",
          "x-clockodoapiuser": "jane@example.com"
        },
        "body": null
      }
    }
  ],
  "output": {
    "absences": [
      {
        "id": 88,
        "users_id": 44,
        "date_since": "2026-07-01",
        "date_until": "2026-07-05",
        "status": 1,
        "type": 1,
        "count_days": 0.5,
        "note": "Summer break",
