{
  "package": "@activepieces/piece-clockodo",
  "version": "0.2.10",
  "action": "list_absences",
  "auth": {
    "type": "CUSTOM_AUTH",
    "props": {
      "email": "jane@example.com",
      "token": "test-key",
      "company_name": "Acme",
      "company_email": "it@example.com"
    }
  },
  "inputs": {
    "year": 2026,
    "user_id": 44
