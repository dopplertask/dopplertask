{
  "package": "@activepieces/piece-clockodo",
  "version": "0.2.10",
  "action": "create_customer",
  "auth": {
    "type": "CUSTOM_AUTH",
    "props": {
      "email": "jane@example.com",
      "token": "test-key",
      "company_name": "Acme",
      "company_email": "it@example.com"
    }
  },
  "inputs": {
    "name": "Acme GmbH",
    "number": "C-100",
    "active": true,
    "billable": true,
    "note": "Key account",
    "color": 15634787
  },
  "credential": {
    "email": "jane@example.com",
    "token": "test-key",
    "company_name": "Acme",
    "company_email": "it@example.com"
  },
  "answers": [
    {
      "status": 200,
      "body": {
        "customer": {
          "id": 11,
          "name": "Acme GmbH",
          "number": "C-100",
          "active": true,
          "billable_default": true,
          "note": "Key account",
          "color": 15634787
        }
      }
    }
  ],
  "exchanges": [
    {
      "request": {
        "method": "POST",
        "url": "https://my.clockodo.com/api/v2/customers",
        "headers": {
          "content-type": "application/json",
          "x-clockodo-external-application": "Acme;it@example.com",
          "x-clockodoapikey": "test-key",
          "x-clockodoapiuser": "jane@example.com"
        },
        "body": {
          "name": "Acme GmbH",
          "number": "C-100",
          "active": true,
          "billable_default": true,
          "note": "Key account",
          "color": 15634787
        }
      }
    }
  ],
  "output": {
    "id": 11,
    "name": "Acme GmbH",
    "number": "C-100",
    "active": true,
    "billable_default": true,
    "note": "Key account",
    "color": 15634787
  }
}
