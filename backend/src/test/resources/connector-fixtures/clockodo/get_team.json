{
  "package": "@activepieces/piece-clockodo",
  "version": "0.2.10",
  "action": "get_team",
  "auth": {
    "type": "CUSTOM_AUTH",
    "props": {
      "email": "jane@example.com",
      "token": "test-key",
      "company_name": "Acme",
      "company_email": "it@example.com"
    }
  },
  "inputs": {
    "team_id": 55
  },
  "credential": {
    "email": "jane@example.com",
    "token": "test-key",
    "company_name": "Acme",
    "company_email": "it@example.com"
  },
  "answers": [
    {
      "status": 200,
      "body": {
        "team": {
          "id": 55,
          "name": "Design",
          "leader": 44
        }
      }
    }
  ],
  "exchanges": [
    {
      "request": {
        "method": "GET",
        "url": "https://my.clockodo.com/api/v2/teams/55",
        "headers": {
          "x-clockodo-external-application": "Acme;it@example.com",
          "x-clockodoapikey": "test-key",
          "x-clockodoapiuser": "jane@example.com"
        },
        "body": null
      }
    }
  ],
  "output": {
    "id": 55,
    "name": "Design",
    "leader": 44
  }
}
