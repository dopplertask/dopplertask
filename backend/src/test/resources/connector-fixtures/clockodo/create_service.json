{
  "package": "@activepieces/piece-clockodo",
  "version": "0.2.10",
  "action": "create_service",
  "auth": {
    "type": "CUSTOM_AUTH",
    "props": {
      "email": "jane@example.com",
      "token": "test-key",
      "company_name": "Acme",
      "company_email": "it@example.com"
    }
  },
  "inputs": {
    "name": "Consulting",
    "number": "S-1",
    "active": true,
    "note": "Standard rate"
  },
  "credential": {
    "email": "jane@example.com",
    "token": "test-key",
    "company_name": "Acme",
    "company_email": "it@example.com"
  },
  "answers": [
    {
      "status": 200,
      "body": {
        "service": {
          "id": 33,
          "name": "Consulting",
          "number": "S-1",
          "active": true,
          "note": "Standard rate"
        }
      }
    }
  ],
  "exchanges": [
    {
      "request": {
        "method": "POST",
        "url": "https://my.clockodo.com/api/v2/services",
        "headers": {
          "content-type": "application/json",
          "x-clockodo-external-application": "Acme;it@example.com",
          "x-clockodoapikey": "test-key",
          "x-clockodoapiuser": "jane@example.com"
        },
        "body": {
          "name": "Consulting",
          "number": "S-1",
          "active": true,
          "note": "Standard rate"
        }
      }
    }
  ],
  "output": {
    "id": 33,
    "name": "Consulting",
    "number": "S-1",
    "active": true,
    "note": "Standard rate"
  }
}
