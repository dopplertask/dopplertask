{
  "package": "@activepieces/piece-clockodo",
  "version": "0.2.10",
  "action": "list_services",
  "auth": {
    "type": "CUSTOM_AUTH",
    "props": {
      "email": "jane@example.com",
      "token": "test-key",
      "company_name": "Acme",
      "company_email": "it@example.com"
    }
  },
  "inputs": {},
  "credential": {
    "email": "jane@example.com",
    "token": "test-key",
    "company_name": "Acme",
    "company_email": "it@example.com"
  },
  "answers": [
    {
      "status": 200,
      "body": {
        "services": [
          {
            "id": 33,
            "name": "Consulting",
            "number": "S-1",
            "active": true,
            "note": "Standard rate"
          }
        ]
      }
    }
  ],
  "exchanges": [
    {
      "request": {
        "method": "GET",
        "url": "https://my.clockodo.com/api/v2/services",
        "headers": {
          "x-clockodo-external-application": "Acme;it@example.com",
          "x-clockodoapikey": "test-key",
          "x-clockodoapiuser": "jane@example.com"
        },
        "body": null
      }
    }
  ],
  "output": {
    "services": [
      {
        "id": 33,
        "name": "Consulting",
        "number": "S-1",
        "active": true,
        "note": "Standard rate"
      }
    ]
  }
}
