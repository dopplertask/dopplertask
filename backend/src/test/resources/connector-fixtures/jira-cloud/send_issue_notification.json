{
  "package": "@activepieces/piece-jira-cloud",
  "version": "0.6.4",
  "action": "send_issue_notification",
  "auth": {
    "type": "CUSTOM_AUTH",
    "props": {
      "instanceUrl": "https://test.atlassian.net",
      "email": "ada@example.com",
      "apiToken": "jira-test-token"
    }
  },
  "inputs": {
    "issueIdOrKey": "PROJ-1",
    "subject": "Heads up",
    "textBody": "Please review",
    "htmlBody": "<p>Please review</p>",
    "notifyReporter": true,
    "notifyAssignee": false,
    "notifyWatchers": true,
    "notifyVoters": false,
    "userAccountIds": [
      "acc-1"
    ],
    "groupIds": [
      "g1"
    ]
  },
  "credential": {
    "instanceUrl": "https://test.atlassian.net",
    "email": "ada@example.com",
    "apiToken": "jira-test-token"
  },
  "answers": [
    {
      "status": 200,
      "body": ""
    }
  ],
  "exchanges": [
    {
      "request": {
        "method": "POST",
        "url": "https://test.atlassian.net/rest/api/3/issue/PROJ-1/notify",
        "headers": {
          "authorization": "Basic YWRhQGV4YW1wbGUuY29tOmppcmEtdGVzdC10b2tlbg==",
          "content-type": "application/json"
        },
        "body": {
          "textBody": "Please review",
          "to": {
            "reporter": true,
            "assignee": false,
            "watchers": true,
            "voters": false,
            "users": [
              {
                "accountId": "acc-1"
              }
            ],
            "groupIds": [
              "g1"
            ]
          },
          "subject": "Heads up",
          "htmlBody": "<p>Please review</p>"
        }
      }
    }
  ],
  "output": {
    "success": true,
    "issue": "PROJ-1",
    "queued": true
  }
}
