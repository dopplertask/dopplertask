{
  "package": "@activepieces/piece-jira-cloud",
  "version": "0.6.4",
  "auth": {
    "type": "CUSTOM_AUTH",
    "props": {
      "instanceUrl": "https://test.atlassian.net",
      "email": "ada@example.com",
      "apiToken": "jira-test-token"
    }
  },
  "trigger": "new_issue_type",
  "inputs": {
    "projectId": "10000"
  },
  "credential": {
    "instanceUrl": "https://test.atlassian.net",
    "email": "ada@example.com",
    "apiToken": "jira-test-token"
  },
  "store": {
    "seen": [],
    "issueTypeIds": "[\"10001\"]"
  },
  "answers": [
    {
      "status": 200,
      "body": [
        {
          "id": "10001",
          "name": "Task",
          "hierarchyLevel": 0
        },
        {
          "id": "10002",
          "name": "Story",
          "description": "A user story",
          "hierarchyLevel": 0
        }
      ]
    }
  ],
  "exchanges": [
    {
      "request": {
        "method": "GET",
        "url": "https://test.atlassian.net/rest/api/3/issuetype/project?projectId=10000",
        "headers": {
          "authorization": "Basic YWRhQGV4YW1wbGUuY29tOmppcmEtdGVzdC10b2tlbg=="
        },
        "body": null
      }
    }
  ],
  "output": [
    {
      "id": "10002",
      "name": "Story",
      "description": "A user story",
      "hierarchyLevel": 0
    }
  ],
  "storeAfter": {
    "seen": [],
    "issueTypeIds": "[\"10002\",\"10001\"]"
  }
}
