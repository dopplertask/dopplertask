{
  "package": "@activepieces/piece-jira-cloud",
  "version": "0.6.4",
  "action": "create_issue_link",
  "auth": {
    "type": "CUSTOM_AUTH",
    "props": {
      "instanceUrl": "https://test.atlassian.net",
      "email": "ada@example.com",
      "apiToken": "jira-test-token"
    }
  },
  "inputs": {
    "linkTypeName": " Blocks ",
    "outwardIssueKey": "PROJ-1",
    "inwardIssueKey": "PROJ-2",
    "comment": "Linked **because**"
  },
  "credential": {
    "instanceUrl": "https://test.atlassian.net",
    "email": "ada@example.com",
    "apiToken": "jira-test-token"
  },
  "answers": [
    {
      "status": 201,
      "body": ""
    }
  ],
  "exchanges": [
    {
      "request": {
        "method": "POST",
        "url": "https://test.atlassian.net/rest/api/3/issueLink",
        "headers": {
          "authorization": "Basic YWRhQGV4YW1wbGUuY29tOmppcmEtdGVzdC10b2tlbg==",
          "content-type": "application/json"
        },
        "body": {
          "type": {
            "name": "Blocks"
          },
          "outwardIssue": {
            "key": "PROJ-1"
          },
          "inwardIssue": {
            "key": "PROJ-2"
          },
          "comment": {
            "body": {
              "version": 1,
              "type": "doc",
              "content": [
                {
                  "type": "paragraph",
                  "content": [
                    {
                      "type": "text",
                      "text": "Linked "
                    },
                    {
                      "type": "text",
                      "text": "because",
                      "marks": [
                        {
                          "type": "strong"
                        }
                      ]
                    }
                  ]
                }
              ]
            }
          }
        }
      }
    }
  ],
  "output": {
    "success": true,
    "link_type": "Blocks",
    "outward_issue": "PROJ-1",
    "inward_issue": "PROJ-2"
  }
}
