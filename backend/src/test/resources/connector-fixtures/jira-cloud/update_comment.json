{
  "package": "@activepieces/piece-jira-cloud",
  "version": "0.6.4",
  "action": "update_comment",
  "auth": {
    "type": "CUSTOM_AUTH",
    "props": {
      "instanceUrl": "https://test.atlassian.net",
      "email": "ada@example.com",
      "apiToken": "jira-test-token"
    }
  },
  "inputs": {
    "issueId": "PROJ-1",
    "commentId": "100",
    "comment": "Edited with `code`",
    "notifyUsers": false
  },
  "settings": {
    "issueIdOrKey": "PROJ-1",
    "commentId": "100",
    "comment": "Edited with `code`",
    "notifyUsers": false
  },
  "credential": {
    "instanceUrl": "https://test.atlassian.net",
    "email": "ada@example.com",
    "apiToken": "jira-test-token"
  },
  "answers": [
    {
      "status": 200,
      "body": {
        "id": "100"
      }
    }
  ],
  "exchanges": [
    {
      "request": {
        "method": "PUT",
        "url": "https://test.atlassian.net/rest/api/3/issue/PROJ-1/comment/100?notifyUsers=false",
        "headers": {
          "authorization": "Basic YWRhQGV4YW1wbGUuY29tOmppcmEtdGVzdC10b2tlbg==",
          "content-type": "application/json"
        },
        "body": {
          "body": {
            "version": 1,
            "type": "doc",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Edited with "
                  },
                  {
                    "type": "text",
                    "text": "code",
                    "marks": [
                      {
                        "type": "code"
                      }
                    ]
                  }
                ]
              }
            ]
          }
        }
      }
    }
  ],
  "output": {
    "id": "100"
  }
}
