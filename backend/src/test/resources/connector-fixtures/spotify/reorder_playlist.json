{
  "package": "@activepieces/piece-spotify",
  "version": "0.6.3",
  "action": "reorder_playlist",
  "auth": {
    "access_token": "test-token",
    "data": {}
  },
  "inputs": {
    "playlist_id": "p1",
    "from_position": 3,
    "to_position": 0,
    "amount": 2
  },
  "credential": {
    "oauthAccessToken": "test-token"
  },
  "answers": [
    {
      "status": 200,
      "body": {
        "snapshot_id": "s3"
      }
    }
  ],
  "exchanges": [
    {
      "request": {
        "method": "PUT",
        "url": "https://api.spotify.com/v1/playlists/p1/items",
        "headers": {
          "authorization": "Bearer test-token",
          "content-type": "application/json"
        },
        "body": {
          "range_start": 3,
          "range_length": 2,
          "insert_before": 0
        }
      }
    }
  ]
}
