{
  "package": "@activepieces/piece-spotify",
  "version": "0.6.3",
  "action": "create_playlist",
  "auth": {
    "access_token": "test-token",
    "data": {}
  },
  "inputs": {
    "name": "Road trip",
    "description": "Summer songs",
    "public": false,
    "collaborative": true
  },
  "credential": {
    "oauthAccessToken": "test-token"
  },
  "answers": [
    {
      "status": 200,
      "body": {
        "id": "u1",
        "display_name": "Ada"
      }
    },
    {
      "status": 201,
      "body": {
        "id": "p9",
        "name": "Road trip"
      }
    }
  ],
  "exchanges": [
    {
      "request": {
        "method": "GET",
        "url": "https://api.spotify.com/v1/me",
        "headers": {
          "authorization": "Bearer test-token"
        },
        "body": null
      }
    },
    {
      "request": {
        "method": "POST",
        "url": "https://api.spotify.com/v1/users/u1/playlists",
        "headers": {
          "authorization": "Bearer test-token",
          "content-type": "application/json"
        },
        "body": {
          "name": "Road trip",
          "description": "Summer songs",
          "public": false,
          "collaborative": true
        }
      }
    }
  ],
  "output": {
    "id": "p9",
    "name": "Road trip"
  }
}
