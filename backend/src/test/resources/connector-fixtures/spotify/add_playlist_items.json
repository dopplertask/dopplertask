{
  "package": "@activepieces/piece-spotify",
  "version": "0.6.3",
  "action": "add_playlist_items",
  "auth": {
    "access_token": "test-token",
    "data": {}
  },
  "inputs": {
    "playlist_id": "p1",
    "items": [
      "spotify:track:t1",
      "spotify:episode:e1"
    ],
    "position": 2
  },
  "credential": {
    "oauthAccessToken": "test-token"
  },
  "answers": [
    {
      "status": 201,
      "body": {
        "snapshot_id": "s1"
      }
    }
  ],
  "exchanges": [
    {
      "request": {
        "method": "POST",
        "url": "https://api.spotify.com/v1/playlists/p1/items",
        "headers": {
          "authorization": "Bearer test-token",
          "content-type": "application/json"
        },
        "body": {
          "uris": [
            "spotify:track:t1",
            "spotify:episode:e1"
          ],
          "position": 2
        }
      }
    }
  ]
}
