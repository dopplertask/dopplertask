{
  "package": "@activepieces/piece-spotify",
  "version": "0.6.3",
  "action": "remove_playlist_items",
  "auth": {
    "access_token": "test-token",
    "data": {}
  },
  "inputs": {
    "playlist_id": "p1",
    "items": [
      "spotify:track:t1",
      "spotify:episode:e1"
    ]
  },
  "credential": {
    "oauthAccessToken": "test-token"
  },
  "answers": [
    {
      "status": 200,
      "body": {
        "snapshot_id": "s2"
      }
    }
  ],
  "exchanges": [
    {
      "request": {
        "method": "DELETE",
        "url": "https://api.spotify.com/v1/playlists/p1/items",
        "headers": {
          "authorization": "Bearer test-token",
          "content-type": "application/json"
        },
        "body": {
          "items": [
            {
              "uri": "spotify:track:t1"
            },
            {
              "uri": "spotify:episode:e1"
            }
          ]
        }
      }
    }
  ]
}
