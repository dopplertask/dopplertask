{
  "package": "@activepieces/piece-resend",
  "version": "0.6.2",
  "action": "update_contact",
  "auth": {
    "type": "SECRET_TEXT",
    "secret_text": "re_test_key"
  },
  "inputs": {
    "audience_id": "aud-1",
    "contact_id": "con-1",
    "first_name": "Ana",
    "last_name": "Berg",
    "unsubscribed": true
  },
  "credential": {
    "apiKey": "re_test_key"
  },
  "answers": [
    {
      "status": 200,
      "body": {
        "object": "contact",
        "id": "con-1"
      }
    }
  ],
  "exchanges": [
    {
      "request": {
        "method": "PATCH",
        "url": "https://api.resend.com/audiences/aud-1/contacts/con-1",
        "headers": {
          "authorization": "Bearer re_test_key",
          "content-type": "application/json"
        },
        "body": {
          "first_name": "Ana",
          "last_name": "Berg",
          "unsubscribed": true
        }
      }
    }
  ],
  "output": {
    "object": "contact",
    "id": "con-1"
  }
}
