{
  "package": "@activepieces/piece-resend",
  "version": "0.6.2",
  "action": "remove_contact_from_segment",
  "auth": {
    "type": "SECRET_TEXT",
    "secret_text": "re_test_key"
  },
  "inputs": {
    "contact_identifier": "ada@example.com",
    "segment_id": "seg-1"
  },
  "credential": {
    "apiKey": "re_test_key"
  },
  "answers": [
    {
      "status": 200,
      "body": {
        "id": "seg-1",
        "deleted": true
      }
    }
  ],
  "exchanges": [
    {
      "request": {
        "method": "DELETE",
        "url": "https://api.resend.com/contacts/ada%40example.com/segments/seg-1",
        "headers": {
          "authorization": "Bearer re_test_key"
        },
        "body": null
      }
    }
  ],
  "output": {
    "id": "seg-1",
    "deleted": true
  }
}
