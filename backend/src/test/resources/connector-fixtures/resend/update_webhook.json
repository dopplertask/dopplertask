{
  "package": "@activepieces/piece-resend",
  "version": "0.6.2",
  "action": "update_webhook",
  "auth": {
    "type": "SECRET_TEXT",
    "secret_text": "re_test_key"
  },
  "inputs": {
    "webhook_id": "wh-1",
    "endpoint": "https://hooks.acme.test/new",
    "events": [
      "email.sent",
      "email.bounced"
    ],
    "status": "disabled"
  },
  "credential": {
    "apiKey": "re_test_key"
  },
  "answers": [
    {
      "status": 200,
      "body": {
        "object": "webhook",
        "id": "wh-1"
      }
    }
  ],
  "exchanges": [
    {
      "request": {
        "method": "PATCH",
        "url": "https://api.resend.com/webhooks/wh-1",
        "headers": {
          "authorization": "Bearer re_test_key",
          "content-type": "application/json"
        },
        "body": {
          "endpoint": "https://hooks.acme.test/new",
          "events": [
            "email.sent",
            "email.bounced"
          ],
          "status": "disabled"
        }
      }
    }
  ],
  "output": {
    "object": "webhook",
    "id": "wh-1"
  }
}
