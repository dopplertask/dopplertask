{
  "package": "@activepieces/piece-resend",
  "version": "0.6.2",
  "action": "get_contact",
  "auth": {
    "type": "SECRET_TEXT",
    "secret_text": "re_test_key"
  },
  "inputs": {
    "contact_identifier": "ada@example.com"
  },
  "credential": {
    "apiKey": "re_test_key"
  },
  "answers": [
    {
      "status": 200,
      "body": {
        "object": "contact",
        "id": "c-1",
        "email": "ada@example.com"
      }
    }
  ],
  "exchanges": [
    {
      "request": {
        "method": "GET",
        "url": "https://api.resend.com/contacts/ada%40example.com",
        "headers": {
          "authorization": "Bearer re_test_key"
        },
        "body": null
      }
    }
  ],
  "output": {
    "object": "contact",
    "id": "c-1",
    "email": "ada@example.com"
  }
}
