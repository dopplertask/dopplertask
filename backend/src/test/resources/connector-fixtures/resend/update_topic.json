{
  "package": "@activepieces/piece-resend",
  "version": "0.6.2",
  "action": "update_topic",
  "auth": {
    "type": "SECRET_TEXT",
    "secret_text": "re_test_key"
  },
  "inputs": {
    "topic_id": "top-1",
    "name": "Updates",
    "description": "All news",
    "visibility": "private"
  },
  "credential": {
    "apiKey": "re_test_key"
  },
  "answers": [
    {
      "status": 200,
      "body": {
        "id": "top-1"
      }
    }
  ],
  "exchanges": [
    {
      "request": {
        "method": "PATCH",
        "url": "https://api.resend.com/topics/top-1",
        "headers": {
          "authorization": "Bearer re_test_key",
          "content-type": "application/json"
        },
        "body": {
          "name": "Updates",
          "description": "All news",
          "visibility": "private"
        }
      }
    }
  ],
  "output": {
    "id": "top-1"
  }
}
