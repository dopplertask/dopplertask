{
  "package": "@activepieces/piece-resend",
  "version": "0.6.2",
  "action": "create_webhook",
  "auth": {
    "type": "SECRET_TEXT",
    "secret_text": "re_test_key"
  },
  "inputs": {
    "endpoint": "https://hooks.example.com/resend",
    "events": [
      "email.sent",
      "email.bounced"
    ]
  },
  "settings": {
    "endpoint": "https://hooks.example.com/resend",
    "events": "[\"email.sent\",\"email.bounced\"]"
  },
  "credential": {
    "apiKey": "re_test_key"
  },
  "answers": [
    {
      "status": 200,
      "body": {
        "object": "webhook",
        "id": "wh-1",
        "signing_secret": "whsec_fake"
      }
    }
  ],
  "exchanges": [
    {
      "request": {
        "method": "POST",
        "url": "https://api.resend.com/webhooks",
        "headers": {
          "authorization": "Bearer re_test_key",
          "content-type": "application/json"
        },
        "body": {
          "endpoint": "https://hooks.example.com/resend",
          "events": [
            "email.sent",
            "email.bounced"
          ]
        }
      }
    }
  ],
  "output": {
    "object": "webhook",
    "id": "wh-1",
    "signing_secret": "whsec_fake"
  }
}
