{
  "package": "@activepieces/piece-resend",
  "version": "0.6.2",
  "action": "create_domain",
  "auth": {
    "type": "SECRET_TEXT",
    "secret_text": "re_test_key"
  },
  "inputs": {
    "name": "mail.acme.test",
    "region": "eu-west-1"
  },
  "credential": {
    "apiKey": "re_test_key"
  },
  "answers": [
    {
      "status": 200,
      "body": {
        "id": "dom-1",
        "name": "mail.acme.test",
        "status": "not_started",
        "region": "eu-west-1",
        "created_at": "2026-01-01T10:00:00Z",
        "capabilities": {
          "sending": "enabled",
          "receiving": "disabled"
        },
        "records": [
          {
            "record": "SPF",
            "name": "send",
            "type": "MX",
            "value": "feedback-smtp.eu-west-1.amazonses.com",
            "status": "not_started",
            "ttl": "Auto"
          }
        ]
      }
    }
  ],
  "exchanges": [
    {
      "request": {
        "method": "POST",
        "url": "https://api.resend.com/domains",
        "headers": {
          "authorization": "Bearer re_test_key",
          "content-type": "application/json"
        },
        "body": {
          "name": "mail.acme.test",
          "region": "eu-west-1"
        }
      }
    }
  ],
  "output": {
    "id": "dom-1",
    "name": "mail.acme.test",
    "status": "not_started",
    "region": "eu-west-1",
    "created_at": "2026-01-01T10:00:00Z",
    "sending": "enabled",
    "receiving": "disabled",
    "dns_records": [
      {
        "record": "SPF",
        "name": "send",
        "type": "MX",
        "value": "feedback-smtp.eu-west-1.amazonses.com",
        "status": "not_started",
        "ttl": "Auto"
      }
    ]
  }
}
