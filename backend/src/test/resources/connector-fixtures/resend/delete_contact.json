{
  "package": "@activepieces/piece-resend",
  "version": "0.6.2",
  "action": "delete_contact",
  "auth": {
    "type": "SECRET_TEXT",
    "secret_text": "re_test_key"
  },
  "inputs": {
    "audience_id": "aud-1",
    "contact_id": "c-1"
  },
  "credential": {
    "apiKey": "re_test_key"
  },
  "answers": [
    {
      "status": 200,
      "body": {
        "object": "contact",
        "id": "c-1",
        "deleted": true
      }
    }
  ],
  "exchanges": [
    {
      "request": {
        "method": "DELETE",
        "url": "https://api.resend.com/audiences/aud-1/contacts/c-1",
        "headers": {
          "authorization": "Bearer re_test_key"
        },
        "body": null
      }
    }
  ],
  "output": {
    "object": "contact",
    "id": "c-1",
    "deleted": true
  }
}
