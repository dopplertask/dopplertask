{
  "package": "@activepieces/piece-resend",
  "version": "0.6.2",
  "action": "create_segment",
  "auth": {
    "type": "SECRET_TEXT",
    "secret_text": "re_test_key"
  },
  "inputs": {
    "name": "VIP"
  },
  "credential": {
    "apiKey": "re_test_key"
  },
  "answers": [
    {
      "status": 200,
      "body": {
        "object": "segment",
        "id": "seg-1",
        "name": "VIP"
      }
    }
  ],
  "exchanges": [
    {
      "request": {
        "method": "POST",
        "url": "https://api.resend.com/segments",
        "headers": {
          "authorization": "Bearer re_test_key",
          "content-type": "application/json"
        },
        "body": {
          "name": "VIP"
        }
      }
    }
  ],
  "output": {
    "object": "segment",
    "id": "seg-1",
    "name": "VIP"
  }
}
