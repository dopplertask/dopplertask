{
  "package": "@activepieces/piece-resend",
  "version": "0.6.2",
  "action": "send_batch_emails",
  "auth": {
    "type": "SECRET_TEXT",
    "secret_text": "re_test_key"
  },
  "inputs": {
    "emails": [
      {
        "from": "Acme <news@acme.test>",
        "to": "ana@example.com",
        "subject": "One",
        "content_type": "html",
        "content": "<p>One</p>",
        "reply_to": "help@acme.test",
        "cc": "cc@acme.test",
        "bcc": "audit@acme.test"
      },
      {
        "from": "news@acme.test",
        "to": "bo@example.com",
        "subject": "Two",
        "content_type": "text",
        "content": "Two",
        "reply_to": "help@acme.test",
        "cc": "cc2@acme.test",
        "bcc": "audit2@acme.test"
      }
    ],
    "idempotency_key": "batch-1"
  },
  "credential": {
    "apiKey": "re_test_key"
  },
  "answers": [
    {
      "status": 200,
      "body": {
        "data": [
          {
            "id": "em-1"
          },
          {
            "id": "em-2"
          }
        ]
      }
    }
  ],
  "exchanges": [
    {
      "request": {
        "method": "POST",
        "url": "https://api.resend.com/emails/batch",
        "headers": {
          "authorization": "Bearer re_test_key",
          "content-type": "application/json",
          "idempotency-key": "batch-1"
        },
        "body": [
          {
            "from": "Acme <news@acme.test>",
            "to": "ana@example.com",
            "subject": "One",
            "html": "<p>One</p>",
            "reply_to": "help@acme.test",
            "cc": "cc@acme.test",
            "bcc": "audit@acme.test"
          },
          {
            "from": "news@acme.test",
            "to": "bo@example.com",
            "subject": "Two",
            "text": "Two",
            "reply_to": "help@acme.test",
            "cc": "cc2@acme.test",
            "bcc": "audit2@acme.test"
          }
        ]
      }
    }
  ],
  "output": [
    {
      "id": "em-1"
    },
    {
      "id": "em-2"
    }
  ]
}
