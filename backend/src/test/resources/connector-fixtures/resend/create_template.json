{
  "package": "@activepieces/piece-resend",
  "version": "0.6.2",
  "action": "create_template",
  "auth": {
    "type": "SECRET_TEXT",
    "secret_text": "re_test_key"
  },
  "inputs": {
    "name": "Welcome",
    "html": "<p>Hi {{{NAME}}}</p>",
    "alias": "welcome",
    "from": "Acme <hi@example.com>",
    "subject": "Welcome aboard",
    "reply_to": "help@example.com",
    "text": "Hi there"
  },
  "credential": {
    "apiKey": "re_test_key"
  },
  "answers": [
    {
      "status": 200,
      "body": {
        "id": "tpl-1",
        "object": "template"
      }
    }
  ],
  "exchanges": [
    {
      "request": {
        "method": "POST",
        "url": "https://api.resend.com/templates",
        "headers": {
          "authorization": "Bearer re_test_key",
          "content-type": "application/json"
        },
        "body": {
          "name": "Welcome",
          "html": "<p>Hi {{{NAME}}}</p>",
          "alias": "welcome",
          "from": "Acme <hi@example.com>",
          "subject": "Welcome aboard",
          "reply_to": "help@example.com",
          "text": "Hi there"
        }
      }
    }
  ],
  "output": {
    "id": "tpl-1",
    "object": "template"
  }
}
