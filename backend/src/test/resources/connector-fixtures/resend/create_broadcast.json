{
  "package": "@activepieces/piece-resend",
  "version": "0.6.2",
  "action": "create_broadcast",
  "auth": {
    "type": "SECRET_TEXT",
    "secret_text": "re_test_key"
  },
  "inputs": {
    "audience_id": "aud-1",
    "from": "Acme <news@acme.test>",
    "subject": "We launched",
    "name": "Launch",
    "reply_to": "help@acme.test",
    "preview_text": "Big news",
    "content_type": "text",
    "content": "Hello all"
  },
  "credential": {
    "apiKey": "re_test_key"
  },
  "answers": [
    {
      "status": 200,
      "body": {
        "id": "bc-1"
      }
    }
  ],
  "exchanges": [
    {
      "request": {
        "method": "POST",
        "url": "https://api.resend.com/broadcasts",
        "headers": {
          "authorization": "Bearer re_test_key",
          "content-type": "application/json"
        },
        "body": {
          "audience_id": "aud-1",
          "from": "Acme <news@acme.test>",
          "subject": "We launched",
          "text": "Hello all",
          "name": "Launch",
          "reply_to": "help@acme.test",
          "preview_text": "Big news"
        }
      }
    }
  ],
  "output": {
    "id": "bc-1"
  }
}
