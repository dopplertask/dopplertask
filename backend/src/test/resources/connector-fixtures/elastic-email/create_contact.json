        "headers": {
          "content-type": "application/json",
          "x-elasticemail-apikey": "credential000z"
        },
        "body": [
          {
            "Email": "sample000z",
            "FirstName": "sample002z",
            "LastName": "sample003z"
          }
        ]
      }
    }
  ],
