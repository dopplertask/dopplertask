{
  "package": "@activepieces/piece-google-docs",
  "version": "0.6.5",
  "action": "create_paragraph_bullets",
  "auth": {
    "access_token": "test-token",
    "data": {}
  },
  "inputs": {
    "documentId": "doc-1",
    "startIndex": 1,
    "endIndex": 5
  },
  "credential": {
    "oauthAccessToken": "test-token"
  },
  "answers": [
    {
      "status": 200,
      "body": {
        "documentId": "doc-1",
        "replies": [
          {}
        ],
        "writeControl": {
          "requiredRevisionId": "rev-2"
        }
      }
    }
  ],
  "exchanges": [
    {
      "request": {
        "method": "POST",
        "url": "https://docs.googleapis.com/v1/documents/doc-1:batchUpdate",
        "headers": {
          "authorization": "Bearer test-token",
          "content-type": "application/json",
          "x-goog-api-client": "gdcl/8.0.2 gl-node/26.4.0"
        },
        "body": {
          "requests": [
            {
              "createParagraphBullets": {
                "range": {
                  "startIndex": 1,
                  "endIndex": 5
                },
                "bulletPreset": "BULLET_DISC_CIRCLE_SQUARE"
              }
            }
          ]
        }
      }
    }
  ],
  "output": {
    "success": true,
    "documentId": "doc-1",
    "startIndex": 1,
    "endIndex": 5,
    "bulletPreset": "BULLET_DISC_CIRCLE_SQUARE"
  }
}
