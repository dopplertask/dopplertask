{
  "package": "@activepieces/piece-google-docs",
  "version": "0.6.5",
  "action": "copy_document",
  "auth": {
    "access_token": "test-token",
    "data": {}
  },
  "inputs": {
    "fileId": "doc-1",
    "title": "Copy of notes",
    "parents": "folder-1"
  },
  "credential": {
    "oauthAccessToken": "test-token"
  },
  "answers": [
    {
      "status": 200,
      "body": {
        "id": "doc-2",
        "name": "Copy of notes",
        "webViewLink": "https://docs.google.com/document/d/doc-2/edit",
        "parents": [
          "folder-1"
        ]
      }
    }
  ],
  "exchanges": [
    {
      "request": {
        "method": "POST",
        "url": "https://www.googleapis.com/drive/v3/files/doc-1/copy?supportsAllDrives=true&fields=id%2C%20name%2C%20webViewLink%2C%20parents",
        "headers": {
          "authorization": "Bearer test-token",
          "content-type": "application/json",
          "x-goog-api-client": "gdcl/8.0.2 gl-node/26.4.0"
        },
        "body": {
          "name": "Copy of notes",
          "parents": [
            "folder-1"
          ]
        }
      }
    }
  ],
  "output": {
    "id": "doc-2",
    "name": "Copy of notes",
    "webViewLink": "https://docs.google.com/document/d/doc-2/edit",
    "parents": [
      "folder-1"
    ]
  }
}
