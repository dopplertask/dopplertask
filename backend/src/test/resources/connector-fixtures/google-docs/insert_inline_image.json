{
  "package": "@activepieces/piece-google-docs",
  "version": "0.6.5",
  "action": "insert_inline_image",
  "auth": {
    "access_token": "test-token",
    "data": {}
  },
  "inputs": {
    "documentId": "doc-1",
    "uri": "https://example.com/logo.png",
    "index": 3,
    "widthPt": 100,
    "heightPt": 50
  },
  "credential": {
    "oauthAccessToken": "test-token"
  },
  "answers": [
    {
      "status": 200,
      "body": {
        "documentId": "doc-1",
        "replies": [
          {
            "insertInlineImage": {
              "objectId": "kix.img3"
            }
          }
        ],
        "writeControl": {
          "requiredRevisionId": "rev-2"
        }
      }
    }
  ],
  "exchanges": [
    {
      "request": {
        "method": "POST",
        "url": "https://docs.googleapis.com/v1/documents/doc-1:batchUpdate",
        "headers": {
          "authorization": "Bearer test-token",
          "content-type": "application/json",
          "x-goog-api-client": "gdcl/8.0.2 gl-node/26.4.0"
        },
        "body": {
          "requests": [
            {
              "insertInlineImage": {
                "uri": "https://example.com/logo.png",
                "location": {
                  "index": 3
                },
                "objectSize": {
                  "width": {
                    "magnitude": 100,
                    "unit": "PT"
                  },
                  "height": {
                    "magnitude": 50,
                    "unit": "PT"
                  }
                }
              }
            }
          ]
        }
      }
    }
  ],
  "output": {
    "success": true,
    "documentId": "doc-1",
    "insertedObjectId": "kix.img3",
    "mode": "insert_at_index"
  }
}
