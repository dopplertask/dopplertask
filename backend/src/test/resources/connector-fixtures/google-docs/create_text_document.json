{
  "package": "@activepieces/piece-google-docs",
  "version": "0.6.5",
  "action": "create_text_document",
  "auth": {
    "access_token": "test-token",
    "data": {}
  },
  "inputs": {
    "title": "Plain notes",
    "body": "Some plain text"
  },
  "credential": {
    "oauthAccessToken": "test-token"
  },
  "answers": [
    {
      "status": 200,
      "body": {
        "documentId": "doc-1",
        "title": "Plain notes"
      }
    },
    {
      "status": 200,
      "body": {
        "documentId": "doc-1",
        "replies": [
          {}
        ],
        "writeControl": {
          "requiredRevisionId": "rev-2"
        }
      }
    }
  ],
  "exchanges": [
    {
      "request": {
        "method": "POST",
        "url": "https://docs.googleapis.com/v1/documents",
        "headers": {
          "authorization": "Bearer test-token",
          "content-type": "application/json"
        },
        "body": {
          "title": "Plain notes"
        }
      }
    },
    {
      "request": {
        "method": "POST",
        "url": "https://docs.googleapis.com/v1/documents/doc-1:batchUpdate",
        "headers": {
          "authorization": "Bearer test-token",
          "content-type": "application/json"
        },
        "body": {
          "requests": [
            {
              "insertText": {
                "text": "Some plain text",
                "endOfSegmentLocation": {}
              }
            }
          ]
        }
      }
    }
  ],
  "output": {
    "documentId": "doc-1",
    "replies": [
      {}
    ],
    "writeControl": {
      "requiredRevisionId": "rev-2"
    }
  }
}
