{
  "package": "@activepieces/piece-google-docs",
  "version": "0.6.5",
  "action": "create_document_based_on_template",
  "auth": {
    "access_token": "test-token",
    "data": {}
  },
  "inputs": {
    "template": "doc-1",
    "placeholder_format": "curly_braces",
    "values": {
      "name": "Ada",
      "city": "Paris"
    },
    "images": [
      {
        "imageObjectId": "kix.img1",
        "url": "https://example.com/logo.png"
      }
    ]
  },
  "credential": {
    "oauthAccessToken": "test-token"
  },
