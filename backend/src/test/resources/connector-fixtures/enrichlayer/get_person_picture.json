{
  "package": "@activepieces/piece-enrichlayer",
  "version": "0.1.3",
  "action": "get_person_picture",
  "auth": {
    "type": "SECRET_TEXT",
    "secret_text": "test-key"
  },
  "inputs": {
    "person_profile_url": "https://www.linkedin.com/in/janedoe/"
  },
  "credential": {
    "apiKey": "test-key"
  },
  "answers": [
    {
      "status": 200,
      "body": {
        "tmp_profile_pic_url": "https://cdn.example.test/jane.png"
      }
    }
  ],
  "exchanges": [
    {
      "request": {
        "method": "GET",
        "url": "https://enrichlayer.com/api/v2/person/profile-picture?person_profile_url=https%3A%2F%2Fwww.linkedin.com%2Fin%2Fjanedoe%2F",
        "headers": {
          "authorization": "Bearer test-key"
        },
        "body": null
      }
    }
  ],
  "output": {
    "tmp_profile_pic_url": "https://cdn.example.test/jane.png"
  }
}
