{
  "package": "@activepieces/piece-enrichlayer",
  "version": "0.1.3",
  "action": "get_person_lookup",
  "auth": {
    "type": "SECRET_TEXT",
    "secret_text": "test-key"
  },
  "inputs": {
    "first_name": "Jane",
    "company_domain": "acme.test",
    "last_name": "Doe",
    "title": "Acme-title",
    "location": "Acme-location",
    "enrich_profile": "enrich",
    "similarity_checks": "skip"
  },
  "credential": {
    "apiKey": "test-key"
  },
  "answers": [
    {
      "status": 200,
      "body": {
        "url": "https://www.linkedin.com/in/janedoe/",
        "name": "Jane Doe",
        "company": "Acme",
        "last_updated": "2024-05-01T10:00:00Z"
      }
    }
  ],
  "exchanges": [
    {
      "request": {
        "method": "GET",
        "url": "https://enrichlayer.com/api/v2/profile/resolve?first_name=Jane&company_domain=acme.test&last_name=Doe&title=Acme-title&location=Acme-location&enrich_profile=enrich&similarity_checks=skip",
        "headers": {
          "authorization": "Bearer test-key"
        },
        "body": null
      }
    }
  ],
  "output": {
    "url": "https://www.linkedin.com/in/janedoe/",
    "name": "Jane Doe",
    "company": "Acme",
    "last_updated": "2024-05-01T10:00:00Z"
  }
}
