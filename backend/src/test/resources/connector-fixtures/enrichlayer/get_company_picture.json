{
  "package": "@activepieces/piece-enrichlayer",
  "version": "0.1.3",
  "action": "get_company_picture",
  "auth": {
    "type": "SECRET_TEXT",
    "secret_text": "test-key"
  },
  "inputs": {
    "company_profile_url": "https://www.linkedin.com/company/acme/"
  },
  "settings": {
    "company_url": "https://www.linkedin.com/company/acme/"
  },
  "credential": {
    "apiKey": "test-key"
  },
  "answers": [
    {
      "status": 200,
      "body": {
        "tmp_profile_pic_url": "https://cdn.example.test/acme.png"
