{
  "package": "@activepieces/piece-enrichlayer",
  "version": "0.1.3",
  "action": "get_employee_count",
  "auth": {
    "type": "SECRET_TEXT",
    "secret_text": "test-key"
  },
  "inputs": {
    "url": "https://www.linkedin.com/in/janedoe/",
    "employment_status": "all",
    "coy_name_match": "exclude",
    "estimated_employee_count": "include",
    "at_date": "2024-01-01",
    "use_cache": "if-recent"
  },
  "credential": {
    "apiKey": "test-key"
  },
  "answers": [
    {
      "status": 200,
      "body": {
        "total_employee": 1200,
        "linkedin_employee_count": 1150,
        "linkdb_employee_count": 980
      }
    }
  ],
  "exchanges": [
    {
      "request": {
        "method": "GET",
        "url": "https://enrichlayer.com/api/v2/company/employees/count?url=https%3A%2F%2Fwww.linkedin.com%2Fin%2Fjanedoe%2F&employment_status=all&coy_name_match=exclude&estimated_employee_count=include&at_date=2024-01-01&use_cache=if-recent",
        "headers": {
          "authorization": "Bearer test-key"
        },
        "body": null
      }
    }
  ],
  "output": {
    "total_employee": 1200,
    "linkedin_employee_count": 1150,
    "linkdb_employee_count": 980
  }
}
