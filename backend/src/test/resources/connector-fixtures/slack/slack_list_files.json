{
  "package": "@activepieces/piece-slack",
  "version": "0.23.1",
  "action": "slack_list_files",
  "auth": {
    "type": "OAUTH2",
    "access_token": "test-token",
    "data": {
      "team_id": "T0TEAM",
      "authed_user": {
        "id": "U0ME",
        "access_token": "test-user-token"
      }
    }
  },
  "inputs": {
    "channel": "C0CHAN",
    "user": "U0ADA",
    "types": "images,pdfs",
    "ts_from": "1700000000",
    "ts_to": "1800000000",
    "limit": 20
  },
  "credential": {
    "oauthAccessToken": "test-token"
  },
  "answers": [
    {
      "status": 200,
      "body": {
        "ok": true,
        "files": [
          {
            "id": "F0FILE",
            "name": "plan.pdf"
          }
        ],
        "paging": {
          "count": 20,
          "total": 1,
          "page": 1,
          "pages": 1
        }
      }
    }
  ],
  "exchanges": [
    {
      "request": {
        "method": "POST",
        "url": "https://slack.com/api/files.list",
        "headers": {
          "authorization": "Bearer test-token",
          "content-type": "application/x-www-form-urlencoded"
        },
        "body": "channel=C0CHAN&user=U0ADA&types=images%2Cpdfs&ts_from=1700000000&ts_to=1800000000&count=20"
      }
    }
  ],
  "output": {
    "files": [
      {
        "id": "F0FILE",
        "name": "plan.pdf"
      }
    ],
    "count": 1,
    "paging": {
      "count": 20,
      "total": 1,
      "page": 1,
      "pages": 1
    }
  }
}
