{
  "package": "@activepieces/piece-slack",
  "version": "0.23.1",
  "action": "list_user_groups",
  "auth": {
    "type": "OAUTH2",
    "access_token": "test-token",
    "data": {
      "team_id": "T0TEAM",
      "authed_user": {
        "id": "U0ME",
        "access_token": "test-user-token"
      }
    }
  },
  "inputs": {
    "includeDisabled": true,
    "includeUsers": false
  },
  "credential": {
    "oauthAccessToken": "test-token"
  },
  "answers": [
    {
      "status": 200,
      "body": {
        "ok": true,
        "usergroups": [
          {
            "id": "S0GROUP",
            "handle": "engineering",
            "name": "Engineering"
          }
        ]
      }
    }
  ],
  "exchanges": [
    {
      "request": {
        "method": "POST",
        "url": "https://slack.com/api/usergroups.list",
        "headers": {
          "authorization": "Bearer test-token",
          "content-type": "application/x-www-form-urlencoded"
        },
        "body": "include_disabled=true&include_users=false"
      }
    }
  ],
  "output": {
    "ok": true,
    "usergroups": [
      {
        "id": "S0GROUP",
        "handle": "engineering",
        "name": "Engineering"
      }
    ],
    "response_metadata": {}
  }
