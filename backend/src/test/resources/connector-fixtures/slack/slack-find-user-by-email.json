{
  "package": "@activepieces/piece-slack",
  "version": "0.23.1",
  "action": "slack-find-user-by-email",
  "auth": {
    "type": "OAUTH2",
    "access_token": "test-token",
    "data": {
      "team_id": "T0TEAM",
      "authed_user": {
        "id": "U0ME",
        "access_token": "test-user-token"
      }
    }
  },
  "inputs": {
    "email": "ada@example.com"
  },
  "credential": {
    "oauthAccessToken": "test-token"
  },
  "answers": [
    {
      "status": 200,
      "body": {
        "ok": true,
        "user": {
          "id": "U0ADA",
          "name": "ada",
          "profile": {
            "email": "ada@example.com"
          }
        }
      }
    }
  ],
  "exchanges": [
    {
      "request": {
        "method": "POST",
        "url": "https://slack.com/api/users.lookupByEmail",
        "headers": {
          "authorization": "Bearer test-token",
          "content-type": "application/x-www-form-urlencoded"
        },
        "body": "email=ada%40example.com"
      }
    }
  ],
  "output": {
    "ok": true,
    "user": {
      "id": "U0ADA",
      "name": "ada",
      "profile": {
        "email": "ada@example.com"
      }
    },
    "response_metadata": {}
  }
}
