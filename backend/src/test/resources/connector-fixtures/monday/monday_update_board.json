{
  "package": "@activepieces/piece-monday",
  "version": "0.4.1",
  "action": "monday_update_board",
  "auth": {
    "type": "SECRET_TEXT",
    "secret_text": "mon-test-token"
  },
  "inputs": {
    "board_id": "111",
    "board_attribute": "description",
    "new_value": "New plans"
  },
  "credential": {
    "token": "mon-test-token"
  },
  "answers": [
    {
      "status": 200,
      "body": {
        "data": {
          "update_board": "{\"success\":true,\"undo_data\":{}}"
        },
        "account_id": 9001
      }
    }
  ],
  "exchanges": [
    {
      "request": {
        "method": "POST",
        "url": "https://api.monday.com/v2",
        "headers": {
          "api-version": "2026-07",
          "authorization": "mon-test-token",
          "content-type": "application/json"
        },
        "body": {
          "query": "mutation ($board_id: ID!, $board_attribute: BoardAttributes!, $new_value: String!) {\n        update_board(board_id: $board_id, board_attribute: $board_attribute, new_value: $new_value)\n      }",
          "variables": {
            "board_id": "111",
            "board_attribute": "description",
            "new_value": "New plans"
          }
        }
      }
    }
  ],
  "output": {
    "board_id": "111",
    "attribute": "description",
    "new_value": "New plans",
    "success": true
  }
}
