{
  "package": "@activepieces/piece-monday",
  "version": "0.4.1",
  "action": "monday_rename_item",
  "auth": {
    "type": "SECRET_TEXT",
    "secret_text": "mon-test-token"
  },
  "inputs": {
    "board_id": "111",
    "item_id": "333",
    "name": "Renamed"
  },
  "credential": {
    "token": "mon-test-token"
  },
  "answers": [
    {
      "status": 200,
      "body": {
        "data": {
          "change_multiple_column_values": {
            "id": "333",
            "name": "Renamed",
            "state": "active",
            "url": "https://acme.monday.com/boards/111/pulses/333",
            "board": {
              "id": "111"
            },
            "group": {
              "id": "topics"
            }
          }
        },
        "account_id": 9001
      }
    }
  ],
  "exchanges": [
    {
      "request": {
        "method": "POST",
        "url": "https://api.monday.com/v2",
        "headers": {
          "api-version": "2026-07",
          "authorization": "mon-test-token",
          "content-type": "application/json"
        },
        "body": {
          "query": "mutation ($boardId: ID!, $itemId: ID!, $columnValues: JSON!) {\n        change_multiple_column_values(board_id: $boardId, item_id: $itemId, column_values: $columnValues) {\n          id name state url board { id } group { id }\n        }\n      }",
          "variables": {
            "boardId": "111",
            "itemId": "333",
            "columnValues": "{\"name\":\"Renamed\"}"
          }
        }
      }
    }
  ],
  "output": {
    "id": "333",
    "name": "Renamed",
    "state": "active",
    "url": "https://acme.monday.com/boards/111/pulses/333",
    "board_id": "111",
    "group_id": "topics"
  }
}
