{
  "package": "@activepieces/piece-monday",
  "version": "0.4.1",
  "action": "monday_list_tags",
  "auth": {
    "type": "SECRET_TEXT",
    "secret_text": "mon-test-token"
  },
  "inputs": {
    "board_id": "111",
    "tag_ids": [
      "5"
    ]
  },
  "credential": {
    "token": "mon-test-token"
  },
  "answers": [
    {
      "status": 200,
      "body": {
        "data": {
          "boards": [
            {
              "tags": [
                {
                  "id": 5,
                  "name": "urgent",
                  "color": null
                }
              ]
            }
          ]
        },
        "account_id": 9001
      }
    }
  ],
  "exchanges": [
    {
      "request": {
        "method": "POST",
        "url": "https://api.monday.com/v2",
        "headers": {
          "api-version": "2026-07",
          "authorization": "mon-test-token",
          "content-type": "application/json"
        },
        "body": {
          "query": "query ($ids: [ID!]) {\n      boards(ids: $ids) { tags { id name color } }\n    }",
          "variables": {
            "ids": [
              "111"
            ]
          }
        }
      }
    }
  ],
  "output": {
    "tags": [
      {
        "id": "5",
        "name": "urgent",
        "color": null
      }
    ],
    "count": 1
  }
}
