{
  "package": "@activepieces/piece-monday",
  "version": "0.4.1",
  "action": "monday_archive_board",
  "auth": {
    "type": "SECRET_TEXT",
    "secret_text": "mon-test-token"
  },
  "inputs": {
    "board_id": "111"
  },
  "credential": {
    "token": "mon-test-token"
  },
  "answers": [
    {
      "status": 200,
      "body": {
        "data": {
          "archive_board": {
            "id": "111",
            "name": "Roadmap",
            "state": "archived"
          }
        },
        "account_id": 9001
      }
    }
  ],
  "exchanges": [
    {
      "request": {
        "method": "POST",
        "url": "https://api.monday.com/v2",
        "headers": {
          "api-version": "2026-07",
          "authorization": "mon-test-token",
          "content-type": "application/json"
        },
        "body": {
          "query": "mutation ($board_id: ID!) {\n        archive_board(board_id: $board_id) { id name state }\n      }",
          "variables": {
            "board_id": "111"
          }
        }
      }
    }
  ],
  "output": {
    "id": "111",
    "name": "Roadmap",
    "state": "archived"
  }
}
