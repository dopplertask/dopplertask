{
  "package": "@activepieces/piece-monday",
  "version": "0.4.1",
  "action": "monday_list_groups",
  "auth": {
    "type": "SECRET_TEXT",
    "secret_text": "mon-test-token"
  },
  "inputs": {
    "board_id": "111"
  },
  "credential": {
    "token": "mon-test-token"
  },
  "answers": [
    {
      "status": 200,
      "body": {
        "data": {
          "boards": [
            {
              "id": "111",
              "groups": [
                {
                  "id": "topics",
                  "title": "Group Title",
                  "color": "#579bfc",
                  "archived": null,
                  "deleted": false
                }
              ]
            }
          ]
        },
        "account_id": 9001
      }
    }
  ],
  "exchanges": [
    {
      "request": {
        "method": "POST",
        "url": "https://api.monday.com/v2",
        "headers": {
          "api-version": "2026-07",
          "authorization": "mon-test-token",
          "content-type": "application/json"
        },
        "body": {
          "query": "query ($boardIds: [ID!]) {\n        boards(ids: $boardIds) {\n          id\n          groups { id title color archived deleted }\n        }\n      }",
          "variables": {
            "boardIds": [
              "111"
            ]
          }
        }
      }
    }
  ],
  "output": {
    "board_id": "111",
    "groups": [
      {
        "id": "topics",
        "title": "Group Title",
        "color": "#579bfc",
        "archived": false,
        "deleted": false
      }
    ],
    "count": 1
  }
}
