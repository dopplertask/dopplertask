{
  "package": "@activepieces/piece-monday",
  "version": "0.4.1",
  "action": "monday_add_board_column",
  "auth": {
    "type": "SECRET_TEXT",
    "secret_text": "mon-test-token"
  },
  "inputs": {
    "board_id": "111",
    "title": "Stage",
    "column_type": " status ",
    "description": "Where it is",
    "after_column_id": "name",
    "defaults": {
      "labels": {
        "1": "Done",
        "2": "Stuck"
      }
    }
  },
  "credential": {
    "token": "mon-test-token"
  },
  "answers": [
    {
      "status": 200,
      "body": {
        "data": {
          "create_column": {
            "id": "status_2",
            "title": "Stage",
            "type": "status",
            "description": "Where it is"
          }
        },
        "account_id": 9001
      }
    }
  ],
  "exchanges": [
    {
      "request": {
        "method": "POST",
        "url": "https://api.monday.com/v2",
        "headers": {
          "api-version": "2026-07",
          "authorization": "mon-test-token",
          "content-type": "application/json"
        },
        "body": {
          "query": "mutation ($boardId: ID!, $title: String!, $columnType: ColumnType!, $description: String, $afterColumnId: ID, $defaults: JSON) {\n        create_column(\n          board_id: $boardId\n          title: $title\n          column_type: $columnType\n          description: $description\n          after_column_id: $afterColumnId\n          defaults: $defaults\n        ) {\n          id\n          title\n          type\n          description\n        }\n      }",
          "variables": {
            "boardId": "111",
            "title": "Stage",
            "columnType": "status",
            "description": "Where it is",
            "afterColumnId": "name",
            "defaults": "{\"labels\":{\"1\":\"Done\",\"2\":\"Stuck\"}}"
          }
        }
      }
    }
  ],
  "output": {
    "id": "status_2",
    "board_id": "111",
    "title": "Stage",
    "type": "status",
    "description": "Where it is"
  }
}
