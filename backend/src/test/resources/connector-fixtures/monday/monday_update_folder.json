{
  "package": "@activepieces/piece-monday",
  "version": "0.4.1",
  "action": "monday_update_folder",
  "auth": {
    "type": "SECRET_TEXT",
    "secret_text": "mon-test-token"
  },
  "inputs": {
    "folder_id": "13",
    "name": "Q2",
    "parent_folder_id": "10",
    "workspace_id": "9"
  },
  "credential": {
    "token": "mon-test-token"
  },
  "answers": [
    {
      "status": 200,
      "body": {
        "data": {
          "folders": [
            {
              "color": "BRIGHT_BLUE"
            }
          ]
        },
        "account_id": 9001
      }
    },
    {
      "status": 200,
      "body": {
        "data": {
          "update_folder": {
            "id": "13",
            "name": "Q2",
            "color": "BRIGHT_BLUE",
            "workspace": {
              "id": "9"
            },
            "parent": {
              "id": "10"
            }
          }
        },
        "account_id": 9001
      }
    }
  ],
  "exchanges": [
    {
      "request": {
        "method": "POST",
        "url": "https://api.monday.com/v2",
        "headers": {
          "api-version": "2026-07",
          "authorization": "mon-test-token",
          "content-type": "application/json"
        },
        "body": {
          "query": "query ($ids: [ID!]) {\n      folders(ids: $ids) {\n        color\n      }\n    }",
          "variables": {
            "ids": [
              "13"
            ]
          }
        }
      }
    },
    {
      "request": {
        "method": "POST",
        "url": "https://api.monday.com/v2",
        "headers": {
          "api-version": "2026-07",
          "authorization": "mon-test-token",
          "content-type": "application/json"
        },
        "body": {
          "query": "mutation ($folder_id: ID!, $name: String, $parent_folder_id: ID, $workspace_id: ID, $color: FolderColor) {\n        update_folder(folder_id: $folder_id, name: $name, parent_folder_id: $parent_folder_id, workspace_id: $workspace_id, color: $color) {\n          id\n          name\n          color\n          workspace { id }\n          parent { id }\n        }\n      }",
          "variables": {
            "folder_id": "13",
            "name": "Q2",
            "parent_folder_id": "10",
            "workspace_id": "9",
            "color": "BRIGHT_BLUE"
          }
        }
      }
    }
  ],
  "output": {
    "id": "13",
    "name": "Q2",
    "color": "BRIGHT_BLUE",
    "workspace_id": "9",
    "parent_folder_id": "10"
  }
}
