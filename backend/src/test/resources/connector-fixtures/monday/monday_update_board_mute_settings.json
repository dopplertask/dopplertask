{
  "package": "@activepieces/piece-monday",
  "version": "0.4.1",
  "action": "monday_update_board_mute_settings",
  "auth": {
    "type": "SECRET_TEXT",
    "secret_text": "mon-test-token"
  },
  "inputs": {
    "board_id": "111",
    "mute_state": "CUSTOM_SETTINGS",
    "enabled": [
      "IM_ASSIGNED",
      "IM_MENTIONED"
    ]
  },
  "credential": {
    "token": "mon-test-token"
  },
  "answers": [
    {
      "status": 200,
      "body": {
        "data": {
          "update_mute_board_settings": [
            {
              "board_id": "111",
              "mute_state": "CUSTOM_SETTINGS",
              "enabled": [
                "IM_ASSIGNED",
                "IM_MENTIONED"
              ]
            }
          ]
        },
        "account_id": 9001
      }
    }
  ],
  "exchanges": [
    {
      "request": {
        "method": "POST",
        "url": "https://api.monday.com/v2",
        "headers": {
          "api-version": "2026-07",
          "authorization": "mon-test-token",
          "content-type": "application/json"
        },
        "body": {
          "query": "mutation ($boardId: String!, $muteState: BoardMuteState!, $enabled: [CustomizableBoardSettings!]) {\n        update_mute_board_settings(board_id: $boardId, mute_state: $muteState, enabled: $enabled) {\n          board_id\n          mute_state\n          enabled\n        }\n      }",
          "variables": {
            "boardId": "111",
            "muteState": "CUSTOM_SETTINGS",
            "enabled": [
              "IM_ASSIGNED",
              "IM_MENTIONED"
            ]
          }
        }
      }
    }
  ],
  "output": {
    "board_id": "111",
    "mute_state": "CUSTOM_SETTINGS",
    "enabled": "IM_ASSIGNED, IM_MENTIONED"
  }
}
