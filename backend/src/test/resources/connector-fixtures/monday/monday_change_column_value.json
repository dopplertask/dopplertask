{
  "package": "@activepieces/piece-monday",
  "version": "0.4.1",
  "action": "monday_change_column_value",
  "auth": {
    "type": "SECRET_TEXT",
    "secret_text": "mon-test-token"
  },
  "inputs": {
    "board_id": "111",
    "item_id": "333",
    "column_id": "status",
    "value": {
      "label": "Done"
    },
    "create_labels_if_missing": true
  },
  "credential": {
    "token": "mon-test-token"
  },
  "answers": [
    {
      "status": 200,
      "body": {
        "data": {
          "change_column_value": {
            "id": "333",
            "name": "Task 333",
            "state": "active",
            "url": null,
            "board": {
              "id": "111"
            },
            "group": null
          }
        },
        "account_id": 9001
      }
    }
  ],
  "exchanges": [
    {
      "request": {
        "method": "POST",
        "url": "https://api.monday.com/v2",
        "headers": {
          "api-version": "2026-07",
          "authorization": "mon-test-token",
          "content-type": "application/json"
        },
        "body": {
          "query": "mutation ($boardId: ID!, $itemId: ID!, $columnId: String!, $value: JSON!, $createLabels: Boolean) {\n        change_column_value(board_id: $boardId, item_id: $itemId, column_id: $columnId, value: $value, create_labels_if_missing: $createLabels) {\n          id name state url board { id } group { id }\n        }\n      }",
          "variables": {
            "boardId": "111",
            "itemId": "333",
            "columnId": "status",
            "value": "{\"label\":\"Done\"}",
            "createLabels": true
          }
        }
      }
    }
  ],
  "output": {
    "id": "333",
    "name": "Task 333",
    "state": "active",
    "url": null,
    "board_id": "111",
    "group_id": null
  }
}
