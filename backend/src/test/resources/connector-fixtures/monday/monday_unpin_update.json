{
  "package": "@activepieces/piece-monday",
  "version": "0.4.1",
  "action": "monday_unpin_update",
  "auth": {
    "type": "SECRET_TEXT",
    "secret_text": "mon-test-token"
  },
  "inputs": {
    "update_id": "444",
    "item_id": "333"
  },
  "credential": {
    "token": "mon-test-token"
  },
  "answers": [
    {
      "status": 200,
      "body": {
        "data": {
          "unpin_from_top": {
            "id": "444",
            "item_id": "333"
          }
        },
        "account_id": 9001
      }
    }
  ],
  "exchanges": [
    {
      "request": {
        "method": "POST",
        "url": "https://api.monday.com/v2",
        "headers": {
          "api-version": "2026-07",
          "authorization": "mon-test-token",
          "content-type": "application/json"
        },
        "body": {
          "query": "mutation ($id: ID!, $itemId: ID) {\n        unpin_from_top(id: $id, item_id: $itemId) { id item_id }\n      }",
          "variables": {
            "id": "444",
            "itemId": "333"
          }
        }
      }
    }
  ],
  "output": {
    "id": "444",
    "item_id": "333",
    "pinned": false
  }
