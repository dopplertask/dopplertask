{
  "package": "@activepieces/piece-monday",
  "version": "0.4.1",
  "action": "monday_set_item_column_values",
  "auth": {
    "type": "SECRET_TEXT",
    "secret_text": "mon-test-token"
  },
  "inputs": {
    "board_id": "111",
    "item_id": "333",
    "column_values": {
      "status": {
        "label": "Done"
      },
      "numbers": "42",
      "people": {
        "personsAndTeams": [
          {
            "id": 123,
            "kind": "person"
          }
        ]
      }
    },
    "create_labels_if_missing": true
  },
  "credential": {
    "token": "mon-test-token"
  },
  "answers": [
    {
      "status": 200,
      "body": {
        "data": {
          "change_multiple_column_values": {
            "id": "333",
            "name": "Task 333",
            "state": "active",
            "url": "https://acme.monday.com/boards/111/pulses/333",
            "board": {
              "id": "111"
            },
            "group": {
              "id": "topics"
            }
          }
        },
        "account_id": 9001
      }
    }
  ],
  "exchanges": [
    {
      "request": {
        "method": "POST",
        "url": "https://api.monday.com/v2",
        "headers": {
          "api-version": "2026-07",
          "authorization": "mon-test-token",
          "content-type": "application/json"
        },
        "body": {
          "query": "mutation ($boardId: ID!, $itemId: ID!, $columnValues: JSON!, $createLabels: Boolean) {\n        change_multiple_column_values(board_id: $boardId, item_id: $itemId, column_values: $columnValues, create_labels_if_missing: $createLabels) {\n          id name state url board { id } group { id }\n        }\n      }",
          "variables": {
            "boardId": "111",
            "itemId": "333",
            "columnValues": "{\"status\":{\"label\":\"Done\"},\"numbers\":\"42\",\"people\":{\"personsAndTeams\":[{\"id\":123,\"kind\":\"person\"}]}}",
            "createLabels": true
          }
        }
      }
    }
  ],
  "output": {
    "id": "333",
    "name": "Task 333",
    "state": "active",
    "url": "https://acme.monday.com/boards/111/pulses/333",
    "board_id": "111",
    "group_id": "topics"
  }
}
