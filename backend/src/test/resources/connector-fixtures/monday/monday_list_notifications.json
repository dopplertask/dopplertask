          "query": "query ($filterRead: Boolean, $since: ISO8601DateTime, $limit: Int, $cursor: ID) {\n        notifications(filter_read: $filterRead, since: $since, limit: $limit, cursor: $cursor) {\n          id\n          title\n          text\n          read\n          created_at\n          board { id name }\n          item { id name }\n          update { id }\n        }\n      }",
