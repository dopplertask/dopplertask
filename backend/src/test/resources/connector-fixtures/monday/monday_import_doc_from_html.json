        "body": {
          "query": "mutation ($html: String!, $workspaceId: ID!, $title: String, $folderId: ID, $kind: DocKind) {\n        import_doc_from_html(html: $html, workspaceId: $workspaceId, title: $title, folderId: $folderId, kind: $kind) {\n          success\n          doc_id\n          error\n        }\n      }",
