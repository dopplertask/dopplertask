{
  "package": "@activepieces/piece-monday",
  "version": "0.4.1",
  "action": "monday_send_notification",
  "auth": {
    "type": "SECRET_TEXT",
    "secret_text": "mon-test-token"
  },
  "inputs": {
    "user_id": "5",
    "target_type": "Project",
    "target_id": "333",
    "text": "Please review"
  },
  "credential": {
    "token": "mon-test-token"
  },
  "answers": [
    {
      "status": 200,
      "body": {
        "data": {
          "create_notification": {
            "text": "Please review"
          }
        },
        "account_id": 9001
      }
    }
  ],
  "exchanges": [
    {
      "request": {
        "method": "POST",
        "url": "https://api.monday.com/v2",
        "headers": {
          "api-version": "2026-07",
          "authorization": "mon-test-token",
          "content-type": "application/json"
        },
        "body": {
          "query": "mutation ($userId: ID!, $targetId: ID!, $targetType: NotificationTargetType!, $text: String!) {\n        create_notification(user_id: $userId, target_id: $targetId, target_type: $targetType, text: $text) {\n          text\n        }\n      }",
          "variables": {
            "userId": "5",
            "targetId": "333",
            "targetType": "Project",
            "text": "Please review"
          }
        }
      }
    }
  ],
  "output": {
    "sent": true,
    "user_id": "5",
    "target_type": "Project",
    "target_id": "333",
    "text": "Please review"
  }
}
