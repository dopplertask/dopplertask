{
  "package": "@activepieces/piece-monday",
  "version": "0.4.1",
  "action": "monday_aggregate_board_data",
  "auth": {
    "type": "SECRET_TEXT",
    "secret_text": "mon-test-token"
  },
  "inputs": {
    "board_id": "111",
    "function": "SUM",
    "column_id": "numbers",
    "group_by_column_id": "status",
    "group_limit": 10,
    "filter": {
      "rules": [
        {
          "column_id": "status",
          "compare_value": [
            1
          ],
          "operator": "any_of"
        }
      ]
    }
  },
  "credential": {
    "token": "mon-test-token"
  },
  "answers": [
    {
      "status": 200,
      "body": {
        "data": {
          "aggregate": {
            "results": [
              {
                "entries": [
                  {
                    "alias": "metric",
                    "value": {
                      "result": 42
                    }
                  },
                  {
                    "alias": "status",
                    "value": {
                      "value": "Done"
                    }
                  }
                ]
              },
              {
                "entries": [
                  {
                    "alias": "metric",
                    "value": {
                      "result": 7
                    }
                  },
                  {
                    "alias": "status",
                    "value": {
                      "value": {
                        "index": 2
                      }
                    }
                  }
                ]
              }
            ]
          }
        },
        "account_id": 9001
      }
    }
  ],
  "exchanges": [
    {
      "request": {
        "method": "POST",
        "url": "https://api.monday.com/v2",
        "headers": {
          "api-version": "2026-07",
          "authorization": "mon-test-token",
          "content-type": "application/json"
        },
        "body": {
          "query": "query ($query: AggregateQueryInput!) {\n        aggregate(query: $query) {\n          results {\n            entries {\n              alias\n              value {\n                ... on AggregateBasicAggregationResult { result }\n                ... on AggregateGroupByResult { value }\n              }\n            }\n          }\n        }\n      }",
          "variables": {
            "query": {
              "from": {
                "type": "TABLE",
                "id": "111"
              },
              "select": [
                {
                  "type": "FUNCTION",
                  "as": "metric",
                  "function": {
                    "function": "SUM",
                    "params": [
                      {
                        "type": "COLUMN",
                        "column": {
                          "column_id": "numbers"
                        },
                        "as": "numbers"
                      }
                    ]
                  }
                },
                {
                  "type": "COLUMN",
                  "column": {
                    "column_id": "status"
                  },
                  "as": "status"
                }
              ],
              "group_by": [
                {
                  "column_id": "status",
                  "limit": 10
                }
              ],
              "query": {
                "rules": [
                  {
                    "column_id": "status",
                    "compare_value": [
                      1
                    ],
                    "operator": "any_of"
                  }
                ]
              }
            }
          }
        }
      }
    }
  ],
  "output": {
    "board_id": "111",
    "function": "SUM",
    "column_id": "numbers",
    "group_by_column_id": "status",
    "rows": [
      {
        "group_value": "Done",
        "value": 42
      },
      {
        "group_value": "{\"index\":2}",
        "value": 7
      }
    ],
    "count": 2
  }
}
