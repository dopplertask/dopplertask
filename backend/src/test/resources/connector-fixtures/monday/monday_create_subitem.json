{
  "package": "@activepieces/piece-monday",
  "version": "0.4.1",
  "action": "monday_create_subitem",
  "auth": {
    "type": "SECRET_TEXT",
    "secret_text": "mon-test-token"
  },
  "inputs": {
    "parent_item_id": "333",
    "item_name": "Step 1",
    "column_values": {
      "status": {
        "label": "Working on it"
      }
    },
    "create_labels_if_missing": false
  },
  "credential": {
    "token": "mon-test-token"
  },
  "answers": [
    {
      "status": 200,
      "body": {
        "data": {
          "create_subitem": {
            "id": "336",
            "name": "Task 336",
            "state": "active",
            "url": "https://acme.monday.com/boards/111/pulses/336",
            "board": {
              "id": "999"
            },
            "group": {
              "id": "topics"
            }
          }
        },
        "account_id": 9001
      }
    }
  ],
  "exchanges": [
    {
      "request": {
        "method": "POST",
        "url": "https://api.monday.com/v2",
        "headers": {
          "api-version": "2026-07",
          "authorization": "mon-test-token",
          "content-type": "application/json"
        },
        "body": {
          "query": "mutation ($parentItemId: ID!, $itemName: String!, $columnValues: JSON, $createLabels: Boolean) {\n        create_subitem(parent_item_id: $parentItemId, item_name: $itemName, column_values: $columnValues, create_labels_if_missing: $createLabels) {\n          id name state url board { id } group { id }\n        }\n      }",
          "variables": {
            "parentItemId": "333",
            "itemName": "Step 1",
            "columnValues": "{\"status\":{\"label\":\"Working on it\"}}",
            "createLabels": false
          }
        }
      }
    }
  ],
  "output": {
    "id": "336",
    "name": "Task 336",
    "state": "active",
    "url": "https://acme.monday.com/boards/111/pulses/336",
    "board_id": "999",
    "group_id": "topics",
    "parent_item_id": "333"
  }
}
