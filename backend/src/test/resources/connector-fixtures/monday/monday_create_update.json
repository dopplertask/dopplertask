          "api-version": "2023-10",
          "authorization": "mon-test-token",
          "content-type": "application/json"
        },
        "body": {
          "query": "\n  mutation createUpdate($itemId: ID!, $body: String!) {\n    create_update(item_id: $itemId, body: $body) {\n      id\n    }\n  }",
          "variables": {
            "itemId": "333",
            "body": "Looks good"
          }
        }
      }
    }
  ],
  "output": {
    "data": {
      "create_update": {
        "id": "444"
      }
    },
    "account_id": 9001
  }
