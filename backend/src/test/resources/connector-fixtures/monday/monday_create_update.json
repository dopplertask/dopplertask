{
  "package": "@activepieces/piece-monday",
  "version": "0.4.1",
  "action": "monday_create_update",
  "auth": {
    "type": "SECRET_TEXT",
    "secret_text": "mon-test-token"
  },
  "inputs": {
    "item_id": "333",
    "body": "Looks good"
  },
  "credential": {
    "token": "mon-test-token"
  },
  "answers": [
    {
      "status": 200,
      "body": {
        "data": {
          "create_update": {
            "id": "444"
          }
        },
        "account_id": 9001
      }
    }
  ],
  "exchanges": [
    {
      "request": {
        "method": "POST",
