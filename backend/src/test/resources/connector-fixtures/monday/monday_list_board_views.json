{
  "package": "@activepieces/piece-monday",
  "version": "0.4.1",
  "action": "monday_list_board_views",
  "auth": {
    "type": "SECRET_TEXT",
    "secret_text": "mon-test-token"
  },
  "inputs": {
    "board_id": "111"
  },
