{
  "package": "@activepieces/piece-monday",
  "version": "0.4.1",
  "action": "monday_add_board_group",
  "auth": {
    "type": "SECRET_TEXT",
    "secret_text": "mon-test-token"
  },
  "inputs": {
    "board_id": "111",
    "group_name": "Backlog",
    "group_color": "#ff642e",
    "relative_to": "topics",
    "position_relative_method": "after_at"
  },
  "credential": {
    "token": "mon-test-token"
  },
  "answers": [
    {
      "status": 200,
      "body": {
        "data": {
          "create_group": {
            "id": "backlog",
            "title": "Backlog",
            "color": "#ff642e"
          }
        },
        "account_id": 9001
      }
    }
  ],
  "exchanges": [
    {
      "request": {
        "method": "POST",
        "url": "https://api.monday.com/v2",
        "headers": {
          "api-version": "2026-07",
          "authorization": "mon-test-token",
          "content-type": "application/json"
        },
        "body": {
          "query": "mutation ($boardId: ID!, $groupName: String!, $groupColor: String, $relativeTo: String, $positionRelativeMethod: PositionRelative) {\n        create_group(\n          board_id: $boardId\n          group_name: $groupName\n          group_color: $groupColor\n          relative_to: $relativeTo\n          position_relative_method: $positionRelativeMethod\n        ) { id title color }\n      }",
          "variables": {
            "boardId": "111",
            "groupName": "Backlog",
            "groupColor": "#ff642e",
            "relativeTo": "topics",
            "positionRelativeMethod": "after_at"
          }
        }
      }
    }
  ],
  "output": {
    "id": "backlog",
    "board_id": "111",
    "title": "Backlog",
    "color": "#ff642e"
  }
}
