{
  "package": "@activepieces/piece-monday",
  "version": "0.4.1",
  "action": "monday_append_markdown_to_doc",
  "auth": {
    "type": "SECRET_TEXT",
    "secret_text": "mon-test-token"
  },
  "inputs": {
    "doc_id": "50",
    "markdown": "# Title\n\nText",
    "after_block_id": "blk1"
  },
  "credential": {
    "token": "mon-test-token"
  },
  "answers": [
    {
      "status": 200,
      "body": {
        "data": {
          "add_content_to_doc_from_markdown": {
            "success": true,
            "block_ids": [
              "b1",
              "b2"
            ],
            "error": null
          }
        },
        "account_id": 9001
      }
    }
  ],
  "exchanges": [
    {
      "request": {
        "method": "POST",
        "url": "https://api.monday.com/v2",
        "headers": {
          "api-version": "2026-07",
          "authorization": "mon-test-token",
          "content-type": "application/json"
        },
        "body": {
          "query": "mutation ($docId: ID!, $markdown: String!, $afterBlockId: String) {\n        add_content_to_doc_from_markdown(docId: $docId, markdown: $markdown, afterBlockId: $afterBlockId) {\n          success\n          block_ids\n          error\n        }\n      }",
          "variables": {
            "docId": "50",
            "markdown": "# Title\n\nText",
            "afterBlockId": "blk1"
          }
        }
      }
    }
  ],
  "output": {
    "doc_id": "50",
    "success": true,
    "block_ids": "b1, b2",
    "block_count": 2
  }
}
