{
  "package": "@activepieces/piece-monday",
  "version": "0.4.1",
  "action": "monday_update_workspace",
  "auth": {
    "type": "SECRET_TEXT",
    "secret_text": "mon-test-token"
  },
  "inputs": {
    "workspace_id": "9",
    "name": "Renamed",
    "description": "New text",
    "clear_description": false,
    "kind": "closed",
    "account_product_id": "12"
  },
  "credential": {
    "token": "mon-test-token"
  },
  "answers": [
    {
      "status": 200,
      "body": {
        "data": {
          "update_workspace": {
            "id": "9",
            "name": "Renamed",
            "kind": "closed",
            "description": "New text",
            "state": "active"
          }
        },
        "account_id": 9001
      }
    }
  ],
  "exchanges": [
    {
      "request": {
        "method": "POST",
        "url": "https://api.monday.com/v2",
        "headers": {
          "api-version": "2026-07",
          "authorization": "mon-test-token",
          "content-type": "application/json"
        },
        "body": {
          "query": "mutation ($id: ID!, $attributes: UpdateWorkspaceAttributesInput!) {\n        update_workspace(id: $id, attributes: $attributes) {\n          id\n          name\n          kind\n          description\n          state\n        }\n      }",
          "variables": {
            "id": "9",
            "attributes": {
              "name": "Renamed",
              "description": "New text",
              "kind": "closed",
              "account_product_id": "12"
            }
          }
        }
      }
    }
  ],
  "output": {
    "id": "9",
    "name": "Renamed",
    "kind": "closed",
    "description": "New text",
    "state": "active"
  }
}
