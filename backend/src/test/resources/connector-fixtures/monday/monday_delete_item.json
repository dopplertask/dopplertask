{
  "package": "@activepieces/piece-monday",
  "version": "0.4.1",
  "action": "monday_delete_item",
  "auth": {
    "type": "SECRET_TEXT",
    "secret_text": "mon-test-token"
  },
  "inputs": {
    "item_id": "333"
  },
  "credential": {
    "token": "mon-test-token"
  },
  "answers": [
    {
      "status": 200,
      "body": {
        "data": {
          "delete_item": {
            "id": "333"
          }
        },
        "account_id": 9001
      }
    }
  ],
  "exchanges": [
    {
      "request": {
        "method": "POST",
        "url": "https://api.monday.com/v2",
        "headers": {
          "api-version": "2026-07",
          "authorization": "mon-test-token",
          "content-type": "application/json"
        },
        "body": {
          "query": "mutation ($itemId: ID!) {\n        delete_item(item_id: $itemId) { id }\n      }",
          "variables": {
            "itemId": "333"
          }
        }
      }
    }
  ],
  "output": {
    "success": true,
    "id": "333"
  }
}
