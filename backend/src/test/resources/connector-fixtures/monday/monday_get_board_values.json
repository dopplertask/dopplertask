        "body": {
          "query": "\n  query getItemColumnValues($boardId: ID!,$columnIds: [String!])\n  {\n    boards(ids: [$boardId])\n    {\n      items_page(query_params: {order_by: {column_id: \"__last_updated__\",direction: desc}})\n      {\n        items{\n          id\n          name\n          column_values(ids: $columnIds){\n            id\n            type\n            value\n            text\n            ... on ButtonValue{\n              label\n            }\n            ... on StatusValue{\n              label\n            }\n            ... on VoteValue{\n              vote_count\n            }\n            ... on TagsValue{\n              tags{\n                  name\n              }\n          }\n          ... on BoardRelationValue {\n            linked_item_ids\n          }\n          ... on DependencyValue {\n            linked_item_ids\n          }\n          ... on WeekValue {\n            start_date\n            end_date\n          }\n          }\n        }\n      }\n    }\n  }",
          "variables": {
            "boardId": "222",
            "columnIds": [
              "text",
              "status"
            ]
          }
