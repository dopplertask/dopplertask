{
  "package": "@activepieces/piece-monday",
  "version": "0.4.1",
  "action": "monday_create_board_item",
  "auth": {
    "type": "SECRET_TEXT",
    "secret_text": "mon-test-token"
  },
  "inputs": {
    "board_id": "111",
    "item_name": "New task",
    "group_id": "topics",
    "column_values": {
      "status": {
        "label": "Done"
      },
      "date4": {
        "date": "2026-01-31"
      },
      "text": "Hello"
    },
    "create_labels_if_missing": true
  },
  "credential": {
    "token": "mon-test-token"
  },
  "answers": [
    {
      "status": 200,
      "body": {
        "data": {
          "create_item": {
            "id": "335",
            "name": "Task 335",
            "state": "active",
            "url": "https://acme.monday.com/boards/111/pulses/335",
            "board": {
              "id": "111"
            },
            "group": {
              "id": "topics"
            }
          }
        },
        "account_id": 9001
      }
    }
  ],
  "exchanges": [
    {
      "request": {
        "method": "POST",
        "url": "https://api.monday.com/v2",
        "headers": {
          "api-version": "2026-07",
          "authorization": "mon-test-token",
          "content-type": "application/json"
        },
        "body": {
          "query": "mutation ($boardId: ID!, $itemName: String!, $groupId: String, $columnValues: JSON, $createLabels: Boolean) {\n        create_item(board_id: $boardId, item_name: $itemName, group_id: $groupId, column_values: $columnValues, create_labels_if_missing: $createLabels) {\n          id name state url board { id } group { id }\n        }\n      }",
          "variables": {
            "boardId": "111",
            "itemName": "New task",
            "groupId": "topics",
            "columnValues": "{\"status\":{\"label\":\"Done\"},\"date4\":{\"date\":\"2026-01-31\"},\"text\":\"Hello\"}",
            "createLabels": true
          }
        }
      }
    }
  ],
  "output": {
    "id": "335",
    "name": "Task 335",
    "state": "active",
    "url": "https://acme.monday.com/boards/111/pulses/335",
    "board_id": "111",
    "group_id": "topics"
  }
}
