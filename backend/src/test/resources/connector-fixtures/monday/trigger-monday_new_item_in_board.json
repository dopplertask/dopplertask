  "exchanges": [
    {
      "request": {
        "method": "POST",
        "url": "https://api.monday.com/v2",
        "headers": {
          "api-version": "2023-10",
          "authorization": "mon-test-token",
          "content-type": "application/json"
        },
        "body": {
          "query": "\n  mutation createWebhook(\n    $boardId: ID!\n    $url: String!\n    $event: WebhookEventType!\n    $config: JSON\n  ) {\n    create_webhook(\n      board_id: $boardId\n      url: $url\n      event: $event\n      config: $config\n    ) {\n      id\n      board_id\n    }\n  }",
          "variables": {
            "boardId": "222",
            "url": "https://tasks.example.com/hooks/test-key",
            "event": "create_item"
          }
        }
      }
    },
    {
      "request": {
        "method": "POST",
        "url": "https://api.monday.com/v2",
        "headers": {
          "api-version": "2023-10",
          "authorization": "mon-test-token",
          "content-type": "application/json"
        },
        "body": {
          "query": "\n  query getItemColumnValues($boardId: ID!,$itemId: ID!,$columnIds: [String!])\n  {\n    boards(ids: [$boardId])\n    {\n      items_page(query_params: {ids: [$itemId]})\n      {\n        items{\n          id\n          name\n          column_values(ids: $columnIds){\n            id\n            type\n            value\n            text\n            ... on ButtonValue{\n              label\n            }\n            ... on StatusValue{\n              label\n            }\n            ... on VoteValue{\n              vote_count\n            }\n            ... on TagsValue{\n              tags{\n                  name\n              }\n          }\n          ... on BoardRelationValue {\n            linked_item_ids\n          }\n          ... on DependencyValue {\n            linked_item_ids\n          }\n          ... on WeekValue {\n            start_date\n            end_date\n          }\n          }\n        }\n      }\n    }\n  }",
          "variables": {
            "boardId": 222,
            "itemId": 333
          }
        }
      }
    }
  ],
  "output": [
    {
      "event": {
        "userId": 123,
