{
  "package": "@activepieces/piece-monday",
  "version": "0.4.1",
  "action": "monday_duplicate_item",
  "auth": {
    "type": "SECRET_TEXT",
    "secret_text": "mon-test-token"
  },
  "inputs": {
    "board_id": "111",
    "item_id": "333",
    "with_updates": true
  },
  "credential": {
    "token": "mon-test-token"
  },
  "answers": [
    {
      "status": 200,
      "body": {
        "data": {
          "duplicate_item": {
            "id": "337",
            "name": "Task 337",
            "state": "active",
            "url": "https://acme.monday.com/boards/111/pulses/337",
            "board": {
              "id": "111"
            },
            "group": {
              "id": "topics"
            }
          }
        },
        "account_id": 9001
      }
    }
  ],
  "exchanges": [
    {
      "request": {
        "method": "POST",
        "url": "https://api.monday.com/v2",
        "headers": {
          "api-version": "2026-07",
          "authorization": "mon-test-token",
          "content-type": "application/json"
        },
        "body": {
          "query": "mutation ($boardId: ID!, $itemId: ID!, $withUpdates: Boolean) {\n        duplicate_item(board_id: $boardId, item_id: $itemId, with_updates: $withUpdates) {\n          id name state url board { id } group { id }\n        }\n      }",
          "variables": {
            "boardId": "111",
            "itemId": "333",
            "withUpdates": true
          }
        }
      }
    }
  ],
  "output": {
    "id": "337",
    "name": "Task 337",
    "state": "active",
    "url": "https://acme.monday.com/boards/111/pulses/337",
    "board_id": "111",
    "group_id": "topics"
  }
}
