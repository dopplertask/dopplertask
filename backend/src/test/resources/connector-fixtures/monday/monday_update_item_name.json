{
  "package": "@activepieces/piece-monday",
  "version": "0.4.1",
  "action": "monday_update_item_name",
  "auth": {
    "type": "SECRET_TEXT",
    "secret_text": "mon-test-token"
  },
  "inputs": {
    "workspace_id": "111",
    "board_id": "222",
    "item_id": "333",
    "name": "Renamed"
  },
  "credential": {
    "token": "mon-test-token"
  },
  "answers": [
    {
      "status": 200,
      "body": {
        "data": {
          "change_multiple_column_values": {
            "id": "333",
            "name": "Renamed"
          }
        },
        "account_id": 9001
      }
    }
  ],
  "exchanges": [
    {
      "request": {
        "method": "POST",
        "url": "https://api.monday.com/v2",
        "headers": {
          "api-version": "2023-10",
          "authorization": "mon-test-token",
          "content-type": "application/json"
        },
        "body": {
          "query": "\n  mutation updateItem($itemId: ID!, $boardId: ID!, $columnValues: JSON!) {\n    change_multiple_column_values(\n      item_id: $itemId\n      board_id: $boardId\n      column_values: $columnValues\n    ) {\n      id\n      name\n    }\n  }",
          "variables": {
            "boardId": "222",
            "itemId": "333",
            "columnValues": "{\"name\":\"Renamed\"}"
          }
        }
      }
    }
  ],
  "output": {
    "data": {
      "change_multiple_column_values": {
        "id": "333",
        "name": "Renamed"
      }
    },
    "account_id": 9001
  }
}
