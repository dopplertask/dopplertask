{
  "package": "@activepieces/piece-monday",
  "version": "0.4.1",
  "action": "monday_export_doc_as_markdown",
  "auth": {
    "type": "SECRET_TEXT",
    "secret_text": "mon-test-token"
  },
  "inputs": {
    "doc_id": "50",
    "block_ids": [
      "b1",
      "b2"
    ]
  },
  "credential": {
    "token": "mon-test-token"
  },
  "answers": [
    {
      "status": 200,
      "body": {
        "data": {
          "export_markdown_from_doc": {
            "success": true,
            "markdown": "# Title",
            "error": null
          }
        },
        "account_id": 9001
      }
    }
  ],
  "exchanges": [
    {
      "request": {
        "method": "POST",
        "url": "https://api.monday.com/v2",
        "headers": {
          "api-version": "2026-07",
          "authorization": "mon-test-token",
          "content-type": "application/json"
        },
        "body": {
          "query": "query ($docId: ID!, $blockIds: [String!]) {\n        export_markdown_from_doc(docId: $docId, blockIds: $blockIds) {\n          success\n          markdown\n          error\n        }\n      }",
          "variables": {
            "docId": "50",
            "blockIds": [
              "b1",
              "b2"
            ]
          }
        }
      }
    }
  ],
  "output": {
    "doc_id": "50",
    "markdown": "# Title"
  }
}
