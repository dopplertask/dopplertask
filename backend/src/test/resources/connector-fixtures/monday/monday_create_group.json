{
  "package": "@activepieces/piece-monday",
  "version": "0.4.1",
  "action": "monday_create_group",
  "auth": {
    "type": "SECRET_TEXT",
    "secret_text": "mon-test-token"
  },
  "inputs": {
    "workspace_id": "111",
    "board_id": "222",
    "group_name": "Sprint 1"
  },
  "credential": {
    "token": "mon-test-token"
  },
  "answers": [
    {
      "status": 200,
      "body": {
        "data": {
          "create_group": {
            "id": "new_group"
          }
        },
        "account_id": 9001
      }
    }
  ],
  "exchanges": [
    {
      "request": {
        "method": "POST",
        "url": "https://api.monday.com/v2",
        "headers": {
          "api-version": "2023-10",
          "authorization": "mon-test-token",
          "content-type": "application/json"
        },
        "body": {
          "query": "\n  mutation createGroup($boardId: ID!, $groupName: String!) {\n    create_group(board_id: $boardId, group_name: $groupName) {\n      id\n    }\n  }",
          "variables": {
            "boardId": "222",
            "groupName": "Sprint 1"
          }
        }
      }
    }
  ],
  "output": {
    "data": {
      "create_group": {
        "id": "new_group"
      }
    },
    "account_id": 9001
  }
}
