          "api-version": "2023-10",
          "authorization": "mon-test-token",
          "content-type": "application/json"
        },
        "body": {
          "query": "\n  mutation createColumn(\n    $boardId: ID!\n    $columnTitle: String!\n    $columnType: ColumnType!\n  ) {\n    create_column(\n      board_id: $boardId\n      title: $columnTitle\n      column_type: $columnType\n    ) {\n      id\n    }\n  }",
          "variables": {
            "boardId": "222",
            "columnTitle": "Priority",
            "columnType": "status"
          }
        }
      }
    }
  ],
