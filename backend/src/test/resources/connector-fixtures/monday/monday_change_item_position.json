{
  "package": "@activepieces/piece-monday",
  "version": "0.4.1",
  "action": "monday_change_item_position",
  "auth": {
    "type": "SECRET_TEXT",
    "secret_text": "mon-test-token"
  },
  "inputs": {
    "item_id": "333",
    "group_id": "topics",
    "group_top": "top"
  },
  "credential": {
    "token": "mon-test-token"
  },
  "answers": [
    {
      "status": 200,
      "body": {
        "data": {
          "change_item_position": {
            "id": "333",
            "name": "Task 333",
            "state": "active",
            "url": "https://acme.monday.com/boards/111/pulses/333",
            "board": {
              "id": "111"
            },
            "group": {
              "id": "topics"
            }
          }
        },
        "account_id": 9001
      }
    }
  ],
  "exchanges": [
    {
      "request": {
        "method": "POST",
        "url": "https://api.monday.com/v2",
        "headers": {
          "api-version": "2026-07",
          "authorization": "mon-test-token",
          "content-type": "application/json"
        },
        "body": {
          "query": "mutation ($itemId: ID!, $relativeTo: ID, $positionRelativeMethod: PositionRelative, $groupId: ID, $groupTop: Boolean) {\n        change_item_position(item_id: $itemId, relative_to: $relativeTo, position_relative_method: $positionRelativeMethod, group_id: $groupId, group_top: $groupTop) {\n          id name state url board { id } group { id }\n        }\n      }",
          "variables": {
            "itemId": "333",
            "groupId": "topics",
            "groupTop": true
          }
        }
      }
    }
  ],
  "output": {
    "id": "333",
    "name": "Task 333",
    "state": "active",
    "url": "https://acme.monday.com/boards/111/pulses/333",
    "board_id": "111",
    "group_id": "topics"
  }
}
