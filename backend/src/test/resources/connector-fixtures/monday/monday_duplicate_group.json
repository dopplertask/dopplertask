{
  "package": "@activepieces/piece-monday",
  "version": "0.4.1",
  "action": "monday_duplicate_group",
  "auth": {
    "type": "SECRET_TEXT",
    "secret_text": "mon-test-token"
  },
  "inputs": {
    "board_id": "111",
    "group_id": "topics",
    "group_title": "Copy of topics",
    "add_to_top": true
  },
  "credential": {
    "token": "mon-test-token"
  },
  "answers": [
    {
      "status": 200,
      "body": {
        "data": {
          "duplicate_group": {
            "id": "topics_2",
            "title": "Copy of topics",
            "color": "#579bfc"
          }
        },
        "account_id": 9001
      }
    }
  ],
  "exchanges": [
    {
      "request": {
        "method": "POST",
        "url": "https://api.monday.com/v2",
        "headers": {
          "api-version": "2026-07",
          "authorization": "mon-test-token",
          "content-type": "application/json"
        },
        "body": {
          "query": "mutation ($boardId: ID!, $groupId: String!, $addToTop: Boolean, $groupTitle: String) {\n        duplicate_group(board_id: $boardId, group_id: $groupId, add_to_top: $addToTop, group_title: $groupTitle) { id title color }\n      }",
          "variables": {
            "boardId": "111",
            "groupId": "topics",
            "addToTop": true,
            "groupTitle": "Copy of topics"
          }
        }
      }
    }
  ],
  "output": {
    "id": "topics_2",
    "board_id": "111",
    "source_group_id": "topics",
    "title": "Copy of topics",
    "color": "#579bfc"
  }
}
