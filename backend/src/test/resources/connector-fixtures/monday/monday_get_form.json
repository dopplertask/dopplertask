{
  "package": "@activepieces/piece-monday",
  "version": "0.4.1",
  "action": "monday_get_form",
  "auth": {
    "type": "SECRET_TEXT",
    "secret_text": "mon-test-token"
  },
  "inputs": {
    "form_token": "https://forms.monday.com/forms/abc123?r=use1"
  },
  "credential": {
    "token": "mon-test-token"
  },
  "answers": [
    {
      "status": 200,
      "body": {
        "data": {
          "form": {
            "id": 77,
            "title": "Feedback",
            "description": null,
            "active": true,
            "isAnonymous": false,
            "ownerId": 5,
            "questions": [
              {
                "id": "q1",
                "title": "Name",
                "type": "ShortText",
                "required": true,
                "visible": true
              }
            ]
          }
        },
        "account_id": 9001
      }
    }
  ],
  "exchanges": [
    {
      "request": {
        "method": "POST",
        "url": "https://api.monday.com/v2",
        "headers": {
          "api-version": "2026-07",
          "authorization": "mon-test-token",
          "content-type": "application/json"
        },
        "body": {
          "query": "query ($formToken: String!) {\n        form(formToken: $formToken) {\n          id\n          title\n          description\n          active\n          isAnonymous\n          ownerId\n          questions { id title type required visible }\n        }\n      }",
          "variables": {
            "formToken": "abc123"
          }
        }
      }
    }
  ],
  "output": {
    "id": "77",
    "title": "Feedback",
    "description": null,
    "active": true,
    "is_anonymous": false,
    "owner_id": "5",
    "question_count": 1,
    "questions": [
      {
        "id": "q1",
        "title": "Name",
        "type": "ShortText",
        "required": true,
        "visible": true
      }
    ]
  }
}
