{
  "package": "@activepieces/piece-monday",
  "version": "0.4.1",
  "action": "monday_duplicate_board",
  "auth": {
    "type": "SECRET_TEXT",
    "secret_text": "mon-test-token"
  },
  "inputs": {
    "board_id": "111",
    "duplicate_type": "duplicate_board_with_pulses",
    "board_name": "Copy",
    "workspace_id": "9",
    "folder_id": "10",
    "keep_subscribers": true
  },
  "credential": {
    "token": "mon-test-token"
  },
  "answers": [
    {
      "status": 200,
      "body": {
        "data": {
          "duplicate_board": {
            "board": {
              "id": "112",
              "name": "Copy",
              "url": "https://acme.monday.com/boards/112",
              "workspace_id": null
            }
          }
        },
        "account_id": 9001
      }
    }
  ],
  "exchanges": [
    {
      "request": {
        "method": "POST",
        "url": "https://api.monday.com/v2",
        "headers": {
          "api-version": "2026-07",
          "authorization": "mon-test-token",
          "content-type": "application/json"
        },
        "body": {
          "query": "mutation ($board_id: ID!, $duplicate_type: DuplicateBoardType!, $board_name: String, $workspace_id: ID, $folder_id: ID, $keep_subscribers: Boolean) {\n        duplicate_board(board_id: $board_id, duplicate_type: $duplicate_type, board_name: $board_name, workspace_id: $workspace_id, folder_id: $folder_id, keep_subscribers: $keep_subscribers) {\n          board { id name url workspace_id }\n        }\n      }",
          "variables": {
            "board_id": "111",
            "duplicate_type": "duplicate_board_with_pulses",
            "board_name": "Copy",
            "workspace_id": "9",
            "folder_id": "10",
            "keep_subscribers": true
          }
        }
      }
    }
  ],
  "output": {
    "id": "112",
    "name": "Copy",
    "url": "https://acme.monday.com/boards/112",
    "workspace_id": null,
    "source_board_id": "111"
  }
}
