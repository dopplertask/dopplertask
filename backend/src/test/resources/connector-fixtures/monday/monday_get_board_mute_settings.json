{
  "package": "@activepieces/piece-monday",
  "version": "0.4.1",
  "action": "monday_get_board_mute_settings",
  "auth": {
    "type": "SECRET_TEXT",
    "secret_text": "mon-test-token"
  },
  "inputs": {
    "board_ids": [
      "111",
      "112"
    ]
  },
  "credential": {
    "token": "mon-test-token"
  },
  "answers": [
    {
      "status": 200,
      "body": {
        "data": {
          "mute_board_settings": [
            {
              "board_id": "111",
              "mute_state": "NOT_MUTED"
            },
            {
              "board_id": "112"
            }
          ]
        },
        "account_id": 9001
      }
    }
  ],
  "exchanges": [
    {
      "request": {
        "method": "POST",
        "url": "https://api.monday.com/v2",
        "headers": {
          "api-version": "2026-07",
          "authorization": "mon-test-token",
          "content-type": "application/json"
        },
        "body": {
          "query": "query ($boardIds: [ID!]!) {\n        mute_board_settings(board_ids: $boardIds) {\n          board_id\n          mute_state\n        }\n      }",
          "variables": {
            "boardIds": [
              "111",
              "112"
            ]
          }
        }
      }
    }
  ],
  "output": {
    "settings": [
      {
        "board_id": "111",
        "mute_state": "NOT_MUTED"
      },
      {
        "board_id": "112",
        "mute_state": null
      }
    ],
    "count": 2
  }
}
