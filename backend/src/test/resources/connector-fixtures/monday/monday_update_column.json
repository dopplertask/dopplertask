{
  "package": "@activepieces/piece-monday",
  "version": "0.4.1",
  "action": "monday_update_column",
  "auth": {
    "type": "SECRET_TEXT",
    "secret_text": "mon-test-token"
  },
  "inputs": {
    "board_id": "111",
    "column_id": "status",
    "title": "Stage",
    "description": "Where it is"
  },
  "credential": {
    "token": "mon-test-token"
  },
  "answers": [
    {
      "status": 200,
      "body": {
        "data": {
          "change_column_title": {
            "id": "status",
            "title": "Stage",
            "description": null
          }
        },
        "account_id": 9001
      }
    },
    {
      "status": 200,
      "body": {
        "data": {
          "change_column_metadata": {
            "id": "status",
            "title": "Stage",
            "description": "Where it is"
          }
        },
        "account_id": 9001
      }
    }
  ],
  "exchanges": [
    {
      "request": {
        "method": "POST",
        "url": "https://api.monday.com/v2",
        "headers": {
          "api-version": "2026-07",
          "authorization": "mon-test-token",
          "content-type": "application/json"
        },
        "body": {
          "query": "mutation ($boardId: ID!, $columnId: String!, $title: String!) {\n            change_column_title(board_id: $boardId, column_id: $columnId, title: $title) { id title description }\n          }",
          "variables": {
            "boardId": "111",
            "columnId": "status",
            "title": "Stage"
          }
        }
      }
    },
    {
      "request": {
        "method": "POST",
        "url": "https://api.monday.com/v2",
        "headers": {
          "api-version": "2026-07",
          "authorization": "mon-test-token",
          "content-type": "application/json"
        },
        "body": {
          "query": "mutation ($boardId: ID!, $columnId: String!, $value: String) {\n            change_column_metadata(board_id: $boardId, column_id: $columnId, column_property: description, value: $value) { id title description }\n          }",
          "variables": {
            "boardId": "111",
            "columnId": "status",
            "value": "Where it is"
          }
        }
      }
    }
  ],
  "output": {
    "id": "status",
    "board_id": "111",
    "title": "Stage",
    "description": "Where it is"
  }
}
