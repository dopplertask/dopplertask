{
  "package": "@activepieces/piece-reachinbox",
  "version": "0.2.2",
  "action": "add_leads",
  "auth": {
    "type": "SECRET_TEXT",
    "secret_text": "test-key"
  },
  "inputs": {
    "campaignId": "101",
    "email": "jane@example.com",
    "firstName": "Jane",
    "lastName": "Doe",
    "customVariables": [
      {
        "key": "company",
        "value": "Acme"
      },
      {
        "key": "city",
        "value": "Stockholm"
      }
    ]
  },
  "credential": {
    "apiKey": "test-key"
  },
  "answers": [
    {
      "status": 200,
      "body": {
        "success": true,
        "message": "Leads added",
        "leadCount": 1
      }
    }
  ],
  "exchanges": [
    {
      "request": {
        "method": "POST",
        "url": "https://api.reachinbox.ai/api/v1/leads/add",
        "headers": {
          "authorization": "Bearer test-key",
          "content-type": "application/json"
        },
        "body": {
          "campaignId": "101",
          "leads": [
            {
              "email": "jane@example.com",
              "firstName": "Jane",
              "lastName": "Doe",
              "company": "Acme",
              "city": "Stockholm"
            }
          ],
          "newCoreVariables": [
            "firstName",
            "company",
            "city"
          ],
          "duplicates": []
        }
      }
    }
  ],
  "output": {
    "success": true,
    "message": "Leads added",
    "leadCount": 1
  }
}
