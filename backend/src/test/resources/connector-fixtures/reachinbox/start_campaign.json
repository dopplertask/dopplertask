{
  "package": "@activepieces/piece-reachinbox",
  "version": "0.2.2",
  "action": "start_campaign",
  "auth": {
    "type": "SECRET_TEXT",
    "secret_text": "test-key"
  },
  "inputs": {
    "campaignId": 101
  },
  "credential": {
    "apiKey": "test-key"
  },
  "answers": [
    {
      "status": 200,
      "body": {
        "status": 200,
        "message": "Campaign started"
      }
    }
  ],
  "exchanges": [
    {
      "request": {
        "method": "POST",
        "url": "https://api.reachinbox.ai/api/v1/campaigns/start",
        "headers": {
          "authorization": "Bearer test-key",
          "content-type": "application/json"
        },
        "body": {
          "campaignId": 101
        }
      }
    }
  ],
  "output": {
    "success": true,
    "message": "Campaign started"
  }
}
