{
  "package": "@activepieces/piece-reachinbox",
  "version": "0.2.2",
  "action": "update_lead",
  "auth": {
    "type": "SECRET_TEXT",
    "secret_text": "test-key"
  },
  "inputs": {
    "campaignId": 101,
    "leadId": "lead-7",
    "email": "jane.new@example.com",
    "firstName": "Jane",
    "lastName": "Doe",
    "customVariables": [
      {
        "key": "company",
        "value": "Acme"
      },
      {
        "key": "city",
        "value": "Stockholm"
      }
    ]
  },
  "credential": {
    "apiKey": "test-key"
  },
  "answers": [
    {
      "status": 200,
      "body": {
        "status": 200,
        "message": "Lead updated"
      }
    }
  ],
  "exchanges": [
    {
      "request": {
        "method": "PUT",
        "url": "https://api.reachinbox.ai/api/v1/leads/update",
        "headers": {
          "authorization": "Bearer test-key",
          "content-type": "application/json"
        },
        "body": {
          "campaignId": 101,
          "leadId": "lead-7",
          "email": "jane.new@example.com",
          "attributes": {
            "firstName": "Jane",
            "lastName": "Doe",
            "company": "Acme",
            "city": "Stockholm"
          }
        }
      }
    }
  ],
  "output": {
    "success": true,
    "message": "Lead updated"
  }
}
