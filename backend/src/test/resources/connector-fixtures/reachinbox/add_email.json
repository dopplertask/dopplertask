{
  "package": "@activepieces/piece-reachinbox",
  "version": "0.2.2",
  "action": "add_email",
  "auth": {
    "type": "SECRET_TEXT",
    "secret_text": "test-key"
  },
  "inputs": {
    "campaignId": 101,
    "email": "sender@example.com"
  },
  "credential": {
    "apiKey": "test-key"
  },
  "answers": [
    {
      "status": 200,
      "body": {
        "status": 200,
        "message": "Email added"
      }
    }
  ],
  "exchanges": [
    {
      "request": {
        "method": "POST",
        "url": "https://api.reachinbox.ai/api/v1/campaigns/add-email",
        "headers": {
          "authorization": "Bearer test-key",
          "content-type": "application/json"
        },
        "body": {
          "campaignId": 101,
          "email": "sender@example.com"
        }
      }
    }
  ],
  "output": {
    "success": true,
    "message": "Email added"
  }
}
