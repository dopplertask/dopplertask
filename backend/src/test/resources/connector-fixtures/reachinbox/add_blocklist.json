{
  "package": "@activepieces/piece-reachinbox",
  "version": "0.2.2",
  "action": "add_blocklist",
  "auth": {
    "type": "SECRET_TEXT",
    "secret_text": "test-key"
  },
  "inputs": {
    "emails": [
      "spam@example.com"
    ],
    "domains": [
      "bad.example"
    ],
    "keywords": [
      "casino"
    ]
  },
  "credential": {
    "apiKey": "test-key"
  },
  "answers": [
    {
      "status": 200,
      "body": {
        "status": 200,
        "message": "Blocklist updated"
      }
    }
  ],
  "exchanges": [
    {
      "request": {
        "method": "POST",
        "url": "https://api.reachinbox.ai/api/v1/blocklist/add",
        "headers": {
          "authorization": "Bearer test-key",
          "content-type": "application/json"
        },
        "body": {
          "emails": [
            "spam@example.com"
          ],
          "domains": [
            "bad.example"
          ],
          "keywords": [
            "casino"
          ]
        }
      }
    }
  ],
  "output": {
    "success": true,
    "message": "Blocklist updated"
  }
}
