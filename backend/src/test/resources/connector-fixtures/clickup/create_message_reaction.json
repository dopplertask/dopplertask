{
  "package": "@activepieces/piece-clickup",
  "version": "0.10.1",
  "action": "create_message_reaction",
  "auth": {
    "access_token": "test-token",
    "data": {}
  },
  "inputs": {
    "workspace_id": "9001",
    "message_id": "m1",
    "emoji": "tada"
  },
  "credential": {
    "oauthAccessToken": "test-token"
  },
  "answers": [
    {
      "status": 201,
      "body": {
