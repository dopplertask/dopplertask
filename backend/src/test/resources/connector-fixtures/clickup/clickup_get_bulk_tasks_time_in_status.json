{
  "package": "@activepieces/piece-clickup",
  "version": "0.10.1",
  "action": "clickup_get_bulk_tasks_time_in_status",
  "auth": {
    "access_token": "test-token",
    "data": {}
  },
  "inputs": {
    "task_ids": [
      "t1",
      "t2"
    ]
  },
  "credential": {
    "oauthAccessToken": "test-token"
  },
  "answers": [
