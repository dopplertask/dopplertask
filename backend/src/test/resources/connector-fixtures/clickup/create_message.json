{
  "package": "@activepieces/piece-clickup",
  "version": "0.10.1",
  "action": "create_message",
  "auth": {
    "access_token": "test-token",
    "data": {}
  },
  "inputs": {
    "workspace_id": "9001",
    "channel_id": "ch1",
    "content": "Hello team",
    "type": "message"
  },
  "credential": {
    "oauthAccessToken": "test-token"
  },
  "answers": [
    {
      "status": 201,
      "body": {
        "id": "m1",
        "content": "Hello team"
      }
    }
  ],
  "exchanges": [
    {
      "request": {
        "method": "POST",
        "url": "https://api.clickup.com/api/v3/workspaces/9001/chat/channels/ch1/messages",
        "headers": {
          "authorization": "Bearer test-token",
          "content-type": "application/json"
        },
        "body": {
          "content": "Hello team",
          "type": "message"
        }
      }
    }
  ],
  "output": {
    "id": "m1",
    "content": "Hello team"
  }
}
