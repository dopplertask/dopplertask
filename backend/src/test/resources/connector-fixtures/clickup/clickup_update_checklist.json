{
  "package": "@activepieces/piece-clickup",
  "version": "0.10.1",
  "action": "clickup_update_checklist",
  "auth": {
    "access_token": "test-token",
    "data": {}
  },
  "inputs": {
    "checklist_id": "cl1",
    "name": "Launch",
    "position": 1
  },
  "credential": {
    "oauthAccessToken": "test-token"
  },
  "answers": [
    {
      "status": 200,
      "body": {
        "checklist": {
          "id": "cl1"
        }
      }
    }
  ],
  "exchanges": [
    {
      "request": {
        "method": "PUT",
        "url": "https://api.clickup.com/api/v2/checklist/cl1",
        "headers": {
          "authorization": "Bearer test-token",
          "content-type": "application/json"
        },
        "body": {
          "name": "Launch",
          "position": 1
        }
      }
    }
  ],
  "output": {
    "checklist": {
      "id": "cl1"
    }
  }
}
