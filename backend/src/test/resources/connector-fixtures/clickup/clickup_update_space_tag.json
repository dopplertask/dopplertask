{
  "package": "@activepieces/piece-clickup",
  "version": "0.10.1",
  "action": "clickup_update_space_tag",
  "auth": {
    "access_token": "test-token",
    "data": {}
  },
  "inputs": {
    "workspace_id": "9001",
    "space_id": "s1",
    "tag_name": "needs review",
    "new_name": "review",
    "tag_fg": "#000000",
    "tag_bg": "#FFEB3B"
  },
  "credential": {
    "oauthAccessToken": "test-token"
  },
  "answers": [
    {
      "status": 200,
      "body": {
        "tag": {
          "name": "review"
        }
      }
    }
  ],
  "exchanges": [
    {
      "request": {
        "method": "PUT",
        "url": "https://api.clickup.com/api/v2/space/s1/tag/needs%20review",
        "headers": {
          "authorization": "Bearer test-token",
          "content-type": "application/json"
        },
        "body": {
          "tag": {
            "name": "review",
            "tag_fg": "#000000",
            "tag_bg": "#FFEB3B"
          }
        }
      }
    }
  ],
  "output": {
    "tag": {
      "name": "review"
    }
  }
}
