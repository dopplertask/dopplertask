{
  "package": "@activepieces/piece-clickup",
  "version": "0.10.1",
  "action": "clickup_create_checklist",
  "auth": {
    "access_token": "test-token",
    "data": {}
  },
  "inputs": {
    "workspace_id": "9001",
    "space_id": "s1",
    "list_id": "l1",
    "task_id": "t1",
    "name": "Release"
  },
  "credential": {
    "oauthAccessToken": "test-token"
  },
  "answers": [
    {
      "status": 200,
      "body": {
        "checklist": {
          "id": "cl1",
          "name": "Release"
        }
      }
    }
  ],
  "exchanges": [
    {
      "request": {
        "method": "POST",
        "url": "https://api.clickup.com/api/v2/task/t1/checklist",
        "headers": {
          "authorization": "Bearer test-token",
          "content-type": "application/json"
        },
        "body": {
          "name": "Release"
        }
      }
    }
  ],
  "output": {
    "checklist": {
      "id": "cl1",
      "name": "Release"
    }
  }
}
