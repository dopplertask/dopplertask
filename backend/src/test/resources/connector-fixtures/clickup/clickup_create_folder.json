{
  "package": "@activepieces/piece-clickup",
  "version": "0.10.1",
  "action": "clickup_create_folder",
  "auth": {
    "access_token": "test-token",
    "data": {}
  },
  "inputs": {
    "workspace_id": "9001",
    "space_id": "s1",
    "name": "Campaigns"
  },
  "credential": {
    "oauthAccessToken": "test-token"
  },
  "answers": [
    {
      "status": 200,
      "body": {
        "id": "f1",
        "name": "Campaigns"
      }
    }
  ],
  "exchanges": [
    {
      "request": {
        "method": "POST",
        "url": "https://api.clickup.com/api/v2/space/s1/folder",
        "headers": {
          "authorization": "Bearer test-token",
          "content-type": "application/json"
        },
        "body": {
          "name": "Campaigns"
        }
      }
    }
  ],
  "output": {
    "id": "f1",
    "name": "Campaigns"
  }
}
