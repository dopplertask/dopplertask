{
  "package": "@activepieces/piece-clickup",
  "version": "0.10.1",
  "action": "clickup_update_folder",
  "auth": {
    "access_token": "test-token",
    "data": {}
  },
  "inputs": {
    "folder_id": "f1",
    "name": "Campaigns 2026"
  },
  "credential": {
    "oauthAccessToken": "test-token"
