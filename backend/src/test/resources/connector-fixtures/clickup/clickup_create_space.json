{
  "package": "@activepieces/piece-clickup",
  "version": "0.10.1",
  "action": "clickup_create_space",
  "auth": {
    "access_token": "test-token",
    "data": {}
  },
  "inputs": {
    "workspace_id": "9001",
    "name": "Sales",
    "multiple_assignees": false
  },
  "credential": {
    "oauthAccessToken": "test-token"
  },
  "answers": [
    {
      "status": 200,
      "body": {
        "id": "s2",
        "name": "Sales"
      }
    }
  ],
  "exchanges": [
    {
      "request": {
        "method": "POST",
        "url": "https://api.clickup.com/api/v2/team/9001/space",
        "headers": {
          "authorization": "Bearer test-token",
          "content-type": "application/json"
        },
        "body": {
          "name": "Sales",
          "multiple_assignees": false
        }
      }
    }
  ],
  "output": {
    "id": "s2",
    "name": "Sales"
  }
}
