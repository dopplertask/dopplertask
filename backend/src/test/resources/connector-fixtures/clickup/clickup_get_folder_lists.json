{
  "package": "@activepieces/piece-clickup",
  "version": "0.10.1",
  "action": "clickup_get_folder_lists",
  "auth": {
    "access_token": "test-token",
    "data": {}
  },
  "inputs": {
    "workspace_id": "9001",
    "space_id": "s1",
    "folder_id": "f1"
  },
  "credential": {
    "oauthAccessToken": "test-token"
  },
  "answers": [
    {
      "status": 200,
      "body": {
        "lists": [
          {
            "id": "l1"
          }
        ]
      }
    }
  ],
  "exchanges": [
    {
      "request": {
        "method": "GET",
        "url": "https://api.clickup.com/api/v2/folder/f1/list",
        "headers": {
          "authorization": "Bearer test-token"
        },
        "body": null
      }
    }
  ],
  "output": {
    "lists": [
      {
        "id": "l1"
      }
    ]
  }
}
