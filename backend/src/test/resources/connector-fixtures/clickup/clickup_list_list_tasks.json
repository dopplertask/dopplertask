{
  "package": "@activepieces/piece-clickup",
  "version": "0.10.1",
  "action": "clickup_list_list_tasks",
  "auth": {
    "access_token": "test-token",
    "data": {}
  },
  "inputs": {
    "workspace_id": "9001",
    "space_id": "s1",
    "list_id": "l1",
    "page": 1,
    "reverse": true,
    "include_closed": false,
    "subtasks": true,
    "order_by": "due_date"
  },
  "credential": {
    "oauthAccessToken": "test-token"
  },
  "answers": [
    {
      "status": 200,
      "body": {
        "tasks": [
          {
            "id": "t1",
            "name": "Write report",
            "status": {
              "status": "to do"
            },
            "url": "https://app.clickup.com/t/t1"
          }
        ]
      }
    }
  ],
  "exchanges": [
    {
      "request": {
        "method": "GET",
        "url": "https://api.clickup.com/api/v2/list/l1/task?page=1&reverse=true&include_closed=false&subtasks=true&order_by=due_date",
        "headers": {
          "authorization": "Bearer test-token",
          "content-type": "application/json"
        },
        "body": null
      }
    }
  ],
  "output": {
    "tasks": [
      {
        "id": "t1",
        "name": "Write report",
        "status": {
          "status": "to do"
        },
        "url": "https://app.clickup.com/t/t1"
      }
    ]
  }
}
