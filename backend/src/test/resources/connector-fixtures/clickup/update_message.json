{
  "package": "@activepieces/piece-clickup",
  "version": "0.10.1",
  "action": "update_message",
  "auth": {
    "access_token": "test-token",
    "data": {}
  },
  "inputs": {
    "workspace_id": "9001",
    "message_id": "m1",
    "content": "Hello all",
    "content_format": "text/md"
  },
  "credential": {
    "oauthAccessToken": "test-token"
  },
  "answers": [
    {
      "status": 200,
      "body": {
        "id": "m1",
        "content": "Hello all"
      }
    }
  ],
  "exchanges": [
    {
      "request": {
        "method": "PATCH",
        "url": "https://api.clickup.com/api/v3/workspaces/9001/chat/messages/m1",
        "headers": {
          "authorization": "Bearer test-token",
          "content-type": "application/json"
        },
        "body": {
          "content": "Hello all",
          "content_format": "text/md"
        }
      }
    }
  ],
  "output": {
    "id": "m1",
    "content": "Hello all"
  }
}
