{
  "package": "@activepieces/piece-clickup",
  "version": "0.10.1",
  "action": "clickup_update_space",
  "auth": {
    "access_token": "test-token",
    "data": {}
  },
  "inputs": {
    "workspace_id": "9001",
    "space_id": "s1",
    "name": "Sales EU",
    "multiple_assignees": "unchanged"
  },
  "credential": {
    "oauthAccessToken": "test-token"
  },
  "answers": [
    {
      "status": 200,
      "body": {
        "id": "s1",
        "multiple_assignees": true
      }
    },
    {
      "status": 200,
      "body": {
        "id": "s1",
        "name": "Sales EU"
      }
    }
  ],
  "exchanges": [
    {
      "request": {
        "method": "GET",
        "url": "https://api.clickup.com/api/v2/space/s1",
        "headers": {
          "authorization": "Bearer test-token"
        },
        "body": null
      }
    },
    {
      "request": {
        "method": "PUT",
        "url": "https://api.clickup.com/api/v2/space/s1",
        "headers": {
          "authorization": "Bearer test-token",
          "content-type": "application/json"
        },
        "body": {
          "multiple_assignees": true,
          "name": "Sales EU"
        }
      }
    }
  ],
  "output": {
    "id": "s1",
    "name": "Sales EU"
  }
}
