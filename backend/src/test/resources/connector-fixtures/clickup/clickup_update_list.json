{
  "package": "@activepieces/piece-clickup",
  "version": "0.10.1",
  "action": "clickup_update_list",
  "auth": {
    "access_token": "test-token",
    "data": {}
  },
  "inputs": {
    "list_id": "l1",
    "name": "Sprint 2",
    "content": "Next sprint"
  },
  "credential": {
    "oauthAccessToken": "test-token"
  },
  "answers": [
    {
      "status": 200,
      "body": {
        "id": "l1"
      }
    }
  ],
  "exchanges": [
    {
      "request": {
        "method": "PUT",
        "url": "https://api.clickup.com/api/v2/list/l1",
        "headers": {
          "authorization": "Bearer test-token",
          "content-type": "application/json"
        },
        "body": {
          "name": "Sprint 2",
          "content": "Next sprint"
        }
      }
    }
  ],
  "output": {
    "id": "l1"
  }
}
