{
  "package": "@activepieces/piece-outseta",
  "version": "0.3.3",
  "action": "add_discount_to_subscription",
  "auth": {
    "type": "CUSTOM_AUTH",
    "props": {
      "domain": "https://credential000z.example.com",
      "apiKey": "credential001z",
      "apiSecret": "credential002z"
    }
  },
  "inputs": {
    "accountUid": "sample000z",
    "discountUid": "sample001z"
  },
  "credential": {
    "domain": "credential000z.example.com",
    "apiKey": "credential001z",
    "apiSecret": "credential002z"
  },
  "answers": [
    {
      "status": 200,
      "body": {}
    }
  ],
  "exchanges": [
    {
      "request": {
        "method": "GET",
        "url": "https://credential000z.example.com/api/v1/crm/accounts/sample000z?fields=CurrentSubscription.*",
        "headers": {
          "authorization": "Outseta credential001z:credential002z",
          "content-type": "application/json"
        },
        "body": null
      }
    }
  ],
  "output": {
    "error": "Account sample000z does not have an active subscription."
  }
