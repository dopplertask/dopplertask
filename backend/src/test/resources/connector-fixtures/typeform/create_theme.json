{
  "package": "@activepieces/piece-typeform",
  "version": "0.7.1",
  "action": "create_theme",
  "auth": {
    "access_token": "test-token",
    "data": {}
  },
  "inputs": {
    "name": " Brand ",
    "font": "Lato",
    "questionColor": "#3D3D3D",
    "answerColor": " #111111 ",
    "buttonColor": "#222222",
    "backgroundColor": "#FFFFFF",
    "fieldAlignment": "center",
    "fieldFontSize": "large",
    "screenAlignment": "center",
    "screenFontSize": "small"
  },
  "credential": {
    "oauthAccessToken": "test-token"
  },
  "answers": [
    {
      "status": 200,
      "body": {
        "id": "T3",
        "name": "Brand"
      }
    }
  ],
  "exchanges": [
    {
      "request": {
        "method": "POST",
        "url": "https://api.typeform.com/themes",
        "headers": {
          "authorization": "Bearer test-token",
          "content-type": "application/json"
        },
        "body": {
          "name": "Brand",
          "font": "Lato",
          "colors": {
            "question": "#3D3D3D",
            "answer": "#111111",
            "button": "#222222",
            "background": "#FFFFFF"
          },
          "fields": {
            "alignment": "center",
            "font_size": "large"
          },
          "screens": {
            "alignment": "center",
            "font_size": "small"
          }
        }
      }
    }
  ],
  "output": {
    "id": "T3",
    "name": "Brand"
  }
}
