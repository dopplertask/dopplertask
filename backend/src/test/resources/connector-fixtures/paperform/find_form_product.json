{
  "package": "@activepieces/piece-paperform",
  "version": "0.2.1",
  "action": "find_form_product",
  "auth": {
    "type": "SECRET_TEXT",
    "secret_text": "test-key"
  },
  "inputs": {
    "formId": "form-1",
    "search": "T-Shirt"
  },
  "credential": {
    "apiKey": "test-key"
  },
  "answers": [
    {
      "status": 200,
      "body": {
        "status": "ok",
        "results": {
          "products": [
            {
              "name": "T-Shirt",
              "price": 25,
              "quantity": 100,
              "minimum": 1,
              "maximum": 5,
              "discountable": true,
              "images": [
                {
                  "url": "https://example.com/shirt.png",
                  "width": 600,
                  "height": 400
                }
              ],
              "SKU": "TSHIRT-1"
            }
          ]
        },
        "total": 1,
        "has_more": false,
        "limit": 100,
        "skip": 0
      }
    }
  ],
  "exchanges": [
    {
      "request": {
        "method": "GET",
        "url": "https://api.paperform.co/v1/forms/form-1/products?search=T-Shirt&limit=100",
        "headers": {
          "authorization": "Bearer test-key",
          "content-type": "application/json"
        },
        "body": null
      }
    }
  ],
  "output": {
    "found": true,
    "data": [
      {
        "name": "T-Shirt",
        "price": 25,
        "quantity": 100,
        "minimum": 1,
        "maximum": 5,
        "discountable": true,
        "images": [
          {
            "url": "https://example.com/shirt.png",
            "width": 600,
            "height": 400
          }
        ],
        "SKU": "TSHIRT-1"
      }
    ]
