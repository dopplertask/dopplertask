{
  "package": "@activepieces/piece-paperform",
  "version": "0.2.1",
  "action": "create_form_product",
  "auth": {
    "type": "SECRET_TEXT",
    "secret_text": "test-key"
  },
  "inputs": {
    "formId": "form-1",
    "productFieldKey": "abc12",
    "name": "T-Shirt",
    "sku": "TSHIRT-1",
    "price": 25,
    "quantity": 100,
    "minimum": 1,
    "maximum": 5,
    "discountable": true,
    "imageUrl": "https://example.com/shirt.png",
    "imageWidth": 600,
    "imageHeight": 400
  },
  "credential": {
    "apiKey": "test-key"
  },
  "answers": [
    {
      "status": 200,
      "body": {
        "status": "ok",
        "results": {
          "product": {
            "name": "T-Shirt",
            "price": 25,
            "quantity": 100,
            "minimum": 1,
            "maximum": 5,
            "discountable": true,
            "images": [
              {
                "url": "https://example.com/shirt.png",
                "width": 600,
                "height": 400
              }
            ],
            "SKU": "TSHIRT-1"
          }
        }
      }
    }
  ],
  "exchanges": [
    {
      "request": {
        "method": "POST",
        "url": "https://api.paperform.co/v1/forms/form-1/products",
        "headers": {
          "authorization": "Bearer test-key",
          "content-type": "application/json"
        },
        "body": {
          "product_field_key": "abc12",
          "name": "T-Shirt",
          "price": 25,
          "SKU": "TSHIRT-1",
          "quantity": 100,
          "minimum": 1,
          "maximum": 5,
          "discountable": true,
          "images": [
            {
              "url": "https://example.com/shirt.png",
              "width": 600,
              "height": 400
            }
          ]
        }
      }
    }
  ],
  "output": {
    "name": "T-Shirt",
    "price": 25,
    "quantity": 100,
    "minimum": 1,
    "maximum": 5,
    "discountable": true,
    "images": [
      {
        "url": "https://example.com/shirt.png",
        "width": 600,
        "height": 400
      }
    ],
    "SKU": "TSHIRT-1"
  }
}
