{
  "package": "@activepieces/piece-paperform",
  "version": "0.2.1",
  "trigger": "new_form_submission",
  "webhook": true,
  "auth": {
    "type": "SECRET_TEXT",
    "secret_text": "test-key"
  },
  "inputs": {
    "formId": "form_1"
  },
  "credential": {
    "apiKey": "test-key"
  },
  "answers": [
    {
      "status": 200,
      "body": {
        "results": {
          "webhook": {
            "id": "hook_42",
            "target_url": "https://tasks.example.com/hooks/test-key"
          }
        }
      }
    },
    {
      "status": 200,
      "body": {
        "results": {
          "submission": {
            "id": "sub_1",
            "form_id": "form_1",
            "data": {
              "abc1": "Ada",
              "abc2": "ada@example.com",
              "abc3": "x",
              "zzz": 1
            },
            "created_at": "2026-01-02 10:00:00"
          }
        }
      }
    },
    {
      "status": 200,
      "body": {
        "results": {
          "fields": [
            {
              "key": "abc1",
              "title": "Name"
            },
            {
              "key": "abc2",
              "title": "Email"
            },
            {
              "key": "abc3"
            }
          ]
        }
      }
    }
  ],
  "event": {
    "submission_id": "sub_1",
    "form_id": "form_1"
  },
  "exchanges": [
    {
      "request": {
        "method": "POST",
        "url": "https://api.paperform.co/v1/forms/form_1/webhooks",
        "headers": {
          "authorization": "Bearer test-key",
          "content-type": "application/json"
        },
        "body": {
          "target_url": "https://tasks.example.com/hooks/test-key",
          "triggers": [
            "submission"
          ]
        }
      }
    },
    {
      "request": {
        "method": "GET",
        "url": "https://api.paperform.co/v1/submissions/sub_1",
        "headers": {
          "authorization": "Bearer test-key",
          "content-type": "application/json"
        },
        "body": null
      }
    },
    {
      "request": {
        "method": "GET",
        "url": "https://api.paperform.co/v1/forms/form_1/fields",
        "headers": {
          "authorization": "Bearer test-key",
          "content-type": "application/json"
        },
        "body": null
      }
    }
  ],
  "output": [
    {
      "id": "sub_1",
      "form_id": "form_1",
      "data": {
        "Name": "Ada",
        "Email": "ada@example.com",
        "abc3": "x",
        "zzz": 1
      },
      "created_at": "2026-01-02 10:00:00"
    }
  ]
}
