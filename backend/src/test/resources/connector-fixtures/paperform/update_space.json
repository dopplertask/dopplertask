{
  "package": "@activepieces/piece-paperform",
  "version": "0.2.1",
  "action": "update_space",
  "auth": {
    "type": "SECRET_TEXT",
    "secret_text": "test-key"
  },
  "inputs": {
    "spaceId": "12",
    "name": "Sales"
  },
  "credential": {
    "apiKey": "test-key"
  },
  "answers": [
    {
      "status": 200,
      "body": {
        "status": "ok",
        "results": {
          "space": {
            "id": 12,
            "name": "Sales"
          }
        }
      }
    }
  ],
  "exchanges": [
    {
      "request": {
        "method": "PUT",
        "url": "https://api.paperform.co/v1/spaces/12",
        "headers": {
          "authorization": "Bearer test-key",
          "content-type": "application/json"
        },
        "body": {
          "name": "Sales"
        }
      }
    }
  ],
  "output": {
    "id": 12,
    "name": "Sales"
  }
}
