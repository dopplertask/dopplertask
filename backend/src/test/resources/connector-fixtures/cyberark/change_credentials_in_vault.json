{
  "package": "@activepieces/piece-cyberark",
  "version": "0.1.8",
  "action": "change_credentials_in_vault",
  "auth": {
    "props": {
      "serverUrl": "https://pvwa.example.com",
      "username": "vault-admin",
      "password": "test-password"
    }
  },
  "credential": {
    "serverUrl": "https://pvwa.example.com",
    "username": "vault-admin",
    "password": "test-password"
  },
  "inputs": {
    "accountId": "12_3",
    "newCredentials": "New-Pass-2"
  },
  "answers": [
    {
      "status": 200,
      "body": "\"test-session-token\""
    },
    {
      "status": 200,
      "body": ""
    }
  ],
  "exchanges": [
    {
      "request": {
        "method": "POST",
        "url": "https://pvwa.example.com/PasswordVault/API/auth/Cyberark/Logon/",
        "headers": {
          "content-type": "application/json"
        },
        "body": {
          "username": "vault-admin",
          "password": "test-password"
        }
      }
    },
    {
      "request": {
        "method": "POST",
        "url": "https://pvwa.example.com/PasswordVault/API/Accounts/12_3/Password/Update/",
        "headers": {
          "authorization": "test-session-token",
          "content-type": "application/json"
        },
        "body": {
          "NewCredentials": "New-Pass-2"
        }
      }
    }
  ],
  "output": {
    "success": true
  }
}
