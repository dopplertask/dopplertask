{
  "package": "@activepieces/piece-cyberark",
  "version": "0.1.8",
  "action": "set_next_password_bulk",
  "auth": {
    "props": {
      "serverUrl": "https://pvwa.example.com",
      "username": "vault-admin",
      "password": "test-password"
    }
  },
  "credential": {
    "serverUrl": "https://pvwa.example.com",
    "username": "vault-admin",
    "password": "test-password"
  },
  "inputs": {
    "bulkItems": [
      {
        "accountId": "12_3",
        "changeImmediately": true,
        "newCredentials": "Next-Pass-1"
      },
      "{\"accountId\":\"12_4\"}"
    ]
  },
  "answers": [
    {
      "status": 200,
      "body": "\"test-session-token\""
    },
    {
      "status": 200,
      "body": {
        "BulkActionId": "bulk-4"
      }
    }
  ],
  "exchanges": [
    {
      "request": {
        "method": "POST",
        "url": "https://pvwa.example.com/PasswordVault/API/auth/Cyberark/Logon/",
        "headers": {
          "content-type": "application/json"
        },
        "body": {
          "username": "vault-admin",
          "password": "test-password"
        }
      }
    },
    {
      "request": {
        "method": "POST",
        "url": "https://pvwa.example.com/PasswordVault/API/Accounts/SetNextPassword/Bulk",
        "headers": {
          "authorization": "test-session-token",
          "content-type": "application/json"
        },
        "body": {
          "bulkItems": [
            {
              "accountId": "12_3",
              "changeImmediately": true,
              "newCredentials": "Next-Pass-1"
            },
            {
              "accountId": "12_4"
            }
          ]
        }
      }
    }
  ],
  "output": {
    "success": true,
    "details": {
      "BulkActionId": "bulk-4"
    }
  }
}
