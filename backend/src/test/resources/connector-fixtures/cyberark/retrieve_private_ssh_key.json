{
  "package": "@activepieces/piece-cyberark",
  "version": "0.1.8",
  "action": "retrieve_private_ssh_key",
  "auth": {
    "props": {
      "serverUrl": "https://pvwa.example.com",
      "username": "vault-admin",
      "password": "test-password"
    }
  },
  "credential": {
    "serverUrl": "https://pvwa.example.com",
    "username": "vault-admin",
    "password": "test-password"
  },
  "inputs": {
    "accountId": "12_3",
    "reason": "Deploy",
    "actionType": "download",
    "isUse": true
  },
  "answers": [
    {
      "status": 200,
      "body": "\"test-session-token\""
    },
    {
      "status": 200,
      "body": "\"-----BEGIN OPENSSH PRIVATE KEY-----\\nZmFrZQ==\\n-----END OPENSSH PRIVATE KEY-----\""
    }
  ],
  "exchanges": [
    {
      "request": {
        "method": "POST",
        "url": "https://pvwa.example.com/PasswordVault/API/auth/Cyberark/Logon/",
        "headers": {
          "content-type": "application/json"
        },
        "body": {
          "username": "vault-admin",
          "password": "test-password"
        }
      }
    },
    {
      "request": {
        "method": "POST",
        "url": "https://pvwa.example.com/PasswordVault/API/Accounts/12_3/Secret/Retrieve/",
        "headers": {
          "authorization": "test-session-token",
          "content-type": "application/json"
        },
        "body": {
          "reason": "Deploy",
          "ActionType": "download",
          "isUse": true
        }
      }
    }
  ],
  "output": {
    "success": true,
    "sshKey": "-----BEGIN OPENSSH PRIVATE KEY-----\nZmFrZQ==\n-----END OPENSSH PRIVATE KEY-----"
  }
}
