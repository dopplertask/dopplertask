{
  "package": "@activepieces/piece-cyberark",
  "version": "0.1.8",
  "action": "add_member_to_group",
  "auth": {
    "props": {
      "serverUrl": "https://pvwa.example.com",
      "username": "vault-admin",
      "password": "test-password"
    }
  },
  "credential": {
    "serverUrl": "https://pvwa.example.com",
    "username": "vault-admin",
    "password": "test-password"
  },
  "inputs": {
    "groupId": "7",
    "memberId": "jane.doe",
    "memberType": "domain",
    "domainName": "corp.example.com"
  },
  "answers": [
    {
      "status": 200,
      "body": "\"test-session-token\""
    },
    {
      "status": 201,
      "body": {
        "memberId": "jane.doe",
        "memberType": "domain"
      }
    }
  ],
  "exchanges": [
    {
      "request": {
        "method": "POST",
        "url": "https://pvwa.example.com/PasswordVault/API/auth/Cyberark/Logon/",
        "headers": {
          "content-type": "application/json"
        },
        "body": {
          "username": "vault-admin",
          "password": "test-password"
        }
      }
    },
    {
      "request": {
        "method": "POST",
        "url": "https://pvwa.example.com/PasswordVault/API/UserGroups/7/Members/",
        "headers": {
          "authorization": "test-session-token",
          "content-type": "application/json"
        },
        "body": {
          "memberId": "jane.doe",
          "memberType": "domain",
          "domainName": "corp.example.com"
        }
      }
    }
  ],
  "output": {
    "success": true,
    "member": {
      "memberId": "jane.doe",
      "memberType": "domain"
    },
    "message": "Successfully added jane.doe to group 7"
  }
}
