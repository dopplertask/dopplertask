{
  "package": "@activepieces/piece-cyberark",
  "version": "0.1.8",
  "action": "get_password_value",
  "auth": {
    "props": {
      "serverUrl": "https://pvwa.example.com",
      "username": "vault-admin",
      "password": "test-password"
    }
  },
  "credential": {
    "serverUrl": "https://pvwa.example.com",
    "username": "vault-admin",
    "password": "test-password"
  },
  "inputs": {
    "accountId": "12_3",
    "reason": "Incident INC-1",
    "ticketingSystemName": "ServiceNow",
    "ticketId": "INC-1",
    "version": 0,
    "actionType": "show",
    "isUse": false,
    "machine": "host1.example.com"
  },
  "answers": [
    {
      "status": 200,
      "body": "\"test-session-token\""
    },
    {
      "status": 200,
      "body": "\"s3cr3t-value\""
    }
  ],
  "exchanges": [
    {
      "request": {
        "method": "POST",
        "url": "https://pvwa.example.com/PasswordVault/API/auth/Cyberark/Logon/",
        "headers": {
          "content-type": "application/json"
        },
        "body": {
          "username": "vault-admin",
          "password": "test-password"
        }
      }
    },
    {
      "request": {
        "method": "POST",
        "url": "https://pvwa.example.com/PasswordVault/API/Accounts/12_3/Password/Retrieve/",
        "headers": {
          "authorization": "test-session-token",
          "content-type": "application/json"
        },
        "body": {
          "reason": "Incident INC-1",
          "TicketingSystemName": "ServiceNow",
          "TicketId": "INC-1",
          "Version": 0,
          "ActionType": "show",
          "isUse": false,
          "Machine": "host1.example.com"
        }
      }
    }
  ],
  "output": {
    "success": true,
    "password": "s3cr3t-value"
  }
}
