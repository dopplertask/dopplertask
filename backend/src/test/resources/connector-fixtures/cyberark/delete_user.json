{
  "package": "@activepieces/piece-cyberark",
  "version": "0.1.8",
  "action": "delete_user",
  "auth": {
    "props": {
      "serverUrl": "https://pvwa.example.com",
      "username": "vault-admin",
      "password": "test-password"
    }
  },
  "credential": {
    "serverUrl": "https://pvwa.example.com",
    "username": "vault-admin",
    "password": "test-password"
  },
  "inputs": {
    "userId": "42",
    "confirmDeletion": true
  },
  "answers": [
    {
      "status": 200,
      "body": "\"test-session-token\""
    },
    {
      "status": 200,
      "body": ""
    }
  ],
  "exchanges": [
    {
      "request": {
        "method": "POST",
        "url": "https://pvwa.example.com/PasswordVault/API/auth/Cyberark/Logon/",
        "headers": {
          "content-type": "application/json"
        },
        "body": {
          "username": "vault-admin",
          "password": "test-password"
        }
      }
    },
    {
      "request": {
        "method": "DELETE",
        "url": "https://pvwa.example.com/PasswordVault/API/Users/42/",
        "headers": {
          "authorization": "test-session-token",
          "content-type": "application/json"
        },
        "body": null
      }
    }
  ],
  "output": {
    "success": true,
    "message": "User 42 deleted successfully"
  }
}
