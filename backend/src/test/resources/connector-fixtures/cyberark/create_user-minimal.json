{
  "package": "@activepieces/piece-cyberark",
  "version": "0.1.8",
  "action": "create_user",
  "auth": {
    "props": {
      "serverUrl": "https://pvwa.example.com",
      "username": "vault-admin",
      "password": "test-password"
    }
  },
  "credential": {
    "serverUrl": "https://pvwa.example.com",
    "username": "vault-admin",
    "password": "test-password"
  },
  "inputs": {
    "username": "jane.doe",
    "userType": "",
    "authenticationMethod": "AuthTypePass",
    "location": "\\\\"
  },
  "answers": [
    {
      "status": 200,
      "body": "\"test-session-token\""
    },
    {
      "status": 201,
      "body": {
        "id": 42,
        "username": "jane.doe",
        "userType": "EPVUser",
        "enableUser": true,
        "suspended": false
      }
    }
  ],
  "exchanges": [
    {
      "request": {
        "method": "POST",
        "url": "https://pvwa.example.com/PasswordVault/API/auth/Cyberark/Logon/",
        "headers": {
          "content-type": "application/json"
        },
        "body": {
          "username": "vault-admin",
          "password": "test-password"
        }
      }
    },
    {
      "request": {
        "method": "POST",
        "url": "https://pvwa.example.com/PasswordVault/API/Users",
        "headers": {
          "authorization": "test-session-token",
          "content-type": "application/json"
        },
        "body": {
          "username": "jane.doe",
          "userType": "EPVUser",
          "enableUser": true,
          "changePassOnNextLogon": true,
          "passwordNeverExpires": false,
          "authenticationMethod": "AuthTypePass",
          "location": "\\\\"
        }
      }
    }
  ],
  "output": {
    "success": true,
    "user": {
      "id": 42,
      "username": "jane.doe",
      "userType": "EPVUser",
      "enableUser": true,
      "suspended": false
    }
  }
}
