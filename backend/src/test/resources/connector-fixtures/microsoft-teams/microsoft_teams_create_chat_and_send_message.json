{
  "package": "@activepieces/piece-microsoft-teams",
  "version": "0.8.2",
  "action": "microsoft_teams_create_chat_and_send_message",
  "auth": {
    "type": "OAUTH2",
    "access_token": "test-token",
    "data": {}
  },
  "inputs": {
    "teamId": "team-1",
    "members": [
      "u-2"
    ],
    "contentType": "text",
    "content": "Welcome"
  },
  "credential": {
    "oauthAccessToken": "test-token"
  },
  "answers": [
    {
      "status": 200,
      "body": {
        "id": "u-me",
        "userPrincipalName": "me@example.com"
      }
    },
    {
      "status": 200,
      "body": {
        "id": "chat-9",
        "chatType": "oneOnOne"
      }
    },
    {
      "status": 200,
      "body": {
        "id": "msg-1",
        "createdDateTime": "2026-01-02T10:00:00Z",
        "body": {
          "contentType": "text",
          "content": "Hello"
        }
      }
    }
  ],
  "exchanges": [
    {
      "request": {
        "method": "GET",
        "url": "https://graph.microsoft.com/v1.0/me?$select=id,userPrincipalName",
        "headers": {
          "authorization": "Bearer test-token",
          "sdkversion": "graph-js/3.0.7 (featureUsage=7)"
        },
        "body": null
      }
    },
    {
      "request": {
        "method": "POST",
        "url": "https://graph.microsoft.com/v1.0/chats",
        "headers": {
          "authorization": "Bearer test-token",
          "content-type": "application/json",
          "sdkversion": "graph-js/3.0.7 (featureUsage=7)"
        },
        "body": {
          "chatType": "oneOnOne",
          "members": [
            {
              "@odata.type": "#microsoft.graph.aadUserConversationMember",
              "roles": [
                "owner"
              ],
              "user@odata.bind": "https://graph.microsoft.com/v1.0/users('u-me')"
            },
            {
              "@odata.type": "#microsoft.graph.aadUserConversationMember",
              "roles": [
                "owner"
              ],
              "user@odata.bind": "https://graph.microsoft.com/v1.0/users('u-2')"
            }
          ]
        }
      }
    },
    {
      "request": {
        "method": "POST",
        "url": "https://graph.microsoft.com/v1.0/chats/chat-9/messages",
        "headers": {
          "authorization": "Bearer test-token",
          "content-type": "application/json",
          "sdkversion": "graph-js/3.0.7 (featureUsage=7)"
        },
        "body": {
          "body": {
            "content": "Welcome",
            "contentType": "text"
          }
        }
      }
    }
  ],
  "output": {
    "chat": {
      "id": "chat-9",
      "chatType": "oneOnOne"
    },
    "message": {
      "id": "msg-1",
      "createdDateTime": "2026-01-02T10:00:00Z",
      "body": {
        "contentType": "text",
        "content": "Hello"
      }
    }
  }
