{
  "package": "@activepieces/piece-apify",
  "version": "0.4.2",
  "auth": {
    "type": "CUSTOM_AUTH",
    "props": {
      "apikey": "test-key"
    }
  },
  "credential": {
    "apikey": "test-key"
  },
  "action": "apify_get_run_log",
  "inputs": {
    "runId": "run-1"
  },
  "answers": [
    {
      "status": 200,
      "headers": {
        "content-type": "text/plain; charset=utf-8"
      },
      "body": "{\"level\":\"INFO\",\"msg\":\"started\"}"
    }
  ],
  "exchanges": [
    {
      "request": {
        "method": "GET",
        "url": "https://api.apify.com/v2/logs/run-1",
        "headers": {
          "authorization": "Bearer test-key",
          "x-apify-integration-platform": "activepieces"
        },
        "body": null
      }
    }
  ],
  "output": {
    "id": "run-1",
    "log": "{\"level\":\"INFO\",\"msg\":\"started\"}"
  }
}
