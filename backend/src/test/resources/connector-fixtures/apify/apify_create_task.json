{
  "package": "@activepieces/piece-apify",
  "version": "0.4.2",
  "action": "apify_create_task",
  "auth": {
    "type": "CUSTOM_AUTH",
    "props": {
      "apikey": "test-key"
    }
  },
  "inputs": {
    "name": "my-task",
    "actorId": "act-1",
    "input": {
      "url": "https://example.com"
    }
  },
  "credential": {
    "apikey": "test-key"
  },
  "answers": [
    {
      "status": 201,
      "body": {
        "data": {
          "id": "tsk-1",
          "name": "my-task",
          "actId": "act-1"
        }
      }
    }
  ],
  "exchanges": [
    {
      "request": {
        "method": "POST",
        "url": "https://api.apify.com/v2/actor-tasks",
        "headers": {
          "authorization": "Bearer test-key",
          "content-type": "application/json",
          "x-apify-integration-platform": "activepieces"
        },
        "body": {
          "name": "my-task",
          "actId": "act-1",
          "input": {
            "url": "https://example.com"
          }
        }
      }
    }
  ],
  "output": {
    "id": "tsk-1",
    "name": "my-task",
    "actId": "act-1"
  }
}
