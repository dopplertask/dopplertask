          "startedAt": "2026-01-02T10:00:00.000Z",
          "finishedAt": null,
          "defaultDatasetId": "ds-1"
        }
      }
    }
  ],
  "exchanges": [
    {
      "request": {
        "method": "POST",
        "url": "https://api.apify.com/v2/acts/apify~web-scraper/runs?timeout=120&memory=1024&build=latest",
        "headers": {
          "authorization": "Bearer test-key",
          "content-type": "application/json",
          "x-apify-integration-platform": "activepieces"
        },
        "body": {
          "startUrls": [
            {
              "url": "https://example.com"
            }
          ]
        }
      }
    }
  ],
  "output": {
    "run": {
      "id": "run-1",
      "actId": "act-1",
      "status": "READY",
      "startedAt": "2026-01-02T10:00:00.000Z",
