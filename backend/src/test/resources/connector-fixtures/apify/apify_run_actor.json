{
  "package": "@activepieces/piece-apify",
  "version": "0.4.2",
  "action": "apify_run_actor",
  "auth": {
    "type": "CUSTOM_AUTH",
    "props": {
      "apikey": "test-key"
    }
  },
  "credential": {
    "apikey": "test-key"
  },
  "inputs": {
    "actorId": "apify~web-scraper",
    "input": {
      "startUrls": [
        {
          "url": "https://example.com"
        }
      ]
    },
    "build": "latest",
    "memory": 1024,
    "timeout": 120
