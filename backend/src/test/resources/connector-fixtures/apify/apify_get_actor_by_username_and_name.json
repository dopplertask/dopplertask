{
  "package": "@activepieces/piece-apify",
  "version": "0.4.2",
  "action": "apify_get_actor",
  "auth": {
    "type": "CUSTOM_AUTH",
    "props": {
      "apikey": "test-key"
    }
  },
  "inputs": {
    "actorId": "jane/my-actor"
  },
  "credential": {
    "apikey": "test-key"
  },
  "answers": [
