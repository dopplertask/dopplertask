{
  "package": "@activepieces/piece-apify",
  "version": "0.4.2",
  "action": "apify_update_task_input",
  "auth": {
    "type": "CUSTOM_AUTH",
    "props": {
      "apikey": "test-key"
    }
  },
  "credential": {
    "apikey": "test-key"
  },
  "inputs": {
    "taskId": "tsk-1",
    "input": "hello"
  },
  "settings": {
    "taskId": "tsk-1",
    "input": "\"hello\""
  },
  "answers": [
    {
      "status": 200,
      "body": {
        "url": "https://example.com",
        "maxPages": 3
      }
    }
  ],
  "exchanges": [
    {
      "request": {
        "method": "PUT",
        "url": "https://api.apify.com/v2/actor-tasks/tsk-1/input",
        "headers": {
          "authorization": "Bearer test-key",
          "content-type": "application/x-www-form-urlencoded",
          "x-apify-integration-platform": "activepieces"
        },
        "body": "hello"
      }
    }
  ],
  "output": {
    "taskId": "tsk-1",
    "input": {
      "url": "https://example.com",
      "maxPages": 3
    }
  }
}
