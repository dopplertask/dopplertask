{
  "package": "@activepieces/piece-apify",
  "version": "0.4.2",
  "auth": {
    "type": "CUSTOM_AUTH",
    "props": {
      "apikey": "test-key"
    }
  },
  "credential": {
    "apikey": "test-key"
  },
  "action": "apify_get_task_last_run_dataset_items",
  "inputs": {
    "taskId": "user/my-task",
    "limit": 0
  },
  "answers": [
    {
      "status": 200,
      "headers": {
        "X-Apify-Pagination-Offset": "1",
        "X-Apify-Pagination-Limit": "2",
        "X-Apify-Pagination-Count": "2",
        "X-Apify-Pagination-Total": "5"
      },
      "body": [
        {
          "url": "https://example.com/a",
          "title": "A"
        },
        {
          "url": "https://example.com/b",
          "title": "B"
        }
      ]
    }
  ],
  "exchanges": [],
  "output": {
    "error": "Limit must be greater than 0."
  }
}
