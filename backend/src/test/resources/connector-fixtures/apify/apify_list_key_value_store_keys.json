{
  "package": "@activepieces/piece-apify",
  "version": "0.4.2",
  "action": "apify_list_key_value_store_keys",
  "auth": {
    "type": "CUSTOM_AUTH",
    "props": {
      "apikey": "test-key"
    }
  },
  "inputs": {
    "storeId": "kvs-1",
    "prefix": "OUT",
    "limit": 2
  },
  "credential": {
    "apikey": "test-key"
  },
  "answers": [
    {
      "status": 200,
      "body": {
        "data": {
          "items": [
            {
              "key": "OUTPUT",
              "size": 120
            },
            {
              "key": "OUTPUT-2",
              "size": 80
            }
          ],
          "count": 2,
          "limit": 2,
          "isTruncated": true,
          "exclusiveStartKey": null,
          "nextExclusiveStartKey": "OUTPUT-2"
        }
      }
    }
  ],
  "exchanges": [
    {
      "request": {
        "method": "GET",
        "url": "https://api.apify.com/v2/key-value-stores/kvs-1/keys?prefix=OUT&limit=2",
        "headers": {
          "authorization": "Bearer test-key",
          "x-apify-integration-platform": "activepieces"
        },
        "body": null
      }
    }
  ],
  "output": {
    "keys": [
      {
        "key": "OUTPUT",
        "size": 120
      },
      {
        "key": "OUTPUT-2",
        "size": 80
      }
    ],
    "count": 2,
    "isTruncated": true,
    "nextExclusiveStartKey": "OUTPUT-2",
    "storeId": "kvs-1"
  }
}
