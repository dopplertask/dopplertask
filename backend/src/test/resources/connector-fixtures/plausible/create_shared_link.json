{
  "package": "@activepieces/piece-plausible",
  "version": "0.2.2",
  "action": "create_shared_link",
  "auth": {
    "type": "SECRET_TEXT",
    "secret_text": "test-key"
  },
  "inputs": {
    "site_id": "example.com",
    "name": "Wordpress"
  },
  "credential": {
    "apiKey": "test-key"
  },
  "answers": [
    {
      "status": 200,
      "body": {
        "name": "Wordpress",
        "url": "https://plausible.io/share/example.com?auth=abc123"
      }
    }
  ],
  "exchanges": [
    {
      "request": {
        "method": "PUT",
        "url": "https://plausible.io/api/v1/sites/shared-links",
        "headers": {
          "authorization": "Bearer test-key",
          "content-type": "application/json"
        },
        "body": {
          "site_id": "example.com",
          "name": "Wordpress"
        }
      }
    }
  ],
  "output": {
    "name": "Wordpress",
    "url": "https://plausible.io/share/example.com?auth=abc123"
  }
}
