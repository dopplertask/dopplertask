{
  "package": "@activepieces/piece-plausible",
  "version": "0.2.2",
  "action": "invite_guest",
  "auth": {
    "type": "SECRET_TEXT",
    "secret_text": "test-key"
  },
  "inputs": {
    "site_id": "example.com",
    "email": "guest@example.com",
    "role": "editor"
  },
  "credential": {
    "apiKey": "test-key"
  },
  "answers": [
    {
      "status": 200,
      "body": {
        "email": "guest@example.com",
        "role": "editor",
        "status": "invited"
      }
    }
  ],
  "exchanges": [
    {
      "request": {
        "method": "PUT",
        "url": "https://plausible.io/api/v1/sites/guests",
        "headers": {
          "authorization": "Bearer test-key",
          "content-type": "application/json"
        },
        "body": {
          "site_id": "example.com",
          "email": "guest@example.com",
          "role": "editor"
        }
      }
    }
  ],
  "output": {
    "email": "guest@example.com",
    "role": "editor",
    "status": "invited"
  }
}
