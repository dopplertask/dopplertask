{
  "package": "@activepieces/piece-plausible",
  "version": "0.2.2",
  "action": "remove_guest",
  "auth": {
    "type": "SECRET_TEXT",
    "secret_text": "test-key"
  },
  "inputs": {
    "site_id": "example.com",
    "email": "guest@example.com"
  },
  "credential": {
    "apiKey": "test-key"
  },
  "answers": [
    {
      "status": 200,
      "body": {
        "deleted": true
      }
    }
  ],
  "exchanges": [
    {
      "request": {
        "method": "DELETE",
        "url": "https://plausible.io/api/v1/sites/guests/guest%40example.com",
        "headers": {
          "authorization": "Bearer test-key",
          "content-type": "application/json"
        },
        "body": {
          "site_id": "example.com"
        }
      }
    }
  ],
  "output": {
    "deleted": true
  }
}
