{
  "package": "@activepieces/piece-plausible",
  "version": "0.2.2",
  "action": "get_aggregate_stats",
  "auth": {
    "type": "SECRET_TEXT",
    "secret_text": "test-key"
  },
  "inputs": {
    "site_id": "example.com",
    "period": "7d",
    "metrics": [
      "visitors",
      "pageviews"
    ]
  },
  "credential": {
    "apiKey": "test-key"
  },
  "answers": [
    {
      "status": 200,
      "body": {
        "results": {
          "visitors": {
            "value": 1200
          },
          "pageviews": {
            "value": 3400
          }
        }
      }
    }
  ],
  "exchanges": [
    {
      "request": {
        "method": "GET",
        "url": "https://plausible.io/api/v1/stats/aggregate?site_id=example.com&period=7d&metrics=visitors%2Cpageviews",
        "headers": {
          "authorization": "Bearer test-key"
        },
        "body": null
      }
    }
  ],
  "output": {
    "visitors": 1200,
    "pageviews": 3400
  }
}
