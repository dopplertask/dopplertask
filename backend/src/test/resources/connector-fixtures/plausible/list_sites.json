{
  "package": "@activepieces/piece-plausible",
  "version": "0.2.2",
  "action": "list_sites",
  "auth": {
    "type": "SECRET_TEXT",
    "secret_text": "test-key"
  },
  "inputs": {},
  "credential": {
    "apiKey": "test-key"
  },
  "answers": [
    {
      "status": 200,
      "body": {
        "sites": [
          {
            "domain": "example.com",
            "timezone": "Europe/London"
          }
        ],
        "meta": {
          "limit": 100
        }
      }
    }
  ],
  "exchanges": [
    {
      "request": {
        "method": "GET",
        "url": "https://plausible.io/api/v1/sites",
        "headers": {
          "authorization": "Bearer test-key"
        },
        "body": null
      }
    }
  ],
  "output": {
    "sites": [
      {
        "domain": "example.com",
        "timezone": "Europe/London"
      }
    ]
  }
}
