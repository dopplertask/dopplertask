{
  "package": "@activepieces/piece-plausible",
  "version": "0.2.2",
  "auth": {
    "type": "SECRET_TEXT",
    "secret_text": "test-key"
  },
  "trigger": "traffic_spike",
  "inputs": {
    "site_id": "example.com",
    "threshold": 100
  },
  "credential": {
    "apiKey": "test-key"
  },
  "store": {
    "lastPoll": 1700000000000,
    "wasAboveThreshold": true
  },
  "answers": [
    {
      "status": 200,
      "body": 40
    }
  ],
  "exchanges": [
    {
      "request": {
        "method": "GET",
        "url": "https://plausible.io/api/v1/stats/realtime/visitors?site_id=example.com",
        "headers": {
          "authorization": "Bearer test-key"
        },
        "body": null
      }
    }
  ],
  "output": [],
  "storeAfter": {
    "lastPoll": 1700000000000,
    "wasAboveThreshold": false
  }
}
