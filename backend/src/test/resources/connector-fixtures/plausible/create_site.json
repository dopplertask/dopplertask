{
  "package": "@activepieces/piece-plausible",
  "version": "0.2.2",
  "action": "create_site",
  "auth": {
    "type": "SECRET_TEXT",
    "secret_text": "test-key"
  },
  "inputs": {
    "domain": "new.example.com",
    "timezone": "Europe/London",
    "team_id": "team-1",
    "track_404_pages": true,
    "hash_based_routing": false,
    "outbound_links": true,
    "file_downloads": false,
    "form_submissions": true
  },
  "credential": {
    "apiKey": "test-key"
  },
  "answers": [
    {
      "status": 200,
      "body": {
        "domain": "new.example.com",
        "timezone": "Europe/London"
      }
    }
  ],
  "exchanges": [
    {
      "request": {
        "method": "POST",
        "url": "https://plausible.io/api/v1/sites",
        "headers": {
          "authorization": "Bearer test-key",
          "content-type": "application/json"
        },
        "body": {
          "domain": "new.example.com",
          "timezone": "Europe/London",
          "team_id": "team-1",
          "tracker_script_configuration": {
            "track_404_pages": true,
            "outbound_links": true,
            "form_submissions": true
          }
        }
      }
    }
  ],
  "output": {
    "domain": "new.example.com",
    "timezone": "Europe/London"
  }
}
