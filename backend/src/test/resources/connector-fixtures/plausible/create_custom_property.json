{
  "package": "@activepieces/piece-plausible",
  "version": "0.2.2",
  "action": "create_custom_property",
  "auth": {
    "type": "SECRET_TEXT",
    "secret_text": "test-key"
  },
  "inputs": {
    "site_id": "example.com",
    "property": "plan"
  },
  "credential": {
    "apiKey": "test-key"
  },
  "answers": [
    {
      "status": 200,
      "body": {
        "created": true
      }
    }
  ],
  "exchanges": [
    {
      "request": {
        "method": "PUT",
        "url": "https://plausible.io/api/v1/sites/custom-props",
        "headers": {
          "authorization": "Bearer test-key",
          "content-type": "application/json"
        },
        "body": {
          "site_id": "example.com",
          "property": "plan"
        }
      }
    }
  ],
  "output": {
    "created": true
  }
}
