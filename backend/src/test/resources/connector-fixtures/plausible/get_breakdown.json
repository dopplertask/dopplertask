{
  "package": "@activepieces/piece-plausible",
  "version": "0.2.2",
  "action": "get_breakdown",
  "auth": {
    "type": "SECRET_TEXT",
    "secret_text": "test-key"
  },
  "inputs": {
    "site_id": "example.com",
    "period": "30d",
    "property": "visit:source",
    "limit": 5
  },
  "credential": {
    "apiKey": "test-key"
  },
  "answers": [
    {
      "status": 200,
      "body": {
        "results": [
          {
            "source": "Google",
            "visitors": 500
          },
          {
            "source": "Direct",
            "visitors": 300
          }
        ]
      }
    }
  ],
  "exchanges": [
    {
      "request": {
        "method": "GET",
        "url": "https://plausible.io/api/v1/stats/breakdown?site_id=example.com&period=30d&property=visit%3Asource&limit=5",
        "headers": {
          "authorization": "Bearer test-key"
        },
        "body": null
      }
    }
  ],
  "output": [
    {
      "source": "Google",
      "visitors": 500
    },
    {
      "source": "Direct",
      "visitors": 300
    }
  ]
}
