{
  "package": "@activepieces/piece-plausible",
  "version": "0.2.2",
  "action": "create_goal",
  "auth": {
    "type": "SECRET_TEXT",
    "secret_text": "test-key"
  },
  "inputs": {
    "site_id": "example.com",
    "goal_type": "event",
    "event_name": "Signup",
    "page_path": "/register*",
    "display_name": "Signups"
  },
  "credential": {
    "apiKey": "test-key"
  },
  "answers": [
    {
      "status": 200,
      "body": {
        "id": "1",
        "goal_type": "event",
        "display_name": "Signups",
        "event_name": "Signup"
      }
    }
  ],
  "exchanges": [
    {
      "request": {
        "method": "PUT",
        "url": "https://plausible.io/api/v1/sites/goals",
        "headers": {
          "authorization": "Bearer test-key",
          "content-type": "application/json"
        },
        "body": {
          "site_id": "example.com",
          "goal_type": "event",
          "event_name": "Signup",
          "display_name": "Signups"
        }
      }
    }
  ],
  "output": {
    "id": "1",
    "goal_type": "event",
    "display_name": "Signups",
    "event_name": "Signup"
  }
}
