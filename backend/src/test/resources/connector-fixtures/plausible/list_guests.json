{
  "package": "@activepieces/piece-plausible",
  "version": "0.2.2",
  "action": "list_guests",
  "auth": {
    "type": "SECRET_TEXT",
    "secret_text": "test-key"
  },
  "inputs": {
    "site_id": "example.com"
  },
  "credential": {
    "apiKey": "test-key"
  },
  "answers": [
    {
      "status": 200,
      "body": {
        "guests": [
          {
            "email": "guest@example.com",
            "role": "viewer",
            "status": "invited"
          }
        ],
        "meta": {}
      }
    }
  ],
  "exchanges": [
    {
      "request": {
        "method": "GET",
        "url": "https://plausible.io/api/v1/sites/guests?site_id=example.com",
        "headers": {
          "authorization": "Bearer test-key"
        },
        "body": null
      }
    }
  ],
  "output": {
    "guests": [
      {
        "email": "guest@example.com",
        "role": "viewer",
        "status": "invited"
      }
    ]
  }
}
