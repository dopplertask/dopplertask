{
  "package": "@activepieces/piece-plausible",
  "version": "0.2.2",
  "action": "get_site",
  "auth": {
    "type": "SECRET_TEXT",
    "secret_text": "test-key"
  },
  "inputs": {
    "site_id": "example.com"
  },
  "credential": {
    "apiKey": "test-key"
  },
  "answers": [
    {
      "status": 200,
      "body": {
        "domain": "example.com",
        "timezone": "Europe/London",
        "custom_properties": [],
        "tracker_script_configuration": {
          "outbound_links": true
        }
      }
    }
  ],
  "exchanges": [
    {
      "request": {
        "method": "GET",
        "url": "https://plausible.io/api/v1/sites/example.com",
        "headers": {
          "authorization": "Bearer test-key"
        },
        "body": null
      }
    }
  ],
  "output": {
    "domain": "example.com",
    "timezone": "Europe/London",
    "custom_properties": [],
    "tracker_script_configuration": {
      "outbound_links": true
    }
  }
}
