{
  "package": "@activepieces/piece-plausible",
  "version": "0.2.2",
  "action": "list_custom_properties",
  "auth": {
    "type": "SECRET_TEXT",
    "secret_text": "test-key"
  },
  "inputs": {
    "site_id": "example.com"
  },
  "credential": {
    "apiKey": "test-key"
  },
  "answers": [
    {
      "status": 200,
      "body": {
        "custom_properties": [
          {
            "property": "plan"
          }
        ]
      }
    }
  ],
  "exchanges": [
    {
      "request": {
        "method": "GET",
        "url": "https://plausible.io/api/v1/sites/custom-props?site_id=example.com",
        "headers": {
          "authorization": "Bearer test-key"
        },
        "body": null
      }
    }
  ],
  "output": {
    "custom_properties": [
      {
        "property": "plan"
      }
    ]
  }
}
