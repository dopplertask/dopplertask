{
  "package": "@activepieces/piece-dropbox",
  "version": "0.10.2",
  "action": "create_dropbox_upload_link",
  "auth": {
    "access_token": "test-token",
    "data": {}
  },
  "inputs": {
    "path": "/Uploads/report.pdf",
    "mode": "overwrite",
    "autorename": true,
    "duration": 3600
  },
  "credential": {
    "oauthAccessToken": "test-token"
  },
  "answers": [
    {
      "status": 200,
      "body": {
        "link": "https://content.dropboxapi.com/apitul/1/abc"
      }
    }
  ],
  "exchanges": [
    {
      "request": {
        "method": "POST",
        "url": "https://api.dropboxapi.com/2/files/get_temporary_upload_link",
        "headers": {
          "authorization": "Bearer test-token",
          "content-type": "application/json"
        },
        "body": {
          "commit_info": {
            "path": "/Uploads/report.pdf",
            "mode": "overwrite",
            "autorename": true
          },
          "duration": 3600
        }
      }
    }
  ],
  "output": {
    "link": "https://content.dropboxapi.com/apitul/1/abc"
  }
