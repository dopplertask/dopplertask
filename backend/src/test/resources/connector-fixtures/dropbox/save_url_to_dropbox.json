{
  "package": "@activepieces/piece-dropbox",
  "version": "0.10.2",
  "action": "save_url_to_dropbox",
  "auth": {
    "access_token": "test-token",
    "data": {}
  },
  "inputs": {
    "path": "/Downloads/report.pdf",
    "url": "https://files.example.com/report.pdf"
  },
  "credential": {
    "oauthAccessToken": "test-token"
  },
  "answers": [
    {
      "status": 200,
      "body": {
        ".tag": "async_job_id",
        "async_job_id": "job-1"
      }
    }
  ],
  "exchanges": [
    {
      "request": {
        "method": "POST",
        "url": "https://api.dropboxapi.com/2/files/save_url",
        "headers": {
          "authorization": "Bearer test-token",
          "content-type": "application/json"
        },
        "body": {
          "path": "/Downloads/report.pdf",
          "url": "https://files.example.com/report.pdf"
        }
      }
    }
  ],
  "output": {
    ".tag": "async_job_id",
    "async_job_id": "job-1"
  }
}
