{
  "package": "@activepieces/piece-dropbox",
  "version": "0.10.2",
  "action": "start_dropbox_move_batch",
  "auth": {
    "access_token": "test-token",
    "data": {}
  },
  "inputs": {
    "entries": [
      {
        "from_path": "/a.txt",
        "to_path": "/b/a.txt",
        "note": "ignored"
      },
      {
        "from_path": "/c.txt",
        "to_path": "/b/c.txt"
      }
    ],
    "autorename": true
  },
  "credential": {
    "oauthAccessToken": "test-token"
  },
  "answers": [
    {
      "status": 200,
      "body": {
        ".tag": "async_job_id",
        "async_job_id": "job-1"
      }
    }
  ],
  "exchanges": [
    {
      "request": {
        "method": "POST",
        "url": "https://api.dropboxapi.com/2/files/move_batch_v2",
        "headers": {
          "authorization": "Bearer test-token",
          "content-type": "application/json"
        },
        "body": {
          "entries": [
            {
              "from_path": "/a.txt",
              "to_path": "/b/a.txt"
            },
            {
              "from_path": "/c.txt",
              "to_path": "/b/c.txt"
            }
          ],
          "autorename": true
        }
      }
    }
  ],
  "output": {
    ".tag": "async_job_id",
    "async_job_id": "job-1"
  }
}
