{
  "package": "@activepieces/piece-dropbox",
  "version": "0.10.2",
  "auth": {
    "access_token": "test-token",
    "data": {}
  },
  "credential": {
    "oauthAccessToken": "test-token"
  },
  "trigger": "new_folder",
  "inputs": {
    "path": "/Clients",
    "recursive": false
  },
  "store": {
    "cursor": "cursor-1",
    "seen": []
  },
  "answers": [
    {
      "status": 200,
      "body": {
        "entries": [
          {
            ".tag": "folder",
            "name": "Acme",
            "id": "id:f1",
            "path_display": "/Clients/Acme",
            "path_lower": "/clients/acme"
          },
          {
            ".tag": "file",
            "name": "a.txt",
            "id": "id:x1",
            "path_display": "/Clients/a.txt",
            "path_lower": "/clients/a.txt"
          }
        ],
        "cursor": "cursor-2",
        "has_more": true
      }
    },
    {
      "status": 200,
      "body": {
        "entries": [
          {
            ".tag": "folder",
            "name": "Globex",
            "id": "id:f2",
            "path_display": "/Clients/Globex",
            "path_lower": "/clients/globex"
          }
        ],
        "cursor": "cursor-3",
        "has_more": false
      }
    }
  ],
  "exchanges": [
    {
      "request": {
        "method": "POST",
        "url": "https://api.dropboxapi.com/2/files/list_folder/continue",
        "headers": {
          "authorization": "Bearer test-token",
          "content-type": "application/json"
        },
        "body": {
          "cursor": "cursor-1"
        }
      }
    },
    {
      "request": {
        "method": "POST",
        "url": "https://api.dropboxapi.com/2/files/list_folder/continue",
        "headers": {
          "authorization": "Bearer test-token",
          "content-type": "application/json"
        },
        "body": {
          "cursor": "cursor-2"
        }
      }
    }
  ],
  "output": [
    {
      ".tag": "folder",
      "name": "Acme",
      "id": "id:f1",
      "path_display": "/Clients/Acme",
      "path_lower": "/clients/acme"
    },
    {
      ".tag": "folder",
      "name": "Globex",
      "id": "id:f2",
      "path_display": "/Clients/Globex",
      "path_lower": "/clients/globex"
    }
  ],
  "storeAfter": {
    "cursor": "cursor-3",
    "seen": []
  }
}
