{
  "package": "@activepieces/piece-dropbox",
  "version": "0.10.2",
  "action": "start_dropbox_delete_batch",
  "auth": {
    "access_token": "test-token",
    "data": {}
  },
  "inputs": {
    "paths": [
      "/old/a.txt",
      "id:abc123"
    ]
  },
  "credential": {
    "oauthAccessToken": "test-token"
  },
  "answers": [
    {
      "status": 200,
      "body": {
        ".tag": "async_job_id",
        "async_job_id": "job-1"
      }
    }
  ],
  "exchanges": [
    {
      "request": {
        "method": "POST",
        "url": "https://api.dropboxapi.com/2/files/delete_batch",
        "headers": {
          "authorization": "Bearer test-token",
          "content-type": "application/json"
        },
        "body": {
          "entries": [
            {
              "path": "/old/a.txt"
            },
            {
              "path": "id:abc123"
            }
          ]
        }
      }
    }
  ],
  "output": {
    ".tag": "async_job_id",
    "async_job_id": "job-1"
  }
}
