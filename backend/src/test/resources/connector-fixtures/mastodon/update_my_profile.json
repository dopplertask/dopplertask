{
  "package": "@activepieces/piece-mastodon",
  "version": "0.9.2",
  "action": "update_my_profile",
  "auth": {
    "type": "CUSTOM_AUTH",
    "props": {
      "base_url": "https://credential000z.example.com",
      "access_token": "credential001z"
    }
  },
  "inputs": {
    "display_name": "sample000z",
    "note": "sample001z",
    "default_language": "sample006z"
  },
  "credential": {
    "base_url": "credential000z.example.com",
    "access_token": "credential001z"
  },
  "answers": [
    {
      "status": 200,
      "body": {}
    }
  ],
  "exchanges": [
    {
      "request": {
        "method": "PATCH",
        "url": "https://credential000z.example.com/api/v1/accounts/update_credentials",
        "headers": {
          "authorization": "Bearer credential001z",
          "content-type": "application/json"
        },
        "body": {
          "display_name": "sample000z",
          "note": "sample001z",
          "source": {
            "language": "sample006z"
          }
        }
      }
    }
  ],
  "output": {}
}
