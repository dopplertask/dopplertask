{
  "package": "@activepieces/piece-apitable",
  "version": "0.5.3",
  "action": "apitable_upload_attachment",
  "auth": {
    "type": "CUSTOM_AUTH",
    "props": {
      "token": "test-key",
      "apiTableUrl": "https://aitable.ai"
    }
  },
  "inputs": {
    "space_id": "spc1",
    "datasheet_id": "dst1"
  },
  "files": {
    "file": {
      "name": "notes.txt",
      "base64": "aGVsbG8gYXR0YWNobWVudA=="
    }
  },
  "credential": {
    "token": "test-key",
    "apiTableUrl": "aitable.ai"
  },
  "answers": [
    {
      "status": 200,
      "body": {
        "success": true,
        "code": 200,
        "message": "SUCCESS",
        "data": {
          "token": "t1",
          "mimeType": "text/plain",
          "size": 16,
          "name": "notes.txt",
          "url": "https://s1.example/t1"
        }
      }
    }
  ],
  "exchanges": [
    {
      "request": {
        "method": "POST",
        "url": "https://aitable.ai/fusion/v1/datasheets/dst1/attachments",
        "headers": {
          "authorization": "Bearer test-key",
          "content-type": "multipart/form-data; boundary=--------------------------c1dbf9093967141c76308a05"
        },
        "body": "----------------------------c1dbf9093967141c76308a05\r\nContent-Disposition: form-data; name=\"file\"; filename=\"notes.txt\"\r\nContent-Type: text/plain\r\n\r\nhello attachment\r\n----------------------------c1dbf9093967141c76308a05--\r\n"
      }
    }
  ],
  "output": {
    "success": true,
    "code": 200,
    "message": "SUCCESS",
    "data": {
      "token": "t1",
      "mimeType": "text/plain",
      "size": 16,
      "name": "notes.txt",
      "url": "https://s1.example/t1"
    }
  }
}
