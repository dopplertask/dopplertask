{
  "package": "@activepieces/piece-webflow",
  "version": "0.4.1",
  "action": "webflow_register_hosted_script",
  "auth": {
    "access_token": "test-token",
    "data": {}
  },
  "inputs": {
    "siteId": "site-1",
    "displayName": "Analytics",
    "version": "1.0.0",
    "hostedLocation": "https://cdn.example.com/app.js",
    "integrityHash": "sha384-abc123",
    "canCopy": "true"
  },
  "credential": {
    "oauthAccessToken": "test-token"
  },
  "answers": [
    {
      "status": 200,
      "body": {
        "id": "answer-1",
        "name": "Answer"
      }
    }
  ],
  "exchanges": [
    {
      "request": {
        "method": "POST",
        "url": "https://api.webflow.com/v2/sites/site-1/registered_scripts/hosted",
        "headers": {
          "authorization": "Bearer test-token",
          "content-type": "application/json"
        },
        "body": {
          "displayName": "Analytics",
          "version": "1.0.0",
          "hostedLocation": "https://cdn.example.com/app.js",
          "integrityHash": "sha384-abc123",
          "canCopy": true
        }
      }
    }
  ],
  "output": {
    "id": "answer-1",
    "name": "Answer"
  }
}
