{
  "package": "@activepieces/piece-webflow",
  "version": "0.4.1",
  "action": "publish_collection_item",
  "auth": {
    "access_token": "test-token",
    "data": {}
  },
  "inputs": {
    "site_id": "site-1",
    "collection_id": "coll-1",
    "collection_item_id": "item-1"
  },
  "credential": {
    "oauthAccessToken": "test-token"
  },
  "answers": [
    {
      "status": 200,
      "body": {
        "id": "answer-1",
        "name": "Answer"
      }
    }
  ],
  "exchanges": [
    {
      "request": {
        "method": "POST",
        "url": "https://api.webflow.com/v2/collections/coll-1/items/publish",
        "headers": {
          "authorization": "Bearer test-token",
          "content-type": "application/json"
        },
        "body": {
          "itemIds": [
            "item-1"
          ]
        }
      }
    }
  ],
  "output": {
    "id": "answer-1",
    "name": "Answer"
  }
}
