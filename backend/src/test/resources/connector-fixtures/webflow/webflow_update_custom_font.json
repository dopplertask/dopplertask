{
  "package": "@activepieces/piece-webflow",
  "version": "0.4.1",
  "action": "webflow_update_custom_font",
  "auth": {
    "access_token": "test-token",
    "data": {}
  },
  "inputs": {
    "siteId": "site-1",
    "fontId": "font-1",
    "fontFamily": "Inter",
    "weight": 700,
    "italic": "false",
    "fontDisplay": "swap"
  },
  "credential": {
    "oauthAccessToken": "test-token"
  },
  "answers": [
    {
      "status": 200,
      "body": {
        "id": "answer-1",
        "name": "Answer"
      }
    }
  ],
  "exchanges": [
    {
      "request": {
        "method": "PATCH",
        "url": "https://api.webflow.com/v2/sites/site-1/custom_fonts/font-1",
        "headers": {
          "authorization": "Bearer test-token",
          "content-type": "application/json"
        },
        "body": {
          "fontFamily": "Inter",
          "weight": 700,
          "italic": false,
          "fontDisplay": "swap"
        }
      }
    }
  ],
  "output": {
    "id": "answer-1",
    "name": "Answer"
  }
}
