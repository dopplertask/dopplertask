{
  "package": "@activepieces/piece-webflow",
  "version": "0.4.1",
  "action": "webflow_publish_site",
  "auth": {
    "access_token": "test-token",
    "data": {}
  },
  "inputs": {
    "siteId": "site-1",
    "publishToWebflowSubdomain": "true",
    "customDomainIds": [
      "dom-1",
      "dom-2"
    ],
    "pageId": "page-1"
  },
  "credential": {
    "oauthAccessToken": "test-token"
  },
  "answers": [
    {
      "status": 200,
      "body": {
        "id": "answer-1",
        "name": "Answer"
      }
    }
  ],
  "exchanges": [
    {
      "request": {
        "method": "POST",
        "url": "https://api.webflow.com/v2/sites/site-1/publish",
        "headers": {
          "authorization": "Bearer test-token",
          "content-type": "application/json"
        },
        "body": {
          "customDomains": [
            "dom-1",
            "dom-2"
          ],
          "publishToWebflowSubdomain": true,
          "pageId": "page-1"
        }
      }
    }
  ],
  "output": {
    "id": "answer-1",
    "name": "Answer"
  }
}
