{
  "package": "@activepieces/piece-webflow",
  "version": "0.4.1",
  "action": "webflow_delete_custom_fonts_batch",
  "auth": {
    "access_token": "test-token",
    "data": {}
  },
  "inputs": {
    "site_id": "site-1",
    "fontIds": [
      "font-1",
      "font-2"
    ]
  },
  "credential": {
    "oauthAccessToken": "test-token"
  },
  "answers": [
    {
      "status": 200,
      "body": {
        "id": "answer-1",
        "name": "Answer"
      }
    }
  ],
  "exchanges": [
    {
      "request": {
        "method": "POST",
        "url": "https://api.webflow.com/v2/sites/site-1/custom_fonts/batchDelete",
        "headers": {
          "authorization": "Bearer test-token",
          "content-type": "application/json"
        },
        "body": {
          "items": [
            {
              "id": "font-1"
            },
            {
              "id": "font-2"
            }
          ]
        }
      }
    }
  ],
  "output": {
    "id": "answer-1",
    "name": "Answer"
  }
}
