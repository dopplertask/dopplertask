{
  "package": "@activepieces/piece-webflow",
  "version": "0.4.1",
  "action": "webflow_delete_collection_items",
  "auth": {
    "access_token": "test-token",
    "data": {}
  },
  "inputs": {
    "collectionId": "coll-1",
    "items": [
      {
        "id": "item-1"
      },
      {
        "id": "item-2"
      }
    ]
  },
  "credential": {
    "oauthAccessToken": "test-token"
  },
  "answers": [
    {
      "status": 200,
      "body": {
        "id": "answer-1",
        "name": "Answer"
      }
    }
  ],
  "exchanges": [
    {
      "request": {
        "method": "DELETE",
        "url": "https://api.webflow.com/v2/collections/coll-1/items",
        "headers": {
          "authorization": "Bearer test-token",
          "content-type": "application/json"
        },
        "body": {
          "items": [
            {
              "id": "item-1"
            },
            {
              "id": "item-2"
            }
          ]
        }
      }
    }
  ],
  "output": {
