{
  "package": "@activepieces/piece-webflow",
  "version": "0.4.1",
  "action": "webflow_publish_collection_items",
  "auth": {
    "access_token": "test-token",
    "data": {}
  },
  "inputs": {
    "collectionId": "coll-1",
    "itemIds": [
      "item-1",
      "item-2"
    ]
  },
  "credential": {
    "oauthAccessToken": "test-token"
  },
  "answers": [
    {
      "status": 200,
      "body": {
        "id": "answer-1",
        "name": "Answer"
      }
    }
  ],
  "exchanges": [
    {
      "request": {
        "method": "POST",
        "url": "https://api.webflow.com/v2/collections/coll-1/items/publish",
        "headers": {
          "authorization": "Bearer test-token",
          "content-type": "application/json"
        },
        "body": {
          "itemIds": [
            "item-1",
            "item-2"
          ]
        }
      }
    }
  ],
  "output": {
    "id": "answer-1",
    "name": "Answer"
  }
}
