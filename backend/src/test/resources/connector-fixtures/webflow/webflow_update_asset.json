        "headers": {
          "authorization": "Bearer test-token",
          "content-type": "application/json"
        },
        "body": {
          "displayName": "Hero",
          "altText": "A hero image"
        }
      }
    }
  ],
  "output": {
    "id": "answer-1",
    "name": "Answer"
  }
