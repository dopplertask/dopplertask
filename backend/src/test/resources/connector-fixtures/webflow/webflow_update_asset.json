{
  "package": "@activepieces/piece-webflow",
  "version": "0.4.1",
  "action": "webflow_update_asset",
  "auth": {
    "access_token": "test-token",
    "data": {}
  },
  "inputs": {
    "assetId": "asset-1",
    "displayName": "Hero",
    "altText": "A hero image",
    "localeId": "loc-1"
  },
