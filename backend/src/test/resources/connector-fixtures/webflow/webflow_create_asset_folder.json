{
  "package": "@activepieces/piece-webflow",
  "version": "0.4.1",
  "action": "webflow_create_asset_folder",
  "auth": {
    "access_token": "test-token",
    "data": {}
  },
  "inputs": {
    "site_id": "site-1",
    "displayName": "Blog images",
    "parentFolder": "folder-1"
  },
  "credential": {
    "oauthAccessToken": "test-token"
  },
  "answers": [
    {
      "status": 200,
      "body": {
        "id": "answer-1",
        "name": "Answer"
      }
    }
  ],
  "exchanges": [
    {
      "request": {
        "method": "POST",
        "url": "https://api.webflow.com/v2/sites/site-1/asset_folders",
        "headers": {
          "authorization": "Bearer test-token",
          "content-type": "application/json"
        },
        "body": {
          "displayName": "Blog images",
          "parentFolder": "folder-1"
        }
      }
    }
  ],
  "output": {
    "id": "answer-1",
    "name": "Answer"
  }
}
