{
  "package": "@activepieces/piece-webflow",
  "version": "0.4.1",
  "action": "webflow_create_live_collection_item",
  "auth": {
    "access_token": "test-token",
    "data": {}
  },
  "inputs": {
    "collectionId": "coll-1",
    "fieldData": {
      "name": "My post",
      "slug": "my-post"
    },
    "isArchived": "true"
  },
  "credential": {
    "oauthAccessToken": "test-token"
  },
  "answers": [
    {
      "status": 200,
      "body": {
        "id": "answer-1",
        "name": "Answer"
      }
    }
  ],
  "exchanges": [
    {
      "request": {
        "method": "POST",
        "url": "https://api.webflow.com/v2/collections/coll-1/items/live",
        "headers": {
          "authorization": "Bearer test-token",
          "content-type": "application/json"
        },
        "body": {
          "fieldData": {
            "name": "My post",
            "slug": "my-post"
          },
          "isArchived": true
        }
      }
    }
  ],
  "output": {
    "id": "answer-1",
    "name": "Answer"
  }
}
