{
  "package": "@activepieces/piece-webflow",
  "version": "0.4.1",
  "action": "webflow_create_collection_field",
  "auth": {
    "access_token": "test-token",
    "data": {}
  },
  "inputs": {
    "collectionId": "coll-1",
    "type": "Option",
    "displayName": "Blog Posts",
    "isRequired": "true",
    "helpText": "Pick one",
    "options": [
      "Feature",
      "News"
    ]
  },
  "credential": {
    "oauthAccessToken": "test-token"
  },
  "answers": [
    {
      "status": 200,
      "body": {
        "id": "answer-1",
        "name": "Answer"
      }
    }
  ],
  "exchanges": [
    {
      "request": {
        "method": "POST",
        "url": "https://api.webflow.com/v2/collections/coll-1/fields",
        "headers": {
          "authorization": "Bearer test-token",
          "content-type": "application/json"
        },
        "body": {
          "type": "Option",
          "displayName": "Blog Posts",
          "isRequired": true,
          "helpText": "Pick one",
          "metadata": {
            "options": [
              {
                "name": "Feature"
              },
              {
                "name": "News"
              }
            ]
          }
        }
      }
    }
  ],
  "output": {
    "id": "answer-1",
    "name": "Answer"
  }
}
