{
  "package": "@activepieces/piece-webflow",
  "version": "0.4.1",
  "action": "update_collection_item",
  "auth": {
    "access_token": "test-token",
    "data": {}
  },
  "inputs": {
    "site_id": "site-1",
    "collection_id": "coll-1",
    "collection_item_id": "item-1",
    "is_archived": false,
    "is_draft": true,
    "collection_fields": {
      "name": "Hello",
      "price": "12",
      "category": "News",
      "hero": "https://img.example.com/a.png",
      "gallery": [
        "https://img.example.com/b.png"
      ],
      "related": [
        "item-9"
      ]
    }
  },
  "credential": {
    "oauthAccessToken": "test-token"
  },
  "answers": [
    {
      "status": 200,
      "body": {
        "id": "coll-1",
        "displayName": "Posts",
        "fields": [
          {
            "slug": "name",
            "type": "PlainText",
            "isEditable": true
          },
          {
            "slug": "price",
            "type": "Number",
            "isEditable": true
          },
          {
            "slug": "category",
            "type": "Option",
            "isEditable": true,
            "validations": {
              "options": [
                {
                  "id": "opt-1",
                  "name": "News"
                },
                {
                  "id": "opt-2",
                  "name": "Feature"
                }
              ]
            }
          },
          {
            "slug": "hero",
            "type": "Image",
            "isEditable": true
          },
          {
            "slug": "gallery",
            "type": "MultiImage",
            "isEditable": true
          },
          {
            "slug": "related",
            "type": "MultiReference",
            "isEditable": true
          },
          {
            "slug": "unused",
            "type": "PlainText",
            "isEditable": true
          }
        ]
      }
    },
    {
      "status": 200,
      "body": {
        "id": "item-1",
        "isDraft": false,
        "isArchived": false,
        "fieldData": {
          "name": "Hello",
          "slug": "hello"
        }
      }
    }
  ],
  "exchanges": [
    {
      "request": {
        "method": "GET",
        "url": "https://api.webflow.com/v2/collections/coll-1",
        "headers": {
          "authorization": "Bearer test-token"
        },
        "body": null
      }
    },
    {
      "request": {
        "method": "PATCH",
        "url": "https://api.webflow.com/v2/collections/coll-1/items/item-1",
        "headers": {
          "authorization": "Bearer test-token",
          "content-type": "application/json"
        },
        "body": {
          "isArchived": false,
          "isDraft": true,
          "fieldData": {
            "name": "Hello",
            "price": 12,
            "category": "opt-1",
            "hero": {
              "url": "https://img.example.com/a.png"
            },
            "gallery": [
              {
                "url": "https://img.example.com/b.png"
              }
            ],
            "related": [
              "item-9"
            ]
          }
        }
      }
    }
  ],
  "output": {
    "id": "item-1",
    "isDraft": false,
    "isArchived": false,
    "fieldData": {
      "name": "Hello",
      "slug": "hello"
    }
  }
}
