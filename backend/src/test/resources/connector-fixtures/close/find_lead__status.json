{
  "package": "@activepieces/piece-close",
  "version": "0.3.2",
  "action": "find_lead",
  "auth": {
    "type": "SECRET_TEXT",
    "secret_text": "test-key"
  },
  "inputs": {
    "search_type": "status",
    "search_query": " potential ",
    "match_type": "contains"
  },
  "credential": {
    "apiKey": "test-key"
  },
  "answers": [
    {
      "status": 200,
      "body": {
        "data": [
          {
            "id": "stat_1",
            "label": "Potential"
          },
          {
            "id": "stat_2",
            "label": "Not potential"
          },
          {
            "id": "stat_3",
            "label": "Won"
          }
        ]
      }
    },
    {
      "status": 200,
      "body": {
        "data": [
          {
            "id": "lead_1",
            "name": "Acme",
            "status_label": "Potential",
            "contacts": []
          }
        ],
        "cursor": null
      }
    }
  ],
  "exchanges": [
    {
      "request": {
        "method": "GET",
        "url": "https://api.close.com/api/v1/status/lead/",
        "headers": {
          "authorization": "Basic dGVzdC1rZXk6"
        },
        "body": null
      }
    },
    {
      "request": {
        "method": "POST",
        "url": "https://api.close.com/api/v1/data/search/",
        "headers": {
          "authorization": "Basic dGVzdC1rZXk6",
          "content-type": "application/json"
        },
        "body": {
          "_limit": 100,
          "query": {
            "type": "and",
            "queries": [
              {
                "type": "object_type",
                "object_type": "lead"
              },
              {
                "type": "field_condition",
                "field": {
                  "type": "regular_field",
                  "object_type": "lead",
                  "field_name": "status_id"
                },
                "condition": {
                  "type": "reference",
                  "reference_type": "status.lead",
                  "object_ids": [
                    "stat_1",
                    "stat_2"
                  ]
                }
              }
            ]
          },
          "_fields": {
            "lead": [
              "id",
              "name",
              "status_label",
              "contacts"
            ],
            "contact": [
              "id",
              "name",
              "emails",
              "phones"
            ]
          }
        }
      }
    }
  ],
  "output": {
    "found": true,
    "result": [
      {
        "id": "lead_1",
        "name": "Acme",
        "status_label": "Potential",
        "contacts": []
      }
    ]
  }
}
