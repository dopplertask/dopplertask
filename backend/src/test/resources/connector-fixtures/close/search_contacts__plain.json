{
  "package": "@activepieces/piece-close",
  "version": "0.3.2",
  "action": "search_contacts",
  "auth": {
    "type": "SECRET_TEXT",
    "secret_text": "test-key"
  },
  "inputs": {
    "text": " Jane "
  },
  "credential": {
    "apiKey": "test-key"
  },
  "answers": [
    {
      "status": 200,
      "body": {
        "data": [],
        "cursor": null
      }
    }
  ],
  "exchanges": [
    {
      "request": {
        "method": "POST",
        "url": "https://api.close.com/api/v1/data/search/",
        "headers": {
          "authorization": "Basic dGVzdC1rZXk6",
          "content-type": "application/json"
        },
        "body": {
          "query": {
            "type": "and",
            "queries": [
              {
                "type": "object_type",
                "object_type": "contact"
              },
              {
                "type": "text",
                "value": "Jane",
                "mode": "full_words"
              }
            ]
          },
          "_limit": 25,
          "_fields": {
            "contact": [
              "id",
              "lead_id",
              "name",
              "title",
              "emails",
              "phones",
              "urls",
              "custom",
              "date_created",
              "date_updated"
            ]
          },
          "sort": [
            {
              "field": {
                "type": "regular_field",
                "object_type": "contact",
                "field_name": "date_created"
              },
              "direction": "desc"
            }
          ]
        }
      }
    }
  ],
  "output": {
    "items": [],
    "count": 0,
    "hasMore": false,
    "nextCursor": null
  }
}
