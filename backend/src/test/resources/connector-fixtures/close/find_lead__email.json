{
  "package": "@activepieces/piece-close",
  "version": "0.3.2",
  "action": "find_lead",
  "auth": {
    "type": "SECRET_TEXT",
    "secret_text": "test-key"
  },
  "inputs": {
    "search_type": "contact_email",
    "search_query": "jane@acme.example",
    "match_type": "exact"
  },
  "credential": {
    "apiKey": "test-key"
  },
  "answers": [
    {
      "status": 200,
      "body": {
        "data": [
          {
            "id": "lead_1",
            "name": "Acme",
            "status_label": "Potential",
            "contacts": []
          }
        ],
        "cursor": ""
      }
    }
  ],
  "exchanges": [
    {
      "request": {
        "method": "POST",
        "url": "https://api.close.com/api/v1/data/search/",
        "headers": {
          "authorization": "Basic dGVzdC1rZXk6",
          "content-type": "application/json"
        },
        "body": {
          "_limit": 100,
          "query": {
            "type": "and",
            "queries": [
              {
                "type": "object_type",
                "object_type": "lead"
              },
              {
                "type": "has_related",
                "this_object_type": "lead",
                "related_object_type": "contact",
                "related_query": {
                  "type": "has_related",
                  "this_object_type": "contact",
                  "related_object_type": "contact_email",
                  "related_query": {
                    "type": "field_condition",
                    "field": {
                      "type": "regular_field",
                      "object_type": "contact_email",
                      "field_name": "email"
                    },
                    "condition": {
                      "type": "text",
                      "mode": "phrase",
                      "value": "jane@acme.example"
                    }
                  }
                }
              }
            ]
          },
          "_fields": {
            "lead": [
              "id",
              "name",
              "status_label",
              "contacts"
            ],
            "contact": [
              "id",
              "name",
              "emails",
              "phones"
            ]
          }
        }
      }
    }
  ],
  "output": {
    "found": true,
    "result": [
      {
        "id": "lead_1",
        "name": "Acme",
        "status_label": "Potential",
        "contacts": []
      }
    ]
  }
}
