{
  "package": "@activepieces/piece-close",
  "version": "0.3.2",
  "action": "find_contact",
  "auth": {
    "type": "SECRET_TEXT",
    "secret_text": "test-key"
  },
  "inputs": {
    "search_type": "lead_id",
    "search_query": " lead_1 ",
    "match_type": "contains"
  },
  "credential": {
    "apiKey": "test-key"
  },
  "answers": [
    {
      "status": 200,
      "body": {
        "data": [
          {
            "id": "cont_1",
            "lead_id": "lead_1"
          }
        ]
      }
    }
  ],
  "exchanges": [
    {
      "request": {
        "method": "POST",
        "url": "https://api.close.com/api/v1/data/search/",
        "headers": {
          "authorization": "Basic dGVzdC1rZXk6",
          "content-type": "application/json"
        },
        "body": {
          "_limit": 100,
          "query": {
            "type": "and",
            "queries": [
              {
                "type": "object_type",
                "object_type": "contact"
              },
              {
                "type": "field_condition",
                "field": {
                  "type": "regular_field",
                  "object_type": "contact",
                  "field_name": "lead_id"
                },
                "condition": {
                  "type": "reference",
                  "reference_type": "lead",
                  "object_ids": [
                    "lead_1"
                  ]
                }
              }
            ]
          },
          "_fields": {
            "lead": [
              "id",
              "name",
              "status_label",
              "contacts"
            ],
            "contact": [
              "title",
              "id",
              "name",
              "emails",
              "lead_id",
              "phones"
            ]
          }
        }
      }
    }
  ],
  "output": {
    "found": true,
    "result": [
      {
        "id": "cont_1",
        "lead_id": "lead_1"
      }
    ]
  }
