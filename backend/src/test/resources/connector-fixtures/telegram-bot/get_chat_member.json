{
  "package": "@activepieces/piece-telegram-bot",
  "version": "0.9.3",
  "action": "get_chat_member",
  "auth": {
    "type": "SECRET_TEXT",
    "secret_text": "123456789:AAE-fake_Secret"
  },
  "inputs": {
    "chat_id": "-1001234567890",
    "user_id": "42"
  },
  "credential": {
    "botId": "123456789",
    "botSecret": "AAE-fake_Secret"
  },
  "answers": [
    {
      "status": 200,
      "body": {
        "ok": true,
        "result": {
          "user": {
            "id": 42,
            "is_bot": false,
            "first_name": "Ada"
          },
          "status": "member"
        }
      }
    }
  ],
  "exchanges": [
    {
      "request": {
        "method": "POST",
        "url": "https://api.telegram.org/bot123456789:AAE-fake_Secret/getChatMember",
        "headers": {
          "content-type": "application/json"
        },
        "body": {
          "chat_id": "-1001234567890",
          "user_id": "42"
        }
      }
    }
  ],
  "output": {
    "ok": true,
    "result": {
      "user": {
        "id": 42,
        "is_bot": false,
        "first_name": "Ada"
      },
      "status": "member"
    }
  }
}
