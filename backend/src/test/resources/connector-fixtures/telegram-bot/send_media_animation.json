{
  "package": "@activepieces/piece-telegram-bot",
  "version": "0.9.3",
  "action": "send_media",
  "auth": {
    "type": "SECRET_TEXT",
    "secret_text": "123456789:AAE-fake_Secret"
  },
  "inputs": {
    "chat_id": "123456789",
    "media_type": "animation",
    "media": {
      "animationId": "CgACAgIAAxkBAAIBfake",
      "duration": 5
    },
    "message": "A GIF",
    "format": "None"
  },
  "credential": {
    "botId": "123456789",
    "botSecret": "AAE-fake_Secret"
  },
  "answers": [
    {
      "status": 200,
      "body": {
        "ok": true,
        "result": {
          "message_id": 21,
          "chat": {
            "id": 123456789,
            "type": "private"
          },
          "date": 1686050152,
          "text": "Hello world"
        }
      }
    }
  ],
  "exchanges": [
    {
      "request": {
        "method": "POST",
        "url": "https://api.telegram.org/bot123456789:AAE-fake_Secret/sendAnimation",
        "headers": {
          "content-type": "application/json"
        },
        "body": {
          "animation": "CgACAgIAAxkBAAIBfake",
          "chat_id": "123456789",
          "caption": "A GIF",
          "disable_notification": false,
          "protect_content": false,
          "duration": 5
        }
      }
    }
  ],
  "output": {
    "status": 200,
    "headers": {
      "content-type": "application/json"
    },
    "body": {
      "ok": true,
      "result": {
        "message_id": 21,
        "chat": {
          "id": 123456789,
          "type": "private"
        },
        "date": 1686050152,
        "text": "Hello world"
      }
    }
  }
}
