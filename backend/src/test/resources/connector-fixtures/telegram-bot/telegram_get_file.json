{
  "package": "@activepieces/piece-telegram-bot",
  "version": "0.9.3",
  "action": "telegram_get_file",
  "auth": {
    "type": "SECRET_TEXT",
    "secret_text": "123456789:AAE-fake_Secret"
  },
  "inputs": {
    "file_id": "BQACAgIAAxkBAAIBfake"
  },
  "credential": {
    "botId": "123456789",
    "botSecret": "AAE-fake_Secret"
  },
  "answers": [
    {
      "status": 200,
      "body": {
        "ok": true,
        "result": {
          "file_id": "BQACAgIAAxkBAAIBfake",
          "file_unique_id": "AgADfake",
          "file_size": 1024,
          "file_path": "documents/file_1.pdf"
        }
      }
    }
  ],
  "exchanges": [
    {
      "request": {
        "method": "POST",
        "url": "https://api.telegram.org/bot123456789:AAE-fake_Secret/getFile",
        "headers": {
          "content-type": "application/json"
        },
        "body": {
          "file_id": "BQACAgIAAxkBAAIBfake"
        }
      }
    }
  ],
  "output": {
    "file_info": {
      "file_id": "BQACAgIAAxkBAAIBfake",
      "file_unique_id": "AgADfake",
      "file_size": 1024,
      "file_path": "documents/file_1.pdf"
    }
  }
}
