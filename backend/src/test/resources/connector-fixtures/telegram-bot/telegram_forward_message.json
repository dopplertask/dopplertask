{
  "package": "@activepieces/piece-telegram-bot",
  "version": "0.9.3",
  "action": "telegram_forward_message",
  "auth": {
    "type": "SECRET_TEXT",
    "secret_text": "123456789:AAE-fake_Secret"
  },
  "inputs": {
    "chat_id": "123456789",
    "from_chat_id": "@examplechannel",
    "message_thread_id": "7",
    "disable_notification": true,
    "protect_content": true,
    "message_id": "21"
  },
  "credential": {
    "botId": "123456789",
    "botSecret": "AAE-fake_Secret"
  },
  "answers": [
    {
      "status": 200,
      "body": {
        "ok": true,
        "result": {
          "message_id": 21,
          "chat": {
            "id": 123456789,
            "type": "private"
          },
          "date": 1686050152,
          "text": "Hello world"
        }
      }
    }
  ],
  "exchanges": [
    {
      "request": {
        "method": "POST",
        "url": "https://api.telegram.org/bot123456789:AAE-fake_Secret/forwardMessage",
        "headers": {
          "content-type": "application/json"
        },
        "body": {
          "chat_id": "123456789",
          "from_chat_id": "@examplechannel",
          "message_id": "21",
          "message_thread_id": "7",
          "disable_notification": true,
          "protect_content": true
        }
      }
    }
  ],
  "output": {
    "status": 200,
    "headers": {
      "content-type": "application/json"
    },
    "body": {
      "ok": true,
      "result": {
        "message_id": 21,
        "chat": {
          "id": 123456789,
          "type": "private"
        },
        "date": 1686050152,
        "text": "Hello world"
      }
    }
  }
}
