{
  "package": "@activepieces/piece-telegram-bot",
  "version": "0.9.3",
  "action": "get_chat",
  "auth": {
    "type": "SECRET_TEXT",
    "secret_text": "123456789:AAE-fake_Secret"
  },
  "inputs": {
    "chat_id": "-1001234567890"
  },
  "credential": {
    "botId": "123456789",
    "botSecret": "AAE-fake_Secret"
  },
  "answers": [
    {
      "status": 200,
      "body": {
        "ok": true,
        "result": {
          "id": -1001234567890,
          "type": "supergroup",
          "title": "Example Group"
        }
      }
    }
  ],
  "exchanges": [
    {
      "request": {
        "method": "POST",
        "url": "https://api.telegram.org/bot123456789:AAE-fake_Secret/getChat",
        "headers": {
          "content-type": "application/json"
        },
        "body": {
          "chat_id": "-1001234567890"
        }
      }
    }
  ],
  "output": {
    "ok": true,
    "result": {
      "id": -1001234567890,
      "type": "supergroup",
      "title": "Example Group"
    }
  }
}
