{
  "package": "@activepieces/piece-telegram-bot",
  "version": "0.9.3",
  "action": "send_text_message",
  "auth": {
    "type": "SECRET_TEXT",
    "secret_text": "123456789:AAE-fake_Secret"
  },
  "inputs": {
    "chat_id": "123456789",
    "message": "Hello *world*",
    "message_thread_id": "7",
    "web_page_preview": true,
    "disable_notification": true,
    "protect_content": false,
    "reply_to_message_id": 20,
    "reply_markup": {
      "inline_keyboard": [
        [
          {
            "text": "Open",
            "url": "https://example.com"
          }
        ]
      ]
    },
    "format": "MarkdownV2"
  },
  "credential": {
    "botId": "123456789",
    "botSecret": "AAE-fake_Secret"
  },
  "answers": [
    {
      "status": 200,
      "body": {
        "ok": true,
        "result": {
          "message_id": 21,
          "chat": {
            "id": 123456789,
            "type": "private"
          },
          "date": 1686050152,
          "text": "Hello world"
        }
      }
    }
  ],
  "exchanges": [
    {
      "request": {
        "method": "POST",
        "url": "https://api.telegram.org/bot123456789:AAE-fake_Secret/sendMessage",
        "headers": {
          "content-type": "application/json"
        },
        "body": {
          "chat_id": "123456789",
          "text": "Hello *world*",
          "message_thread_id": "7",
          "parse_mode": "MarkdownV2",
          "reply_markup": {
            "inline_keyboard": [
              [
                {
                  "text": "Open",
                  "url": "https://example.com"
                }
              ]
            ]
          },
          "disable_web_page_preview": true,
          "disable_notification": true,
          "protect_content": false,
          "reply_to_message_id": 20
        }
      }
    }
  ],
  "output": {
    "status": 200,
    "headers": {
      "content-type": "application/json"
    },
    "body": {
      "ok": true,
      "result": {
        "message_id": 21,
        "chat": {
          "id": 123456789,
          "type": "private"
        },
        "date": 1686050152,
        "text": "Hello world"
      }
    }
  }
}
