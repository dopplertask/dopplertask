{
  "package": "@activepieces/piece-telegram-bot",
  "version": "0.9.3",
  "action": "request_approval_message",
  "auth": {
    "type": "SECRET_TEXT",
    "secret_text": "123456789:AAE-fake_Secret"
  },
  "inputs": {
    "chat_id": "@team channel",
    "message": "Approve *order 1042*?",
    "parse_mode": "MarkdownV2"
  },
  "credential": {
    "botId": "123456789",
    "botSecret": "AAE-fake_Secret"
  },
  "answers": [
    {
      "status": 200,
      "body": {
        "ok": true,
        "result": {
          "message_id": 21,
          "chat": {
            "id": 123456789,
            "type": "private"
          },
          "date": 1686050152,
          "text": "Approve order 1042?"
        }
      }
    }
  ],
  "answer": {
    "query": {
      "chat_id": "@team channel",
      "action": "approve"
    }
  },
  "exchanges": [
    {
      "request": {
        "method": "POST",
        "url": "https://api.telegram.org/bot123456789:AAE-fake_Secret/sendMessage",
        "headers": {
          "content-type": "application/json"
        },
        "body": {
          "chat_id": "@team channel",
          "text": "Approve *order 1042*?",
          "parse_mode": "MarkdownV2",
          "reply_markup": {
            "inline_keyboard": [
              [
                {
                  "text": "Review & Respond",
                  "url": "https://tasks.example.com/hooks/resume/test-key/confirm?chat_id=%40team%20channel"
                }
              ]
            ]
          }
        }
      }
    }
  ],
  "output": {
    "approved": true,
    "chatId": "@team channel"
  }
}
