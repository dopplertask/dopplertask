{
  "package": "@activepieces/piece-telegram-bot",
  "version": "0.9.3",
  "auth": {
    "type": "SECRET_TEXT",
    "secret_text": "123456789:AAE-fake_Secret"
  },
  "action": "telegram_get_chat_administrators",
  "inputs": {
    "chat_id": "-1001234567890"
  },
  "credential": {
    "botId": "123456789",
    "botSecret": "AAE-fake_Secret"
  },
  "answers": [
    {
      "status": 200,
      "body": {
        "ok": true,
        "result": [
          {
            "user": {
              "id": 111111111,
              "is_bot": false,
              "first_name": "Jane"
            },
            "status": "creator",
            "is_anonymous": false
          },
          {
            "user": {
              "id": 123456789,
              "is_bot": true,
              "first_name": "Example Bot",
              "username": "example_bot"
            },
            "status": "administrator",
            "can_be_edited": false,
            "can_delete_messages": true
          }
        ]
      }
    }
  ],
  "exchanges": [
    {
      "request": {
        "method": "POST",
        "url": "https://api.telegram.org/bot123456789:AAE-fake_Secret/getChatAdministrators",
        "headers": {
          "content-type": "application/json"
        },
        "body": {
          "chat_id": "-1001234567890"
        }
      }
    }
  ],
  "output": {
    "ok": true,
    "result": [
      {
        "user": {
          "id": 111111111,
          "is_bot": false,
          "first_name": "Jane"
        },
        "status": "creator",
        "is_anonymous": false
      },
      {
        "user": {
          "id": 123456789,
          "is_bot": true,
          "first_name": "Example Bot",
          "username": "example_bot"
        },
        "status": "administrator",
        "can_be_edited": false,
        "can_delete_messages": true
      }
    ]
  }
}
