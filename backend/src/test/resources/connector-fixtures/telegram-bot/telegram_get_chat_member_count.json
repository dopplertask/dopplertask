{
  "package": "@activepieces/piece-telegram-bot",
  "version": "0.9.3",
  "auth": {
    "type": "SECRET_TEXT",
    "secret_text": "123456789:AAE-fake_Secret"
  },
  "action": "telegram_get_chat_member_count",
  "inputs": {
    "chat_id": "@examplechannel"
  },
  "credential": {
    "botId": "123456789",
    "botSecret": "AAE-fake_Secret"
  },
  "answers": [
    {
      "status": 200,
      "body": {
        "ok": true,
        "result": 42
      }
    }
  ],
  "exchanges": [
    {
      "request": {
        "method": "POST",
        "url": "https://api.telegram.org/bot123456789:AAE-fake_Secret/getChatMemberCount",
        "headers": {
          "content-type": "application/json"
        },
        "body": {
          "chat_id": "@examplechannel"
        }
      }
    }
  ],
  "output": {
    "ok": true,
    "result": 42
  }
}
