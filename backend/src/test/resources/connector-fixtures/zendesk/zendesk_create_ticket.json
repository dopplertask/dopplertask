{
  "package": "@activepieces/piece-zendesk",
  "version": "0.5.3",
  "action": "zendesk_create_ticket",
  "auth": {
    "type": "CUSTOM_AUTH",
    "props": {
      "email": "ada@example.com",
      "token": "zd-test-token",
      "subdomain": "acme"
    }
  },
  "inputs": {
    "comment_body": "comment body value",
    "comment_is_html": false,
    "comment_public": "true",
    "subject": "subject value",
    "requester_email": "requester@example.com",
    "requester_name": "requester name value",
    "assignee_id": "12345",
    "group_id": "12345",
    "organization_id": "12345",
    "status": "new",
    "priority": "low",
    "type": "question",
    "problem_id": "12345",
    "due_at": "2026-01-02T10:00:00.000Z",
    "tags": [
      "vip",
      "urgent"
    ],
    "external_id": "12345",
    "brand_id": "12345",
    "ticket_form_id": "12345",
    "custom_fields": [
      {
        "id": 360001,
        "value": "gold"
      }
    ],
    "additional_fields": {
      "recipient": "help@acme.com"
    }
  },
  "credential": {
    "email": "ada@example.com",
    "token": "zd-test-token",
    "subdomain": "acme"
  },
  "answers": [
    {
      "status": 200,
      "body": {
        "ticket": {
          "id": 1,
          "name": "One"
        }
      }
    }
  ],
  "exchanges": [
    {
      "request": {
        "method": "POST",
        "url": "https://acme.zendesk.com/api/v2/tickets.json",
        "headers": {
          "authorization": "Basic YWRhQGV4YW1wbGUuY29tL3Rva2VuOnpkLXRlc3QtdG9rZW4=",
          "content-type": "application/json"
        },
        "body": {
          "ticket": {
            "recipient": "help@acme.com",
            "subject": "subject value",
            "comment": {
              "body": "comment body value",
              "public": true
            },
            "requester": {
              "email": "requester@example.com",
              "name": "requester name value"
            },
            "assignee_id": 12345,
            "group_id": 12345,
            "organization_id": 12345,
            "status": "new",
            "priority": "low",
            "type": "question",
            "problem_id": 12345,
            "due_at": "2026-01-02T10:00:00.000Z",
            "tags": [
              "vip",
              "urgent"
            ],
            "external_id": "12345",
            "brand_id": 12345,
            "ticket_form_id": 12345,
            "custom_fields": [
              {
                "id": 360001,
                "value": "gold"
              }
            ]
          }
        }
      }
    }
  ],
  "output": {
    "id": 1,
    "name": "One"
  }
