{
  "package": "@activepieces/piece-zendesk",
  "version": "0.5.3",
  "action": "zendesk_update_custom_object_record",
  "auth": {
    "type": "CUSTOM_AUTH",
    "props": {
      "email": "ada@example.com",
      "token": "zd-test-token",
      "subdomain": "acme"
    }
  },
  "inputs": {
    "custom_object_key": "car",
    "record_id": "12345",
    "name": "name value",
    "external_id": "12345",
    "custom_object_fields": {
      "color": "blue"
    }
  },
  "credential": {
    "email": "ada@example.com",
    "token": "zd-test-token",
    "subdomain": "acme"
  },
  "answers": [
    {
      "status": 200,
      "body": {
        "custom_object_record": {
          "id": 1,
          "name": "One"
        }
      }
    }
  ],
  "exchanges": [
    {
      "request": {
        "method": "PATCH",
        "url": "https://acme.zendesk.com/api/v2/custom_objects/car/records/12345.json",
        "headers": {
          "authorization": "Basic YWRhQGV4YW1wbGUuY29tL3Rva2VuOnpkLXRlc3QtdG9rZW4=",
          "content-type": "application/json"
        },
        "body": {
          "custom_object_record": {
            "name": "name value",
            "external_id": "12345",
            "custom_object_fields": {
              "color": "blue"
            }
          }
        }
      }
    }
  ],
  "output": {
    "id": 1,
    "name": "One"
  }
}
