{
  "package": "@activepieces/piece-zendesk",
  "version": "0.5.3",
  "action": "delete-user",
  "auth": {
    "type": "CUSTOM_AUTH",
    "props": {
      "email": "ada@example.com",
      "token": "zd-test-token",
      "subdomain": "acme"
    }
  },
  "inputs": {
    "user_id": "777",
    "confirmation": true
  },
  "credential": {
    "email": "ada@example.com",
    "token": "zd-test-token",
    "subdomain": "acme"
  },
  "answers": [
    {
      "status": 200,
      "body": {
        "user": {
          "id": 777,
          "active": false
        }
      }
    }
  ],
  "exchanges": [
    {
      "request": {
        "method": "DELETE",
        "url": "https://acme.zendesk.com/api/v2/users/777.json",
        "headers": {
          "authorization": "Basic YWRhQGV4YW1wbGUuY29tL3Rva2VuOnpkLXRlc3QtdG9rZW4="
        },
        "body": null
      }
    }
  ],
  "output": {
    "success": true,
    "message": "User 777 has been deleted",
    "data": {
      "user": {
        "id": 777,
        "active": false
      }
    },
    "warning": "Deleted users are not recoverable in Zendesk UI. For GDPR erasure, use 'Permanently Delete User' if required.",
    "note": "To comply with GDPR, you may need to use the \"Permanently Delete User\" endpoint for complete data removal."
  }
}
