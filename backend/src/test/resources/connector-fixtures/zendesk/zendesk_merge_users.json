{
  "package": "@activepieces/piece-zendesk",
  "version": "0.5.3",
  "action": "zendesk_merge_users",
  "auth": {
    "type": "CUSTOM_AUTH",
    "props": {
      "email": "ada@example.com",
      "token": "zd-test-token",
      "subdomain": "acme"
    }
  },
  "inputs": {
    "source_user_id": "12345",
    "target_user_id": "67890"
  },
  "credential": {
    "email": "ada@example.com",
    "token": "zd-test-token",
    "subdomain": "acme"
  },
  "answers": [
    {
      "status": 200,
      "body": {
        "user": {
          "id": 1,
          "name": "One"
        }
      }
    }
  ],
  "exchanges": [
    {
      "request": {
        "method": "PUT",
        "url": "https://acme.zendesk.com/api/v2/users/12345/merge.json",
        "headers": {
          "authorization": "Basic YWRhQGV4YW1wbGUuY29tL3Rva2VuOnpkLXRlc3QtdG9rZW4=",
          "content-type": "application/json"
        },
        "body": {
          "user": {
            "id": 67890
          }
        }
      }
    }
  ],
  "output": {
    "id": 1,
    "name": "One"
  }
}
