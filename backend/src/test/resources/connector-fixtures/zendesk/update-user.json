{
  "package": "@activepieces/piece-zendesk",
  "version": "0.5.3",
  "action": "update-user",
  "auth": {
    "type": "CUSTOM_AUTH",
    "props": {
      "email": "ada@example.com",
      "token": "zd-test-token",
      "subdomain": "acme"
    }
  },
  "inputs": {
    "user_id": "12345",
    "name": " Ada L ",
    "email": "email@example.com",
    "phone": "phone value",
    "tags": [
      "vip",
      "urgent"
    ],
    "user_fields": {
      "field_plan": "gold",
      "empty": ""
    }
  },
  "credential": {
    "email": "ada@example.com",
    "token": "zd-test-token",
    "subdomain": "acme"
  },
  "answers": [
    {
      "status": 200,
      "body": {
        "user": {
          "id": 777,
          "name": "Ada"
        }
      }
    }
  ],
  "exchanges": [
    {
      "request": {
        "method": "PUT",
        "url": "https://acme.zendesk.com/api/v2/users/12345.json",
        "headers": {
          "authorization": "Basic YWRhQGV4YW1wbGUuY29tL3Rva2VuOnpkLXRlc3QtdG9rZW4=",
          "content-type": "application/json"
        },
        "body": {
          "user": {
            "name": "Ada L",
            "email": "email@example.com",
            "phone": "phone value",
            "tags": [
              "vip",
              "urgent"
            ],
            "user_fields": {
              "plan": "gold"
            }
          }
        }
      }
    }
  ],
  "output": {
    "success": true,
    "message": "User updated successfully",
    "data": {
      "user": {
        "id": 777,
        "name": "Ada"
      }
    }
  }
}
