{
  "package": "@activepieces/piece-zendesk",
  "version": "0.5.3",
  "action": "add-comment-to-ticket",
  "auth": {
    "type": "CUSTOM_AUTH",
    "props": {
      "email": "ada@example.com",
      "token": "zd-test-token",
      "subdomain": "acme"
    }
  },
  "inputs": {
    "ticket_id": "12345",
    "comment_body": "comment body value",
    "comment_html_body": "comment html body value",
    "public": true,
    "author_email": "author@example.com",
    "uploads": [
      "tok-1"
    ],
    "via_followup_source_id": 7
  },
  "credential": {
    "email": "ada@example.com",
    "token": "zd-test-token",
    "subdomain": "acme"
  },
  "answers": [
    {
      "status": 200,
      "body": {
        "users": [
          {
            "id": 905,
            "email": "x@example.com"
          }
        ]
      }
    },
    {
      "status": 200,
      "body": {
        "ticket": {
          "id": 12345
        },
        "audit": {
          "id": 7
        }
      }
    }
  ],
  "exchanges": [
    {
      "request": {
        "method": "GET",
        "url": "https://acme.zendesk.com/api/v2/users/search.json?query=email%3Aauthor%40example.com",
        "headers": {
          "authorization": "Basic YWRhQGV4YW1wbGUuY29tL3Rva2VuOnpkLXRlc3QtdG9rZW4="
        },
        "body": null
      }
    },
    {
      "request": {
        "method": "PUT",
        "url": "https://acme.zendesk.com/api/v2/tickets/12345.json",
        "headers": {
          "authorization": "Basic YWRhQGV4YW1wbGUuY29tL3Rva2VuOnpkLXRlc3QtdG9rZW4=",
          "content-type": "application/json"
        },
        "body": {
          "ticket": {
            "comment": {
              "html_body": "comment html body value",
              "public": true,
              "author_id": 905,
              "uploads": [
                "tok-1"
              ],
              "via": {
                "followup_source_id": 7
              }
            }
          }
        }
      }
    }
  ],
  "output": {
    "success": true,
    "message": "Comment added successfully to ticket 12345",
    "data": {
      "ticket": {
        "id": 12345
      },
      "audit": {
        "id": 7
      }
    },
    "comment_details": {
      "is_public": true,
      "has_attachments": true,
      "content_type": "html"
    }
  }
}
