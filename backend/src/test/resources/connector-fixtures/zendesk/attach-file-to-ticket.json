{
  "package": "@activepieces/piece-zendesk",
  "version": "0.5.3",
  "auth": {
    "type": "CUSTOM_AUTH",
    "props": {
      "email": "ada@example.com",
      "token": "zd-test-token",
      "subdomain": "acme"
    }
  },
  "action": "attach-file-to-ticket",
  "inputs": {
    "ticket_id": "12345"
  },
  "files": {
    "file": {
      "name": "report (1).txt",
      "base64": "aGVsbG8gemVuZGVzaw=="
    }
  },
  "credential": {
    "email": "ada@example.com",
    "token": "zd-test-token",
    "subdomain": "acme"
  },
  "answers": [
    {
      "status": 201,
      "body": {
        "upload": {
          "token": "tok-1",
          "attachment": {
            "id": 3
          }
        }
      }
    },
    {
      "status": 200,
      "body": {
        "ticket": {
          "id": 12345
        },
        "audit": {
          "id": 9
        }
      }
    }
  ],
  "exchanges": [
    {
      "request": {
        "method": "POST",
        "url": "https://acme.zendesk.com/api/v2/uploads.json?filename=report+%281%29.txt",
        "headers": {
          "authorization": "Basic YWRhQGV4YW1wbGUuY29tL3Rva2VuOnpkLXRlc3QtdG9rZW4=",
          "content-type": "application/octet-stream"
        },
        "body": "hello zendesk"
      }
    },
    {
      "request": {
        "method": "PUT",
        "url": "https://acme.zendesk.com/api/v2/tickets/12345.json",
        "headers": {
          "authorization": "Basic YWRhQGV4YW1wbGUuY29tL3Rva2VuOnpkLXRlc3QtdG9rZW4=",
          "content-type": "application/json"
        },
        "body": {
          "ticket": {
            "comment": {
              "body": "File attached: report (1).txt",
              "uploads": [
                "tok-1"
              ]
            }
          }
        }
      }
    }
  ],
  "output": {
    "success": true,
    "message": "Successfully attached file \"report (1).txt\" to ticket 12345",
    "data": {
      "ticket": {
        "id": 12345
      },
      "audit": {
        "id": 9
      }
    },
    "file_name": "report (1).txt",
    "upload_token": "tok-1"
  }
}
