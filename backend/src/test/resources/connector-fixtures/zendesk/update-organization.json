{
  "package": "@activepieces/piece-zendesk",
  "version": "0.5.3",
  "action": "update-organization",
  "auth": {
    "type": "CUSTOM_AUTH",
    "props": {
      "email": "ada@example.com",
      "token": "zd-test-token",
      "subdomain": "acme"
    }
  },
  "inputs": {
    "organization_id": "456",
    "name": "name value",
    "details": "details value",
    "notes": "notes value",
    "external_id": "12345",
    "group_id": "89",
    "domain_names": [
      "acme.com"
    ],
    "tags": [
      "vip",
      "urgent"
    ],
    "organization_fields": {
      "field_tier": "gold"
    },
    "shared_tickets": true,
    "shared_comments": true
  },
  "credential": {
    "email": "ada@example.com",
    "token": "zd-test-token",
    "subdomain": "acme"
  },
  "answers": [
    {
      "status": 200,
      "body": {
        "organization_fields": [
          {
            "key": "tier",
            "type": "text"
          }
        ]
      }
    },
    {
      "status": 200,
      "body": {
        "organization": {
          "id": 456,
          "name": "Acme"
        }
      }
    }
  ],
  "exchanges": [
    {
      "request": {
        "method": "GET",
        "url": "https://acme.zendesk.com/api/v2/organization_fields.json",
        "headers": {
          "authorization": "Basic YWRhQGV4YW1wbGUuY29tL3Rva2VuOnpkLXRlc3QtdG9rZW4="
        },
        "body": null
      }
    },
    {
      "request": {
        "method": "PUT",
        "url": "https://acme.zendesk.com/api/v2/organizations/456.json",
        "headers": {
          "authorization": "Basic YWRhQGV4YW1wbGUuY29tL3Rva2VuOnpkLXRlc3QtdG9rZW4=",
          "content-type": "application/json"
        },
        "body": {
          "organization": {
            "name": "name value",
            "details": "details value",
            "notes": "notes value",
            "external_id": "12345",
            "group_id": "89",
            "domain_names": [
              "acme.com"
            ],
            "tags": [
              "vip",
              "urgent"
            ],
            "shared_tickets": true,
            "shared_comments": true,
            "organization_fields": {
              "tier": "gold"
            }
          }
        }
      }
    }
  ],
  "output": {
    "success": true,
    "message": "Organization updated successfully",
    "data": {
      "organization": {
        "id": 456,
        "name": "Acme"
      }
    }
  }
}
