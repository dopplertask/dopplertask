{
  "package": "@activepieces/piece-zendesk",
  "version": "0.5.3",
  "action": "zendesk_update_user",
  "auth": {
    "type": "CUSTOM_AUTH",
    "props": {
      "email": "ada@example.com",
      "token": "zd-test-token",
      "subdomain": "acme"
    }
  },
  "inputs": {
    "user_id": "12345",
    "name": "name value",
