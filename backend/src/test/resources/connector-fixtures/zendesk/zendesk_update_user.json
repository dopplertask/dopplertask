          "content-type": "application/json"
        },
        "body": {
          "user": {
            "note": "x",
            "name": "name value",
            "email": "email@example.com",
            "phone": "phone value",
            "role": "end-user",
            "organization_id": 12345,
            "external_id": "12345",
            "tags": [
              "vip",
              "urgent"
            ],
            "user_fields": {
              "note": "x"
            },
            "details": "details value",
            "notes": "notes value",
            "verified": true,
            "suspended": true
          }
        }
      }
    }
  ],
  "output": {
    "id": 1,
    "name": "One"
  }
}
