{
  "package": "@activepieces/piece-zendesk",
  "version": "0.5.3",
  "auth": {
    "type": "CUSTOM_AUTH",
    "props": {
      "email": "ada@example.com",
      "token": "zd-test-token",
      "subdomain": "acme"
    }
  },
  "action": "zendesk_upsert_custom_object_record",
  "inputs": {
    "custom_object_key": "car",
    "external_id": "ext 9",
    "name": "Blue car",
    "custom_object_fields": {
      "color": "blue"
    }
  },
  "credential": {
    "email": "ada@example.com",
    "token": "zd-test-token",
    "subdomain": "acme"
  },
  "answers": [
    {
      "status": 201,
      "body": {
        "custom_object_record": {
          "id": "r1",
          "name": "Blue car"
        }
      }
    }
  ],
  "exchanges": [
    {
      "request": {
        "method": "PATCH",
        "url": "https://acme.zendesk.com/api/v2/custom_objects/car/records.json?external_id=ext+9",
        "headers": {
          "authorization": "Basic YWRhQGV4YW1wbGUuY29tL3Rva2VuOnpkLXRlc3QtdG9rZW4=",
          "content-type": "application/json"
        },
        "body": {
          "custom_object_record": {
            "name": "Blue car",
            "custom_object_fields": {
              "color": "blue"
            }
          }
        }
      }
    }
  ],
  "output": {
    "created": true,
    "custom_object_record": {
      "id": "r1",
      "name": "Blue car"
    }
  }
}
