{
  "package": "@activepieces/piece-zendesk",
  "version": "0.5.3",
  "action": "zendesk_merge_tickets",
  "auth": {
    "type": "CUSTOM_AUTH",
    "props": {
      "email": "ada@example.com",
      "token": "zd-test-token",
      "subdomain": "acme"
    }
  },
  "inputs": {
    "target_ticket_id": "12345",
    "source_ticket_ids": [
      "101",
      "102"
    ],
    "target_comment": "target comment value",
    "target_comment_is_public": true,
    "source_comment": "source comment value",
    "source_comment_is_public": false
  },
  "credential": {
    "email": "ada@example.com",
    "token": "zd-test-token",
    "subdomain": "acme"
  },
  "answers": [
    {
      "status": 200,
      "body": {
        "job_status": {
          "id": 1,
          "name": "One"
        }
      }
    }
  ],
  "exchanges": [
    {
      "request": {
        "method": "POST",
        "url": "https://acme.zendesk.com/api/v2/tickets/12345/merge.json",
        "headers": {
          "authorization": "Basic YWRhQGV4YW1wbGUuY29tL3Rva2VuOnpkLXRlc3QtdG9rZW4=",
          "content-type": "application/json"
        },
        "body": {
          "ids": [
            101,
            102
          ],
          "target_comment": "target comment value",
          "target_comment_is_public": true,
          "source_comment": "source comment value",
          "source_comment_is_public": false
        }
      }
    }
  ],
  "output": {
    "id": 1,
    "name": "One"
  }
}
