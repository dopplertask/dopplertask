{
  "package": "@activepieces/piece-zendesk",
  "version": "0.5.3",
  "action": "zendesk_add_ticket_comment",
  "auth": {
    "type": "CUSTOM_AUTH",
    "props": {
      "email": "ada@example.com",
      "token": "zd-test-token",
      "subdomain": "acme"
    }
  },
  "inputs": {
    "ticket_id": "12345",
    "body": "body value",
    "is_html": true,
    "public": "true",
    "author_id": "12345",
    "status": "new"
  },
  "credential": {
    "email": "ada@example.com",
    "token": "zd-test-token",
    "subdomain": "acme"
  },
  "answers": [
    {
      "status": 200,
      "body": {
        "ticket": {
          "id": 12345
        },
        "audit": {
          "id": 9
        }
      }
    }
  ],
  "exchanges": [
    {
      "request": {
        "method": "PUT",
        "url": "https://acme.zendesk.com/api/v2/tickets/12345.json",
        "headers": {
          "authorization": "Basic YWRhQGV4YW1wbGUuY29tL3Rva2VuOnpkLXRlc3QtdG9rZW4=",
          "content-type": "application/json"
        },
        "body": {
          "ticket": {
            "comment": {
              "html_body": "body value",
              "public": true,
              "author_id": 12345
            },
            "status": "new"
          }
        }
      }
    }
  ],
  "output": {
    "ticket": {
      "id": 12345
    },
    "audit": {
      "id": 9
    }
  }
}
