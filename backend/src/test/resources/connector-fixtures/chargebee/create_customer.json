{
  "package": "@activepieces/piece-chargebee",
  "version": "0.1.3",
  "action": "create_customer",
  "auth": {
    "type": "CUSTOM_AUTH",
    "props": {
      "site": "acme-test",
      "api_key": "test_key"
    }
  },
  "inputs": {
    "id": "cus_1",
    "first_name": "Ada",
    "last_name": "Lovelace",
    "email": "ada@example.com",
    "company": "Acme Ltd",
    "phone": "+46 70 123 45 67",
    "locale": "en-US",
    "preferred_currency_code": "USD",
    "auto_collection": "on",
    "net_term_days": 30,
    "allow_direct_debit": true,
    "vat_number": "SE556677889901",
    "taxability": "taxable",
    "invoice_notes": "Thanks for your order",
    "meta_data": {
      "source": "web",
      "tier": "gold"
    }
  },
  "credential": {
    "site": "acme-test",
    "api_key": "test_key"
  },
  "answers": [
    {
      "status": 200,
      "body": {
        "customer": {
          "id": "cus_1",
          "email": "ada@example.com"
        }
      }
    }
  ],
  "exchanges": [
    {
      "request": {
        "method": "POST",
        "url": "https://acme-test.chargebee.com/api/v2/customers",
        "headers": {
          "authorization": "Basic dGVzdF9rZXk6",
          "content-type": "application/x-www-form-urlencoded"
        },
        "body": "id=cus_1&first_name=Ada&last_name=Lovelace&email=ada%40example.com&company=Acme%20Ltd&phone=%2B46%2070%20123%2045%2067&locale=en-US&preferred_currency_code=USD&auto_collection=on&net_term_days=30&allow_direct_debit=true&vat_number=SE556677889901&taxability=taxable&invoice_notes=Thanks%20for%20your%20order&meta_data=%7B%22source%22%3A%22web%22%2C%22tier%22%3A%22gold%22%7D"
      }
    }
  ],
  "output": {
    "customer": {
      "id": "cus_1",
      "email": "ada@example.com"
    }
  }
}
