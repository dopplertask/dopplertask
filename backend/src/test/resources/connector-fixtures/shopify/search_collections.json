{
  "package": "@activepieces/piece-shopify",
  "version": "0.11.3",
  "action": "search_collections",
  "auth": {
    "type": "CUSTOM_AUTH",
    "props": {
      "shopName": "test-shop",
      "adminToken": "shpat_test_token"
    }
  },
  "inputs": {
    "query": "sample query",
    "sort_key": "TITLE",
    "reverse": true,
    "first": 5,
    "after": "sample after"
  },
  "credential": {
    "shopName": "test-shop",
    "adminToken": "shpat_test_token"
  },
  "answers": [
    {
      "status": 200,
      "body": {
        "data": {
          "collections": {
            "nodes": [
              {
                "id": "gid://shopify/Collection/1001",
                "legacyResourceId": "1001",
                "title": "title-1",
                "handle": "handle-1",
                "sortOrder": "sortOrder-1",
                "updatedAt": "2026-01-02T03:04:05Z",
                "productsCount": {
                  "count": 3
                },
                "image": {
                  "url": "https://example.com/item",
                  "altText": "altText-1"
                }
              }
            ],
            "pageInfo": {
              "hasNextPage": false,
              "endCursor": "cursor-1"
            }
          }
        }
      }
    }
  ],
  "exchanges": [
    {
      "request": {
        "method": "POST",
        "url": "https://test-shop.myshopify.com/admin/api/2026-10/graphql.json",
        "headers": {
          "content-type": "application/json",
          "x-shopify-access-token": "shpat_test_token"
        },
        "body": {
          "query": "query SearchCollections($first: Int!, $after: String, $query: String, $sortKey: CollectionSortKeys, $reverse: Boolean) { collections(first: $first, after: $after, query: $query, sortKey: $sortKey, reverse: $reverse) { nodes { id legacyResourceId title handle sortOrder updatedAt productsCount { count } image { url altText } } pageInfo { hasNextPage endCursor } } }",
          "variables": {
            "first": 5,
            "after": "sample after",
            "query": "sample query",
            "sortKey": "TITLE",
            "reverse": true
          }
        }
      }
    }
  ],
  "output": {
    "items": [
      {
        "id": "gid://shopify/Collection/1001",
        "legacy_resource_id": "1001",
        "title": "title-1",
        "handle": "handle-1",
        "sort_order": "sortOrder-1",
        "updated_at": "2026-01-02T03:04:05Z",
        "products_count": 3,
        "image_url": "https://example.com/item",
        "image_alt": "altText-1"
      }
    ],
    "count": 1,
    "has_next_page": false,
    "end_cursor": "cursor-1",
