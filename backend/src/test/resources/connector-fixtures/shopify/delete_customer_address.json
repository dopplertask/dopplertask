{
  "package": "@activepieces/piece-shopify",
  "version": "0.11.3",
  "action": "delete_customer_address",
  "auth": {
    "type": "CUSTOM_AUTH",
    "props": {
      "shopName": "test-shop",
      "adminToken": "shpat_test_token"
    }
  },
  "inputs": {
    "customer_id": "1001",
    "address_id": "1001"
  },
  "credential": {
    "shopName": "test-shop",
    "adminToken": "shpat_test_token"
  },
  "answers": [
    {
      "status": 200,
      "body": {
        "data": {
          "customerAddressDelete": {
            "deletedAddressId": "deletedAddressId-1",
            "userErrors": []
          }
        }
      }
    }
  ],
  "exchanges": [
    {
      "request": {
        "method": "POST",
        "url": "https://test-shop.myshopify.com/admin/api/2026-10/graphql.json",
        "headers": {
          "content-type": "application/json",
          "x-shopify-access-token": "shpat_test_token"
        },
        "body": {
          "query": "mutation DeleteCustomerAddress($customerId: ID!, $addressId: ID!) { customerAddressDelete(customerId: $customerId, addressId: $addressId) { deletedAddressId userErrors { field message } } }",
          "variables": {
            "customerId": "gid://shopify/Customer/1001",
            "addressId": "gid://shopify/MailingAddress/1001?model_name=CustomerAddress"
          }
        }
      }
    }
  ],
  "output": {
    "customer_id": "gid://shopify/Customer/1001",
    "deleted_address_id": "deletedAddressId-1",
    "redacted_fields": []
  }
}
