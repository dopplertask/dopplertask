{
  "package": "@activepieces/piece-shopify",
  "version": "0.11.3",
  "action": "list_publications",
  "auth": {
    "type": "CUSTOM_AUTH",
    "props": {
      "shopName": "test-shop",
      "adminToken": "shpat_test_token"
    }
  },
  "inputs": {
    "catalog_type": "APP",
    "reverse": true,
    "first": 5,
    "after": "sample after"
  },
  "credential": {
    "shopName": "test-shop",
    "adminToken": "shpat_test_token"
  },
  "answers": [
    {
      "status": 200,
      "body": {
        "data": {
          "publications": {
            "nodes": [
              {
                "id": "gid://shopify/Publication/1001",
                "autoPublish": "autoPublish-1",
                "supportsFuturePublishing": "supportsFuturePublishing-1",
                "catalog": {
                  "id": "gid://shopify/Catalog/1001",
                  "title": "title-1",
                  "status": "status-1"
                }
              }
            ],
            "pageInfo": {
              "hasNextPage": false,
              "endCursor": "cursor-1"
            }
          }
        }
      }
    }
  ],
  "exchanges": [
    {
      "request": {
        "method": "POST",
        "url": "https://test-shop.myshopify.com/admin/api/2026-10/graphql.json",
        "headers": {
          "content-type": "application/json",
          "x-shopify-access-token": "shpat_test_token"
        },
        "body": {
          "query": "query ListPublications($first: Int!, $after: String, $catalogType: CatalogType, $reverse: Boolean) { publications(first: $first, after: $after, catalogType: $catalogType, reverse: $reverse) { nodes { id autoPublish supportsFuturePublishing catalog { id title status } } pageInfo { hasNextPage endCursor } } }",
          "variables": {
            "first": 5,
            "after": "sample after",
            "catalogType": "APP",
            "reverse": true
          }
        }
      }
    }
  ],
  "output": {
    "items": [
      {
        "id": "gid://shopify/Publication/1001",
        "title": "title-1",
        "catalog_id": "gid://shopify/Catalog/1001",
        "catalog_status": "status-1",
        "auto_publish": "autoPublish-1",
        "supports_future_publishing": "supportsFuturePublishing-1"
      }
