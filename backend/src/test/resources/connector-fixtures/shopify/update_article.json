{
  "package": "@activepieces/piece-shopify",
  "version": "0.11.3",
  "action": "update_article",
  "auth": {
    "type": "CUSTOM_AUTH",
    "props": {
      "shopName": "test-shop",
      "adminToken": "shpat_test_token"
    }
  },
  "inputs": {
    "article_id": "1001",
    "title": "sample title",
    "body_html": "<p>Sample text</p>",
    "summary_html": "<p>Sample text</p>",
    "author_name": "sample author name",
    "tags": [
      "sample tag"
    ],
    "is_published": "true",
    "publish_date": "2026-01-02T03:04:05Z",
    "handle": "sample-handle",
    "redirect_new_handle": "true",
    "blog_id": "1001",
    "image_url": "https://example.com/item",
    "image_alt_text": "sample image alt text",
    "template_suffix": "sample template suffix",
    "clear_body": false,
    "clear_tags": false
  },
  "credential": {
    "shopName": "test-shop",
    "adminToken": "shpat_test_token"
  },
  "answers": [
    {
      "status": 200,
      "body": {
        "data": {
          "articleUpdate": {
            "article": {
              "id": "gid://shopify/Article/1001",
              "title": "title-1",
              "handle": "handle-1",
              "summary": "summary-1",
              "tags": [
                "tags-1"
              ],
              "isPublished": true,
              "publishedAt": "2026-01-02T03:04:05Z",
              "templateSuffix": "templateSuffix-1",
              "createdAt": "2026-01-02T03:04:05Z",
              "updatedAt": "2026-01-02T03:04:05Z",
              "author": {
                "name": "name-1"
              },
              "blog": {
                "id": "gid://shopify/Blog/1001",
                "title": "title-1"
              },
              "image": {
                "url": "https://example.com/item",
                "altText": "altText-1"
              },
              "commentsCount": {
                "count": 3
              },
              "body": "body-1"
            },
            "userErrors": []
          }
        }
      }
    }
  ],
  "exchanges": [
    {
      "request": {
        "method": "POST",
        "url": "https://test-shop.myshopify.com/admin/api/2026-10/graphql.json",
        "headers": {
          "content-type": "application/json",
          "x-shopify-access-token": "shpat_test_token"
        },
        "body": {
          "query": "mutation UpdateArticle($id: ID!, $article: ArticleUpdateInput!) { articleUpdate(id: $id, article: $article) { article { id title handle summary tags isPublished publishedAt templateSuffix createdAt updatedAt author { name } blog { id title } image { url altText } commentsCount { count } body } userErrors { field message code } } }",
          "variables": {
            "id": "gid://shopify/Article/1001",
            "article": {
              "title": "sample title",
              "body": "<p>Sample text</p>",
              "summary": "<p>Sample text</p>",
              "author": {
                "name": "sample author name"
              },
              "tags": [
                "sample tag"
              ],
              "isPublished": true,
              "publishDate": "2026-01-02T03:04:05Z",
              "handle": "sample-handle",
              "blogId": "gid://shopify/Blog/1001",
              "image": {
                "url": "https://example.com/item",
                "altText": "sample image alt text"
              },
              "templateSuffix": "sample template suffix",
              "redirectNewHandle": true
            }
          }
        }
      }
    }
  ],
  "output": {
    "id": "gid://shopify/Article/1001",
    "title": "title-1",
    "handle": "handle-1",
    "author_name": "name-1",
    "blog_id": "gid://shopify/Blog/1001",
    "blog_title": "title-1",
    "summary_html": "summary-1",
    "tags": "tags-1",
    "is_published": true,
    "published_at": "2026-01-02T03:04:05Z",
    "template_suffix": "templateSuffix-1",
    "image_url": "https://example.com/item",
    "image_alt_text": "altText-1",
    "comments_count": 3,
    "created_at": "2026-01-02T03:04:05Z",
    "updated_at": "2026-01-02T03:04:05Z",
    "body_html": "body-1",
    "redacted_fields": []
  }
}
