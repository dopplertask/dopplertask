{
  "package": "@activepieces/piece-shopify",
  "version": "0.11.3",
  "action": "list_articles",
  "auth": {
    "type": "CUSTOM_AUTH",
    "props": {
      "shopName": "test-shop",
      "adminToken": "shpat_test_token"
    }
  },
  "inputs": {
    "blog_id": "1001",
    "query": "sample query",
    "sort_key": "ID",
    "reverse": true,
    "first": 5,
    "after": "sample after"
  },
  "credential": {
    "shopName": "test-shop",
    "adminToken": "shpat_test_token"
  },
  "answers": [
    {
      "status": 200,
      "body": {
        "data": {
          "articles": {
            "nodes": [
              {
                "id": "gid://shopify/Article/1001",
                "title": "title-1",
                "handle": "handle-1",
                "summary": "summary-1",
                "tags": [
                  "tags-1"
                ],
                "isPublished": true,
                "publishedAt": "2026-01-02T03:04:05Z",
                "templateSuffix": "templateSuffix-1",
                "createdAt": "2026-01-02T03:04:05Z",
                "updatedAt": "2026-01-02T03:04:05Z",
                "author": {
                  "name": "name-1"
                },
                "blog": {
                  "id": "gid://shopify/Blog/1001",
                  "title": "title-1"
                },
                "image": {
                  "url": "https://example.com/item",
                  "altText": "altText-1"
                },
                "commentsCount": {
                  "count": 3
                }
              }
            ],
            "pageInfo": {
              "hasNextPage": false,
              "endCursor": "cursor-1"
            }
          }
        }
      }
    }
  ],
  "exchanges": [
    {
      "request": {
        "method": "POST",
        "url": "https://test-shop.myshopify.com/admin/api/2026-10/graphql.json",
        "headers": {
          "content-type": "application/json",
          "x-shopify-access-token": "shpat_test_token"
        },
        "body": {
          "query": "query ListArticles($first: Int!, $after: String, $query: String, $sortKey: ArticleSortKeys, $reverse: Boolean) { articles(first: $first, after: $after, query: $query, sortKey: $sortKey, reverse: $reverse) { nodes { id title handle summary tags isPublished publishedAt templateSuffix createdAt updatedAt author { name } blog { id title } image { url altText } commentsCount { count } } pageInfo { hasNextPage endCursor } } }",
          "variables": {
            "first": 5,
            "after": "sample after",
            "query": "blog_id:1001 sample query",
            "sortKey": "ID",
            "reverse": true
          }
        }
      }
    }
  ],
  "output": {
    "items": [
      {
        "id": "gid://shopify/Article/1001",
        "title": "title-1",
        "handle": "handle-1",
        "author_name": "name-1",
        "blog_id": "gid://shopify/Blog/1001",
        "blog_title": "title-1",
        "summary_html": "summary-1",
        "tags": "tags-1",
        "is_published": true,
        "published_at": "2026-01-02T03:04:05Z",
        "template_suffix": "templateSuffix-1",
        "image_url": "https://example.com/item",
        "image_alt_text": "altText-1",
        "comments_count": 3,
        "created_at": "2026-01-02T03:04:05Z",
        "updated_at": "2026-01-02T03:04:05Z"
      }
    ],
    "count": 1,
    "has_next_page": false,
    "end_cursor": "cursor-1",
    "redacted_fields": []
  }
