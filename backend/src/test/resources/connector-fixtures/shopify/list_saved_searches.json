{
  "package": "@activepieces/piece-shopify",
  "version": "0.11.3",
  "action": "list_saved_searches",
  "auth": {
    "type": "CUSTOM_AUTH",
    "props": {
      "shopName": "test-shop",
      "adminToken": "shpat_test_token"
    }
  },
  "inputs": {
    "resource_type": "ORDER",
    "reverse": true,
    "first": 5,
    "after": "sample after"
  },
  "credential": {
    "shopName": "test-shop",
    "adminToken": "shpat_test_token"
  },
  "answers": [
    {
      "status": 200,
      "body": {
        "data": {
          "orderSavedSearches": {
            "nodes": [
              {
                "id": "gid://shopify/OrderSavedSearche/1001",
                "name": "name-1",
                "query": "query-1",
                "searchTerms": "searchTerms-1",
                "resourceType": "resourceType-1"
              }
            ],
            "pageInfo": {
              "hasNextPage": false,
              "endCursor": "cursor-1"
            }
          }
        }
      }
    }
  ],
  "exchanges": [
    {
      "request": {
        "method": "POST",
        "url": "https://test-shop.myshopify.com/admin/api/2026-10/graphql.json",
        "headers": {
          "content-type": "application/json",
          "x-shopify-access-token": "shpat_test_token"
        },
        "body": {
          "query": "query ListSavedSearches($first: Int!, $after: String, $reverse: Boolean) { orderSavedSearches(first: $first, after: $after, reverse: $reverse) { nodes { id name query searchTerms resourceType } pageInfo { hasNextPage endCursor } } }",
          "variables": {
            "first": 5,
            "after": "sample after",
            "reverse": true
          }
        }
      }
    }
  ],
  "output": {
    "items": [
      {
        "id": "gid://shopify/OrderSavedSearche/1001",
        "name": "name-1",
        "query": "query-1",
        "search_terms": "searchTerms-1",
        "resource_type": "resourceType-1"
      }
    ],
    "count": 1,
    "has_next_page": false,
    "end_cursor": "cursor-1",
    "redacted_fields": []
  }
}
