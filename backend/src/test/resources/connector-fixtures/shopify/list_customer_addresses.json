{
  "package": "@activepieces/piece-shopify",
  "version": "0.11.3",
  "action": "list_customer_addresses",
  "auth": {
    "type": "CUSTOM_AUTH",
    "props": {
      "shopName": "test-shop",
      "adminToken": "shpat_test_token"
    }
  },
  "inputs": {
    "customer_id": "1001",
    "reverse": true,
    "first": 5,
    "after": "sample after"
  },
  "credential": {
    "shopName": "test-shop",
    "adminToken": "shpat_test_token"
  },
  "answers": [
    {
      "status": 200,
      "body": {
        "data": {
          "customer": {
            "id": "gid://shopify/Customer/1001",
            "defaultAddress": {
              "id": "gid://shopify/DefaultAddres/1001"
            },
            "addressesV2": {
              "nodes": [
                {
                  "id": "gid://shopify/AddressesV2/1001",
                  "firstName": "firstName-1",
                  "lastName": "lastName-1",
                  "name": "name-1",
                  "company": "company-1",
                  "address1": "address1-1",
                  "address2": "address2-1",
                  "city": "city-1",
                  "province": "province-1",
                  "provinceCode": "provinceCode-1",
                  "country": "country-1",
                  "countryCodeV2": "countryCodeV2-1",
                  "zip": "zip-1",
                  "phone": "phone-1"
                }
              ],
              "pageInfo": {
                "hasNextPage": false,
                "endCursor": "cursor-1"
              }
            }
          }
        }
      }
    }
  ],
  "exchanges": [
    {
      "request": {
        "method": "POST",
        "url": "https://test-shop.myshopify.com/admin/api/2026-10/graphql.json",
        "headers": {
          "content-type": "application/json",
          "x-shopify-access-token": "shpat_test_token"
        },
        "body": {
          "query": "query ListCustomerAddresses($id: ID!, $first: Int!, $after: String, $reverse: Boolean) { customer(id: $id) { id defaultAddress { id } addressesV2(first: $first, after: $after, reverse: $reverse) { nodes { id firstName lastName name company address1 address2 city province provinceCode country countryCodeV2 zip phone } pageInfo { hasNextPage endCursor } } } }",
          "variables": {
            "id": "gid://shopify/Customer/1001",
            "first": 5,
            "after": "sample after",
            "reverse": true
          }
        }
      }
    }
  ],
  "output": {
    "customer_id": "gid://shopify/Customer/1001",
    "items": [
      {
        "id": "gid://shopify/AddressesV2/1001",
        "first_name": "firstName-1",
        "last_name": "lastName-1",
        "name": "name-1",
        "company": "company-1",
        "address1": "address1-1",
        "address2": "address2-1",
        "city": "city-1",
        "province": "province-1",
        "province_code": "provinceCode-1",
        "country": "country-1",
        "country_code": "countryCodeV2-1",
        "zip": "zip-1",
        "phone": "phone-1",
        "is_default": false
      }
    ],
    "count": 1,
    "has_next_page": false,
    "end_cursor": "cursor-1",
    "redacted_fields": []
  }
}
