{
  "package": "@activepieces/piece-shopify",
  "version": "0.11.3",
  "action": "delete_url_redirect",
  "auth": {
    "type": "CUSTOM_AUTH",
    "props": {
      "shopName": "test-shop",
      "adminToken": "shpat_test_token"
    }
  },
  "inputs": {
    "url_redirect_id": "https://example.com/item"
  },
  "credential": {
    "shopName": "test-shop",
    "adminToken": "shpat_test_token"
  },
  "answers": [
    {
      "status": 200,
      "body": {
        "data": {
          "urlRedirectDelete": {
            "deletedUrlRedirectId": "deletedUrlRedirectId-1",
            "userErrors": []
          }
        }
      }
    }
  ],
  "exchanges": [
    {
      "request": {
        "method": "POST",
        "url": "https://test-shop.myshopify.com/admin/api/2026-10/graphql.json",
        "headers": {
          "content-type": "application/json",
          "x-shopify-access-token": "shpat_test_token"
        },
        "body": {
          "query": "mutation DeleteUrlRedirect($id: ID!) { urlRedirectDelete(id: $id) { deletedUrlRedirectId userErrors { field message code } } }",
          "variables": {
            "id": "https://example.com/item"
          }
        }
      }
    }
  ],
  "output": {
    "deleted_url_redirect_id": "deletedUrlRedirectId-1",
    "redacted_fields": []
  }
}
