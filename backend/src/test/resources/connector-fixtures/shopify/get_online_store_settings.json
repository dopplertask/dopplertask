{
  "package": "@activepieces/piece-shopify",
  "version": "0.11.3",
  "action": "get_online_store_settings",
  "auth": {
    "type": "CUSTOM_AUTH",
    "props": {
      "shopName": "test-shop",
      "adminToken": "shpat_test_token"
    }
  },
  "inputs": {},
  "credential": {
    "shopName": "test-shop",
    "adminToken": "shpat_test_token"
  },
  "answers": [
    {
      "status": 200,
      "body": {
        "data": {
          "onlineStore": {
            "passwordProtection": {
              "enabled": true
            }
          }
        }
      }
    }
  ],
  "exchanges": [
    {
      "request": {
        "method": "POST",
        "url": "https://test-shop.myshopify.com/admin/api/2026-10/graphql.json",
        "headers": {
          "content-type": "application/json",
          "x-shopify-access-token": "shpat_test_token"
        },
        "body": {
          "query": "query GetOnlineStoreSettings { onlineStore { passwordProtection { enabled } } }",
          "variables": {}
        }
      }
    }
  ],
  "output": {
    "password_protection_enabled": true,
    "redacted_fields": []
  }
}
