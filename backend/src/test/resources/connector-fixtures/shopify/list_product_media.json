{
  "package": "@activepieces/piece-shopify",
  "version": "0.11.3",
  "action": "list_product_media",
  "auth": {
    "type": "CUSTOM_AUTH",
    "props": {
      "shopName": "test-shop",
      "adminToken": "shpat_test_token"
    }
  },
  "inputs": {
    "product_id": "1001",
    "reverse": true,
    "first": 5,
    "after": "sample after"
  },
  "credential": {
    "shopName": "test-shop",
    "adminToken": "shpat_test_token"
  },
  "answers": [
    {
      "status": 200,
      "body": {
        "data": {
          "product": {
            "id": "gid://shopify/Product/1001",
            "media": {
              "nodes": [
                {
                  "id": "gid://shopify/Media/1001",
                  "alt": "alt-1",
                  "mediaContentType": "mediaContentType-1",
                  "status": "status-1",
                  "preview": {
                    "image": {
                      "url": "https://example.com/item"
                    }
                  },
                  "mimeType": "mimeType-1",
                  "image": {
                    "url": "https://example.com/item",
                    "width": "width-1",
                    "height": "height-1"
                  },
                  "mediaErrors": [
                    {
                      "code": "code-1",
                      "message": "message-1"
                    }
                  ]
                }
              ],
              "pageInfo": {
                "hasNextPage": false,
                "endCursor": "cursor-1"
              }
            }
          }
        }
      }
    }
  ],
  "exchanges": [
    {
      "request": {
        "method": "POST",
        "url": "https://test-shop.myshopify.com/admin/api/2026-10/graphql.json",
        "headers": {
          "content-type": "application/json",
          "x-shopify-access-token": "shpat_test_token"
        },
        "body": {
          "query": "query ListProductMedia($id: ID!, $first: Int!, $after: String, $reverse: Boolean) { product(id: $id) { id media(first: $first, after: $after, reverse: $reverse, sortKey: POSITION) { nodes { id alt mediaContentType status preview { image { url } } ... on MediaImage { mimeType image { url width height } } ... on ExternalVideo { originUrl } ... on Video { filename } ... on Model3d { filename } mediaErrors { code message } } pageInfo { hasNextPage endCursor } } } }",
          "variables": {
            "id": "gid://shopify/Product/1001",
            "first": 5,
            "after": "sample after",
            "reverse": true
          }
        }
      }
    }
  ],
  "output": {
    "items": [
      {
        "id": "gid://shopify/Media/1001",
        "alt": "alt-1",
        "media_content_type": "mediaContentType-1",
        "status": "status-1",
        "image_url": "https://example.com/item",
        "width": "width-1",
        "height": "height-1",
        "mime_type": "mimeType-1",
        "preview_url": "https://example.com/item",
        "external_url": null,
        "filename": null,
        "errors": "message-1"
      }
    ],
    "count": 1,
    "has_next_page": false,
    "end_cursor": "cursor-1",
    "redacted_fields": []
  }
}
