{
  "package": "@activepieces/piece-shopify",
  "version": "0.11.3",
  "action": "list_theme_files",
  "auth": {
    "type": "CUSTOM_AUTH",
    "props": {
      "shopName": "test-shop",
      "adminToken": "shpat_test_token"
    }
  },
  "inputs": {
    "theme_id": "1001",
    "filenames": [
      "sample filename"
    ],
    "first": 5,
    "after": "sample after"
  },
  "credential": {
    "shopName": "test-shop",
    "adminToken": "shpat_test_token"
  },
  "answers": [
    {
      "status": 200,
      "body": {
        "data": {
          "theme": {
            "id": "gid://shopify/Theme/1001",
            "name": "name-1",
            "role": "role-1",
            "files": {
              "nodes": [
                {
                  "filename": "filename-1",
                  "contentType": "contentType-1",
                  "size": "size-1",
                  "checksumMd5": "checksumMd5-1",
                  "createdAt": "2026-01-02T03:04:05Z",
                  "updatedAt": "2026-01-02T03:04:05Z"
                }
              ],
              "pageInfo": {
                "hasNextPage": false,
                "endCursor": "cursor-1"
              },
              "userErrors": []
            }
          }
        }
      }
    }
  ],
  "exchanges": [
    {
      "request": {
        "method": "POST",
        "url": "https://test-shop.myshopify.com/admin/api/2026-10/graphql.json",
        "headers": {
          "content-type": "application/json",
          "x-shopify-access-token": "shpat_test_token"
        },
        "body": {
          "query": "query ListThemeFiles($id: ID!, $first: Int!, $after: String, $filenames: [String!]) { theme(id: $id) { id name role files(first: $first, after: $after, filenames: $filenames) { nodes { filename contentType size checksumMd5 createdAt updatedAt } pageInfo { hasNextPage endCursor } userErrors { filename code } } } }",
          "variables": {
            "id": "gid://shopify/OnlineStoreTheme/1001",
            "first": 5,
            "after": "sample after",
            "filenames": [
              "sample filename"
            ]
          }
        }
      }
    }
  ],
  "output": {
    "theme_id": "gid://shopify/Theme/1001",
    "theme_name": "name-1",
    "theme_role": "role-1",
    "items": [
      {
        "filename": "filename-1",
        "content_type": "contentType-1",
        "size": null,
        "checksum_md5": "checksumMd5-1",
        "created_at": "2026-01-02T03:04:05Z",
        "updated_at": "2026-01-02T03:04:05Z"
      }
    ],
    "count": 1,
    "has_next_page": false,
    "end_cursor": "cursor-1",
    "redacted_fields": [],
    "file_errors": []
  }
}
