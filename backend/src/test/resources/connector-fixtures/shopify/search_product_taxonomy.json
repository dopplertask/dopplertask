{
  "package": "@activepieces/piece-shopify",
  "version": "0.11.3",
  "action": "search_product_taxonomy",
  "auth": {
    "type": "CUSTOM_AUTH",
    "props": {
      "shopName": "test-shop",
      "adminToken": "shpat_test_token"
    }
  },
  "inputs": {
    "search": "sample search",
    "parent_category_id": "1001",
    "first": 5,
    "after": "sample after"
  },
  "credential": {
    "shopName": "test-shop",
    "adminToken": "shpat_test_token"
  },
  "answers": [
    {
      "status": 200,
      "body": {
        "data": {
          "taxonomy": {
            "categories": {
              "nodes": [
                {
                  "id": "gid://shopify/Categorie/1001",
                  "name": "name-1",
                  "fullName": "fullName-1",
                  "level": "level-1",
                  "isLeaf": true,
                  "isRoot": true,
                  "isArchived": true,
                  "parentId": "parentId-1",
                  "childrenIds": "childrenIds-1"
                }
              ],
              "pageInfo": {
                "hasNextPage": false,
                "endCursor": "cursor-1"
              }
            }
          }
        }
      }
    }
  ],
  "exchanges": [
    {
      "request": {
        "method": "POST",
        "url": "https://test-shop.myshopify.com/admin/api/2026-10/graphql.json",
        "headers": {
          "content-type": "application/json",
          "x-shopify-access-token": "shpat_test_token"
        },
        "body": {
          "query": "query SearchProductTaxonomy($first: Int!, $after: String, $search: String, $childrenOf: ID) { taxonomy { categories(first: $first, after: $after, search: $search, childrenOf: $childrenOf) { nodes { id name fullName level isLeaf isRoot isArchived parentId childrenIds } pageInfo { hasNextPage endCursor } } } }",
          "variables": {
            "first": 5,
            "after": "sample after",
            "search": "sample search",
            "childrenOf": "gid://shopify/TaxonomyCategory/1001"
          }
        }
      }
    }
  ],
  "output": {
    "items": [
      {
        "id": "gid://shopify/Categorie/1001",
        "name": "name-1",
        "full_name": "fullName-1",
        "level": "level-1",
        "is_leaf": true,
        "is_root": true,
        "is_archived": true,
        "parent_id": "parentId-1",
        "children_ids": "childrenIds-1"
      }
    ],
    "count": 1,
    "has_next_page": false,
    "end_cursor": "cursor-1",
    "redacted_fields": []
  }
}
