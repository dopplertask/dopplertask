{
  "package": "@activepieces/piece-shopify",
  "version": "0.11.3",
  "action": "list_customer_account_pages",
  "auth": {
    "type": "CUSTOM_AUTH",
    "props": {
      "shopName": "test-shop",
      "adminToken": "shpat_test_token"
    }
  },
  "inputs": {
    "reverse": true,
    "first": 5,
    "after": "sample after"
  },
  "credential": {
    "shopName": "test-shop",
    "adminToken": "shpat_test_token"
  },
  "answers": [
    {
      "status": 200,
      "body": {
        "data": {
          "customerAccountPages": {
            "nodes": [
              {
                "__typename": "CustomerAccountNativePage",
                "id": "gid://shopify/CustomerAccountPage/1001",
                "handle": "handle-1",
                "title": "title-1",
                "defaultCursor": "cursor-1",
                "pageType": "pageType-1"
              }
            ],
            "pageInfo": {
              "hasNextPage": false,
              "endCursor": "cursor-1"
            }
          }
        }
      }
    }
  ],
  "exchanges": [
    {
      "request": {
        "method": "POST",
        "url": "https://test-shop.myshopify.com/admin/api/2026-10/graphql.json",
        "headers": {
          "content-type": "application/json",
          "x-shopify-access-token": "shpat_test_token"
        },
        "body": {
          "query": "query ListCustomerAccountPages($first: Int!, $after: String, $reverse: Boolean) { customerAccountPages(first: $first, after: $after, reverse: $reverse) { nodes { __typename id handle title defaultCursor ... on CustomerAccountNativePage { pageType } ... on CustomerAccountAppExtensionPage { appExtensionUuid } } pageInfo { hasNextPage endCursor } } }",
          "variables": {
            "first": 5,
            "after": "sample after",
            "reverse": true
          }
        }
      }
    }
  ],
  "output": {
    "items": [
      {
        "id": "gid://shopify/CustomerAccountPage/1001",
        "page_kind": "CustomerAccountNativePage",
        "handle": "handle-1",
        "title": "title-1",
        "default_cursor": "cursor-1",
        "page_type": "pageType-1",
        "app_extension_uuid": null
      }
    ],
    "count": 1,
    "has_next_page": false,
    "end_cursor": "cursor-1",
    "redacted_fields": []
  }
}
