{
  "package": "@activepieces/piece-shopify",
  "version": "0.11.3",
  "action": "get_product_media",
  "auth": {
    "type": "CUSTOM_AUTH",
    "props": {
      "shopName": "test-shop",
      "adminToken": "shpat_test_token"
    }
  },
  "inputs": {
    "media_id": "1001"
  },
  "credential": {
    "shopName": "test-shop",
    "adminToken": "shpat_test_token"
  },
  "answers": [
    {
      "status": 200,
      "body": {
        "data": {
          "node": {
            "id": "gid://shopify/Node/1001",
            "alt": "alt-1",
            "mediaContentType": "mediaContentType-1",
            "status": "status-1",
            "preview": {
              "image": {
                "url": "https://example.com/item"
              }
            },
            "mimeType": "mimeType-1",
            "image": {
              "url": "https://example.com/item",
              "width": "width-1",
              "height": "height-1"
            },
            "mediaErrors": [
              {
                "code": "code-1",
                "message": "message-1"
              }
            ]
          }
        }
      }
    }
  ],
  "exchanges": [
    {
      "request": {
        "method": "POST",
        "url": "https://test-shop.myshopify.com/admin/api/2026-10/graphql.json",
        "headers": {
          "content-type": "application/json",
          "x-shopify-access-token": "shpat_test_token"
        },
        "body": {
          "query": "query GetProductMedia($id: ID!) { node(id: $id) { ... on Media { id alt mediaContentType status preview { image { url } } ... on MediaImage { mimeType image { url width height } } ... on ExternalVideo { originUrl } ... on Video { filename } ... on Model3d { filename } mediaErrors { code message } } } }",
          "variables": {
            "id": "gid://shopify/MediaImage/1001"
          }
        }
      }
    }
  ],
  "output": {
    "id": "gid://shopify/Node/1001",
    "alt": "alt-1",
    "media_content_type": "mediaContentType-1",
    "status": "status-1",
    "image_url": "https://example.com/item",
    "width": "width-1",
    "height": "height-1",
    "mime_type": "mimeType-1",
    "preview_url": "https://example.com/item",
    "external_url": null,
    "filename": null,
    "errors": "message-1",
    "redacted_fields": []
  }
}
