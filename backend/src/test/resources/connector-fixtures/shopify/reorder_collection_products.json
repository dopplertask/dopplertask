{
  "package": "@activepieces/piece-shopify",
  "version": "0.11.3",
  "action": "reorder_collection_products",
  "auth": {
    "type": "CUSTOM_AUTH",
    "props": {
      "shopName": "test-shop",
      "adminToken": "shpat_test_token"
    }
  },
  "inputs": {
    "collection_id": "1001",
    "moves": [
      {
        "product_id": "1001",
        "new_position": 2
      }
    ]
  },
  "credential": {
    "shopName": "test-shop",
    "adminToken": "shpat_test_token"
  },
  "answers": [
    {
      "status": 200,
      "body": {
        "data": {
          "collectionReorderProducts": {
            "job": {
              "id": "gid://shopify/Job/1001",
              "done": true
            },
            "userErrors": []
          }
        }
      }
    }
  ],
  "exchanges": [
    {
      "request": {
        "method": "POST",
        "url": "https://test-shop.myshopify.com/admin/api/2026-10/graphql.json",
        "headers": {
          "content-type": "application/json",
          "x-shopify-access-token": "shpat_test_token"
        },
        "body": {
          "query": "mutation ReorderCollectionProducts($id: ID!, $moves: [MoveInput!]!) { collectionReorderProducts(id: $id, moves: $moves) { job { id done } userErrors { field message code } } }",
          "variables": {
            "id": "gid://shopify/Collection/1001",
            "moves": [
              {
                "id": "gid://shopify/Product/1001",
                "newPosition": "2"
              }
            ]
          }
        }
      }
    }
  ],
  "output": {
    "collection_id": "gid://shopify/Collection/1001",
    "job_id": "gid://shopify/Job/1001",
    "done": true,
    "redacted_fields": []
  }
}
