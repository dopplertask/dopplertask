{
  "package": "@activepieces/piece-shopify",
  "version": "0.11.3",
  "action": "count_discounts",
  "auth": {
    "type": "CUSTOM_AUTH",
    "props": {
      "shopName": "test-shop",
      "adminToken": "shpat_test_token"
    }
  },
  "inputs": {
    "query": "sample query"
  },
  "credential": {
    "shopName": "test-shop",
    "adminToken": "shpat_test_token"
  },
  "answers": [
    {
      "status": 200,
      "body": {
        "data": {
          "discountNodesCount": {
            "count": 3,
            "precision": "precision-1"
          }
        }
      }
    }
  ],
  "exchanges": [
    {
      "request": {
        "method": "POST",
        "url": "https://test-shop.myshopify.com/admin/api/2026-10/graphql.json",
        "headers": {
          "content-type": "application/json",
          "x-shopify-access-token": "shpat_test_token"
        },
        "body": {
          "query": "query CountDiscounts($query: String) { discountNodesCount(query: $query) { count precision } }",
          "variables": {
            "query": "sample query"
          }
        }
      }
    }
  ],
  "output": {
    "count": 3,
    "precision": "precision-1",
    "redacted_fields": []
  }
}
