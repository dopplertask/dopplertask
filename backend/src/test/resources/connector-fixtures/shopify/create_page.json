{
  "package": "@activepieces/piece-shopify",
  "version": "0.11.3",
  "action": "create_page",
  "auth": {
    "type": "CUSTOM_AUTH",
    "props": {
      "shopName": "test-shop",
      "adminToken": "shpat_test_token"
    }
  },
  "inputs": {
    "title": "sample title",
    "body_html": "<p>Sample text</p>",
    "handle": "sample-handle",
    "is_published": "true",
    "publish_date": "2026-01-02T03:04:05Z",
    "template_suffix": "sample template suffix"
  },
  "credential": {
    "shopName": "test-shop",
    "adminToken": "shpat_test_token"
  },
  "answers": [
    {
      "status": 200,
      "body": {
        "data": {
          "pageCreate": {
            "page": {
              "id": "gid://shopify/Page/1001",
              "title": "title-1",
              "handle": "handle-1",
              "bodySummary": "bodySummary-1",
              "isPublished": true,
              "publishedAt": "2026-01-02T03:04:05Z",
              "templateSuffix": "templateSuffix-1",
              "createdAt": "2026-01-02T03:04:05Z",
              "updatedAt": "2026-01-02T03:04:05Z",
              "body": "body-1"
            },
            "userErrors": []
          }
        }
      }
    }
  ],
  "exchanges": [
    {
      "request": {
        "method": "POST",
        "url": "https://test-shop.myshopify.com/admin/api/2026-10/graphql.json",
        "headers": {
          "content-type": "application/json",
          "x-shopify-access-token": "shpat_test_token"
        },
        "body": {
          "query": "mutation CreatePage($page: PageCreateInput!) { pageCreate(page: $page) { page { id title handle bodySummary isPublished publishedAt templateSuffix createdAt updatedAt body } userErrors { field message code } } }",
          "variables": {
            "page": {
              "title": "sample title",
              "body": "<p>Sample text</p>",
              "handle": "sample-handle",
              "isPublished": true,
              "publishDate": "2026-01-02T03:04:05Z",
              "templateSuffix": "sample template suffix"
            }
          }
        }
      }
    }
  ],
  "output": {
    "id": "gid://shopify/Page/1001",
    "title": "title-1",
    "handle": "handle-1",
    "body_summary": "bodySummary-1",
    "is_published": true,
    "published_at": "2026-01-02T03:04:05Z",
    "template_suffix": "templateSuffix-1",
    "created_at": "2026-01-02T03:04:05Z",
    "updated_at": "2026-01-02T03:04:05Z",
    "body_html": "body-1",
    "redacted_fields": []
  }
}
