{
  "package": "@activepieces/piece-shopify",
  "version": "0.11.3",
  "action": "delete_product_media",
  "auth": {
    "type": "CUSTOM_AUTH",
    "props": {
      "shopName": "test-shop",
      "adminToken": "shpat_test_token"
    }
  },
  "inputs": {
    "product_id": "1001",
    "media_ids": [
      "gid://shopify/Media/1001"
    ]
  },
  "credential": {
    "shopName": "test-shop",
    "adminToken": "shpat_test_token"
  },
  "answers": [
    {
      "status": 200,
      "body": {
        "data": {
          "product": {
            "media": {
              "nodes": [
                {
                  "id": "gid://shopify/Media/1001",
                  "status": "status-1"
                }
              ]
            }
          }
        }
      }
    },
    {
      "status": 200,
      "body": {
        "data": {
          "fileUpdate": {
            "files": [
              {
                "id": "gid://shopify/File/1001"
              }
            ],
            "userErrors": []
          }
        }
      }
    }
  ],
  "exchanges": [
    {
      "request": {
        "method": "POST",
        "url": "https://test-shop.myshopify.com/admin/api/2026-10/graphql.json",
        "headers": {
          "content-type": "application/json",
          "x-shopify-access-token": "shpat_test_token"
        },
        "body": {
          "query": "query ReadProductMediaStatus($id: ID!) { product(id: $id) { media(first: 250) { nodes { id status } } } }",
          "variables": {
            "id": "gid://shopify/Product/1001"
          }
        }
      }
    },
    {
      "request": {
        "method": "POST",
        "url": "https://test-shop.myshopify.com/admin/api/2026-10/graphql.json",
        "headers": {
          "content-type": "application/json",
          "x-shopify-access-token": "shpat_test_token"
        },
        "body": {
          "query": "mutation DeleteProductMedia($files: [FileUpdateInput!]!) { fileUpdate(files: $files) { files { id } userErrors { field message code } } }",
          "variables": {
            "files": [
              {
                "id": "gid://shopify/Media/1001",
                "referencesToRemove": [
                  "gid://shopify/Product/1001"
                ]
              }
            ]
          }
        }
      }
    }
  ],
  "output": {
    "product_id": "gid://shopify/Product/1001",
    "removed_media_ids": [
      "gid://shopify/File/1001"
    ],
    "redacted_fields": []
  }
}
