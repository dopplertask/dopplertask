{
  "package": "@activepieces/piece-shopify",
  "version": "0.11.3",
  "action": "add_tags",
  "auth": {
    "type": "CUSTOM_AUTH",
    "props": {
      "shopName": "test-shop",
      "adminToken": "shpat_test_token"
    }
  },
  "inputs": {
    "resource_type": "Order",
    "resource_id": "1001",
    "tags": [
      "sample tag"
    ]
  },
  "credential": {
    "shopName": "test-shop",
    "adminToken": "shpat_test_token"
  },
  "answers": [
    {
      "status": 200,
      "body": {
        "data": {
          "tagsAdd": {
            "node": {
              "id": "gid://shopify/Node/1001",
              "tags": [
                "tags-1"
              ]
            },
            "userErrors": []
          }
        }
      }
    }
  ],
  "exchanges": [
    {
      "request": {
        "method": "POST",
        "url": "https://test-shop.myshopify.com/admin/api/2026-10/graphql.json",
        "headers": {
          "content-type": "application/json",
          "x-shopify-access-token": "shpat_test_token"
        },
        "body": {
          "query": "mutation AddTags($id: ID!, $tags: [String!]!) { tagsAdd(id: $id, tags: $tags) { node { id ... on Order { tags } ... on DraftOrder { tags } ... on Customer { tags } ... on Product { tags } ... on Article { tags } } userErrors { field message } } }",
          "variables": {
            "id": "gid://shopify/Order/1001",
            "tags": [
              "sample tag"
            ]
          }
        }
      }
    }
  ],
  "output": {
    "id": "gid://shopify/Node/1001",
    "tags_added": "sample tag",
    "tags": "tags-1",
    "redacted_fields": []
  }
}
