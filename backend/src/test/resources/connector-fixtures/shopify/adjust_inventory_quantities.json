{
  "package": "@activepieces/piece-shopify",
  "version": "0.11.3",
  "action": "adjust_inventory_quantities",
  "auth": {
    "type": "CUSTOM_AUTH",
    "props": {
      "shopName": "test-shop",
      "adminToken": "shpat_test_token"
    }
  },
  "inputs": {
    "name": "available",
    "reason": "correction",
    "changes": [
      {
        "inventory_item_id": "1001",
        "location_id": "1001",
        "delta": 2,
        "expected_quantity": 2,
        "ledger_document_uri": "sample ledger document uri"
      }
    ],
    "reference_document_uri": "sample reference document uri",
    "idempotency_key": "6f1c2a54-1b7e-4f5e-9d3a-2c4b8e7f9a10"
  },
  "credential": {
    "shopName": "test-shop",
    "adminToken": "shpat_test_token"
  },
  "answers": [
    {
      "status": 200,
      "body": {
        "data": {
          "level0": {
            "inventoryLevel": {
              "isActive": true
            }
          }
        }
      }
    },
    {
      "status": 200,
      "body": {
        "data": {
          "inventoryAdjustQuantities": [
            {
              "inventoryAdjustmentGroup": {
                "id": "gid://shopify/InventoryAdjustmentGroup/1001",
                "createdAt": "2026-01-02T03:04:05Z",
                "reason": "reason-1",
                "referenceDocumentUri": "referenceDocumentUri-1",
                "changes": [
                  {
                    "name": "name-1",
                    "delta": "delta-1",
                    "quantityAfterChange": "quantityAfterChange-1",
                    "ledgerDocumentUri": "ledgerDocumentUri-1",
                    "item": {
                      "id": "gid://shopify/Item/1001",
                      "sku": "sku-1"
                    },
                    "location": {
                      "id": "gid://shopify/Location/1001",
                      "name": "name-1"
                    }
                  }
                ]
              },
              "userErrors": []
            }
          ]
        }
      }
    }
  ],
  "exchanges": [
    {
      "request": {
        "method": "POST",
        "url": "https://test-shop.myshopify.com/admin/api/2026-10/graphql.json",
        "headers": {
          "content-type": "application/json",
          "x-shopify-access-token": "shpat_test_token"
        },
        "body": {
          "query": "query CheckInventoryLevels($item0: ID!, $location0: ID!) { level0: inventoryItem(id: $item0) { inventoryLevel(locationId: $location0) { isActive } } }",
          "variables": {
            "item0": "gid://shopify/InventoryItem/1001",
            "location0": "gid://shopify/Location/1001"
          }
        }
      }
    },
    {
      "request": {
        "method": "POST",
        "url": "https://test-shop.myshopify.com/admin/api/2026-10/graphql.json",
        "headers": {
          "content-type": "application/json",
          "x-shopify-access-token": "shpat_test_token"
        },
        "body": {
          "query": "mutation AdjustInventoryQuantities($input: InventoryAdjustQuantitiesInput!, $idempotencyKey: String!) { inventoryAdjustQuantities(input: $input) @idempotent(key: $idempotencyKey) { inventoryAdjustmentGroup { id createdAt reason referenceDocumentUri changes { name delta quantityAfterChange ledgerDocumentUri item { id sku } location { id name } } } userErrors { field message code } } }",
          "variables": {
            "input": {
              "name": "available",
              "reason": "correction",
              "referenceDocumentUri": "sample reference document uri",
              "changes": [
                {
                  "inventoryItemId": "gid://shopify/InventoryItem/1001",
                  "locationId": "gid://shopify/Location/1001",
                  "delta": 2,
                  "changeFromQuantity": 2,
                  "ledgerDocumentUri": "sample ledger document uri"
                }
              ]
            },
            "idempotencyKey": "6f1c2a54-1b7e-4f5e-9d3a-2c4b8e7f9a10"
          }
        }
      }
    }
  ],
  "output": {
    "adjustment_group_id": null,
    "created_at": null,
    "reason": null,
    "reference_document_uri": null,
    "changes": [],
    "idempotency_key": "6f1c2a54-1b7e-4f5e-9d3a-2c4b8e7f9a10",
    "redacted_fields": []
  }
