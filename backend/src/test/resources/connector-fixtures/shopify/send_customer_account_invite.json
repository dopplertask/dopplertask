{
  "package": "@activepieces/piece-shopify",
  "version": "0.11.3",
  "action": "send_customer_account_invite",
  "auth": {
    "type": "CUSTOM_AUTH",
    "props": {
      "shopName": "test-shop",
      "adminToken": "shpat_test_token"
    }
  },
  "inputs": {
    "customer_id": "1001",
    "subject": "sample subject",
    "custom_message": "<p>Sample text</p>"
  },
  "credential": {
    "shopName": "test-shop",
    "adminToken": "shpat_test_token"
  },
  "answers": [
    {
      "status": 200,
      "body": {
        "data": {
          "customerSendAccountInviteEmail": {
            "customer": {
              "id": "gid://shopify/Customer/1001",
              "state": "state-1"
            },
            "userErrors": []
          }
        }
      }
    }
  ],
  "exchanges": [
    {
      "request": {
        "method": "POST",
        "url": "https://test-shop.myshopify.com/admin/api/2026-10/graphql.json",
        "headers": {
          "content-type": "application/json",
          "x-shopify-access-token": "shpat_test_token"
        },
        "body": {
          "query": "mutation SendCustomerAccountInvite($customerId: ID!, $email: EmailInput) { customerSendAccountInviteEmail(customerId: $customerId, email: $email) { customer { id state } userErrors { field message code } } }",
          "variables": {
            "customerId": "gid://shopify/Customer/1001",
            "email": {
              "subject": "sample subject",
              "customMessage": "<p>Sample text</p>"
            }
          }
        }
      }
    }
  ],
  "output": {
    "customer_id": "gid://shopify/Customer/1001",
    "state": "state-1",
    "redacted_fields": []
  }
}
