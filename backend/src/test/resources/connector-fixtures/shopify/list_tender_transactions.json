{
  "package": "@activepieces/piece-shopify",
  "version": "0.11.3",
  "action": "list_tender_transactions",
  "auth": {
    "type": "CUSTOM_AUTH",
    "props": {
      "shopName": "test-shop",
      "adminToken": "shpat_test_token"
    }
  },
  "inputs": {
    "query": "sample query",
    "reverse": true,
    "first": 5,
    "after": "sample after"
  },
  "credential": {
    "shopName": "test-shop",
    "adminToken": "shpat_test_token"
  },
  "answers": [
    {
      "status": 200,
      "body": {
        "data": {
          "tenderTransactions": {
            "nodes": [
              {
                "id": "gid://shopify/TenderTransaction/1001",
                "amount": {
                  "amount": "10.00",
                  "currencyCode": "USD"
                },
                "paymentMethod": "paymentMethod-1",
                "processedAt": "2026-01-02T03:04:05Z",
                "remoteReference": "remoteReference-1",
                "test": true,
                "order": {
                  "id": "gid://shopify/Order/1001",
                  "name": "name-1"
                },
                "transactionDetails": {
                  "creditCardCompany": "creditCardCompany-1"
                }
              }
            ],
            "pageInfo": {
              "hasNextPage": false,
              "endCursor": "cursor-1"
            }
          }
        }
      }
    }
  ],
  "exchanges": [
    {
      "request": {
        "method": "POST",
        "url": "https://test-shop.myshopify.com/admin/api/2026-10/graphql.json",
        "headers": {
          "content-type": "application/json",
          "x-shopify-access-token": "shpat_test_token"
        },
        "body": {
          "query": "query ListTenderTransactions($first: Int!, $after: String, $query: String, $reverse: Boolean) { tenderTransactions(first: $first, after: $after, query: $query, reverse: $reverse) { nodes { id amount { amount currencyCode } paymentMethod processedAt remoteReference test order { id name } transactionDetails { ... on TenderTransactionCreditCardDetails { creditCardCompany } } } pageInfo { hasNextPage endCursor } } }",
          "variables": {
            "first": 5,
            "after": "sample after",
            "query": "sample query",
            "reverse": true
          }
        }
      }
    }
  ],
  "output": {
    "items": [
      {
        "id": "gid://shopify/TenderTransaction/1001",
        "amount": "10.00",
        "currency_code": "USD",
        "payment_method": "paymentMethod-1",
