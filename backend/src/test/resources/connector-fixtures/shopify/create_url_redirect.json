{
  "package": "@activepieces/piece-shopify",
  "version": "0.11.3",
  "action": "create_url_redirect",
  "auth": {
    "type": "CUSTOM_AUTH",
    "props": {
      "shopName": "test-shop",
      "adminToken": "shpat_test_token"
    }
  },
  "inputs": {
    "path": "sample path",
    "target": "sample target"
  },
  "credential": {
    "shopName": "test-shop",
    "adminToken": "shpat_test_token"
  },
  "answers": [
    {
      "status": 200,
      "body": {
        "data": {
          "urlRedirectCreate": {
            "urlRedirect": {
              "id": "gid://shopify/UrlRedirect/1001",
              "path": "path-1",
              "target": "target-1"
            },
            "userErrors": []
          }
        }
      }
    }
  ],
  "exchanges": [
    {
      "request": {
        "method": "POST",
        "url": "https://test-shop.myshopify.com/admin/api/2026-10/graphql.json",
        "headers": {
          "content-type": "application/json",
          "x-shopify-access-token": "shpat_test_token"
        },
        "body": {
          "query": "mutation CreateUrlRedirect($urlRedirect: UrlRedirectInput!) { urlRedirectCreate(urlRedirect: $urlRedirect) { urlRedirect { id path target } userErrors { field message code } } }",
          "variables": {
            "urlRedirect": {
              "path": "sample path",
              "target": "sample target"
            }
          }
        }
      }
    }
  ],
  "output": {
    "id": "gid://shopify/UrlRedirect/1001",
    "path": "path-1",
    "target": "target-1",
    "redacted_fields": []
  }
}
