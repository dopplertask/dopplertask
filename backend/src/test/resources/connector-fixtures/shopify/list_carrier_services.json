      "adminToken": "shpat_test_token"
    }
  },
  "inputs": {
    "query": "sample query",
    "sort_key": "ID",
    "reverse": true,
    "first": 5,
    "after": "sample after"
  },
  "credential": {
    "shopName": "test-shop",
    "adminToken": "shpat_test_token"
  },
  "answers": [
    {
      "status": 200,
      "body": {
        "data": {
          "carrierServices": {
