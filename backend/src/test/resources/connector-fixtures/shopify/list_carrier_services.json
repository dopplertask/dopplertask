        "headers": {
          "content-type": "application/json",
          "x-shopify-access-token": "shpat_test_token"
        },
        "body": {
          "query": "query ListCarrierServices($first: Int!, $after: String, $query: String, $sortKey: CarrierServiceSortKeys, $reverse: Boolean) { carrierServices(first: $first, after: $after, query: $query, sortKey: $sortKey, reverse: $reverse) { nodes { id name formattedName active callbackUrl supportsServiceDiscovery } pageInfo { hasNextPage endCursor } } }",
