{
  "package": "@activepieces/piece-shopify",
  "version": "0.11.3",
  "action": "list_web_presences",
  "auth": {
    "type": "CUSTOM_AUTH",
    "props": {
      "shopName": "test-shop",
      "adminToken": "shpat_test_token"
    }
  },
  "inputs": {
    "reverse": true,
    "first": 5,
    "after": "sample after"
  },
  "credential": {
    "shopName": "test-shop",
    "adminToken": "shpat_test_token"
  },
  "answers": [
    {
      "status": 200,
      "body": {
        "data": {
          "webPresences": {
            "nodes": [
              {
                "id": "gid://shopify/WebPresence/1001",
                "subfolderSuffix": "subfolderSuffix-1",
                "domain": {
                  "id": "gid://shopify/Domain/1001",
                  "host": "host-1",
                  "url": "https://example.com/item"
                },
                "defaultLocale": {
                  "locale": "locale-1"
                },
                "rootUrls": [
                  {
                    "locale": "locale-1",
                    "url": "https://example.com/item"
                  }
                ]
              }
            ],
            "pageInfo": {
              "hasNextPage": false,
              "endCursor": "cursor-1"
            }
          }
        }
      }
    }
  ],
  "exchanges": [
    {
      "request": {
        "method": "POST",
        "url": "https://test-shop.myshopify.com/admin/api/2026-10/graphql.json",
        "headers": {
          "content-type": "application/json",
          "x-shopify-access-token": "shpat_test_token"
        },
        "body": {
          "query": "query ListWebPresences($first: Int!, $after: String, $reverse: Boolean) { webPresences(first: $first, after: $after, reverse: $reverse) { nodes { id subfolderSuffix domain { id host url } defaultLocale { locale } rootUrls { locale url } } pageInfo { hasNextPage endCursor } } }",
          "variables": {
            "first": 5,
            "after": "sample after",
            "reverse": true
          }
        }
      }
    }
  ],
  "output": {
    "items": [
      {
        "id": "gid://shopify/WebPresence/1001",
        "kind": "domain",
        "subfolder_suffix": "subfolderSuffix-1",
        "domain_id": "gid://shopify/Domain/1001",
        "domain_host": "host-1",
        "domain_url": "https://example.com/item",
        "default_locale": "locale-1",
        "root_urls": [
          {
            "locale": "locale-1",
            "url": "https://example.com/item"
          }
        ]
      }
    ],
    "count": 1,
    "has_next_page": false,
    "end_cursor": "cursor-1",
    "redacted_fields": []
  }
}
