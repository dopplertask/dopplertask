{
  "package": "@activepieces/piece-shopify",
  "version": "0.11.3",
  "action": "get_job",
  "auth": {
    "type": "CUSTOM_AUTH",
    "props": {
      "shopName": "test-shop",
      "adminToken": "shpat_test_token"
    }
  },
  "inputs": {
    "job_id": "1001"
  },
  "credential": {
    "shopName": "test-shop",
    "adminToken": "shpat_test_token"
  },
  "answers": [
    {
      "status": 200,
      "body": {
        "data": {
          "job": {
            "id": "gid://shopify/Job/1001",
            "done": true
          }
        }
      }
    }
  ],
  "exchanges": [
    {
      "request": {
        "method": "POST",
        "url": "https://test-shop.myshopify.com/admin/api/2026-10/graphql.json",
        "headers": {
          "content-type": "application/json",
          "x-shopify-access-token": "shpat_test_token"
        },
        "body": {
          "query": "query GetJob($id: ID!) { job(id: $id) { id done } }",
          "variables": {
            "id": "gid://shopify/Job/1001"
          }
        }
      }
    }
  ],
  "output": {
    "id": "gid://shopify/Job/1001",
    "done": true,
    "redacted_fields": []
  }
}
