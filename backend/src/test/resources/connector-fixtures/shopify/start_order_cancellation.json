{
  "package": "@activepieces/piece-shopify",
  "version": "0.11.3",
  "action": "start_order_cancellation",
  "auth": {
    "type": "CUSTOM_AUTH",
    "props": {
      "shopName": "test-shop",
      "adminToken": "shpat_test_token"
    }
  },
  "inputs": {
    "order_id": "1001",
    "reason": "CUSTOMER",
    "restock": true,
    "refund_method": "ORIGINAL_PAYMENT_METHODS",
    "store_credit_expires_at": "2026-01-02T03:04:05Z",
    "notify_customer": true,
    "staff_note": "sample staff note"
  },
  "credential": {
    "shopName": "test-shop",
    "adminToken": "shpat_test_token"
  },
  "answers": [
    {
      "status": 200,
      "body": {
        "data": {
          "orderCancel": {
            "job": {
              "id": "gid://shopify/Job/1001",
              "done": true
            },
            "orderCancelUserErrors": []
          }
        }
      }
    }
  ],
  "exchanges": [
    {
      "request": {
        "method": "POST",
        "url": "https://test-shop.myshopify.com/admin/api/2026-10/graphql.json",
        "headers": {
          "content-type": "application/json",
          "x-shopify-access-token": "shpat_test_token"
        },
        "body": {
          "query": "mutation StartOrderCancellation($orderId: ID!, $reason: OrderCancelReason!, $restock: Boolean!, $notifyCustomer: Boolean, $refundMethod: OrderCancelRefundMethodInput, $staffNote: String) { orderCancel(orderId: $orderId, reason: $reason, restock: $restock, notifyCustomer: $notifyCustomer, refundMethod: $refundMethod, staffNote: $staffNote) { job { id done } orderCancelUserErrors { field message code } } }",
          "variables": {
            "orderId": "gid://shopify/Order/1001",
            "reason": "CUSTOMER",
            "restock": true,
            "notifyCustomer": true,
            "refundMethod": {
              "originalPaymentMethodsRefund": true
            },
            "staffNote": "sample staff note"
          }
        }
      }
    }
  ],
  "output": {
    "order_id": "gid://shopify/Order/1001",
    "job_id": "gid://shopify/Job/1001",
    "job_done": true,
    "redacted_fields": []
  }
}
