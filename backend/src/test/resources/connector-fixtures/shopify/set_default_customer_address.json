{
  "package": "@activepieces/piece-shopify",
  "version": "0.11.3",
  "action": "set_default_customer_address",
  "auth": {
    "type": "CUSTOM_AUTH",
    "props": {
      "shopName": "test-shop",
      "adminToken": "shpat_test_token"
    }
  },
  "inputs": {
    "customer_id": "1001",
    "address_id": "1001"
  },
  "credential": {
    "shopName": "test-shop",
    "adminToken": "shpat_test_token"
  },
  "answers": [
    {
      "status": 200,
      "body": {
        "data": {
          "customerUpdateDefaultAddress": {
            "customer": {
              "id": "gid://shopify/Customer/1001",
              "defaultAddress": {
                "id": "gid://shopify/DefaultAddres/1001",
                "firstName": "firstName-1",
                "lastName": "lastName-1",
                "name": "name-1",
                "company": "company-1",
                "address1": "address1-1",
                "address2": "address2-1",
                "city": "city-1",
                "province": "province-1",
                "provinceCode": "provinceCode-1",
                "country": "country-1",
                "countryCodeV2": "countryCodeV2-1",
                "zip": "zip-1",
                "phone": "phone-1"
              }
            },
            "userErrors": []
          }
        }
      }
    }
  ],
  "exchanges": [
    {
      "request": {
        "method": "POST",
        "url": "https://test-shop.myshopify.com/admin/api/2026-10/graphql.json",
        "headers": {
          "content-type": "application/json",
          "x-shopify-access-token": "shpat_test_token"
        },
        "body": {
          "query": "mutation SetDefaultCustomerAddress($customerId: ID!, $addressId: ID!) { customerUpdateDefaultAddress(customerId: $customerId, addressId: $addressId) { customer { id defaultAddress { id firstName lastName name company address1 address2 city province provinceCode country countryCodeV2 zip phone } } userErrors { field message } } }",
          "variables": {
            "customerId": "gid://shopify/Customer/1001",
            "addressId": "gid://shopify/MailingAddress/1001?model_name=CustomerAddress"
          }
        }
      }
    }
  ],
  "output": {
    "customer_id": "gid://shopify/Customer/1001",
    "id": "gid://shopify/DefaultAddres/1001",
    "first_name": "firstName-1",
    "last_name": "lastName-1",
    "name": "name-1",
    "company": "company-1",
    "address1": "address1-1",
    "address2": "address2-1",
    "city": "city-1",
    "province": "province-1",
    "province_code": "provinceCode-1",
    "country": "country-1",
    "country_code": "countryCodeV2-1",
    "zip": "zip-1",
    "phone": "phone-1",
    "redacted_fields": []
  }
}
