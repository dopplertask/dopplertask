{
  "package": "@activepieces/piece-shopify",
  "version": "0.11.3",
  "action": "get_domain",
  "auth": {
    "type": "CUSTOM_AUTH",
    "props": {
      "shopName": "test-shop",
      "adminToken": "shpat_test_token"
    }
  },
  "inputs": {
    "domain_id": "1001"
  },
  "credential": {
    "shopName": "test-shop",
    "adminToken": "shpat_test_token"
  },
  "answers": [
    {
      "status": 200,
      "body": {
        "data": {
          "domain": {
            "id": "gid://shopify/Domain/1001",
            "host": "host-1",
            "url": "https://example.com/item",
            "sslEnabled": "sslEnabled-1",
            "localization": {
              "defaultLocale": "defaultLocale-1",
              "alternateLocales": "alternateLocales-1",
              "country": "country-1"
            },
            "marketWebPresence": {
              "id": "gid://shopify/MarketWebPresence/1001",
              "subfolderSuffix": "subfolderSuffix-1",
              "rootUrls": [
                {
                  "locale": "locale-1",
                  "url": "https://example.com/item"
                }
              ]
            }
          }
        }
      }
    }
  ],
  "exchanges": [
    {
      "request": {
        "method": "POST",
        "url": "https://test-shop.myshopify.com/admin/api/2026-10/graphql.json",
        "headers": {
          "content-type": "application/json",
          "x-shopify-access-token": "shpat_test_token"
        },
        "body": {
          "query": "query GetDomain($id: ID!) { domain(id: $id) { id host url sslEnabled localization { defaultLocale alternateLocales country } marketWebPresence { id subfolderSuffix rootUrls { locale url } } } }",
          "variables": {
            "id": "gid://shopify/Domain/1001"
          }
        }
      }
    }
  ],
  "output": {
    "id": "gid://shopify/Domain/1001",
    "host": "host-1",
    "url": "https://example.com/item",
    "ssl_enabled": "sslEnabled-1",
    "default_locale": "defaultLocale-1",
    "alternate_locales": "alternateLocales-1",
    "country": "country-1",
    "web_presence_id": "gid://shopify/MarketWebPresence/1001",
    "web_presence_subfolder_suffix": "subfolderSuffix-1",
    "web_presence_root_urls": [
      {
        "locale": "locale-1",
        "url": "https://example.com/item"
      }
    ],
    "redacted_fields": []
  }
}
