{
  "package": "@activepieces/piece-shopify",
  "version": "0.11.3",
  "action": "list_catalogs",
  "auth": {
    "type": "CUSTOM_AUTH",
    "props": {
      "shopName": "test-shop",
      "adminToken": "shpat_test_token"
    }
  },
  "inputs": {
    "type": "MARKET",
    "query": "sample query",
    "sort_key": "ID",
    "reverse": true,
    "first": 5,
    "after": "sample after"
  },
  "credential": {
    "shopName": "test-shop",
    "adminToken": "shpat_test_token"
  },
  "answers": [
    {
      "status": 200,
      "body": {
        "data": {
          "catalogs": {
            "nodes": [
              {
                "__typename": "MarketCatalog",
                "id": "gid://shopify/Catalog/1001",
                "title": "title-1",
                "status": "status-1",
                "priceList": {
                  "id": "gid://shopify/PriceList/1001",
                  "name": "name-1",
                  "currency": "currency-1"
                },
                "publication": {
                  "id": "gid://shopify/Publication/1001"
                },
                "marketsCount": {
                  "count": 3
                }
              }
            ],
            "pageInfo": {
              "hasNextPage": false,
              "endCursor": "cursor-1"
            }
          }
        }
      }
    }
  ],
  "exchanges": [
    {
      "request": {
        "method": "POST",
        "url": "https://test-shop.myshopify.com/admin/api/2026-10/graphql.json",
        "headers": {
          "content-type": "application/json",
          "x-shopify-access-token": "shpat_test_token"
        },
        "body": {
          "query": "query ListCatalogs($first: Int!, $after: String, $type: CatalogType, $query: String, $sortKey: CatalogSortKeys, $reverse: Boolean) { catalogs(first: $first, after: $after, type: $type, query: $query, sortKey: $sortKey, reverse: $reverse) { nodes { __typename id title status priceList { id name currency } publication { id } ... on MarketCatalog { marketsCount { count } } ... on CompanyLocationCatalog { companyLocationsCount { count } } } pageInfo { hasNextPage endCursor } } }",
          "variables": {
            "first": 5,
            "after": "sample after",
            "type": "MARKET",
            "query": "sample query",
            "sortKey": "ID",
            "reverse": true
          }
        }
      }
    }
  ],
  "output": {
    "items": [
      {
        "id": "gid://shopify/Catalog/1001",
        "catalog_type": "MarketCatalog",
        "title": "title-1",
        "status": "status-1",
        "price_list_id": "gid://shopify/PriceList/1001",
        "price_list_name": "name-1",
        "price_list_currency": "currency-1",
        "publication_id": "gid://shopify/Publication/1001",
        "markets_count": 3,
        "company_locations_count": null
      }
    ],
    "count": 1,
    "has_next_page": false,
    "end_cursor": "cursor-1",
    "redacted_fields": []
  }
}
