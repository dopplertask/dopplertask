{
  "package": "@activepieces/piece-shopify",
  "version": "0.11.3",
  "action": "list_delivery_zones",
  "auth": {
    "type": "CUSTOM_AUTH",
    "props": {
      "shopName": "test-shop",
      "adminToken": "shpat_test_token"
    }
  },
  "inputs": {
    "profile_id": "1001",
    "location_group_id": "1001",
    "first": 5,
    "after": "sample after",
    "zone_token": "sample zone token",
    "rates_after": "sample rates after"
  },
  "credential": {
    "shopName": "test-shop",
    "adminToken": "shpat_test_token"
  },
  "answers": [
    {
      "status": 200,
      "body": {
        "data": {
          "deliveryProfile": {
            "id": "gid://shopify/DeliveryProfile/1001",
            "profileLocationGroups": [
              {
                "locationGroupZones": {
                  "edges": [
                    {
                      "cursor": "cursor-1",
                      "node": {
                        "zone": {
                          "id": "gid://shopify/Zone/1001",
                          "name": "name-1",
                          "countries": [
                            {
                              "name": "name-1",
                              "code": {
                                "countryCode": "countryCode-1",
                                "restOfWorld": "restOfWorld-1"
                              }
                            }
                          ]
                        },
                        "methodDefinitions": {
                          "pageInfo": {
                            "hasNextPage": false,
                            "endCursor": "cursor-1"
                          },
                          "nodes": [
                            {
                              "id": "gid://shopify/MethodDefinition/1001",
                              "name": "name-1",
                              "active": true,
                              "description": "description-1",
                              "rateProvider": {
                                "__typename": "DeliveryRateDefinition",
                                "price": {
                                  "amount": "10.00",
                                  "currencyCode": "USD"
                                }
                              }
                            }
                          ]
                        }
                      }
                    }
                  ],
                  "pageInfo": {
                    "hasNextPage": false,
                    "endCursor": "cursor-1"
                  }
                }
              }
            ]
          }
        }
      }
    }
  ],
  "exchanges": [
    {
      "request": {
        "method": "POST",
        "url": "https://test-shop.myshopify.com/admin/api/2026-10/graphql.json",
        "headers": {
          "content-type": "application/json",
          "x-shopify-access-token": "shpat_test_token"
        },
        "body": {
          "query": "query ListDeliveryZones($id: ID!, $locationGroupId: ID!, $first: Int!, $after: String, $ratesAfter: String) { deliveryProfile(id: $id) { id profileLocationGroups(locationGroupId: $locationGroupId) { locationGroupZones(first: $first, after: $after) { edges { cursor node { zone { id name countries { name code { countryCode restOfWorld } } } methodDefinitions(first: 50, after: $ratesAfter) { pageInfo { hasNextPage endCursor } nodes { id name active description rateProvider { __typename ... on DeliveryRateDefinition { price { amount currencyCode } } ... on DeliveryParticipant { carrierService { id name } } } } } } } pageInfo { hasNextPage endCursor } } } } }",
          "variables": {
            "id": "gid://shopify/DeliveryProfile/1001",
            "locationGroupId": "gid://shopify/DeliveryLocationGroup/1001",
            "first": 1,
            "after": "sample zone token",
            "ratesAfter": "sample rates after"
          }
        }
      }
    }
  ],
  "output": {
    "profile_id": "gid://shopify/DeliveryProfile/1001",
    "location_group_id": "gid://shopify/DeliveryLocationGroup/1001",
    "items": [
      {
        "zone_id": "gid://shopify/Zone/1001",
        "zone_name": "name-1",
        "countries": [
          "REST_OF_WORLD"
        ],
        "rates": [
          {
            "id": "gid://shopify/MethodDefinition/1001",
            "name": "name-1",
            "active": true,
            "description": "description-1",
            "price": "10.00",
            "currency_code": "USD",
            "carrier_service_id": null,
            "carrier_service_name": null
          }
        ],
        "rates_truncated": false,
        "rates_end_cursor": "cursor-1",
        "zone_token": "sample zone token"
      }
    ],
    "count": 1,
    "has_next_page": false,
    "end_cursor": null,
    "redacted_fields": []
  }
}
