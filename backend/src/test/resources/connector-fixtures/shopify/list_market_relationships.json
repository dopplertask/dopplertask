{
  "package": "@activepieces/piece-shopify",
  "version": "0.11.3",
  "action": "list_market_relationships",
  "auth": {
    "type": "CUSTOM_AUTH",
    "props": {
      "shopName": "test-shop",
      "adminToken": "shpat_test_token"
    }
  },
  "inputs": {
    "reverse": true,
    "first": 5,
    "after": "sample after"
  },
  "credential": {
    "shopName": "test-shop",
    "adminToken": "shpat_test_token"
  },
  "answers": [
    {
      "status": 200,
      "body": {
        "data": {
          "marketRelationshipsStatus": {
            "version": "version-1"
          },
          "marketRelationships": {
            "nodes": [
              {
                "id": "gid://shopify/MarketRelationship/1001",
                "parentMarket": {
                  "id": "gid://shopify/ParentMarket/1001",
                  "name": "name-1",
                  "handle": "handle-1"
                },
                "childMarket": {
                  "id": "gid://shopify/ChildMarket/1001",
                  "name": "name-1",
                  "handle": "handle-1"
                }
              }
            ],
            "pageInfo": {
              "hasNextPage": false,
              "endCursor": "cursor-1"
            }
          }
        }
      }
    }
  ],
  "exchanges": [
    {
      "request": {
        "method": "POST",
        "url": "https://test-shop.myshopify.com/admin/api/2026-10/graphql.json",
        "headers": {
          "content-type": "application/json",
          "x-shopify-access-token": "shpat_test_token"
        },
        "body": {
          "query": "query ListMarketRelationships($first: Int!, $after: String, $reverse: Boolean) { marketRelationshipsStatus { version } marketRelationships(first: $first, after: $after, reverse: $reverse) { nodes { id parentMarket { id name handle } childMarket { id name handle } } pageInfo { hasNextPage endCursor } } }",
          "variables": {
            "first": 5,
            "after": "sample after",
            "reverse": true
          }
        }
      }
    }
  ],
  "output": {
    "items": [
      {
        "id": "gid://shopify/MarketRelationship/1001",
        "parent_market_id": "gid://shopify/ParentMarket/1001",
        "parent_market_name": "name-1",
        "parent_market_handle": "handle-1",
        "child_market_id": "gid://shopify/ChildMarket/1001",
        "child_market_name": "name-1",
        "child_market_handle": "handle-1"
      }
    ],
    "count": 1,
    "has_next_page": false,
    "end_cursor": "cursor-1",
    "redacted_fields": [],
    "relationships_version": "version-1"
  }
}
