{
  "package": "@activepieces/piece-shopify",
  "version": "0.11.3",
  "action": "send_payment_method_update_email",
  "auth": {
    "type": "CUSTOM_AUTH",
    "props": {
      "shopName": "test-shop",
      "adminToken": "shpat_test_token"
    }
  },
  "inputs": {
    "resource_type": "ORDERS",
    "resource_id": "1001",
    "from": "sample from",
    "bcc": [
      "sample bcc"
    ]
  },
  "credential": {
    "shopName": "test-shop",
    "adminToken": "shpat_test_token"
  },
  "answers": [
    {
      "status": 200,
      "body": {
        "data": {
          "paymentInstrumentSendAddEmail": {
            "customer": {
              "id": "gid://shopify/Customer/1001"
            },
            "userErrors": []
          }
        }
      }
    }
  ],
  "exchanges": [
    {
      "request": {
        "method": "POST",
        "url": "https://test-shop.myshopify.com/admin/api/2026-10/graphql.json",
        "headers": {
          "content-type": "application/json",
          "x-shopify-access-token": "shpat_test_token"
        },
        "body": {
          "query": "mutation SendPaymentMethodUpdateEmail($mandate: PaymentInstrumentMandateInput!, $email: EmailInput) { paymentInstrumentSendAddEmail(mandate: $mandate, email: $email) { customer { id } userErrors { field message } } }",
          "variables": {
            "mandate": {
              "resourceType": "ORDERS",
              "resourceId": "1001"
            },
            "email": {
              "from": "sample from",
              "bcc": [
                "sample bcc"
              ]
            }
          }
        }
      }
    }
  ],
  "output": {
    "customer_id": "gid://shopify/Customer/1001",
    "resource_type": "ORDERS",
    "resource_id": "1001",
    "redacted_fields": []
  }
}
