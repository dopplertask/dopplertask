{
  "package": "@activepieces/piece-shopify",
  "version": "0.11.3",
  "action": "list_enabled_currencies",
  "auth": {
    "type": "CUSTOM_AUTH",
    "props": {
      "shopName": "test-shop",
      "adminToken": "shpat_test_token"
    }
  },
  "inputs": {
    "first": 5,
    "after": "sample after"
  },
  "credential": {
    "shopName": "test-shop",
    "adminToken": "shpat_test_token"
  },
  "answers": [
    {
      "status": 200,
      "body": {
        "data": {
          "shop": {
            "currencyCode": "USD",
            "enabledPresentmentCurrencies": [
              "enabledPresentmentCurrencies-1"
            ],
            "currencySettings": {
              "nodes": [
                {
                  "currencyCode": "USD",
                  "currencyName": "currencyName-1",
                  "enabled": true,
                  "manualRate": "manualRate-1",
                  "rateUpdatedAt": "2026-01-02T03:04:05Z"
                }
              ],
              "pageInfo": {
                "hasNextPage": false,
                "endCursor": "cursor-1"
              }
            }
          }
        }
      }
    }
  ],
  "exchanges": [
    {
      "request": {
        "method": "POST",
        "url": "https://test-shop.myshopify.com/admin/api/2026-10/graphql.json",
        "headers": {
          "content-type": "application/json",
          "x-shopify-access-token": "shpat_test_token"
        },
        "body": {
          "query": "query ListEnabledCurrencies($first: Int!, $after: String) { shop { currencyCode enabledPresentmentCurrencies currencySettings(first: $first, after: $after) { nodes { currencyCode currencyName enabled manualRate rateUpdatedAt } pageInfo { hasNextPage endCursor } } } }",
          "variables": {
            "first": 5,
            "after": "sample after"
          }
        }
      }
    }
  ],
  "output": {
    "shop_currency_code": "USD",
    "enabled_presentment_currencies": [
      "enabledPresentmentCurrencies-1"
    ],
    "items": [
      {
        "currency_code": "USD",
        "currency_name": "currencyName-1",
        "enabled": true,
        "manual_rate": "manualRate-1",
        "rate_updated_at": "2026-01-02T03:04:05Z"
      }
    ],
    "count": 1,
    "has_next_page": false,
    "end_cursor": "cursor-1",
    "redacted_fields": []
  }
}
