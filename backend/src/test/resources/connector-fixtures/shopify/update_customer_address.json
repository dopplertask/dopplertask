      "shopName": "test-shop",
      "adminToken": "shpat_test_token"
    }
  },
  "inputs": {
    "customer_id": "1001",
    "address_id": "1001",
    "first_name": "sample first name",
    "last_name": "sample last name",
    "company": "sample company",
    "address1": "sample address1",
    "address2": "sample address2",
    "city": "sample city",
    "province_code": "CA",
    "country_code": "US",
    "zip": "94103",
    "phone": "+15555550123",
    "set_as_default": "true"
  },
  "credential": {
    "shopName": "test-shop",
    "adminToken": "shpat_test_token"
  },
  "answers": [
    {
      "status": 200,
      "body": {
        "data": {
          "customerAddressUpdate": {
            "address": {
              "id": "gid://shopify/Addres/1001",
              "firstName": "firstName-1",
              "lastName": "lastName-1",
              "name": "name-1",
              "company": "company-1",
              "address1": "address1-1",
              "address2": "address2-1",
              "city": "city-1",
              "province": "province-1",
