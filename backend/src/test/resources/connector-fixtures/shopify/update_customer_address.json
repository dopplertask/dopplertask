              "zip": "zip-1",
              "phone": "phone-1"
            },
            "userErrors": []
          }
        }
      }
    }
  ],
  "exchanges": [
    {
      "request": {
        "method": "POST",
        "url": "https://test-shop.myshopify.com/admin/api/2026-10/graphql.json",
        "headers": {
          "content-type": "application/json",
          "x-shopify-access-token": "shpat_test_token"
        },
        "body": {
          "query": "mutation UpdateCustomerAddress($customerId: ID!, $addressId: ID!, $address: MailingAddressInput!, $setAsDefault: Boolean) { customerAddressUpdate(customerId: $customerId, addressId: $addressId, address: $address, setAsDefault: $setAsDefault) { address { id firstName lastName name company address1 address2 city province provinceCode country countryCodeV2 zip phone } userErrors { field message } } }",
          "variables": {
            "customerId": "gid://shopify/Customer/1001",
            "addressId": "gid://shopify/MailingAddress/1001?model_name=CustomerAddress",
            "address": {
              "firstName": "sample first name",
              "lastName": "sample last name",
              "company": "sample company",
              "address1": "sample address1",
              "address2": "sample address2",
              "city": "sample city",
              "provinceCode": "CA",
              "countryCode": "US",
              "zip": "94103",
              "phone": "+15555550123"
            },
            "setAsDefault": true
          }
        }
      }
    }
  ],
  "output": {
    "customer_id": "gid://shopify/Customer/1001",
    "id": "gid://shopify/Addres/1001",
    "first_name": "firstName-1",
    "last_name": "lastName-1",
    "name": "name-1",
    "company": "company-1",
    "address1": "address1-1",
