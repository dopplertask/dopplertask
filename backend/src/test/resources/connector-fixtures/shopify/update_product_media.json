{
  "package": "@activepieces/piece-shopify",
  "version": "0.11.3",
  "action": "update_product_media",
  "auth": {
    "type": "CUSTOM_AUTH",
    "props": {
      "shopName": "test-shop",
      "adminToken": "shpat_test_token"
    }
  },
  "inputs": {
    "media_id": "1001",
    "alt": "sample alt",
    "filename": "sample filename",
    "replacement_url": "https://example.com/item"
  },
  "credential": {
    "shopName": "test-shop",
    "adminToken": "shpat_test_token"
  },
  "answers": [
    {
      "status": 200,
      "body": {
        "data": {
          "fileUpdate": {
            "files": {
              "id": "gid://shopify/File/1001",
              "alt": "alt-1",
              "fileStatus": "fileStatus-1",
              "updatedAt": "2026-01-02T03:04:05Z",
              "preview": {
                "image": {
                  "url": "https://example.com/item"
                }
              },
              "image": {
                "url": "https://example.com/item"
              }
            },
            "userErrors": []
          }
        }
      }
    }
  ],
  "exchanges": [
    {
      "request": {
        "method": "POST",
        "url": "https://test-shop.myshopify.com/admin/api/2026-10/graphql.json",
        "headers": {
          "content-type": "application/json",
          "x-shopify-access-token": "shpat_test_token"
        },
        "body": {
          "query": "mutation UpdateProductMedia($files: [FileUpdateInput!]!) { fileUpdate(files: $files) { files { id alt fileStatus updatedAt preview { image { url } } ... on MediaImage { image { url } } } userErrors { field message code } } }",
          "variables": {
            "files": [
              {
                "id": "gid://shopify/MediaImage/1001",
                "alt": "sample alt",
                "filename": "sample filename",
                "originalSource": "https://example.com/item"
              }
            ]
          }
        }
      }
    }
  ],
  "output": {
    "id": "gid://shopify/MediaImage/1001",
    "alt": null,
    "file_status": null,
    "image_url": null,
    "preview_url": null,
    "updated_at": null,
    "redacted_fields": []
  }
}
