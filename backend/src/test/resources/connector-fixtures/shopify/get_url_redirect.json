{
  "package": "@activepieces/piece-shopify",
  "version": "0.11.3",
  "action": "get_url_redirect",
  "auth": {
    "type": "CUSTOM_AUTH",
    "props": {
      "shopName": "test-shop",
      "adminToken": "shpat_test_token"
    }
  },
  "inputs": {
    "url_redirect_id": "https://example.com/item"
  },
  "credential": {
    "shopName": "test-shop",
    "adminToken": "shpat_test_token"
  },
  "answers": [
    {
      "status": 200,
      "body": {
        "data": {
          "urlRedirect": {
            "id": "gid://shopify/UrlRedirect/1001",
            "path": "path-1",
            "target": "target-1"
          }
        }
      }
    }
  ],
  "exchanges": [
    {
      "request": {
        "method": "POST",
        "url": "https://test-shop.myshopify.com/admin/api/2026-10/graphql.json",
        "headers": {
          "content-type": "application/json",
          "x-shopify-access-token": "shpat_test_token"
        },
        "body": {
          "query": "query GetUrlRedirect($id: ID!) { urlRedirect(id: $id) { id path target } }",
          "variables": {
            "id": "https://example.com/item"
          }
        }
      }
    }
  ],
  "output": {
    "id": "gid://shopify/UrlRedirect/1001",
    "path": "path-1",
    "target": "target-1",
    "redacted_fields": []
  }
}
