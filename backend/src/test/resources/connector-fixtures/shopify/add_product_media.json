{
  "package": "@activepieces/piece-shopify",
  "version": "0.11.3",
  "action": "add_product_media",
  "auth": {
    "type": "CUSTOM_AUTH",
    "props": {
      "shopName": "test-shop",
      "adminToken": "shpat_test_token"
    }
  },
  "inputs": {
    "product_id": "1001",
    "media": [
      {
        "url": "https://example.com/item",
        "alt": "sample alt",
        "media_type": "IMAGE"
      }
    ]
  },
  "credential": {
    "shopName": "test-shop",
    "adminToken": "shpat_test_token"
  },
  "answers": [
    {
      "status": 200,
      "body": {
        "data": {
          "product": {
            "media": {
              "nodes": [
                {
                  "id": "gid://shopify/Media/1001"
                }
              ]
            }
          }
        }
      }
    },
    {
      "status": 200,
      "body": {
        "data": {
          "productUpdate": {
            "product": {
              "id": "gid://shopify/Product/1001",
              "media": {
                "nodes": [
                  {
                    "id": "gid://shopify/Media/1001",
                    "alt": "alt-1",
                    "mediaContentType": "mediaContentType-1",
                    "status": "status-1",
                    "preview": {
                      "image": {
                        "url": "https://example.com/item"
                      }
                    },
                    "mimeType": "mimeType-1",
                    "image": {
                      "url": "https://example.com/item",
                      "width": "width-1",
                      "height": "height-1"
                    },
                    "mediaErrors": {
                      "code": "code-1",
                      "message": "message-1"
                    }
                  }
                ]
              }
            },
            "userErrors": []
          }
        }
      }
    }
  ],
  "exchanges": [
    {
      "request": {
        "method": "POST",
        "url": "https://test-shop.myshopify.com/admin/api/2026-10/graphql.json",
        "headers": {
          "content-type": "application/json",
          "x-shopify-access-token": "shpat_test_token"
        },
        "body": {
          "query": "query ReadProductMediaIds($id: ID!) { product(id: $id) { media(first: 250) { nodes { id } } } }",
          "variables": {
            "id": "gid://shopify/Product/1001"
          }
        }
      }
    },
    {
      "request": {
        "method": "POST",
        "url": "https://test-shop.myshopify.com/admin/api/2026-10/graphql.json",
        "headers": {
          "content-type": "application/json",
          "x-shopify-access-token": "shpat_test_token"
        },
        "body": {
          "query": "mutation AddProductMedia($product: ProductUpdateInput!, $media: [CreateMediaInput!]) { productUpdate(product: $product, media: $media) { product { id media(first: 250, sortKey: POSITION) { nodes { id alt mediaContentType status preview { image { url } } ... on MediaImage { mimeType image { url width height } } ... on ExternalVideo { originUrl } ... on Video { filename } ... on Model3d { filename } mediaErrors { code message } } } } userErrors { field message } } }",
          "variables": {
            "product": {
              "id": "gid://shopify/Product/1001"
            },
            "media": [
              {
                "originalSource": "https://example.com/item",
                "alt": "sample alt",
                "mediaContentType": "IMAGE"
              }
            ]
          }
        }
      }
    }
  ],
  "output": {
    "product_id": "gid://shopify/Product/1001",
    "media": [],
    "count": 0,
    "redacted_fields": []
  }
}
