{
  "package": "@activepieces/piece-shopify",
  "version": "0.11.3",
  "action": "delete_product_variants",
  "auth": {
    "type": "CUSTOM_AUTH",
    "props": {
      "shopName": "test-shop",
      "adminToken": "shpat_test_token"
    }
  },
  "inputs": {
    "product_id": "1001",
    "variant_ids": [
      "1001"
    ]
  },
  "credential": {
    "shopName": "test-shop",
    "adminToken": "shpat_test_token"
  },
  "answers": [
    {
      "status": 200,
      "body": {
        "data": {
          "productVariantsBulkDelete": {
            "product": {
              "id": "gid://shopify/Product/1001"
            },
            "userErrors": []
          }
        }
      }
    }
  ],
  "exchanges": [
    {
      "request": {
        "method": "POST",
        "url": "https://test-shop.myshopify.com/admin/api/2026-10/graphql.json",
        "headers": {
          "content-type": "application/json",
          "x-shopify-access-token": "shpat_test_token"
        },
        "body": {
          "query": "mutation DeleteProductVariants($productId: ID!, $variantsIds: [ID!]!) { productVariantsBulkDelete(productId: $productId, variantsIds: $variantsIds) { product { id } userErrors { field message code } } }",
          "variables": {
            "productId": "gid://shopify/Product/1001",
            "variantsIds": [
              "gid://shopify/ProductVariant/1001"
            ]
          }
        }
      }
    }
  ],
  "output": {
    "product_id": "gid://shopify/Product/1001",
    "deleted_variant_ids": [
      "gid://shopify/ProductVariant/1001"
    ],
    "redacted_fields": []
  }
