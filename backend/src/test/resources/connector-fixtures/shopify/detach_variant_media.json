{
  "package": "@activepieces/piece-shopify",
  "version": "0.11.3",
  "action": "detach_variant_media",
  "auth": {
    "type": "CUSTOM_AUTH",
    "props": {
      "shopName": "test-shop",
      "adminToken": "shpat_test_token"
    }
  },
  "inputs": {
    "product_id": "1001",
    "variant_media": [
      {
        "variant_id": "1001",
        "media_id": "1001"
      }
    ]
  },
  "credential": {
    "shopName": "test-shop",
    "adminToken": "shpat_test_token"
  },
  "answers": [
    {
      "status": 200,
      "body": {
        "data": {
          "productVariantDetachMedia": {
            "productVariants": [
              {
                "id": "gid://shopify/ProductVariant/1001",
                "title": "title-1",
                "media": {
                  "nodes": [
                    {
                      "id": "gid://shopify/Media/1001"
                    }
                  ]
                }
              }
            ],
            "userErrors": []
          }
        }
      }
    }
  ],
  "exchanges": [
    {
      "request": {
        "method": "POST",
        "url": "https://test-shop.myshopify.com/admin/api/2026-10/graphql.json",
        "headers": {
          "content-type": "application/json",
          "x-shopify-access-token": "shpat_test_token"
        },
        "body": {
          "query": "mutation DetachVariantMedia($productId: ID!, $variantMedia: [ProductVariantDetachMediaInput!]!) { productVariantDetachMedia(productId: $productId, variantMedia: $variantMedia) { productVariants { id title media(first: 10) { nodes { id } } } userErrors { field message code } } }",
          "variables": {
            "productId": "gid://shopify/Product/1001",
            "variantMedia": [
              {
                "variantId": "gid://shopify/ProductVariant/1001",
                "mediaIds": [
                  "gid://shopify/MediaImage/1001"
                ]
              }
            ]
          }
        }
      }
    }
  ],
  "output": {
    "product_id": "gid://shopify/Product/1001",
    "variants": [
      {
        "id": "gid://shopify/ProductVariant/1001",
        "title": "title-1",
        "media_ids": [
          "gid://shopify/Media/1001"
        ]
      }
    ],
    "redacted_fields": []
  }
}
