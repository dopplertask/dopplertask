{
  "package": "@activepieces/piece-shopify",
  "version": "0.11.3",
  "action": "list_discount_redeem_codes",
  "auth": {
    "type": "CUSTOM_AUTH",
    "props": {
      "shopName": "test-shop",
      "adminToken": "shpat_test_token"
    }
  },
  "inputs": {
    "discount_id": "1001",
    "query": "sample query",
    "first": 5,
    "after": "sample after"
  },
  "credential": {
    "shopName": "test-shop",
    "adminToken": "shpat_test_token"
  },
  "answers": [
    {
      "status": 200,
      "body": {
        "data": {
          "discountNode": {
            "id": "gid://shopify/DiscountNode/1001",
            "discount": {
              "__typename": "DiscountCodeBasic",
              "codes": {
                "nodes": [
                  {
                    "id": "gid://shopify/Code/1001",
                    "code": "code-1",
                    "asyncUsageCount": 3,
                    "createdBy": {
                      "id": "gid://shopify/CreatedBy/1001",
                      "title": "title-1"
                    }
                  }
                ],
                "pageInfo": {
                  "hasNextPage": false,
                  "endCursor": "cursor-1"
                }
              }
            }
          }
        }
      }
    }
  ],
  "exchanges": [
    {
      "request": {
        "method": "POST",
        "url": "https://test-shop.myshopify.com/admin/api/2026-10/graphql.json",
        "headers": {
          "content-type": "application/json",
          "x-shopify-access-token": "shpat_test_token"
        },
        "body": {
          "query": "query ListDiscountRedeemCodes($id: ID!, $first: Int!, $after: String, $query: String) { discountNode(id: $id) { id discount { __typename ... on DiscountCodeBasic { codes(first: $first, after: $after, query: $query) { nodes { id code asyncUsageCount createdBy { id title } } pageInfo { hasNextPage endCursor } } } ... on DiscountCodeBxgy { codes(first: $first, after: $after, query: $query) { nodes { id code asyncUsageCount createdBy { id title } } pageInfo { hasNextPage endCursor } } } ... on DiscountCodeFreeShipping { codes(first: $first, after: $after, query: $query) { nodes { id code asyncUsageCount createdBy { id title } } pageInfo { hasNextPage endCursor } } } ... on DiscountCodeApp { codes(first: $first, after: $after, query: $query) { nodes { id code asyncUsageCount createdBy { id title } } pageInfo { hasNextPage endCursor } } } } } }",
          "variables": {
            "id": "gid://shopify/DiscountCodeNode/1001",
            "first": 5,
            "after": "sample after",
            "query": "sample query"
          }
        }
      }
    }
  ],
  "output": {
    "discount_id": "gid://shopify/DiscountCodeNode/1001",
    "discount_type": "DiscountCodeBasic",
    "items": [
      {
        "id": "gid://shopify/Code/1001",
        "code": "code-1",
        "usage_count": 3,
        "created_by_app_id": "gid://shopify/CreatedBy/1001",
        "created_by_app_title": "title-1"
      }
    ],
    "count": 1,
    "has_next_page": false,
    "end_cursor": "cursor-1",
    "redacted_fields": []
  }
}
