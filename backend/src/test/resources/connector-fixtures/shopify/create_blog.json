{
  "package": "@activepieces/piece-shopify",
  "version": "0.11.3",
  "action": "create_blog",
  "auth": {
    "type": "CUSTOM_AUTH",
    "props": {
      "shopName": "test-shop",
      "adminToken": "shpat_test_token"
    }
  },
  "inputs": {
    "title": "sample title",
    "handle": "sample-handle",
    "comment_policy": "CLOSED",
    "template_suffix": "sample template suffix"
  },
  "credential": {
    "shopName": "test-shop",
    "adminToken": "shpat_test_token"
  },
  "answers": [
    {
      "status": 200,
      "body": {
        "data": {
          "blogCreate": {
            "blog": {
              "id": "gid://shopify/Blog/1001",
              "title": "title-1",
              "handle": "handle-1",
              "commentPolicy": "commentPolicy-1",
              "templateSuffix": "templateSuffix-1",
              "createdAt": "2026-01-02T03:04:05Z",
              "updatedAt": "2026-01-02T03:04:05Z",
              "feed": {
                "path": "path-1",
                "location": "location-1"
              },
              "articlesCount": {
                "count": 3
              }
            },
            "userErrors": []
          }
        }
      }
    }
  ],
  "exchanges": [
    {
      "request": {
        "method": "POST",
        "url": "https://test-shop.myshopify.com/admin/api/2026-10/graphql.json",
        "headers": {
          "content-type": "application/json",
          "x-shopify-access-token": "shpat_test_token"
        },
        "body": {
          "query": "mutation CreateBlog($blog: BlogCreateInput!) { blogCreate(blog: $blog) { blog { id title handle commentPolicy templateSuffix createdAt updatedAt feed { path location } articlesCount { count } } userErrors { field message code } } }",
          "variables": {
            "blog": {
              "title": "sample title",
              "handle": "sample-handle",
              "commentPolicy": "CLOSED",
              "templateSuffix": "sample template suffix"
            }
          }
        }
      }
    }
  ],
  "output": {
    "id": "gid://shopify/Blog/1001",
    "title": "title-1",
    "handle": "handle-1",
    "comment_policy": "commentPolicy-1",
    "template_suffix": "templateSuffix-1",
    "articles_count": 3,
    "feed_path": "path-1",
    "feed_location": "location-1",
    "created_at": "2026-01-02T03:04:05Z",
    "updated_at": "2026-01-02T03:04:05Z",
    "redacted_fields": []
  }
}
