{
  "package": "@activepieces/piece-shopify",
  "version": "0.11.3",
  "action": "deactivate_inventory_at_location",
  "auth": {
    "type": "CUSTOM_AUTH",
    "props": {
      "shopName": "test-shop",
      "adminToken": "shpat_test_token"
    }
  },
  "inputs": {
    "inventory_item_id": "1001",
    "location_id": "1001"
  },
  "credential": {
    "shopName": "test-shop",
    "adminToken": "shpat_test_token"
  },
  "answers": [
    {
      "status": 200,
      "body": {
        "data": {
          "inventoryItem": {
            "id": "gid://shopify/InventoryItem/1001",
            "inventoryLevel": {
              "id": "gid://shopify/InventoryLevel/1001",
              "canDeactivate": true,
              "deactivationAlert": "deactivationAlert-1"
            }
          }
        }
      }
    },
    {
      "status": 200,
      "body": {
        "data": {
          "inventoryDeactivate": {
            "userErrors": []
          }
        }
      }
    }
  ],
  "exchanges": [
    {
      "request": {
        "method": "POST",
        "url": "https://test-shop.myshopify.com/admin/api/2026-10/graphql.json",
        "headers": {
          "content-type": "application/json",
          "x-shopify-access-token": "shpat_test_token"
        },
        "body": {
          "query": "query DeactivateInventoryLevelLookup($id: ID!, $locationId: ID!) { inventoryItem(id: $id) { id inventoryLevel(locationId: $locationId) { id canDeactivate deactivationAlert } } }",
          "variables": {
            "id": "gid://shopify/InventoryItem/1001",
            "locationId": "gid://shopify/Location/1001"
          }
        }
      }
    },
    {
      "request": {
        "method": "POST",
        "url": "https://test-shop.myshopify.com/admin/api/2026-10/graphql.json",
        "headers": {
          "content-type": "application/json",
          "x-shopify-access-token": "shpat_test_token"
        },
        "body": {
          "query": "mutation DeactivateInventoryAtLocation($inventoryLevelId: ID!) { inventoryDeactivate(inventoryLevelId: $inventoryLevelId) { userErrors { field message } } }",
          "variables": {
            "inventoryLevelId": "gid://shopify/InventoryLevel/1001"
          }
        }
      }
    }
  ],
  "output": {
    "deactivated": true,
    "inventory_level_id": "gid://shopify/InventoryLevel/1001",
    "inventory_item_id": "gid://shopify/InventoryItem/1001",
    "location_id": "gid://shopify/Location/1001",
    "redacted_fields": []
  }
}
