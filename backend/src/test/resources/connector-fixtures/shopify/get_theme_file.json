{
  "package": "@activepieces/piece-shopify",
  "version": "0.11.3",
  "action": "get_theme_file",
  "auth": {
    "type": "CUSTOM_AUTH",
    "props": {
      "shopName": "test-shop",
      "adminToken": "shpat_test_token"
    }
  },
  "inputs": {
    "theme_id": "1001",
    "filename": "sample filename"
  },
  "credential": {
    "shopName": "test-shop",
    "adminToken": "shpat_test_token"
  },
  "answers": [
    {
      "status": 200,
      "body": {
        "data": {
          "theme": {
            "id": "gid://shopify/Theme/1001",
            "name": "name-1",
            "role": "role-1",
            "files": {
              "nodes": [
                {
                  "filename": "filename-1",
                  "contentType": "contentType-1",
                  "size": "size-1",
                  "checksumMd5": "checksumMd5-1",
                  "createdAt": "2026-01-02T03:04:05Z",
                  "updatedAt": "2026-01-02T03:04:05Z",
                  "body": {
                    "__typename": "OnlineStoreThemeFileBodyText",
                    "content": "content-1"
                  }
                }
              ],
              "userErrors": []
            }
          }
        }
      }
    }
  ],
  "exchanges": [
    {
      "request": {
        "method": "POST",
        "url": "https://test-shop.myshopify.com/admin/api/2026-10/graphql.json",
        "headers": {
          "content-type": "application/json",
          "x-shopify-access-token": "shpat_test_token"
        },
        "body": {
          "query": "query GetThemeFile($id: ID!, $filenames: [String!]) { theme(id: $id) { id name role files(filenames: $filenames, first: 1) { nodes { filename contentType size checksumMd5 createdAt updatedAt body { __typename ... on OnlineStoreThemeFileBodyText { content } ... on OnlineStoreThemeFileBodyBase64 { contentBase64 } ... on OnlineStoreThemeFileBodyUrl { url } } } userErrors { filename code } } } }",
          "variables": {
            "id": "gid://shopify/OnlineStoreTheme/1001",
            "filenames": [
              "sample filename"
            ]
          }
        }
      }
    }
  ],
  "output": {
    "theme_id": "gid://shopify/Theme/1001",
    "theme_name": "name-1",
    "theme_role": "role-1",
    "filename": "filename-1",
    "content_type": "contentType-1",
    "size": null,
    "checksum_md5": "checksumMd5-1",
    "body_type": "TEXT",
    "content": "content-1",
    "content_base64": null,
    "url": null,
    "created_at": "2026-01-02T03:04:05Z",
    "updated_at": "2026-01-02T03:04:05Z",
    "redacted_fields": []
  }
}
