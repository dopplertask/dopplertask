{
  "package": "@activepieces/piece-shopify",
  "version": "0.11.3",
  "action": "list_fulfillment_order_move_locations",
  "auth": {
    "type": "CUSTOM_AUTH",
    "props": {
      "shopName": "test-shop",
      "adminToken": "shpat_test_token"
    }
  },
  "inputs": {
    "fulfillment_order_id": "1001",
    "query": "sample query",
    "line_item_ids": [
      "1001"
    ],
    "first": 5,
    "after": "sample after"
  },
  "credential": {
    "shopName": "test-shop",
    "adminToken": "shpat_test_token"
  },
  "answers": [
    {
      "status": 200,
      "body": {
        "data": {
          "fulfillmentOrder": {
            "id": "gid://shopify/FulfillmentOrder/1001",
            "locationsForMove": {
              "nodes": [
                {
                  "movable": "movable-1",
                  "message": "message-1",
                  "location": {
                    "id": "gid://shopify/Location/1001",
                    "name": "name-1"
                  },
                  "availableLineItemsCount": {
                    "count": 3
                  },
                  "unavailableLineItemsCount": {
                    "count": 3
                  }
                }
              ],
              "pageInfo": {
                "hasNextPage": false,
                "endCursor": "cursor-1"
              }
            }
          }
        }
      }
    }
  ],
  "exchanges": [
    {
      "request": {
        "method": "POST",
        "url": "https://test-shop.myshopify.com/admin/api/2026-10/graphql.json",
        "headers": {
          "content-type": "application/json",
          "x-shopify-access-token": "shpat_test_token"
        },
        "body": {
          "query": "query ListFulfillmentOrderMoveLocations($id: ID!, $first: Int!, $after: String, $query: String, $lineItemIds: [ID!]) { fulfillmentOrder(id: $id) { id locationsForMove(first: $first, after: $after, query: $query, lineItemIds: $lineItemIds) { nodes { movable message location { id name } availableLineItemsCount { count } unavailableLineItemsCount { count } } pageInfo { hasNextPage endCursor } } } }",
          "variables": {
            "id": "gid://shopify/FulfillmentOrder/1001",
            "first": 5,
            "after": "sample after",
            "query": "sample query",
            "lineItemIds": [
              "gid://shopify/FulfillmentOrderLineItem/1001"
            ]
          }
        }
      }
    }
  ],
  "output": {
    "fulfillment_order_id": "gid://shopify/FulfillmentOrder/1001",
    "items": [
      {
        "location_id": "gid://shopify/Location/1001",
        "location_name": "name-1",
        "movable": "movable-1",
        "message": "message-1",
        "available_line_items_count": 3,
        "unavailable_line_items_count": 3
      }
    ],
    "count": 1,
    "has_next_page": false,
    "end_cursor": "cursor-1",
    "redacted_fields": []
  }
}
