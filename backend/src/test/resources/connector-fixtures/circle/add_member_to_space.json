{
  "package": "@activepieces/piece-circle",
  "version": "0.2.2",
  "action": "add_member_to_space",
  "auth": {
    "type": "SECRET_TEXT",
    "secret_text": "test-token"
  },
  "inputs": {
    "space_id": 501,
    "email": "ada@example.com"
  },
  "credential": {
    "apiToken": "test-token"
  },
  "answers": [
    {
      "status": 200,
      "body": {
        "message": "This user has been added to the space.",
        "success": true
      }
    }
  ],
  "exchanges": [
    {
      "request": {
        "method": "POST",
        "url": "https://app.circle.so/api/admin/v2/space_members",
        "headers": {
          "authorization": "Bearer test-token",
          "content-type": "application/json"
        },
        "body": {
          "space_id": 501,
          "email": "ada@example.com"
        }
      }
    }
  ],
  "output": {
    "message": "This user has been added to the space.",
    "success": true
  }
}
