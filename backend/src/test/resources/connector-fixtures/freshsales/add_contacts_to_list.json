{
  "package": "@activepieces/piece-freshsales",
  "version": "0.6.1",
  "action": "add_contacts_to_list",
  "auth": {
    "username": "acme-test",
    "password": "fs-test-key"
  },
  "inputs": {
    "list_id": "700",
    "contact_ids": [
      "9001",
      "9002"
    ]
  },
  "credential": {
    "alias": "acme-test",
    "apiKey": "fs-test-key"
  },
  "answers": [
    {
      "status": 200,
      "body": {
        "message": "Contacts added"
      }
    }
  ],
  "exchanges": [
    {
      "request": {
        "method": "PUT",
        "url": "https://acme-test.myfreshworks.com/crm/sales/api/lists/700/add_contacts",
        "headers": {
          "authorization": "Token token=fs-test-key",
          "content-type": "application/json"
        },
        "body": {
          "ids": [
            9001,
            9002
          ]
        }
      }
    }
  ],
  "output": {
    "list_id": 700,
    "contact_ids": [
      9001,
      9002
    ],
    "message": "Contacts added"
  }
}
