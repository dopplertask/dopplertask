{
  "package": "@activepieces/piece-trello",
  "version": "0.9.0",
  "action": "archive_board",
  "auth": {
    "username": "trello-key",
    "password": "trello-token"
  },
  "inputs": {
    "board_id": "board-1",
    "closed": true
  },
  "credential": {
    "apiKey": "trello-key",
    "token": "trello-token"
  },
  "answers": [
    {
      "status": 200,
      "body": {
        "id": "board-1",
        "name": "Roadmap",
        "desc": "Plans",
        "closed": false,
        "url": "https://trello.com/b/xyz/roadmap"
      }
    }
  ],
  "exchanges": [
    {
      "request": {
        "method": "PUT",
        "url": "https://api.trello.com/1/boards/board-1/closed?value=true&key=trello-key&token=trello-token",
        "headers": {},
        "body": null
      }
    }
  ],
  "output": {
    "id": "board-1",
    "name": "Roadmap",
    "desc": "Plans",
    "closed": false,
    "url": "https://trello.com/b/xyz/roadmap"
  }
}
