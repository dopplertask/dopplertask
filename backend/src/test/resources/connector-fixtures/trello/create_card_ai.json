{
  "package": "@activepieces/piece-trello",
  "version": "0.9.0",
  "action": "create_card_ai",
  "auth": {
    "username": "trello-key",
    "password": "trello-token"
  },
  "inputs": {
    "list_id": "list-1",
    "name": "Launch post",
    "description": "Draft it",
    "position": "bottom",
    "labels": [
      "label-1"
    ]
  },
  "credential": {
    "apiKey": "trello-key",
    "token": "trello-token"
  },
  "answers": [
    {
      "status": 200,
      "body": {
        "id": "card-1",
        "name": "Launch post",
        "desc": "Draft it",
        "idList": "list-1",
        "idBoard": "board-1",
        "closed": false,
        "url": "https://trello.com/c/abc/1-launch-post"
      }
    }
  ],
  "exchanges": [
    {
      "request": {
        "method": "POST",
        "url": "https://api.trello.com/1/cards?idList=list-1&key=trello-key&token=trello-token",
        "headers": {
          "content-type": "application/json"
        },
        "body": {
          "name": "Launch post",
          "desc": "Draft it",
          "pos": "bottom",
          "idLabels": [
            "label-1"
          ]
        }
      }
    }
  ],
  "output": {
    "id": "card-1",
    "name": "Launch post",
    "desc": "Draft it",
    "idList": "list-1",
    "idBoard": "board-1",
    "closed": false,
    "url": "https://trello.com/c/abc/1-launch-post"
  }
}
