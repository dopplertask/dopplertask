{
  "package": "@activepieces/piece-trello",
  "version": "0.9.0",
  "action": "copy_card",
  "auth": {
    "username": "trello-key",
    "password": "trello-token"
  },
  "inputs": {
    "source_card_id": "card-1",
    "list_id": "list-2",
    "name": "Launch-post-copy",
    "keep_from_source": [
      "checklists",
      "labels"
    ],
    "position": "top"
  },
  "credential": {
    "apiKey": "trello-key",
    "token": "trello-token"
  },
  "answers": [
    {
      "status": 200,
      "body": {
        "id": "card-1",
        "name": "Launch post",
        "desc": "Draft it",
        "idList": "list-1",
        "idBoard": "board-1",
        "closed": false,
        "url": "https://trello.com/c/abc/1-launch-post"
      }
    }
  ],
  "exchanges": [
    {
      "request": {
        "method": "POST",
        "url": "https://api.trello.com/1/cards?idCardSource=card-1&idList=list-2&name=Launch-post-copy&pos=top&keepFromSource=checklists%2Clabels&key=trello-key&token=trello-token",
        "headers": {},
        "body": null
      }
    }
  ],
  "output": {
    "id": "card-1",
    "name": "Launch post",
    "desc": "Draft it",
    "idList": "list-1",
    "idBoard": "board-1",
    "closed": false,
    "url": "https://trello.com/c/abc/1-launch-post"
  }
}
