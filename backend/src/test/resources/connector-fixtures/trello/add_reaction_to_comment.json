{
  "package": "@activepieces/piece-trello",
  "version": "0.9.0",
  "action": "add_reaction_to_comment",
  "auth": {
    "username": "trello-key",
    "password": "trello-token"
  },
  "inputs": {
    "action_id": "action-1",
    "short_name": "thumbsup"
  },
  "credential": {
    "apiKey": "trello-key",
    "token": "trello-token"
  },
  "answers": [
    {
      "status": 200,
      "body": {
        "id": "reaction-1",
        "idMember": "member-1",
        "idModel": "action-1",
        "emoji": {
          "shortName": "thumbsup"
        }
      }
    }
  ],
  "exchanges": [
    {
      "request": {
        "method": "POST",
        "url": "https://api.trello.com/1/actions/action-1/reactions?key=trello-key&token=trello-token",
        "headers": {
          "content-type": "application/json"
        },
        "body": {
          "shortName": "thumbsup"
        }
      }
    }
  ],
  "output": {
    "id": "reaction-1",
    "idMember": "member-1",
    "idModel": "action-1",
    "emoji": {
      "shortName": "thumbsup"
    }
  }
}
