{
  "package": "@activepieces/piece-trello",
  "version": "0.9.0",
  "action": "update_checklist_item",
  "auth": {
    "username": "trello-key",
    "password": "trello-token"
  },
  "inputs": {
    "card_id": "card-1",
    "checkitem_id": "item-1",
    "name": "Publish",
    "state": "incomplete",
    "position": "top"
  },
  "credential": {
    "apiKey": "trello-key",
    "token": "trello-token"
  },
  "answers": [
    {
      "status": 200,
      "body": {
        "id": "item-1",
        "name": "Write",
        "state": "complete",
        "idChecklist": "checklist-1"
      }
    }
  ],
  "exchanges": [
    {
      "request": {
        "method": "PUT",
        "url": "https://api.trello.com/1/cards/card-1/checkItem/item-1?name=Publish&state=incomplete&pos=top&key=trello-key&token=trello-token",
        "headers": {},
        "body": null
      }
    }
  ],
  "output": {
    "id": "item-1",
    "name": "Write",
    "state": "complete",
    "idChecklist": "checklist-1"
  }
}
