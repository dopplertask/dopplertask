{
  "package": "@activepieces/piece-trello",
  "version": "0.9.0",
  "action": "create_custom_field_option",
  "auth": {
    "username": "trello-key",
    "password": "trello-token"
  },
  "inputs": {
    "custom_field_id": "field-1",
    "value": "High"
  },
  "credential": {
    "apiKey": "trello-key",
    "token": "trello-token"
  },
  "answers": [
    {
      "status": 200,
      "body": {
        "id": "option-1",
        "idCustomField": "field-1",
        "value": {
          "text": "High"
        },
        "pos": 16384
      }
    }
  ],
  "exchanges": [
    {
      "request": {
        "method": "POST",
        "url": "https://api.trello.com/1/customFields/field-1/options?key=trello-key&token=trello-token",
        "headers": {
          "content-type": "application/json"
        },
        "body": {
          "value": {
            "text": "High"
          },
          "pos": "bottom"
        }
      }
    }
  ],
  "output": {
    "id": "option-1",
    "idCustomField": "field-1",
    "value": {
      "text": "High"
    },
    "pos": 16384
  }
}
