{
  "package": "@activepieces/piece-trello",
  "version": "0.9.0",
  "action": "add_card_attachment_from_url",
  "auth": {
    "username": "trello-key",
    "password": "trello-token"
  },
  "inputs": {
    "card_id": "card-1",
    "url": "https://example.com/spec.pdf",
    "name": "Spec",
    "set_cover": true
  },
  "credential": {
    "apiKey": "trello-key",
    "token": "trello-token"
  },
  "answers": [
    {
      "status": 200,
      "body": {
        "id": "att-1",
        "name": "spec.pdf",
        "url": "https://example.com/spec.pdf",
        "mimeType": "application/pdf",
        "bytes": 1024
      }
    }
  ],
  "exchanges": [
    {
      "request": {
        "method": "POST",
        "url": "https://api.trello.com/1/cards/card-1/attachments?url=https%3A%2F%2Fexample.com%2Fspec.pdf&name=Spec&setCover=true&key=trello-key&token=trello-token",
        "headers": {},
        "body": null
      }
    }
  ],
  "output": {
    "id": "att-1",
    "name": "spec.pdf",
    "url": "https://example.com/spec.pdf",
    "mimeType": "application/pdf",
    "bytes": 1024
  }
}
