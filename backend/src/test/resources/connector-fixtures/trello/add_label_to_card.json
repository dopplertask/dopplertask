{
  "package": "@activepieces/piece-trello",
  "version": "0.9.0",
  "action": "add_label_to_card",
  "auth": {
    "username": "trello-key",
    "password": "trello-token"
  },
  "inputs": {
    "card_id": "card-1",
    "label_id": "label-1"
  },
  "credential": {
    "apiKey": "trello-key",
    "token": "trello-token"
  },
  "answers": [
    {
      "status": 200,
      "body": [
        "label-1"
      ]
    }
  ],
  "exchanges": [
    {
      "request": {
        "method": "POST",
        "url": "https://api.trello.com/1/cards/card-1/idLabels?value=label-1&key=trello-key&token=trello-token",
        "headers": {},
        "body": null
      }
    }
  ],
  "output": [
    "label-1"
  ]
}
