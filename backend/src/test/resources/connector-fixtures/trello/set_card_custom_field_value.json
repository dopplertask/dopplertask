{
  "package": "@activepieces/piece-trello",
  "version": "0.9.0",
  "action": "set_card_custom_field_value",
  "auth": {
    "username": "trello-key",
    "password": "trello-token"
  },
  "inputs": {
    "card_id": "card-1",
    "custom_field_id": "field-1",
    "field_type": "checkbox",
    "value": "True"
  },
  "credential": {
    "apiKey": "trello-key",
    "token": "trello-token"
  },
  "answers": [
    {
      "status": 200,
      "body": {
        "id": "cfi-1",
        "idCustomField": "field-1",
        "idModel": "card-1",
        "modelType": "card",
        "value": {
          "checked": "true"
        }
      }
    }
  ],
  "exchanges": [
    {
      "request": {
        "method": "PUT",
        "url": "https://api.trello.com/1/cards/card-1/customField/field-1/item?key=trello-key&token=trello-token",
        "headers": {
          "content-type": "application/json"
        },
        "body": {
          "value": {
            "checked": true
          }
        }
      }
    }
  ],
  "output": {
    "id": "cfi-1",
    "idCustomField": "field-1",
    "idModel": "card-1",
    "modelType": "card",
    "value": {
      "checked": "true"
    }
  }
}
