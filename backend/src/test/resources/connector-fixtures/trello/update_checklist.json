{
  "package": "@activepieces/piece-trello",
  "version": "0.9.0",
  "action": "update_checklist",
  "auth": {
    "username": "trello-key",
    "password": "trello-token"
  },
  "inputs": {
    "checklist_id": "checklist-1",
    "name": "Launch-steps",
    "position": "bottom"
  },
  "credential": {
    "apiKey": "trello-key",
    "token": "trello-token"
  },
  "answers": [
    {
      "status": 200,
      "body": {
        "id": "checklist-1",
        "name": "Steps",
        "idCard": "card-1",
        "idBoard": "board-1",
        "checkItems": [
          {
            "id": "item-1",
            "name": "Write",
            "state": "incomplete"
          }
        ]
      }
    }
  ],
  "exchanges": [
    {
      "request": {
        "method": "PUT",
        "url": "https://api.trello.com/1/checklists/checklist-1?name=Launch-steps&pos=bottom&key=trello-key&token=trello-token",
        "headers": {},
        "body": null
      }
    }
  ],
  "output": {
    "id": "checklist-1",
    "name": "Steps",
    "idCard": "card-1",
    "idBoard": "board-1",
    "checkItems": [
      {
        "id": "item-1",
        "name": "Write",
        "state": "incomplete"
      }
    ]
  }
}
