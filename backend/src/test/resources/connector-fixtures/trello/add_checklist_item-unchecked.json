{
  "package": "@activepieces/piece-trello",
  "version": "0.9.0",
  "action": "add_checklist_item",
  "auth": {
    "username": "trello-key",
    "password": "trello-token"
  },
  "inputs": {
    "checklist_id": "checklist-1",
    "name": "Review",
    "checked": false
  },
  "credential": {
    "apiKey": "trello-key",
    "token": "trello-token"
  },
  "answers": [
    {
      "status": 200,
      "body": {
        "id": "item-1",
        "name": "Write",
        "state": "complete",
        "idChecklist": "checklist-1"
      }
    }
  ],
  "exchanges": [
    {
      "request": {
        "method": "POST",
        "url": "https://api.trello.com/1/checklists/checklist-1/checkItems?name=Review&checked=false&key=trello-key&token=trello-token",
        "headers": {},
        "body": null
      }
    }
  ],
  "output": {
    "id": "item-1",
    "name": "Write",
    "state": "complete",
    "idChecklist": "checklist-1"
  }
}
