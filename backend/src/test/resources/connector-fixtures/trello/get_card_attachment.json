{
  "package": "@activepieces/piece-trello",
  "version": "0.9.0",
  "action": "get_card_attachment",
  "auth": {
    "username": "trello-key",
    "password": "trello-token"
  },
  "inputs": {
    "card_id": "card-1",
    "attachment_id": "att-1"
  },
  "credential": {
    "apiKey": "trello-key",
    "token": "trello-token"
  },
  "answers": [
    {
      "status": 200,
      "body": {
        "id": "att-1",
        "name": "spec.pdf",
        "url": "https://example.com/spec.pdf",
        "mimeType": "application/pdf",
        "bytes": 1024
      }
    }
  ],
  "exchanges": [
    {
      "request": {
        "method": "GET",
        "url": "https://api.trello.com/1/cards/card-1/attachments/att-1?key=trello-key&token=trello-token",
        "headers": {},
        "body": null
      }
    }
  ],
  "output": {
    "id": "att-1",
    "name": "spec.pdf",
    "url": "https://example.com/spec.pdf",
    "mimeType": "application/pdf",
    "bytes": 1024
  }
}
