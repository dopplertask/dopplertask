{
  "package": "@activepieces/piece-trello",
  "version": "0.9.0",
  "action": "add_member_to_card",
  "auth": {
    "username": "trello-key",
    "password": "trello-token"
  },
  "inputs": {
    "card_id": "card-1",
    "member_id": "member-1"
  },
  "credential": {
    "apiKey": "trello-key",
    "token": "trello-token"
  },
  "answers": [
    {
      "status": 200,
      "body": [
        {
          "id": "member-1",
          "username": "ada",
          "fullName": "Ada Lovelace"
        }
      ]
    }
  ],
  "exchanges": [
    {
      "request": {
        "method": "POST",
        "url": "https://api.trello.com/1/cards/card-1/idMembers?value=member-1&key=trello-key&token=trello-token",
        "headers": {},
        "body": null
      }
    }
  ],
  "output": [
    {
      "id": "member-1",
      "username": "ada",
      "fullName": "Ada Lovelace"
    }
  ]
}
