{
  "package": "@activepieces/piece-trello",
  "version": "0.9.0",
  "action": "list_board_labels",
  "auth": {
    "username": "trello-key",
    "password": "trello-token"
  },
  "inputs": {
    "board_id": "board-1",
    "limit": 0
  },
  "credential": {
    "apiKey": "trello-key",
    "token": "trello-token"
  },
  "answers": [
    {
      "status": 200,
      "body": [
        {
          "id": "label-1",
          "idBoard": "board-1",
          "name": "Urgent",
          "color": "red"
        }
      ]
    }
  ],
  "exchanges": [
    {
      "request": {
        "method": "GET",
        "url": "https://api.trello.com/1/boards/board-1/labels?key=trello-key&token=trello-token",
        "headers": {},
        "body": null
      }
    }
  ],
  "output": {
    "labels": [
      {
        "id": "label-1",
        "idBoard": "board-1",
        "name": "Urgent",
        "color": "red"
      }
    ],
    "count": 1
  }
}
