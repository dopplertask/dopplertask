{
  "package": "@activepieces/piece-trello",
  "version": "0.9.0",
  "action": "create_board_label",
  "auth": {
    "username": "trello-key",
    "password": "trello-token"
  },
  "inputs": {
    "board_id": "board-1",
    "name": "Urgent",
    "color": "red"
  },
  "credential": {
    "apiKey": "trello-key",
    "token": "trello-token"
  },
  "answers": [
    {
      "status": 200,
      "body": {
        "id": "label-1",
        "idBoard": "board-1",
        "name": "Urgent",
        "color": "red"
      }
    }
  ],
  "exchanges": [
    {
      "request": {
        "method": "POST",
        "url": "https://api.trello.com/1/labels?idBoard=board-1&name=Urgent&color=red&key=trello-key&token=trello-token",
        "headers": {},
        "body": null
      }
    }
  ],
  "output": {
    "id": "label-1",
    "idBoard": "board-1",
    "name": "Urgent",
    "color": "red"
  }
}
