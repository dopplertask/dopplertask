{
  "package": "@activepieces/piece-trello",
  "version": "0.9.0",
  "action": "create_board_custom_field",
  "auth": {
    "username": "trello-key",
    "password": "trello-token"
  },
  "inputs": {
    "board_id": "board-1",
    "name": "Priority",
    "type": "list"
  },
  "credential": {
    "apiKey": "trello-key",
    "token": "trello-token"
  },
  "answers": [
    {
      "status": 200,
      "body": {
        "id": "field-1",
        "name": "Priority",
        "type": "list",
        "idModel": "board-1",
        "modelType": "board"
      }
    }
  ],
  "exchanges": [
    {
      "request": {
        "method": "POST",
        "url": "https://api.trello.com/1/customFields?key=trello-key&token=trello-token",
        "headers": {
          "content-type": "application/json"
        },
        "body": {
          "idModel": "board-1",
          "modelType": "board",
          "name": "Priority",
          "type": "list",
          "pos": "bottom",
          "display_cardFront": false
        }
      }
    }
  ],
  "output": {
    "id": "field-1",
    "name": "Priority",
    "type": "list",
    "idModel": "board-1",
    "modelType": "board"
  }
}
