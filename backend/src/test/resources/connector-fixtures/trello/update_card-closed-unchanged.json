{
  "package": "@activepieces/piece-trello",
  "version": "0.9.0",
  "action": "update_card",
  "auth": {
    "username": "trello-key",
    "password": "trello-token"
  },
  "inputs": {
    "card_id": "card-1",
    "board_id": "board-1"
  },
  "credential": {
    "apiKey": "trello-key",
    "token": "trello-token"
  },
  "answers": [
    {
      "status": 200,
      "body": {
        "id": "card-1",
        "name": "Launch post",
        "desc": "Draft it",
        "idList": "list-1",
        "idBoard": "board-1",
        "closed": false,
        "url": "https://trello.com/c/abc/1-launch-post"
      }
    }
  ],
  "exchanges": [
    {
      "request": {
        "method": "PUT",
        "url": "https://api.trello.com/1/cards/card-1?key=trello-key&token=trello-token",
        "headers": {
          "content-type": "application/json"
        },
        "body": {}
      }
    }
  ],
  "output": {
    "id": "card-1",
    "name": "Launch post",
    "desc": "Draft it",
    "idList": "list-1",
    "idBoard": "board-1",
    "closed": false,
    "url": "https://trello.com/c/abc/1-launch-post"
  }
}
