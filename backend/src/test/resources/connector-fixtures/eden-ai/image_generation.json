{
  "package": "@activepieces/piece-eden-ai",
  "version": "0.2.5",
  "action": "image_generation",
  "auth": {
    "type": "SECRET_TEXT",
    "secret_text": "test-key-1234567890"
  },
  "inputs": {
    "provider": "openai",
    "text": "Some fake text to analyse.",
    "resolution": "512x512",
    "num_images": 2,
    "model": "dall-e-3",
    "fallback_providers": [
      "stabilityai"
    ],
    "show_original_response": true
  },
  "credential": {
    "apiKey": "test-key-1234567890"
  },
  "answers": [
    {
      "status": 200,
      "body": {
        "openai": {
          "status": "success",
          "items": [
            {
              "image": "aGVsbG8=",
              "image_resource_url": "https://example.com/i.png"
            }
          ]
        }
      }
    }
  ],
  "exchanges": [
    {
      "request": {
        "method": "POST",
        "url": "https://api.edenai.run/v2/image/generation/",
        "headers": {
          "authorization": "Bearer test-key-1234567890",
          "content-type": "application/json"
        },
        "body": {
          "providers": "openai",
          "text": "Some fake text to analyse.",
          "resolution": "512x512",
          "num_images": 2,
          "show_original_response": true,
          "fallback_providers": [
            "stabilityai"
          ],
          "settings": {
            "openai": "dall-e-3"
          }
        }
      }
    }
  ],
  "output": {
    "provider": "openai",
    "items": [
      {
        "image": "aGVsbG8=",
        "image_resource_url": "https://example.com/i.png"
      }
    ],
    "status": "success",
    "original_response": null,
    "raw": {
      "openai": {
        "status": "success",
        "items": [
          {
            "image": "aGVsbG8=",
            "image_resource_url": "https://example.com/i.png"
          }
        ]
      }
    }
  }
}
