{
  "package": "@activepieces/piece-eden-ai",
  "version": "0.2.5",
  "action": "spell_check",
  "auth": {
    "type": "SECRET_TEXT",
    "secret_text": "test-key-1234567890"
  },
  "inputs": {
    "provider": "openai",
    "text": "Some fake text to analyse.",
    "language": "en",
    "model": "test-model",
    "fallback_providers": [
      "microsoft"
    ],
    "show_original_response": true
  },
  "credential": {
    "apiKey": "test-key-1234567890"
  },
  "answers": [
    {
      "status": 200,
      "body": {
        "openai": {
          "status": "success",
          "text": "Helo world",
          "items": [
            {
              "text": "Helo",
              "type": "spelling",
              "offset": 0,
              "length": 4,
              "suggestions": [
                {
                  "suggestion": "Hello",
                  "score": 0.9
                }
              ]
            }
          ]
        }
      }
    }
  ],
  "exchanges": [
    {
      "request": {
        "method": "POST",
        "url": "https://api.edenai.run/v2/text/spell_check",
        "headers": {
          "authorization": "Bearer test-key-1234567890",
          "content-type": "application/json"
        },
        "body": {
          "providers": "openai",
          "text": "Some fake text to analyse.",
          "language": "en",
          "show_original_response": true,
          "fallback_providers": [
            "microsoft"
          ],
          "settings": {
            "openai": "test-model"
          }
        }
      }
    }
  ],
  "output": {
    "provider": "openai",
    "text": "Helo world",
    "items": [
      {
        "text": "Helo",
        "type": "spelling",
        "offset": 0,
        "length": 4,
        "suggestions": [
          {
            "suggestion": "Hello",
            "score": 0.9
          }
        ]
      }
    ],
    "status": "success",
    "original_response": null,
    "raw": {
      "openai": {
        "status": "success",
        "text": "Helo world",
        "items": [
          {
            "text": "Helo",
            "type": "spelling",
            "offset": 0,
            "length": 4,
            "suggestions": [
              {
                "suggestion": "Hello",
                "score": 0.9
              }
            ]
          }
        ]
      }
    }
  }
