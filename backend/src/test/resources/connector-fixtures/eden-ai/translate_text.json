{
  "package": "@activepieces/piece-eden-ai",
  "version": "0.2.5",
  "action": "translate_text",
  "auth": {
    "type": "SECRET_TEXT",
    "secret_text": "test-key-1234567890"
  },
  "inputs": {
    "provider": "openai",
    "text": "Some fake text to analyse.",
    "source_language": "en",
    "target_language": "sv",
    "model": "test-model",
    "fallback_providers": [
      "amazon"
    ],
    "show_original_response": true
  },
  "credential": {
    "apiKey": "test-key-1234567890"
  },
  "answers": [
    {
      "status": 200,
      "body": {
        "openai": {
          "status": "success",
          "text": "Hej världen"
        }
      }
    }
  ],
  "exchanges": [
    {
      "request": {
        "method": "POST",
        "url": "https://api.edenai.run/v2/translation/automatic_translation",
        "headers": {
          "authorization": "Bearer test-key-1234567890",
          "content-type": "application/json"
        },
        "body": {
          "providers": "openai",
          "text": "Some fake text to analyse.",
          "target_language": "sv",
          "source_language": "en",
          "show_original_response": true,
          "fallback_providers": [
            "amazon"
          ],
          "settings": {
            "openai": "test-model"
          }
        }
      }
    }
  ],
  "output": {
    "provider": "openai",
    "text": "Hej världen",
    "status": "success",
    "original_response": null,
    "raw": {
      "openai": {
        "status": "success",
        "text": "Hej världen"
      }
    }
  }
}
