{
  "package": "@activepieces/piece-eden-ai",
  "version": "0.2.5",
  "action": "detect_language",
  "auth": {
    "type": "SECRET_TEXT",
    "secret_text": "test-key-1234567890"
  },
  "inputs": {
    "provider": "openai",
    "text": "Some fake text to analyse.",
    "model": "test-model",
    "fallback_providers": [
      "amazon"
    ],
    "show_original_response": true
  },
  "credential": {
    "apiKey": "test-key-1234567890"
  },
  "answers": [
    {
      "status": 200,
      "body": {
        "openai": {
          "status": "success",
          "items": [
            {
              "language": "sv",
              "display_name": "Swedish",
              "confidence": 0.98
            }
          ]
        }
      }
    }
  ],
  "exchanges": [
    {
      "request": {
        "method": "POST",
        "url": "https://api.edenai.run/v2/translation/language_detection",
        "headers": {
          "authorization": "Bearer test-key-1234567890",
          "content-type": "application/json"
        },
        "body": {
          "providers": "openai",
          "text": "Some fake text to analyse.",
          "show_original_response": true,
          "fallback_providers": [
            "amazon"
          ],
          "settings": {
            "openai": "test-model"
          }
        }
      }
    }
  ],
  "output": {
    "provider": "openai",
    "languages": [
      {
        "language": "sv",
        "display_name": "Swedish",
        "confidence": 0.98
      }
    ],
    "status": "success",
    "original_response": null,
    "raw": {
      "openai": {
        "status": "success",
        "items": [
          {
            "language": "sv",
            "display_name": "Swedish",
            "confidence": 0.98
          }
        ]
      }
    }
  }
}
