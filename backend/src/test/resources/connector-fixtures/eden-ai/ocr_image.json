{
  "package": "@activepieces/piece-eden-ai",
  "version": "0.2.5",
  "action": "ocr_image",
  "auth": {
    "type": "SECRET_TEXT",
    "secret_text": "test-key-1234567890"
  },
  "inputs": {
    "provider": "google",
    "file_url": "https://example.com/receipt.pdf",
    "language": "en",
    "file_password": "fake-pass",
    "attributes_as_list": true,
    "fallback_providers": [
      "amazon"
    ],
    "show_original_response": true
  },
  "credential": {
    "apiKey": "test-key-1234567890"
  },
  "answers": [
    {
      "status": 200,
      "body": {
        "google": {
          "status": "success",
          "text": "Receipt 42",
          "bounding_boxes": [
            {
              "text": "Receipt",
              "left": 0.1,
              "top": 0.1,
              "width": 0.3,
              "height": 0.05
            }
          ]
        }
      }
    }
  ],
  "exchanges": [
    {
      "request": {
        "method": "POST",
        "url": "https://api.edenai.run/v2/ocr/ocr",
        "headers": {
          "authorization": "Bearer test-key-1234567890",
          "content-type": "application/json"
        },
        "body": {
          "providers": "google",
          "file_url": "https://example.com/receipt.pdf",
          "language": "en",
          "file_password": "fake-pass",
          "attributes_as_list": true,
          "show_original_response": true,
          "fallback_providers": [
            "amazon"
          ]
        }
      }
    }
  ],
  "output": {
    "provider": "google",
    "text": "Receipt 42",
    "bounding_boxes": [
      {
        "text": "Receipt",
        "left": 0.1,
        "top": 0.1,
        "width": 0.3,
        "height": 0.05
      }
    ],
    "status": "success",
    "original_response": null,
    "raw": {
      "google": {
        "status": "success",
        "text": "Receipt 42",
        "bounding_boxes": [
          {
            "text": "Receipt",
            "left": 0.1,
            "top": 0.1,
            "width": 0.3,
            "height": 0.05
          }
        ]
      }
    }
  }
}
