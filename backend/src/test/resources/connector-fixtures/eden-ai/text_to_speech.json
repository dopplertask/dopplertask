{
  "package": "@activepieces/piece-eden-ai",
  "version": "0.2.5",
  "action": "text_to_speech",
  "auth": {
    "type": "SECRET_TEXT",
    "secret_text": "test-key-1234567890"
  },
  "inputs": {
    "provider": "google",
    "text": "Some fake text to analyse.",
    "language": "en",
    "option": "MALE",
    "rate": 10,
    "pitch": -5,
    "volume": 20,
    "audio_format": "mp3",
    "sampling_rate": 24000,
    "fallback_providers": [
      "amazon"
    ],
    "show_original_response": true
  },
  "credential": {
    "apiKey": "test-key-1234567890"
  },
  "answers": [
    {
      "status": 200,
      "body": {
        "google": {
          "status": "success",
          "audio": "aGVsbG8=",
          "audio_resource_url": "https://example.com/a.mp3",
          "voice_type": 1
        }
      }
    }
  ],
  "exchanges": [
    {
      "request": {
        "method": "POST",
        "url": "https://api.edenai.run/v2/audio/text_to_speech/",
        "headers": {
          "authorization": "Bearer test-key-1234567890",
          "content-type": "application/json"
        },
        "body": {
          "providers": "google",
          "text": "Some fake text to analyse.",
          "language": "en",
          "option": "MALE",
          "rate": 10,
          "pitch": -5,
          "volume": 20,
          "audio_format": "mp3",
          "sampling_rate": 24000,
          "show_original_response": true,
          "fallback_providers": [
            "amazon"
          ]
        }
      }
    }
  ],
  "output": {
    "provider": "google",
    "audio": "aGVsbG8=",
    "audio_resource_url": "https://example.com/a.mp3",
    "voice_type": 1,
    "status": "success",
    "original_response": null,
    "raw": {
      "google": {
        "status": "success",
        "audio": "aGVsbG8=",
        "audio_resource_url": "https://example.com/a.mp3",
        "voice_type": 1
      }
    }
  }
}
