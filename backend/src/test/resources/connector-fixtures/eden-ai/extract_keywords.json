{
  "package": "@activepieces/piece-eden-ai",
  "version": "0.2.5",
  "action": "extract_keywords",
  "auth": {
    "type": "SECRET_TEXT",
    "secret_text": "test-key-1234567890"
  },
  "inputs": {
    "provider": "openai",
    "text": "Some fake text to analyse.",
    "language": "en",
    "model": "test-model",
    "fallback_providers": [
      "amazon"
    ],
    "show_original_response": true
  },
  "credential": {
    "apiKey": "test-key-1234567890"
  },
  "answers": [
    {
      "status": 200,
      "body": {
        "openai": {
          "status": "success",
          "items": [
            {
              "keyword": "padel",
              "importance": 0.9
            },
            {
              "keyword": "court"
            }
          ]
        }
      }
    }
  ],
  "exchanges": [
    {
      "request": {
        "method": "POST",
        "url": "https://api.edenai.run/v2/text/keyword_extraction",
        "headers": {
          "authorization": "Bearer test-key-1234567890",
          "content-type": "application/json"
        },
        "body": {
          "providers": "openai",
          "text": "Some fake text to analyse.",
          "language": "en",
          "show_original_response": true,
          "fallback_providers": [
            "amazon"
          ],
          "settings": {
            "openai": "test-model"
          }
        }
      }
    }
  ],
  "output": {
    "provider": "openai",
    "keywords": [
      {
        "keyword": "padel",
        "importance": 0.9
      },
      {
        "keyword": "court",
        "importance": 0
      }
    ],
    "status": "success",
    "original_response": null,
    "raw": {
      "openai": {
        "status": "success",
        "items": [
          {
            "keyword": "padel",
            "importance": 0.9
          },
          {
            "keyword": "court"
          }
        ]
      }
    }
  }
}
