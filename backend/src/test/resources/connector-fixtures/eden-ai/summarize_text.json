{
  "package": "@activepieces/piece-eden-ai",
  "version": "0.2.5",
  "action": "summarize_text",
  "auth": {
    "type": "SECRET_TEXT",
    "secret_text": "test-key-1234567890"
  },
  "inputs": {
    "provider": "openai",
    "text": "Some fake text to analyse.",
    "output_sentences": 2,
    "language": "en",
    "model": "test-model",
    "fallback_providers": [
      "microsoft"
    ],
    "show_original_response": true
  },
  "credential": {
    "apiKey": "test-key-1234567890"
  },
  "answers": [
    {
      "status": 200,
      "body": {
        "openai": {
          "status": "success",
          "result": "A short summary."
        }
      }
    }
  ],
  "exchanges": [
    {
      "request": {
        "method": "POST",
        "url": "https://api.edenai.run/v2/text/summarize",
        "headers": {
          "authorization": "Bearer test-key-1234567890",
          "content-type": "application/json"
        },
        "body": {
          "providers": "openai",
          "text": "Some fake text to analyse.",
          "output_sentences": 2,
          "language": "en",
          "show_original_response": true,
          "fallback_providers": [
            "microsoft"
          ],
          "settings": {
            "openai": "test-model"
          }
        }
      }
    }
  ],
  "output": {
    "provider": "openai",
    "summary": "A short summary.",
    "status": "success",
    "original_response": null,
    "raw": {
      "openai": {
        "status": "success",
        "result": "A short summary."
      }
    }
  }
}
