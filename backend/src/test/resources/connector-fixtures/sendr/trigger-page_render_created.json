{
  "package": "@activepieces/piece-sendr",
  "version": "0.1.1",
  "trigger": "page_render_created",
  "webhook": true,
  "auth": {
    "type": "SECRET_TEXT",
    "secret_text": "test-key"
  },
  "inputs": {},
  "credential": {
    "apiKey": "test-key"
  },
  "answers": [
    {
      "status": 200,
      "body": {
        "url": "https://tasks.example.com/hooks/test-key",
        "name": "Activepieces - New Page Render",
        "events": [
          "page_render.created"
        ],
        "enabled": true
      }
    },
    {
      "status": 200,
      "body": {
        "secret": "whsec-test"
      }
    }
  ],
  "event": {
    "event": "page_render.created",
    "pageId": "page-1",
    "pageUrl": "https://pages.sendr.io/anna-acme",
    "pageSlug": "anna-acme",
    "templateId": "tpl-1",
    "eventStatus": "created"
  },
  "eventHeaders": {
    "x-webhook-secret": "whsec-test"
  },
  "exchanges": [
    {
      "request": {
        "method": "POST",
        "url": "https://api.sendr.io/api/v1/webhook",
        "headers": {
          "authorization": "Bearer test-key",
          "content-type": "application/json"
        },
        "body": {
          "name": "Activepieces - New Page Render",
          "url": "https://tasks.example.com/hooks/test-key",
          "events": [
            "page_render.created"
          ]
        }
      }
    },
    {
      "request": {
        "method": "POST",
        "url": "https://api.sendr.io/api/v1/webhook/reveal-secret",
        "headers": {
          "authorization": "Bearer test-key",
          "content-type": "application/json"
        },
        "body": {
          "url": "https://tasks.example.com/hooks/test-key"
        }
      }
    }
  ],
  "output": [
    {
      "event_type": "page_render.created",
      "page_id": "page-1",
      "page_url": "https://pages.sendr.io/anna-acme",
      "page_slug": "anna-acme",
      "template_id": "tpl-1",
      "event_status": "created"
    }
  ],
  "storeAfter": {
    "webhookUrl": "https://tasks.example.com/hooks/test-key",
    "webhookSecret": "whsec-test"
  }
}
