{
  "package": "@activepieces/piece-sendr",
  "version": "0.1.1",
  "action": "queue_video_generation",
  "auth": {
    "type": "SECRET_TEXT",
    "secret_text": "test-key"
  },
  "inputs": {
    "mode": "lipsync",
    "audioUrl": "https://cdn.example.com/a.mp3",
    "videoUrl": "https://cdn.example.com/v.mp4",
    "muxAssetId": "mux-1",
    "targetWord": "[NAME]",
    "replacementWord": "Anna",
    "pageSlug": "anna-acme",
    "webhookUrl": "https://hooks.example.com/sendr"
  },
  "credential": {
    "apiKey": "test-key"
  },
  "answers": [
    {
      "status": 200,
      "body": {
        "jobId": "job-2",
        "status": "queued"
      }
    }
  ],
  "exchanges": [
    {
      "request": {
        "method": "POST",
        "url": "https://api.sendr.io/api/v1/enrichment/generate-video",
        "headers": {
          "authorization": "Bearer test-key",
          "content-type": "application/json"
        },
        "body": {
          "audioUrl": "https://cdn.example.com/a.mp3",
          "mode": "lipsync",
          "videoUrl": "https://cdn.example.com/v.mp4",
          "muxAssetId": "mux-1",
          "targetWord": "[NAME]",
          "replacementWord": "Anna",
          "pageSlug": "anna-acme",
          "webhookUrl": "https://hooks.example.com/sendr"
        }
      }
    }
  ],
  "output": {
    "jobId": "job-2",
    "status": "queued"
  }
}
