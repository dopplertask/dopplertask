{
  "package": "@activepieces/piece-sendr",
  "version": "0.1.1",
  "action": "generate_sendr_page",
  "auth": {
    "type": "SECRET_TEXT",
    "secret_text": "test-key"
  },
  "inputs": {
    "template": "tpl-1",
    "websiteUrl": "https://acme.example.com",
    "renderGif": true,
    "attributes": {
      "source": "crm"
    },
    "webhookUrl": "https://hooks.example.com/sendr",
    "variables": {
      "first_name": "Anna",
      "company": "Acme Inc"
    }
  },
  "credential": {
    "apiKey": "test-key"
  },
  "answers": [
    {
      "status": 200,
      "body": {
        "id": "page-1",
        "slug": "anna-acme",
        "url": "https://sendr.page/anna-acme",
        "status": "queued"
      }
    }
  ],
  "settings": {
    "template": "tpl-1",
    "websiteUrl": "https://acme.example.com",
    "renderGif": "true",
    "attributes": {
      "source": "crm"
    },
    "webhookUrl": "https://hooks.example.com/sendr",
    "variables": {
      "first_name": "Anna",
      "company": "Acme Inc"
    }
  },
  "exchanges": [
    {
      "request": {
        "method": "POST",
        "url": "https://api.sendr.io/api/v1/enrichment/sendr-page",
        "headers": {
          "authorization": "Bearer test-key",
          "content-type": "application/json"
        },
        "body": {
          "templateId": "tpl-1",
          "variablesValues": {
            "first_name": "Anna",
            "company": "Acme Inc"
          },
          "websiteToScreenshotUrl": "https://acme.example.com",
          "renderGif": true,
          "attributes": {
            "source": "crm"
          },
          "webhookUrl": "https://hooks.example.com/sendr"
        }
      }
    }
  ],
  "output": {
    "id": "page-1",
    "slug": "anna-acme",
    "url": "https://sendr.page/anna-acme",
    "status": "queued"
  }
}
