    "apiKey": "test-key"
  },
  "answers": [
    {
      "status": 200,
      "body": {
        "url": "https://tasks.example.com/hooks/test-key",
        "name": "Activepieces - New Contact Page Engagement",
        "events": [
          "contact_page_engagement.created"
        ],
        "enabled": true
      }
    },
    {
      "status": 200,
      "body": {
        "secret": "whsec-test"
      }
    }
  ],
  "event": {
    "event": "contact_page_engagement.created",
    "pageId": "page-1",
    "pageSlug": "anna-acme",
    "pageUrl": "https://pages.sendr.io/anna-acme",
    "attributes": {
      "first_name": "Anna",
      "company": "Acme Inc"
    },
    "timestamp": "2026-04-24T14:00:00Z"
  },
  "eventHeaders": {
    "x-webhook-secret": "whsec-test"
  },
  "exchanges": [
    {
      "request": {
        "method": "POST",
        "url": "https://api.sendr.io/api/v1/webhook",
        "headers": {
          "authorization": "Bearer test-key",
          "content-type": "application/json"
        },
        "body": {
          "name": "Activepieces - New Contact Page Engagement",
          "url": "https://tasks.example.com/hooks/test-key",
          "events": [
            "contact_page_engagement.created"
          ]
        }
      }
    },
    {
      "request": {
        "method": "POST",
        "url": "https://api.sendr.io/api/v1/webhook/reveal-secret",
        "headers": {
          "authorization": "Bearer test-key",
          "content-type": "application/json"
        },
        "body": {
          "url": "https://tasks.example.com/hooks/test-key"
        }
      }
    }
  ],
  "output": [
    {
      "event_type": "contact_page_engagement.created",
      "page_id": "page-1",
      "page_slug": "anna-acme",
      "page_url": "https://pages.sendr.io/anna-acme",
      "attributes": "{\"first_name\":\"Anna\",\"company\":\"Acme Inc\"}",
