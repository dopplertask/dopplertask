{
  "package": "@activepieces/piece-sendr",
  "version": "0.1.1",
  "trigger": "contact_page_engagement_created",
  "webhook": true,
  "auth": {
    "type": "SECRET_TEXT",
    "secret_text": "test-key"
  },
  "inputs": {},
