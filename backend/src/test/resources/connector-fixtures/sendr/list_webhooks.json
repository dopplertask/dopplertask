{
  "package": "@activepieces/piece-sendr",
  "version": "0.1.1",
  "action": "list_webhooks",
  "auth": {
    "type": "SECRET_TEXT",
    "secret_text": "test-key"
  },
  "inputs": {},
  "credential": {
    "apiKey": "test-key"
  },
  "answers": [
    {
      "status": 200,
      "body": {
        "webhooks": [
          {
            "url": "https://hooks.example.com/sendr",
            "name": "Main",
            "events": [
              "page_render:created",
              "page_render:updated"
            ],
            "enabled": true
          },
          {
            "url": "https://hooks.example.com/b"
          }
        ]
      }
    }
  ],
  "exchanges": [
    {
      "request": {
        "method": "GET",
        "url": "https://api.sendr.io/api/v1/webhook",
        "headers": {
          "authorization": "Bearer test-key"
        },
        "body": null
      }
    }
  ],
  "output": [
    {
      "url": "https://hooks.example.com/sendr",
      "name": "Main",
      "events": "page_render:created, page_render:updated",
      "enabled": true
    },
    {
      "url": "https://hooks.example.com/b",
      "name": null,
      "events": null,
      "enabled": null
    }
  ]
}
