{
  "package": "@activepieces/piece-sendr",
  "version": "0.1.1",
  "action": "queue_dynamic_audio",
  "auth": {
    "type": "SECRET_TEXT",
    "secret_text": "test-key"
  },
  "inputs": {
    "audioUrl": "https://cdn.example.com/base.mp3",
    "targetWord": "[NAME]",
    "replacementWord": "Anna",
    "elevenlabsId": "voice-1",
    "languageCode": "en-US",
    "webhookUrl": "https://hooks.example.com/sendr"
  },
  "credential": {
    "apiKey": "test-key"
  },
  "answers": [
    {
      "status": 200,
      "body": {
        "jobId": "job-1",
        "status": "queued"
      }
    }
  ],
  "exchanges": [
    {
      "request": {
        "method": "POST",
        "url": "https://api.sendr.io/api/v1/enrichment/dynamic-audio",
        "headers": {
          "authorization": "Bearer test-key",
          "content-type": "application/json"
        },
        "body": {
          "audioUrl": "https://cdn.example.com/base.mp3",
          "targetWord": "[NAME]",
          "replacementWord": "Anna",
          "elevenlabsId": "voice-1",
          "languageCode": "en-US",
          "webhookUrl": "https://hooks.example.com/sendr"
        }
      }
    }
  ],
  "output": {
    "jobId": "job-1",
    "status": "queued"
  }
}
