{
  "package": "@activepieces/piece-sendr",
  "version": "0.1.1",
  "action": "reveal_webhook_secret",
  "auth": {
    "type": "SECRET_TEXT",
    "secret_text": "test-key"
  },
  "inputs": {
    "webhook": "https://hooks.example.com/sendr"
  },
  "credential": {
    "apiKey": "test-key"
  },
  "answers": [
    {
      "status": 200,
      "body": {
        "secret": "whsec_fake"
      }
    }
  ],
  "exchanges": [
    {
      "request": {
        "method": "POST",
        "url": "https://api.sendr.io/api/v1/webhook/reveal-secret",
        "headers": {
          "authorization": "Bearer test-key",
          "content-type": "application/json"
        },
        "body": {
          "url": "https://hooks.example.com/sendr"
        }
      }
    }
  ],
  "output": {
    "secret": "whsec_fake"
  }
}
