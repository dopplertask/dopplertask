{
  "package": "@activepieces/piece-sendr",
  "version": "0.1.1",
  "action": "add_row_to_sheet",
  "auth": {
    "type": "SECRET_TEXT",
    "secret_text": "test-key"
  },
  "inputs": {
    "sheet": "sh-1",
    "rowData": {
      "Email": "john@example.com",
      "First Name": "John"
    }
  },
  "credential": {
    "apiKey": "test-key"
  },
  "answers": [
    {
      "status": 200,
      "body": {
        "id": "row-1",
        "values": {
          "Email": "john@example.com",
          "First Name": "John"
        }
      }
    }
  ],
  "exchanges": [
    {
      "request": {
        "method": "POST",
        "url": "https://api.sendr.io/api/v1/sheet/sh-1/row",
        "headers": {
          "authorization": "Bearer test-key",
          "content-type": "application/json"
        },
        "body": {
          "Email": "john@example.com",
          "First Name": "John"
        }
      }
    }
  ],
  "output": {
    "id": "row-1",
    "values_Email": "john@example.com",
    "values_First Name": "John"
  }
}
