{
  "package": "@activepieces/piece-sendr",
  "version": "0.1.1",
  "action": "toggle_webhook",
  "auth": {
    "type": "SECRET_TEXT",
    "secret_text": "test-key"
  },
  "inputs": {
    "webhook": "https://hooks.example.com/sendr",
    "enabled": false
  },
  "credential": {
    "apiKey": "test-key"
  },
  "answers": [
    {
      "status": 200,
      "body": {
        "url": "https://hooks.example.com/sendr",
        "enabled": false
      }
    }
  ],
  "settings": {
    "webhook": "https://hooks.example.com/sendr",
    "enabled": "false"
  },
  "exchanges": [
    {
      "request": {
        "method": "POST",
        "url": "https://api.sendr.io/api/v1/webhook/enabling",
        "headers": {
          "authorization": "Bearer test-key",
          "content-type": "application/json"
        },
        "body": {
          "url": "https://hooks.example.com/sendr",
          "enabled": false
        }
      }
    }
  ],
  "output": {
    "url": "https://hooks.example.com/sendr",
    "enabled": false
  }
}
