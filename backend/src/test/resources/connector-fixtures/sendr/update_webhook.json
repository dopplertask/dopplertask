{
  "package": "@activepieces/piece-sendr",
  "version": "0.1.1",
  "action": "update_webhook",
  "auth": {
    "type": "SECRET_TEXT",
    "secret_text": "test-key"
  },
  "inputs": {
    "webhook": "https://hooks.example.com/sendr",
    "name": "Renamed",
    "events": [
      "page_render:updated"
    ],
    "attributes": {
      "team": "sales"
    },
    "resourceType": "campaign",
    "resourceId": "cmp-2"
  },
  "credential": {
    "apiKey": "test-key"
  },
  "answers": [
    {
      "status": 200,
      "body": {
        "url": "https://hooks.example.com/sendr",
        "name": "Renamed",
        "events": [
          "page_render:updated"
        ]
      }
    }
  ],
  "exchanges": [
    {
      "request": {
        "method": "PATCH",
        "url": "https://api.sendr.io/api/v1/webhook",
        "headers": {
          "authorization": "Bearer test-key",
          "content-type": "application/json"
        },
        "body": {
          "name": "Renamed",
          "events": [
            "page_render:updated"
          ],
          "attributes": {
            "team": "sales"
          },
          "resourceType": "campaign",
          "resourceId": "cmp-2",
          "url": "https://hooks.example.com/sendr"
        }
      }
    }
  ],
  "output": {
    "url": "https://hooks.example.com/sendr",
    "name": "Renamed",
    "events": "page_render:updated"
  }
}
