{
  "package": "@activepieces/piece-sendr",
  "version": "0.1.1",
  "action": "get_sheet_columns",
  "auth": {
    "type": "SECRET_TEXT",
    "secret_text": "test-key"
  },
  "inputs": {
    "sheet": "sh-1"
  },
  "credential": {
    "apiKey": "test-key"
  },
  "answers": [
    {
      "status": 200,
      "body": {
        "columns": [
          {
            "id": "col-1",
