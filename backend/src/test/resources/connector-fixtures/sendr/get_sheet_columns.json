            "enriched": false
          },
          {
            "id": "col-2",
            "name": "Company"
          }
        ]
      }
    }
  ],
  "exchanges": [
    {
      "request": {
        "method": "GET",
        "url": "https://api.sendr.io/api/v1/sheet/sh-1/column",
        "headers": {
          "authorization": "Bearer test-key"
        },
        "body": null
      }
    }
  ],
  "output": [
    {
      "id": "col-1",
      "name": "Email",
      "type": "email",
      "enriched": false
    },
    {
      "id": "col-2",
      "name": "Company",
      "type": null,
      "enriched": null
    }
  ]
}
