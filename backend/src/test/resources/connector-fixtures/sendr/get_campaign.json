          "opened": 4
        }
      }
    }
  ],
  "exchanges": [
    {
      "request": {
        "method": "GET",
        "url": "https://api.sendr.io/api/v1/campaigns/cmp-1",
        "headers": {
          "authorization": "Bearer test-key"
        },
        "body": null
      }
    }
  ],
  "output": {
    "id": "cmp-1",
    "name": "Spring",
    "status": "ACTIVE",
    "stats_sent": 10,
    "stats_opened": 4
  }
