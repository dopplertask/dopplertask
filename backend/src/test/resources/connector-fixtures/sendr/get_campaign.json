{
  "package": "@activepieces/piece-sendr",
  "version": "0.1.1",
  "action": "get_campaign",
  "auth": {
    "type": "SECRET_TEXT",
    "secret_text": "test-key"
  },
  "inputs": {
    "campaign": "cmp-1"
  },
  "credential": {
    "apiKey": "test-key"
  },
  "answers": [
    {
      "status": 200,
      "body": {
        "id": "cmp-1",
        "name": "Spring",
