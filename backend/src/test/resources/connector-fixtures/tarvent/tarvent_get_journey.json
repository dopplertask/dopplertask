{
  "package": "@activepieces/piece-tarvent",
  "version": "0.2.1",
  "action": "tarvent_get_journey",
  "auth": {
    "type": "CUSTOM_AUTH",
    "props": {
      "accountId": "acc-1",
      "apiKey": "test-key"
    }
  },
  "inputs": {
    "name": "Welcome",
    "tags": "onboarding",
    "status": "RUNNING",
    "limit": 10,
    "cursor": ""
  },
  "credential": {
    "accountId": "acc-1",
    "apiKey": "test-key"
  },
  "answers": [
    {
      "status": 200,
      "body": {
        "data": {
          "journeys": {
            "nodes": [
              {
                "id": "j-1",
                "name": "Welcome",
                "status": "RUNNING",
                "tags": [
                  "onboarding"
                ]
              }
            ],
            "pageInfo": {
              "hasNextPage": true,
              "endCursor": "cur-2"
            }
          }
        }
      }
    }
  ],
  "exchanges": [
    {
      "request": {
        "method": "POST",
        "url": "https://api.tarvent.com/graphql",
        "headers": {
          "account": "acc-1",
          "content-type": "application/json",
          "x-api-key": "test-key"
        },
        "body": {
          "query": "query FindJourneys($first: Int, $after: String, $where: JourneyInfoFilterInput) { journeys(first: $first, after: $after, where: $where) { nodes { id tags name audienceId description reEntryType status totalEmailNodes totalNotificationEmailNodes totalSiteNotificationNodes totalSMSNodes createdUtc modifiedUtc } pageInfo { hasNextPage endCursor } } }",
          "variables": {
            "where": {
              "and": [
                {
                  "name": {
                    "contains": "Welcome"
                  }
                },
                {
                  "tags": {
                    "some": {
                      "in": [
                        "onboarding"
                      ]
                    }
                  }
                },
                {
                  "status": {
                    "in": [
                      "RUNNING"
                    ]
                  }
                }
              ]
            },
            "first": 10,
            "after": null
          }
        }
      }
    }
  ],
  "output": {
    "items": [
      {
        "id": "j-1",
        "name": "Welcome",
        "status": "RUNNING",
        "tags": [
          "onboarding"
        ]
      }
    ],
    "count": 1,
    "totalCount": null,
    "hasMore": true,
    "nextCursor": "cur-2"
  }
}
