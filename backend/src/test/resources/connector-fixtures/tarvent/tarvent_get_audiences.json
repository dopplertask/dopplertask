{
  "package": "@activepieces/piece-tarvent",
  "version": "0.2.1",
  "action": "tarvent_get_audiences",
  "auth": {
    "type": "CUSTOM_AUTH",
    "props": {
      "accountId": "acc-1",
      "apiKey": "test-key"
    }
  },
  "inputs": {
    "name": "News",
    "tags": "main, promo",
    "limit": 20,
    "cursor": ""
  },
  "credential": {
    "accountId": "acc-1",
    "apiKey": "test-key"
  },
  "answers": [
    {
      "status": 200,
      "body": {
        "data": {
          "audiences": {
            "totalCount": 1,
            "nodes": [
              {
                "id": "aud-1",
                "name": "Newsletter",
                "totalContacts": 120,
                "tags": [
                  "main"
                ]
              }
            ],
            "pageInfo": {
              "hasNextPage": true,
              "endCursor": "cur-2"
            }
          }
        }
      }
    }
  ],
  "exchanges": [
    {
      "request": {
        "method": "POST",
        "url": "https://api.tarvent.com/graphql",
        "headers": {
          "account": "acc-1",
          "content-type": "application/json",
          "x-api-key": "test-key"
        },
        "body": {
          "query": "query FindAudiences($first: Int, $after: String, $where: AudienceInfoFilterInput) { audiences(first: $first, after: $after, where: $where) { totalCount nodes { id name companyName streetAddress streetAddress2 addressLocality addressRegion postalCode addressCountry phone website totalContacts totalActiveContacts totalUnconfirmedContacts totalUndeliverableContacts totalUnsubscribedContacts totalComplaintContacts totalSuppressedContacts tags customKeyDataField { id labelText } createdUtc lastModifiedUtc } pageInfo { hasNextPage endCursor } } }",
          "variables": {
            "where": {
              "and": [
                {
                  "name": {
                    "contains": "News"
                  }
                },
                {
                  "tags": {
                    "some": {
                      "in": [
                        "main",
                        "promo"
                      ]
                    }
                  }
                }
              ]
            },
            "first": 20,
            "after": null
          }
        }
      }
    }
  ],
  "output": {
    "items": [
      {
        "id": "aud-1",
        "name": "Newsletter",
        "totalContacts": 120,
        "tags": [
          "main"
        ]
      }
    ],
    "count": 1,
    "totalCount": 1,
    "hasMore": true,
    "nextCursor": "cur-2"
  }
}
