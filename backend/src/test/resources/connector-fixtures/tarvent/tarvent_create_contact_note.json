{
  "package": "@activepieces/piece-tarvent",
  "version": "0.2.1",
  "action": "tarvent_create_contact_note",
  "auth": {
    "type": "CUSTOM_AUTH",
    "props": {
      "accountId": "acc-1",
      "apiKey": "test-key"
    }
  },
  "inputs": {
    "contactId": "c-1",
    "note": "Called about the order."
  },
  "credential": {
    "accountId": "acc-1",
    "apiKey": "test-key"
  },
  "answers": [
    {
      "status": 200,
      "body": {
        "data": {
          "createContactNote": {
            "id": "n-1"
          }
        }
      }
    }
  ],
  "exchanges": [
    {
      "request": {
        "method": "POST",
        "url": "https://api.tarvent.com/graphql",
        "headers": {
          "account": "acc-1",
          "content-type": "application/json",
          "x-api-key": "test-key"
        },
        "body": {
          "query": "mutation CreateContactNote($input: CreateContactNoteInput!) { createContactNote(input: $input) { id } }",
          "variables": {
            "input": {
              "contactId": "c-1",
              "message": "Called about the order."
            }
          }
        }
      }
    }
  ],
  "output": {
    "success": true,
    "contactId": "c-1",
    "message": "Called about the order."
  }
}
