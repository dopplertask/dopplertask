{
  "package": "@activepieces/piece-tarvent",
  "version": "0.2.1",
  "action": "tarvent_set_journey_status_ai",
  "auth": {
    "type": "CUSTOM_AUTH",
    "props": {
      "accountId": "acc-1",
      "apiKey": "test-key"
    }
  },
  "inputs": {
    "journeyId": "j-1",
    "action": "STOP"
  },
  "credential": {
    "accountId": "acc-1",
    "apiKey": "test-key"
  },
  "answers": [
    {
      "status": 200,
      "body": {
        "data": {
          "stopJourney": true
        }
      }
    }
  ],
  "exchanges": [
    {
      "request": {
        "method": "POST",
        "url": "https://api.tarvent.com/graphql",
        "headers": {
          "account": "acc-1",
          "content-type": "application/json",
          "x-api-key": "test-key"
        },
        "body": {
          "query": "mutation StopJourney($id: String!) { stopJourney(id: $id) }",
          "variables": {
            "id": "j-1"
          }
        }
      }
    }
  ],
  "output": {
    "success": true,
    "journeyId": "j-1",
    "action": "STOP"
  }
}
