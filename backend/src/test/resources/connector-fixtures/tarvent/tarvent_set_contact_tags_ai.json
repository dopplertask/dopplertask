{
  "package": "@activepieces/piece-tarvent",
  "version": "0.2.1",
  "action": "tarvent_set_contact_tags_ai",
  "auth": {
    "type": "CUSTOM_AUTH",
    "props": {
      "accountId": "acc-1",
      "apiKey": "test-key"
    }
  },
  "inputs": {
    "audienceId": "aud-1",
    "contactId": "c-1",
    "tags": [
      "vip",
      " lead "
    ],
    "action": "ADD"
  },
  "credential": {
    "accountId": "acc-1",
    "apiKey": "test-key"
  },
  "answers": [
    {
      "status": 200,
      "body": {
        "data": {
          "updateContactTags": true
        }
      }
    }
  ],
  "exchanges": [
    {
      "request": {
        "method": "POST",
        "url": "https://api.tarvent.com/graphql",
        "headers": {
          "account": "acc-1",
          "content-type": "application/json",
          "x-api-key": "test-key"
        },
        "body": {
          "query": "mutation UpdateContactTags($input: UpdateContactTagsInput!) { updateContactTags(input: $input) }",
          "variables": {
            "input": {
              "id": "c-1",
              "audienceId": "aud-1",
              "operator": "ADD",
              "tags": [
                "vip",
                "lead"
              ]
            }
          }
        }
      }
    }
  ],
  "output": {
    "success": true,
    "contactId": "c-1",
    "action": "ADD",
    "tags": [
      "vip",
      "lead"
    ]
  }
}
