{
  "package": "@activepieces/piece-tarvent",
  "version": "0.2.1",
  "action": "tarvent_find_contact_ai",
  "auth": {
    "type": "CUSTOM_AUTH",
    "props": {
      "accountId": "acc-1",
      "apiKey": "test-key"
    }
  },
  "inputs": {
    "audienceId": "aud-1",
    "email": "",
    "contactId": "c-9"
  },
  "credential": {
    "accountId": "acc-1",
    "apiKey": "test-key"
  },
  "answers": [
    {
      "status": 200,
      "body": {
        "errors": [
          {
            "message": "The contact was not found.",
            "extensions": {
              "code": "1030"
            }
          }
        ]
      }
    },
    {
      "status": 200,
      "body": {
        "data": {
          "contacts": {
            "nodes": [
              {
                "id": "c-1"
              }
            ],
            "pageInfo": {
              "hasNextPage": true,
              "endCursor": "x1"
            }
          }
        }
      }
    }
  ],
  "exchanges": [
    {
      "request": {
        "method": "POST",
        "url": "https://api.tarvent.com/graphql",
        "headers": {
          "account": "acc-1",
          "content-type": "application/json",
          "x-api-key": "test-key"
        },
        "body": {
          "query": "query GetContact($input: GetContactInput!) { contact(input: $input) { id email firstName lastName status tags groups { id name } rating latitude longitude streetAddress streetAddress2 addressLocality addressRegion postalCode addressCountry timeZone language sendFormat optInUtc confirmedUtc optOutUtc profileFields { id dataField { id labelText } value } createdUtc modifiedUtc } }",
          "variables": {
            "input": {
              "audienceId": "aud-1",
              "emailAddress": null,
              "id": "c-9"
            }
          }
        }
      }
    },
    {
      "request": {
        "method": "POST",
        "url": "https://api.tarvent.com/graphql",
        "headers": {
          "account": "acc-1",
          "content-type": "application/json",
          "x-api-key": "test-key"
        },
        "body": {
          "query": "query CheckAudience($first: Int, $after: String, $input: GetAllContactsInput!) { contacts(first: $first, after: $after, input: $input) { nodes { id } pageInfo { hasNextPage endCursor } } }",
          "variables": {
            "input": {
              "audienceId": "aud-1"
            },
            "first": 1,
            "after": null
          }
        }
      }
    }
  ],
  "output": {
    "found": false,
    "contact": null
  }
}
