{
  "package": "@activepieces/piece-tarvent",
  "version": "0.2.1",
  "action": "tarvent_get_campaigns",
  "auth": {
    "type": "CUSTOM_AUTH",
    "props": {
      "accountId": "acc-1",
      "apiKey": "test-key"
    }
  },
  "inputs": {
    "name": "Spring",
    "tags": "promo",
    "status": "PENDING",
    "limit": 10,
    "cursor": ""
  },
  "credential": {
    "accountId": "acc-1",
    "apiKey": "test-key"
  },
  "answers": [
    {
      "status": 200,
      "body": {
        "data": {
          "campaigns": {
            "totalCount": 1,
            "nodes": [
              {
                "id": "cmp-1",
                "name": "Spring sale",
                "sendStatus": "PENDING",
                "tags": [
                  "promo"
                ]
              }
            ],
            "pageInfo": {
              "hasNextPage": true,
              "endCursor": "cur-2"
            }
          }
        }
      }
    }
  ],
  "exchanges": [
    {
      "request": {
        "method": "POST",
        "url": "https://api.tarvent.com/graphql",
        "headers": {
          "account": "acc-1",
          "content-type": "application/json",
          "x-api-key": "test-key"
        },
        "body": {
          "query": "query FindCampaigns($first: Int, $after: String, $order: [CampaignInfoSortInput!], $where: CampaignInfoFilterInput) { campaigns(first: $first, after: $after, order: $order, where: $where) { totalCount nodes { id tags name audienceId description mvWinType timeJumper sendStatus scheduledToSendUtc createdUtc modifiedUtc } pageInfo { hasNextPage endCursor } } }",
          "variables": {
            "order": [
              {
                "modifiedUtc": "DESC"
              }
            ],
            "where": {
              "and": [
                {
                  "name": {
                    "contains": "Spring"
                  }
                },
                {
                  "tags": {
                    "some": {
                      "in": [
                        "promo"
                      ]
                    }
                  }
                },
                {
                  "sendStatus": {
                    "in": [
                      "PENDING",
                      "PROCESSING",
                      "QUEUED"
                    ]
                  }
                }
              ]
            },
            "first": 10,
            "after": null
          }
        }
      }
    }
  ],
  "output": {
    "items": [
      {
        "id": "cmp-1",
        "name": "Spring sale",
        "sendStatus": "PENDING",
        "tags": [
          "promo"
        ]
      }
    ],
    "count": 1,
    "totalCount": 1,
    "hasMore": true,
    "nextCursor": "cur-2"
  }
}
