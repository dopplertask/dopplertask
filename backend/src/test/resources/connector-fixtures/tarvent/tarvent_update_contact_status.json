{
  "package": "@activepieces/piece-tarvent",
  "version": "0.2.1",
  "action": "tarvent_update_contact_status",
  "auth": {
    "type": "CUSTOM_AUTH",
    "props": {
      "accountId": "acc-1",
      "apiKey": "test-key"
    }
  },
  "inputs": {
    "contactId": "c-1",
    "action": "OPT_OUT"
  },
  "credential": {
    "accountId": "acc-1",
    "apiKey": "test-key"
  },
  "answers": [
    {
      "status": 200,
      "body": {
        "data": {
          "updateContactStatus": true
        }
      }
    }
  ],
  "exchanges": [
    {
      "request": {
        "method": "POST",
        "url": "https://api.tarvent.com/graphql",
        "headers": {
          "account": "acc-1",
          "content-type": "application/json",
          "x-api-key": "test-key"
        },
        "body": {
          "query": "mutation UpdateContactStatus($input: UpdateContactStatusInput!) { updateContactStatus(input: $input) }",
          "variables": {
            "input": {
              "id": "c-1",
              "status": "OPT_OUT"
            }
          }
        }
      }
    }
  ],
  "output": {
    "success": true,
    "contactId": "c-1",
    "status": "OPT_OUT"
  }
}
