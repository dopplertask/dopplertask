{
  "package": "@activepieces/piece-tarvent",
  "version": "0.2.1",
  "action": "tarvent_get_custom_event",
  "auth": {
    "type": "CUSTOM_AUTH",
    "props": {
      "accountId": "acc-1",
      "apiKey": "test-key"
    }
  },
  "inputs": {
    "name": "Purchase",
    "limit": 10,
    "cursor": "cur-1"
  },
  "credential": {
    "accountId": "acc-1",
    "apiKey": "test-key"
  },
  "answers": [
    {
      "status": 200,
      "body": {
        "data": {
          "customApiEvents": {
            "nodes": [
              {
                "id": "ce-1",
                "key": "purchase",
                "name": "Purchase",
                "description": "Bought",
                "createdUtc": "2026-01-02T10:00:00Z"
              }
            ],
            "pageInfo": {
              "hasNextPage": true,
              "endCursor": "cur-2"
            }
          }
        }
      }
    }
  ],
  "exchanges": [
    {
      "request": {
        "method": "POST",
        "url": "https://api.tarvent.com/graphql",
        "headers": {
          "account": "acc-1",
          "content-type": "application/json",
          "x-api-key": "test-key"
        },
        "body": {
          "query": "query FindCustomEvents($first: Int, $after: String, $where: CustomApiEventFilterInput) { customApiEvents(first: $first, after: $after, where: $where) { nodes { id key name description createdUtc modifiedUtc } pageInfo { hasNextPage endCursor } } }",
          "variables": {
            "where": {
              "name": {
                "contains": "Purchase"
              }
            },
            "first": 10,
            "after": "cur-1"
          }
        }
      }
    }
  ],
  "output": {
    "items": [
      {
        "id": "ce-1",
        "key": "purchase",
        "name": "Purchase",
        "description": "Bought",
        "createdUtc": "2026-01-02T10:00:00Z"
      }
    ],
    "count": 1,
    "totalCount": null,
    "hasMore": true,
    "nextCursor": "cur-2"
  }
