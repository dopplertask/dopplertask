    "language": "en-US",
    "timeZone": "America/Denver"
  },
  "credential": {
    "accountId": "acc-1",
    "apiKey": "test-key"
  },
  "answers": [
    {
      "status": 200,
      "body": {
        "data": {
          "updateContact": {
