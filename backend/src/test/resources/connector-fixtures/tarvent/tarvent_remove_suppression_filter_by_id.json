{
  "package": "@activepieces/piece-tarvent",
  "version": "0.2.1",
  "action": "tarvent_remove_suppression_filter",
  "auth": {
    "type": "CUSTOM_AUTH",
    "props": {
      "accountId": "acc-1",
      "apiKey": "test-key"
    }
  },
  "inputs": {
    "email": "",
    "filterId": "sf-7"
  },
  "credential": {
    "accountId": "acc-1",
    "apiKey": "test-key"
  },
  "answers": [
    {
      "status": 200,
      "body": {
        "data": {
          "deleteAccountSuppressionFilter": true
        }
      }
    }
  ],
  "exchanges": [
    {
      "request": {
        "method": "POST",
        "url": "https://api.tarvent.com/graphql",
        "headers": {
          "account": "acc-1",
          "content-type": "application/json",
          "x-api-key": "test-key"
        },
        "body": {
          "query": "mutation DeleteSuppressionFilter($id: String!) { deleteAccountSuppressionFilter(id: $id) }",
          "variables": {
            "id": "sf-7"
          }
        }
      }
    }
  ],
  "output": {
    "removed": 1,
    "filterIds": [
      "sf-7"
    ]
  }
}
