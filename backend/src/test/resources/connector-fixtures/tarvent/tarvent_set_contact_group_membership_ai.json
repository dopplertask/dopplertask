{
  "package": "@activepieces/piece-tarvent",
  "version": "0.2.1",
  "action": "tarvent_set_contact_group_membership_ai",
  "auth": {
    "type": "CUSTOM_AUTH",
    "props": {
      "accountId": "acc-1",
      "apiKey": "test-key"
    }
  },
  "inputs": {
    "audienceId": "aud-1",
    "groupId": "g-1",
    "contactId": "c-1",
    "action": "REMOVE"
  },
  "credential": {
    "accountId": "acc-1",
    "apiKey": "test-key"
  },
  "answers": [
    {
      "status": 200,
      "body": {
        "data": {
          "deleteGroupContact": {
            "id": "c-1"
          }
        }
      }
    }
  ],
  "exchanges": [
    {
      "request": {
        "method": "POST",
        "url": "https://api.tarvent.com/graphql",
        "headers": {
          "account": "acc-1",
          "content-type": "application/json",
          "x-api-key": "test-key"
        },
        "body": {
          "query": "mutation DeleteGroupContact($input: DeleteGroupContactInput!) { deleteGroupContact(input: $input) { id } }",
          "variables": {
            "input": {
              "id": "c-1",
              "groupId": "g-1",
              "audienceId": "aud-1"
            }
          }
        }
      }
    }
  ],
  "output": {
    "success": true,
    "contactId": "c-1",
    "groupId": "g-1",
    "audienceId": "aud-1",
    "action": "REMOVE"
  }
}
