{
  "package": "@activepieces/piece-tarvent",
  "version": "0.2.1",
  "action": "tarvent_create_transaction_ai",
  "auth": {
    "type": "CUSTOM_AUTH",
    "props": {
      "accountId": "acc-1",
      "apiKey": "test-key"
    }
  },
  "inputs": {
    "groupName": "Orders",
    "fromEmail": "shop@example.com",
    "fromName": "Shop",
    "toEmail": "ana@example.com",
    "ccEmail": [
      {
        "email": "cc@example.com"
      }
    ],
    "bccEmail": [
      {
        "email": "bcc@example.com"
      }
    ],
    "subject": "Your order",
    "replyToEmail": "help@example.com",
    "replyToName": "Help",
    "variables": {
      "First_Name": "Ana",
      "order": "42"
    },
    "mimeType": "HTML",
    "content": "<p>Hi [[Tx.VariableData.FirstName]]</p>",
    "templateId": "tpl-1"
  },
  "credential": {
    "accountId": "acc-1",
    "apiKey": "test-key"
  },
  "answers": [
    {
      "status": 200,
      "body": {
        "data": {
          "createTransaction": [
            {
              "emailAddress": "ana@example.com",
              "errorCode": null,
              "errorMsg": null,
              "requestId": "req-1",
              "transactionId": "tx-1"
            },
            {
              "emailAddress": "cc@example.com",
              "errorCode": null,
              "errorMsg": null,
              "requestId": "req-1",
              "transactionId": "tx-2"
            },
            {
              "emailAddress": "bcc@example.com",
              "errorCode": "12",
              "errorMsg": "Suppressed",
              "requestId": "req-1",
              "transactionId": null
            }
          ]
        }
      }
    }
  ],
  "exchanges": [
    {
      "request": {
        "method": "POST",
        "url": "https://api.tarvent.com/graphql",
        "headers": {
          "account": "acc-1",
          "content-type": "application/json",
          "x-api-key": "test-key"
        },
        "body": {
          "query": "mutation CreateTransaction($input: CreateTransactionInput!) { createTransaction(input: $input) { emailAddress errorCode errorMsg requestId transactionId } }",
          "variables": {
            "input": {
              "content": {
                "templateId": "tpl-1",
                "contentBodies": null
              },
              "groupName": "Orders",
              "header": {
                "from": {
                  "emailAddress": "shop@example.com",
                  "name": "Shop"
                },
                "replyTo": {
                  "emailAddress": "help@example.com",
                  "name": "Help"
                },
                "subject": "Your order"
              },
              "recipients": [
                {
                  "emailAddress": "ana@example.com",
                  "type": "TO",
                  "variables": [
                    {
                      "name": "FirstName",
                      "value": "Ana"
                    },
                    {
                      "name": "order",
                      "value": "42"
                    }
                  ]
                },
                {
                  "emailAddress": "cc@example.com",
                  "type": "CC",
                  "variables": [
                    {
                      "name": "FirstName",
                      "value": "Ana"
                    },
                    {
                      "name": "order",
                      "value": "42"
                    }
                  ]
                },
                {
                  "emailAddress": "bcc@example.com",
                  "type": "BCC",
                  "variables": [
                    {
                      "name": "FirstName",
                      "value": "Ana"
                    },
                    {
                      "name": "order",
                      "value": "42"
                    }
                  ]
                }
              ],
              "settings": {
                "ignoreSuppressCheck": false
              }
            }
          }
        }
      }
    }
  ],
  "output": {
    "requestId": "req-1",
    "transactionId": "tx-1",
    "recipients": [
      {
        "emailAddress": "ana@example.com",
        "transactionId": "tx-1",
        "errorCode": null,
        "errorMsg": null,
        "sent": true
      },
      {
        "emailAddress": "cc@example.com",
        "transactionId": "tx-2",
        "errorCode": null,
        "errorMsg": null,
        "sent": true
      },
      {
        "emailAddress": "bcc@example.com",
        "transactionId": null,
        "errorCode": "12",
        "errorMsg": "Suppressed",
        "sent": false
      }
    ]
  }
}
