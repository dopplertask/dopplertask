{
  "package": "@activepieces/piece-tarvent",
  "version": "0.2.1",
  "action": "tarvent_get_campaign_stats",
  "auth": {
    "type": "CUSTOM_AUTH",
    "props": {
      "accountId": "acc-1",
      "apiKey": "test-key"
    }
  },
  "inputs": {
    "campaignId": "cmp-1"
  },
  "credential": {
    "accountId": "acc-1",
    "apiKey": "test-key"
  },
  "answers": [
    {
      "status": 200,
      "body": {
        "data": {
          "campaignStats": {
            "campaignId": "cmp-1",
            "totalSent": 120,
            "totalDelivered": 118,
            "uniqueOpens": 64,
            "uniqueClicks": 12,
            "sendDomain": "mail.example.com"
          }
        }
      }
    }
  ],
  "exchanges": [
    {
      "request": {
        "method": "POST",
        "url": "https://api.tarvent.com/graphql",
        "headers": {
          "account": "acc-1",
          "content-type": "application/json",
          "x-api-key": "test-key"
        },
        "body": {
          "query": "query GetCampaignStats($input: CampaignStatsInput!) { campaignStats(input: $input) { campaignId totalSent totalDelivered totalDeliveredPct totalOpens uniqueOpens uniqueOpensPct totalClicks uniqueClicks uniqueClicksPct clickToOpenPct totalReplies uniqueReplies uniqueRepliesPct totalBounce totalBouncePct uniqueHardBounce uniqueHardBouncePct uniqueSoftBounce uniqueSoftBouncePct uniqueOptOut uniqueOptOutPct uniqueSpam uniqueSpamPct uniqueSuppressed engagementScore engagementScoreAvg senderReputation sendDomain } }",
          "variables": {
            "input": {
              "id": "cmp-1"
            }
          }
        }
      }
    }
  ],
  "output": {
    "campaignId": "cmp-1",
    "totalSent": 120,
    "totalDelivered": 118,
    "uniqueOpens": 64,
    "uniqueClicks": 12,
    "sendDomain": "mail.example.com"
  }
}
