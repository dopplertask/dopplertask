{
  "package": "@activepieces/piece-tarvent",
  "version": "0.2.1",
  "action": "tarvent_get_transaction",
  "auth": {
    "type": "CUSTOM_AUTH",
    "props": {
      "accountId": "acc-1",
      "apiKey": "test-key"
    }
  },
  "inputs": {
    "transactionId": "tx-1"
  },
  "credential": {
    "accountId": "acc-1",
    "apiKey": "test-key"
  },
  "answers": [
    {
      "status": 200,
      "body": {
        "data": {
          "transaction": [
            {
              "id": "tx-1",
              "requestId": "req-1",
              "status": "SENT",
              "recipient": "ana@example.com",
              "subject": "Your order",
              "openCount": 1,
              "clickCount": 0
            },
            null
          ]
        }
      }
    }
  ],
  "exchanges": [
    {
      "request": {
        "method": "POST",
        "url": "https://api.tarvent.com/graphql",
        "headers": {
          "account": "acc-1",
          "content-type": "application/json",
          "x-api-key": "test-key"
        },
        "body": {
          "query": "query GetTransaction($id: String!) { transaction(id: $id) { id requestId status recipient recipientName recipientType from fromName replyTo subject groupName tags error bounceCategory openCount clickCount sendCount complaint unsubscribe contactId sendAtUtc processedUtc createdUtc modifiedUtc } }",
          "variables": {
            "id": "tx-1"
          }
        }
      }
    }
  ],
  "output": {
    "found": true,
    "transactionId": "tx-1",
    "items": [
      {
        "id": "tx-1",
        "requestId": "req-1",
        "status": "SENT",
        "recipient": "ana@example.com",
        "subject": "Your order",
        "openCount": 1,
        "clickCount": 0
      }
    ]
  }
}
