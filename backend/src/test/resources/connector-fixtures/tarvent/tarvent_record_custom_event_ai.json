{
  "package": "@activepieces/piece-tarvent",
  "version": "0.2.1",
  "action": "tarvent_record_custom_event_ai",
  "auth": {
    "type": "CUSTOM_AUTH",
    "props": {
      "accountId": "acc-1",
      "apiKey": "test-key"
    }
  },
  "inputs": {
    "contactId": "c-1",
    "eventKey": "purchase"
  },
  "credential": {
    "accountId": "acc-1",
    "apiKey": "test-key"
  },
  "answers": [
    {
      "status": 200,
      "body": {
        "data": {
          "createContactCustomEvent": true
        }
      }
    }
  ],
  "exchanges": [
    {
      "request": {
        "method": "POST",
        "url": "https://api.tarvent.com/graphql",
        "headers": {
          "account": "acc-1",
          "content-type": "application/json",
          "x-api-key": "test-key"
        },
        "body": {
          "query": "mutation CreateContactCustomEvent($id: String!, $key: String!) { createContactCustomEvent(id: $id, key: $key) }",
          "variables": {
            "id": "c-1",
            "key": "purchase"
          }
        }
      }
    }
  ],
  "output": {
    "success": true,
    "contactId": "c-1",
    "eventKey": "purchase"
  }
}
