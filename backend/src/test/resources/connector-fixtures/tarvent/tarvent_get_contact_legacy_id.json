{
  "package": "@activepieces/piece-tarvent",
  "version": "0.2.1",
  "action": "tarvent_get_contact",
  "auth": {
    "type": "CUSTOM_AUTH",
    "props": {
      "accountId": "acc-1",
      "apiKey": "test-key"
    }
  },
  "inputs": {
    "audienceId": "aud-1",
    "email": "c-1",
    "contactId": ""
  },
  "credential": {
    "accountId": "acc-1",
    "apiKey": "test-key"
  },
  "answers": [
    {
      "status": 200,
      "body": {
        "data": {
          "contact": {
            "id": "c-1",
            "email": "ada@example.com",
            "firstName": "Ada",
            "lastName": "Lovelace",
            "status": "ACTIVE",
            "tags": [
              "VIP"
            ],
            "groups": [
              {
                "id": "grp-1",
                "name": "Customers"
              }
            ]
          }
        }
      }
    }
  ],
  "exchanges": [
    {
      "request": {
        "method": "POST",
        "url": "https://api.tarvent.com/graphql",
        "headers": {
          "account": "acc-1",
          "content-type": "application/json",
          "x-api-key": "test-key"
        },
        "body": {
          "query": "query GetContact($input: GetContactInput!) { contact(input: $input) { id email firstName lastName status tags groups { id name } rating latitude longitude streetAddress streetAddress2 addressLocality addressRegion postalCode addressCountry timeZone language sendFormat optInUtc confirmedUtc optOutUtc profileFields { id dataField { id labelText } value } createdUtc modifiedUtc } }",
          "variables": {
            "input": {
              "audienceId": "aud-1",
              "emailAddress": null,
              "id": "c-1"
            }
          }
        }
      }
    }
  ],
  "output": {
    "found": true,
    "contact": {
      "id": "c-1",
      "email": "ada@example.com",
      "firstName": "Ada",
      "lastName": "Lovelace",
      "status": "ACTIVE",
      "tags": [
        "VIP"
      ],
      "groups": [
        {
          "id": "grp-1",
          "name": "Customers"
        }
      ]
    }
  }
}
