{
  "package": "@activepieces/piece-tarvent",
  "version": "0.2.1",
  "action": "tarvent_list_tags",
  "auth": {
    "type": "CUSTOM_AUTH",
    "props": {
      "accountId": "acc-1",
      "apiKey": "test-key"
    }
  },
  "inputs": {
    "limit": 25,
    "cursor": "cur-1"
  },
  "credential": {
    "accountId": "acc-1",
    "apiKey": "test-key"
  },
  "answers": [
    {
      "status": 200,
      "body": {
        "data": {
          "tags": {
            "nodes": [
              {
                "name": "vip",
                "count": 12,
                "type": "CONTACT",
                "isSystem": false
              }
            ],
            "pageInfo": {
              "hasNextPage": true,
              "endCursor": "cur-2"
            }
          }
        }
      }
    }
  ],
  "exchanges": [
    {
      "request": {
        "method": "POST",
        "url": "https://api.tarvent.com/graphql",
        "headers": {
          "account": "acc-1",
          "content-type": "application/json",
          "x-api-key": "test-key"
        },
        "body": {
          "query": "query ListTags($first: Int, $after: String) { tags(first: $first, after: $after) { nodes { name count type isSystem } pageInfo { hasNextPage endCursor } } }",
          "variables": {
            "first": 25,
            "after": "cur-1"
          }
        }
      }
    }
  ],
  "output": {
    "items": [
      {
        "name": "vip",
        "count": 12,
        "type": "CONTACT",
        "isSystem": false
      }
    ],
    "count": 1,
    "totalCount": null,
    "hasMore": true,
    "nextCursor": "cur-2"
  }
}
