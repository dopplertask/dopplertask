{
  "name": "swarmnode",
  "label": "SwarmNode",
  "description": "",
  "icon": "",
  "hosts": [
    "api.swarmnode.ai"
  ],
  "upstream": {
    "package": "@activepieces/piece-swarmnode",
    "version": "0.2.1"
  },
  "credential": {
    "fields": {
      "token": {
        "label": "API Key",
        "description": "You can obtain your API key from [Settings](https://app.swarmnode.ai/settings/api-keys/).",
        "secret": true,
        "required": true
      }
    },
    "headers": {
      "authorization": "Bearer {{credential.token}}"
    }
  },
  "actions": {
    "get-execution": {
      "label": "Get Execution",
      "description": "Gets AI Agent's execution details.",
      "inputs": {
        "jobId": {
          "label": "Agent Executor Job ID",
          "required": true
        }
      },
      "request": {
        "method": "GET",
        "url": "https://api.swarmnode.ai/v1/executions/{{jobId}}/"
      }
    }
  },
  "triggers": {}
}
