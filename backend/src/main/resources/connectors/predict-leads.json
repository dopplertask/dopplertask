{
  "name": "predict-leads",
  "label": "PredictLeads",
  "description": "Company Intelligence Data Source",
  "icon": "",
  "hosts": [
    "predictleads.com"
  ],
  "upstream": {
    "package": "@activepieces/piece-predict-leads",
    "version": "0.2.1"
  },
  "credential": {
    "fields": {
      "apiKey": {
        "label": "API Key",
        "description": "The key of the Predict Leads account.",
        "secret": true,
        "required": true
      },
      "apiToken": {
        "label": "API Token",
        "description": "The token of the Predict Leads account.",
        "secret": true,
        "required": true
      }
    },
    "headers": {
      "x-api-key": "{{credential.apiKey}}",
      "x-api-token": "{{credential.apiToken}}"
    }
  },
  "actions": {
    "predict-leads_find_companies": {
      "label": "List Companies",
      "description": "Retrieves all companies.",
      "inputs": {
        "location": {
          "label": "Location",
          "required": true
        },
        "minMaxSizes": {
          "label": "Min Max Size",
          "description": "A min-max size range. Examples: \"11-50\"\". For now, only single range is supported.",
          "required": true
        },
        "page": {
          "label": "Page",
          "description": "Page number of shown items",
          "type": "number"
        },
        "limit": {
          "label": "Limit",
          "description": "Limit the number of shown items per page. Max 1000.",
          "type": "number"
        }
      },
      "request": {
        "method": "GET",
        "url": "https://predictleads.com/api/v3/discover/companies",
        "query": {
          "location": "{{location}}",
          "min_max_sizes": "{{minMaxSizes}}",
          "page": "{{page}}",
          "limit": "{{limit}}"
        }
      }
    },
    "predict-leads_find_company_by_domain": {
      "label": "Retrieve a company",
      "description": "Retrieves a company by its domain.",
      "inputs": {
        "domain": {
          "label": "Domain",
          "description": "The domain of the company to find.",
          "required": true
        }
      },
      "request": {
        "method": "GET",
        "url": "https://predictleads.com/api/v3/companies/{{domain}}"
      }
    },
    "predict-leads_find_company_job_openings": {
      "label": "List Company's Job Openings",
      "description": "Retrieves job openings by company domain.",
      "inputs": {
        "domain": {
          "label": "Domain",
          "description": "Company's domain",
          "required": true
        },
        "active_only": {
          "label": "Active Only",
          "description": "Set to true if you'd like to receive JobOpenings that are not closed, have last_seen_at more recent than 5 days and were found in the last year",
          "type": "boolean"
        },
        "not_closed": {
          "label": "Not Closed",
          "description": "Similar to active_only, but without considering last_seen_at timestamp.",
          "type": "boolean"
        },
        "first_seen_at_from": {
          "label": "First Seen At From",
          "description": "Only return data first seen after given date . Example 2024-09-25"
        },
        "first_seen_at_until": {
          "label": "First Seen At Until",
          "description": "Only return data first seen before given date . Example 2024-09-25"
        },
        "last_seen_at_from": {
          "label": "Last Seen At From",
          "description": "Only return data last seen after given date . Example 2024-09-25"
        },
        "last_seen_at_until": {
          "label": "Last Seen At Until",
          "description": "Only return data last seen before given date . Example 2024-09-25"
        },
        "with_description_only": {
          "label": "With Description Only",
          "description": "Only return JobOpenings that have description",
          "type": "boolean"
        },
        "with_location_only": {
          "label": "With Location Only",
          "description": "Only return JobOpenings that have location",
          "type": "boolean"
        },
        "categories": {
          "label": "Categories",
          "description": "Select categories to filter job openings",
          "type": "json",
          "options": [
            {
              "value": "administration",
              "label": "Administration"
            },
            {
              "value": "consulting",
              "label": "Consulting"
            },
            {
              "value": "data_analysis",
              "label": "Data Analysis"
            },
            {
              "value": "design",
              "label": "Design"
            },
            {
              "value": "directors",
              "label": "Directors"
            },
            {
              "value": "education",
              "label": "Education"
            },
            {
              "value": "engineering",
              "label": "Engineering"
            },
            {
              "value": "finance",
              "label": "Finance"
            },
            {
              "value": "healthcare_services",
              "label": "Healthcare Services"
            },
            {
              "value": "human_resources",
              "label": "Human Resources"
            },
            {
              "value": "information_technology",
              "label": "Information Technology"
            },
            {
              "value": "internship",
              "label": "Internship"
            },
            {
              "value": "legal",
              "label": "Legal"
            },
            {
              "value": "management",
              "label": "Management"
            },
            {
              "value": "marketing",
              "label": "Marketing"
            },
            {
              "value": "military_and_protective_services",
              "label": "Military And Protective Services"
            },
            {
              "value": "operations",
              "label": "Operations"
            },
            {
              "value": "purchasing",
              "label": "Purchasing"
            },
            {
              "value": "product_management",
              "label": "Product Management"
            },
            {
              "value": "quality_assurance",
              "label": "Quality Assurance"
            },
            {
              "value": "real_estate",
              "label": "Real Estate"
            },
            {
              "value": "research",
              "label": "Research"
            },
            {
              "value": "sales",
              "label": "Sales"
            },
            {
              "value": "software_development",
              "label": "Software Development"
            },
            {
              "value": "support",
              "label": "Support"
            },
            {
              "value": "manual_work",
              "label": "Manual Work"
            },
            {
              "value": "food",
              "label": "Food"
            }
          ]
        },
        "page": {
          "label": "Page",
          "description": "Page number of shown items",
          "type": "number"
        },
        "limit": {
          "label": "Limit",
          "description": "Limit the number of shown items per page. Max 1000.",
          "type": "number"
        }
      },
      "request": {
        "method": "GET",
        "url": "https://predictleads.com/api/v3/companies/{{domain}}/job_openings",
        "query": {
          "first_seen_at_from": "{{first_seen_at_from}}",
          "first_seen_at_until": "{{first_seen_at_until}}",
          "last_seen_at_from": "{{last_seen_at_from}}",
          "last_seen_at_until": "{{last_seen_at_until}}",
          "page": "{{page}}",
          "limit": "{{limit}}"
        }
      }
    },
    "predict-leads_get_a_job_opening_by_id": {
      "label": "Get Job Opening",
      "description": "Retrieves a single job opening by ID.",
      "inputs": {
        "jobOpeningId": {
          "label": "Job Opening ID",
          "description": "The ID of the job opening to retrieve.",
          "required": true
        }
      },
      "request": {
        "method": "GET",
        "url": "https://predictleads.com/api/v3/job_openings/{{jobOpeningId}}"
      }
    },
    "predict-leads_find_technologies_by_domain": {
