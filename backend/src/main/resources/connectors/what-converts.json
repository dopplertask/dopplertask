{
  "name": "what-converts",
  "label": "WhatConverts",
  "description": "",
  "icon": "",
  "hosts": [
    "app.whatconverts.com"
  ],
  "upstream": {
    "package": "@activepieces/piece-what-converts",
    "version": "0.1.7"
  },
  "credential": {
    "fields": {
      "api_token": {
        "label": "API Token",
        "description": "Your WhatConverts API Token.",
        "required": true
      },
      "api_secret": {
        "label": "API Secret",
        "description": "Your WhatConverts API Secret.",
        "secret": true,
        "required": true
      }
    }
  },
  "actions": {
    "update_lead": {
      "label": "Update Lead",
      "description": "Update an existing lead's attributes by its ID.",
      "inputs": {
        "account_id": {
          "label": "Account",
          "description": "The account to select a profile from.",
          "required": true
        },
        "profile_id": {
          "label": "Profile",
          "description": "The profile to search for leads in.",
          "required": true
        },
        "lead_id": {
          "label": "Lead",
          "description": "The lead to update.",
          "required": true
        },
        "lead_type": {
          "label": "Lead Type",
          "description": "The type of the lead.",
          "type": "select",
          "options": [
            {
              "value": "Phone Call",
              "label": "Phone Call"
            },
            {
              "value": "Web Form",
              "label": "Web Form"
            },
            {
              "value": "Chat",
              "label": "Chat"
            },
            {
              "value": "Transaction",
              "label": "Transaction"
            },
            {
              "value": "Event",
              "label": "Event"
            }
          ]
        },
        "quotable": {
          "label": "Quotable",
          "description": "Mark the lead as quotable.",
          "type": "select",
          "options": [
            {
              "value": "Yes",
              "label": "Yes"
            },
            {
              "value": "No",
              "label": "No"
            }
          ]
        },
        "sales_value": {
          "label": "Sales Value",
          "description": "The monetary value of the lead (e.g., \"150.00\")."
        },
        "first_name": {
          "label": "First Name"
        },
        "last_name": {
          "label": "Last Name"
        },
        "email": {
          "label": "Email"
        },
        "phone_number": {
          "label": "Phone Number"
        },
        "notes": {
          "label": "Notes",
          "type": "multiline"
        },
        "referring_source": {
          "label": "Referring Source",
          "description": "The source of the lead (e.g., \"google\").",
          "type": "select",
          "options": [
            {
              "value": "google",
              "label": "Google"
            },
            {
              "value": "bing",
              "label": "Bing"
            },
            {
              "value": "facebook",
              "label": "Facebook"
            },
            {
              "value": "linkedin",
              "label": "LinkedIn"
            },
            {
              "value": "twitter",
              "label": "Twitter"
            },
            {
              "value": "instagram",
              "label": "Instagram"
            },
            {
              "value": "(direct)",
              "label": "Direct Traffic"
            }
          ]
        },
        "referring_medium": {
          "label": "Referring Medium",
          "description": "The medium of the lead (e.g., \"cpc\").",
          "type": "select",
          "options": [
            {
              "value": "organic",
              "label": "Organic Search"
            },
            {
              "value": "cpc",
              "label": "Paid Search (CPC)"
            },
            {
              "value": "social",
              "label": "Social Media"
            },
            {
              "value": "email",
              "label": "Email"
            },
            {
              "value": "referral",
              "label": "Referral"
            },
            {
              "value": "display",
              "label": "Display Ad"
            },
            {
              "value": "(none)",
              "label": "None (for Direct Traffic)"
            }
          ]
        },
        "referring_campaign": {
          "label": "Referring Campaign",
          "description": "The campaign that generated the lead.",
          "type": "select",
          "options": [
            {
              "value": "summer-sale",
              "label": "Summer Sale"
            },
            {
              "value": "q4-promo",
              "label": "Q4 Promotion"
            },
            {
              "value": "new-product-launch",
              "label": "New Product Launch"
            },
            {
              "value": "brand-awareness",
              "label": "Brand Awareness"
            }
          ]
        }
      },
      "request": {
        "method": "POST",
        "url": "https://app.whatconverts.com/api/v1/leads/{{lead_id}}",
        "headers": {
          "authorization": "Basic Y3JlZGVudGlhbDAwMHo6Y3JlZGVudGlhbDAwMXo="
        },
        "body": {
          "sales_value": "{{sales_value}}",
          "lead_details": {
            "first_name": "{{first_name}}",
            "last_name": "{{last_name}}",
            "email": "{{email}}",
            "phone_number": "{{phone_number}}",
            "notes": "{{notes}}"
          }
        }
      }
    },
    "find_lead": {
      "label": "Find Lead",
      "description": "Find a lead by various criteria.",
      "inputs": {
        "account_id": {
          "label": "Account",
          "description": "The account to select a profile from.",
          "required": true
        },
        "profile_id": {
          "label": "Profile",
          "description": "The profile to search for leads in.",
          "required": true
        },
        "email_address": {
          "label": "Email Address",
          "description": "Find a lead by their email address."
        },
        "phone_number": {
          "label": "Phone Number",
          "description": "Find a lead by their E.164 formatted phone number."
        },
        "lead_type": {
          "label": "Lead Type",
          "description": "Filter leads by their type.",
          "type": "select",
          "options": [
            {
              "value": "appointment",
              "label": "Appointment"
            },
            {
              "value": "chat",
              "label": "Chat"
            },
            {
              "value": "email",
              "label": "Email"
            },
            {
              "value": "event",
              "label": "Event"
            },
            {
              "value": "other",
              "label": "Other"
            },
            {
              "value": "phone_call",
              "label": "Phone Call"
            },
            {
              "value": "text_message",
              "label": "Text Message"
            },
            {
              "value": "transaction",
              "label": "Transaction"
            },
            {
              "value": "web_form",
              "label": "Web Form"
            }
          ]
        },
        "per_page": {
          "label": "Leads Per Page",
          "description": "The number of leads to return (default 25, max 2500).",
          "type": "number"
        }
      },
      "request": {
        "method": "GET",
        "url": "https://app.whatconverts.com/api/v1/leads",
        "query": {
          "profile_id": "{{profile_id}}",
          "email_address": "{{email_address}}",
          "phone_number": "{{phone_number}}",
          "per_page": "{{per_page}}"
        },
        "headers": {
          "authorization": "Basic Y3JlZGVudGlhbDAwMHo6Y3JlZGVudGlhbDAwMXo="
        }
      }
    }
  },
  "triggers": {}
}
