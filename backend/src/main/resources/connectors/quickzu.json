{
  "name": "quickzu",
  "label": "Quickzu",
  "description": "Streamline ordering from whatsapp",
  "icon": "",
  "hosts": [
    "app.quickzu.com"
  ],
  "upstream": {
    "package": "@activepieces/piece-quickzu",
    "version": "0.2.0"
  },
  "credential": {
    "fields": {
      "token": {
        "label": "API Token",
        "description": "\n1. Login to your Quickzu Dashboard.\n2. Go to **https://app.quickzu.com/dash/settings/api-webhooks**.\n3. Copy **API Token** to the clipboard and paste it.",
        "secret": true,
        "required": true
      }
    },
    "headers": {
      "authorization": "{{credential.token}}"
    }
  },
  "actions": {
    "quickzu_add_product": {
      "label": "Add Product",
      "description": "Adds new product to store.",
      "inputs": {
        "name": {
          "label": "Name",
          "required": true
        },
        "desc": {
          "label": "Description",
          "type": "multiline"
        },
        "categoryId": {
          "label": "Category",
          "required": true
        },
        "mrp": {
          "label": "MRP Price",
          "required": true,
          "type": "number"
        },
        "price": {
          "label": "Selling Price",
          "description": "Selling price should be equal or less than MRP.",
          "type": "number"
        },
        "unit": {
          "label": "Unit",
          "required": true,
          "type": "select",
          "options": [
            {
              "value": "piece",
              "label": "piece"
            },
            {
              "value": "kilogram",
              "label": "kilogram"
            },
            {
              "value": "Gram",
              "label": "Gram"
            },
            {
              "value": "pound",
              "label": "pound"
            },
            {
              "value": "litre",
              "label": "litre"
            },
            {
              "value": "mili litre",
              "label": "mili litre"
            },
            {
              "value": "dozen",
              "label": "dozen"
            },
            {
              "value": "feet",
              "label": "feet"
            },
            {
              "value": "meter",
              "label": "meter"
            },
            {
              "value": "square feet",
              "label": "square feet"
            },
            {
              "value": "square meter",
              "label": "square meter"
            },
            {
              "value": "set",
              "label": "set"
            },
            {
              "value": "hour",
              "label": "hour"
            },
            {
              "value": "day",
              "label": "day"
            },
            {
              "value": "service",
              "label": "service"
            },
            {
              "value": "combo",
              "label": "combo"
            },
            {
              "value": "box",
              "label": "box"
            },
            {
              "value": "pack",
              "label": "pack"
            },
            {
              "value": "bottle",
              "label": "bottle"
            },
            {
              "value": "whole",
              "label": "whole"
            },
            {
              "value": "slice",
              "label": "slice"
            },
            {
              "value": "bulk",
              "label": "bulk"
            }
          ],
          "defaultValue": "kilogram"
        },
        "value_per_unit": {
          "label": "Unit Value",
          "required": true,
          "type": "number",
          "defaultValue": "1"
        },
        "availability": {
          "label": "Availability",
          "required": true,
          "type": "boolean",
          "defaultValue": "true"
        },
        "exclude_tax": {
          "label": "Exclude Tax",
          "required": true,
          "type": "boolean",
          "defaultValue": "false"
        },
        "enable_variants": {
          "label": "Enable Variants",
          "required": true,
          "type": "boolean",
          "defaultValue": "false"
        },
        "status": {
          "label": "Status",
          "required": true,
          "type": "boolean",
          "defaultValue": "true"
        }
      },
      "request": {
        "method": "POST",
        "url": "https://app.quickzu.com/api/seller/products",
        "body": {
          "name": "{{name}}",
          "desc": "{{desc}}",
          "category": "{{categoryId}}",
          "mrp": "{{mrp}}",
          "price": "{{price}}",
          "value_per_unit": "{{value_per_unit}}",
          "meta": {
            "nonveg": false
          }
        }
      }
    },
    "quickzu_update_product": {
      "label": "Update Product",
      "description": "Updates an existing product in store.",
      "inputs": {
        "productId": {
          "label": "Product",
          "required": true
        },
        "name": {
          "label": "Name"
        },
        "desc": {
          "label": "Description",
          "type": "multiline"
        },
        "categoryId": {
          "label": "Category"
        },
        "mrp": {
          "label": "MRP Price",
          "type": "number"
        },
        "price": {
          "label": "Selling Price",
          "description": "Selling price should be equal or less than MRP.",
          "type": "number"
        },
        "unit": {
          "label": "Unit",
          "type": "select",
          "options": [
            {
              "value": "piece",
              "label": "piece"
            },
            {
              "value": "kilogram",
              "label": "kilogram"
            },
            {
              "value": "Gram",
              "label": "Gram"
            },
            {
              "value": "pound",
              "label": "pound"
            },
            {
              "value": "litre",
              "label": "litre"
            },
            {
              "value": "mili litre",
              "label": "mili litre"
            },
            {
              "value": "dozen",
              "label": "dozen"
            },
            {
              "value": "feet",
              "label": "feet"
            },
            {
              "value": "meter",
              "label": "meter"
            },
            {
              "value": "square feet",
              "label": "square feet"
            },
            {
              "value": "square meter",
              "label": "square meter"
            },
            {
              "value": "set",
              "label": "set"
            },
            {
              "value": "hour",
              "label": "hour"
            },
            {
              "value": "day",
              "label": "day"
            },
            {
              "value": "service",
              "label": "service"
            },
            {
              "value": "combo",
              "label": "combo"
            },
            {
              "value": "box",
              "label": "box"
            },
            {
              "value": "pack",
              "label": "pack"
            },
            {
              "value": "bottle",
              "label": "bottle"
            },
            {
              "value": "whole",
              "label": "whole"
            },
            {
              "value": "slice",
              "label": "slice"
            },
            {
              "value": "bulk",
              "label": "bulk"
            }
          ]
        },
        "value_per_unit": {
          "label": "Unit Value",
          "type": "number"
        },
        "availability": {
          "label": "Availability",
          "type": "select",
          "options": [
            {
              "value": "yes",
              "label": "Yes"
            },
            {
              "value": "no",
              "label": "No"
            }
          ]
        },
        "exclude_tax": {
          "label": "Exclude Tax",
          "type": "select",
          "options": [
            {
              "value": "yes",
              "label": "Yes"
            },
            {
              "value": "no",
              "label": "No"
            }
          ]
        },
        "enable_variants": {
          "label": "Enable Variants",
          "type": "select",
          "options": [
            {
              "value": "yes",
              "label": "Yes"
            },
            {
              "value": "no",
              "label": "No"
            }
          ]
        },
        "status": {
          "label": "Status",
          "type": "select",
          "options": [
            {
              "value": "yes",
              "label": "Yes"
            },
            {
              "value": "no",
              "label": "No"
            }
          ]
        },
        "nonveg": {
          "label": "Non-Veg",
          "type": "select",
          "options": [
            {
              "value": "yes",
              "label": "Yes"
            },
            {
              "value": "no",
              "label": "No"
            }
          ]
        }
      },
      "request": {
        "method": "GET",
        "url": "https://app.quickzu.com/api/seller/products"
      }
    },
    "quickzu_delete_product": {
      "label": "Delete Product",
      "description": "Deletes an existing product from store.",
      "inputs": {
        "productId": {
          "label": "Product",
          "required": true
        }
      },
      "request": {
        "method": "DELETE",
        "url": "https://app.quickzu.com/api/seller/products/{{productId}}"
      }
    },
    "quickzu_list_products": {
      "label": "List Products",
      "description": "Retrieves all or single product details from store.",
      "inputs": {
        "term": {
          "label": "Product name that need to be search."
        },
        "categoryId": {
          "label": "Category"
        }
      },
      "request": {
        "method": "GET",
        "url": "https://app.quickzu.com/api/seller/products",
        "query": {
          "term": "{{term}}",
          "category": "{{categoryId}}"
        }
      }
    },
    "quickzu_create_category": {
      "label": "Create Category",
      "description": "Creates a new category in store.",
      "inputs": {
        "name": {
          "label": "Category Name",
          "required": true
        },
        "status": {
          "label": "Category Status",
          "required": true,
          "type": "boolean",
          "defaultValue": "true"
        }
      },
      "request": {
        "method": "POST",
        "url": "https://app.quickzu.com/api/seller/categories/",
        "body": {
          "name": "{{name}}"
        }
      }
    },
    "quickzu_update_category": {
      "label": "Update Category",
      "description": "Updates an existing category in store.",
      "inputs": {
        "categoryId": {
          "label": "Category",
          "required": true
        },
        "name": {
          "label": "Category Name"
        },
        "status": {
          "label": "Category Status",
          "required": true,
          "type": "boolean",
          "defaultValue": "false"
        }
      },
      "request": {
        "method": "PUT",
        "url": "https://app.quickzu.com/api/seller/categories/{{categoryId}}",
        "body": {
          "name": "{{name}}"
        }
      }
    },
    "quickzu_delete_category": {
      "label": "Delete Category",
      "description": "Deletes an existing category from store.",
      "inputs": {
        "categoryId": {
          "label": "Category",
          "required": true
        }
      },
      "request": {
        "method": "DELETE",
        "url": "https://app.quickzu.com/api/seller/categories/{{categoryId}}"
      }
    },
    "quickzu_list_categories": {
      "label": "List Categories",
      "description": "Retrieves all categories from store.",
      "inputs": {
        "term": {
          "label": "Search Term",
          "description": "Category name that need to be search."
        }
      },
      "request": {
        "method": "GET",
        "url": "https://app.quickzu.com/api/seller/categories",
        "query": {
          "term": "{{term}}"
        }
      }
    },
    "quickzu_get_order_details": {
      "label": "Get Order Details",
      "description": "Retrieves order details from store.",
      "inputs": {
        "orderId": {
          "label": "Order",
          "required": true
        }
      },
      "request": {
        "method": "GET",
        "url": "https://app.quickzu.com/api/seller/orders/{{orderId}}"
      }
    },
    "quickzu_list_orders": {
      "label": "List Orders",
      "description": "Retrieves orders of store.",
      "inputs": {
        "page": {
          "label": "Current page number",
          "required": true,
          "type": "number",
          "defaultValue": "1"
        },
        "limit": {
          "label": "Number of orders per page",
          "required": true,
          "type": "number",
          "defaultValue": "20"
        }
      },
      "request": {
        "method": "GET",
        "url": "https://app.quickzu.com/api/seller/orders/",
        "query": {
          "page": "{{page}}",
          "limit": "{{limit}}"
        }
      }
    },
    "quickzu_list_live_orders": {
      "label": "List Live Orders",
      "description": "Retrieves live orders of store.",
      "inputs": {
        "limit": {
          "label": "Number of live orders that need to be fetched per order status",
          "required": true,
          "type": "number",
          "defaultValue": "15"
        }
      },
      "request": {
        "method": "GET",
        "url": "https://app.quickzu.com/api/seller/orders/live",
        "query": {
          "limit": "{{limit}}"
        }
      }
    }
  },
  "triggers": {}
}
