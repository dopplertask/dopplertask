{
  "name": "missive",
  "label": "Missive",
  "description": "",
  "icon": "",
  "hosts": [
    "public.missiveapp.com"
  ],
  "upstream": {
    "package": "@activepieces/piece-missive",
    "version": "0.2.1"
  },
  "credential": {
    "fields": {
      "token": {
        "label": "API Token",
        "description": "\n    To get your API token:\n    \n    1. Go to your Missive preferences\n    2. Click the API tab  \n    3. Click \"Create a new token\"\n    4. Copy the generated token (starts with 'missive_pat-')\n    \n    Note: You need to be part of an organization subscribed to the Productive plan to generate API tokens.\n    ",
        "secret": true,
        "required": true
      }
    },
    "headers": {
      "authorization": "Bearer {{credential.token}}"
    }
  },
  "actions": {
    "create_contact": {
      "label": "Create Contact",
      "description": "Add a new contact within a specified contact book",
      "inputs": {
        "contact_book": {
          "label": "Contact Book",
          "description": "Select the contact book where the contact will be created",
          "required": true
        },
        "first_name": {
          "label": "First Name",
          "description": "First name of the contact"
        },
        "last_name": {
          "label": "Last Name",
          "description": "Last name of the contact"
        },
        "middle_name": {
          "label": "Middle Name",
          "description": "Middle name of the contact"
        },
        "phonetic_first_name": {
          "label": "Phonetic First Name",
          "description": "Phonetic spelling of the first name"
        },
        "phonetic_last_name": {
          "label": "Phonetic Last Name",
          "description": "Phonetic spelling of the last name"
        },
        "phonetic_middle_name": {
          "label": "Phonetic Middle Name",
          "description": "Phonetic spelling of the middle name"
        },
        "prefix": {
          "label": "Prefix",
          "description": "Name prefix (e.g., Mr., Mrs., Dr.)"
        },
        "suffix": {
          "label": "Suffix",
          "description": "Name suffix (e.g., Jr., Sr., III)"
        },
        "nickname": {
          "label": "Nickname",
          "description": "Nickname for the contact"
        },
        "file_as": {
          "label": "File As",
          "description": "How the contact should be filed/sorted"
        },
        "notes": {
          "label": "Notes",
          "description": "Additional notes about the contact",
          "type": "multiline"
        },
        "starred": {
          "label": "Starred",
          "description": "Whether the contact should be starred",
          "type": "boolean",
          "defaultValue": "false"
        },
        "gender": {
          "label": "Gender",
          "description": "Gender of the contact",
          "type": "select",
          "options": [
            {
              "value": "Male",
              "label": "Male"
            },
            {
              "value": "Female",
              "label": "Female"
            },
            {
              "value": "Other",
              "label": "Other"
            }
          ]
        },
        "infos": {
          "label": "Contact Information",
          "description": "Email addresses, phone numbers, and other contact information",
          "type": "json"
        }
      },
      "request": {
        "method": "POST",
        "url": "https://public.missiveapp.com/v1/contacts",
        "body": {
          "contacts": [
            {
              "contact_book": "{{contact_book}}",
              "first_name": "{{first_name}}",
              "last_name": "{{last_name}}",
              "middle_name": "{{middle_name}}",
              "phonetic_first_name": "{{phonetic_first_name}}",
              "phonetic_last_name": "{{phonetic_last_name}}",
              "phonetic_middle_name": "{{phonetic_middle_name}}",
              "prefix": "{{prefix}}",
              "suffix": "{{suffix}}",
              "nickname": "{{nickname}}",
              "file_as": "{{file_as}}",
              "notes": "{{notes}}"
            }
          ]
        }
      }
    },
    "update_contact": {
      "label": "Update Contact",
      "description": "Modify fields for an existing contact",
      "inputs": {
        "contact_book": {
          "label": "Contact Book",
          "description": "Select the contact book where the contact will be created",
          "required": true
        },
        "contact_id": {
          "label": "Contact",
          "description": "Select the contact to update",
          "required": true
        },
        "move_to_contact_book": {
          "label": "Move to Contact Book",
          "description": "Move contact to a different contact book (optional)"
        },
        "first_name": {
          "label": "First Name",
          "description": "First name of the contact"
        },
        "last_name": {
          "label": "Last Name",
          "description": "Last name of the contact"
        },
        "middle_name": {
          "label": "Middle Name",
          "description": "Middle name of the contact"
        },
        "phonetic_first_name": {
          "label": "Phonetic First Name",
          "description": "Phonetic spelling of the first name"
        },
        "phonetic_last_name": {
          "label": "Phonetic Last Name",
          "description": "Phonetic spelling of the last name"
        },
        "phonetic_middle_name": {
          "label": "Phonetic Middle Name",
          "description": "Phonetic spelling of the middle name"
        },
        "prefix": {
          "label": "Prefix",
          "description": "Name prefix (e.g., Mr., Mrs., Dr.)"
        },
        "suffix": {
          "label": "Suffix",
          "description": "Name suffix (e.g., Jr., Sr., III)"
        },
        "nickname": {
          "label": "Nickname",
          "description": "Nickname for the contact"
        },
        "file_as": {
          "label": "File As",
          "description": "How the contact should be filed/sorted"
        },
        "notes": {
          "label": "Notes",
          "description": "Additional notes about the contact",
          "type": "multiline"
        },
        "starred": {
          "label": "Starred",
          "description": "Whether the contact should be starred",
          "type": "boolean"
        },
        "gender": {
          "label": "Gender",
          "description": "Gender of the contact",
          "type": "select",
          "options": [
            {
              "value": "Male",
              "label": "Male"
            },
            {
              "value": "Female",
              "label": "Female"
            },
            {
              "value": "Other",
              "label": "Other"
            }
          ]
        },
        "infos": {
          "label": "Contact Information",
          "description": "Email addresses, phone numbers, and other contact information. Note: When updating infos, all existing infos will be replaced with the ones provided here.",
          "type": "json"
        }
      },
      "request": {
        "method": "PATCH",
        "url": "https://public.missiveapp.com/v1/contacts/{{contact_id}}",
        "body": {
          "contacts": [
            {
              "id": "{{contact_id}}",
              "contact_book": "{{move_to_contact_book}}",
              "first_name": "{{first_name}}",
              "last_name": "{{last_name}}",
              "middle_name": "{{middle_name}}",
              "phonetic_first_name": "{{phonetic_first_name}}",
              "phonetic_last_name": "{{phonetic_last_name}}",
              "phonetic_middle_name": "{{phonetic_middle_name}}",
              "prefix": "{{prefix}}",
              "suffix": "{{suffix}}",
              "nickname": "{{nickname}}",
              "file_as": "{{file_as}}",
              "notes": "{{notes}}"
            }
          ]
        }
      }
    }
  },
  "triggers": {}
}
