{
  "name": "dumpling-ai",
  "label": "Dumpling AI",
  "description": "Transform unstructured website content into clean, AI-ready data",
  "icon": "",
  "hosts": [
    "app.dumplingai.com"
  ],
  "upstream": {
    "package": "@activepieces/piece-dumpling-ai",
    "version": "0.2.2"
  },
  "credential": {
    "fields": {
      "token": {
        "label": "API Key",
        "description": "\n  You can obtain API key from [API Section](https://app.dumplingai.com/api-keys).",
        "secret": true,
        "required": true
      }
    },
    "headers": {
      "authorization": "Bearer {{credential.token}}"
    }
  },
  "actions": {
    "web_search": {
      "label": "Web Search",
      "description": "Search the web and optionally retrieve content from top results.",
      "inputs": {
        "query": {
          "label": "Search Query",
          "required": true
        },
        "country": {
          "label": "Country",
          "description": "Two-letter country code for location bias (e.g., \"US\" for United States)."
        },
        "location": {
          "label": "Location",
          "description": "Specific location to focus the search (e.g., \"New York, NY\")."
        },
        "language": {
          "label": "Language",
          "description": "Language code for the search results (e.g., \"en\" for English)."
        },
        "dateRange": {
          "label": "Date Range",
          "description": "Filter results by date.",
          "type": "select",
          "options": [
            {
              "value": "anyTime",
              "label": "Any Time"
            },
            {
              "value": "pastHour",
              "label": "Past Hour"
            },
            {
              "value": "pastDay",
              "label": "Past Day"
            },
            {
              "value": "pastWeek",
              "label": "Past Week"
            },
            {
              "value": "pastMonth",
              "label": "Past Month"
            },
            {
              "value": "pastYear",
              "label": "Past Year"
            }
          ]
        },
        "page": {
          "label": "Page Number",
          "description": "Page number for paginated results.",
          "type": "number"
        },
        "scrapeResults": {
          "label": "Scrape Results",
          "description": "Whether to scrape top search results.",
          "type": "boolean",
          "defaultValue": "false"
        },
        "numResultsToScrape": {
          "label": "Number of Results to Scrape",
          "description": "Number of top results to scrape (max: 10).",
          "type": "number",
          "defaultValue": "3"
        },
        "scrapeFormat": {
          "label": "Scrape Format",
          "description": "Format of scraped content",
          "type": "select",
          "options": [
            {
              "value": "markdown",
              "label": "Markdown"
            },
            {
              "value": "html",
              "label": "HTML"
            },
            {
              "value": "screenshot",
              "label": "Screenshot"
            }
          ],
          "defaultValue": "markdown"
        },
        "cleanedOutput": {
          "label": "Clean Output",
          "description": "Whether the scraped output should be cleaned.",
          "type": "boolean",
          "defaultValue": "true"
        }
      },
      "request": {
        "method": "POST",
        "url": "https://app.dumplingai.com/api/v1/search",
        "body": {
          "query": "{{query}}",
          "country": "{{country}}",
          "location": "{{location}}",
          "language": "{{language}}",
          "page": "{{page}}",
          "numResultsToScrape": "{{numResultsToScrape}}"
        }
      }
    },
    "search_news": {
      "label": "Search News",
      "description": "Search for news articles using Google News.",
      "inputs": {
        "query": {
          "label": "Search Query",
          "description": "The search query for Google News.",
          "required": true
        },
        "country": {
          "label": "Country",
          "description": "Country code for location bias (e.g., \"US\" for United States)."
        },
        "location": {
          "label": "Location",
          "description": "Specific location to focus the search (e.g., \"New York, NY\")."
        },
        "language": {
          "label": "Language",
          "description": "Language code for the search results (e.g., \"en\" for English)."
        },
        "dateRange": {
          "label": "Date Range",
          "description": "Filter results by date.",
          "type": "select",
          "options": [
            {
              "value": "anyTime",
              "label": "Any Time"
            },
            {
              "value": "pastHour",
              "label": "Past Hour"
            },
            {
              "value": "pastDay",
              "label": "Past Day"
            },
            {
              "value": "pastWeek",
              "label": "Past Week"
            },
            {
              "value": "pastMonth",
              "label": "Past Month"
            },
            {
              "value": "pastYear",
              "label": "Past Year"
            }
          ]
        },
        "page": {
          "label": "Page Number",
          "description": "Page number for paginated results.",
          "type": "number"
        }
      },
      "request": {
        "method": "POST",
        "url": "https://app.dumplingai.com/api/v1/search-news",
        "body": {
          "query": "{{query}}",
          "country": "{{country}}",
          "location": "{{location}}",
          "language": "{{language}}",
          "page": "{{page}}"
        }
      }
    },
    "generate_image": {
      "label": "Generate Image",
      "description": "Generate images based on a text prompt using AI.",
      "inputs": {
        "model": {
          "label": "Model",
          "description": "The model to use for image generation",
          "required": true,
          "type": "select",
          "options": [
            {
              "value": "FLUX.1-schnell",
              "label": "FLUX.1-schnell"
            },
            {
              "value": "FLUX.1-dev",
              "label": "FLUX.1-dev"
            },
            {
              "value": "FLUX.1-pro",
              "label": "FLUX.1-pro"
            },
            {
              "value": "FLUX.1.1-pro",
              "label": "FLUX.1.1-pro"
            },
            {
              "value": "recraft-v3",
              "label": "recraft-v3"
            }
          ],
          "defaultValue": "FLUX.1-schnell"
        },
        "prompt": {
          "label": "Prompt",
          "description": "The text prompt for image generation",
          "required": true,
          "type": "multiline"
        },
        "aspect_ratio": {
          "label": "Aspect Ratio",
          "description": "Aspect ratio of the generated image",
          "type": "select",
          "options": [
            {
              "value": "1:1",
              "label": "Square (1:1)"
            },
            {
              "value": "16:9",
              "label": "Landscape 16:9"
            },
            {
              "value": "21:9",
              "label": "Landscape 21:9"
            },
            {
              "value": "3:2",
              "label": "Landscape 3:2"
            },
            {
              "value": "4:3",
              "label": "Landscape 4:3"
            },
            {
              "value": "2:3",
              "label": "Portrait 2:3"
            },
            {
              "value": "3:4",
              "label": "Portrait 3:4"
            },
            {
              "value": "4:5",
              "label": "Portrait 4:5"
            },
            {
              "value": "9:16",
              "label": "Portrait 9:16"
            },
            {
              "value": "9:21",
              "label": "Portrait 9:21"
            }
          ],
          "defaultValue": "1:1"
        },
        "num_outputs": {
          "label": "Number of Images",
          "description": "Number of images to generate (1-4)",
          "type": "number",
          "defaultValue": "1"
        },
        "seed": {
          "label": "Seed",
          "description": "Seed for reproducible results",
          "type": "number"
        },
        "output_format": {
          "label": "Output Format",
          "description": "Format of the generated image",
          "type": "select",
          "options": [
            {
              "value": "webp",
              "label": "WebP"
            },
            {
              "value": "jpg",
              "label": "JPG"
            },
            {
              "value": "png",
              "label": "PNG"
            }
          ],
          "defaultValue": "webp"
        }
      },
      "request": {
        "method": "POST",
        "url": "https://app.dumplingai.com/api/v1/generate-ai-image",
        "body": {
          "input": {
            "prompt": "{{prompt}}",
            "seed": "{{seed}}",
            "num_outputs": "{{num_outputs}}"
          }
        }
      }
    },
    "scrape_website": {
      "label": "Scrape Website",
      "description": "Scrapes data from a specified URL and format the result.",
      "inputs": {
        "url": {
          "label": "URL",
          "required": true
        },
        "format": {
          "label": "Output Format",
          "description": "The format of the output",
          "type": "select",
          "options": [
            {
              "value": "markdown",
              "label": "Markdown"
            },
            {
              "value": "html",
              "label": "HTML"
            },
            {
              "value": "screenshot",
              "label": "Screenshot"
            }
          ],
          "defaultValue": "markdown"
        },
        "cleaned": {
          "label": "Clean Output ?",
          "description": "Whether the output should be cleaned.",
          "type": "boolean",
          "defaultValue": "true"
        },
        "renderJs": {
          "label": "Render JavaScript ?",
          "description": "Whether to render JavaScript before scraping.",
          "type": "boolean",
          "defaultValue": "true"
        }
      },
      "request": {
        "method": "POST",
        "url": "https://app.dumplingai.com/api/v1/scrape",
        "body": {
          "url": "{{url}}"
        }
      }
    },
    "crawl_website": {
      "label": "Crawl Website",
      "description": "Crawl a website and return structured content from multiple pages.",
      "inputs": {
        "url": {
          "label": "URL",
          "description": "The website URL to crawl.",
          "required": true
        },
        "limit": {
          "label": "Page Limit",
          "description": "Maximum number of pages to crawl.",
          "type": "number",
          "defaultValue": "5"
        },
        "depth": {
          "label": "Crawl Depth",
          "description": "Depth of crawling (distance between base URL path and sub paths).",
          "type": "number",
          "defaultValue": "2"
        },
        "format": {
          "label": "Output Format",
          "description": "Format of the output content.",
          "type": "select",
          "options": [
            {
              "value": "markdown",
              "label": "Markdown"
            },
            {
              "value": "text",
              "label": "Text"
            },
            {
              "value": "raw",
              "label": "Raw"
            }
          ],
          "defaultValue": "markdown"
        }
      },
      "request": {
        "method": "POST",
        "url": "https://app.dumplingai.com/api/v1/crawl",
        "body": {
          "url": "{{url}}",
          "limit": "{{limit}}",
          "depth": "{{depth}}"
        }
      }
    }
  },
  "triggers": {}
}
