{
  "name": "dittofeed",
  "label": "Dittofeed",
  "description": "Customer data platform for user analytics and tracking",
  "icon": "",
  "hosts": [
    "{{credential.baseUrl}}"
  ],
  "upstream": {
    "package": "@activepieces/piece-dittofeed",
    "version": "0.1.6"
  },
  "credential": {
    "fields": {
      "apiKey": {
        "label": "API Key",
        "description": "Your API key of Dittofeed.",
        "secret": true,
        "required": true
      },
      "baseUrl": {
        "label": "Base URL",
        "description": "The base URL of your Dittofeed instance. The host only, without https://, such as name.example.com.",
        "required": true
      }
    },
    "headers": {
      "authorization": "{{credential.apiKey}}"
    }
  },
  "actions": {
    "identify": {
      "label": "Identify User",
      "description": "Identify a user in Dittofeed.",
      "inputs": {
        "userId": {
          "label": "User ID",
          "required": true
        },
        "traits": {
          "label": "User Traits",
          "type": "json"
        }
      },
      "request": {
        "method": "POST",
        "url": "https://{{credential.baseUrl}}/api/public/apps/identify",
        "body": {
          "type": "identify",
          "messageId": "identify-{{userId}}-1794261901645",
          "userId": "{{userId}}"
        }
      }
    },
    "track": {
      "label": "Track Event",
      "description": "Track an event for a user.",
      "inputs": {
        "userId": {
          "label": "User ID",
          "required": true
        },
        "event": {
          "label": "Event Name",
          "required": true
        },
        "properties": {
          "label": "Event Properties",
          "type": "json"
        }
      },
      "request": {
        "method": "POST",
        "url": "https://{{credential.baseUrl}}/api/public/apps/track",
        "body": {
          "type": "track",
          "messageId": "track-{{userId}}-{{event}}-1794261901836",
          "userId": "{{userId}}",
          "event": "{{event}}"
        }
      }
    },
    "screen": {
      "label": "Screen Event",
      "description": "Track a screen view event.",
      "inputs": {
        "userId": {
          "label": "User ID",
          "required": true
        },
        "name": {
          "label": "Screen Name",
          "required": true
        },
        "properties": {
          "label": "Screen Properties",
          "type": "json"
        }
      },
      "request": {
        "method": "POST",
        "url": "https://{{credential.baseUrl}}/api/public/apps/screen",
        "body": {
          "type": "screen",
          "messageId": "screen-{{userId}}-{{name}}-1794261902017",
          "userId": "{{userId}}",
          "name": "{{name}}"
        }
      }
    }
  },
  "triggers": {}
}
