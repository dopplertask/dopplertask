    "microsoft_outlook_calendar_create_event": {
      "label": "Create Event",
      "description": "Creates a calendar event, optionally with attendees.",
      "inputs": {
        "subject": {
          "label": "Subject",
          "required": true
        },
        "start": {
          "label": "Start",
          "description": "Start as a local date-time without offset, e.g. \"2026-11-01T09:00:00\", read in Time Zone. For an all-day event use midnight.",
          "required": true
        },
        "end": {
          "label": "End",
          "description": "End as a local date-time without offset, e.g. \"2026-11-01T10:00:00\", read in Time Zone. For an all-day event use midnight of the following day.",
          "required": true
        },
        "timeZone": {
          "label": "Time Zone",
          "description": "Time zone of Start and End, IANA or Windows name, e.g. \"Europe/London\" or \"Pacific Standard Time\" (see Get Supported Time Zones). Defaults to UTC."
        },
        "calendarId": {
          "label": "Calendar ID",
          "description": "Calendar ID, from List Calendars. Leave empty for the user's default calendar."
        },
        "bodyContent": {
          "label": "Body",
          "description": "Event description.",
          "type": "multiline"
        },
        "bodyContentType": {
          "label": "Body Type",
          "description": "Format of Body. Defaults to text.",
          "type": "select",
          "options": [
            {
              "value": "text",
              "label": "Text"
            },
            {
              "value": "html",
              "label": "HTML"
            }
          ]
        },
        "location": {
          "label": "Location",
          "description": "Location display name, e.g. a room or address."
        },
        "attendees": {
          "label": "Attendees",
          "description": "People to invite; each one receives a meeting invitation when the event is created.",
          "type": "json"
        },
        "isAllDay": {
          "label": "All Day",
          "description": "Whether the event lasts whole days. Start and End must then be midnight in Time Zone.",
          "type": "select",
          "options": [
            {
              "value": "true",
              "label": "Yes"
            },
            {
              "value": "false",
              "label": "No"
            }
          ]
        },
        "isOnlineMeeting": {
          "label": "Online Meeting",
          "description": "Whether to add an online meeting link using the mailbox's default provider, e.g. Teams.",
          "type": "select",
          "options": [
            {
              "value": "true",
              "label": "Yes"
            },
            {
              "value": "false",
              "label": "No"
            }
          ]
        },
        "showAs": {
          "label": "Show As",
          "description": "Free/busy status shown for the event. Defaults to busy.",
          "type": "select",
          "options": [
            {
              "value": "free",
              "label": "Free"
            },
            {
              "value": "tentative",
              "label": "Tentative"
            },
            {
              "value": "busy",
              "label": "Busy"
            },
            {
              "value": "oof",
              "label": "Out of Office"
            },
            {
              "value": "workingElsewhere",
              "label": "Working Elsewhere"
            },
            {
              "value": "unknown",
              "label": "Unknown"
            }
          ]
        },
        "importance": {
          "label": "Importance",
          "type": "select",
          "options": [
            {
              "value": "low",
              "label": "Low"
            },
            {
              "value": "normal",
              "label": "Normal"
            },
            {
              "value": "high",
              "label": "High"
            }
          ]
        },
        "sensitivity": {
          "label": "Sensitivity",
          "type": "select",
          "options": [
            {
              "value": "normal",
              "label": "Normal"
            },
            {
              "value": "personal",
              "label": "Personal"
            },
            {
              "value": "private",
              "label": "Private"
            },
            {
              "value": "confidential",
              "label": "Confidential"
            }
          ]
        },
        "categories": {
          "label": "Categories",
          "description": "Category names, e.g. \"Red category\".",
          "type": "json"
        },
        "isReminderOn": {
          "label": "Reminder On",
          "type": "select",
          "options": [
            {
              "value": "true",
              "label": "Yes"
            },
            {
              "value": "false",
              "label": "No"
            }
          ]
        },
        "reminderMinutesBeforeStart": {
          "label": "Reminder Minutes Before Start",
          "type": "number"
        },
        "allowNewTimeProposals": {
          "label": "Allow New Time Proposals",
          "description": "Whether attendees may propose another time. Defaults to true.",
          "type": "select",
          "options": [
            {
              "value": "true",
              "label": "Yes"
            },
            {
              "value": "false",
              "label": "No"
            }
          ]
        },
        "recurrence": {
          "label": "Recurrence",
          "description": "Graph patternedRecurrence object, e.g. {\"pattern\":{\"type\":\"weekly\",\"interval\":1,\"daysOfWeek\":[\"monday\"]},\"range\":{\"type\":\"endDate\",\"startDate\":\"2026-11-02\",\"endDate\":\"2026-12-28\"}}. Leave empty for a single event.",
          "type": "json"
        }
      },
      "request": {
        "method": "POST",
        "url": "https://graph.microsoft.com/v1.0/me/calendars/{{calendarId}}/events",
        "headers": {
          "sdkversion": "graph-js/3.0.7 (featureUsage=7)"
        },
        "body": {
          "subject": "{{subject}}",
          "start": {
            "dateTime": "{{start}}",
            "timeZone": "{{timeZone}}"
          },
          "end": {
            "dateTime": "{{end}}",
            "timeZone": "{{timeZone}}"
          },
          "body": {
            "contentType": "text",
            "content": "{{bodyContent}}"
          },
          "location": {
            "displayName": "{{location}}"
          },
          "reminderMinutesBeforeStart": "{{reminderMinutesBeforeStart}}"
        }
      }
    },
