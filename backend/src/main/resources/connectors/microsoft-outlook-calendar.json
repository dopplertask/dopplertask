{
  "name": "microsoft-outlook-calendar",
  "label": "Microsoft Outlook Calendar",
  "description": "Calendar software by Microsoft",
  "icon": "",
  "hosts": [
    "graph.microsoft.com"
  ],
  "upstream": {
    "package": "@activepieces/piece-microsoft-outlook-calendar",
    "version": "0.4.1"
  },
  "credential": {
    "oauth2": {
      "authUrl": "https://{cloud}/common/oauth2/v2.0/authorize",
      "tokenUrl": "https://{cloud}/common/oauth2/v2.0/token",
      "scope": "User.Read Calendars.ReadWrite offline_access openid email profile"
    }
  },
  "actions": {
    "create_event": {
      "label": "Create a new event in a calendar",
      "description": "Create a new event in a calendar",
      "inputs": {
        "calendarId": {
          "label": "Calendar",
          "required": true
        },
        "title": {
          "label": "Title of the event",
          "required": true
        },
        "start": {
          "label": "Start date time of the event",
          "required": true
        },
        "end": {
          "label": "End date time of the event",
          "description": "By default it'll be 30 min post start time"
        },
        "timezone": {
          "label": "Timezone",
          "required": true
        },
        "location": {
          "label": "Location"
        }
      },
      "request": {
        "method": "POST",
        "url": "https://graph.microsoft.com/v1.0/me/calendars/{{calendarId}}/events",
        "headers": {
          "sdkversion": "graph-js/3.0.7 (featureUsage=7)"
        },
        "body": {
          "subject": "{{title}}",
          "body": {},
          "start": {
            "dateTime": "Invalid Date",
            "timeZone": "{{timezone}}"
          },
          "end": {
            "dateTime": "Invalid Date",
            "timeZone": "{{timezone}}"
          },
          "location": {
            "displayName": "{{location}}"
          }
        }
      }
    },
    "delete_event": {
      "label": "Delete an event in a calendar",
      "description": "Delete an event in a calendar",
      "inputs": {
        "calendarId": {
          "label": "Calendar",
          "required": true
        },
        "eventId": {
          "label": "Event ID",
          "required": true
        }
      },
      "request": {
        "method": "DELETE",
        "url": "https://graph.microsoft.com/v1.0/me/calendars/{{calendarId}}/events/{{eventId}}",
        "headers": {
          "sdkversion": "graph-js/3.0.7 (featureUsage=7)"
        }
      }
    },
    "microsoft_outlook_calendar_get_event_attachment": {
      "label": "Get Event Attachment",
      "description": "Gets one attachment of an event, including its content.",
      "inputs": {
        "eventId": {
          "label": "Event ID",
          "description": "Event ID, from List Events, Get Calendar View or Create Event.",
          "required": true
        },
        "attachmentId": {
          "label": "Attachment ID",
          "description": "Attachment ID, from List Event Attachments or Add Event Attachment.",
          "required": true
        }
      },
      "request": {
        "method": "GET",
        "url": "https://graph.microsoft.com/v1.0/me/events/{{eventId}}/attachments/{{attachmentId}}",
        "headers": {
          "sdkversion": "graph-js/3.0.7 (featureUsage=7)"
        }
      }
    },
    "microsoft_outlook_calendar_create_calendar_group": {
      "label": "Create Calendar Group",
      "description": "Creates a calendar group.",
      "inputs": {
        "name": {
          "label": "Name",
          "description": "Name of the new calendar group.",
          "required": true
        }
      },
      "request": {
        "method": "POST",
        "url": "https://graph.microsoft.com/v1.0/me/calendarGroups",
        "headers": {
          "sdkversion": "graph-js/3.0.7 (featureUsage=7)"
        },
        "body": {
          "name": "{{name}}"
        }
      }
    },
