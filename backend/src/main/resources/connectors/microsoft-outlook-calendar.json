      },
      "request": {
        "method": "GET",
        "url": "https://graph.microsoft.com/v1.0/me/calendarGroups/{{calendarGroupId}}",
        "headers": {
          "sdkversion": "graph-js/3.0.7 (featureUsage=7)"
        }
      }
    },
    "microsoft_outlook_calendar_update_calendar_group": {
