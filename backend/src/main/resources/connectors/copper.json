{
  "name": "copper",
  "label": "Copper",
  "description": "",
  "icon": "",
  "hosts": [
    "api.copper.com"
  ],
  "upstream": {
    "package": "@activepieces/piece-copper",
    "version": "0.2.2"
  },
  "credential": {
    "fields": {
      "email": {
        "label": "Email Address",
        "description": "Email Address of the Token Owner",
        "required": true
      },
      "apiKey": {
        "label": "API Key",
        "description": "Your API Key in settings > integrations",
        "required": true
      }
    },
    "headers": {
      "x-pw-accesstoken": "{{credential.apiKey}}",
      "x-pw-useremail": "{{credential.email}}"
    }
  },
  "actions": {
    "createLead": {
      "label": "Create Lead",
      "description": "Adds a new lead.",
      "inputs": {
        "name": {
          "label": "Full Name",
          "required": true
        },
        "email": {
          "label": "Email",
          "required": true
        },
        "category": {
          "label": "Category of the email address (e.g., work, personal)",
          "required": true
        },
        "phone_numbers": {
          "label": "Phone Numbers",
          "type": "json"
        },
        "address_street": {
          "label": "Street"
        },
        "address_city": {
          "label": "City"
        },
        "address_state": {
          "label": "State/Region"
        },
        "address_postal_code": {
          "label": "Postal Code"
        },
        "address_country": {
          "label": "Country"
        }
      },
      "request": {
        "method": "POST",
        "url": "https://api.copper.com/developer_api/v1/leads",
        "headers": {
          "x-pw-application": "developer_api"
        },
        "body": {
          "name": "{{name}}",
          "email": {
            "email": "{{email}}",
            "category": "{{category}}"
          },
          "address": {
            "street": "{{address_street}}",
            "city": "{{address_city}}",
            "state": "{{address_state}}",
            "postal_code": "{{address_postal_code}}",
            "country": "{{address_country}}"
          }
        }
      }
    },
    "createCompany": {
      "label": "Create Company",
      "description": "Adds a new company.",
      "inputs": {
        "name": {
          "label": "Full Name",
          "required": true
        },
        "email_domain": {
          "label": "Email Domain",
          "description": "E.g. democompany.com"
        },
        "details": {
          "label": "Details"
        },
        "phone_numbers": {
          "label": "Phone Numbers",
          "type": "json"
        },
        "address_street": {
          "label": "Street"
        },
        "address_city": {
          "label": "City"
        },
        "address_state": {
          "label": "State/Region"
        },
        "address_postal_code": {
          "label": "Postal Code"
        },
        "address_country": {
          "label": "Country"
        },
        "primaryContactId": {
          "label": "Primary Contact",
          "description": "select a primary contact"
        }
      },
      "request": {
        "method": "POST",
        "url": "https://api.copper.com/developer_api/v1/companies",
        "headers": {
          "x-pw-application": "developer_api"
        },
        "body": {
          "name": "{{name}}",
          "email_domain": "{{email_domain}}",
          "details": "{{details}}",
          "address": {
            "street": "{{address_street}}",
            "city": "{{address_city}}",
            "state": "{{address_state}}",
            "postal_code": "{{address_postal_code}}",
            "country": "{{address_country}}"
          },
          "primary_contact_id": "{{primaryContactId}}"
        }
      }
    },
    "createProject": {
      "label": "Create Project",
      "description": "Adds a new project.",
      "inputs": {
        "name": {
          "label": "Name",
          "description": "The name of the project",
          "required": true
        },
        "details": {
          "label": "Details",
          "description": "The details of the project"
        }
      },
      "request": {
        "method": "POST",
        "url": "https://api.copper.com/developer_api/v1/projects",
        "headers": {
          "x-pw-application": "developer_api"
        },
        "body": {
          "name": "{{name}}",
          "details": "{{details}}"
        }
      }
    }
  },
  "triggers": {}
}
