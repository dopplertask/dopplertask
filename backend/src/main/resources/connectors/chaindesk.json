{
  "name": "chaindesk",
  "label": "Chaindesk",
  "description": "",
  "icon": "",
  "hosts": [
    "app.askli.co"
  ],
  "upstream": {
    "package": "@activepieces/piece-chaindesk",
    "version": "0.2.2"
  },
  "credential": {
    "fields": {
      "token": {
        "label": "API Key",
        "description": "You can obtain API key from [API Keys settings](https://app.askli.co/settings/api-keys).",
        "secret": true,
        "required": true
      }
    },
    "headers": {
      "authorization": "Bearer {{credential.token}}"
    }
  },
  "actions": {
    "query-agent": {
      "label": "Query Agent",
      "description": "Asks question to your Agent.",
      "inputs": {
        "agentId": {
          "label": "Agent ID",
          "required": true
        },
        "query": {
          "label": "Query",
          "required": true,
          "type": "multiline"
        },
        "conversationId": {
          "label": "Conversation ID",
          "description": "ID of the conversation (If not provided a new conversation is created).",
          "type": "multiline"
        }
      },
      "request": {
        "method": "POST",
        "url": "https://app.askli.co/api/agents/{{agentId}}/query",
        "body": {
          "query": "{{query}}",
          "conversationId": "{{conversationId}}"
        }
      }
    },
    "query-datastore": {
      "label": "Query Datastore",
      "description": "Asks question to your Datastore.",
      "inputs": {
        "datastoreId": {
          "label": "Datastore ID",
          "required": true
        },
        "query": {
          "label": "Query",
          "required": true,
          "type": "multiline"
        }
      },
      "request": {
        "method": "POST",
        "url": "https://app.askli.co/api/datastores/{{datastoreId}}/query",
        "body": {
          "query": "{{query}}"
        }
      }
    }
  },
  "triggers": {}
}
