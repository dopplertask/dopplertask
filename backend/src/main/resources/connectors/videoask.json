{
  "name": "videoask",
  "label": "VideoAsk",
  "description": "",
  "icon": "",
  "hosts": [
    "api.videoask.com"
  ],
  "upstream": {
    "package": "@activepieces/piece-videoask",
    "version": "0.2.1"
  },
  "credential": {
    "oauth2": {
      "authUrl": "https://auth.videoask.com/authorize",
      "tokenUrl": "https://auth.videoask.com/oauth/token",
      "scope": ""
    }
  },
  "actions": {
    "addTagToContact": {
      "label": "Add tag to contact",
      "description": "Add a tag to a contact (respondent) in VideoAsk",
      "inputs": {
        "organizationId": {
          "label": "Organization ID",
          "description": "Select the organization",
          "required": true
        },
        "contactId": {
          "label": "Contact ID",
          "description": "The contact (respondent) id to add the tag to",
          "required": true
        },
        "tagId": {
          "label": "Tag ID",
          "description": "Select the tag",
          "required": true
        }
      },
      "request": {
        "method": "PATCH",
        "url": "https://api.videoask.com/contacts/{{contactId}}/tags/{{tagId}}",
        "headers": {
          "organization-id": "{{organizationId}}"
        },
        "body": {
          "action": "add"
        }
      }
    },
    "createContact": {
      "label": "create contact",
      "description": "Create a new respondent (contact)",
      "inputs": {
        "organizationId": {
          "label": "Organization ID",
          "description": "Select the organization",
          "required": true
        },
        "name": {
          "label": "Name",
          "description": "The name of the contact"
        },
        "email": {
          "label": "Email",
          "description": "The email of the contact",
          "required": true
        },
        "phone_number": {
          "label": "Phone",
          "description": "The phone number of the contact"
        }
      },
      "request": {
        "method": "POST",
        "url": "https://api.videoask.com/contacts",
        "headers": {
          "organization-id": "{{organizationId}}"
        },
        "body": {
          "name": "{{name}}",
          "email": "{{email}}",
          "phone_number": "{{phone_number}}"
        }
      }
    },
    "removeTagFromContact": {
      "label": "Remove tag from contact",
      "description": "Remove a tag from a contact (respondent) in VideoAsk",
      "inputs": {
        "organizationId": {
          "label": "Organization ID",
          "description": "Select the organization",
          "required": true
        },
        "contactId": {
          "label": "Contact ID",
          "description": "The contact (respondent) id to remove the tag from",
          "required": true
        },
        "tagId": {
          "label": "Tag ID",
          "description": "Select the tag",
          "required": true
        }
      },
      "request": {
        "method": "PATCH",
        "url": "https://api.videoask.com/contacts/{{contactId}}/tags/{{tagId}}",
        "headers": {
          "organization-id": "{{organizationId}}"
        },
        "body": {
          "action": "remove"
        }
      }
    },
    "searchForm": {
      "label": "Search form by keyword(s)",
      "description": "Search forms by keyword(s) within the organization",
      "inputs": {
        "organizationId": {
          "label": "Organization ID",
          "description": "Select the organization",
          "required": true
        },
        "limit": {
          "label": "Limit",
          "description": "Maximum number of results to return",
          "type": "number",
          "defaultValue": "100"
        },
        "search": {
          "label": "Search term",
          "description": "Keyword(s) to search for in form titles",
          "required": true
        }
      },
      "request": {
        "method": "GET",
        "url": "https://api.videoask.com/search/forms",
        "query": {
          "limit": "{{limit}}",
          "search": "{{search}}"
        },
        "headers": {
          "organization-id": "{{organizationId}}"
        }
      }
    },
    "updateContact": {
      "label": "Update contact",
      "description": "Update an existing respondent (contact) in VideoAsk",
      "inputs": {
        "organizationId": {
          "label": "Organization ID",
          "description": "Select the organization",
          "required": true
        },
        "respondentId": {
          "label": "Respondent ID",
          "description": "The ID of the respondent to update",
          "required": true
        },
        "name": {
          "label": "Name",
          "description": "The name of the contact"
        },
        "email": {
          "label": "Email",
          "description": "The email of the contact"
        },
        "phone_number": {
          "label": "Phone",
          "description": "The phone number of the contact"
        }
      },
      "request": {
        "method": "PATCH",
        "url": "https://api.videoask.com/respondents/{{respondentId}}",
        "headers": {
          "organization-id": "{{organizationId}}"
        },
        "body": {
          "name": "{{name}}",
          "email": "{{email}}",
          "phone_number": "{{phone_number}}"
        }
      }
    }
  },
  "triggers": {}
}
