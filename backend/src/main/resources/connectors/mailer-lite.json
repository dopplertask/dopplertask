{
  "name": "mailer-lite",
  "label": "MailerLite",
  "description": "Email marketing software",
  "icon": "",
  "hosts": [
    "connect.mailerlite.com"
  ],
  "upstream": {
    "package": "@activepieces/piece-mailer-lite",
    "version": "0.10.3"
  },
  "credential": {
    "fields": {
      "token": {
        "label": "API Key",
        "description": "\nTo obtain your API key, follow these steps:\n\n1. Log in to your MailerLite account.\n2. Visit the [API page](https://dashboard.mailerlite.com/integrations/api).\n3. Click the **Generate new token** button.\n4. Copy the generated API key.\n",
        "secret": true,
        "required": true
      }
    },
    "headers": {
      "authorization": "Bearer {{credential.token}}"
    }
  },
  "actions": {
    "add_subscriber_to_group": {
      "label": "Add Subscriber to Group",
      "description": "Add an existing subscriber to a group.",
      "inputs": {
        "subscriberId": {
          "label": "Subscriber",
          "required": true
        },
        "subscriberGroupId": {
          "label": "Group",
          "required": true
        }
      },
      "request": {
        "method": "POST",
        "url": "https://connect.mailerlite.com/api/subscribers/{{subscriberId}}/groups/{{subscriberGroupId}}",
        "headers": {
          "x-requested-with": "XMLHttpRequest"
        }
      }
    },
    "find_subscriber": {
      "label": "Find Subscriber",
      "description": "Find a subscriber by email or ID.",
      "inputs": {
        "searchValue": {
          "label": "Email or Subscriber ID",
          "required": true
        }
      },
      "request": {
        "method": "GET",
        "url": "https://connect.mailerlite.com/api/subscribers/{{searchValue}}",
        "headers": {
          "x-requested-with": "XMLHttpRequest"
        }
      }
    },
    "remove_subscriber_from_group": {
      "label": "Remove Subscriber from Group",
      "description": "Remove a subscriber from a group.",
      "inputs": {
        "subscriberId": {
          "label": "Subscriber",
          "required": true
        },
        "subscriberGroupId": {
          "label": "Group",
          "required": true
        }
      },
      "request": {
        "method": "DELETE",
        "url": "https://connect.mailerlite.com/api/subscribers/{{subscriberId}}/groups/{{subscriberGroupId}}",
        "headers": {
          "x-requested-with": "XMLHttpRequest"
        }
      }
    },
    "unsubscribe_subscriber": {
      "label": "Unsubscribe Subscriber",
      "description": "Set a subscriber status to unsubscribed.",
      "inputs": {
        "email": {
          "label": "Email",
          "required": true
        }
      },
      "request": {
        "method": "POST",
        "url": "https://connect.mailerlite.com/api/subscribers",
        "headers": {
          "x-requested-with": "XMLHttpRequest"
        },
        "body": {
          "email": "{{email}}",
          "status": "unsubscribed"
        }
      }
    },
    "create_group": {
      "label": "Create Group",
      "description": "Create a new group.",
      "inputs": {
        "name": {
          "label": "Group Name",
          "required": true
        }
      },
      "request": {
        "method": "POST",
        "url": "https://connect.mailerlite.com/api/groups",
        "headers": {
          "x-requested-with": "XMLHttpRequest"
        },
        "body": {
          "name": "{{name}}"
        }
      }
    },
    "forget_subscriber": {
      "label": "Forget Subscriber (GDPR)",
      "description": "Remove a subscriber and permanently erase their data (GDPR).",
      "inputs": {
        "subscriber_id": {
          "label": "Subscriber ID",
          "description": "The subscriber ID, from find_subscriber or list_subscribers.",
          "required": true
        }
      },
      "request": {
        "method": "POST",
        "url": "https://connect.mailerlite.com/api/subscribers/{{subscriber_id}}/forget"
      }
    },
    "count_subscribers": {
      "label": "Count Subscribers",
      "description": "Get the total number of subscribers in the account.",
      "inputs": {},
      "request": {
        "method": "GET",
        "url": "https://connect.mailerlite.com/api/subscribers",
        "query": {
          "limit": "0"
        }
      }
    },
    "get_import_status": {
      "label": "Get Import Status",
      "description": "Get the progress and report of a subscriber import.",
      "inputs": {
        "import_id": {
          "label": "Import ID",
          "description": "The import ID returned by import_subscribers_to_group.",
          "required": true
        }
      },
      "request": {
        "method": "GET",
        "url": "https://connect.mailerlite.com/api/subscribers/import/{{import_id}}"
      }
    },
    "rename_group": {
      "label": "Rename Group",
      "description": "Rename a subscriber group.",
      "inputs": {
        "group_id": {
          "label": "Group ID",
          "description": "The group ID, from list_groups or find_groups_by_name.",
          "required": true
        },
        "name": {
          "label": "Name",
          "description": "The new group name (max 255 characters).",
          "required": true
        }
      },
      "request": {
        "method": "PUT",
        "url": "https://connect.mailerlite.com/api/groups/{{group_id}}",
        "body": {
          "name": "{{name}}"
        }
      }
    },
    "rename_segment": {
      "label": "Rename Segment",
      "description": "Rename a segment.",
      "inputs": {
        "segment_id": {
          "label": "Segment ID",
          "description": "The segment ID, from list_segments.",
          "required": true
        },
        "name": {
          "label": "Name",
          "description": "The new segment name (max 255 characters).",
          "required": true
        }
      },
      "request": {
        "method": "PUT",
        "url": "https://connect.mailerlite.com/api/segments/{{segment_id}}",
        "body": {
          "name": "{{name}}"
        }
      }
    },
    "rename_field": {
      "label": "Rename Field",
      "description": "Rename a custom field.",
      "inputs": {
        "field_id": {
          "label": "Field ID",
          "description": "The custom field ID, from list_fields.",
          "required": true
        },
        "name": {
          "label": "Name",
          "description": "The new field name.",
          "required": true
        }
      },
      "request": {
        "method": "PUT",
        "url": "https://connect.mailerlite.com/api/fields/{{field_id}}",
        "body": {
          "name": "{{name}}"
        }
      }
    },
    "get_automation": {
      "label": "Get Automation",
      "description": "Get an automation by ID.",
      "inputs": {
        "automation_id": {
          "label": "Automation ID",
          "description": "The automation ID, from list_automations.",
          "required": true
        }
      },
      "request": {
        "method": "GET",
        "url": "https://connect.mailerlite.com/api/automations/{{automation_id}}"
      }
    },
    "create_automation": {
      "label": "Create Automation Draft",
      "description": "Create an empty, disabled automation draft.",
      "inputs": {
        "name": {
          "label": "Name",
          "description": "The automation name.",
          "required": true
        }
      },
      "request": {
        "method": "POST",
        "url": "https://connect.mailerlite.com/api/automations",
        "body": {
          "name": "{{name}}"
        }
      }
    },
    "get_campaign": {
      "label": "Get Campaign",
      "description": "Get a campaign by ID.",
      "inputs": {
        "campaign_id": {
          "label": "Campaign ID",
          "description": "The campaign ID, from list_campaigns.",
          "required": true
        }
      },
      "request": {
        "method": "GET",
        "url": "https://connect.mailerlite.com/api/campaigns/{{campaign_id}}"
      }
    },
    "create_campaign_draft": {
      "label": "Create Campaign Draft",
      "description": "Create a regular email campaign as a draft. It is never sent.",
      "inputs": {
        "name": {
          "label": "Campaign Name",
          "description": "Internal campaign name.",
          "required": true
        },
        "subject": {
          "label": "Subject",
          "description": "Email subject line.",
          "required": true
        },
        "from_name": {
          "label": "From Name",
          "description": "Sender name shown to recipients.",
          "required": true
        },
        "from": {
          "label": "From Email",
          "description": "Sender email. Must be a verified sender on the MailerLite account.",
          "required": true
        },
        "reply_to": {
          "label": "Reply-To Email",
          "description": "Reply-to email address."
        },
        "group_ids": {
          "label": "Group IDs",
          "description": "Groups to send to, from list_groups.",
          "type": "json"
        },
        "segment_ids": {
          "label": "Segment IDs",
          "description": "Segments to send to, from list_segments.",
          "type": "json"
        },
        "language_id": {
          "label": "Language ID",
          "description": "Campaign language ID, from list_campaign_languages."
        },
        "content": {
          "label": "HTML Content",
          "description": "Email HTML. Advanced plan only; omit on other plans.",
          "type": "multiline"
        }
      },
      "request": {
        "method": "POST",
        "url": "https://connect.mailerlite.com/api/campaigns",
        "body": {
          "name": "{{name}}",
          "type": "regular",
          "emails": [
            {
              "subject": "{{subject}}",
              "from_name": "{{from_name}}",
              "from": "{{from}}",
              "reply_to": "{{reply_to}}",
              "content": "{{content}}"
            }
          ],
          "language_id": "{{language_id}}"
        }
      }
    },
    "update_campaign_draft": {
      "label": "Update Campaign Draft",
      "description": "Update a draft campaign, keeping the values you do not change.",
      "inputs": {
        "campaign_id": {
          "label": "Campaign ID",
          "description": "The draft campaign ID, from list_campaigns.",
          "required": true
        },
        "name": {
          "label": "Campaign Name",
          "description": "New internal campaign name."
        },
        "subject": {
          "label": "Subject",
          "description": "New email subject line."
        },
        "from_name": {
          "label": "From Name",
          "description": "New sender name."
        },
        "from": {
          "label": "From Email",
          "description": "New sender email. Must be a verified sender on the MailerLite account."
        },
        "reply_to": {
          "label": "Reply-To Email",
          "description": "New reply-to email address."
        },
        "group_ids": {
          "label": "Group IDs",
          "description": "Replaces the audience with these groups, from list_groups. Not with Segment IDs.",
          "type": "json"
        },
        "segment_ids": {
          "label": "Segment IDs",
          "description": "Replaces the audience with these segments, from list_segments. Not with Group IDs.",
          "type": "json"
        },
        "language_id": {
          "label": "Language ID",
          "description": "Campaign language ID, from list_campaign_languages."
        },
        "content": {
          "label": "HTML Content",
          "description": "Email HTML. Advanced plan only; omit on other plans.",
          "type": "multiline"
        }
      },
      "request": {
        "method": "GET",
        "url": "https://connect.mailerlite.com/api/campaigns/{{campaign_id}}"
      }
    },
    "list_campaign_languages": {
      "label": "List Campaign Languages",
      "description": "List the languages available for campaigns.",
      "inputs": {},
      "request": {
        "method": "GET",
        "url": "https://connect.mailerlite.com/api/campaigns/languages"
      }
    },
    "get_form": {
      "label": "Get Form",
      "description": "Get a form by ID.",
      "inputs": {
        "form_id": {
          "label": "Form ID",
          "description": "The form ID, from list_forms.",
          "required": true
        }
      },
      "request": {
        "method": "GET",
        "url": "https://connect.mailerlite.com/api/forms/{{form_id}}"
      }
    },
    "get_webhook": {
      "label": "Get Webhook",
      "description": "Get a webhook by ID.",
      "inputs": {
        "webhook_id": {
          "label": "Webhook ID",
          "description": "The webhook ID, from list_webhooks.",
          "required": true
        }
      },
      "request": {
        "method": "GET",
        "url": "https://connect.mailerlite.com/api/webhooks/{{webhook_id}}"
      }
    },
    "update_webhook": {
      "label": "Update Webhook",
      "description": "Update a webhook, changing only the values you supply.",
      "inputs": {
        "webhook_id": {
          "label": "Webhook ID",
          "description": "The webhook ID, from list_webhooks.",
          "required": true
        },
        "name": {
          "label": "Name",
          "description": "New webhook name."
        },
        "url": {
          "label": "URL",
          "description": "New HTTPS URL MailerLite will POST events to."
        },
        "events": {
          "label": "Events",
          "description": "Replaces the events that trigger the webhook.",
          "type": "json",
          "options": [
            {
              "value": "subscriber.created",
              "label": "subscriber.created"
            },
            {
              "value": "subscriber.updated",
              "label": "subscriber.updated"
            },
            {
              "value": "subscriber.unsubscribed",
              "label": "subscriber.unsubscribed"
            },
            {
              "value": "subscriber.added_to_group",
              "label": "subscriber.added_to_group"
            },
            {
              "value": "subscriber.removed_from_group",
              "label": "subscriber.removed_from_group"
            },
            {
              "value": "subscriber.bounced",
              "label": "subscriber.bounced"
            },
            {
              "value": "subscriber.automation_triggered",
              "label": "subscriber.automation_triggered"
            },
            {
              "value": "subscriber.automation_completed",
              "label": "subscriber.automation_completed"
            },
            {
              "value": "subscriber.spam_reported",
              "label": "subscriber.spam_reported"
            },
            {
              "value": "subscriber.deleted",
              "label": "subscriber.deleted"
            },
            {
              "value": "subscriber.active",
              "label": "subscriber.active"
            },
            {
              "value": "campaign.sent",
              "label": "campaign.sent"
            },
            {
              "value": "campaign.click",
              "label": "campaign.click"
            },
            {
              "value": "campaign.open",
              "label": "campaign.open"
            }
          ]
        },
        "enabled": {
          "label": "Enabled",
          "description": "Whether the webhook is active.",
          "type": "select",
          "options": [
            {
              "value": "true",
              "label": "Yes"
            },
            {
              "value": "false",
              "label": "No"
            }
          ]
        },
        "batchable": {
          "label": "Batchable",
          "description": "Whether events are delivered in batches.",
          "type": "select",
          "options": [
            {
              "value": "true",
              "label": "Yes"
            },
            {
              "value": "false",
              "label": "No"
            }
          ]
        }
      },
      "request": {
        "method": "PUT",
        "url": "https://connect.mailerlite.com/api/webhooks/{{webhook_id}}",
        "body": {
          "name": "{{name}}",
          "url": "{{url}}"
        }
      }
    },
    "list_timezones": {
      "label": "List Timezones",
      "description": "List the timezones MailerLite supports.",
      "inputs": {},
      "request": {
        "method": "GET",
        "url": "https://connect.mailerlite.com/api/timezones"
      }
    }
  },
  "triggers": {}
}
