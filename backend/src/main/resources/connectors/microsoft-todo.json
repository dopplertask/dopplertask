{
  "name": "microsoft-todo",
  "label": "Microsoft To Do",
  "description": "Cloud based task management application.",
  "icon": "",
  "hosts": [
    "graph.microsoft.com"
  ],
  "upstream": {
    "package": "@activepieces/piece-microsoft-todo",
    "version": "0.5.3"
  },
  "credential": {
    "oauth2": {
      "authUrl": "https://{cloud}/common/oauth2/v2.0/authorize",
      "tokenUrl": "https://{cloud}/common/oauth2/v2.0/token",
      "scope": "Tasks.ReadWrite User.Read offline_access openid email profile"
    }
  },
  "actions": {
    "create_task": {
      "label": "Create Task",
      "description": "Creates a new task.",
      "inputs": {
        "task_list_id": {
          "label": "Task List",
          "description": "The task list to create the task in.",
          "required": true
        },
        "title": {
          "label": "Title",
          "description": "The title of the task.",
          "required": true
        },
        "body_content": {
          "label": "Body Content",
          "description": "The body or notes for the task.",
          "type": "multiline"
        },
        "importance": {
          "label": "Importance",
          "description": "The importance of the task.",
          "type": "select",
          "options": [
            {
              "value": "low",
              "label": "Low"
            },
            {
              "value": "normal",
              "label": "Normal"
            },
            {
              "value": "high",
              "label": "High"
            }
          ]
        },
        "status": {
          "label": "Status",
          "description": "The status of the task.",
          "type": "select",
          "options": [
            {
              "value": "notStarted",
              "label": "Not Started"
            },
            {
              "value": "inProgress",
              "label": "In Progress"
            },
            {
              "value": "completed",
              "label": "Completed"
            },
            {
              "value": "waitingOnOthers",
              "label": "Waiting On Others"
            },
            {
              "value": "deferred",
              "label": "Deferred"
            }
          ],
          "defaultValue": "notStarted"
        },
        "due_date_time": {
          "label": "Due Date"
        },
        "reminder_date_time": {
          "label": "Reminder Date"
        },
        "start_date_time": {
          "label": "Start Date",
          "description": "The date and time the task is scheduled to start."
        },
        "categories": {
          "label": "Categories",
          "description": "Comma-separated categories for the task (e.g., Work, Personal)."
        }
      },
      "request": {
        "method": "POST",
        "url": "https://graph.microsoft.com/v1.0/me/todo/lists/{{task_list_id}}/tasks",
        "headers": {
          "sdkversion": "graph-js/3.0.7 (featureUsage=7)"
        },
        "body": {
          "title": "{{title}}",
          "body": {
            "content": "{{body_content}}",
            "contentType": "text"
          },
          "dueDateTime": {
            "dateTime": "{{due_date_time}}",
            "timeZone": "UTC"
          },
          "isReminderOn": true,
          "reminderDateTime": {
            "dateTime": "{{reminder_date_time}}",
            "timeZone": "UTC"
          },
          "startDateTime": {
            "dateTime": "{{start_date_time}}",
            "timeZone": "UTC"
          },
          "categories": [
            "{{categories}}"
          ]
        }
      }
    },
    "create_task_list": {
      "label": "Create Task List",
      "description": "Create a new task list.",
      "inputs": {
        "displayName": {
          "label": "Title",
          "description": "The name for the new task list.",
          "required": true
        }
      },
      "request": {
        "method": "POST",
        "url": "https://graph.microsoft.com/v1.0/me/todo/lists",
        "headers": {
          "sdkversion": "graph-js/3.0.7 (featureUsage=7)"
        },
        "body": {
          "displayName": "{{displayName}}"
        }
      }
    },
    "list_task_lists": {
      "label": "List Task Lists",
      "description": "Returns a list of all task lists.",
      "inputs": {},
      "request": {
        "method": "GET",
        "url": "https://graph.microsoft.com/v1.0/me/todo/lists",
        "headers": {
          "sdkversion": "graph-js/3.0.7 (featureUsage=7)"
        }
      }
    },
    "update_task": {
      "label": "Update Task",
      "description": "Update an existing task.",
      "inputs": {
        "task_list_id": {
          "label": "Task List",
          "description": "The task list containing the task to update.",
          "required": true
        },
        "task_id": {
          "label": "Task",
          "description": "The task to update.",
          "required": true
        },
        "title": {
          "label": "Title",
          "description": "The title of the task."
        },
        "body_content": {
          "label": "Body Content",
          "description": "The body or notes for the task.",
          "type": "multiline"
        },
        "importance": {
          "label": "Importance",
          "description": "The importance of the task.",
          "type": "select",
          "options": [
            {
              "value": "low",
              "label": "Low"
            },
            {
              "value": "normal",
              "label": "Normal"
            },
            {
              "value": "high",
              "label": "High"
            }
          ]
        },
        "status": {
          "label": "Status",
          "description": "The status of the task.",
          "type": "select",
          "options": [
            {
              "value": "notStarted",
              "label": "Not Started"
            },
            {
              "value": "inProgress",
              "label": "In Progress"
            },
            {
              "value": "completed",
              "label": "Completed"
            },
            {
              "value": "waitingOnOthers",
              "label": "Waiting On Others"
            },
            {
              "value": "deferred",
              "label": "Deferred"
            }
          ]
        },
        "due_date_time": {
          "label": "Due Date"
        },
        "reminder_date_time": {
          "label": "Reminder Date"
        },
        "start_date_time": {
          "label": "Start Date",
          "description": "The date and time the task is scheduled to start."
        },
        "categories": {
          "label": "Categories",
          "description": "Comma-separated categories for the task (e.g., Work, Personal)."
        }
      },
      "request": {
        "method": "PATCH",
        "url": "https://graph.microsoft.com/v1.0/me/todo/lists/{{task_list_id}}/tasks/{{task_id}}",
        "headers": {
          "sdkversion": "graph-js/3.0.7 (featureUsage=7)"
        },
        "body": {
          "title": "{{title}}",
          "body": {
            "content": "{{body_content}}",
            "contentType": "text"
          },
          "dueDateTime": {
            "dateTime": "{{due_date_time}}",
            "timeZone": "UTC"
          },
          "isReminderOn": true,
          "reminderDateTime": {
            "dateTime": "{{reminder_date_time}}",
            "timeZone": "UTC"
          },
          "startDateTime": {
            "dateTime": "{{start_date_time}}",
            "timeZone": "UTC"
          },
          "categories": [
            "{{categories}}"
          ]
        }
      }
    },
    "update_task_list": {
      "label": "Update Task List",
      "description": "Updates an existing task list.",
      "inputs": {
        "task_list_id": {
          "label": "Task List",
          "description": "The task list to update.",
          "required": true
        },
        "displayName": {
          "label": "New Name",
          "description": "The new name for the task list.",
          "required": true
        }
      },
      "request": {
        "method": "PATCH",
        "url": "https://graph.microsoft.com/v1.0/me/todo/lists/{{task_list_id}}",
        "headers": {
          "sdkversion": "graph-js/3.0.7 (featureUsage=7)"
        },
        "body": {
          "displayName": "{{displayName}}"
        }
      }
    },
    "complete_task": {
      "label": "Complete Task",
      "description": "Marks a task as completed.",
      "inputs": {
        "task_list_id": {
          "label": "Task List",
          "description": "The task list containing the task you want to complete.",
          "required": true
        },
        "task_id": {
          "label": "Task",
          "description": "The specific task to mark as complete.",
          "required": true
        }
      },
      "request": {
        "method": "PATCH",
        "url": "https://graph.microsoft.com/v1.0/me/todo/lists/{{task_list_id}}/tasks/{{task_id}}",
        "headers": {
          "sdkversion": "graph-js/3.0.7 (featureUsage=7)"
        },
        "body": {
          "status": "completed",
          "completedDateTime": {
            "dateTime": "2026-11-09T22:21:57.172Z",
            "timeZone": "UTC"
          }
        }
      }
    },
    "get_task": {
      "label": "Get Task",
      "description": "Gets the details of a specific task.",
      "inputs": {
        "task_list_id": {
          "label": "Task List",
          "description": "The list containing the task you want to retrieve.",
          "required": true
        },
        "task_id": {
          "label": "Task",
          "description": "The specific task to retrieve.",
          "required": true
        }
      },
      "request": {
        "method": "GET",
        "url": "https://graph.microsoft.com/v1.0/me/todo/lists/{{task_list_id}}/tasks/{{task_id}}",
        "headers": {
          "sdkversion": "graph-js/3.0.7 (featureUsage=7)"
        }
      }
    },
    "microsoft_todo_list_checklist_items": {
      "label": "List Checklist Items",
      "description": "List the checklist items (steps) of a task.",
      "inputs": {
        "list_id": {
          "label": "Task List ID",
          "description": "ID of the task list, from List Task Lists or Create Task List.",
          "required": true
        },
        "task_id": {
          "label": "Task ID",
          "description": "ID of the task, from List Tasks or Create Task.",
          "required": true
        }
      },
      "request": {
        "method": "GET",
        "url": "https://graph.microsoft.com/v1.0/me/todo/lists/{{list_id}}/tasks/{{task_id}}/checklistItems",
        "headers": {
          "sdkversion": "graph-js/3.0.7 (featureUsage=7)"
        }
      }
    },
    "microsoft_todo_list_linked_resources": {
      "label": "List Linked Resources",
      "description": "List the linked resources (source links) of a task.",
      "inputs": {
        "list_id": {
          "label": "Task List ID",
          "description": "ID of the task list, from List Task Lists or Create Task List.",
          "required": true
        },
        "task_id": {
          "label": "Task ID",
          "description": "ID of the task, from List Tasks or Create Task.",
          "required": true
        }
      },
      "request": {
        "method": "GET",
        "url": "https://graph.microsoft.com/v1.0/me/todo/lists/{{list_id}}/tasks/{{task_id}}/linkedResources",
        "headers": {
          "sdkversion": "graph-js/3.0.7 (featureUsage=7)"
        }
      }
    },
    "microsoft_todo_list_task_attachments": {
      "label": "List Task Attachments",
      "description": "List the files attached to a task.",
      "inputs": {
        "list_id": {
          "label": "Task List ID",
          "description": "ID of the task list, from List Task Lists or Create Task List.",
          "required": true
        },
        "task_id": {
          "label": "Task ID",
          "description": "ID of the task, from List Tasks or Create Task.",
          "required": true
        }
      },
      "request": {
        "method": "GET",
        "url": "https://graph.microsoft.com/v1.0/me/todo/lists/{{list_id}}/tasks/{{task_id}}/attachments",
        "headers": {
          "sdkversion": "graph-js/3.0.7 (featureUsage=7)"
        }
      }
    },
    "microsoft_todo_search_tasks": {
      "label": "Search Tasks in All Lists",
      "description": "Find tasks by title and status across every task list.",
      "inputs": {
        "title": {
          "label": "Title",
          "description": "Only return tasks whose title matches this text."
        },
        "match_type": {
          "label": "Match Type",
          "description": "How Title is matched. Defaults to Contains.",
          "type": "select",
          "options": [
            {
              "value": "contains",
              "label": "Contains"
            },
            {
              "value": "startsWith",
              "label": "Starts With"
            },
            {
              "value": "exact",
              "label": "Exact Match"
            }
          ]
        },
        "status": {
          "label": "Status",
          "description": "Only return tasks with this status.",
          "type": "select",
          "options": [
            {
              "value": "notStarted",
              "label": "Not Started"
            },
            {
              "value": "inProgress",
              "label": "In Progress"
            },
            {
              "value": "completed",
              "label": "Completed"
            },
            {
              "value": "waitingOnOthers",
              "label": "Waiting On Others"
            },
            {
              "value": "deferred",
              "label": "Deferred"
            }
          ]
        },
        "limit": {
          "label": "Limit",
          "description": "Maximum number of tasks to return (1-200). Defaults to 50.",
          "type": "number"
        }
      },
      "request": {
        "method": "GET",
        "url": "https://graph.microsoft.com/v1.0/me/todo/lists",
        "headers": {
          "sdkversion": "graph-js/3.0.7 (featureUsage=7)"
        }
      }
    }
  },
  "triggers": {}
}
