{
  "name": "quickbase",
  "label": "Quickbase",
  "description": "",
  "icon": "",
  "hosts": [
    "api.quickbase.com"
  ],
  "upstream": {
    "package": "@activepieces/piece-quickbase",
    "version": "0.2.2"
  },
  "credential": {
    "fields": {
      "realmHostname": {
        "label": "Realm Hostname",
        "description": "Enter your Quickbase Realm Hostname (e.g., yourrealm.quickbase.com). The host only, without https://, such as name.example.com.",
        "required": true
      },
      "userToken": {
        "label": "User Token",
        "description": "Enter your Quickbase User Token",
        "required": true
      }
    },
    "headers": {
      "authorization": "QB-USER-TOKEN {{credential.userToken}}",
      "qb-realm-hostname": "https://{{credential.realmHostname}}"
    }
  },
  "actions": {
    "create_record": {
      "label": "Create Record",
      "description": "Create a new record in a Quickbase table",
      "inputs": {
        "appId": {
          "label": "App",
          "description": "Select the Quickbase app",
          "required": true
        },
        "tableId": {
          "label": "Table",
          "description": "Select the table",
          "required": true
        }
      },
      "request": {
        "method": "GET",
        "url": "https://api.quickbase.com/v1/fields",
        "query": {
          "tableId": "{{tableId}}"
        }
      }
    },
    "update_record": {
      "label": "Update Record",
      "description": "Update an existing record in a Quickbase table",
      "inputs": {
        "appId": {
          "label": "App",
          "description": "Select the Quickbase app",
          "required": true
        },
        "tableId": {
          "label": "Table",
          "description": "Select the table",
          "required": true
        },
        "recordId": {
          "label": "Record",
          "description": "Select a record from the table",
          "required": true
        }
      },
      "request": {
        "method": "GET",
        "url": "https://api.quickbase.com/v1/fields",
        "query": {
          "tableId": "{{tableId}}"
        }
      }
    },
    "find_record": {
      "label": "Find Record",
      "description": "Search for records in a Quickbase table using filters",
      "inputs": {
        "appId": {
          "label": "App",
          "description": "Select the Quickbase app",
          "required": true
        },
        "tableId": {
          "label": "Table",
          "description": "Select the table",
          "required": true
        },
        "filters": {
          "label": "Filters",
          "description": "Filter criteria to find records. Use field names or field IDs as keys.",
          "type": "json"
        },
        "sortField": {
          "label": "Sort Field",
          "description": "Field to sort records by (optional)"
        },
        "sortOrder": {
          "label": "Sort Order",
          "description": "Order to sort records",
          "type": "select",
          "options": [
            {
              "value": "ASC",
              "label": "Ascending (A-Z, 1-9)"
            },
            {
              "value": "DESC",
              "label": "Descending (Z-A, 9-1)"
            }
          ],
          "defaultValue": "ASC"
        },
        "maxRecords": {
          "label": "Maximum Records",
          "description": "Maximum number of records to return",
          "type": "number",
          "defaultValue": "100"
        }
      },
      "request": {
        "method": "GET",
        "url": "https://api.quickbase.com/v1/fields",
        "query": {
          "tableId": "{{tableId}}"
        }
      }
    }
  },
  "triggers": {}
}
