{
  "name": "gameball",
  "label": "Gameball",
  "description": "",
  "icon": "",
  "hosts": [
    "api.gameball.co"
  ],
  "upstream": {
    "package": "@activepieces/piece-gameball",
    "version": "0.1.6"
  },
  "credential": {
    "fields": {
      "token": {
        "label": "API Key",
        "description": "Please use your gameball api key. visit [help center](https://help.gameball.co/en/articles/3467114-get-your-account-integration-details-api-key-and-transaction-key) for more information",
        "secret": true,
        "required": true
      }
    },
    "headers": {
      "apikey": "{{credential.token}}"
    }
  },
  "actions": {
    "sendEvent": {
      "label": "Send event",
      "description": "Send an event to gameball",
      "inputs": {
        "playerUniqueId": {
          "label": "Your Player Unique Id",
          "required": true
        },
        "eventName": {
          "label": "Event Name",
          "required": true
        }
      },
      "request": {
        "method": "POST",
        "url": "https://api.gameball.co/api/v3.0/integrations/event",
        "body": {
          "playerUniqueId": "{{playerUniqueId}}",
          "events": {
            "sample001z": {}
          }
        }
      }
    }
  },
  "triggers": {}
}
