{
  "name": "mindee",
  "label": "Mindee",
  "description": "Document automation API",
  "icon": "",
  "hosts": [
    "api-v2.mindee.net"
  ],
  "upstream": {
    "package": "@activepieces/piece-mindee",
    "version": "0.4.2"
  },
  "credential": {
    "fields": {
      "token": {
        "label": "API Key",
        "description": "To get your API key:\n1. Sign in to the Mindee platform at [app.mindee.com](https://app.mindee.com).\n2. Open **API Keys** and create a key.\n3. Copy the key and paste it here.\n\nKeys from the legacy platform (platform.mindee.com) only work with the **Predict Document (Legacy v1)** action.",
        "secret": true,
        "required": true
      }
    },
    "headers": {
      "authorization": "{{credential.token}}"
    }
  },
  "actions": {
    "get_job_status": {
      "label": "Get Job Status",
      "description": "Checks whether a Mindee job has finished and returns its inference ID.",
      "inputs": {
        "job_id": {
          "label": "Job ID",
          "required": true
        }
      },
      "request": {
        "method": "GET",
        "url": "https://api-v2.mindee.net/v2/jobs/{{job_id}}",
        "query": {
          "redirect": "false"
        }
      }
    },
    "get_result": {
      "label": "Get Result",
      "description": "Gets the result of a finished Mindee inference.",
      "inputs": {
        "product": {
          "label": "Product",
          "description": "The Mindee product that ran the inference.",
          "required": true,
          "type": "select",
          "options": [
            {
              "value": "extraction",
              "label": "Extraction"
            },
            {
              "value": "classification",
              "label": "Classification"
            },
            {
              "value": "crop",
              "label": "Crop"
            },
            {
              "value": "ocr",
              "label": "OCR"
            },
            {
              "value": "split",
              "label": "Split"
            }
          ],
          "defaultValue": "extraction"
        },
        "inference_id": {
          "label": "Inference ID",
          "required": true
        }
      },
      "request": {
        "method": "GET",
        "url": "https://api-v2.mindee.net/v2/products/undefined/results/{{inference_id}}"
      }
    },
    "get_rag_document": {
      "label": "Get RAG Document",
      "description": "Gets a RAG document of an extraction model.",
      "inputs": {
        "document_id": {
          "label": "RAG Document ID",
          "required": true
        }
      },
      "request": {
        "method": "GET",
        "url": "https://api-v2.mindee.net/v2/products/extraction/rag-documents/{{document_id}}"
      }
    }
  },
  "triggers": {}
}
