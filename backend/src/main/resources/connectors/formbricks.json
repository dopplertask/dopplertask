{
  "name": "formbricks",
  "label": "Formbricks",
  "description": "Open source Survey Platform",
  "icon": "",
  "hosts": [
    "{{credential.appUrl}}"
  ],
  "upstream": {
    "package": "@activepieces/piece-formbricks",
    "version": "0.4.1"
  },
  "credential": {
    "fields": {
      "appUrl": {
        "label": "App URL",
        "description": "The host only, without https://, such as name.example.com.",
        "required": true
      },
      "apiKey": {
        "label": "API Key",
        "description": "",
        "secret": true,
        "required": true
      }
    },
    "headers": {
      "x-api-key": "{{credential.apiKey}}"
    }
  },
  "actions": {
    "list_surveys": {
      "label": "List Surveys",
      "description": "Lists the surveys in a workspace, optionally only those with a given status. Scans up to 1,000 surveys; \"More Available\" is true when the list may be incomplete.",
      "inputs": {
        "workspaceId": {
          "label": "Workspace",
          "description": "Only list surveys from this workspace. Leave empty for every workspace the API key can access."
        },
        "status": {
          "label": "Status",
          "description": "Only list surveys with this status.",
          "type": "select",
          "options": [
            {
              "value": "draft",
              "label": "draft"
            },
            {
              "value": "scheduled",
              "label": "scheduled"
            },
            {
              "value": "inProgress",
              "label": "inProgress"
            },
            {
              "value": "paused",
              "label": "paused"
            },
            {
              "value": "completed",
              "label": "completed"
            }
          ]
        },
        "limit": {
          "label": "Limit",
          "description": "Maximum number of surveys to return (1 to 500).",
          "type": "number",
          "defaultValue": "100"
        }
      },
      "request": {
        "method": "GET",
        "url": "https://{{credential.appUrl}}/api/v1/management/surveys",
        "query": {
          "limit": "100",
          "offset": "0"
        }
      }
    },
    "get_survey": {
      "label": "Get Survey",
      "description": "Gets a survey with its questions and their IDs.",
      "inputs": {
        "workspaceId": {
          "label": "Workspace",
          "description": "Narrows the survey list. Optional."
        },
        "surveyId": {
          "label": "Survey",
          "description": "Pick the survey.",
          "required": true
        }
      },
      "request": {
        "method": "GET",
        "url": "https://{{credential.appUrl}}/api/v1/management/surveys/{{surveyId}}"
      }
    },
    "get_response": {
      "label": "Get Response",
      "description": "Gets a single survey response by its ID.",
      "inputs": {
        "responseId": {
          "label": "Response ID",
          "description": "From a Formbricks trigger or List Responses.",
          "required": true
        }
      },
      "request": {
        "method": "GET",
        "url": "https://{{credential.appUrl}}/api/v2/management/responses/{{responseId}}"
      }
    },
    "find_contact": {
      "label": "Find Contact",
      "description": "Finds a contact by email or user ID.",
      "inputs": {
        "workspaceId": {
          "label": "Workspace",
          "description": "The Formbricks workspace (project) to use.",
          "required": true
        },
        "email": {
          "label": "Email",
          "description": "Fill in the email or the user ID."
        },
        "userId": {
          "label": "User ID"
        }
      },
      "request": {
        "method": "GET",
        "url": "https://{{credential.appUrl}}/api/v1/management/contact-attribute-keys"
      }
    },
    "list_contact_attribute_keys": {
      "label": "List Contact Attribute Keys",
      "description": "Lists the contact attributes (email, user ID and custom ones) defined in Formbricks.",
      "inputs": {
        "workspaceId": {
          "label": "Workspace ID",
          "description": "Only keys of this workspace. Leave empty for all."
        }
      },
      "request": {
        "method": "GET",
        "url": "https://{{credential.appUrl}}/api/v1/management/contact-attribute-keys"
      }
    },
    "create_contact_attribute_key": {
      "label": "Create Contact Attribute Key",
      "description": "Adds a custom contact attribute, such as plan or company.",
      "inputs": {
        "workspaceId": {
          "label": "Workspace",
          "description": "The Formbricks workspace (project) to use.",
          "required": true
        },
        "key": {
          "label": "Key",
          "description": "Letters, numbers and underscores, for example company_size.",
          "required": true
        },
        "name": {
          "label": "Display Name"
        },
        "description": {
          "label": "Description",
          "type": "multiline"
        }
      },
      "request": {
        "method": "POST",
        "url": "https://{{credential.appUrl}}/api/v2/management/contact-attribute-keys",
        "body": {
          "workspaceId": "{{workspaceId}}",
          "key": "{{key}}",
          "name": "{{name}}",
          "description": "{{description}}"
        }
      }
    },
    "list_action_classes": {
      "label": "List Actions",
      "description": "Lists the user actions (action classes) that can trigger in-app surveys.",
      "inputs": {
        "workspaceId": {
          "label": "Workspace ID",
          "description": "Only actions of this workspace. Leave empty for all."
        }
      },
      "request": {
        "method": "GET",
        "url": "https://{{credential.appUrl}}/api/v1/management/action-classes"
      }
    },
    "list_surveys_ai": {
      "label": "List Surveys (AI)",
      "description": "Lists Formbricks surveys by workspace ID and status.",
      "inputs": {
        "workspaceId": {
          "label": "Workspace ID",
          "description": "Only surveys from this workspace. Empty for all workspaces."
        },
        "status": {
          "label": "Status",
          "type": "select",
          "options": [
            {
              "value": "draft",
              "label": "draft"
            },
            {
              "value": "scheduled",
              "label": "scheduled"
            },
            {
              "value": "inProgress",
              "label": "inProgress"
            },
            {
              "value": "paused",
              "label": "paused"
            },
            {
              "value": "completed",
              "label": "completed"
            }
          ]
        },
        "limit": {
          "label": "Limit",
          "description": "Maximum number of surveys to return (1 to 500, default 100).",
          "type": "number"
        }
      },
      "request": {
        "method": "GET",
        "url": "https://{{credential.appUrl}}/api/v1/management/surveys",
        "query": {
          "limit": "100",
          "offset": "0"
        }
      }
    },
    "get_survey_ai": {
      "label": "Get Survey (AI)",
      "description": "Gets a Formbricks survey by ID.",
      "inputs": {
        "surveyId": {
          "label": "Survey ID",
          "required": true
        }
      },
      "request": {
        "method": "GET",
        "url": "https://{{credential.appUrl}}/api/v1/management/surveys/{{surveyId}}"
      }
    },
    "find_contact_ai": {
      "label": "Find Contact (AI)",
      "description": "Finds a Formbricks contact by email or user ID in a workspace ID.",
      "inputs": {
        "workspaceId": {
          "label": "Workspace ID",
          "required": true
        },
        "email": {
          "label": "Email"
        },
        "userId": {
          "label": "User ID"
        }
      },
      "request": {
        "method": "GET",
        "url": "https://{{credential.appUrl}}/api/v1/management/contact-attribute-keys"
      }
    },
    "create_contact_attribute_key_ai": {
      "label": "Create Contact Attribute Key (AI)",
      "description": "Creates a custom contact attribute key in a workspace ID.",
      "inputs": {
        "workspaceId": {
          "label": "Workspace ID",
          "required": true
        },
        "key": {
          "label": "Key",
          "required": true
        },
        "name": {
          "label": "Display Name"
        },
        "description": {
          "label": "Description"
        }
      },
      "request": {
        "method": "POST",
        "url": "https://{{credential.appUrl}}/api/v2/management/contact-attribute-keys",
        "body": {
          "workspaceId": "{{workspaceId}}",
          "key": "{{key}}",
          "name": "{{name}}",
          "description": "{{description}}"
        }
      }
    }
  },
  "triggers": {}
}
