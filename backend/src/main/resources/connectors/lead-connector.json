{
  "name": "lead-connector",
  "label": "LeadConnector",
  "description": "Lead Connector - Go High Level",
  "icon": "",
  "hosts": [
    "services.leadconnectorhq.com"
  ],
  "upstream": {
    "package": "@activepieces/piece-lead-connector",
    "version": "0.4.3"
  },
  "credential": {
    "oauth2": {
      "authUrl": "https://marketplace.gohighlevel.com/oauth/chooselocation",
      "tokenUrl": "https://services.leadconnectorhq.com/oauth/token",
      "scope": "campaigns.readonly contacts.write contacts.readonly locations.readonly locations/tags.readonly locations/tags.write opportunities.readonly opportunities.write users.readonly workflows.readonly forms.readonly"
    }
  },
  "actions": {
    "add_contact_to_campaign": {
      "label": "Add Contact to Campaign",
      "description": "Add an existing contact to a campaign.",
      "inputs": {
        "contact": {
          "label": "Contact",
          "required": true
        },
        "campaign": {
          "label": "Campaign",
          "required": true
        }
      },
      "request": {
        "method": "POST",
        "url": "https://services.leadconnectorhq.com/contacts/{{contact}}/campaigns/{{campaign}}",
        "headers": {
          "version": "2021-07-28"
        }
      }
    },
    "add_contact_to_workflow": {
      "label": "Add Contact to Workflow",
      "description": "Add an existing contact to a workflow.",
      "inputs": {
        "contact": {
          "label": "Contact",
          "required": true
        },
        "workflow": {
          "label": "Workflow",
          "required": true
        }
      },
      "request": {
        "method": "POST",
        "url": "https://services.leadconnectorhq.com/contacts/{{contact}}/workflow/{{workflow}}",
        "headers": {
          "version": "2021-07-28"
        }
      }
    },
    "add_note_to_contact": {
      "label": "Add Note to Contact",
      "description": "Add a new note to a contact.",
      "inputs": {
        "contact": {
          "label": "Contact",
          "required": true
        },
        "note": {
          "label": "Note",
          "required": true
        },
        "user": {
          "label": "Author",
          "description": "The team member the note is credited to.",
          "required": true
        }
      },
      "request": {
        "method": "POST",
        "url": "https://services.leadconnectorhq.com/contacts/{{contact}}/notes/",
        "headers": {
          "version": "2021-07-28"
        },
        "body": {
          "body": "{{note}}",
          "userId": "{{user}}"
        }
      }
    },
    "search_contacts": {
      "label": "Search Contacts",
      "description": "Search for contacts with a search query.",
      "inputs": {
        "query": {
          "label": "Search Query",
          "description": "Matched against name, email, phone and more. Up to 100 results.",
          "required": true
        }
      },
      "request": {
        "method": "GET",
        "url": "https://services.leadconnectorhq.com/contacts/",
        "query": {
          "limit": "100",
          "locationId": "undefined",
          "query": "{{query}}"
        },
        "headers": {
          "version": "2021-07-28"
        }
      }
    },
    "create_opportunity": {
      "label": "Create Opportunity",
      "description": "Create a new opportunity.",
      "inputs": {
        "pipeline": {
          "label": "Pipeline",
          "required": true
        },
        "stage": {
          "label": "Stage",
          "required": true
        },
        "title": {
          "label": "Opportunity Name",
          "required": true
        },
        "contact": {
          "label": "Contact",
          "required": true
        },
        "status": {
          "label": "Status",
          "required": true
        },
        "monetaryValue": {
          "label": "Value",
          "description": "In your account's currency.",
          "type": "number"
        },
        "assignedTo": {
          "label": "Assigned To",
          "description": "Leave empty to keep it unassigned."
        }
      },
      "request": {
        "method": "POST",
        "url": "https://services.leadconnectorhq.com/opportunities/",
        "headers": {
          "version": "2021-07-28"
        },
        "body": {
          "pipelineStageId": "{{stage}}",
          "contactId": "{{contact}}",
          "status": "{{status}}",
          "name": "{{title}}",
          "pipelineId": "{{pipeline}}",
          "assignedTo": "{{assignedTo}}",
          "monetaryValue": "{{monetaryValue}}"
        }
      }
    },
    "update_opportunity": {
      "label": "Update Opportunity",
      "description": "Updates an existing opportunity.",
      "inputs": {
        "pipeline": {
          "label": "Pipeline",
          "required": true
        },
        "opportunity": {
          "label": "Opportunity",
          "required": true
        },
        "stage": {
          "label": "Stage"
        },
        "title": {
          "label": "Opportunity Name"
        },
        "contact": {
          "label": "Contact"
        },
        "status": {
          "label": "Status"
        },
        "monetaryValue": {
          "label": "Value",
          "description": "In your account's currency.",
          "type": "number"
        },
        "assignedTo": {
          "label": "Assigned To"
        }
      },
      "request": {
        "method": "PUT",
        "url": "https://services.leadconnectorhq.com/opportunities/{{opportunity}}",
        "headers": {
          "version": "2021-07-28"
        },
        "body": {
          "pipelineId": "{{pipeline}}",
          "pipelineStageId": "{{stage}}",
          "status": "{{status}}",
          "name": "{{title}}",
          "contactId": "{{contact}}",
          "assignedTo": "{{assignedTo}}",
          "monetaryValue": "{{monetaryValue}}"
        }
      }
    }
  },
  "triggers": {}
}
