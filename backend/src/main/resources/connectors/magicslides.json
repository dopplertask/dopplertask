{
  "name": "magicslides",
  "label": "MagicSlides",
  "description": "Create PowerPoint presentations from topics, summaries, or YouTube videos using AI.",
  "icon": "",
  "hosts": [
    "api.magicslides.app"
  ],
  "upstream": {
    "package": "@activepieces/piece-magicslides",
    "version": "0.1.7"
  },
  "credential": {
    "fields": {
      "accessId": {
        "label": "Access ID",
        "description": "Enter your MagicSlides Access ID",
        "required": true
      },
      "email": {
        "label": "Email",
        "description": "Enter your registered email address.",
        "required": true
      }
    },
    "body": {
      "accessId": "{{credential.accessId}}",
      "email": "{{credential.email}}"
    }
  },
  "actions": {
    "createPptFromTopic": {
      "label": "Create PPT from Topic",
      "description": "Generates a PPT presentation from a given topic.",
      "inputs": {
        "topic": {
          "label": "Topic",
          "required": true
        },
        "slideCount": {
          "label": "Number of slides",
          "type": "number",
          "defaultValue": "10"
        },
        "language": {
          "label": "Language",
          "type": "select",
          "options": [
            {
              "value": "en",
              "label": "English"
            },
            {
              "value": "hi",
              "label": "Hindi"
            },
            {
              "value": "es",
              "label": "Spanish"
            },
            {
              "value": "fr",
              "label": "French"
            },
            {
              "value": "de",
              "label": "German"
            },
            {
              "value": "zh",
              "label": "Chinese"
            }
          ],
          "defaultValue": "en"
        },
        "template": {
          "label": "Template",
          "type": "select",
          "options": [
            {
              "value": "bullet-point1",
              "label": "Bullet Point 1 (default)"
            },
            {
              "value": "bullet-point2",
              "label": "Bullet Point 2"
            },
            {
              "value": "bullet-point4",
              "label": "Bullet Point 4"
            },
            {
              "value": "bullet-point5",
              "label": "Bullet Point 5"
            },
            {
              "value": "bullet-point6",
              "label": "Bullet Point 6"
            },
            {
              "value": "bullet-point7",
              "label": "Bullet Point 7"
            },
            {
              "value": "bullet-point8",
              "label": "Bullet Point 8"
            },
            {
              "value": "bullet-point9",
              "label": "Bullet Point 9"
            },
            {
              "value": "bullet-point10",
              "label": "Bullet Point 10"
            },
            {
              "value": "pitchdeckorignal",
              "label": "Pitch Deck Original"
            },
            {
              "value": "pitch-deck-2",
              "label": "Pitch Deck 2"
            },
            {
              "value": "pitch-deck-3",
              "label": "Pitch Deck 3"
            },
            {
              "value": "custom2",
              "label": "Custom 2"
            },
            {
              "value": "custom3",
              "label": "Custom 3"
            },
            {
              "value": "verticalBulletPoint1",
              "label": "Vertical Bullet Point 1"
            },
            {
              "value": "verticalCustom1",
              "label": "Vertical Custom 1"
            }
          ],
          "defaultValue": "bullet-point1"
        },
        "model": {
          "label": "AI Model",
          "type": "select",
          "options": [
            {
              "value": "gpt-4",
              "label": "GPT-4"
            },
            {
              "value": "gpt-3.5",
              "label": "GPT-3.5"
            }
          ],
          "defaultValue": "gpt-4"
        },
        "extraInfoSource": {
          "label": "Extra Information Source",
          "description": "Provide a URL or text to give additional context for the presentation."
        },
        "aiImages": {
          "label": "Use AI Images",
          "type": "boolean",
          "defaultValue": "false"
        },
        "imageForEachSlide": {
          "label": "Image for Each Slide",
          "type": "boolean",
          "defaultValue": "true"
        },
        "googleImage": {
          "label": "Use Google Images",
          "type": "boolean",
          "defaultValue": "false"
        },
        "googleText": {
          "label": "Use Google Text",
          "type": "boolean",
          "defaultValue": "false"
        },
        "include_images": {
          "label": "Include images",
          "type": "boolean",
          "defaultValue": "true"
        },
        "presentationFor": {
          "label": "Presentation For (Audience)"
        },
        "watermark": {
          "label": "Watermark",
          "description": "Add a watermark to the presentation. e.g., {\"width\": \"48\", \"height\": \"48\", \"brandURL\": \"https://...png\", \"position\": \"BottomRight\"}",
          "type": "json"
        }
      },
      "request": {
        "method": "POST",
        "url": "https://api.magicslides.app/public/api/ppt_from_topic",
        "body": {
          "topic": "{{topic}}",
          "slideCount": "{{slideCount}}",
          "presentationFor": "{{presentationFor}}",
          "extraInfoSource": "{{extraInfoSource}}"
        }
      }
    },
    "createPptFromText": {
      "label": "Create PPT from Text/Summary",
      "description": "Generates a PPT presentation from provided text or summary.",
      "inputs": {
        "msSummaryText": {
          "label": "Summary Text",
          "required": true,
          "type": "multiline"
        },
        "slideCount": {
          "label": "Number of Slides",
          "type": "number",
          "defaultValue": "10"
        },
        "language": {
          "label": "Language",
          "type": "select",
          "options": [
            {
              "value": "en",
              "label": "English"
            },
            {
              "value": "hi",
              "label": "Hindi"
            },
            {
              "value": "es",
              "label": "Spanish"
            },
            {
              "value": "fr",
              "label": "French"
            },
            {
              "value": "de",
              "label": "German"
            },
            {
              "value": "zh",
              "label": "Chinese"
            }
          ],
          "defaultValue": "en"
        },
        "template": {
          "label": "Template",
          "type": "select",
          "options": [
            {
              "value": "bullet-point1",
              "label": "Bullet Point 1 (default)"
            },
            {
              "value": "bullet-point2",
              "label": "Bullet Point 2"
            },
            {
              "value": "bullet-point4",
              "label": "Bullet Point 4"
            },
            {
              "value": "bullet-point5",
              "label": "Bullet Point 5"
            },
            {
              "value": "bullet-point6",
              "label": "Bullet Point 6"
            },
            {
              "value": "bullet-point7",
              "label": "Bullet Point 7"
            },
            {
              "value": "bullet-point8",
              "label": "Bullet Point 8"
            },
            {
              "value": "bullet-point9",
              "label": "Bullet Point 9"
            },
            {
              "value": "bullet-point10",
              "label": "Bullet Point 10"
            },
            {
              "value": "pitchdeckorignal",
              "label": "Pitch Deck Original"
            },
            {
              "value": "pitch-deck-2",
              "label": "Pitch Deck 2"
            },
            {
              "value": "pitch-deck-3",
              "label": "Pitch Deck 3"
            },
            {
              "value": "custom2",
              "label": "Custom 2"
            },
            {
              "value": "custom3",
              "label": "Custom 3"
            },
            {
              "value": "verticalBulletPoint1",
              "label": "Vertical Bullet Point 1"
            },
            {
              "value": "verticalCustom1",
              "label": "Vertical Custom 1"
            }
          ],
          "defaultValue": "bullet-point1"
        },
        "model": {
          "label": "AI Model",
          "type": "select",
          "options": [
            {
              "value": "gpt-4",
              "label": "GPT-4"
            },
            {
              "value": "gpt-3.5",
              "label": "GPT-3.5"
            }
          ],
          "defaultValue": "gpt-4"
        },
        "aiImages": {
          "label": "Use AI Images",
          "type": "boolean",
          "defaultValue": "false"
        },
        "imageForEachSlide": {
          "label": "Image for Each Slide",
          "type": "boolean",
          "defaultValue": "true"
        },
        "googleImage": {
          "label": "Use Google Images",
          "type": "boolean",
          "defaultValue": "false"
        },
        "googleText": {
          "label": "Use Google Text",
          "type": "boolean",
          "defaultValue": "false"
        },
        "presentationFor": {
          "label": "Presentation For (Audience)"
        },
        "watermark": {
          "label": "Watermark",
          "description": "Optional watermark e.g., {\"width\":\"48\",\"height\":\"48\",\"brandURL\":\"https://...png\",\"position\":\"BottomRight\"}",
          "type": "json"
        }
      },
      "request": {
        "method": "POST",
        "url": "https://api.magicslides.app/public/api/ppt_from_summery",
        "body": {
          "msSummaryText": "{{msSummaryText}}",
          "slideCount": "{{slideCount}}",
          "presentationFor": "{{presentationFor}}"
        }
      }
    },
    "createPptFromYoutube": {
      "label": "Create PPT from YouTube Video",
      "description": "Generates a PPT presentation from a YouTube video link.",
      "inputs": {
        "youtubeURL": {
          "label": "YouTube Video URL",
          "required": true
        },
        "template": {
          "label": "Template",
          "type": "select",
          "options": [
            {
              "value": "bullet-point1",
              "label": "Bullet Point 1"
            },
            {
              "value": "bullet-point2",
              "label": "Bullet Point 2"
            },
            {
              "value": "bullet-point4",
              "label": "Bullet Point 4"
            },
            {
              "value": "pitch-deck-3",
              "label": "Pitch Deck 3"
            },
            {
              "value": "pitch-deck-2",
              "label": "Pitch Deck 2"
            },
            {
              "value": "custom Dark 1",
              "label": "Custom Dark 1"
            },
            {
              "value": "verticalBulletPoint1",
              "label": "Vertical Bullet Point 1"
            }
          ],
          "defaultValue": "bullet-point1"
        },
        "language": {
          "label": "Language",
          "defaultValue": "en"
        },
        "slideCount": {
          "label": "Number of slides",
          "type": "number",
          "defaultValue": "10"
        },
        "aiImages": {
          "label": "Enable AI Images",
          "type": "boolean",
          "defaultValue": "false"
        },
        "imageForEachSlide": {
          "label": "Include Image on Every Slide",
          "type": "boolean",
          "defaultValue": "true"
        },
        "googleImage": {
          "label": "Use Google Images",
          "type": "boolean",
          "defaultValue": "false"
        },
        "googleText": {
          "label": "Enhance Content with Google Search",
          "type": "boolean",
          "defaultValue": "false"
        },
        "model": {
          "label": "AI Model",
          "type": "select",
          "options": [
            {
              "value": "gpt-4",
              "label": "GPT-4"
            },
            {
              "value": "gpt-3.5",
              "label": "GPT-3.5"
            }
          ],
          "defaultValue": "gpt-4"
        },
        "presentationFor": {
          "label": "Presentation For (Audience)"
        },
        "watermark": {
          "label": "Watermark",
          "description": "Optional watermark e.g., {\"width\":\"48\",\"height\":\"48\",\"brandURL\":\"https://...png\",\"position\":\"BottomRight\"}",
          "type": "json"
        }
      },
      "request": {
        "method": "POST",
        "url": "https://api.magicslides.app/public/api/ppt_from_youtube",
        "body": {
          "youtubeURL": "{{youtubeURL}}",
          "language": "{{language}}",
          "slideCount": "{{slideCount}}",
          "presentationFor": "{{presentationFor}}"
        }
      }
    }
  },
  "triggers": {}
}
