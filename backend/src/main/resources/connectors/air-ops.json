{
  "name": "air-ops",
  "label": "AirOps",
  "description": "Build and deploy AI-powered workflows and agents.",
  "icon": "",
  "hosts": [
    "api.airops.com"
  ],
  "upstream": {
    "package": "@activepieces/piece-air-ops",
    "version": "0.2.2"
  },
  "credential": {
    "fields": {
      "token": {
        "label": "API Key",
        "description": "Your API key can be found in the **Workspace Settings** section of your AirOps account.",
        "secret": true,
        "required": true
      }
    },
    "headers": {
      "authorization": "Bearer {{credential.token}}"
    }
  },
  "actions": {
    "run_workflow": {
      "label": "Run Workflow",
      "description": "Execute an AirOps workflow synchronously.",
      "inputs": {
        "app": {
          "label": "Workflow",
          "description": "Select the workflow to execute.",
          "required": true
        },
        "inputs": {
          "label": "Inputs",
          "description": "Input values for the workflow.",
          "type": "json"
        },
        "inputs_schema": {
          "label": "Inputs Schema",
          "description": "Schema defining the workflow inputs (advanced).",
          "type": "json"
        },
        "definition": {
          "label": "Definition",
          "description": "Custom workflow definition steps (advanced).",
          "type": "json"
        }
      },
      "request": {
        "method": "POST",
        "url": "https://api.airops.com/public_api/airops_apps/{{app}}/execute_definition",
        "body": {}
      }
    },
    "run_workflow_async": {
      "label": "Run Workflow (Async)",
      "description": "Queue an AirOps workflow for asynchronous execution.",
      "inputs": {
        "app": {
          "label": "Workflow",
          "description": "Select the workflow to execute.",
          "required": true
        },
        "inputs": {
          "label": "Inputs",
          "description": "Input values for the workflow.",
          "type": "json"
        },
        "inputs_schema": {
          "label": "Inputs Schema",
          "description": "Schema defining the workflow inputs (advanced).",
          "type": "json"
        },
        "definition": {
          "label": "Definition",
          "description": "Custom workflow definition steps (advanced).",
          "type": "json"
        }
      },
      "request": {
        "method": "POST",
        "url": "https://api.airops.com/public_api/airops_apps/{{app}}/async_execute_definition",
        "body": {}
      }
    },
    "get_execution": {
      "label": "Get Execution",
      "description": "Get an execution by UUID.",
      "inputs": {
        "app": {
          "label": "Workflow",
          "description": "Select the workflow.",
          "required": true
        },
        "execution_uuid": {
          "label": "Execution UUID",
          "description": "The UUID of the execution to retrieve.",
          "required": true
        }
      },
      "request": {
        "method": "GET",
        "url": "https://api.airops.com/public_api/airops_apps/{{app}}/executions"
      }
    }
  },
  "triggers": {}
}
