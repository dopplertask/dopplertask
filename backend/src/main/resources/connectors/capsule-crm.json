{
  "name": "capsule-crm",
  "label": "Capsule CRM",
  "description": "",
  "icon": "",
  "hosts": [
    "api.capsulecrm.com"
  ],
  "upstream": {
    "package": "@activepieces/piece-capsule-crm",
    "version": "0.1.7"
  },
  "credential": {
    "oauth2": {
      "authUrl": "https://api.capsulecrm.com/oauth/authorise",
      "tokenUrl": "https://api.capsulecrm.com/oauth/token",
      "scope": "read write"
    }
  },
  "actions": {
    "create_task": {
      "label": "Create Task",
      "description": "Create a new Task in Capsule CRM.",
      "inputs": {
        "description": {
          "label": "Description",
          "description": "A short description of the task.",
          "required": true
        },
        "dueOn": {
          "label": "Due Date",
          "description": "The date when this task is due.",
          "required": true
        },
        "detail": {
          "label": "Details",
          "description": "More details about the task.",
          "type": "multiline"
        },
        "dueTime": {
          "label": "Due Time",
          "description": "The time when this task is due (e.g., 18:00:00). Note: The time is in the user's timezone."
        },
        "linkTo": {
          "label": "Link To",
          "description": "The entity this task is linked to. Only one can be selected.",
          "type": "select",
          "options": [
            {
              "value": "party",
              "label": "Party (Contact)"
            },
            {
              "value": "opportunity",
              "label": "Opportunity"
            },
            {
              "value": "project",
              "label": "Project"
            }
          ]
        },
        "categoryId": {
          "label": "Category",
          "description": "The category of this task."
        },
        "ownerId": {
          "label": "Owner",
          "description": "The user this task is assigned to."
        }
      },
      "request": {
        "method": "POST",
        "url": "https://api.capsulecrm.com/api/v2/tasks",
        "body": {
          "task": {
            "description": "{{description}}",
            "dueOn": "{{dueOn}}",
            "detail": "{{detail}}",
            "dueTime": "{{dueTime}}",
            "category": {
              "id": "{{categoryId}}"
            },
            "owner": {
              "id": "{{ownerId}}"
            }
          }
        }
      }
    },
    "update_opportunity": {
      "label": "Update Opportunity",
      "description": "Update an existing Opportunity in Capsule CRM.",
      "inputs": {
        "opportunityId": {
          "label": "Opportunity",
          "required": true
        },
        "name": {
          "label": "Name"
        },
        "description": {
          "label": "Description",
          "type": "multiline"
        },
        "milestoneId": {
          "label": "Milestone"
        },
        "currency": {
          "label": "Currency"
        },
        "amount": {
          "label": "Amount",
          "type": "number"
        },
        "expectedCloseOn": {
          "label": "Expected Close Date"
        },
        "probability": {
          "label": "Probability",
          "type": "number"
        },
        "durationBasis": {
          "label": "Duration Basis",
          "type": "select",
          "options": [
            {
              "value": "FIXED",
              "label": "Fixed"
            },
            {
              "value": "HOUR",
              "label": "Hour"
            },
            {
              "value": "DAY",
              "label": "Day"
            },
            {
              "value": "WEEK",
              "label": "Week"
            },
            {
              "value": "MONTH",
              "label": "Month"
            },
            {
              "value": "QUARTER",
              "label": "Quarter"
            },
            {
              "value": "YEAR",
              "label": "Year"
            }
          ]
        },
        "duration": {
          "label": "Duration",
          "type": "number"
        },
        "ownerId": {
          "label": "Owner"
        },
        "teamId": {
          "label": "Team"
        }
      },
      "request": {
        "method": "PUT",
        "url": "https://api.capsulecrm.com/api/v2/opportunities/{{opportunityId}}",
        "body": {
          "opportunity": {
            "name": "{{name}}",
            "description": "{{description}}",
            "expectedCloseOn": "{{expectedCloseOn}}",
            "probability": "{{probability}}",
            "duration": "{{duration}}",
            "owner": {
              "id": "{{ownerId}}"
            },
            "team": {
              "id": "{{teamId}}"
            },
            "milestone": {
              "id": "{{milestoneId}}"
            },
            "value": {
              "currency": "{{currency}}",
              "amount": "{{amount}}"
            }
          }
        }
      }
    },
    "find_contact": {
      "label": "Find Contact",
      "description": "Find a Person by search criteria.",
      "inputs": {
        "term": {
          "label": "Search Term",
          "description": "The value to search for (e.g., a name or email).",
          "required": true
        }
      },
      "request": {
        "method": "GET",
        "url": "https://api.capsulecrm.com/api/v2/parties/search",
        "query": {
          "q": "{{term}}"
        }
      }
    }
  },
  "triggers": {}
}
