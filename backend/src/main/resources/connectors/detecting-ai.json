{
  "name": "detecting-ai",
  "label": "DETECTING-AI.COM",
  "description": "",
  "icon": "",
  "hosts": [
    "api.detecting-ai.com"
  ],
  "upstream": {
    "package": "@activepieces/piece-detecting-ai",
    "version": "0.1.1"
  },
  "credential": {
    "fields": {
      "token": {
        "label": "API Key",
        "description": "You can obtain your API key from the [DETECTING-AI.COM Dashboard](https://detecting-ai.com) in the API section.",
        "secret": true,
        "required": true
      }
    },
    "headers": {
      "x-api-key": "{{credential.token}}"
    }
  },
  "actions": {
    "detect_ai_content": {
      "label": "Detect AI Content",
      "description": "Detect AI-generated content in text",
      "inputs": {
        "text": {
          "label": "Text",
          "required": true,
          "type": "multiline"
        },
        "version": {
          "label": "Version",
          "required": true,
          "type": "select",
          "options": [
            {
              "value": "v1",
              "label": "v1"
            },
            {
              "value": "v2",
              "label": "v2"
            }
          ],
          "defaultValue": "v2"
        }
      },
      "request": {
        "method": "POST",
        "url": "https://api.detecting-ai.com/api/detect/",
        "body": {
          "text": "{{text}}"
        }
      }
    },
    "check_plagiarism": {
      "label": "Check Plagiarism",
      "description": "Check text for plagiarism",
      "inputs": {
        "text": {
          "label": "Text",
          "required": true,
          "type": "multiline"
        }
      },
      "request": {
        "method": "POST",
        "url": "https://api.detecting-ai.com/api/plagiarism/",
        "body": {
          "text": "{{text}}"
        }
      }
    },
    "humanize_text": {
      "label": "Humanize Text",
      "description": "Humanize text to make it sound more natural",
      "inputs": {
        "text": {
          "label": "Text",
          "required": true,
          "type": "multiline"
        },
        "model": {
          "label": "Model",
          "required": true,
          "type": "select",
          "options": [
            {
              "value": "cognia",
              "label": "cognia"
            },
            {
              "value": "lexi",
              "label": "lexi"
            }
          ],
          "defaultValue": "lexi"
        }
      },
      "request": {
        "method": "POST",
        "url": "https://api.detecting-ai.com/api/humanize/",
        "body": {
          "text": "{{text}}"
        }
      }
    }
  },
  "triggers": {}
}
