{
  "name": "bokio",
  "label": "Bokio",
  "description": "Bokio is an accounting software platform which offers digital bookkeeping, invoicing, and financial management tools to help simplify accounting processes.",
  "icon": "",
  "hosts": [
    "api.bokio.se"
  ],
  "upstream": {
    "package": "@activepieces/piece-bokio",
    "version": "0.1.1"
  },
  "credential": {
    "fields": {
      "companyId": {
        "label": "Company ID",
        "description": "Enter your Bokio Company ID ",
        "required": true
      },
      "api_key": {
        "label": "API Key",
        "description": "Enter your Bokio API Key",
        "required": true
      }
    },
    "headers": {
      "authorization": "Bearer {{credential.api_key}}"
    }
  },
  "actions": {
    "createAJournalEntry": {
      "label": "Create a journal entry",
      "description": "Creates a new journal entry in Bokio",
      "inputs": {
        "title": {
          "label": "Title",
          "description": "Title of the journal entry"
        },
        "date": {
          "label": "Date",
          "description": "Journal entry date (YYYY-MM-DD)",
          "required": true
        },
        "items": {
          "label": "Items (JSON)",
          "description": "Journal entry items as JSON array. Each item should have: account (account number), debit (optional), credit (optional)",
          "type": "json"
        }
      },
      "request": {
        "method": "POST",
        "url": "https://api.bokio.se/v1/companies/{{credential.companyId}}/journal-entries",
        "body": {
          "date": "{{date}}",
          "title": "{{title}}"
        }
      }
    },
    "findCustomer": {
      "label": "Find Customer",
      "description": "Find customers in Bokio by filtering and pagination",
      "inputs": {
        "filterType": {
          "label": "Filter Type",
          "description": "Type of filter to use",
          "type": "select",
          "options": [
            {
              "value": "name",
              "label": "Name"
            },
            {
              "value": "type",
              "label": "Type"
            },
            {
              "value": "vatNumber",
              "label": "VAT Number"
            },
            {
              "value": "orgNumber",
              "label": "Organization Number"
            }
          ]
        },
        "filterValue": {
          "label": "Filter Value",
          "description": "Value to filter by"
        },
        "page": {
          "label": "Page",
          "description": "Page number (defaults to 1)",
          "type": "number"
        },
        "pageSize": {
          "label": "Page Size",
          "description": "Number of items per page (max 100, defaults to 25)",
          "type": "number"
        }
      },
      "request": {
        "method": "GET",
        "url": "https://api.bokio.se/v1/companies/{{credential.companyId}}/customers",
        "query": {
          "page": "{{page}}",
          "pageSize": "{{pageSize}}"
        }
      }
    },
    "getAnInvoice": {
      "label": "Get an invoice",
      "description": "Retrieve a specific invoice by its ID",
      "inputs": {
        "invoiceId": {
          "label": "Invoice ID",
          "description": "The ID of the invoice to retrieve",
          "required": true
        }
      },
      "request": {
        "method": "GET",
        "url": "https://api.bokio.se/v1/companies/{{credential.companyId}}/invoices/{{invoiceId}}"
      }
    },
    "getAJournalEntry": {
      "label": "Get a journal entry",
      "description": "Retrieve a specific journal entry by its ID",
      "inputs": {
        "journalEntryId": {
          "label": "Journal Entry ID",
          "description": "UUID of the journal entry",
          "required": true
        }
      },
      "request": {
        "method": "GET",
        "url": "https://api.bokio.se/v1/companies/{{credential.companyId}}/journal-entries/{{journalEntryId}}"
      }
    }
  },
  "triggers": {}
}
