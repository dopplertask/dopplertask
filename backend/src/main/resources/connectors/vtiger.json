{
  "name": "vtiger",
  "label": "Vtiger",
  "description": "CRM software for sales, marketing, and support teams",
  "icon": "",
  "hosts": [
    "{{credential.instance_url}}"
  ],
  "upstream": {
    "package": "@activepieces/piece-vtiger",
    "version": "1.5.2"
  },
  "credential": {
    "fields": {
      "instance_url": {
        "label": "VTiger Instance URL",
        "description": "For the instance URL, add the url without the endpoint. For example enter https://<instance>.od2.vtiger.com instead of https://<instance>.od2.vtiger.com/restapi/v1/vtiger/default. The host only, without https://, such as name.example.com.",
        "required": true
      },
      "username": {
        "label": "Username",
        "description": "Enter your username/email",
        "required": true
      },
      "password": {
        "label": "Access Key",
        "description": "Enter your access Key",
        "secret": true,
        "required": true
      }
    },
    "query": {
      "username": "{{credential.username}}"
    }
  },
  "actions": {
    "create_record": {
      "label": "Create Record",
      "description": "Create a Record",
      "inputs": {
        "elementType": {
          "label": "Module Type",
          "description": "The module / element type",
          "required": true
        }
      },
      "request": {
        "method": "GET",
        "url": "https://{{credential.instance_url}}/webservice.php",
        "query": {
          "operation": "getchallenge"
        }
      }
    },
    "query_records": {
      "label": "Query Records",
      "description": "Query records by SQL statement.",
      "inputs": {
        "query": {
          "label": "Query",
          "description": "Enter the query statement, e.g. SELECT count(*) FROM Contacts; Add LIMIT offset, count to page through large results.",
          "required": true,
          "type": "multiline"
        }
      },
      "request": {
        "method": "GET",
        "url": "https://{{credential.instance_url}}/webservice.php",
        "query": {
          "operation": "getchallenge"
        }
      }
    },
    "search_records": {
      "label": "Search Records",
      "description": "Search for a record.",
      "inputs": {
        "elementType": {
          "label": "Module Type",
          "description": "The module / element type",
          "required": true
        },
        "limit": {
          "label": "Limit",
          "description": "Enter the maximum number of records to return (default and maximum 1000).",
          "type": "number"
        }
      },
      "request": {
        "method": "GET",
        "url": "https://{{credential.instance_url}}/webservice.php",
        "query": {
          "operation": "getchallenge"
        }
      }
    }
  },
  "triggers": {}
}
