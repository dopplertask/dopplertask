{
  "name": "serpstat",
  "label": "Serpstat",
  "description": "",
  "icon": "",
  "hosts": [
    "api.serpstat.com"
  ],
  "upstream": {
    "package": "@activepieces/piece-serpstat",
    "version": "0.2.1"
  },
  "credential": {
    "fields": {
      "token": {
        "label": "API Token",
        "description": "You can obtain your API token from your Serpstat account. Go to your Serpstat dashboard and navigate to API settings to get your token.",
        "secret": true,
        "required": true
      }
    },
    "query": {
      "token": "{{credential.token}}"
    }
  },
  "actions": {
    "get_keywords": {
      "label": "Get Keywords",
      "description": "Get keywords data from Serpstat > Keyword Analysis.",
      "inputs": {
        "query": {
          "label": "Query",
          "description": "The search query to find keywords for",
          "required": true
        },
        "se": {
          "label": "Search Engine",
          "description": "Search engine to use for keyword analysis",
          "required": true,
          "type": "select",
          "options": [
            {
              "value": "g_us",
              "label": "United States"
            },
            {
              "value": "g_sg",
              "label": "Singapore"
            },
            {
              "value": "g_id",
              "label": "Indonesia"
            },
            {
              "value": "g_my",
              "label": "Malaysia"
            },
            {
              "value": "g_vn",
              "label": "Vietnam"
            },
            {
              "value": "g_th",
              "label": "Thailand"
            }
          ],
          "defaultValue": "g_us"
        },
        "minusKeywords": {
          "label": "Minus Keywords",
          "description": "List of keywords to exclude from the search",
          "type": "json"
        },
        "withIntents": {
          "label": "With Intents",
          "description": "Include keyword intent (works for g_au and g_us only)",
          "type": "boolean"
        },
        "sortField": {
          "label": "Sort Field",
          "description": "Field to sort by (any numeric fields in response data)",
          "type": "select",
          "options": [
            {
              "value": "region_queries_count",
              "label": "Region Queries Count"
            },
            {
              "value": "search_volume",
              "label": "Search Volume"
            },
            {
              "value": "cpc",
              "label": "CPC"
            },
            {
              "value": "competition",
              "label": "Competition"
            },
            {
              "value": "results_count",
              "label": "Results Count"
            }
          ],
          "defaultValue": "region_queries_count"
        },
        "sortOrder": {
          "label": "Sort Order",
          "description": "Sort direction",
          "type": "select",
          "options": [
            {
              "value": "desc",
              "label": "Descending"
            },
            {
              "value": "asc",
              "label": "Ascending"
            }
          ],
          "defaultValue": "desc"
        },
        "size": {
          "label": "Size",
          "description": "Number of results to return (max 100)",
          "type": "number",
          "defaultValue": "10"
        },
        "page": {
          "label": "Page",
          "description": "Page number for pagination",
          "type": "number",
          "defaultValue": "1"
        },
        "filters": {
          "label": "Filters",
          "description": "See the docs for syntax - https://api-docs.serpstat.com/docs/serpstat-public-api/w7jh5sk9kc0cm-get-keywords",
          "type": "json"
        }
      },
      "request": {
        "method": "POST",
        "url": "https://api.serpstat.com/v4/",
        "body": {
          "id": "653e0bc7-c17c-4d69-b75f-7652be04ecd6",
          "method": "SerpstatKeywordProcedure.getKeywords",
          "params": {
            "keyword": "{{query}}",
            "page": "{{page}}",
            "size": "{{size}}"
          }
        }
      }
    },
    "get_suggestions": {
      "label": "Get Suggestions",
      "description": "Get keyword suggestions from Serpstat > Keyword Analysis.",
      "inputs": {
        "keyword": {
          "label": "Keyword",
          "description": "The keyword to get suggestions for.",
          "required": true
        },
        "se": {
          "label": "Search Engine",
          "description": "Search engine to use for suggestions.",
          "required": true,
          "type": "select",
          "options": [
            {
              "value": "g_us",
              "label": "United States"
            },
            {
              "value": "g_sg",
              "label": "Singapore"
            },
            {
              "value": "g_id",
              "label": "Indonesia"
            },
            {
              "value": "g_my",
              "label": "Malaysia"
            },
            {
              "value": "g_vn",
              "label": "Vietnam"
            },
            {
              "value": "g_th",
              "label": "Thailand"
            }
          ],
          "defaultValue": "g_us"
        },
        "filters": {
          "label": "Filters",
          "description": "See the docs for syntax - https://api-docs.serpstat.com/docs/serpstat-public-api/mmd9zlcqjaoe4-get-suggestions",
          "type": "json"
        },
        "page": {
          "label": "Page",
          "description": "Page number in response.",
          "type": "number",
          "defaultValue": "1"
        },
        "size": {
          "label": "Size",
          "description": "Number of results per page in response.",
          "type": "number",
          "defaultValue": "100"
        }
      },
      "request": {
        "method": "POST",
        "url": "https://api.serpstat.com/v4/",
        "body": {
          "id": "eed7c08e-6dd3-47b5-8116-5e526a6d76a1",
          "method": "SerpstatKeywordProcedure.getSuggestions",
          "params": {
            "keyword": "{{keyword}}",
            "page": "{{page}}",
            "size": "{{size}}"
          }
        }
      }
    }
  },
  "triggers": {}
}
