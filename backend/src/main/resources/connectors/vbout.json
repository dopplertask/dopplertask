{
  "name": "vbout",
  "label": "VBOUT",
  "description": "Marketing automation platform for agencies",
  "icon": "",
  "hosts": [
    "api.vbout.com"
  ],
  "upstream": {
    "package": "@activepieces/piece-vbout",
    "version": "0.1.7"
  },
  "credential": {
    "fields": {
      "token": {
        "label": "API Key",
        "description": "\nTo obtain your API key, follow these steps:\n\n1.Go to **settings** by clicking your profile-pic (top-right).\n\n2.Navigate to **API Integrations** section.\n\n3.Under **API USER KEY** ,copy API key.\n\n",
        "secret": true,
        "required": true
      }
    },
    "query": {
      "key": "{{credential.token}}"
    }
  },
  "actions": {
    "vbout_create_email_list": {
      "label": "Create Email List",
      "description": "Creates a new email list.",
      "inputs": {
        "name": {
          "label": "Name",
          "description": "The name of the list.",
          "required": true
        },
        "email_subject": {
          "label": "Email Subject",
          "description": "The default subscription subject.",
          "type": "multiline"
        },
        "reply_to": {
          "label": "Reply To",
          "description": "The Reply to email of the list."
        },
        "fromemail": {
          "label": "From Email",
          "description": "The From email of the list."
        },
        "from_name": {
          "label": "From Name",
          "description": "The From name of the list."
        },
        "notify_email": {
          "label": "Notify Email",
          "description": "Notification Email."
        },
        "success_email": {
          "label": "Success Email",
          "description": "Subscription Success Email."
        },
        "success_message": {
          "label": "Success Message",
          "description": "Subscription Success Message."
        },
        "error_message": {
          "label": "Error Message",
          "description": "Subscription Error Message."
        },
        "confirmation_email": {
          "label": "Confirmation Email",
          "description": "Confirmation Email Message."
        },
        "confirmation_message": {
          "label": "Confirmation Message"
        }
      },
      "request": {
        "method": "POST",
        "url": "https://api.vbout.com/1/emailMarketing/AddList",
        "body": {
          "name": "{{name}}",
          "email_subject": "{{email_subject}}",
          "reply_to": "{{reply_to}}",
          "fromemail": "{{fromemail}}",
          "from_name": "{{from_name}}",
          "notify_email": "{{notify_email}}",
          "success_email": "{{success_email}}",
          "success_message": "{{success_message}}",
          "error_message": "{{error_message}}",
          "confirmation_email": "{{confirmation_email}}",
          "confirmation_message": "{{confirmation_message}}"
        }
      }
    },
    "vbout_get_contact_by_email": {
      "label": "Get Contact by Email",
      "description": "Retrieves the contact by email.",
      "inputs": {
        "listid": {
          "label": "List ID"
        },
        "email": {
          "label": "Email",
          "required": true
        }
      },
      "request": {
        "method": "GET",
        "url": "https://api.vbout.com/1/emailmarketing/getcontactbyemail",
        "query": {
          "email": "{{email}}",
          "listid": "{{listid}}"
        }
      }
    },
    "vbout_get_email_list": {
      "label": "Get List Details with Custom Fields",
      "description": "Retrieves specific list details with custom fields.",
      "inputs": {
        "listid": {
          "label": "List ID",
          "required": true
        }
      },
      "request": {
        "method": "GET",
        "url": "https://api.vbout.com/1/emailmarketing/getlist",
        "query": {
          "id": "{{listid}}"
        }
      }
    },
    "vbout_remove_tag": {
      "label": "Remove Tags from Contact",
      "description": "Removes tags from an existing contact.",
      "inputs": {
        "email": {
          "label": "Email Address",
          "required": true
        },
        "tagname": {
          "label": "Tag Name",
          "description": "use comma for multiple tag e.g. **tag1,tag2**.",
          "required": true
        }
      },
      "request": {
        "method": "DELETE",
        "url": "https://api.vbout.com/1/emailMarketing/RemoveTag",
        "query": {
          "email": "{{email}}",
          "tagname": "{{tagname}}"
        }
      }
    },
    "vbout_unsubscribe_contact": {
      "label": "Unsubscribe Contact",
      "description": "Unsubscribes an existing contact in a given email list.",
      "inputs": {
        "email": {
          "label": "Contact Email",
          "description": "Contact email for update.",
          "required": true
        },
        "listid": {
          "label": "List ID",
          "required": true
        }
      },
      "request": {
        "method": "GET",
        "url": "https://api.vbout.com/1/emailmarketing/getcontactbyemail",
        "query": {
          "email": "{{email}}",
          "listid": "{{listid}}"
        }
      }
    },
    "vbout_update_contact": {
      "label": "Update Contact",
      "description": "Updates a contact in a given email list.",
      "inputs": {
        "email": {
          "label": "Contact Email",
          "description": "Contact email for update.",
          "required": true
        },
        "listid": {
          "label": "List ID",
          "required": true
        },
        "status": {
          "label": "Contact Status",
          "type": "select",
          "options": [
            {
              "value": "0",
              "label": "Unconfirmed"
            },
            {
              "value": "1",
              "label": "Active"
            },
            {
              "value": "2",
              "label": "Unsubscribe"
            },
            {
              "value": "3",
              "label": "Bounced Email"
            }
          ]
        },
        "ipaddress": {
          "label": "IP Address"
        }
      },
      "request": {
        "method": "GET",
        "url": "https://api.vbout.com/1/emailmarketing/getcontactbyemail",
        "query": {
          "email": "{{email}}"
        }
      }
    }
  },
  "triggers": {}
}
