{
  "name": "octopush-sms",
  "label": "Octopush SMS",
  "description": "Send bulk messaging for your promotions, order tracking, appointment reminders, voice messages, one-time passwords (OTP), 2-way chat sms and much more!",
  "icon": "",
  "hosts": [
    "api.octopush.com"
  ],
  "upstream": {
    "package": "@activepieces/piece-octopush-sms",
    "version": "0.2.1"
  },
  "credential": {
    "fields": {
      "api_login": {
        "label": "API Login",
        "description": " Your Octopush API Login",
        "required": true
      },
      "api_key": {
        "label": "API Key",
        "description": " Your Octopush API Key",
        "secret": true,
        "required": true
      }
    },
    "headers": {
      "api-key": "{{credential.api_key}}",
      "api-login": "{{credential.api_login}}"
    }
  },
  "actions": {
    "addContact": {
      "label": "Add Contact",
      "description": "Add one or more contacts to a contact list",
      "inputs": {
        "phone_number": {
          "label": "Phone Number",
          "description": "The phone number in international format (e.g., +33612345678)",
          "required": true
        },
        "first_name": {
          "label": "First Name",
          "description": "First name of the contact"
        },
        "last_name": {
          "label": "Last Name",
          "description": "Last name of the contact"
        },
        "email": {
          "label": "Email",
          "description": "Email address of the contact"
        },
        "list_name": {
          "label": "List Name",
          "description": "Name of the contact list to add the contact to (optional, max 30 chars)"
        },
        "tag_name": {
          "label": "Tag Name",
          "description": "Tag to attach to the contact (optional, max 20 chars)"
        },
        "do_not_overwrite": {
          "label": "Do Not Overwrite",
          "description": "If enabled, will skip the contact if it already exists instead of updating it",
          "type": "boolean",
          "defaultValue": "false"
        },
        "auto_remove_blacklisted": {
          "label": "Auto Remove Blacklisted",
          "description": "If enabled, blacklisted numbers will be automatically removed from the list",
          "type": "boolean",
          "defaultValue": "false"
        }
      },
      "request": {
        "method": "POST",
        "url": "https://api.octopush.com/v1/public/contact/create",
        "body": {
          "contacts": [
            {
              "phone_number": "{{phone_number}}",
              "first_name": "{{first_name}}",
              "last_name": "{{last_name}}",
              "email": "{{email}}"
            }
          ],
          "list_name": "{{list_name}}",
          "tag_name": "{{tag_name}}"
        }
      }
    },
    "sendANewSms": {
      "label": "Send a New SMS",
      "description": "Send an SMS message to one or more recipients",
      "inputs": {
        "phone_number": {
          "label": "Phone Number",
          "description": "Recipient phone number in international format (e.g., +33612345678)",
          "required": true
        },
        "first_name": {
          "label": "First Name",
          "description": "Recipient first name (optional)"
        },
        "last_name": {
          "label": "Last Name",
          "description": "Recipient last name (optional)"
        },
        "message": {
          "label": "Message Text",
          "description": "The SMS message content (1-1224 characters)",
          "required": true,
          "type": "multiline"
        },
        "sender": {
          "label": "Sender ID",
          "description": "Sender name/ID (3-11 alphanumeric characters)",
          "required": true
        },
        "purpose": {
          "label": "Purpose",
          "description": "Type of SMS campaign",
          "type": "select",
          "options": [
            {
              "value": "alert",
              "label": "Alert"
            },
            {
              "value": "transactional",
              "label": "Transactional"
            },
            {
              "value": "marketing",
              "label": "Marketing"
            },
            {
              "value": "wholesale",
              "label": "Wholesale"
            }
          ]
        },
        "send_at": {
          "label": "Send At",
          "description": "Schedule sending time in ISO8601 format (e.g., 2024-12-25T10:30:00+01:00) - optional"
        },
        "with_replies": {
          "label": "Enable Replies",
          "description": "Enable to receive recipient replies",
          "type": "boolean",
          "defaultValue": "false"
        }
      },
      "request": {
        "method": "POST",
        "url": "https://api.octopush.com/v1/public/sms-campaign/send",
        "body": {
          "text": "{{message}}",
          "recipients": [
            {
              "phone_number": "{{phone_number}}",
              "first_name": "{{first_name}}",
              "last_name": "{{last_name}}"
            }
          ],
          "sender": "{{sender}}",
          "send_at": "{{send_at}}"
        }
      }
    }
  },
  "triggers": {}
}
