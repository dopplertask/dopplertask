{
  "name": "umami",
  "label": "Umami",
  "description": "Privacy-focused, open-source web analytics.",
  "icon": "",
  "hosts": [
    "{{credential.baseUrl}}"
  ],
  "upstream": {
    "package": "@activepieces/piece-umami",
    "version": "0.3.2"
  },
  "credential": {
    "fields": {
      "baseUrl": {
        "label": "Instance URL",
        "description": "Base URL of your Umami instance (e.g. `https://umami.example.com`). Do not include a trailing slash. The host only, without https://, such as name.example.com.",
        "required": true
      },
      "username": {
        "label": "Username",
        "description": "Your Umami login username.",
        "required": true
      },
      "password": {
        "label": "Password",
        "description": "Your Umami login password.",
        "secret": true,
        "required": true
      }
    }
  },
  "actions": {
    "get_website_stats": {
      "label": "Get Website Stats",
      "description": "Returns a summary of visitors, pageviews, bounce rate, and average visit duration for a date range.",
      "inputs": {
        "websiteId": {
          "label": "Website",
          "description": "Select the website to use.",
          "required": true
        },
        "startDate": {
          "label": "Start Date",
          "description": "Beginning of the date range.",
          "required": true
        },
        "endDate": {
          "label": "End Date",
          "description": "End of the date range.",
          "required": true
        }
      },
      "request": {
        "method": "GET",
        "url": "https://{{credential.baseUrl}}/api/websites/{{websiteId}}/stats",
        "query": {
          "startAt": "NaN",
          "endAt": "NaN"
        },
        "headers": {
          "authorization": "Bearer undefined"
        }
      }
    },
    "get_website_metrics": {
      "label": "Get Website Metrics",
      "description": "Returns a ranked list for a chosen metric category (e.g. top pages, browsers, or countries) over a date range.",
      "inputs": {
        "websiteId": {
          "label": "Website",
          "description": "Select the website to use.",
          "required": true
        },
        "startDate": {
          "label": "Start Date",
          "description": "Beginning of the date range.",
          "required": true
        },
        "endDate": {
          "label": "End Date",
          "description": "End of the date range.",
          "required": true
        },
        "type": {
          "label": "Metric",
          "description": "Which metric to rank results by.",
          "required": true,
          "type": "select",
          "options": [
            {
              "value": "url",
              "label": "Pages"
            },
            {
              "value": "referrer",
              "label": "Referrers"
            },
            {
              "value": "browser",
              "label": "Browsers"
            },
            {
              "value": "os",
              "label": "Operating Systems"
            },
            {
              "value": "device",
              "label": "Devices"
            },
            {
              "value": "country",
              "label": "Countries"
            },
            {
              "value": "region",
              "label": "Regions"
            },
            {
              "value": "city",
              "label": "Cities"
            },
            {
              "value": "language",
              "label": "Languages"
            },
            {
              "value": "screen",
              "label": "Screen Sizes"
            },
            {
              "value": "event",
              "label": "Events"
            },
            {
              "value": "title",
              "label": "Page Titles"
            },
            {
              "value": "tag",
              "label": "Tags"
            },
            {
              "value": "host",
              "label": "Hosts"
            },
            {
              "value": "query",
              "label": "Query Parameters"
            }
          ],
          "defaultValue": "url"
        },
        "limit": {
          "label": "Max Results",
          "description": "Maximum number of results to return.",
          "type": "number",
          "defaultValue": "500"
        }
      },
      "request": {
        "method": "GET",
        "url": "https://{{credential.baseUrl}}/api/websites/{{websiteId}}/metrics",
        "query": {
          "startAt": "NaN",
          "endAt": "NaN",
          "type": "undefined",
          "limit": "{{limit}}"
        },
        "headers": {
          "authorization": "Bearer undefined"
        }
      }
    },
    "get_active_visitors": {
      "label": "Get Active Visitors",
      "description": "Returns the number of people currently browsing a website in real time.",
      "inputs": {
        "websiteId": {
          "label": "Website",
          "description": "Select the website to use.",
          "required": true
        }
      },
      "request": {
        "method": "GET",
        "url": "https://{{credential.baseUrl}}/api/websites/{{websiteId}}/active",
        "headers": {
          "authorization": "Bearer undefined"
        }
      }
    },
    "get_pageviews": {
      "label": "Get Pageviews",
      "description": "Returns pageview and session counts over time, broken down by hour, day, week, month, or year.",
      "inputs": {
        "websiteId": {
          "label": "Website",
          "description": "Select the website to use.",
          "required": true
        },
        "startDate": {
          "label": "Start Date",
          "description": "Beginning of the date range.",
          "required": true
        },
        "endDate": {
          "label": "End Date",
          "description": "End of the date range.",
          "required": true
        },
        "unit": {
          "label": "Group By",
          "description": "How to bucket the results over time.",
          "type": "select",
          "options": [
            {
              "value": "hour",
              "label": "Hour"
            },
            {
              "value": "day",
              "label": "Day"
            },
            {
              "value": "week",
              "label": "Week"
            },
            {
              "value": "month",
              "label": "Month"
            },
            {
              "value": "year",
              "label": "Year"
            }
          ],
          "defaultValue": "day"
        },
        "timezone": {
          "label": "Timezone",
          "description": "Timezone for date grouping, e.g. Europe/Paris or America/New_York. Defaults to UTC.",
          "defaultValue": "UTC"
        }
      },
      "request": {
        "method": "GET",
        "url": "https://{{credential.baseUrl}}/api/websites/{{websiteId}}/pageviews",
        "query": {
          "startAt": "NaN",
          "endAt": "NaN",
          "unit": "day",
          "timezone": "{{timezone}}"
        },
        "headers": {
          "authorization": "Bearer undefined"
        }
      }
    },
    "list_websites": {
      "label": "List Websites",
      "description": "Returns all websites tracked in your Umami account.",
      "inputs": {
        "limit": {
          "label": "Max Results",
          "description": "Maximum number of websites to return.",
          "type": "number",
          "defaultValue": "100"
        }
      },
      "request": {
        "method": "GET",
        "url": "https://{{credential.baseUrl}}/api/websites",
        "query": {
          "pageSize": "{{limit}}"
        },
        "headers": {
          "authorization": "Bearer undefined"
        }
      }
    }
  },
  "triggers": {}
}
