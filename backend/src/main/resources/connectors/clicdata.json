{
  "name": "clicdata",
  "label": "Clicdata",
  "description": "ClicData enables True Performance with an end-to-end data analytics platform: connect, transform, automate, visualize and share data from 300+ sources.",
  "icon": "",
  "hosts": [
    "api.clicdata.com"
  ],
  "upstream": {
    "package": "@activepieces/piece-clicdata",
    "version": "0.0.10"
  },
  "credential": {
    "oauth2": {
      "authUrl": "https://api.clicdata.com/oauth20/authorize",
      "tokenUrl": "https://api.clicdata.com/oauth20/token",
      "scope": "account_read data_read data_write table_read table_write"
    }
  },
  "actions": {
    "refresh_table": {
      "label": "Refresh Table",
      "description": "Refresh the selected table depending on the refresh mode",
      "inputs": {
        "table_id": {
          "label": "Table",
          "description": "Select the table to insert data into",
          "required": true
        },
        "mode": {
          "label": "Refresh Mode",
          "description": "Select the refresh mode for the table",
          "required": true,
          "type": "select",
          "options": [
            {
              "value": "reload",
              "label": "Reload"
            },
            {
              "value": "rebuild",
              "label": "Rebuild"
            },
            {
              "value": "update",
              "label": "Update"
            },
            {
              "value": "append",
              "label": "Append"
            },
            {
              "value": "updateappend",
              "label": "Update + Append"
            }
          ],
          "defaultValue": "reload"
        },
        "apiVersion": {
          "label": "API Version",
          "description": "Defaults to 2022.01"
        }
      },
      "request": {
        "method": "POST",
        "url": "https://api.clicdata.com/table/{{table_id}}/refresh",
        "query": {
          "api_version": "{{apiVersion}}"
        },
        "body": {}
      }
    }
  },
  "triggers": {}
}
