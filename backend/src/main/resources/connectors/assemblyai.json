        "redact_pii_sub": {
          "label": "Redact PII Substitution",
          "description": "The replacement logic for detected PII, can be \"entity_type\" or \"hash\". See [PII redaction](https://www.assemblyai.com/docs/models/pii-redaction) for more details.",
          "type": "select",
          "options": [
            {
              "value": "entity_name",
              "label": "Entity Name"
            },
            {
              "value": "hash",
              "label": "Hash"
            }
          ]
        },
        "speaker_labels": {
          "label": "Speaker Labels",
          "description": "Enable [Speaker diarization](https://www.assemblyai.com/docs/models/speaker-diarization), can be true or false",
          "type": "boolean",
          "defaultValue": "false"
        },
        "speakers_expected": {
          "label": "Speakers Expected",
          "description": "Tells the speaker label model how many speakers it should attempt to identify, up to 10. See [Speaker diarization](https://www.assemblyai.com/docs/models/speaker-diarization) for more details.",
          "type": "number"
        },
        "content_safety": {
          "label": "Content Moderation",
          "description": "Enable [Content Moderation](https://www.assemblyai.com/docs/models/content-moderation), can be true or false",
          "type": "boolean",
          "defaultValue": "false"
        },
        "content_safety_confidence": {
          "label": "Content Moderation Confidence",
          "description": "The confidence threshold for the Content Moderation model. Values must be between 25 and 100.",
          "type": "number"
        },
        "iab_categories": {
          "label": "Topic Detection",
          "description": "Enable [Topic Detection](https://www.assemblyai.com/docs/models/topic-detection), can be true or false",
          "type": "boolean",
          "defaultValue": "false"
        },
        "custom_spelling": {
          "label": "Custom Spellings",
          "description": "Customize how words are spelled and formatted using to and from values.\nUse a JSON array of objects of the following format:\n```\n[\n  {\n    \"from\": [\"original\", \"spelling\"],\n    \"to\": \"corrected\"\n  }\n]\n```\n",
          "type": "json"
        },
        "sentiment_analysis": {
          "label": "Sentiment Analysis",
          "description": "Enable [Sentiment Analysis](https://www.assemblyai.com/docs/models/sentiment-analysis), can be true or false",
          "type": "boolean",
          "defaultValue": "false"
        },
        "auto_chapters": {
          "label": "Auto Chapters",
          "description": "Enable [Auto Chapters](https://www.assemblyai.com/docs/models/auto-chapters), can be true or false",
          "type": "boolean",
          "defaultValue": "false"
        },
        "entity_detection": {
          "label": "Entity Detection",
          "description": "Enable [Entity Detection](https://www.assemblyai.com/docs/models/entity-detection), can be true or false",
          "type": "boolean",
          "defaultValue": "false"
        },
        "speech_threshold": {
          "label": "Speech Threshold",
          "description": "Reject audio files that contain less than this fraction of speech.\nValid values are in the range [0, 1] inclusive.\n",
          "type": "number"
        },
        "summarization": {
          "label": "Enable Summarization",
          "description": "Enable [Summarization](https://www.assemblyai.com/docs/models/summarization), can be true or false",
          "type": "boolean",
          "defaultValue": "false"
        },
        "summary_model": {
          "label": "Summary Model",
          "description": "The model to summarize the transcript",
          "type": "select",
          "options": [
            {
              "value": "informative",
              "label": "Informative"
            },
            {
              "value": "conversational",
              "label": "Conversational"
            },
            {
              "value": "catchy",
              "label": "Catchy"
            }
          ]
        },
        "summary_type": {
          "label": "Summary Type",
          "description": "The type of summary",
          "type": "select",
          "options": [
            {
              "value": "bullets",
              "label": "Bullets"
            },
            {
              "value": "bullets_verbose",
              "label": "Bullets Verbose"
            },
            {
              "value": "gist",
              "label": "Gist"
            },
            {
              "value": "headline",
              "label": "Headline"
            },
            {
              "value": "paragraph",
              "label": "Paragraph"
            }
          ]
        },
        "custom_topics": {
          "label": "Enable Custom Topics",
          "description": "Enable custom topics, either true or false",
          "type": "boolean",
          "defaultValue": "false"
        },
        "topics": {
          "label": "Custom Topics",
          "description": "The list of custom topics",
          "type": "json"
        },
        "wait_until_ready": {
          "label": "Wait until transcript is ready",
          "description": "Wait until the transcript status is \"completed\" or \"error\" before moving on to the next step.",
          "required": true,
          "type": "boolean",
          "defaultValue": "true"
        },
        "throw_on_error": {
          "label": "Throw if transcript status is error",
          "description": "If the transcript status is \"error\", throw an error.",
          "required": true,
          "type": "boolean",
          "defaultValue": "true"
        }
      },
      "request": {
        "method": "POST",
        "url": "https://api.assemblyai.com/v2/transcript",
        "headers": {
          "cache-control": "no-cache",
          "pragma": "no-cache"
        },
        "body": {
          "audio_url": "{{audio_url}}",
          "language_confidence_threshold": "{{language_confidence_threshold}}",
          "webhook_url": "{{webhook_url}}",
          "webhook_auth_header_name": "{{webhook_auth_header_name}}",
          "webhook_auth_header_value": "{{webhook_auth_header_value}}",
          "audio_start_from": "{{audio_start_from}}",
          "audio_end_at": "{{audio_end_at}}",
          "speakers_expected": "{{speakers_expected}}",
          "content_safety_confidence": "{{content_safety_confidence}}",
          "speech_threshold": "{{speech_threshold}}"
        }
      }
    },
    "getTranscript": {
      "label": "Get Transcript",
      "description": "Retrieves a transcript by its ID.",
      "inputs": {
        "id": {
          "label": "Transcript ID",
          "required": true
        }
      },
      "request": {
        "method": "GET",
        "url": "https://api.assemblyai.com/v2/transcript/{{id}}",
        "headers": {
          "cache-control": "no-cache",
          "pragma": "no-cache"
        }
      }
    },
    "getTranscriptSentences": {
      "label": "Get Transcript Sentences",
      "description": "Retrieve the sentences of the transcript by its ID.",
      "inputs": {
        "id": {
          "label": "Transcript ID",
          "required": true
        }
      },
      "request": {
        "method": "GET",
        "url": "https://api.assemblyai.com/v2/transcript/{{id}}/sentences",
        "headers": {
          "cache-control": "no-cache",
          "pragma": "no-cache"
        }
      }
    },
    "getTranscriptParagraphs": {
      "label": "Get Transcript Paragraphs",
      "description": "Retrieve the paragraphs of the transcript by its ID.",
      "inputs": {
        "id": {
          "label": "Transcript ID",
          "required": true
        }
      },
      "request": {
        "method": "GET",
        "url": "https://api.assemblyai.com/v2/transcript/{{id}}/paragraphs",
        "headers": {
          "cache-control": "no-cache",
          "pragma": "no-cache"
        }
      }
    },
    "getRedactedAudio": {
      "label": "Get Transcript Redacted Audio",
      "description": "Get the result of the redacted audio model.",
      "inputs": {
        "id": {
          "label": "Transcript ID",
          "required": true
        },
        "download_file": {
          "label": "Download file?",
          "required": true,
          "type": "boolean",
          "defaultValue": "false"
        },
        "download_file_name": {
          "label": "Download File Name",
          "description": "The desired file name for storing in ActivePieces. Make sure the file extension is correct.",
          "required": true,
          "defaultValue": "redacted-audio.mp3"
        }
      },
      "request": {
        "method": "GET",
        "url": "https://api.assemblyai.com/v2/transcript/{{id}}/redacted-audio",
        "headers": {
          "cache-control": "no-cache",
          "pragma": "no-cache"
        }
      }
    },
    "listTranscripts": {
      "label": "List transcripts",
      "description": "Retrieve a list of transcripts you created.\nTranscripts are sorted from newest to oldest. The previous URL always points to a page with older transcripts.",
      "inputs": {
        "limit": {
          "label": "Limit",
          "description": "Maximum amount of transcripts to retrieve",
          "type": "number"
        },
        "status": {
          "label": "Status",
          "description": "Filter by transcript status",
          "type": "select",
          "options": [
            {
              "value": "queued",
              "label": "Queued"
            },
            {
              "value": "processing",
              "label": "Processing"
            },
            {
              "value": "completed",
              "label": "Completed"
            },
            {
              "value": "error",
              "label": "Error"
            }
          ]
        },
        "created_on": {
          "label": "Created On",
          "description": "Only get transcripts created on this date"
        },
        "before_id": {
          "label": "Before ID",
          "description": "Get transcripts that were created before this transcript ID"
        },
        "after_id": {
          "label": "After ID",
          "description": "Get transcripts that were created after this transcript ID"
        },
        "throttled_only": {
          "label": "Throttled Only",
          "description": "Only get throttled transcripts, overrides the status filter",
          "type": "boolean",
          "defaultValue": "false"
        }
      },
      "request": {
        "method": "GET",
        "url": "https://api.assemblyai.com/v2/transcript",
        "query": {
          "limit": "{{limit}}",
          "created_on": "{{created_on}}",
          "before_id": "{{before_id}}",
          "after_id": "{{after_id}}"
        },
        "headers": {
          "cache-control": "no-cache",
          "pragma": "no-cache"
        }
      }
    },
    "deleteTranscript": {
      "label": "Delete transcript",
      "description": "Remove the data from the transcript and mark it as deleted.",
      "inputs": {
        "id": {
          "label": "Transcript ID",
          "required": true
        }
      },
      "request": {
        "method": "DELETE",
        "url": "https://api.assemblyai.com/v2/transcript/{{id}}",
        "headers": {
          "cache-control": "no-cache",
          "pragma": "no-cache"
        }
      }
    },
    "lemurTask": {
      "label": "Run a Task using LeMUR",
      "description": "Use the LeMUR task endpoint to input your own LLM prompt.",
      "inputs": {
        "prompt": {
          "label": "Prompt",
          "description": "Your text to prompt the model to produce a desired output, including any context you want to pass into the model.",
          "required": true
        },
        "transcript_ids": {
          "label": "Transcript IDs",
          "description": "A list of completed transcripts with text. Up to a maximum of 100 files or 100 hours, whichever is lower.\nUse either transcript_ids or input_text as input into LeMUR.\n",
          "type": "json"
        },
        "input_text": {
          "label": "Input Text",
          "description": "Custom formatted transcript data. Maximum size is the context limit of the selected model, which defaults to 100000.\nUse either transcript_ids or input_text as input into LeMUR.\n"
        },
        "context": {
          "label": "Context",
          "description": "Context to provide the model. This can be a string or a free-form JSON value.",
          "type": "multiline"
        },
        "final_model": {
          "label": "Final Model",
          "description": "The model that is used for the final prompt after compression is performed.\n",
          "type": "select",
          "options": [
            {
              "value": "anthropic/claude-3-5-sonnet",
              "label": "Claude 3.5 Sonnet (on Anthropic)"
            },
            {
              "value": "anthropic/claude-3-opus",
              "label": "Claude 3 Opus (on Anthropic)"
            },
            {
              "value": "anthropic/claude-3-haiku",
              "label": "Claude 3 Haiku (on Anthropic)"
            },
            {
              "value": "anthropic/claude-3-sonnet",
              "label": "Claude 3 Sonnet (on Anthropic)"
            },
            {
              "value": "anthropic/claude-2-1",
              "label": "Claude 2.1 (on Anthropic)"
            },
            {
              "value": "anthropic/claude-2",
              "label": "Claude 2 (on Anthropic)"
            },
            {
              "value": "default",
              "label": "Default"
            },
            {
              "value": "anthropic/claude-instant-1-2",
              "label": "Claude Instant 1.2 (on Anthropic)"
            },
            {
              "value": "basic",
              "label": "Basic"
            },
            {
              "value": "assemblyai/mistral-7b",
              "label": "Mistral 7B (Hosted by AssemblyAI)"
            }
          ]
        },
        "max_output_size": {
          "label": "Maximum Output Size",
          "description": "Max output size in tokens, up to 4000",
          "type": "number"
        },
        "temperature": {
          "label": "Temperature",
          "description": "The temperature to use for the model.\nHigher values result in answers that are more creative, lower values are more conservative.\nCan be any value between 0.0 and 1.0 inclusive.\n",
          "type": "number"
        }
      },
      "request": {
        "method": "POST",
        "url": "https://api.assemblyai.com/lemur/v3/generate/task",
        "headers": {
          "cache-control": "no-cache",
          "pragma": "no-cache"
        },
        "body": {
          "prompt": "{{prompt}}"
        }
      }
    },
    "getLemurResponse": {
      "label": "Retrieve LeMUR response",
      "description": "Retrieve a LeMUR response that was previously generated.",
      "inputs": {
        "request_id": {
          "label": "LeMUR request ID",
          "description": "The ID of the LeMUR request whose data you want to delete. This would be found in the response of the original request.",
          "required": true
        }
      },
      "request": {
        "method": "GET",
        "url": "https://api.assemblyai.com/lemur/v3/{{request_id}}",
        "headers": {
          "cache-control": "no-cache",
          "pragma": "no-cache"
        }
      }
    },
    "purgeLemurRequestData": {
      "label": "Purge LeMUR request data",
      "description": "Delete the data for a previously submitted LeMUR request.\nThe LLM response data, as well as any context provided in the original request will be removed.",
      "inputs": {
        "request_id": {
          "label": "LeMUR request ID",
          "description": "The ID of the LeMUR request whose data you want to delete. This would be found in the response of the original request.",
          "required": true
        }
      },
      "request": {
        "method": "DELETE",
        "url": "https://api.assemblyai.com/lemur/v3/{{request_id}}",
        "headers": {
          "cache-control": "no-cache",
          "pragma": "no-cache"
        }
      }
    }
  },
  "triggers": {}
}
