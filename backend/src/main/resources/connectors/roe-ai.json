{
  "name": "roe-ai",
  "label": "Roe AI",
  "description": "",
  "icon": "",
  "hosts": [
    "api.roe-ai.com"
  ],
  "upstream": {
    "package": "@activepieces/piece-roe-ai",
    "version": "0.1.2"
  },
  "credential": {
    "fields": {
      "apiKey": {
        "label": "API Key",
        "description": "Enter your Roe AI API key",
        "required": true
      },
      "organization_id": {
        "label": "Organization ID",
        "description": "Enter your Roe AI Organization ID",
        "required": true
      }
    },
    "headers": {
      "authorization": "Bearer {{credential.apiKey}}"
    },
    "body": {
      "organization_id": "{{credential.organization_id}}"
    }
  },
  "actions": {
    "runQuery": {
      "label": "Run Query",
      "description": "Execute a query synchronously and return results",
      "inputs": {
        "query": {
          "label": "SQL Query",
          "description": "SQL query to execute",
          "required": true,
          "type": "multiline"
        },
        "worksheet_id": {
          "label": "Worksheet ID",
          "description": "Optional worksheet ID"
        },
        "use_admin": {
          "label": "Use Admin Privileges",
          "description": "Use admin privileges for the query",
          "type": "boolean",
          "defaultValue": "false"
        }
      },
      "request": {
        "method": "POST",
        "url": "https://api.roe-ai.com/v1/database/query",
        "body": {
          "query": "{{query}}",
          "worksheet_id": "{{worksheet_id}}"
        }
      }
    }
  },
  "triggers": {}
}
