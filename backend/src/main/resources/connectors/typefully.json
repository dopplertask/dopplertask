{
  "name": "typefully",
  "label": "Typefully",
  "description": "Write, schedule, and publish social media content.",
  "icon": "",
  "hosts": [
    "api.typefully.com"
  ],
  "upstream": {
    "package": "@activepieces/piece-typefully",
    "version": "0.3.4"
  },
  "credential": {
    "fields": {
      "token": {
        "label": "API Key",
        "description": "You can obtain your API key from **Typefully Settings → API**.",
        "secret": true,
        "required": true
      }
    },
    "headers": {
      "authorization": "Bearer {{credential.token}}"
    }
  },
  "actions": {
    "typefully_publish_draft_now": {
      "label": "Publish Draft Now",
      "description": "Immediately publishes an existing draft to all configured platforms.",
      "inputs": {
        "social_set_id": {
          "label": "Social Set",
          "description": "The social set (account) to use.",
          "required": true
        },
        "draft_id": {
          "label": "Draft ID",
          "description": "The ID of the draft to publish.",
          "required": true
        }
      },
      "request": {
        "method": "PATCH",
        "url": "https://api.typefully.com/v2/social-sets/{{social_set_id}}/drafts/{{draft_id}}",
        "body": {
          "publish_at": "now"
        }
      }
    },
    "typefully_schedule_draft": {
      "label": "Schedule Draft",
      "description": "Schedules an existing draft to be published at a specific time.",
      "inputs": {
        "social_set_id": {
          "label": "Social Set",
          "description": "The social set (account) to use.",
          "required": true
        },
        "draft_id": {
          "label": "Draft ID",
          "description": "The ID of the draft to schedule.",
          "required": true
        },
        "schedule_at": {
          "label": "Schedule At",
          "description": "The date and time to publish the draft (ISO 8601 format with timezone).",
          "required": true
        }
      },
      "request": {
        "method": "PATCH",
        "url": "https://api.typefully.com/v2/social-sets/{{social_set_id}}/drafts/{{draft_id}}",
        "body": {
          "publish_at": "{{schedule_at}}"
        }
      }
    },
    "typefully_get_draft": {
      "label": "Get Draft",
      "description": "Retrieve a specific draft by its ID.",
      "inputs": {
        "social_set_id": {
          "label": "Social Set",
          "description": "The social set (account) to use.",
          "required": true
        },
        "draft_id": {
          "label": "Draft ID",
          "description": "The ID of the draft to retrieve.",
          "required": true
        }
      },
      "request": {
        "method": "GET",
        "url": "https://api.typefully.com/v2/social-sets/{{social_set_id}}/drafts/{{draft_id}}"
      }
    },
    "typefully_list_drafts": {
      "label": "List Drafts",
      "description": "List drafts with optional filters.",
      "inputs": {
        "social_set_id": {
          "label": "Social Set",
          "description": "The social set (account) to use.",
          "required": true
        },
        "status": {
          "label": "Status",
          "description": "Filter by draft status.",
          "type": "select",
          "options": [
            {
              "value": "draft",
              "label": "Draft"
            },
            {
              "value": "scheduled",
              "label": "Scheduled"
            },
            {
              "value": "published",
              "label": "Published"
            },
            {
              "value": "publishing",
              "label": "Publishing"
            },
            {
              "value": "error",
              "label": "Error"
            }
          ]
        },
        "order_by": {
          "label": "Order By",
          "description": "Sort order for the results.",
          "type": "select",
          "options": [
            {
              "value": "-created_at",
              "label": "Created At (newest first)"
            },
            {
              "value": "created_at",
              "label": "Created At (oldest first)"
            },
            {
              "value": "-updated_at",
              "label": "Updated At (newest first)"
            },
            {
              "value": "updated_at",
              "label": "Updated At (oldest first)"
            },
            {
              "value": "-scheduled_date",
              "label": "Scheduled Date (newest first)"
            },
            {
              "value": "scheduled_date",
              "label": "Scheduled Date (oldest first)"
            }
          ]
        },
        "limit": {
          "label": "Limit",
          "description": "Maximum number of drafts to return (1-50).",
          "type": "number",
          "defaultValue": "10"
        }
      },
      "request": {
        "method": "GET",
        "url": "https://api.typefully.com/v2/social-sets/{{social_set_id}}/drafts",
        "query": {
          "limit": "{{limit}}"
        }
      }
    }
  },
  "triggers": {}
}
