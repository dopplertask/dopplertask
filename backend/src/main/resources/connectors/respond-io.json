{
  "name": "respond-io",
  "label": "Respond.io",
  "description": "",
  "icon": "",
  "hosts": [
    "api.respond.io"
  ],
  "upstream": {
    "package": "@activepieces/piece-respond-io",
    "version": "0.2.1"
  },
  "credential": {
    "fields": {
      "token": {
        "label": "API Token",
        "description": "Your Respond.io API v2 Token.",
        "secret": true,
        "required": true
      }
    },
    "headers": {
      "authorization": "Bearer {{credential.token}}"
    }
  },
  "actions": {
    "add_comment_to_conversation": {
      "label": "Add Comment to Conversation",
      "description": "Add an internal comment/note to a conversation in Respond.io.",
      "inputs": {
        "identifier": {
          "label": "Contact",
          "description": "Select the contact.",
          "required": true
        },
        "text": {
          "label": "Comment Text",
          "description": "The internal comment to add (max 1000 characters). You can mention users with {{@user.ID}} format where ID is the user ID.",
          "required": true,
          "type": "multiline"
        }
      },
      "request": {
        "method": "POST",
        "url": "https://api.respond.io/v2/contact/{{identifier}}/comment",
        "body": {
          "text": "{{text}}"
        }
      }
    },
    "assign_or_unassign_conversation": {
      "label": "Assign or Unassign Conversation",
      "description": "Assign or unassign a conversation to/from a team member in Respond.io.",
      "inputs": {
        "identifier": {
          "label": "Contact",
          "description": "Select the contact.",
          "required": true
        },
        "assignee": {
          "label": "Assignee",
          "description": "Select the user to assign the conversation to. Leave empty to unassign."
        }
      },
      "request": {
        "method": "POST",
        "url": "https://api.respond.io/v2/contact/{{identifier}}/conversation/assignee",
        "body": {
          "assignee": "{{assignee}}"
        }
      }
    },
    "delete_contact": {
      "label": "Delete Contact",
      "description": "Permanently delete a contact from Respond.io.",
      "inputs": {
        "identifier": {
          "label": "Contact",
          "description": "Select the contact.",
          "required": true
        }
      },
      "request": {
        "method": "DELETE",
        "url": "https://api.respond.io/v2/contact/{{identifier}}"
      }
    },
    "open_conversation": {
      "label": "Open Conversation",
      "description": "Mark a conversation as open in Respond.io.",
      "inputs": {
        "identifier": {
          "label": "Contact",
          "description": "Select the contact.",
          "required": true
        }
      },
      "request": {
        "method": "POST",
        "url": "https://api.respond.io/v2/contact/{{identifier}}/conversation/status",
        "body": {
          "status": "open"
        }
      }
    }
  },
  "triggers": {}
}
