{
  "name": "gorgias",
  "label": "Gorgias",
  "description": "Helpdesk platform for ecommerce teams to manage tickets, customers, and support conversations.",
  "icon": "",
  "hosts": [
    "{{credential.domain}}.gorgias.com"
  ],
  "upstream": {
    "package": "@activepieces/piece-gorgias",
    "version": "0.1.1"
  },
  "credential": {
    "fields": {
      "domain": {
        "label": "Helpdesk Domain",
        "description": "Your Gorgias subdomain only, for example `acme` from https://acme.gorgias.com. The host only, without https://, such as name.example.com.",
        "required": true
      },
      "email": {
        "label": "Email Address",
        "description": "The email address associated with your Gorgias API key.",
        "required": true
      },
      "api_key": {
        "label": "API Key",
        "description": "Your Gorgias API key.",
        "secret": true,
        "required": true
      }
    }
  },
  "actions": {
    "create_gorgias_ticket": {
      "label": "Create Ticket",
      "description": "Create a new Gorgias ticket with an initial message.",
      "inputs": {
        "fromAddress": {
          "label": "From Address",
          "description": "The sender address for the initial message, typically the customer email.",
          "required": true
        },
        "toAddress": {
          "label": "To Address",
          "description": "The recipient address for the initial message.",
          "required": true
        },
        "subject": {
          "label": "Subject",
          "required": true
        },
        "message": {
          "label": "Message",
          "description": "Initial ticket message. HTML is accepted by the API.",
          "required": true,
          "type": "multiline"
        },
        "channel": {
          "label": "Channel",
          "required": true,
          "type": "select",
          "options": [
            {
              "value": "email",
              "label": "Email"
            },
            {
              "value": "sms",
              "label": "SMS"
            },
            {
              "value": "chat",
              "label": "Chat"
            },
            {
              "value": "facebook",
              "label": "Facebook"
            },
            {
              "value": "instagram",
              "label": "Instagram"
            },
            {
              "value": "internal-note",
              "label": "Internal Note"
            },
            {
              "value": "phone",
              "label": "Phone"
            }
          ],
          "defaultValue": "email"
        },
        "via": {
          "label": "Via",
          "description": "How the message reached Gorgias.",
          "required": true,
          "type": "select",
          "options": [
            {
              "value": "help-center",
              "label": "Help Center"
            },
            {
              "value": "api",
              "label": "API"
            },
            {
              "value": "rule",
              "label": "Rule"
            },
            {
              "value": "manual",
              "label": "Manual"
            }
          ],
          "defaultValue": "api"
        }
      },
      "request": {
        "method": "POST",
        "url": "https://{{credential.domain}}.gorgias.com/api/tickets",
        "headers": {
          "authorization": "Basic Y3JlZGVudGlhbDAwMXo6Y3JlZGVudGlhbDAwMno="
        },
        "body": {
          "messages": [
            {
              "from_agent": false,
              "subject": "{{subject}}",
              "body_html": "{{message}}",
              "source": {
                "from": {
                  "address": "{{fromAddress}}"
                },
                "to": [
                  {
                    "address": "{{toAddress}}"
                  }
                ]
              }
            }
          ]
        }
      }
    },
    "get_gorgias_ticket": {
      "label": "Get Ticket",
      "description": "Retrieve a Gorgias ticket by ID.",
      "inputs": {
        "ticketId": {
          "label": "Ticket ID",
          "required": true,
          "type": "number"
        }
      },
      "request": {
        "method": "GET",
        "url": "https://{{credential.domain}}.gorgias.com/api/tickets/{{ticketId}}",
        "headers": {
          "authorization": "Basic Y3JlZGVudGlhbDAwMXo6Y3JlZGVudGlhbDAwMno="
        }
      }
    },
    "update_gorgias_ticket": {
      "label": "Update Ticket",
      "description": "Update a Gorgias ticket.",
      "inputs": {
        "ticketId": {
          "label": "Ticket ID",
          "required": true,
          "type": "number"
        },
        "subject": {
          "label": "Subject"
        },
        "status": {
          "label": "Status",
          "type": "select",
          "options": [
            {
              "value": "open",
              "label": "Open"
            },
            {
              "value": "closed",
              "label": "Closed"
            }
          ]
        },
        "channel": {
          "label": "Channel",
          "type": "select",
          "options": [
            {
              "value": "email",
              "label": "Email"
            },
            {
              "value": "sms",
              "label": "SMS"
            },
            {
              "value": "chat",
              "label": "Chat"
            },
            {
              "value": "facebook",
              "label": "Facebook"
            },
            {
              "value": "instagram",
              "label": "Instagram"
            },
            {
              "value": "internal-note",
              "label": "Internal Note"
            },
            {
              "value": "phone",
              "label": "Phone"
            }
          ]
        },
        "customerId": {
          "label": "Customer ID",
          "description": "Optional customer ID to attach to the ticket.",
          "type": "number"
        },
        "customerEmail": {
          "label": "Customer Email",
          "description": "Optional customer email to attach alongside the customer ID."
        },
        "fromAgent": {
          "label": "From Agent",
          "description": "Whether the first message of the ticket was sent by your company.",
          "type": "boolean"
        },
        "isUnread": {
          "label": "Is Unread",
          "type": "boolean"
        },
        "spam": {
          "label": "Spam",
          "type": "boolean"
        },
        "externalId": {
          "label": "External ID"
        }
      },
      "request": {
        "method": "PUT",
        "url": "https://{{credential.domain}}.gorgias.com/api/tickets/{{ticketId}}",
        "headers": {
          "authorization": "Basic Y3JlZGVudGlhbDAwMXo6Y3JlZGVudGlhbDAwMno="
        },
        "body": {
          "subject": "{{subject}}",
          "external_id": "{{externalId}}",
          "customer": {
            "id": "{{customerId}}",
            "email": "{{customerEmail}}"
          }
        }
      }
    },
    "list_gorgias_tickets": {
      "label": "List Tickets",
      "description": "List Gorgias tickets with cursor-based pagination support.",
      "inputs": {
        "customerId": {
          "label": "Customer ID",
          "description": "Optional customer ID to filter tickets for one customer.",
          "type": "number"
        },
        "cursor": {
          "label": "Cursor",
          "description": "Optional cursor returned by a previous list response."
        },
        "limit": {
          "label": "Limit",
          "description": "Maximum number of tickets to return in this page. Defaults to 25.",
          "type": "number",
          "defaultValue": "25"
        },
        "orderBy": {
          "label": "Order By",
          "description": "Optional ordering, for example `created_datetime:desc`."
        }
      },
      "request": {
        "method": "GET",
        "url": "https://{{credential.domain}}.gorgias.com/api/tickets",
        "query": {
          "customer_id": "{{customerId}}",
          "cursor": "{{cursor}}",
          "limit": "{{limit}}",
          "order_by": "{{orderBy}}"
        },
        "headers": {
          "authorization": "Basic Y3JlZGVudGlhbDAwMXo6Y3JlZGVudGlhbDAwMno="
        }
      }
    },
    "create_gorgias_ticket_message": {
      "label": "Create Message",
      "description": "Create a reply or message on an existing Gorgias ticket.",
      "inputs": {
        "ticketId": {
          "label": "Ticket ID",
          "required": true,
          "type": "number"
        },
        "fromAgent": {
          "label": "From Agent",
          "description": "True when the sender is an agent/user; false when the sender is a customer.",
          "required": true,
          "type": "boolean",
          "defaultValue": "true"
        },
        "senderId": {
          "label": "Sender ID",
          "description": "User ID when From Agent is true, otherwise Customer ID.",
          "required": true,
          "type": "number"
        },
        "receiverId": {
          "label": "Receiver ID",
          "description": "Customer ID when From Agent is true, otherwise User ID.",
          "required": true,
          "type": "number"
        },
        "fromAddress": {
          "label": "From Address",
          "description": "Email or channel address of the sender.",
          "required": true
        },
        "toAddress": {
          "label": "To Address",
          "description": "Email or channel address of the receiver.",
          "required": true
        },
        "message": {
          "label": "Message",
          "description": "Message body. HTML is accepted by the API.",
          "required": true,
          "type": "multiline"
        },
        "subject": {
          "label": "Subject"
        },
        "channel": {
          "label": "Channel",
          "required": true,
          "type": "select",
          "options": [
            {
              "value": "email",
              "label": "Email"
            },
            {
              "value": "sms",
              "label": "SMS"
            },
            {
              "value": "chat",
              "label": "Chat"
            },
            {
              "value": "facebook",
              "label": "Facebook"
            },
            {
              "value": "instagram",
              "label": "Instagram"
            },
            {
              "value": "internal-note",
              "label": "Internal Note"
            },
            {
              "value": "phone",
              "label": "Phone"
            }
          ],
          "defaultValue": "email"
        },
        "via": {
          "label": "Via",
          "required": true,
          "type": "select",
          "options": [
            {
              "value": "help-center",
              "label": "Help Center"
            },
            {
              "value": "api",
              "label": "API"
            },
            {
              "value": "rule",
              "label": "Rule"
            },
            {
              "value": "manual",
              "label": "Manual"
            }
          ],
          "defaultValue": "api"
        },
        "sentDatetime": {
          "label": "Sent Datetime",
          "description": "Optional ISO-8601 timestamp for when the message was sent."
        }
      },
      "request": {
        "method": "POST",
        "url": "https://{{credential.domain}}.gorgias.com/api/tickets/{{ticketId}}/messages",
        "headers": {
          "authorization": "Basic Y3JlZGVudGlhbDAwMXo6Y3JlZGVudGlhbDAwMno="
        },
        "body": {
          "body_html": "{{message}}",
          "subject": "{{subject}}",
          "sent_datetime": "{{sentDatetime}}",
          "sender": {
            "id": "{{senderId}}"
          },
          "receiver": {
            "id": "{{receiverId}}"
          },
          "source": {
            "from": {
              "address": "{{fromAddress}}"
            },
            "to": [
              {
                "address": "{{toAddress}}"
              }
            ]
          }
        }
      }
    },
    "get_gorgias_customer": {
      "label": "Get Customer",
      "description": "Retrieve a Gorgias customer by ID or find one by email.",
      "inputs": {
        "customerId": {
          "label": "Customer ID",
          "description": "Use this when you already know the customer ID.",
          "type": "number"
        },
        "email": {
          "label": "Email",
          "description": "If Customer ID is not provided, search customers by email using Gorgias server-side filtering."
        }
      },
      "request": {
        "method": "GET",
        "url": "https://{{credential.domain}}.gorgias.com/api/customers/{{customerId}}",
        "headers": {
          "authorization": "Basic Y3JlZGVudGlhbDAwMXo6Y3JlZGVudGlhbDAwMno="
        }
      }
    }
  },
  "triggers": {}
}
