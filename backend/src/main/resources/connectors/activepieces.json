{
  "name": "activepieces",
  "label": "Activepieces Platform",
  "description": "Open source no-code business automation",
  "icon": "",
  "hosts": [
    "{{credential.baseApiUrl}}"
  ],
  "upstream": {
    "package": "@activepieces/piece-activepieces",
    "version": "0.5.4"
  },
  "credential": {
    "fields": {
      "baseApiUrl": {
        "label": "Base URL",
        "description": "The host only, without https://, such as name.example.com.",
        "required": true
      },
      "apiKey": {
        "label": "API Key",
        "description": "",
        "secret": true,
        "required": true
      }
    },
    "headers": {
      "authorization": "Bearer {{credential.apiKey}}"
    }
  },
  "actions": {
    "create_project": {
      "label": "Create Project",
      "description": "Create a new project",
      "inputs": {
        "display_name": {
          "label": "Display Name",
          "required": true
        }
      },
      "request": {
        "method": "POST",
        "url": "https://{{credential.baseApiUrl}}/projects",
        "body": {
          "displayName": "{{display_name}}"
        }
      }
    },
    "list_project": {
      "label": "List Projects",
      "description": "List all projects",
      "inputs": {},
      "request": {
        "method": "GET",
        "url": "https://{{credential.baseApiUrl}}/projects"
      }
    }
  },
  "triggers": {}
}
