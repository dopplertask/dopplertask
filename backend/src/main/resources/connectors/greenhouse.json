{
  "name": "greenhouse",
  "label": "Greenhouse",
  "description": "Recruiting and onboarding software",
  "icon": "greenhouse",
  "hosts": [
    "harvest.greenhouse.io"
  ],
  "upstream": {
    "package": "@activepieces/piece-greenhouse",
    "version": "0.1.2"
  },
  "credential": {
    "oauth2": {
      "authUrl": "https://auth.greenhouse.io/authorize",
      "tokenUrl": "https://auth.greenhouse.io/token",
      "scope": "harvest:candidates:list harvest:candidates:create harvest:candidates:update harvest:applications:list harvest:jobs:list harvest:job_posts:list harvest:interviews:list harvest:scorecards:list harvest:notes:create"
    }
  },
  "actions": {
    "create_candidate": {
      "label": "Create Candidate",
      "description": "Creates a new candidate profile in Greenhouse.",
      "inputs": {
        "first_name": {
          "label": "First Name",
          "description": "The candidate's first name.",
          "required": true
        },
        "last_name": {
          "label": "Last Name",
          "description": "The candidate's last name.",
          "required": true
        },
        "email": {
          "label": "Email Address",
          "description": "The candidate's email address."
        },
        "email_type": {
          "label": "Email Type",
          "description": "The type of email address provided.",
          "type": "select",
          "options": [
            {
              "value": "personal",
              "label": "Personal"
            },
            {
              "value": "work",
              "label": "Work"
            },
            {
              "value": "other",
              "label": "Other"
            }
          ],
          "defaultValue": "personal"
        },
        "phone": {
          "label": "Phone Number",
          "description": "The candidate's phone number."
        },
        "phone_type": {
          "label": "Phone Type",
          "description": "The type of phone number provided.",
          "type": "select",
          "options": [
            {
              "value": "mobile",
              "label": "Mobile"
            },
            {
              "value": "home",
              "label": "Home"
            },
            {
              "value": "work",
              "label": "Work"
            },
            {
              "value": "skype",
              "label": "Skype"
            },
            {
              "value": "other",
              "label": "Other"
            }
          ],
          "defaultValue": "mobile"
        },
        "company": {
          "label": "Current Company",
          "description": "The candidate's current employer."
        },
        "title": {
          "label": "Current Job Title",
          "description": "The candidate's current job title."
        },
        "linkedin_url": {
          "label": "LinkedIn URL",
          "description": "URL to the candidate's LinkedIn profile (e.g. `https://linkedin.com/in/johndoe`)."
        },
        "website_url": {
          "label": "Website URL",
          "description": "URL to the candidate's personal website or portfolio."
        },
        "tags": {
          "label": "Tags",
          "description": "Labels to attach to this candidate (e.g. `referral`, `engineering`). Each item in the list becomes one tag.",
          "type": "json"
        }
      },
      "request": {
        "method": "POST",
        "url": "https://harvest.greenhouse.io/v3/candidates",
        "body": {
          "first_name": "{{first_name}}",
          "last_name": "{{last_name}}",
          "company": "{{company}}",
          "title": "{{title}}",
          "email_addresses": [
            {
              "value": "{{email}}",
              "type": "personal"
            }
          ],
          "phone_numbers": [
            {
              "value": "{{phone}}",
              "type": "mobile"
            }
          ],
          "website_addresses": [
            {
              "value": "{{website_url}}",
              "type": "personal"
            }
          ],
          "social_media_addresses": [
            {
              "value": "{{linkedin_url}}"
            }
          ]
        }
      }
    },
    "create_candidate_note": {
      "label": "Create Candidate Note",
      "description": "Adds a note to an existing candidate profile in Greenhouse.",
      "inputs": {
        "candidate_id": {
          "label": "Candidate ID",
          "description": "The numeric ID of the candidate to add the note to. Found in the candidate URL in Greenhouse (e.g. `https://app.greenhouse.io/people/**123456**`), or mapped from a previous **Create Candidate** step.",
          "required": true
        },
        "note_type": {
          "label": "Note Type",
          "description": "The type of note to create.",
          "required": true,
          "type": "select",
          "options": [
            {
              "value": "NOTE",
              "label": "Note"
            },
            {
              "value": "ACTIVITY",
              "label": "Activity"
            }
          ],
          "defaultValue": "NOTE"
        },
        "body": {
          "label": "Note",
          "description": "The content of the note.",
          "required": true,
          "type": "multiline"
        },
        "visibility": {
          "label": "Visibility",
          "description": "Who can see this note. **Admin Only** — only admins; **Private** — only the author; **Public** — all Greenhouse users.",
          "required": true,
          "type": "select",
          "options": [
            {
              "value": "public",
              "label": "Public (all users)"
            },
            {
              "value": "private",
              "label": "Private (author only)"
            },
            {
              "value": "admin_only",
              "label": "Admin Only"
            }
          ],
          "defaultValue": "public"
        },
        "user_id": {
          "label": "Author User ID",
          "description": "Optional. The Greenhouse user ID to attribute this note to. To find it: go to **Configure → Users**, click a user, and copy the number from the URL (e.g. `https://app.greenhouse.io/people/**12345**`)."
        }
      },
      "request": {
        "method": "POST",
        "url": "https://harvest.greenhouse.io/v3/notes",
        "body": {
          "candidate_id": null,
          "body": "{{body}}",
          "user_id": null
        }
      }
    },
    "create_prospect": {
      "label": "Create Prospect",
      "description": "Creates a new prospect in Greenhouse — a person who has not yet applied to a specific job.",
      "inputs": {
        "first_name": {
          "label": "First Name",
          "description": "The prospect's first name.",
          "required": true
        },
        "last_name": {
          "label": "Last Name",
          "description": "The prospect's last name.",
          "required": true
        },
        "email": {
          "label": "Email Address",
          "description": "The prospect's email address."
        },
        "email_type": {
          "label": "Email Type",
          "description": "The type of email address provided.",
          "type": "select",
          "options": [
            {
              "value": "personal",
              "label": "Personal"
            },
            {
              "value": "work",
              "label": "Work"
            },
            {
              "value": "other",
              "label": "Other"
            }
          ],
          "defaultValue": "personal"
        },
        "phone": {
          "label": "Phone Number",
          "description": "The prospect's phone number."
        },
        "phone_type": {
          "label": "Phone Type",
          "description": "The type of phone number provided.",
          "type": "select",
          "options": [
            {
              "value": "mobile",
              "label": "Mobile"
            },
            {
              "value": "home",
              "label": "Home"
            },
            {
              "value": "work",
              "label": "Work"
            },
            {
              "value": "skype",
              "label": "Skype"
            },
            {
              "value": "other",
              "label": "Other"
            }
          ],
          "defaultValue": "mobile"
        },
        "company": {
          "label": "Current Company",
          "description": "The prospect's current employer."
        },
        "title": {
          "label": "Current Job Title",
          "description": "The prospect's current job title."
        },
        "linkedin_url": {
          "label": "LinkedIn URL",
          "description": "URL to the prospect's LinkedIn profile (e.g. `https://linkedin.com/in/johndoe`)."
        },
        "website_url": {
          "label": "Website URL",
          "description": "URL to the prospect's personal website or portfolio."
        },
        "tags": {
          "label": "Tags",
          "description": "Labels to attach to this prospect (e.g. `referral`, `engineering`). Each item in the list becomes one tag.",
          "type": "json"
        }
      },
      "request": {
        "method": "POST",
        "url": "https://harvest.greenhouse.io/v3/candidates",
        "body": {
          "first_name": "{{first_name}}",
          "last_name": "{{last_name}}",
          "application": {
            "prospect": true
          },
          "company": "{{company}}",
          "title": "{{title}}",
          "email_addresses": [
            {
              "value": "{{email}}",
              "type": "personal"
            }
          ],
          "phone_numbers": [
            {
              "value": "{{phone}}",
              "type": "mobile"
            }
          ],
          "website_addresses": [
            {
              "value": "{{website_url}}",
              "type": "personal"
            }
          ],
          "social_media_addresses": [
            {
              "value": "{{linkedin_url}}"
            }
          ]
        }
      }
    },
    "update_candidate": {
      "label": "Update Candidate",
      "description": "Updates an existing candidate profile in Greenhouse. Only fields you provide will be changed.",
      "inputs": {
        "candidate_id": {
          "label": "Candidate ID",
          "description": "The numeric ID of the candidate to update. Found in the candidate URL in Greenhouse (e.g. `https://app.greenhouse.io/people/**123456**`), or mapped from a previous **Create Candidate** step.",
          "required": true
        },
        "first_name": {
          "label": "First Name",
          "description": "Updated first name for the candidate."
        },
        "last_name": {
          "label": "Last Name",
          "description": "Updated last name for the candidate."
        },
        "email": {
          "label": "Email Address",
          "description": "Updated email address. This replaces the candidate's primary email."
        },
        "email_type": {
          "label": "Email Type",
          "description": "The type of the updated email address.",
          "type": "select",
          "options": [
            {
              "value": "personal",
              "label": "Personal"
            },
            {
              "value": "work",
              "label": "Work"
            },
            {
              "value": "other",
              "label": "Other"
            }
          ],
          "defaultValue": "personal"
        },
        "phone": {
          "label": "Phone Number",
          "description": "Updated phone number. This replaces the candidate's primary phone."
        },
        "phone_type": {
          "label": "Phone Type",
          "description": "The type of the updated phone number.",
          "type": "select",
          "options": [
            {
              "value": "mobile",
              "label": "Mobile"
            },
            {
              "value": "home",
              "label": "Home"
            },
            {
              "value": "work",
              "label": "Work"
            },
            {
              "value": "skype",
              "label": "Skype"
            },
            {
              "value": "other",
              "label": "Other"
            }
          ],
          "defaultValue": "mobile"
        },
        "company": {
          "label": "Current Company",
          "description": "Updated current employer."
        },
        "title": {
          "label": "Current Job Title",
          "description": "Updated current job title."
        },
        "linkedin_url": {
          "label": "LinkedIn URL",
          "description": "Updated LinkedIn profile URL (e.g. `https://linkedin.com/in/johndoe`)."
        },
        "website_url": {
          "label": "Website URL",
          "description": "Updated personal website or portfolio URL."
        },
        "tags": {
          "label": "Tags",
          "description": "Replaces all existing tags on the candidate with this list. Leave blank to keep existing tags unchanged.",
          "type": "json"
        }
      },
      "request": {
        "method": "PATCH",
        "url": "https://harvest.greenhouse.io/v3/candidates/{{candidate_id}}",
        "body": {
          "first_name": "{{first_name}}",
          "last_name": "{{last_name}}",
          "company": "{{company}}",
          "title": "{{title}}",
          "email_addresses": [
            {
              "value": "{{email}}",
              "type": "personal"
            }
          ],
          "phone_numbers": [
            {
              "value": "{{phone}}",
              "type": "mobile"
            }
          ],
          "website_addresses": [
            {
              "value": "{{website_url}}",
              "type": "personal"
            }
          ],
          "social_media_addresses": [
            {
              "value": "{{linkedin_url}}"
            }
          ]
        }
      }
    }
  },
  "triggers": {}
}
