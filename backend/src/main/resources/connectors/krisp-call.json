{
  "name": "krisp-call",
  "label": "KrispCall",
  "description": "KrispCall is a cloud telephony system for modern businesses, offering advanced features for high-growth startups and modern enterprises.",
  "icon": "",
  "hosts": [
    "app.krispcall.com"
  ],
  "upstream": {
    "package": "@activepieces/piece-krisp-call",
    "version": "0.1.7"
  },
  "credential": {
    "fields": {
      "apiKey": {
        "label": "API key",
        "description": "",
        "secret": true,
        "required": true
      }
    },
    "headers": {
      "x-api-key": "{{credential.apiKey}}"
    }
  },
  "actions": {
    "addContact": {
      "label": "Add Contact",
      "description": "Add contact in Krispcall",
      "inputs": {
        "name": {
          "label": "Name",
          "description": "Enter your name"
        },
        "number": {
          "label": "Contact number",
          "description": "Enter contact number",
          "required": true
        },
        "address": {
          "label": "Address",
          "description": "Enter your address"
        },
        "company": {
          "label": "Company",
          "description": "Enter your company"
        },
        "email": {
          "label": "Email",
          "description": "Enter your email"
        }
      },
      "request": {
        "method": "POST",
        "url": "https://app.krispcall.com/api/v3/platform/activepiece/add-contact",
        "body": {
          "name": "{{name}}",
          "number": "{{number}}",
          "company": "{{company}}",
          "email": "{{email}}",
          "address": "{{address}}"
        }
      }
    },
    "deleteContacts": {
      "label": "Delete Contacts",
      "description": "Delete contacts from krispcall.",
      "inputs": {
        "contacts": {
          "label": "Contacts",
          "description": "Enter contact which you want to delete.",
          "type": "json"
        }
      },
      "request": {
        "method": "DELETE",
        "url": "https://app.krispcall.com/api/v3/platform/activepiece/delete-contacts",
        "body": {}
      }
    },
    "sendSms": {
      "label": "Send SMS",
      "description": "Send sms in Krispcall.",
      "inputs": {
        "from_number": {
          "label": "From Number",
          "description": "Select an Number",
          "required": true
        },
        "to_number": {
          "label": "To Number",
          "description": "Enter the number to which you want to send sms.",
          "required": true
        },
        "content": {
          "label": "content",
          "description": "Enter your message here.",
          "required": true
        }
      },
      "request": {
        "method": "POST",
        "url": "https://app.krispcall.com/api/v3/platform/activepiece/send-sms",
        "body": {
          "from_number": "{{from_number}}",
          "to_number": "{{to_number}}",
          "content": "{{content}}"
        }
      }
    }
  },
  "triggers": {}
}
