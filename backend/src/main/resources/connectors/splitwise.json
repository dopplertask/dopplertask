{
  "name": "splitwise",
  "label": "Splitwise",
  "description": "Splitwise is a expense splitting app that helps you track and settle bills with friends, family, and roommates.",
  "icon": "",
  "hosts": [
    "secure.splitwise.com"
  ],
  "upstream": {
    "package": "@activepieces/piece-splitwise",
    "version": "0.1.8"
  },
  "credential": {
    "fields": {
      "token": {
        "label": "API Key",
        "description": "\nYou can generate an API key from your app's details page on Splitwise.\nThe API key should be kept secure as it provides access to your personal account.\n",
        "secret": true,
        "required": true
      }
    },
    "headers": {
      "authorization": "Bearer {{credential.token}}"
    }
  },
  "actions": {
    "create_expense": {
      "label": "Create Expense",
      "description": "Creates a new expense, optionally in a group or with specific friends",
      "inputs": {
        "split_type": {
          "label": "Split Type",
          "description": "How to split the expense",
          "required": true,
          "type": "select",
          "options": [
            {
              "value": "equal_group_split",
              "label": "Split equally in group"
            },
            {
              "value": "by_shares",
              "label": "Split by custom shares"
            }
          ],
          "defaultValue": "equal_group_split"
        },
        "cost": {
          "label": "Cost",
          "description": "Amount (e.g., \"25.50\")",
          "required": true
        },
        "description": {
          "label": "Description",
          "description": "Short description of the expense",
          "required": true
        },
        "details": {
          "label": "Details/Notes",
          "description": "Additional notes about the expense",
          "type": "multiline"
        },
        "date": {
          "label": "Date",
          "description": "Date and time the expense took place"
        },
        "repeat_interval": {
          "label": "Repeat Interval",
          "description": "How often to repeat this expense",
          "type": "select",
          "options": [
            {
              "value": "never",
              "label": "Never"
            },
            {
              "value": "weekly",
              "label": "Weekly"
            },
            {
              "value": "fortnightly",
              "label": "Fortnightly"
            },
            {
              "value": "monthly",
              "label": "Monthly"
            },
            {
              "value": "yearly",
              "label": "Yearly"
            }
          ],
          "defaultValue": "never"
        },
        "currency_code": {
          "label": "Currency Code",
          "description": "Currency code (e.g., USD, EUR)",
          "defaultValue": "USD"
        },
        "category_id": {
          "label": "Category",
          "description": "Expense category"
        },
        "group_id": {
          "label": "Group",
          "description": "Group to put this expense in (required for equal split)",
          "required": true
        },
        "users": {
          "label": "Users (Custom Split)",
          "description": "Users and their shares for custom split (only used when Split Type is \"by_shares\")",
          "type": "json"
        }
      },
      "request": {
        "method": "POST",
        "url": "https://secure.splitwise.com/api/v3.0/create_expense",
        "body": {
          "cost": "{{cost}}",
          "description": "{{description}}",
          "group_id": "{{group_id}}",
          "details": "{{details}}",
          "date": "{{date}}",
          "currency_code": "{{currency_code}}",
          "category_id": "{{category_id}}"
        }
      }
    }
  },
  "triggers": {}
}
