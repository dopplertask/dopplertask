{
  "name": "murf-api",
  "label": "Murf AI",
  "description": "",
  "icon": "",
  "hosts": [
    "api.murf.ai"
  ],
  "upstream": {
    "package": "@activepieces/piece-murf-api",
    "version": "0.2.3"
  },
  "credential": {
    "fields": {
      "token": {
        "label": "API Key",
        "description": "Enter your API key from https://murf.ai",
        "secret": true,
        "required": true
      }
    },
    "headers": {
      "api-key": "{{credential.token}}"
    }
  },
  "actions": {
    "text_to_speech": {
      "label": "Text to Speech",
      "description": "Converts input text into speech using Murf AI.",
      "inputs": {
        "language": {
          "label": "Language",
          "description": "Select your preferred language for the translated output.",
          "required": true
        },
        "voiceId": {
          "label": "Voice",
          "description": "Choose a voice for converting text into speech",
          "required": true
        },
        "text": {
          "label": "Text",
          "description": "The text to be synthesized.",
          "required": true,
          "type": "multiline"
        },
        "audioDuration": {
          "label": "Audio Duration (seconds)",
          "description": "Specify audio length. If 0, Murf ignores this. Only for Gen2 model.",
          "type": "number"
        },
        "channelType": {
          "label": "Channel Type",
          "description": "Mono or Stereo output.",
          "type": "select",
          "options": [
            {
              "value": "MONO",
              "label": "Mono"
            },
            {
              "value": "STEREO",
              "label": "Stereo"
            }
          ]
        },
        "encodeAsBase64": {
          "label": "Encode as Base64",
          "description": "Return Base64 encoded audio instead of URL (zero retention).",
          "type": "boolean"
        },
        "format": {
          "label": "Audio Format",
          "description": "Select audio format.",
          "type": "select",
          "options": [
            {
              "value": "MP3",
              "label": "MP3"
            },
            {
              "value": "WAV",
              "label": "WAV"
            },
            {
              "value": "FLAC",
              "label": "FLAC"
            },
            {
              "value": "ALAW",
              "label": "ALAW"
            },
            {
              "value": "ULAW",
              "label": "ULAW"
            },
            {
              "value": "PCM",
              "label": "PCM"
            },
            {
              "value": "OGG",
              "label": "OGG"
            }
          ]
        },
        "modelVersion": {
          "label": "Model Version",
          "description": "Choose Gen1 or Gen2.",
          "type": "select",
          "options": [
            {
              "value": "GEN1",
              "label": "GEN1"
            },
            {
              "value": "GEN2",
              "label": "GEN2"
            }
          ]
        },
        "multiNativeLocale": {
          "label": "Multi Native Locale",
          "description": "Set multi-language voice (e.g., en-US, es-ES). Only for Gen2."
        },
        "pitch": {
          "label": "Pitch",
          "description": "Pitch adjustment (-50 to 50).",
          "type": "number"
        },
        "rate": {
          "label": "Rate",
          "description": "Speed adjustment (-50 to 50).",
          "type": "number"
        },
        "style": {
          "label": "Style",
          "description": "Voice style (e.g., 'default', 'calm', 'energetic'). Check voice details."
        },
        "sampleRate": {
          "label": "Sample Rate",
          "description": "Defaults to 44100. Allowed: 8000, 24000, 44100, 48000.",
          "type": "number"
        },
        "variation": {
          "label": "Variation",
          "description": "Variation level (0–5). Defaults to 1. Higher = more natural pauses/pitch/speed.",
          "type": "number"
        },
        "wordDurationsAsOriginalText": {
          "label": "Word Durations as Original Text",
          "description": "If true, response word timings map to original text. (English only).",
          "type": "boolean"
        },
        "pronunciationDictionary": {
          "label": "Pronunciation Dictionary",
          "description": "Custom word pronunciations.",
          "type": "json"
        }
      },
      "request": {
        "method": "POST",
        "url": "https://api.murf.ai/v1/speech/generate",
        "body": {
          "text": "{{text}}",
          "voiceId": "{{voiceId}}",
          "audioDuration": "{{audioDuration}}",
          "multiNativeLocale": "{{multiNativeLocale}}",
          "pitch": "{{pitch}}",
          "rate": "{{rate}}",
          "sampleRate": "{{sampleRate}}",
          "style": "{{style}}",
          "variation": "{{variation}}"
        }
      }
    }
  },
  "triggers": {}
}
