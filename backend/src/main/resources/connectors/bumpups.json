  "credential": {
    "fields": {
      "token": {
        "label": "Bumpups API Key",
        "description": "**Enter your Bumpups API Key.**\n---\n### How to obtain your API key\n1. Sign up or log in at [bumpups.com](https://bumpups.com).\n2. Go to **Settings** → **API**.\n3. Enable API access and generate a key.\n4. Copy and paste it here.\n",
        "secret": true,
        "required": true
      }
    },
    "headers": {
      "x-api-key": "{{credential.token}}"
    }
  },
