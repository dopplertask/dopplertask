    "generateCreatorDescription": {
      "label": "Generate Creator Description",
      "description": "Generates a compelling description for a YouTube video based on its content.",
      "inputs": {
        "videoUrl": {
          "label": "Video URL",
          "description": "The YouTube video URL.",
          "required": true
        },
        "model": {
          "label": "Model",
          "required": true,
          "type": "select",
          "options": [
            {
              "value": "bump-1.0",
              "label": "bump-1.0"
            }
          ],
          "defaultValue": "bump-1.0"
        },
        "language": {
          "label": "Language",
          "type": "select",
          "options": [
            {
              "value": "en",
              "label": "English (en)"
            },
            {
              "value": "hi",
              "label": "Hindi (hi)"
            },
            {
              "value": "es",
              "label": "Spanish (es)"
            },
            {
              "value": "pt",
              "label": "Portuguese (pt)"
            },
            {
              "value": "ru",
              "label": "Russian (ru)"
            },
            {
              "value": "de",
              "label": "German (de)"
            },
            {
              "value": "fr",
              "label": "French (fr)"
            },
            {
              "value": "ja",
              "label": "Japanese (ja)"
            },
            {
              "value": "ko",
              "label": "Korean (ko)"
            },
            {
              "value": "ar",
              "label": "Arabic (ar)"
            }
          ],
          "defaultValue": "en"
        }
      },
      "request": {
        "method": "POST",
        "url": "https://api.bumpups.com/creator/description",
        "body": {
          "url": "{{videoUrl}}",
          "languaege": "en"
        }
      }
    },
