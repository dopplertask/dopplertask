{
  "name": "quaderno",
  "label": "Quaderno",
  "description": "Quaderno is a tax software that handles sales tax, VAT, and GST for your online business. Automatically calculates tax, sends receipts and invoices, and provides instant multi-channel tax reports for your sales around the world.",
  "icon": "",
  "hosts": [
    "{{credential.account_name}}.quadernoapp.com"
  ],
  "upstream": {
    "package": "@activepieces/piece-quaderno",
    "version": "0.1.1"
  },
  "credential": {
    "fields": {
      "account_name": {
        "label": "Account Name",
        "description": "Your Quaderno account name https://<your_account_name>.quadernoapp.com/ (the subdomain part of your Quaderno URL) https://<your_account_name>.sandbox-quadernoapp.com/",
        "required": true
      },
      "api_key": {
        "label": "API Key",
        "description": "Your Quaderno Private API Key",
        "secret": true,
        "required": true
      }
    }
  },
  "actions": {
    "createContact": {
      "label": "Create Contact",
      "description": "Create a new contact in Quaderno (customer or vendor)",
      "inputs": {
        "firstName": {
          "label": "First Name",
          "description": "The contact's first name (required for person contacts)",
          "required": true
        },
        "lastName": {
          "label": "Last Name",
          "description": "The contact's last name (optional)"
        },
        "email": {
          "label": "Email",
          "description": "The contact's email address"
        },
        "fullName": {
          "label": "Full Name",
          "description": "The contact's full name"
        },
        "kind": {
          "label": "Kind",
          "description": "The type of contact",
          "type": "select",
          "options": [
            {
              "value": "person",
              "label": "Person"
            },
            {
              "value": "company",
              "label": "Company"
            }
          ]
        },
        "country": {
          "label": "Country",
          "description": "2-letter ISO country code (e.g., US, GB)",
          "required": true
        },
        "city": {
          "label": "City",
          "description": "City/District/Suburb/Town/Village"
        },
        "postalCode": {
          "label": "Postal Code",
          "description": "ZIP or postal code"
        },
        "region": {
          "label": "Region/State",
          "description": "State/Province/Region"
        },
        "streetLine1": {
          "label": "Street Address Line 1",
          "description": "Street address or PO Box"
        },
        "streetLine2": {
          "label": "Street Address Line 2",
          "description": "Apartment/Suite/Unit/Building"
        },
        "taxId": {
          "label": "Tax ID",
          "description": "Tax identification number (VAT, ABN, etc.)"
        },
        "taxStatus": {
          "label": "Tax Status",
          "description": "Tax status of the contact",
          "type": "select",
          "options": [
            {
              "value": "taxable",
              "label": "Taxable"
            },
            {
              "value": "exempt",
              "label": "Exempt"
            },
            {
              "value": "reverse",
              "label": "Reverse"
            }
          ]
        },
        "language": {
          "label": "Language",
          "description": "2-letter ISO language code (e.g., EN, FR, ES)"
        },
        "phone": {
          "label": "Phone",
          "description": "The contact's phone number"
        },
        "website": {
          "label": "Website",
          "description": "The contact's website URL"
        },
        "discount": {
          "label": "Discount",
          "description": "Default discount for this contact (as a percentage)",
          "type": "number"
        },
        "notes": {
          "label": "Notes",
          "description": "Internal notes about the contact",
          "type": "multiline"
        },
        "processorId": {
          "label": "Processor ID",
          "description": "The ID assigned by an external payment processor (e.g., Stripe customer ID)"
        },
        "processor": {
          "label": "Processor",
          "description": "The external platform where the contact was imported from (e.g., stripe)"
        }
      },
      "request": {
        "method": "POST",
        "url": "https://{{credential.account_name}}.quadernoapp.com/api/contacts",
        "headers": {
          "api_version": "20241028",
          "authorization": "Basic Y3JlZGVudGlhbDAwMXo6eA=="
        },
        "body": {
          "first_name": "{{firstName}}",
          "kind": "person",
          "country": "{{country}}",
          "last_name": "{{lastName}}",
          "email": "{{email}}",
          "full_name": "{{fullName}}",
          "city": "{{city}}",
          "postal_code": "{{postalCode}}",
          "region": "{{region}}",
          "street_line_1": "{{streetLine1}}",
          "street_line_2": "{{streetLine2}}",
          "tax_id": "{{taxId}}",
          "language": "{{language}}",
          "phone_1": "{{phone}}",
          "web": "{{website}}",
          "discount": "{{discount}}",
          "notes": "{{notes}}",
          "processor_id": "{{processorId}}",
          "processor": "{{processor}}"
        }
      }
    },
    "findContact": {
      "label": "Find Contact",
      "description": "Search and list contacts from Quaderno",
      "inputs": {
        "searchQuery": {
          "label": "Search Query",
          "description": "Search for contacts by name, email, or tax ID (optional)"
        },
        "processorId": {
          "label": "Processor ID",
          "description": "Filter by processor ID (optional)"
        },
        "limit": {
          "label": "Results Limit",
          "description": "Maximum number of results to return (default: 25, max: 100)",
          "type": "number",
          "defaultValue": "25"
        }
      },
      "request": {
        "method": "GET",
        "url": "https://{{credential.account_name}}.quadernoapp.com/api/contacts",
        "query": {
          "q": "{{searchQuery}}",
          "processor_id": "{{processorId}}",
          "limit": "{{limit}}"
        },
        "headers": {
          "api_version": "20241028",
          "authorization": "Basic Y3JlZGVudGlhbDAwMXo6eA=="
        }
      }
    },
    "createInvoice": {
      "label": "Create Invoice",
      "description": "Create a new invoice in Quaderno",
      "inputs": {
        "issueDate": {
          "label": "Issue Date",
          "description": "Date when the invoice was issued (YYYY-MM-DD)",
          "required": true
        },
        "currency": {
          "label": "Currency",
          "description": "3-letter ISO currency code (USD, EUR, GBP, etc.)",
          "required": true
        },
        "invoiceNumber": {
          "label": "Invoice Number",
          "description": "A unique, sequential code that identifies the invoice"
        },
        "dueDate": {
          "label": "Due Date",
          "description": "Date on which payment for this invoice is due (YYYY-MM-DD)"
        },
        "customerFirstName": {
          "label": "Customer First Name",
          "description": "The customer's first name",
          "required": true
        },
        "customerLastName": {
          "label": "Customer Last Name",
          "description": "The customer's last name"
        },
        "customerEmail": {
          "label": "Customer Email",
          "description": "The customer's email address"
        },
        "customerCountry": {
          "label": "Customer Country",
          "description": "2-letter ISO country code (e.g., US, GB)"
        },
        "itemDescription": {
          "label": "Item Description",
          "description": "Description of the invoice line item",
          "required": true
        },
        "itemQuantity": {
          "label": "Item Quantity",
          "description": "Quantity of the invoice item",
          "required": true,
          "type": "number"
        },
        "itemUnitCost": {
          "label": "Item Unit Cost",
          "description": "Unit cost of the invoice item",
          "required": true
        },
        "poNumber": {
          "label": "PO Number",
          "description": "Purchase order number"
        },
        "tagList": {
          "label": "Tags",
          "description": "Tags attached to the invoice (comma-separated)"
        },
        "notes": {
          "label": "Notes",
          "description": "Extra notes about the invoice"
        }
      },
      "request": {
        "method": "POST",
        "url": "https://{{credential.account_name}}.quadernoapp.com/api/invoices",
        "headers": {
          "api_version": "20241028",
          "authorization": "Basic Y3JlZGVudGlhbDAwMXo6eA=="
        },
        "body": {
          "issue_date": "{{issueDate}}",
          "currency": "{{currency}}",
          "contact": {
            "first_name": "{{customerFirstName}}",
            "kind": "person",
            "last_name": "{{customerLastName}}",
            "email": "{{customerEmail}}",
            "country": "{{customerCountry}}"
          },
          "items": [
            {
              "description": "{{itemDescription}}",
              "quantity": "{{itemQuantity}}",
              "unit_cost": "{{itemUnitCost}}"
            }
          ],
          "number": "{{invoiceNumber}}",
          "due_date": "{{dueDate}}",
          "po_number": "{{poNumber}}",
          "tag_list": [
            "{{tagList}}"
          ],
          "notes": "{{notes}}"
        }
      }
    }
  },
  "triggers": {}
}
