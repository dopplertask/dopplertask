{
  "name": "dust",
  "label": "Dust",
  "description": "Secure messaging and collaboration",
  "icon": "",
  "hosts": [
    "dust.tt"
  ],
  "upstream": {
    "package": "@activepieces/piece-dust",
    "version": "0.3.1"
  },
  "credential": {
    "fields": {
      "apiKey": {
        "label": "API key",
        "description": "",
        "secret": true,
        "required": true
      },
      "workspaceId": {
        "label": "Dust workspace ID",
        "description": "Can be found in any of the workspace's URL",
        "required": true
      },
      "region": {
        "label": "Region",
        "description": ""
      }
    },
    "headers": {
      "authorization": "Bearer {{credential.apiKey}}"
    }
  },
  "actions": {
    "createConversation": {
      "label": "Create conversation",
      "description": "Create a new conversation with a specific Dust assistant",
      "inputs": {
        "assistant": {
          "label": "Agent",
          "required": true
        },
        "username": {
          "label": "Username",
          "required": true
        },
        "timezone": {
          "label": "Time zone",
          "required": true,
          "defaultValue": "Europe/Paris"
        },
        "title": {
          "label": "Title"
        },
        "query": {
          "label": "Query",
          "type": "multiline"
        },
        "fragment": {
          "label": "Fragment",
          "type": "file"
        },
        "fileId": {
          "label": "File ID",
          "description": "ID of the file to be added to the conversation (takes precedence over Fragment)"
        },
        "fragmentName": {
          "label": "Fragment/file name"
        },
        "timeout": {
          "label": "Timeout (seconds)",
          "required": true,
          "type": "number",
          "defaultValue": "120"
        }
      },
      "request": {
        "method": "POST",
        "url": "https://dust.tt/api/v1/w/{{credential.workspaceId}}/assistant/conversations",
        "body": {
          "title": "{{title}}",
          "visibility": "unlisted",
          "message": {
            "content": "{{query}}",
            "mentions": [
              {
                "configurationId": "{{assistant}}"
              }
            ],
            "context": {
              "timezone": "{{timezone}}",
              "username": "{{username}}",
              "email": null,
              "fullName": null,
              "profilePictureUrl": null
            }
          },
          "contentFragment": {
            "title": "{{fragmentName}}",
            "fileId": "{{fileId}}"
          },
          "blocking": false,
          "skipToolsValidation": false
        }
      }
    }
  },
  "triggers": {}
}
