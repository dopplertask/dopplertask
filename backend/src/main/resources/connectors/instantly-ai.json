{
  "name": "instantly-ai",
  "label": "Instantly.ai",
  "description": "Powerful cold email outreach and lead engagement platform.",
  "icon": "",
  "hosts": [
    "api.instantly.ai"
  ],
  "upstream": {
    "package": "@activepieces/piece-instantly-ai",
    "version": "0.2.3"
  },
  "credential": {
    "fields": {
      "token": {
        "label": "API Key",
        "description": "\nYou can obtain an API key from **Settings->Integrations->API Keys**.\n",
        "secret": true,
        "required": true
      }
    },
    "headers": {
      "authorization": "Bearer {{credential.token}}"
    }
  },
  "actions": {
    "create_campaign": {
      "label": "Create Campaign",
      "description": "Create a new cold email campaign in Instantly",
      "inputs": {
        "name": {
          "label": "Campaign Name",
          "description": "Name of the campaign",
          "required": true
        },
        "schedule_time_from": {
          "label": "Schedule Time From",
          "description": "Start time in 24-hour format (e.g., \"09:00\")",
          "required": true,
          "defaultValue": "09:00"
        },
        "schedule_time_to": {
          "label": "Schedule Time To",
          "description": "End time in 24-hour format (e.g., \"17:00\")",
          "required": true,
          "defaultValue": "17:00"
        },
        "schedule_timezone": {
          "label": "Schedule Timezone",
          "description": "Timezone for the schedule i.e. \"America/Dawson\".",
          "required": true
        },
        "weekday_sending": {
          "label": "Send on Weekdays",
          "description": "Whether to send emails Monday-Friday",
          "type": "boolean",
          "defaultValue": "true"
        },
        "weekend_sending": {
          "label": "Send on Weekends",
          "description": "Whether to send emails Saturday-Sunday",
          "type": "boolean",
          "defaultValue": "false"
        },
        "start_date": {
          "label": "Start Date",
          "description": "Date to start the campaign"
        },
        "end_date": {
          "label": "End Date",
          "description": "Date to end the campaign"
        },
        "pl_value": {
          "label": "Positive Lead Value",
          "description": "Value of every positive lead",
          "type": "number"
        },
        "is_evergreen": {
          "label": "Is Evergreen",
          "description": "Whether the campaign is evergreen",
          "type": "boolean"
        },
        "email_gap": {
          "label": "Email Gap",
          "description": "Gap between emails in minutes",
          "type": "number"
        },
        "random_wait_max": {
          "label": "Maximum Random Wait Time",
          "description": "Maximum random wait time in minutes",
          "type": "number"
        },
        "text_only": {
          "label": "Text Only",
          "description": "Whether the campaign is text-only",
          "type": "boolean"
        },
        "daily_limit": {
          "label": "Daily Limit",
          "description": "Daily limit for sending emails",
          "type": "number"
        },
        "stop_on_reply": {
          "label": "Stop on Reply",
          "description": "Whether to stop campaign on reply",
          "type": "boolean"
        },
        "link_tracking": {
          "label": "Link Tracking",
          "description": "Whether to track links in emails",
          "type": "boolean"
        },
        "open_tracking": {
          "label": "Open Tracking",
          "description": "Whether to track opens in emails",
          "type": "boolean"
        },
        "stop_on_auto_reply": {
          "label": "Stop on Auto Reply",
          "description": "Whether to stop campaign on auto-reply",
          "type": "boolean"
        },
        "daily_max_leads": {
          "label": "Daily Maximum Leads",
          "description": "Maximum daily new leads to contact",
          "type": "number"
        },
        "prioritize_new_leads": {
          "label": "Prioritize New Leads",
          "description": "Whether to prioritize new leads",
          "type": "boolean"
        },
        "match_lead_esp": {
          "label": "Match Lead ESP",
          "description": "Whether to match leads by ESP",
          "type": "boolean"
        },
        "stop_for_company": {
          "label": "Stop for Company",
          "description": "Stop campaign for the company (domain) when a lead replies",
          "type": "boolean"
        },
        "insert_unsubscribe_header": {
          "label": "Insert Unsubscribe Header",
          "description": "Insert unsubscribe header in emails",
          "type": "boolean"
        },
        "allow_risky_contacts": {
          "label": "Allow Risky Contacts",
          "description": "Allow risky contacts",
          "type": "boolean"
        },
        "disable_bounce_protect": {
          "label": "Disable Bounce Protection",
          "description": "Disable bounce protection",
          "type": "boolean"
        }
      },
      "request": {
        "method": "POST",
        "url": "https://api.instantly.ai/api/v2/campaigns",
        "body": {
          "name": "{{name}}",
          "campaign_schedule": {
            "schedules": [
              {
                "name": "Default Schedule",
                "timing": {
                  "from": "{{schedule_time_from}}",
                  "to": "{{schedule_time_to}}"
                },
                "days": {},
                "timezone": "{{schedule_timezone}}"
              }
            ],
            "start_date": "{{start_date}}",
            "end_date": "{{end_date}}"
          },
          "pl_value": "{{pl_value}}",
          "email_gap": "{{email_gap}}",
          "random_wait_max": "{{random_wait_max}}",
          "daily_limit": "{{daily_limit}}",
          "daily_max_leads": "{{daily_max_leads}}"
        }
      }
    },
    "create_lead_list": {
      "label": "Create Lead List",
      "description": "Creates a new lead list.",
      "inputs": {
        "name": {
          "label": "List Name",
          "required": true
        },
        "has_enrichment_task": {
          "label": "Enable Enrichment",
          "description": "Whether this list runs the enrichment process on every added lead or not.",
          "type": "boolean",
          "defaultValue": "false"
        }
      },
      "request": {
        "method": "POST",
        "url": "https://api.instantly.ai/api/v2/lead-lists",
        "body": {
          "name": "{{name}}"
        }
      }
    }
  },
  "triggers": {}
}
