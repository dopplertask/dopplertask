{
  "name": "front",
  "label": "Front",
  "icon": "",
  "hosts": [
    "api2.frontapp.com"
  ],
  "baseUrl": "https://api2.frontapp.com",
  "upstream": {
    "package": "@activepieces/piece-front",
    "version": "0.2.3"
  },
  "credential": {
    "fields": {
      "token": {
        "label": "Front API Token",
        "description": "Your Front API token. You can create one from your Front settings under \"Developers\". Ensure the token has the necessary scopes.",
        "secret": true,
        "required": true
      }
    },
    "headers": {
      "Authorization": "Bearer {{credential.token}}"
    }
  },
  "actions": {
    "add_comment": {
      "label": "Add Comment",
      "description": "Add a comment (internal note) to a conversation in Front.",
      "inputs": {
        "conversation_id": {
          "label": "Conversation ID",
          "description": "Select the conversation",
          "required": true,
          "optionsFrom": {
            "request": {
              "url": "https://api2.frontapp.com/conversations"
            },
            "list": "$._results",
            "label": "$.subject",
            "value": "$.id"
          }
        },
        "author_id": {
          "label": "Teammate ID",
          "description": "Select the teammate",
          "required": true,
          "optionsFrom": {
            "request": {
              "url": "https://api2.frontapp.com/teammates?limit=50"
            },
            "list": "$._results",
            "label": "$.username",
            "value": "$.id"
          }
        },
        "body": {
          "label": "Comment Body",
          "description": "The content of the comment.",
          "type": "multiline",
          "required": true
        }
      },
      "request": {
        "method": "POST",
        "url": "https://api2.frontapp.com/conversations/{{conversation_id}}/comments",
        "body": {
          "body": "{{body}}",
          "author_id": "{{author_id}}"
        }
      }
    },
    "add_contact_handle": {
      "label": "Add Contact Handle",
      "description": "Add a handle (email, phone number, etc.) to an existing Contact.",
      "inputs": {
        "contact_id": {
          "label": "Contact ID",
          "description": "Select the contact",
          "required": true,
          "optionsFrom": {
            "request": {
              "url": "https://api2.frontapp.com/contacts?limit=50"
            },
            "list": "$._results",
            "label": "$.name",
            "value": "$.id"
          }
        },
        "handle_type": {
          "label": "Handle Type",
          "description": "Type of handle to add.",
          "type": "select",
          "required": true,
          "options": [
            {
              "value": "email",
              "label": "Email"
            },
            {
              "value": "phone",
              "label": "Phone"
            },
            {
              "value": "twitter",
              "label": "Twitter"
            },
            {
              "value": "facebook",
              "label": "Facebook"
            },
            {
              "value": "intercom",
              "label": "Intercom"
            },
            {
              "value": "front_chat",
              "label": "front_chat"
            },
            {
              "value": "custom",
              "label": "custom"
            }
          ]
        },
        "handle_value": {
          "label": "Handle Value",
          "description": "The value of the handle (e.g., email address, phone number).",
          "required": true
        }
      },
      "request": {
        "method": "POST",
        "url": "https://api2.frontapp.com/contacts/{{contact_id}}/handles",
        "body": {
          "source": "{{handle_type}}",
          "handle": "{{handle_value}}"
        }
      },
      "afterResponse": "return {success: true, message: 'Handle added successfully to ' + inputs.contact_id};"
    },
    "add_conversation_links": {
      "label": "Add Conversation Links",
      "description": "Link external references (URLs) to a conversation.",
      "inputs": {
        "conversation_id": {
          "label": "Conversation ID",
          "description": "Select the conversation",
          "required": true,
          "optionsFrom": {
            "request": {
              "url": "https://api2.frontapp.com/conversations"
            },
            "list": "$._results",
            "label": "$.subject",
            "value": "$.id"
          }
        },
        "link_ids": {
          "label": "Link IDs",
          "description": "Select one or more links",
          "type": "json",
          "optionsFrom": {
            "request": {
              "url": "https://api2.frontapp.com/links"
            },
            "list": "$._results",
            "label": "$.name",
            "value": "$.id"
          }
        }
      },
      "request": {
        "method": "POST",
        "url": "https://api2.frontapp.com/conversations/{{conversation_id}}/links",
        "body": {
          "link_ids": "{{link_ids}}"
        }
      },
      "afterResponse": "return {success: true, message: 'Links added to conversation ' + inputs.conversation_id + ' successfully'};"
    },
    "add_conversation_tags": {
      "label": "Add Conversation Tags",
      "description": "Add one or more tags to a conversation.",
      "inputs": {
        "conversation_id": {
          "label": "Conversation ID",
          "description": "Select the conversation",
          "required": true,
          "optionsFrom": {
            "request": {
              "url": "https://api2.frontapp.com/conversations"
            },
            "list": "$._results",
            "label": "$.subject",
            "value": "$.id"
          }
        },
        "tag_ids": {
          "label": "Tag IDs",
          "description": "Select one or more tags",
          "type": "json",
          "optionsFrom": {
            "request": {
              "url": "https://api2.frontapp.com/tags?limit=50"
            },
            "list": "$._results",
            "label": "$.name",
            "value": "$.id"
          }
        }
      },
      "request": {
        "method": "POST",
        "url": "https://api2.frontapp.com/conversations/{{conversation_id}}/tags",
        "body": {
          "tag_ids": "{{tag_ids}}"
        }
      },
      "afterResponse": "return {success: true, message: 'Tags added to conversation ' + inputs.conversation_id + ' successfully'};"
    },
    "assign_unassign_conversation": {
      "label": "Assign/Unassign Conversation",
      "description": "Assign a conversation to a teammate or remove assignment.",
      "inputs": {
        "conversation_id": {
          "label": "Conversation ID",
          "description": "Select the conversation",
          "required": true,
          "optionsFrom": {
            "request": {
              "url": "https://api2.frontapp.com/conversations"
            },
            "list": "$._results",
            "label": "$.subject",
            "value": "$.id"
          }
        },
        "assignee_id": {
          "label": "Teammate ID",
          "description": "Select the teammate",
          "required": true,
          "optionsFrom": {
            "request": {
              "url": "https://api2.frontapp.com/teammates?limit=50"
            },
            "list": "$._results",
            "label": "$.username",
            "value": "$.id"
          }
        }
      },
      "request": {
        "method": "PUT",
        "url": "https://api2.frontapp.com/conversations/{{conversation_id}}/assignee",
        "body": {
          "assignee_id": "{{assignee_id}}"
        }
      },
      "afterResponse": "return {success: true, message: 'Conversation ' + inputs.conversation_id + ' assignee changed successfully'};"
    },
    "create_account": {
      "label": "Create Account",
      "description": "Create a new account in Front.",
      "inputs": {
        "name": {
          "label": "Account Name",
          "description": "The name of the account to create.",
          "required": true
        },
        "description": {
          "label": "Description",
          "description": "A description for the account."
        },
        "domains": {
          "label": "Domains",
          "description": "List of domains associated with the account.",
          "type": "json"
        },
        "external_id": {
          "label": "External ID",
          "description": "An external identifier for the account."
        },
        "custom_fields": {
          "label": "Custom Fields",
          "description": "Custom fields for this account, as a JSON object.",
          "type": "json",
          "defaultValue": "{}"
        }
      },
      "request": {
        "method": "POST",
        "url": "https://api2.frontapp.com/accounts",
        "body": {
          "name": "{{name}}",
          "description": "{{description}}",
          "domains": "{{domains}}",
          "external_id": "{{external_id}}",
          "custom_fields": "{{custom_fields}}"
        }
      }
    },
    "create_contact": {
      "label": "Create Contact",
      "description": "Create a new contact in Front.",
      "inputs": {
        "name": {
          "label": "Name",
          "description": "The name of the contact."
        },
        "description": {
          "label": "Description",
          "description": "A description for the contact."
        },
        "handles": {
          "label": "Handles",
          "description": "List of contact handles (e.g., email, phone).",
          "type": "json",
          "required": true
        },
        "links": {
          "label": "Links",
          "description": "List of URLs associated with the contact.",
          "type": "json"
        },
        "group_names": {
          "label": "Group Names",
          "description": "List of group names to associate with the contact.",
          "type": "json"
        },
        "list_names": {
          "label": "Contact Lists",
          "description": "List of contact list names this contact belongs to. Front will create any that do not exist.",
          "type": "json"
        },
        "custom_fields": {
          "label": "Custom Fields",
          "description": "Custom fields for this contact, as a JSON object (e.g., {\"CRM ID\": \"12345\"}).",
          "type": "json",
          "defaultValue": "{}"
        }
      },
      "request": {
        "method": "POST",
        "url": "https://api2.frontapp.com/contacts",
        "body": {
          "handles": "{{handles}}",
          "description": "{{description}}",
          "name": "{{name}}",
          "links": "{{links}}",
          "group_names": "{{group_names}}",
          "list_names": "{{list_names}}",
          "custom_fields": "{{custom_fields}}"
        }
      }
    },
    "create_draft": {
      "label": "Create Draft",
      "description": "Create a draft message in Front.",
      "inputs": {
        "channel_id": {
          "label": "Channel ID",
          "description": "Select the channel",
          "required": true,
          "optionsFrom": {
            "request": {
              "url": "https://api2.frontapp.com/channels"
            },
            "list": "$._results",
            "label": "$.name",
            "value": "$.id"
          }
        },
        "to": {
          "label": "To",
          "description": "List of recipient handles (email addresses, etc.).",
          "type": "json",
          "required": true
        },
        "cc": {
          "label": "CC",
          "description": "List of CC recipient handles.",
          "type": "json"
        },
        "bcc": {
          "label": "BCC",
          "description": "List of BCC recipient handles.",
          "type": "json"
        },
        "subject": {
          "label": "Subject",
          "description": "The subject of the draft."
        },
        "body": {
          "label": "Body",
          "description": "The body of the draft message.",
          "type": "multiline",
          "required": true
        },
        "mode": {
          "label": "Mode",
          "description": "Mode of the draft reply",
          "type": "select",
          "required": true,
          "defaultValue": "private",
          "options": [
            {
              "value": "private",
              "label": "Private"
            },
            {
              "value": "shared",
              "label": "Shared"
            }
          ]
        },
        "signature_id": {
          "label": "Signature ID",
          "description": "The ID of the signature to use for the draft reply (if applicable)."
        },
        "should_add_default_signature": {
          "label": "Add Default Signature",
          "description": "Whether to append the default signature to the draft reply (if applicable).",
          "type": "boolean",
          "defaultValue": "false"
        }
      },
      "request": {
        "method": "POST",
        "url": "https://api2.frontapp.com/channels/{{channel_id}}/drafts",
        "body": {
          "channel_id": "{{channel_id}}",
          "to": "{{to}}",
          "body": "{{body}}",
          "cc": "{{cc}}",
          "bcc": "{{bcc}}",
          "subject": "{{subject}}",
          "mode": "{{mode}}",
          "signature_id": "{{signature_id}}",
          "should_add_default_signature": "{{should_add_default_signature}}"
        }
      }
    },
    "create_draft_reply": {
      "label": "Create Draft Reply",
      "description": "Create a draft reply to an existing conversation (subject/quote etc.) without sending immediately.",
      "inputs": {
        "conversation_id": {
          "label": "Conversation ID",
          "description": "Select the conversation",
          "required": true,
          "optionsFrom": {
            "request": {
              "url": "https://api2.frontapp.com/conversations"
            },
            "list": "$._results",
            "label": "$.subject",
            "value": "$.id"
          }
        },
        "body": {
          "label": "Message Body",
          "description": "The content of the draft reply.",
          "type": "multiline",
          "required": true
        },
        "subject": {
          "label": "Subject",
          "description": "The subject of the draft reply (for email channels)."
        },
        "author_id": {
          "label": "Teammate ID",
          "description": "Select the teammate",
          "required": true,
          "optionsFrom": {
            "request": {
              "url": "https://api2.frontapp.com/teammates?limit=50"
            },
            "list": "$._results",
            "label": "$.username",
            "value": "$.id"
          }
        },
        "channel_id": {
          "label": "Channel ID",
          "description": "Select the channel",
          "required": true,
          "optionsFrom": {
            "request": {
              "url": "https://api2.frontapp.com/channels"
            },
            "list": "$._results",
            "label": "$.name",
            "value": "$.id"
          }
        },
        "to": {
          "label": "To",
          "description": "List of recipient handles (email addresses, etc.).",
          "type": "json"
        },
        "cc": {
          "label": "CC",
          "description": "List of CC recipient handles.",
          "type": "json"
        },
        "bcc": {
          "label": "BCC",
          "description": "List of BCC recipient handles.",
          "type": "json"
        },
        "mode": {
          "label": "Mode",
          "description": "Mode of the draft reply",
          "type": "select",
          "required": true,
          "defaultValue": "private",
          "options": [
            {
              "value": "private",
              "label": "Private"
            },
            {
              "value": "shared",
              "label": "Shared"
            }
          ]
        },
        "signature_id": {
          "label": "Signature ID",
          "description": "The ID of the signature to use for the draft reply (if applicable)."
        },
        "should_add_default_signature": {
          "label": "Add Default Signature",
          "description": "Whether to append the default signature to the draft reply (if applicable).",
          "type": "boolean",
          "defaultValue": "false"
        }
      },
      "request": {
        "method": "POST",
        "url": "https://api2.frontapp.com/conversations/{{conversation_id}}/drafts",
        "body": {
          "body": "{{body}}",
          "subject": "{{subject}}",
          "author_id": "{{author_id}}",
          "channel_id": "{{channel_id}}",
          "to": "{{to}}",
          "cc": "{{cc}}",
          "bcc": "{{bcc}}",
          "mode": "{{mode}}",
          "signature_id": "{{signature_id}}",
          "should_add_default_signature": "{{should_add_default_signature}}"
        }
      }
    },
    "create_link": {
      "label": "Create Link",
      "description": "Create a Link in Front (name, external URL).",
      "inputs": {
        "name": {
          "label": "Name",
          "description": "The name of the link.",
          "required": true
        },
        "external_url": {
          "label": "External URL",
          "description": "The external URL for the link.",
          "required": true
        },
        "pattern": {
          "label": "Pattern",
          "description": "Optional pattern to match URLs (regex)."
        }
      },
      "request": {
        "method": "POST",
        "url": "https://api2.frontapp.com/links",
        "body": {
          "name": "{{name}}",
          "external_url": "{{external_url}}",
          "pattern": "{{pattern}}"
        }
      }
    },
    "find_account": {
      "label": "Find Account",
      "description": "List company accounts and optionally filter by email domain or external ID.",
      "inputs": {
        "email_domain": {
          "label": "Email Domain",
          "description": "Filter accounts by email domain "
        },
        "external_id": {
          "label": "External ID",
          "description": "Filter accounts by external ID"
        },
        "limit": {
          "label": "Limit",
          "description": "Maximum number of accounts to return (max 100).",
          "type": "number"
        },
        "page_token": {
          "label": "Page Token",
          "description": "Token for pagination."
        },
        "sort_by": {
          "label": "Sort By",
          "description": "Field used to sort the accounts.",
          "type": "select",
          "options": [
            {
              "value": "created_at",
              "label": "Created At"
            },
            {
              "value": "updated_at",
              "label": "Updated At"
            }
          ]
        },
        "sort_order": {
          "label": "Sort Order",
          "description": "Order by which results should be sorted.",
          "type": "select",
          "options": [
            {
              "value": "asc",
              "label": "Ascending"
            },
            {
              "value": "desc",
              "label": "Descending"
            }
          ]
        }
      },
      "request": {
        "method": "GET",
        "url": "https://api2.frontapp.com/accounts"
      },
      "afterResponse": "let found = response._results || response.results || response.accounts || [];\nif (inputs.email_domain) found = found.filter(a => a.email_domain === inputs.email_domain);\nif (inputs.external_id) found = found.filter(a => a.external_id === inputs.external_id);\nreturn found;"
    },
    "find_conversation": {
      "label": "Find Conversation",
      "description": "Find a conversation by search filters such as subject, participants, tags, inbox, etc.",
      "inputs": {
        "q": {
          "label": "Query",
          "description": "Front query string (e.g. subject:\"Order\", tag_ids:tag_123, inbox_id:inb_456, etc.). See https://dev.frontapp.com/docs/search-1",
          "required": true
        },
        "limit": {
          "label": "Limit",
          "description": "Maximum number of conversations to return.",
          "type": "number"
        },
        "page_token": {
          "label": "Page Token",
          "description": "Token for pagination."
        }
      },
      "request": {
        "method": "GET",
        "url": "https://api2.frontapp.com/conversations/search",
        "query": {
          "q": "{{q}}",
          "limit": "{{limit}}",
          "page_token": "{{page_token}}"
        }
      }
    },
    "send_message": {
      "label": "Send Message",
      "description": "Send a new message (starts a conversation) with subject, recipients, body, tags, etc.",
      "inputs": {
        "channel_id": {
          "label": "Channel ID",
          "description": "Select the channel",
          "required": true,
          "optionsFrom": {
            "request": {
              "url": "https://api2.frontapp.com/channels"
            },
            "list": "$._results",
            "label": "$.name",
            "value": "$.id"
          }
        },
        "to": {
          "label": "To",
          "description": "List of recipient handles (email addresses, etc.).",
          "type": "json",
          "required": true
        },
        "cc": {
          "label": "CC",
          "description": "List of CC recipient handles.",
          "type": "json"
        },
        "bcc": {
          "label": "BCC",
          "description": "List of BCC recipient handles.",
          "type": "json"
        },
        "subject": {
          "label": "Subject",
          "description": "The subject of the message."
        },
        "body": {
          "label": "Body",
          "description": "The body of the message.",
          "type": "multiline",
          "required": true
        },
        "tag_ids": {
          "label": "Tag IDs",
          "description": "Select one or more tags",
          "type": "json",
          "optionsFrom": {
            "request": {
              "url": "https://api2.frontapp.com/tags?limit=50"
            },
            "list": "$._results",
            "label": "$.name",
            "value": "$.id"
          }
        }
      },
      "request": {
        "method": "POST",
        "url": "https://api2.frontapp.com/channels/{{channel_id}}/messages",
        "body": {
          "channel_id": "{{channel_id}}",
          "to": "{{to}}",
          "body": "{{body}}",
          "cc": "{{cc}}",
          "bcc": "{{bcc}}",
          "subject": "{{subject}}",
          "tag_ids": "{{tag_ids}}"
        }
      }
    },
    "send_reply": {
      "label": "Send Reply",
      "description": "Send a reply to a conversation in Front.",
      "inputs": {
        "conversation_id": {
          "label": "Conversation ID",
          "description": "Select the conversation",
          "required": true,
          "optionsFrom": {
            "request": {
              "url": "https://api2.frontapp.com/conversations"
            },
            "list": "$._results",
            "label": "$.subject",
            "value": "$.id"
          }
        },
        "body": {
          "label": "Message Body",
          "description": "The content of the reply message.",
          "type": "multiline",
          "required": true
        },
        "author_id": {
          "label": "Teammate ID",
          "description": "Select the teammate",
          "required": true,
          "optionsFrom": {
            "request": {
              "url": "https://api2.frontapp.com/teammates?limit=50"
            },
            "list": "$._results",
            "label": "$.username",
            "value": "$.id"
          }
        },
        "subject": {
          "label": "Subject",
          "description": "The subject of the reply (for email channels)."
        },
        "to": {
          "label": "To",
          "description": "List of recipient handles (email addresses, etc.).",
          "type": "json"
        },
        "cc": {
          "label": "CC",
          "description": "List of CC recipient handles.",
          "type": "json"
        },
        "bcc": {
          "label": "BCC",
          "description": "List of BCC recipient handles.",
          "type": "json"
        },
        "channel_id": {
          "label": "Channel ID",
          "description": "Select the channel",
          "required": true,
          "optionsFrom": {
            "request": {
              "url": "https://api2.frontapp.com/channels"
            },
            "list": "$._results",
            "label": "$.name",
            "value": "$.id"
          }
        }
      },
      "request": {
        "method": "POST",
        "url": "https://api2.frontapp.com/conversations/{{conversation_id}}/messages",
        "body": {
          "body": "{{body}}",
          "author_id": "{{author_id}}",
          "subject": "{{subject}}",
          "to": "{{to}}",
          "cc": "{{cc}}",
          "bcc": "{{bcc}}",
          "channel_id": "{{channel_id}}"
        }
      }
    },
    "update_account": {
      "label": "Update Account",
      "description": "Update an existing account in Front.",
      "inputs": {
        "account_id": {
          "label": "Account ID",
          "description": "Select the account",
          "required": true,
          "optionsFrom": {
            "request": {
              "url": "https://api2.frontapp.com/accounts"
            },
            "list": "$._results",
            "label": "$.name",
            "value": "$.id"
          }
        },
        "name": {
          "label": "Account Name",
          "description": "The new name for the account."
        },
        "description": {
          "label": "Description",
          "description": "The new description for the account."
        },
        "domains": {
          "label": "Domains",
          "description": "List of domains associated with the account.",
          "type": "json"
        },
        "custom_fields": {
          "label": "Custom Fields",
          "description": "Custom fields to add or update. Existing fields will be preserved.",
