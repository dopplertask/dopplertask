{
  "name": "help-scout",
  "label": "Help Scout",
  "description": "",
  "icon": "",
  "hosts": [
    "api.helpscout.net"
  ],
  "upstream": {
    "package": "@activepieces/piece-help-scout",
    "version": "0.3.0"
  },
  "credential": {
    "oauth2": {
      "authUrl": "https://secure.helpscout.net/authentication/authorizeClientApplication",
      "tokenUrl": "https://api.helpscout.net/v2/oauth2/token",
      "scope": ""
    }
  },
  "actions": {
    "ai_send_reply": {
      "label": "Send Reply (by ID)",
      "description": "Sends a reply in a conversation identified by its ID.",
      "inputs": {
        "conversationId": {
          "label": "Conversation ID",
          "description": "Numeric Help Scout conversation ID (the id field from Search Conversations, not the #number shown in the UI).",
          "required": true,
          "type": "number"
        },
        "text": {
          "label": "Reply Text",
          "description": "HTML is allowed.",
          "required": true,
          "type": "multiline"
        },
        "customerId": {
          "label": "Customer ID",
          "description": "Takes precedence over Customer Email.",
          "type": "number"
        },
        "customerEmail": {
          "label": "Customer Email"
        },
        "draft": {
          "label": "Save As Draft",
          "description": "yes saves a draft without sending; leave empty to send.",
          "type": "select",
          "options": [
            {
              "value": "yes",
              "label": "Yes"
            },
            {
              "value": "no",
              "label": "No"
            }
          ]
        },
        "status": {
          "label": "Conversation Status After Reply",
          "type": "select",
          "options": [
            {
              "value": "active",
              "label": "Active"
            },
            {
              "value": "pending",
              "label": "Pending"
            },
            {
              "value": "closed",
              "label": "Closed"
            },
            {
              "value": "spam",
              "label": "Spam"
            }
          ]
        },
        "userId": {
          "label": "Sent By User ID",
          "description": "Defaults to the connected user.",
          "type": "number"
        },
        "cc": {
          "label": "CC Emails",
          "type": "json"
        },
        "bcc": {
          "label": "BCC Emails",
          "type": "json"
        }
      },
      "request": {
        "method": "POST",
        "url": "https://api.helpscout.net/v2/conversations/{{conversationId}}/reply",
        "body": {
          "text": "{{text}}",
          "customer": {
            "id": "{{customerId}}"
          },
          "user": "{{userId}}"
        }
      }
    },
    "ai_add_note": {
      "label": "Add Note (by ID)",
      "description": "Adds an internal note to a conversation identified by its ID.",
      "inputs": {
        "conversationId": {
          "label": "Conversation ID",
          "description": "Numeric Help Scout conversation ID (the id field from Search Conversations, not the #number shown in the UI).",
          "required": true,
          "type": "number"
        },
        "text": {
          "label": "Note Text",
          "description": "HTML is allowed.",
          "required": true,
          "type": "multiline"
        },
        "userId": {
          "label": "Author User ID",
          "description": "Defaults to the connected user.",
          "type": "number"
        }
      },
      "request": {
        "method": "POST",
        "url": "https://api.helpscout.net/v2/conversations/{{conversationId}}/notes",
        "body": {
          "text": "{{text}}",
          "user": "{{userId}}"
        }
      }
    },
    "get_conversation": {
      "label": "Get Conversation",
      "description": "Gets one conversation by ID.",
      "inputs": {
        "conversationId": {
          "label": "Conversation ID",
          "description": "Numeric Help Scout conversation ID (the id field from Search Conversations, not the #number shown in the UI).",
          "required": true,
          "type": "number"
        },
        "includeThreads": {
          "label": "Include Threads",
          "type": "select",
          "options": [
            {
              "value": "yes",
              "label": "Yes"
            },
            {
              "value": "no",
              "label": "No"
            }
          ],
          "defaultValue": "yes"
        }
      },
      "request": {
        "method": "GET",
        "url": "https://api.helpscout.net/v2/conversations/{{conversationId}}",
        "query": {
          "embed": "threads"
        }
      }
    },
    "get_customer": {
      "label": "Get Customer",
      "description": "Gets one customer by ID.",
      "inputs": {
        "customerId": {
          "label": "Customer ID",
          "required": true,
          "type": "number"
        }
      },
      "request": {
        "method": "GET",
        "url": "https://api.helpscout.net/v2/customers/{{customerId}}"
      }
    }
  },
  "triggers": {}
}
