{
  "name": "shippo",
  "label": "Shippo",
  "description": "Multi-carrier shipping platform for real-time rates, labels, and tracking",
  "icon": "",
  "hosts": [
    "api.goshippo.com"
  ],
  "upstream": {
    "package": "@activepieces/piece-shippo",
    "version": "0.1.8"
  },
  "credential": {
    "fields": {
      "token": {
        "label": "API Token",
        "description": "Your Shippo API token",
        "secret": true,
        "required": true
      }
    },
    "headers": {
      "authorization": "ShippoToken {{credential.token}}"
    }
  },
  "actions": {
    "create_order": {
      "label": "Create Order",
      "description": "Create a new order in Shippo",
      "inputs": {
        "order_number": {
          "label": "Order Number",
          "description": "Custom reference number for the order",
          "required": true
        },
        "order_status": {
          "label": "Order Status",
          "description": "Current status of the order",
          "required": true,
          "type": "select",
          "options": [
            {
              "value": "UNKNOWN",
              "label": "Unknown"
            },
            {
              "value": "AWAITPAY",
              "label": "Awaiting Payment"
            },
            {
              "value": "PAID",
              "label": "Paid"
            },
            {
              "value": "REFUNDED",
              "label": "Refunded"
            },
            {
              "value": "CANCELLED",
              "label": "Cancelled"
            },
            {
              "value": "PARTIALLY_FULFILLED",
              "label": "Partially Fulfilled"
            },
            {
              "value": "SHIPPED",
              "label": "Shipped"
            }
          ],
          "defaultValue": "AWAITPAY"
        },
        "placed_at": {
          "label": "Order Date",
          "description": "When the order was placed by the buyer (mandatory) - Format: 2025-10-31T11:56:29.244Z",
          "required": true
        },
        "total_price": {
          "label": "Total Price",
          "description": "Total price including shipping and tax",
          "required": true
        },
        "subtotal_price": {
          "label": "Subtotal Price",
          "description": "Price before shipping and tax (optional)"
        },
        "total_tax": {
          "label": "Total Tax",
          "description": "Total tax amount"
        },
        "currency": {
          "label": "Currency",
          "description": "Currency code (e.g., USD, EUR)",
          "required": true,
          "defaultValue": "USD"
        },
        "from_name": {
          "label": "Sender Name",
          "description": "Name of the sender"
        },
        "from_company": {
          "label": "Sender Company",
          "description": "Company name of the sender"
        },
        "from_street1": {
          "label": "Sender Street Address",
          "description": "Street address line 1"
        },
        "from_city": {
          "label": "Sender City",
          "description": "City"
        },
        "from_state": {
          "label": "Sender State",
          "description": "State/Province"
        },
        "from_zip": {
          "label": "Sender ZIP Code",
          "description": "ZIP/Postal code"
        },
        "from_country": {
          "label": "Sender Country",
          "description": "Two-letter country code (e.g., US)",
          "defaultValue": "US"
        },
        "from_phone": {
          "label": "Sender Phone"
        },
        "from_email": {
          "label": "Sender Email"
        },
        "to_name": {
          "label": "Recipient Name",
          "description": "Name of the recipient",
          "required": true
        },
        "to_company": {
          "label": "Recipient Company",
          "description": "Company name of the recipient"
        },
        "to_street1": {
          "label": "Recipient Street Address",
          "description": "Street address line 1",
          "required": true
        },
        "to_city": {
          "label": "Recipient City",
          "description": "City",
          "required": true
        },
        "to_state": {
          "label": "Recipient State",
          "description": "State/Province",
          "required": true
        },
        "to_zip": {
          "label": "Recipient ZIP Code",
          "description": "ZIP/Postal code",
          "required": true
        },
        "to_country": {
          "label": "Recipient Country",
          "description": "Two-letter country code (e.g., US)",
          "required": true,
          "defaultValue": "US"
        },
        "to_phone": {
          "label": "Recipient Phone"
        },
        "to_email": {
          "label": "Recipient Email"
        },
        "line_item_title": {
          "label": "Item Title",
          "description": "Name/description of the item (optional)"
        },
        "line_item_quantity": {
          "label": "Item Quantity",
          "type": "number",
          "defaultValue": "1"
        },
        "line_item_total_price": {
          "label": "Item Total Price",
          "description": "Total price for this line item (quantity × unit price)"
        },
        "line_item_sku": {
          "label": "Item SKU",
          "description": "Stock keeping unit"
        },
        "line_item_weight": {
          "label": "Item Weight",
          "description": "Weight of a single item (e.g., \"0.5\")"
        },
        "line_item_weight_unit": {
          "label": "Item Weight Unit",
          "type": "select",
          "options": [
            {
              "value": "lb",
              "label": "Pounds (lb)"
            },
            {
              "value": "oz",
              "label": "Ounces (oz)"
            },
            {
              "value": "kg",
              "label": "Kilograms (kg)"
            },
            {
              "value": "g",
              "label": "Grams (g)"
            }
          ],
          "defaultValue": "lb"
        },
        "weight": {
          "label": "Total Package Weight",
          "description": "Total weight of the package for shipping (e.g., \"2.5\")",
          "required": true
        },
        "weight_unit": {
          "label": "Package Weight Unit",
          "description": "Unit for total package weight",
          "type": "select",
          "options": [
            {
              "value": "lb",
              "label": "Pounds (lb)"
            },
            {
              "value": "oz",
              "label": "Ounces (oz)"
            },
            {
              "value": "kg",
              "label": "Kilograms (kg)"
            },
            {
              "value": "g",
              "label": "Grams (g)"
            }
          ],
          "defaultValue": "lb"
        },
        "shipping_cost": {
          "label": "Shipping Cost",
          "description": "Shipping cost amount (e.g., \"5.99\")"
        },
        "shipping_cost_currency": {
          "label": "Shipping Cost Currency",
          "description": "Currency for shipping cost",
          "defaultValue": "USD"
        },
        "shipping_method": {
          "label": "Shipping Method",
          "description": "Shipping method name (e.g., \"USPS First Class Package\") - optional"
        },
        "additional_line_items": {
          "label": "Additional Line Items",
          "description": "Additional line items in JSON format. Example: [{\"title\": \"Product 2\", \"quantity\": 2, \"total_price\": \"20.00\"}]",
          "type": "json"
        }
      },
      "request": {
        "method": "POST",
        "url": "https://api.goshippo.com/orders",
        "body": {
          "order_number": "{{order_number}}",
          "placed_at": "{{placed_at}}",
          "total_price": "{{total_price}}",
          "currency": "{{currency}}",
          "to_address": {
            "name": "{{to_name}}",
            "street1": "{{to_street1}}",
            "city": "{{to_city}}",
            "state": "{{to_state}}",
            "zip": "{{to_zip}}",
            "country": "{{to_country}}",
            "company": "{{to_company}}",
            "phone": "{{to_phone}}",
            "email": "{{to_email}}"
          },
          "from_address": {
            "name": "{{from_name}}",
            "street1": "{{from_street1}}",
            "city": "{{from_city}}",
            "state": "{{from_state}}",
            "zip": "{{from_zip}}",
            "country": "{{from_country}}",
            "company": "{{from_company}}",
            "phone": "{{from_phone}}",
            "email": "{{from_email}}"
          },
          "line_items": [
            {
              "title": "{{line_item_title}}",
              "quantity": "{{line_item_quantity}}",
              "total_price": "{{line_item_total_price}}",
              "currency": "{{currency}}",
              "sku": "{{line_item_sku}}",
              "weight": "{{line_item_weight}}"
            }
          ],
          "subtotal_price": "{{subtotal_price}}",
          "total_tax": "{{total_tax}}",
          "weight": "{{weight}}",
          "shipping_cost": "{{shipping_cost}}",
          "shipping_cost_currency": "{{shipping_cost_currency}}",
          "shipping_method": "{{shipping_method}}"
        }
      }
    },
    "find_order": {
      "label": "Find Order",
      "description": "Search for an order by its ID",
      "inputs": {
        "order_id": {
          "label": "Order ID",
          "description": "The ID of the order to find",
          "required": true
        }
      },
      "request": {
        "method": "GET",
        "url": "https://api.goshippo.com/orders/{{order_id}}"
      }
    },
    "find_shipping_label": {
      "label": "Find Shipping Label",
      "description": "Search for a shipping label by its ID",
      "inputs": {
        "label_id": {
          "label": "Label ID",
          "description": "The ID of the shipping label to find",
          "required": true
        }
      },
      "request": {
        "method": "GET",
        "url": "https://api.goshippo.com/transactions/{{label_id}}"
      }
    }
  },
  "triggers": {}
}
