          "phone": "{{phone}}",
          "status": "{{status}}",
          "company_id": "{{company_id}}",
          "owner_id": "{{owner_id}}",
          "assigned_to": "{{assigned_to}}"
        }
      }
    },
    "ai_create_deal": {
      "label": "Create Deal",
      "description": "Creates a deal.",
      "inputs": {
        "name": {
          "label": "Name",
          "description": "Deal name.",
          "required": true
        },
        "value": {
          "label": "Value",
          "description": "Deal value as a plain number, e.g. 1500.",
          "type": "number"
        },
        "status": {
          "label": "Status",
          "description": "Deal status. Default Open.",
          "type": "select",
          "options": [
            {
              "value": "Open",
              "label": "Open"
            },
            {
              "value": "In Progress",
              "label": "In Progress"
