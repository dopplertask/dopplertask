          "required": true
        }
      },
      "request": {
        "method": "GET",
        "url": "https://{{credential.base_url}}/orders/{{orderId}}"
      }
    },
    "get_pipeline": {
      "label": "Get Pipeline",
      "description": "Gets one pipeline by ID.",
      "inputs": {
        "pipelineId": {
          "label": "Pipeline",
          "description": "Select a pipeline.",
          "required": true
        }
      },
      "request": {
        "method": "GET",
        "url": "https://{{credential.base_url}}/pipelines/{{pipelineId}}"
      }
    },
    "get_product": {
      "label": "Get Product",
      "description": "Gets one product by ID.",
      "inputs": {
        "productId": {
          "label": "Product",
          "description": "Select a product.",
          "required": true
        }
      },
      "request": {
        "method": "GET",
        "url": "https://{{credential.base_url}}/products/{{productId}}"
      }
    },
    "get_project": {
      "label": "Get Project",
      "description": "Gets one project by ID.",
      "inputs": {
        "projectId": {
          "label": "Project",
          "description": "Select a project.",
          "required": true
        }
      },
      "request": {
        "method": "GET",
        "url": "https://{{credential.base_url}}/projects/{{projectId}}"
      }
    },
    "get_task": {
      "label": "Get Task",
      "description": "Gets one task of a project.",
      "inputs": {
        "projectId": {
          "label": "Project",
          "description": "Select a project.",
          "required": true
        },
        "taskId": {
          "label": "Task",
          "description": "Select a task. Pick the project first.",
          "required": true
        }
      },
      "request": {
        "method": "GET",
        "url": "https://{{credential.base_url}}/projects/{{projectId}}/tasks/{{taskId}}"
      }
    },
    "update_company": {
      "label": "Update Company",
      "description": "Updates a company. Fields left blank keep their value; use Clear Fields to empty them.",
      "inputs": {
        "companyId": {
          "label": "Company",
          "description": "Select a company, or type to search.",
          "required": true
        },
        "name": {
          "label": "Name"
        },
        "email": {
          "label": "Email"
        },
        "phone": {
          "label": "Phone"
        },
        "website": {
          "label": "Website"
        },
        "industry": {
          "label": "Industry"
        },
        "status": {
          "label": "Status"
        },
        "owner": {
          "label": "Owner",
          "description": "Workspace member who owns the company (owner_id)."
        },
        "customFields": {
          "label": "Custom Fields",
          "description": "Custom field values by field key. Keys you leave out keep their current value; set a key to an empty value to clear it.",
          "type": "json"
        },
        "clearFields": {
          "label": "Clear Fields",
          "description": "Fields to empty on the record. A field you clear here must be left blank above.",
          "type": "json",
          "options": [
            {
              "value": "email",
              "label": "Email"
            },
            {
              "value": "phone",
              "label": "Phone"
            },
            {
              "value": "website",
              "label": "Website"
            },
            {
              "value": "industry",
              "label": "Industry"
            },
            {
              "value": "status",
              "label": "Status"
            }
          ]
        }
      },
      "request": {
        "method": "PUT",
        "url": "https://{{credential.base_url}}/companies/{{companyId}}",
        "body": {
          "name": "{{name}}",
          "email": "{{email}}",
          "phone": "{{phone}}",
          "website": "{{website}}",
          "industry": "{{industry}}",
          "status": "{{status}}",
          "owner_id": "{{owner}}"
        }
      }
    },
    "update_contact": {
      "label": "Update Contact",
      "description": "Updates a contact. Fields left blank keep their value; use Clear Fields to empty them.",
      "inputs": {
        "contactId": {
          "label": "Contact",
          "description": "Select a contact, or type to search.",
          "required": true
        },
        "firstName": {
          "label": "First Name"
        },
        "lastName": {
          "label": "Last Name"
        },
        "email": {
          "label": "Email",
          "description": "Email address of the contact. NinjaPipe allows one contact per email."
        },
        "phone": {
          "label": "Phone"
        },
        "status": {
          "label": "Status",
          "description": "Contact status, e.g. Active or Lead."
        },
        "companyId": {
          "label": "Company",
          "description": "Select a company, or type to search."
        },
        "owner": {
          "label": "Owner",
          "description": "Workspace member who owns the contact (owner_id). Defaults to the API key owner."
        },
        "assignedTo": {
          "label": "Assigned To",
          "description": "Workspace member shown as \"Assign to\" in NinjaPipe (assigned_to)."
        },
        "customFields": {
          "label": "Custom Fields",
          "description": "Custom field values by field key. Keys you leave out keep their current value; set a key to an empty value to clear it.",
          "type": "json"
        },
        "clearFields": {
          "label": "Clear Fields",
          "description": "Fields to empty on the record. A field you clear here must be left blank above.",
          "type": "json",
          "options": [
            {
              "value": "first_name",
              "label": "First Name"
            },
            {
              "value": "last_name",
              "label": "Last Name"
            },
            {
              "value": "phone",
              "label": "Phone"
            },
            {
              "value": "company_id",
              "label": "Company"
            },
            {
              "value": "assigned_to",
              "label": "Assigned To"
            }
          ]
        }
      },
      "request": {
        "method": "PUT",
        "url": "https://{{credential.base_url}}/contacts/{{contactId}}",
        "body": {
          "first_name": "{{firstName}}",
          "last_name": "{{lastName}}",
          "email": "{{email}}",
          "phone": "{{phone}}",
          "status": "{{status}}",
          "company_id": "{{companyId}}",
          "owner_id": "{{owner}}",
          "assigned_to": "{{assignedTo}}"
        }
      }
    },
