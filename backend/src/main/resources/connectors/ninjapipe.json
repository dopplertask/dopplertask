    "ai_create_contact": {
      "label": "Create Contact",
      "description": "Creates a contact.",
      "inputs": {
        "first_name": {
          "label": "First Name",
          "description": "First name."
        },
        "last_name": {
          "label": "Last Name",
          "description": "Last name."
        },
        "email": {
          "label": "Email",
          "description": "Email address, unique per workspace."
        },
        "phone": {
          "label": "Phone",
          "description": "Phone number."
        },
        "status": {
          "label": "Status",
          "description": "Contact status, e.g. Active or Lead. Defaults to Active."
        },
        "company_id": {
          "label": "Company ID",
          "description": "Company UUID from ai_search_companies."
        },
        "owner_id": {
          "label": "Owner ID",
          "description": "Owner account_id from ai_list_workspace_members. Defaults to the API key owner."
        },
        "assigned_to": {
          "label": "Assigned To",
