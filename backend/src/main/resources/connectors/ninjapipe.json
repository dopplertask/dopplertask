{
  "name": "ninjapipe",
  "label": "NinjaPipe",
  "description": "NinjaPipe CRM integration with contacts, companies, deals, tasks (under projects), pipelines and pipeline items, products, budgets, projects, orders, lists, and Databin webhook delivery.",
  "icon": "",
  "hosts": [
    "{{credential.base_url}}"
  ],
  "upstream": {
    "package": "@activepieces/piece-ninjapipe",
    "version": "0.2.2"
  },
  "credential": {
    "fields": {
      "base_url": {
        "label": "API Base URL",
        "description": "Your workspace API base URL (e.g. https://www.ninjapipe.app/api). The host only, without https://, such as name.example.com.",
        "required": true
      },
      "api_key": {
        "label": "API Key",
        "description": "Your workspace API key from NinjaPipe Settings > API.",
        "secret": true,
        "required": true
      }
    },
    "headers": {
      "authorization": "Bearer {{credential.api_key}}"
    }
  },
  "actions": {
    "add_contact_note": {
      "label": "Add Note to Contact",
      "description": "Adds a note to a contact's activity timeline.",
      "inputs": {
        "contactId": {
          "label": "Contact",
          "description": "Select a contact, or type to search.",
          "required": true
        },
        "title": {
          "label": "Title",
          "required": true
        },
        "content": {
          "label": "Content",
          "type": "multiline"
        },
        "date": {
          "label": "Date",
          "description": "When the note happened. Defaults to now."
        }
      },
      "request": {
        "method": "POST",
        "url": "https://{{credential.base_url}}/contacts/{{contactId}}/activities",
        "body": {
          "type": "note",
          "title": "{{title}}",
          "content": "{{content}}",
          "date": "{{date}}"
        }
      }
    },
    "create_company": {
      "label": "Create Company",
      "description": "Creates a company.",
      "inputs": {
        "name": {
          "label": "Name",
          "required": true
        },
        "email": {
          "label": "Email"
        },
        "phone": {
          "label": "Phone"
        },
        "website": {
          "label": "Website"
        },
        "industry": {
          "label": "Industry"
        },
        "status": {
          "label": "Status"
        },
        "owner": {
          "label": "Owner",
          "description": "Workspace member who owns the company (owner_id)."
        },
        "customFields": {
          "label": "Custom Fields",
          "description": "Custom field values by field key (the key shown in NinjaPipe settings).",
          "type": "json"
        }
      },
      "request": {
        "method": "POST",
        "url": "https://{{credential.base_url}}/companies",
        "body": {
          "name": "{{name}}",
          "email": "{{email}}",
          "phone": "{{phone}}",
          "website": "{{website}}",
          "industry": "{{industry}}",
          "status": "{{status}}",
          "owner_id": "{{owner}}"
        }
      }
    },
    "create_deal": {
      "label": "Create Deal",
      "description": "Creates a deal.",
      "inputs": {
        "name": {
          "label": "Name",
          "required": true
        },
        "value": {
          "label": "Value",
          "description": "Deal value as a number.",
          "type": "number"
        },
        "status": {
          "label": "Status",
          "description": "Status.",
          "type": "select",
          "options": [
            {
              "value": "Open",
              "label": "Open"
            },
            {
              "value": "In Progress",
              "label": "In Progress"
            },
            {
              "value": "Won",
              "label": "Won"
            },
            {
              "value": "Lost",
              "label": "Lost"
            }
          ]
        },
        "owner": {
          "label": "Owner",
          "description": "Workspace member who owns the deal (owner_id)."
        },
        "contactId": {
          "label": "Contact",
          "description": "Select a contact, or type to search."
        },
        "companyId": {
          "label": "Company",
          "description": "Select a company, or type to search."
        },
        "customFields": {
          "label": "Custom Fields",
          "description": "Custom field values by field key (the key shown in NinjaPipe settings).",
          "type": "json"
        }
      },
      "request": {
        "method": "POST",
        "url": "https://{{credential.base_url}}/deals",
        "body": {
          "name": "{{name}}",
          "value": "{{value}}",
          "owner_id": "{{owner}}",
          "contact_id": "{{contactId}}",
          "company_id": "{{companyId}}"
        }
      }
    },
    "create_product": {
      "label": "Create Product",
      "description": "Creates a product.",
      "inputs": {
        "name": {
          "label": "Name",
          "required": true
        },
        "sku": {
          "label": "SKU"
        },
        "price": {
          "label": "Price",
          "type": "number"
        },
        "cost": {
          "label": "Cost",
          "type": "number"
        },
        "description": {
          "label": "Description",
          "type": "multiline"
        },
        "currency": {
          "label": "Currency",
          "description": "ISO currency code, e.g. EUR."
        },
        "status": {
          "label": "Status"
        },
        "category": {
          "label": "Category"
        }
      },
      "request": {
        "method": "POST",
        "url": "https://{{credential.base_url}}/products",
        "body": {
          "name": "{{name}}",
          "sku": "{{sku}}",
          "price": "{{price}}",
          "cost": "{{cost}}",
          "description": "{{description}}",
          "currency": "{{currency}}",
          "status": "{{status}}",
          "category": "{{category}}"
        }
      }
    },
    "get_budget": {
      "label": "Get Budget",
      "description": "Gets one budget by ID.",
      "inputs": {
        "budgetId": {
          "label": "Budget",
          "description": "Select a budget.",
          "required": true
        }
      },
      "request": {
        "method": "GET",
        "url": "https://{{credential.base_url}}/budgets/{{budgetId}}"
      }
    },
    "get_company": {
      "label": "Get Company",
      "description": "Gets one company by ID.",
