    "ai_add_contact_note": {
      "label": "Add Note to Contact",
      "description": "Adds a note to a contact's timeline.",
      "inputs": {
        "contact_id": {
          "label": "Contact ID",
          "description": "Contact UUID from ai_search_contacts.",
          "required": true
        },
        "title": {
          "label": "Title",
          "description": "Short note title.",
