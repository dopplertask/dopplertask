{
  "name": "time-ops",
  "label": "TimeOps",
  "description": "Time tracking and project management for teams and freelancers.",
  "icon": "",
  "hosts": [
    "api.timeops.dk"
  ],
  "upstream": {
    "package": "@activepieces/piece-time-ops",
    "version": "0.1.3"
  },
  "credential": {
    "fields": {
      "token": {
        "label": "API Key",
        "description": "Enter your TimeOps API key. You can find it in your TimeOps account settings.",
        "secret": true,
        "required": true
      }
    },
    "headers": {
      "x-api-key": "{{credential.token}}"
    }
  },
  "actions": {
    "create_customer": {
      "label": "Create Customer",
      "description": "Creates a customer.",
      "inputs": {
        "name": {
          "label": "Name",
          "description": "The name of the customer."
        },
        "vatNumber": {
          "label": "VAT Number",
          "description": "The VAT number of the customer."
        },
        "defaultRate": {
          "label": "Default Rate",
          "description": "The default hourly rate for this customer.",
          "type": "number"
        }
      },
      "request": {
        "method": "POST",
        "url": "https://api.timeops.dk/api/v1/customers",
        "body": {
          "name": "{{name}}",
          "vatNumber": "{{vatNumber}}",
          "defaultRate": "{{defaultRate}}"
        }
      }
    },
    "create_project": {
      "label": "Create Project",
      "description": "Create a project.",
      "inputs": {
        "name": {
          "label": "Name",
          "description": "The name of the project.",
          "required": true
        },
        "customerId": {
          "label": "Customer",
          "description": "The customer this project belongs to.",
          "required": true
        },
        "billable": {
          "label": "Billable",
          "description": "Whether the project is billable.",
          "type": "boolean",
          "defaultValue": "false"
        },
        "rate": {
          "label": "Rate",
          "description": "The hourly rate for this project.",
          "type": "number"
        },
        "finishedAt": {
          "label": "Finished At",
          "description": "The date and time when the project was finished."
        }
      },
      "request": {
        "method": "POST",
        "url": "https://api.timeops.dk/api/v1/Projects",
        "body": {
          "name": "{{name}}",
          "customerId": "{{customerId}}",
          "billable": false,
          "rate": "{{rate}}",
          "finishedAt": "{{finishedAt}}"
        }
      }
    },
    "start_timer": {
      "label": "Start Timer",
      "description": "Starts the timer by creating a new Registration.",
      "inputs": {
        "userId": {
          "label": "User",
          "description": "The user to start the timer for.",
          "required": true
        },
        "projectId": {
          "label": "Project",
          "description": "The project to associate with this timer."
        },
        "description": {
          "label": "Description",
          "description": "Description of the time entry.",
          "type": "multiline"
        },
        "billable": {
          "label": "Billable",
          "description": "Whether this time entry is billable.",
          "type": "boolean",
          "defaultValue": "false"
        },
        "tags": {
          "label": "Tags",
          "description": "Tag IDs to associate with this timer.",
          "type": "json"
        }
      },
      "request": {
        "method": "POST",
        "url": "https://api.timeops.dk/api/v1/Registrations/start/{{userId}}",
        "body": {
          "description": "{{description}}",
          "projectId": "{{projectId}}",
          "billable": false,
          "tags": null
        }
      }
    },
    "stop_timer": {
      "label": "Stop Timer",
      "description": "Stop the currently running timer.",
      "inputs": {
        "userId": {
          "label": "User",
          "description": "The user to stop the timer for.",
          "required": true
        }
      },
      "request": {
        "method": "POST",
        "url": "https://api.timeops.dk/api/v1/Registrations/stop/{{userId}}",
        "body": {}
      }
    },
    "create_registration": {
      "label": "Create Registration",
      "description": "Creates a registration.",
      "inputs": {
        "userId": {
          "label": "User",
          "description": "The user for this registration.",
          "required": true
        },
        "startedAt": {
          "label": "Started At",
          "description": "The start date and time of the registration.",
          "required": true
        },
        "stoppedAt": {
          "label": "Stopped At",
          "description": "The end date and time of the registration."
        },
        "projectId": {
          "label": "Project",
          "description": "The project to associate with this registration."
        },
        "description": {
          "label": "Description",
          "description": "Description of the registration.",
          "type": "multiline"
        },
        "billable": {
          "label": "Billable",
          "description": "Whether this registration is billable.",
          "type": "boolean",
          "defaultValue": "false"
        },
        "tags": {
          "label": "Tags",
          "description": "Tag IDs to associate with this registration.",
          "type": "json"
        }
      },
      "request": {
        "method": "POST",
        "url": "https://api.timeops.dk/api/v1/Registrations",
        "body": {
          "userId": "{{userId}}",
          "startedAt": "{{startedAt}}",
          "stoppedAt": "{{stoppedAt}}",
          "projectId": "{{projectId}}",
          "description": "{{description}}",
          "billable": false,
          "tags": null
        }
      }
    }
  },
  "triggers": {}
}
