    "ticktick_get_habit": {
      "label": "Get Habit",
      "description": "Retrieves a habit by its ID.",
      "inputs": {
        "habitId": {
          "label": "Habit ID",
          "description": "The habit ID, from the List Habits action.",
          "required": true
        }
      },
      "request": {
        "method": "GET",
        "url": "https://api.ticktick.com/open/v1/habit/{{habitId}}"
      }
    },
    "ticktick_create_habit": {
      "label": "Create Habit",
      "description": "Creates a new habit.",
      "inputs": {
        "name": {
          "label": "Name",
          "description": "The habit name (max 1000 characters).",
          "required": true
        },
        "iconRes": {
          "label": "Icon",
          "description": "Habit icon resource, for example \"habit_reading\"."
        },
        "color": {
          "label": "Color",
          "description": "Hex color, for example \"#4D8CF5\"."
        },
        "sortOrder": {
          "label": "Sort Order",
          "type": "number"
        },
        "encouragement": {
          "label": "Encouragement",
          "description": "Encouragement message shown for the habit."
        },
        "type": {
          "label": "Type",
          "description": "\"Boolean\" for done or not done, \"Real\" for a numeric goal."
        },
        "goal": {
          "label": "Goal",
          "description": "Daily goal, for example 1 for a Boolean habit.",
          "type": "number"
        },
        "step": {
