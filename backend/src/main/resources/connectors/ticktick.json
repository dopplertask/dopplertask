{
  "name": "ticktick",
  "label": "TickTick",
  "description": "",
  "icon": "ticktick",
  "hosts": [
    "api.ticktick.com"
  ],
  "upstream": {
    "package": "@activepieces/piece-ticktick",
    "version": "0.3.2"
  },
  "credential": {
    "oauth2": {
      "authUrl": "https://ticktick.com/oauth/authorize",
      "tokenUrl": "https://ticktick.com/oauth/token",
      "scope": "tasks:read tasks:write"
    }
  },
  "actions": {
    "create_task": {
      "label": "Create Task",
      "description": "Creates a new in a specific list.",
      "inputs": {
        "projectId": {
          "label": "List",
          "description": "The list to create the task in.",
          "required": true
        },
        "title": {
          "label": "Task Title",
          "required": true
        },
        "content": {
          "label": "Task Content",
          "type": "multiline"
        },
        "desc": {
          "label": "Description (Checklist)",
          "description": "Description of the checklist, often used with subtasks (items).",
          "type": "multiline"
        },
        "startDate": {
          "label": "Start Date"
        },
        "dueDate": {
          "label": "Due Date"
        },
        "priority": {
          "label": "Priority",
          "type": "select",
          "options": [
            {
              "value": 0,
              "label": "None"
            },
            {
              "value": 1,
              "label": "Low"
            },
            {
              "value": 3,
              "label": "Medium"
            },
            {
              "value": 5,
              "label": "High"
            }
          ]
        }
      },
      "request": {
        "method": "POST",
        "url": "https://api.ticktick.com/open/v1/task",
        "body": {
          "title": "{{title}}",
          "projectId": "{{projectId}}",
          "content": "{{content}}",
          "desc": "{{desc}}",
          "startDate": "Invalid Date",
          "dueDate": "Invalid Date"
        }
      }
    },
    "update_task": {
      "label": "Update Task",
      "description": "Update an existing task.",
      "inputs": {
        "projectId": {
          "label": "List",
          "description": "The list to update the task in.",
          "required": true
        },
        "taskId": {
          "label": "Task ID",
          "description": "The ID of the task to update.",
          "required": true
        },
        "title": {
          "label": "Title"
        },
        "content": {
          "label": "Content",
          "type": "multiline"
        },
        "desc": {
          "label": "Description (Checklist)",
          "description": "New description of the checklist items. Replaces existing.",
          "type": "multiline"
        },
        "startDate": {
          "label": "Start Date"
        },
        "dueDate": {
          "label": "Due Date"
        },
        "priority": {
          "label": "Priority",
          "type": "select",
          "options": [
            {
              "value": 0,
              "label": "None"
            },
            {
              "value": 1,
              "label": "Low"
            },
            {
              "value": 3,
              "label": "Medium"
            },
            {
              "value": 5,
              "label": "High"
            }
          ]
        }
      },
      "request": {
        "method": "POST",
        "url": "https://api.ticktick.com/open/v1/task/{{taskId}}",
        "body": {
          "id": "{{taskId}}",
          "projectId": "{{projectId}}",
          "title": "{{title}}",
          "content": "{{content}}",
          "desc": "{{desc}}",
          "startDate": "Invalid Date",
          "dueDate": "Invalid Date"
        }
      }
    },
    "get_task": {
      "label": "Get Task",
      "description": "Retrieves the details of a specific task.",
      "inputs": {
        "projectId": {
          "label": "List",
          "description": "The list the task belongs to.",
          "required": true
        },
        "taskId": {
          "label": "Task ID",
          "description": "The ID of the task to retrieve.",
          "required": true
        }
      },
      "request": {
        "method": "GET",
        "url": "https://api.ticktick.com/open/v1/project/{{projectId}}/task/{{taskId}}"
      }
    },
    "delete_task": {
      "label": "Delete Task",
      "description": "Deletes an existing task.",
      "inputs": {
        "projectId": {
          "label": "List",
          "description": "The list the task belongs to.",
          "required": true
        },
        "taskId": {
          "label": "Task ID",
          "description": "The ID of the task to delete.",
          "required": true
        }
      },
      "request": {
        "method": "DELETE",
        "url": "https://api.ticktick.com/open/v1/project/{{projectId}}/task/{{taskId}}"
      }
    },
    "complete_task": {
      "label": "Complete Task",
      "description": "Marks an existing task as completed.",
      "inputs": {
        "projectId": {
          "label": "List",
          "required": true
        },
        "taskId": {
          "label": "Task ID",
          "description": "The ID of the task to complete.",
          "required": true
        }
      },
      "request": {
        "method": "POST",
        "url": "https://api.ticktick.com/open/v1/project/{{projectId}}/task/{{taskId}}/complete"
      }
    },
    "find_task": {
      "label": "Find Task",
      "description": "Finds tasks in a specific project by their title.",
      "inputs": {
        "projectId": {
          "label": "List",
          "description": "The list to search within.",
          "required": true
        },
        "title": {
          "label": "Task Title",
          "required": true
        },
        "matchType": {
          "label": "Match Type",
          "description": "Select how the title should be matched.",
          "required": true,
          "type": "select",
          "options": [
            {
              "value": "contains",
              "label": "Contains (case-insensitive)"
            },
            {
              "value": "exact",
              "label": "Exact Match (case-insensitive)"
            }
          ],
          "defaultValue": "contains"
        }
      },
      "request": {
        "method": "GET",
        "url": "https://api.ticktick.com/open/v1/project/{{projectId}}/data"
      }
    },
    "get_project": {
      "label": "Get Task List",
      "description": "Retrieves the details of a specific task list by ID.",
      "inputs": {
        "projectId": {
          "label": "List ID",
          "description": "Select the list to retrieve details for.",
          "required": true
        }
      },
      "request": {
        "method": "GET",
        "url": "https://api.ticktick.com/open/v1/project/{{projectId}}"
      }
    },
    "ticktick_get_project": {
      "label": "Get Project",
      "description": "Retrieves the details of a TickTick project by its ID.",
      "inputs": {
        "projectId": {
          "label": "Project ID",
          "description": "The project ID, from the List Projects action.",
          "required": true
        }
      },
      "request": {
        "method": "GET",
        "url": "https://api.ticktick.com/open/v1/project/{{projectId}}"
      }
    },
    "ticktick_get_project_data": {
      "label": "Get Project With Tasks",
      "description": "Retrieves a TickTick project together with its incomplete tasks and kanban columns.",
      "inputs": {
        "projectId": {
          "label": "Project ID",
          "description": "The project ID, from the List Projects action. Use \"inbox\" for the Inbox.",
          "required": true
        }
      },
      "request": {
        "method": "GET",
        "url": "https://api.ticktick.com/open/v1/project/{{projectId}}/data"
      }
    },
    "ticktick_create_project": {
      "label": "Create Project",
      "description": "Creates a new TickTick project (list).",
      "inputs": {
        "name": {
          "label": "Name",
          "description": "The project name.",
          "required": true
        },
        "color": {
          "label": "Color",
          "description": "Hex color, for example \"#F18181\"."
        },
        "sortOrder": {
          "label": "Sort Order",
          "description": "Sort order value of the project.",
          "type": "number"
        },
        "viewMode": {
          "label": "View Mode",
          "type": "select",
          "options": [
            {
              "value": "list",
              "label": "List"
            },
            {
              "value": "kanban",
              "label": "Kanban"
            },
            {
              "value": "timeline",
              "label": "Timeline"
            }
          ]
        },
        "kind": {
          "label": "Kind",
          "type": "select",
          "options": [
            {
              "value": "TASK",
              "label": "Task"
            },
            {
              "value": "NOTE",
              "label": "Note"
            }
          ]
        }
      },
      "request": {
        "method": "POST",
        "url": "https://api.ticktick.com/open/v1/project",
        "body": {
          "name": "{{name}}",
          "color": "{{color}}",
          "sortOrder": "{{sortOrder}}"
        }
      }
    },
    "ticktick_update_project": {
      "label": "Update Project",
      "description": "Updates the name, color, order, view mode or kind of a TickTick project.",
      "inputs": {
        "projectId": {
          "label": "Project ID",
          "description": "The project ID, from the List Projects action.",
          "required": true
        },
        "name": {
          "label": "Name"
        },
        "color": {
          "label": "Color",
          "description": "Hex color, for example \"#F18181\"."
        },
        "sortOrder": {
          "label": "Sort Order",
          "type": "number"
        },
        "viewMode": {
          "label": "View Mode",
          "type": "select",
          "options": [
            {
              "value": "list",
              "label": "List"
            },
            {
              "value": "kanban",
              "label": "Kanban"
            },
            {
              "value": "timeline",
              "label": "Timeline"
            }
          ]
        },
        "kind": {
          "label": "Kind",
          "type": "select",
          "options": [
            {
              "value": "TASK",
              "label": "Task"
            },
            {
              "value": "NOTE",
              "label": "Note"
            }
          ]
        }
      },
      "request": {
        "method": "POST",
        "url": "https://api.ticktick.com/open/v1/project/{{projectId}}",
        "body": {
          "name": "{{name}}",
          "color": "{{color}}",
          "sortOrder": "{{sortOrder}}"
        }
      }
    },
    "ticktick_create_project_group": {
      "label": "Create Project Group",
      "description": "Creates a new project group (folder).",
      "inputs": {
        "name": {
          "label": "Name",
          "description": "The group name (max 64 characters).",
          "required": true
        }
      },
      "request": {
        "method": "POST",
        "url": "https://api.ticktick.com/open/v1/project/group",
        "body": {
          "name": "{{name}}"
        }
      }
    },
    "ticktick_update_project_group": {
      "label": "Update Project Group",
      "description": "Renames a project group.",
      "inputs": {
        "projectGroupId": {
          "label": "Project Group ID",
          "description": "The group ID, from the List Project Groups action.",
          "required": true
        },
        "name": {
          "label": "Name",
          "description": "The new group name (max 64 characters).",
          "required": true
        }
      },
      "request": {
        "method": "POST",
        "url": "https://api.ticktick.com/open/v1/project/group/{{projectGroupId}}",
        "body": {
          "name": "{{name}}"
        }
      }
    },
    "ticktick_create_column": {
      "label": "Create Column",
      "description": "Creates a kanban column in a TickTick project.",
      "inputs": {
        "projectId": {
          "label": "Project ID",
          "description": "The kanban project ID, from the List Projects action.",
          "required": true
        },
        "name": {
          "label": "Name",
          "description": "The column name (max 1000 characters).",
          "required": true
        }
      },
      "request": {
        "method": "POST",
        "url": "https://api.ticktick.com/open/v1/project/{{projectId}}/column",
        "body": {
          "name": "{{name}}"
        }
      }
    },
    "ticktick_update_column": {
      "label": "Update Column",
      "description": "Renames a kanban column.",
      "inputs": {
        "projectId": {
          "label": "Project ID",
          "description": "The kanban project ID, from the List Projects action.",
          "required": true
        },
        "columnId": {
          "label": "Column ID",
          "description": "The column ID, from the List Columns action.",
          "required": true
        },
        "name": {
          "label": "Name",
          "description": "The new column name (max 1000 characters).",
          "required": true
        }
      },
      "request": {
        "method": "POST",
        "url": "https://api.ticktick.com/open/v1/project/{{projectId}}/column/{{columnId}}",
        "body": {
          "name": "{{name}}"
        }
      }
    },
    "ticktick_get_task": {
      "label": "Get Task",
      "description": "Retrieves a TickTick task by its project and task IDs.",
      "inputs": {
        "projectId": {
          "label": "Project ID",
          "description": "The project the task belongs to. Use \"inbox\" for the Inbox.",
          "required": true
        },
        "taskId": {
          "label": "Task ID",
          "required": true
        }
      },
      "request": {
        "method": "GET",
        "url": "https://api.ticktick.com/open/v1/project/{{projectId}}/task/{{taskId}}"
      }
    },
    "ticktick_create_task": {
      "label": "Create Task",
      "description": "Creates a new task in a TickTick project.",
      "inputs": {
        "projectId": {
          "label": "Project ID",
          "description": "The project to create the task in. Use \"inbox\" for the Inbox.",
          "required": true
        },
        "title": {
          "label": "Title",
          "required": true
        },
        "content": {
          "label": "Content",
          "description": "The task content (notes).",
          "type": "multiline"
        },
        "desc": {
          "label": "Checklist Description",
          "description": "Description of the checklist, used together with subtasks.",
          "type": "multiline"
        },
        "isAllDay": {
          "label": "All Day",
          "type": "select",
          "options": [
            {
              "value": true,
              "label": "Yes"
            },
            {
              "value": false,
              "label": "No"
            }
          ]
        },
        "startDate": {
          "label": "Start Date"
        },
        "dueDate": {
          "label": "Due Date"
        },
        "timeZone": {
          "label": "Time Zone",
          "description": "IANA time zone the dates are specified in, for example \"America/Los_Angeles\"."
        },
        "reminders": {
          "label": "Reminders",
          "description": "Reminder triggers, for example \"TRIGGER:P0DT9H0M0S\" or \"TRIGGER:PT0S\".",
          "type": "json"
        },
        "tags": {
          "label": "Tags",
          "description": "Tag names to put on the task.",
          "type": "json"
        },
        "repeatFlag": {
          "label": "Repeat Rule",
          "description": "Recurrence rule, for example \"RRULE:FREQ=DAILY;INTERVAL=1\"."
        },
        "priority": {
          "label": "Priority",
          "type": "select",
          "options": [
            {
              "value": 0,
              "label": "None"
            },
            {
              "value": 1,
              "label": "Low"
            },
            {
              "value": 3,
              "label": "Medium"
            },
            {
              "value": 5,
              "label": "High"
            }
          ]
        },
        "sortOrder": {
          "label": "Sort Order",
          "type": "number"
        },
        "items": {
          "label": "Subtasks",
          "description": "Array of subtasks, each like {\"title\": \"Step\", \"status\": 0}. Status 0 is open, 1 is completed.",
          "type": "json"
        }
      },
      "request": {
        "method": "POST",
        "url": "https://api.ticktick.com/open/v1/task",
        "body": {
          "projectId": "{{projectId}}",
          "title": "{{title}}",
          "content": "{{content}}",
          "desc": "{{desc}}",
          "timeZone": "{{timeZone}}",
          "repeatFlag": "{{repeatFlag}}",
          "sortOrder": "{{sortOrder}}",
          "startDate": "Invalid Date",
          "dueDate": "Invalid Date"
        }
      }
    },
