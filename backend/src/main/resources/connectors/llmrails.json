{
  "name": "llmrails",
  "label": "LLMRails",
  "description": "LLM Rails Platform",
  "icon": "",
  "hosts": [
    "api.llmrails.com"
  ],
  "upstream": {
    "package": "@activepieces/piece-llmrails",
    "version": "0.2.1"
  },
  "credential": {
    "fields": {
      "token": {
        "label": "API Key",
        "description": "\nFollow these instructions to get your LLMRails API Key:\n\n1. Visit the following website: https://console.llmrails.com/api-keys.\n2. Once on the website, click on create a key.\n3. Once you have created a key, copy it and use it for the Api key field on the site.\n",
        "secret": true,
        "required": true
      }
    },
    "headers": {
      "x-api-key": "{{credential.token}}"
    }
  },
  "actions": {
    "search": {
      "label": "Datastore search",
      "description": "Search in datastore",
      "inputs": {
        "datastoreId": {
          "label": "Datastore ID",
          "required": true
        },
        "text": {
          "label": "Text",
          "description": "Search query",
          "required": true
        },
        "hybrid": {
          "label": "Hybrid search",
          "description": "Hybrid search is combining dense and sparse embeddings.",
          "required": true,
          "type": "boolean",
          "defaultValue": "true"
        },
        "summarize": {
          "label": "Summarize",
          "description": "Summarizes the datastore search results",
          "required": true,
          "type": "boolean",
          "defaultValue": "true"
        }
      },
      "request": {
        "method": "POST",
        "url": "https://api.llmrails.com/v1/datastores/{{datastoreId}}/search",
        "body": {
          "text": "{{text}}"
        }
      }
    }
  },
  "triggers": {}
}
