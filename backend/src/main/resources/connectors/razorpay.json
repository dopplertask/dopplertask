{
  "name": "razorpay",
  "label": "Razorpay",
  "description": "",
  "icon": "razorpay",
  "hosts": [
    "api.razorpay.com"
  ],
  "upstream": {
    "package": "@activepieces/piece-razorpay",
    "version": "0.2.2"
  },
  "credential": {
    "fields": {
      "keyID": {
        "label": "Key ID",
        "description": "",
        "required": true
      },
      "keySecret": {
        "label": "Key Secret",
        "description": "",
        "secret": true,
        "required": true
      }
    }
  },
  "actions": {
    "create-payment-link": {
      "label": "Create Payment Link",
      "description": "Create a payment link",
      "inputs": {
        "amount": {
          "label": "Amount",
          "required": true,
          "type": "number"
        },
        "currency": {
          "label": "Currency",
          "required": true,
          "defaultValue": "INR"
        },
        "reference_id": {
          "label": "Reference ID"
        },
        "description": {
          "label": "Description",
          "type": "multiline"
        },
        "customer_name": {
          "label": "Customer Name"
        },
        "customer_contact": {
          "label": "Customer Contact",
          "required": true,
          "defaultValue": "+91"
        },
        "notify_sms": {
          "label": "Notify via SMS",
          "description": "Send notification via SMS",
          "type": "boolean",
          "defaultValue": "true"
        },
        "customer_email": {
          "label": "Customer Email"
        },
        "notify_email": {
          "label": "Notify via Email",
          "description": "Send notification via Email",
          "type": "boolean",
          "defaultValue": "true"
        },
        "metafield_notes": {
          "label": "Notes"
        },
        "callback_url": {
          "label": "Callback URL"
        },
        "callback_method": {
          "label": "Callback Method"
        }
      },
      "request": {
        "method": "POST",
        "url": "https://api.razorpay.com/v1/payment_links",
        "headers": {
          "authorization": "Basic Y3JlZGVudGlhbDAwMHo6Y3JlZGVudGlhbDAwMXo="
        },
        "body": {
          "amount": 98765000000,
          "currency": "{{currency}}",
          "reference_id": "{{reference_id}}",
          "description": "{{description}}",
          "customer": {
            "name": "{{customer_name}}",
            "contact": "{{customer_contact}}",
            "email": "{{customer_email}}"
          },
          "notify": {},
          "notes": {
            "policy_name": "{{metafield_notes}}"
          },
          "callback_url": "{{callback_url}}",
          "callback_method": "{{callback_method}}"
        }
      }
    }
  },
  "triggers": {}
}
