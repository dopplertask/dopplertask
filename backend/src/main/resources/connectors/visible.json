{
  "name": "visible",
  "label": "Visible",
  "description": "",
  "icon": "",
  "hosts": [
    "api.visible.vc"
  ],
  "upstream": {
    "package": "@activepieces/piece-visible",
    "version": "0.0.10"
  },
  "credential": {
    "fields": {
      "token": {
        "label": "Access Token",
        "description": "Enter your Visible access token.",
        "secret": true,
        "required": true
      }
    },
    "headers": {
      "authorization": "Bearer {{credential.token}}"
    }
  },
  "actions": {
    "create_portfolio_company": {
      "label": "Create Portfolio Company",
      "description": "Creates a new portfolio company.",
      "inputs": {
        "companyId": {
          "label": "Company ID",
          "required": true
        },
        "name": {
          "label": "Name",
          "required": true
        },
        "websiteUrl": {
          "label": "Website URL"
        },
        "currency": {
          "label": "Currency"
        },
        "primaryContactId": {
          "label": "Primary Contact ID"
        }
      },
      "request": {
        "method": "POST",
        "url": "https://api.visible.vc/portfolio_company_profiles",
        "body": {
          "portfolio_company_profile": {
            "name": "{{name}}",
            "company_id": "{{companyId}}",
            "website_url": "{{websiteUrl}}",
            "currency": "{{currency}}",
            "primary_contact_id": "{{primaryContactId}}"
          }
        }
      }
    },
    "create_or_update_contact": {
      "label": "Create or Update Contact",
      "description": "Creates a contact (or updates contact based on email address).",
      "inputs": {
        "email": {
          "label": "Email",
          "required": true
        },
        "companyId": {
          "label": "Company ID",
          "required": true
        },
        "firstName": {
          "label": "First Name"
        },
        "lastName": {
          "label": "Last Name"
        },
        "title": {
          "label": "Title"
        },
        "contactListIds": {
          "label": "Contact List IDs",
          "type": "json"
        }
      },
      "request": {
        "method": "POST",
        "url": "https://api.visible.vc/contacts",
        "body": {
          "contact": {
            "email": "{{email}}",
            "company_id": "{{companyId}}",
            "contact_list_ids": [],
            "first_name": "{{firstName}}",
            "last_name": "{{lastName}}",
            "title": "{{title}}"
          }
        }
      }
    }
  },
  "triggers": {}
}
