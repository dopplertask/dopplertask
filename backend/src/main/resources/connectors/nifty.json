{
  "name": "nifty",
  "label": "Nifty",
  "description": "Project management made simple",
  "icon": "",
  "hosts": [
    "openapi.niftypm.com"
  ],
  "upstream": {
    "package": "@activepieces/piece-nifty",
    "version": "0.3.1"
  },
  "credential": {
    "oauth2": {
      "authUrl": "https://nifty.pm/authorize",
      "tokenUrl": "https://openapi.niftypm.com/oauth/token",
      "scope": "task project subtask milestone subteam"
    }
  },
  "actions": {
    "get_task": {
      "label": "Get Task",
      "description": "Get a task by its ID.",
      "inputs": {
        "task_id": {
          "label": "Task ID",
          "description": "The task ID, e.g. from a trigger or Find Tasks (not the short key like ANP-1).",
          "required": true
        }
      },
      "request": {
        "method": "GET",
        "url": "https://openapi.niftypm.com/api/v1.0/tasks/{{task_id}}"
      }
    },
    "create_project": {
      "label": "Create Project",
      "description": "Create a new project.",
      "inputs": {
        "portfolio": {
          "label": "Portfolio",
          "description": "Optional. When empty, Nifty uses your default portfolio."
        },
        "name": {
          "label": "Project Name",
          "description": "Up to 100 characters.",
          "required": true
        },
        "description": {
          "label": "Description",
          "type": "multiline"
        },
        "access_type": {
          "label": "Access Type",
          "type": "select",
          "options": [
            {
              "value": "public",
              "label": "Public (everyone in the workspace can find and join)"
            },
            {
              "value": "workspace",
              "label": "Workspace (every workspace member is a member)"
            },
            {
              "value": "limited",
              "label": "Limited (only invited members)"
            }
          ]
        },
        "default_tasks_view": {
          "label": "Default Tasks View",
          "type": "select",
          "options": [
            {
              "value": "table",
              "label": "Table"
            },
            {
              "value": "kanban",
              "label": "Kanban"
            },
            {
              "value": "swimlane",
              "label": "Swimlane"
            },
            {
              "value": "timeline",
              "label": "Timeline"
            }
          ]
        }
      },
      "request": {
        "method": "POST",
        "url": "https://openapi.niftypm.com/api/v1.0/projects",
        "body": {
          "name": "{{name}}",
          "subteam_id": "{{portfolio}}",
          "description": "{{description}}"
        }
      }
    },
    "get_project": {
      "label": "Get Project",
      "description": "Get a project by its ID.",
      "inputs": {
        "project_id": {
          "label": "Project ID",
          "required": true
        }
      },
      "request": {
        "method": "GET",
        "url": "https://openapi.niftypm.com/api/v1.0/projects/{{project_id}}"
      }
    },
    "find_projects": {
      "label": "Find Projects",
      "description": "Find projects by name, optionally in one portfolio.",
      "inputs": {
        "name_contains": {
          "label": "Name Contains"
        },
        "portfolio_id": {
          "label": "Portfolio ID"
        },
        "include_archived": {
          "label": "Include Archived",
          "type": "boolean",
          "defaultValue": "false"
        }
      },
      "request": {
        "method": "GET",
        "url": "https://openapi.niftypm.com/api/v1.0/projects",
        "query": {
          "subteam_id": "{{portfolio_id}}",
          "limit": "1000",
          "offset": "0"
        }
      }
    },
    "list_statuses": {
      "label": "List Statuses",
      "description": "List the status columns of a project.",
      "inputs": {
        "project_id": {
          "label": "Project ID",
          "required": true
        },
        "include_archived": {
          "label": "Include Archived",
          "type": "boolean",
          "defaultValue": "false"
        }
      },
      "request": {
        "method": "GET",
        "url": "https://openapi.niftypm.com/api/v1.0/taskgroups",
        "query": {
          "project_id": "{{project_id}}",
          "archived": "false",
          "limit": "1000",
          "offset": "0"
        }
      }
    },
    "list_milestones": {
      "label": "List Milestones and Lists",
      "description": "List the milestones and task lists of a project.",
      "inputs": {
        "project_id": {
          "label": "Project ID",
          "required": true
        },
        "kind": {
          "label": "Kind",
          "type": "select",
          "options": [
            {
              "value": "all",
              "label": "Milestones and lists"
            },
            {
              "value": "milestones",
              "label": "Milestones only"
            },
            {
              "value": "lists",
              "label": "Lists only"
            }
          ],
          "defaultValue": "all"
        }
      },
      "request": {
        "method": "GET",
        "url": "https://openapi.niftypm.com/api/v1.0/milestones",
        "query": {
          "project_id": "{{project_id}}",
          "is_list": "true",
          "limit": "1000",
          "offset": "0"
        }
      }
    },
    "list_members": {
      "label": "List Members",
      "description": "List the members of your Nifty workspace.",
      "inputs": {
        "include_removed": {
          "label": "Include Removed Members",
          "type": "boolean",
          "defaultValue": "false"
        }
      },
      "request": {
        "method": "GET",
        "url": "https://openapi.niftypm.com/api/v1.0/members",
        "query": {
          "limit": "1000",
          "offset": "0"
        }
      }
    },
    "nifty_project_create": {
      "label": "Create Project (AI)",
      "description": "Creates a project. Built for AI agents.",
      "inputs": {
        "name": {
          "label": "Name",
          "description": "Up to 100 characters.",
          "required": true
        },
        "portfolio_id": {
          "label": "Portfolio ID",
          "description": "Optional. The portfolio field (subteam) of any existing project shows the ID."
        },
        "description": {
          "label": "Description",
          "type": "multiline"
        },
        "access_type": {
          "label": "Access Type",
          "type": "select",
          "options": [
            {
              "value": "public",
              "label": "Public (everyone in the workspace can find and join)"
            },
            {
              "value": "workspace",
              "label": "Workspace (every workspace member is a member)"
            },
            {
              "value": "limited",
              "label": "Limited (only invited members)"
            }
          ]
        },
        "default_tasks_view": {
          "label": "Default Tasks View",
          "type": "select",
          "options": [
            {
              "value": "table",
              "label": "Table"
            },
            {
              "value": "kanban",
              "label": "Kanban"
            },
            {
              "value": "swimlane",
              "label": "Swimlane"
            },
            {
              "value": "timeline",
              "label": "Timeline"
            }
          ]
        }
      },
      "request": {
        "method": "POST",
        "url": "https://openapi.niftypm.com/api/v1.0/projects",
        "body": {
          "name": "{{name}}",
          "subteam_id": "{{portfolio_id}}",
          "description": "{{description}}"
        }
      }
    }
  },
  "triggers": {}
}
