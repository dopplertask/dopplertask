{
  "name": "cloutly",
  "label": "Cloutly",
  "description": "Review Management Tool",
  "icon": "",
  "hosts": [
    "app.cloutly.com"
  ],
  "upstream": {
    "package": "@activepieces/piece-cloutly",
    "version": "0.2.1"
  },
  "credential": {
    "fields": {
      "token": {
        "label": "API Key",
        "description": "Please enter the API Key obtained from Cloutly.",
        "secret": true,
        "required": true
      }
    },
    "headers": {
      "x-api-key": "{{credential.token}}"
    }
  },
  "actions": {
    "sendReviewInvite": {
      "label": "Send Review Invite",
      "description": "Sends a review invite to your customer.",
      "inputs": {
        "firstName": {
          "label": "First Name",
          "required": true
        },
        "lastName": {
          "label": "Last Name"
        },
        "email": {
          "label": "Email",
          "description": "The email of the customer to send the invite to (required if Phone Number is empty)"
        },
        "phoneNumber": {
          "label": "Phone Number",
          "description": "The phone number of the customer to send the invite to (required if Email is empty)"
        },
        "sourceCustomerId": {
          "label": "Source Customer ID"
        },
        "businessId": {
          "label": "Business ID",
          "required": true
        },
        "campaignId": {
          "label": "Campaign ID",
          "required": true
        },
        "inviteDelayDays": {
          "label": "Invite Delay Days",
          "description": "The number of days to delay the invite (i.e send after X days)",
          "type": "number"
        },
        "salesRepEmail": {
          "label": "Sales Rep Email",
          "description": "The email of the sales rep to associate the review and customer"
        }
      },
      "request": {
        "method": "POST",
        "url": "https://app.cloutly.com/api/v1/send-review-invite",
        "headers": {
          "x-app": "activepieces"
        },
        "body": {
          "firstName": "{{firstName}}",
          "lastName": "{{lastName}}",
          "channel": {
            "email": "{{email}}",
            "phoneNumber": "{{phoneNumber}}"
          },
          "source": "api",
          "sourceCustomerId": "{{sourceCustomerId}}",
          "businessId": "{{businessId}}",
          "campaignId": "{{campaignId}}",
          "inviteDelayDays": "{{inviteDelayDays}}",
          "salesRepEmail": "{{salesRepEmail}}"
        }
      }
    }
  },
  "triggers": {}
}
