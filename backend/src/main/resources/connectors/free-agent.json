{
  "name": "free-agent",
  "label": "FreeAgent",
  "description": "Accounting and invoicing software for small businesses",
  "icon": "",
  "hosts": [
    "api.freeagent.com"
  ],
  "upstream": {
    "package": "@activepieces/piece-free-agent",
    "version": "0.1.9"
  },
  "credential": {
    "oauth2": {
      "authUrl": "https://api.freeagent.com/v2/approve_app",
      "tokenUrl": "https://api.freeagent.com/v2/token_endpoint",
      "scope": ""
    }
  },
  "actions": {
    "create_contact": {
      "label": "Create Contact",
      "description": "Create a new contact in FreeAgent",
      "inputs": {
        "first_name": {
          "label": "First Name",
          "description": "First name (required if organization name is not specified)"
        },
        "last_name": {
          "label": "Last Name",
          "description": "Last name (required if organization name is not specified)"
        },
        "organisation_name": {
          "label": "Organization Name",
          "description": "Organization name (required if first and last name are not specified)"
        },
        "email": {
          "label": "Email",
          "description": "Email address"
        },
        "billing_email": {
          "label": "Billing Email",
          "description": "Billing email address"
        },
        "phone_number": {
          "label": "Phone Number",
          "description": "Telephone number"
        },
        "mobile": {
          "label": "Mobile",
          "description": "Mobile number"
        },
        "address1": {
          "label": "Address Line 1",
          "description": "First line of the address"
        },
        "address2": {
          "label": "Address Line 2",
          "description": "Second line of the address"
        },
        "address3": {
          "label": "Address Line 3",
          "description": "Third line of the address"
        },
        "town": {
          "label": "Town",
          "description": "Town or city"
        },
        "region": {
          "label": "Region",
          "description": "Region or state"
        },
        "postcode": {
          "label": "Postcode",
          "description": "Post or ZIP code"
        },
        "country": {
          "label": "Country",
          "description": "Country"
        },
        "contact_name_on_invoices": {
          "label": "Show Contact Name on Invoices",
          "description": "Show contact name as well as organization name on invoices",
          "type": "boolean",
          "defaultValue": "false"
        },
        "default_payment_terms_in_days": {
          "label": "Default Payment Terms (Days)",
          "description": "Default payment terms in days",
          "type": "number"
        },
        "charge_sales_tax": {
          "label": "Charge Sales Tax",
          "description": "How to handle sales tax for this contact",
          "type": "select",
          "options": [
            {
              "value": "Auto",
              "label": "Auto"
            },
            {
              "value": "Always",
              "label": "Always"
            },
            {
              "value": "Never",
              "label": "Never"
            }
          ],
          "defaultValue": "Auto"
        },
        "sales_tax_registration_number": {
          "label": "Sales Tax Registration Number",
          "description": "Sales tax registration number if applicable"
        },
        "status": {
          "label": "Status",
          "description": "Contact status",
          "type": "select",
          "options": [
            {
              "value": "Active",
              "label": "Active"
            },
            {
              "value": "Hidden",
              "label": "Hidden"
            }
          ],
          "defaultValue": "Active"
        },
        "locale": {
          "label": "Locale",
          "description": "Invoice/estimate language",
          "type": "select",
          "options": [
            {
              "value": "en",
              "label": "English"
            },
            {
              "value": "en-US",
              "label": "English (US)"
            },
            {
              "value": "es",
              "label": "Spanish"
            },
            {
              "value": "fr",
              "label": "French"
            },
            {
              "value": "de",
              "label": "German"
            },
            {
              "value": "nl",
              "label": "Dutch"
            },
            {
              "value": "it",
              "label": "Italian"
            },
            {
              "value": "pt-BR",
              "label": "Portuguese (Brazil)"
            }
          ],
          "defaultValue": "en"
        }
      },
      "request": {
        "method": "POST",
        "url": "https://api.freeagent.com/v2/contacts",
        "body": {
          "contact": {
            "first_name": "{{first_name}}",
            "last_name": "{{last_name}}",
            "organisation_name": "{{organisation_name}}",
            "email": "{{email}}",
            "billing_email": "{{billing_email}}",
            "phone_number": "{{phone_number}}",
            "mobile": "{{mobile}}",
            "address1": "{{address1}}",
            "address2": "{{address2}}",
            "address3": "{{address3}}",
            "town": "{{town}}",
            "region": "{{region}}",
            "postcode": "{{postcode}}",
            "country": "{{country}}",
            "default_payment_terms_in_days": "{{default_payment_terms_in_days}}",
            "sales_tax_registration_number": "{{sales_tax_registration_number}}"
          }
        }
      }
    }
  },
  "triggers": {}
}
