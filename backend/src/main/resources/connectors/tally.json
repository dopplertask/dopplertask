    "list_workspaces": {
      "label": "List Workspaces",
      "description": "List all workspaces in your Tally account",
      "inputs": {
        "page": {
          "label": "Page",
          "description": "Page number, starting at 1. Defaults to 1.",
          "type": "number",
          "required": false
        }
      },
      "request": {
        "url": "https://api.tally.so/workspaces",
        "query": {
          "page": "{{page}}"
        }
      },
      "outputs": {
        "items": "$.items",
        "hasMore": "$.hasMore"
      }
    },
    "create_workspace": {
      "label": "Create Workspace",
      "description": "Create a new workspace",
      "inputs": {
        "name": {
          "label": "Name",
          "required": true
        }
      },
      "request": {
        "method": "POST",
        "url": "https://api.tally.so/workspaces",
        "body": {
          "name": "{{name}}"
        }
      },
      "outputs": {
        "id": "$.id",
        "name": "$.name"
      }
    },
    "get_workspace": {
      "label": "Get Workspace",
      "description": "Get a single workspace by id",
      "inputs": {
        "workspace_id": {
          "label": "Workspace",
          "required": true,
          "list": "workspaces"
        }
      },
      "request": {
        "url": "https://api.tally.so/workspaces/{{workspace_id}}"
      },
      "outputs": {
        "id": "$.id",
        "name": "$.name"
      }
    },
    "rename_workspace": {
      "label": "Rename Workspace",
      "description": "Rename a workspace",
      "inputs": {
        "workspace_id": {
          "label": "Workspace",
          "required": true,
          "list": "workspaces"
        },
        "name": {
          "label": "New Name",
          "required": true
        }
      },
      "request": {
        "method": "PATCH",
        "url": "https://api.tally.so/workspaces/{{workspace_id}}",
        "body": {
          "name": "{{name}}"
        }
      },
      "afterResponse": "return {workspaceId: inputs.workspace_id, name: inputs.name};",
      "outputs": {
        "workspaceId": "$.workspaceId",
        "name": "$.name"
      }
    },
    "delete_workspace": {
      "label": "Delete Workspace",
      "description": "Permanently delete a workspace and everything inside it",
      "inputs": {
        "workspace_id": {
          "label": "Workspace",
          "required": true,
          "list": "workspaces"
        }
      },
      "request": {
        "method": "DELETE",
        "url": "https://api.tally.so/workspaces/{{workspace_id}}"
      },
      "afterResponse": "return {workspaceId: inputs.workspace_id, deleted: true};",
      "outputs": {
        "workspaceId": "$.workspaceId",
        "deleted": "$.deleted"
      }
    },
    "list_workspace_folders": {
      "label": "List Workspace Folders",
      "description": "List folders inside a workspace",
      "inputs": {
        "workspace_id": {
          "label": "Workspace",
          "required": true,
          "list": "workspaces"
        }
      },
      "request": {
        "url": "https://api.tally.so/workspaces/{{workspace_id}}/folders"
      }
    },
    "create_folder": {
      "label": "Create Folder",
      "description": "Create a folder inside a workspace",
      "inputs": {
        "workspace_id": {
          "label": "Workspace",
          "required": true,
          "list": "workspaces"
        },
        "name": {
          "label": "Name",
          "required": true
        },
        "parent_id": {
          "label": "Folder",
          "description": "Only folders inside the selected workspace are shown.",
          "required": false,
          "list": "folders"
        }
      },
      "request": {
        "method": "POST",
        "url": "https://api.tally.so/workspaces/{{workspace_id}}/folders",
        "body": {
          "name": "{{name}}",
          "parentId": "{{parent_id}}"
        }
      },
      "outputs": {
        "id": "$.id",
        "name": "$.name",
        "workspaceId": "$.workspaceId",
        "parentId": "$.parentId"
      }
    },
    "rename_folder": {
      "label": "Rename Folder",
      "description": "Rename a folder",
      "inputs": {
        "workspace_id": {
          "label": "Workspace",
          "required": true,
          "list": "workspaces"
        },
        "folder_id": {
          "label": "Folder",
          "description": "Only folders inside the selected workspace are shown.",
          "required": true,
          "list": "folders"
        },
        "name": {
          "label": "New Name",
          "required": true
        }
      },
      "request": {
        "method": "PATCH",
        "url": "https://api.tally.so/workspaces/{{workspace_id}}/folders/{{folder_id}}",
        "body": {
          "name": "{{name}}"
        }
      },
      "afterResponse": "return {workspaceId: inputs.workspace_id, folderId: inputs.folder_id, name: inputs.name};",
      "outputs": {
        "workspaceId": "$.workspaceId",
        "folderId": "$.folderId",
        "name": "$.name"
      }
    },
    "delete_folder": {
      "label": "Delete Folder",
      "description": "Delete a folder and its subtree, moving contained forms to trash",
      "inputs": {
        "workspace_id": {
          "label": "Workspace",
          "required": true,
          "list": "workspaces"
        },
        "folder_id": {
          "label": "Folder",
          "description": "Only folders inside the selected workspace are shown.",
          "required": true,
          "list": "folders"
        }
      },
      "request": {
        "method": "DELETE",
        "url": "https://api.tally.so/workspaces/{{workspace_id}}/folders/{{folder_id}}"
      },
      "afterResponse": "return {workspaceId: inputs.workspace_id, folderId: inputs.folder_id, deleted: true};",
      "outputs": {
        "workspaceId": "$.workspaceId",
        "folderId": "$.folderId",
        "deleted": "$.deleted"
      }
    },
    "get_current_user": {
      "label": "Get Current User",
      "description": "Get the connected account's profile and subscription plan",
      "inputs": {},
      "request": {
        "url": "https://api.tally.so/users/me"
      },
      "outputs": {
        "id": "$.id",
        "email": "$.email",
        "fullName": "$.fullName",
        "subscriptionPlan": "$.subscriptionPlan"
      }
    }
  },
  "triggers": {
    "new-submission": {
      "label": "New Submission",
      "description": "Triggers when a form receives a new submission",
      "inputs": {
        "form_id": {
          "label": "Form",
          "description": "Only forms this API key can access are listed.",
          "required": true,
          "list": "forms"
        }
      },
      "webhook": {
        "subscribe": {
          "method": "POST",
          "url": "https://api.tally.so/webhooks",
          "body": {
            "formId": "{{form_id}}",
            "url": "{{webhookUrl}}",
            "eventTypes": [
              "FORM_RESPONSE"
            ]
          }
        },
        "id": "$.id",
        "unsubscribe": {
          "method": "DELETE",
          "url": "https://api.tally.so/webhooks/{{webhookId}}"
        }
      },
      "afterResponse": "if (response.eventType !== 'FORM_RESPONSE') return [];\nconst data = response.data || {};\nconst isObject = (value) => typeof value === 'object' && value !== null && !Array.isArray(value);\nconst textById = (entries) => Object.fromEntries((entries || []).map((entry) => [entry.id, entry.text]));\nconst fields = {};\nconst seen = {};\nfor (const field of data.fields || []) {\n  if (field.type === 'CHECKBOXES' && !field.options) continue;\n  const count = seen[field.label] || 0;\n  seen[field.label] = count + 1;\n  const key = count === 0 ? field.label : `${field.label} (${count + 1})`;\n  let value = field.value;\n  if (['MULTIPLE_CHOICE', 'CHECKBOXES', 'DROPDOWN', 'MULTI_SELECT', 'RANKING'].includes(field.type)) {\n    if (field.options && field.options.length > 0 && Array.isArray(value)) {\n      const optionText = textById(field.options);\n      value = value.map((id) => optionText[id] ?? id);\n    }\n  } else if (field.type === 'MATRIX' && isObject(value)) {\n    const rowText = textById(field.rows);\n    const columnText = textById(field.columns);\n    value = {};\n    for (const [rowId, columnIds] of Object.entries(field.value)) {\n      value[rowText[rowId] ?? rowId] = Array.isArray(columnIds) ? columnIds.map((id) => columnText[id] ?? id) : columnIds;\n    }\n  }\n  fields[key] = value;\n}\nreturn [{ ...data, fields }];",
      "items": "$"
    }
  }
}
