        }
      }
    },
    "get_form_drop_off_analytics": {
      "label": "Get Form Drop-off Analytics",
      "description": "Get per-question drop-off rates for a form",
      "inputs": {
        "form_id": {
          "label": "Form",
          "description": "Only forms this API key can access are listed.",
