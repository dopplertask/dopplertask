{
  "name": "returning-ai",
  "label": "Returning AI",
  "description": "",
  "icon": "",
  "hosts": [
    "integration.returning.ai"
  ],
  "upstream": {
    "package": "@activepieces/piece-returning-ai",
    "version": "0.2.5"
  },
  "credential": {
    "fields": {
      "token": {
        "label": "API Key",
        "description": "Add api key from returning.ai",
        "secret": true,
        "required": true
      }
    },
    "headers": {
      "authorization": "Bearer {{credential.token}}"
    }
  },
  "actions": {
    "replyMessage": {
      "label": "Reply Message",
      "description": "Reply to a specific message as a chosen user in a channel.",
      "inputs": {
        "user": {
          "label": "Sender (Username or email)",
          "description": "The user account that will send the message",
          "required": true
        },
        "messageId": {
          "label": "Reply to (Message ID)",
          "description": "The ID of the message to reply to. ",
          "required": true
        },
        "message": {
          "label": "Message",
          "description": "The content of the reply to be posted.",
          "required": true,
          "type": "multiline"
        }
      },
      "request": {
        "method": "POST",
        "url": "https://integration.returning.ai/apis/v1/messages/reply",
        "body": {
          "messageId": "{{messageId}}",
          "message": "{{message}}",
          "sender": "{{user}}"
        }
      }
    },
    "reactMessage": {
      "label": "React to Message",
      "description": "Add an emoji reaction to a specific message as a chosen user.",
      "inputs": {
        "user": {
          "label": "Sender (Username or email)",
          "description": "The user account that will add the reaction",
          "required": true
        },
        "messageId": {
          "label": "React to (Message ID)",
          "description": "The ID of the message to react to",
          "required": true
        },
        "emoji": {
          "label": "Reaction emoji",
          "description": "The emoji to react with (e.g. :sparkling_heart:)",
          "required": true
        }
      },
      "request": {
        "method": "POST",
        "url": "https://integration.returning.ai/apis/v1/messages/react",
        "body": {
          "messageId": "{{messageId}}",
          "emoji": "{{emoji}}",
          "sender": "{{user}}"
        }
      }
    }
  },
  "triggers": {}
}
