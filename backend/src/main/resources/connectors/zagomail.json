{
  "name": "zagomail",
  "label": "Zagomail",
  "description": "All-in-one email marketing and automation platform",
  "icon": "",
  "hosts": [
    "api.zagomail.com"
  ],
  "upstream": {
    "package": "@activepieces/piece-zagomail",
    "version": "0.1.7"
  },
  "credential": {
    "fields": {
      "token": {
        "label": "Application Public Key",
        "description": "Please provide your application public key by generating one in your zagomail account settings or by directly visiting https://app.zagomail.com/user/api-keys/index.",
        "secret": true,
        "required": true
      }
    },
    "body": {
      "publicKey": "{{credential.token}}"
    }
  },
  "actions": {
    "createSubscriber": {
      "label": "Create Subscriber",
      "description": "Creates a new subscriber in a list.",
      "inputs": {
        "listUId": {
          "label": "List",
          "required": true
        }
      },
      "request": {
        "method": "POST",
        "url": "https://api.zagomail.com/lists/subscriber-create",
        "query": {
          "list_uid": "{{listUId}}"
        },
        "body": {}
      }
    },
    "updateSubscriber": {
      "label": "Update Subscriber",
      "description": "Updates an existing subscriber.",
      "inputs": {
        "listUId": {
          "label": "List",
          "required": true
        },
        "subsriberUid": {
          "label": "Subscriber ID",
          "description": "The ID of the subscriber you want to update.",
          "required": true
        }
      },
      "request": {
        "method": "POST",
        "url": "https://api.zagomail.com/lists/subscriber-update",
        "query": {
          "list_uid": "{{listUId}}",
          "subscriber_uid": "{{subsriberUid}}"
        },
        "body": {}
      }
    },
    "getSubscriberDetails": {
      "label": "Get Subscriber",
      "description": "Gets the details of a subscriber.",
      "inputs": {
        "listUId": {
          "label": "List",
          "required": true
        },
        "subscriberUid": {
          "label": "Subscriber ID",
          "description": "The ID of the subscriber you want to get the details for.",
          "required": true
        }
      },
      "request": {
        "method": "GET",
        "url": "https://api.zagomail.com/lists/get-subscriber",
        "query": {
          "list_uid": "{{listUId}}",
          "subscriber_uid": "{{subscriberUid}}"
        }
      }
    },
    "getCampaignDetails": {
      "label": "Get Campaign",
      "description": "Gets the details of a campaign.",
      "inputs": {
        "campaignUid": {
          "label": "Campaign",
          "required": true
        }
      },
      "request": {
        "method": "GET",
        "url": "https://api.zagomail.com/campaigns/get-stats",
        "query": {
          "campaign_uid": "{{campaignUid}}"
        }
      }
    }
  },
  "triggers": {}
}
