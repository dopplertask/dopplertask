{
  "name": "motiontools",
  "label": "MotionTools",
  "description": "Digitize processes, boost efficiency and excite users with MotionTools, the operating system for fleet-based service providers.",
  "icon": "",
  "hosts": [
    "api.motiontools.io"
  ],
  "upstream": {
    "package": "@activepieces/piece-motiontools",
    "version": "0.1.7"
  },
  "credential": {
    "fields": {
      "token": {
        "label": "Motiontools API Key",
        "description": "API Key for authenticating with Motiontools. Refer https://help.motiontools.io/en/articles/10476909-create-an-api-key",
        "secret": true,
        "required": true
      }
    },
    "headers": {
      "api-key": "{{credential.token}}"
    }
  },
  "actions": {
    "create1stopBooking": {
      "label": "Create 1-stop Booking",
      "description": "Create a hailing booking (1-stop).",
      "inputs": {
        "scheduled_at": {
          "label": "Scheduled At",
          "description": "Scheduled datetime (ISO 8601) for the booking (optional)"
        },
        "payment_method": {
          "label": "Payment Method",
          "description": "Payment method (e.g. cash, card)",
          "required": true
        },
        "stop_type": {
          "label": "Stop Type",
          "description": "Type of stop (e.g. pickup, dropoff)"
        },
        "stop_lat": {
          "label": "Latitude",
          "description": "Latitude for the stop (optional)",
          "type": "number"
        },
        "stop_lng": {
          "label": "Longitude",
          "description": "Longitude for the stop (optional)",
          "type": "number"
        },
        "stop_street": {
          "label": "Street",
          "description": "Street name for the stop (optional)"
        },
        "stop_number": {
          "label": "Street Number",
          "description": "Street number for the stop (optional)"
        },
        "stop_city": {
          "label": "City",
          "description": "City for the stop (optional)"
        },
        "stop_country": {
          "label": "Country",
          "description": "Country for the stop (optional)"
        },
        "stop_zip_code": {
          "label": "Postal Code",
          "description": "Postal code for the stop (optional)"
        },
        "stop_additional_line": {
          "label": "Address Additional Line",
          "description": "Additional address line for the stop (optional)"
        },
        "stop_location_name": {
          "label": "Location Name",
          "description": "Location name for the stop (optional)"
        },
        "stop_first_name": {
          "label": "Contact First Name",
          "description": "Contact's first name at the stop (optional)"
        },
        "stop_last_name": {
          "label": "Contact Last Name",
          "description": "Contact's last name at the stop (optional)"
        },
        "stop_phone_number": {
          "label": "Contact Phone Number",
          "description": "Contact's phone number (optional)"
        },
        "stop_email": {
          "label": "Contact Email",
          "description": "Contact's email (optional)"
        }
      },
      "request": {
        "method": "POST",
        "url": "https://api.motiontools.io/api/hailing/bookings",
        "body": {
          "booking": {
            "scheduled_at": "{{scheduled_at}}",
            "payment_method": "{{payment_method}}",
            "stops": [
              {
                "type": "{{stop_type}}",
                "flow": "full",
                "lat": "{{stop_lat}}",
                "lng": "{{stop_lng}}",
                "street": "{{stop_street}}",
                "number": "{{stop_number}}",
                "city": "{{stop_city}}",
                "country": "{{stop_country}}",
                "zip_code": "{{stop_zip_code}}",
                "additional_line": "{{stop_additional_line}}",
                "location_name": "{{stop_location_name}}",
                "first_name": "{{stop_first_name}}",
                "last_name": "{{stop_last_name}}",
                "phone_number": "{{stop_phone_number}}",
                "email": "{{stop_email}}"
              }
            ]
          }
        }
      }
    },
    "create2stopBooking": {
      "label": "Create 2-stop Booking",
      "description": "Create a hailing booking with two stops (pickup + dropoff).",
      "inputs": {
        "scheduled_at": {
          "label": "Scheduled At",
          "description": "Scheduled datetime (ISO 8601) for the booking (optional)"
        },
        "payment_method": {
          "label": "Payment Method",
          "description": "Payment method (e.g. cash, card)",
          "required": true
        },
        "additional_information": {
          "label": "Additional Information",
          "description": "Any extra notes for the booking (optional)",
          "type": "multiline"
        },
        "metadata": {
          "label": "Metadata",
          "description": "Additional metadata for the booking (optional)",
          "type": "json"
        },
        "stop1_type": {
          "label": "Stop 1 Type"
        },
        "stop1_metadata": {
          "label": "Stop 1 Metadata",
          "type": "json"
        },
        "stop1_lat": {
          "label": "Stop 1 Latitude",
          "type": "number"
        },
        "stop1_lng": {
          "label": "Stop 1 Longitude",
          "type": "number"
        },
        "stop1_street": {
          "label": "Stop 1 Street"
        },
        "stop1_number": {
          "label": "Stop 1 Street Number"
        },
        "stop1_city": {
          "label": "Stop 1 City"
        },
        "stop1_country": {
          "label": "Stop 1 Country"
        },
        "stop1_zip_code": {
          "label": "Stop 1 Postal Code"
        },
        "stop1_additional_line": {
          "label": "Stop 1 Address Additional Line"
        },
        "stop1_location_name": {
          "label": "Stop 1 Location Name"
        },
        "stop1_first_name": {
          "label": "Stop 1 Contact First Name"
        },
        "stop1_last_name": {
          "label": "Stop 1 Contact Last Name"
        },
        "stop1_phone_number": {
          "label": "Stop 1 Contact Phone"
        },
        "stop1_email": {
          "label": "Stop 1 Contact Email"
        },
        "stop2_type": {
          "label": "Stop 2 Type"
        },
        "stop2_metadata": {
          "label": "Stop 2 Metadata",
          "type": "json"
        },
        "stop2_lat": {
          "label": "Stop 2 Latitude",
          "type": "number"
        },
        "stop2_lng": {
          "label": "Stop 2 Longitude",
          "type": "number"
        },
        "stop2_street": {
          "label": "Stop 2 Street"
        },
        "stop2_number": {
          "label": "Stop 2 Street Number"
        },
        "stop2_city": {
          "label": "Stop 2 City"
        },
        "stop2_country": {
          "label": "Stop 2 Country"
        },
        "stop2_zip_code": {
          "label": "Stop 2 Postal Code"
        },
        "stop2_additional_line": {
          "label": "Stop 2 Address Additional Line"
        },
        "stop2_location_name": {
          "label": "Stop 2 Location Name"
        },
        "stop2_first_name": {
          "label": "Stop 2 Contact First Name"
        },
        "stop2_last_name": {
          "label": "Stop 2 Contact Last Name"
        },
        "stop2_phone_number": {
          "label": "Stop 2 Contact Phone"
        },
        "stop2_email": {
          "label": "Stop 2 Contact Email"
        }
      },
      "request": {
        "method": "POST",
        "url": "https://api.motiontools.io/api/hailing/bookings",
        "body": {
          "booking": {
            "scheduled_at": "{{scheduled_at}}",
            "payment_method": "{{payment_method}}",
            "additional_information": "{{additional_information}}",
            "stops": [
              {
                "type": "{{stop1_type}}",
                "flow": "full",
                "lat": "{{stop1_lat}}",
                "lng": "{{stop1_lng}}",
                "street": "{{stop1_street}}",
                "number": "{{stop1_number}}",
                "city": "{{stop1_city}}",
                "country": "{{stop1_country}}",
                "zip_code": "{{stop1_zip_code}}",
                "additional_line": "{{stop1_additional_line}}",
                "location_name": "{{stop1_location_name}}",
                "first_name": "{{stop1_first_name}}",
                "last_name": "{{stop1_last_name}}",
                "phone_number": "{{stop1_phone_number}}",
                "email": "{{stop1_email}}"
              },
              {
                "type": "{{stop2_type}}",
                "flow": "full",
                "lat": "{{stop2_lat}}",
                "lng": "{{stop2_lng}}",
                "street": "{{stop2_street}}",
                "number": "{{stop2_number}}",
                "city": "{{stop2_city}}",
                "country": "{{stop2_country}}",
                "zip_code": "{{stop2_zip_code}}",
                "additional_line": "{{stop2_additional_line}}",
                "location_name": "{{stop2_location_name}}",
                "first_name": "{{stop2_first_name}}",
                "last_name": "{{stop2_last_name}}",
                "phone_number": "{{stop2_phone_number}}",
                "email": "{{stop2_email}}"
              }
            ]
          }
        }
      }
    }
  },
  "triggers": {}
}
