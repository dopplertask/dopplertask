{
  "name": "logsnag",
  "label": "LogSnag",
  "description": "",
  "icon": "",
  "hosts": [
    "api.logsnag.com"
  ],
  "upstream": {
    "package": "@activepieces/piece-logsnag",
    "version": "0.1.2"
  },
  "credential": {
    "fields": {
      "token": {
        "label": "API Key",
        "description": "Your LogSnag API key specific to the project",
        "secret": true,
        "required": true
      }
    },
    "headers": {
      "authorization": "Bearer {{credential.token}}"
    }
  },
  "actions": {
    "createEvent": {
      "label": "Create Event",
      "description": "Creates a new event in LogSnag with the specified channel and details.",
      "inputs": {
        "project": {
          "label": "Project",
          "required": true
        },
        "channel": {
          "label": "Channel",
          "required": true
        },
        "event": {
          "label": "Event",
          "required": true
        },
        "description": {
          "label": "Description"
        }
      },
      "request": {
        "method": "POST",
        "url": "https://api.logsnag.com/v1/log",
        "body": {
          "project": "{{project}}",
          "channel": "{{channel}}",
          "event": "{{event}}",
          "description": "{{description}}"
        }
      }
    }
  },
  "triggers": {}
}
