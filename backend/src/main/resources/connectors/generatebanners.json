{
  "name": "generatebanners",
  "label": "GenerateBanners",
  "description": "Image generation API for banners and social media posts",
  "icon": "",
  "hosts": [
    "api.generatebanners.com"
  ],
  "upstream": {
    "package": "@activepieces/piece-generatebanners",
    "version": "0.4.7"
  },
  "credential": {
    "fields": {
      "username": {
        "label": "Public API Key",
        "required": true
      },
      "password": {
        "label": "Secret API Key",
        "secret": true,
        "required": true
      }
    },
    "basic": {
      "username": "{{credential.username}}",
      "password": "{{credential.password}}"
    },
    "headers": {
      "authorization": "Bearer {{credential.password}}"
    }
  },
  "actions": {
    "render_template": {
      "label": "Render Template",
      "description": "Render a GenerateBanners template",
      "inputs": {
        "template_id": {
          "label": "Template",
          "required": true
        },
        "filetype": {
          "label": "File type",
          "required": true,
          "type": "select",
          "options": [
            {
              "value": "jpg",
              "label": "Image (jpg)"
            },
            {
              "value": "png",
              "label": "Image (png)"
            },
            {
              "value": "pdf",
              "label": "Document (pdf)"
            }
          ],
          "defaultValue": "jpg"
        }
      },
      "request": {
        "method": "GET",
        "url": "https://api.generatebanners.com/api/v1/{{credential.username}}/template/{{template_id}}/sign-url",
        "query": {
          "filetype": "undefined"
        }
      }
    }
  },
  "triggers": {}
}
