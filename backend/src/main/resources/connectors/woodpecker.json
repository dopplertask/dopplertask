{
  "name": "woodpecker",
  "label": "Woodpecker",
  "description": "Cold email automation tool for sales teams to send personalized outreach campaigns",
  "icon": "",
  "hosts": [
    "api.woodpecker.co"
  ],
  "upstream": {
    "package": "@activepieces/piece-woodpecker",
    "version": "0.1.1"
  },
  "credential": {
    "fields": {
      "token": {
        "label": "API Key",
        "description": "\nTo obtain your API key:\n1. Log into your Woodpecker account\n2. Go to Marketplace (top-right) → Integrations → API keys\n3. Click **Create a key**\n4. Copy the key and paste it here\n",
        "secret": true,
        "required": true
      }
    },
    "headers": {
      "x-api-key": "{{credential.token}}"
    }
  },
  "actions": {
    "add_prospect_to_campaign": {
      "label": "Create/Update Prospect in Campaign",
      "description": "Adds a new prospect or updates existing prospect data in a campaign",
      "inputs": {
        "campaign_id": {
          "label": "Campaign",
          "description": "Select the campaign to add prospects to",
          "required": true
        },
        "email": {
          "label": "Email",
          "description": "Prospect email address",
          "required": true
        },
        "first_name": {
          "label": "First Name"
        },
        "last_name": {
          "label": "Last Name"
        },
        "company": {
          "label": "Company"
        },
        "website": {
          "label": "Website"
        },
        "linkedin_url": {
          "label": "LinkedIn URL"
        },
        "tags": {
          "label": "Tags",
          "description": "Tags starting with # separated by spaces (e.g. #VC #Startup)"
        },
        "title": {
          "label": "Job Title"
        },
        "phone": {
          "label": "Phone"
        },
        "address": {
          "label": "Address"
        },
        "city": {
          "label": "City"
        },
        "state": {
          "label": "State"
        },
        "country": {
          "label": "Country"
        },
        "industry": {
          "label": "Industry"
        },
        "status": {
          "label": "Status",
          "description": "Prospect status in the campaign",
          "type": "select",
          "options": [
            {
              "value": "ACTIVE",
              "label": "Active"
            },
            {
              "value": "PAUSED",
              "label": "Paused"
            },
            {
              "value": "TO-REVIEW",
              "label": "To Review"
            },
            {
              "value": "TO-CHECK",
              "label": "To Check"
            }
          ]
        },
        "snippets": {
          "label": "Snippets",
          "description": "Custom snippets for personalization (supports HTML). Max 15 snippets.",
          "type": "json"
        },
        "send_after": {
          "label": "Send After",
          "description": "Earliest date and time the prospect can be contacted"
        },
        "force": {
          "label": "Force Add",
          "description": "Add prospect even if their global status is not ACTIVE (use with caution)",
          "type": "boolean",
          "defaultValue": "false"
        },
        "file_name": {
          "label": "Import Batch Name",
          "description": "Name of the import batch (visible in the imported column)"
        }
      },
      "request": {
        "method": "POST",
        "url": "https://api.woodpecker.co/rest/v1/add_prospects_campaign",
        "body": {
          "campaign": {
            "campaign_id": "{{campaign_id}}",
            "send_after": "{{send_after}}"
          },
          "prospects": [
            {
              "email": "{{email}}",
              "first_name": "{{first_name}}",
              "last_name": "{{last_name}}",
              "company": "{{company}}",
              "website": "{{website}}",
              "linkedin_url": "{{linkedin_url}}",
              "tags": "{{tags}}",
              "title": "{{title}}",
              "phone": "{{phone}}",
              "address": "{{address}}",
              "city": "{{city}}",
              "state": "{{state}}",
              "country": "{{country}}",
              "industry": "{{industry}}"
            }
          ],
          "file_name": "{{file_name}}"
        }
      }
    },
    "add_prospect_to_list": {
      "label": "Create/Update Prospect",
      "description": "Adds a new prospect or updates existing prospect in the global prospect list",
      "inputs": {
        "email": {
          "label": "Email",
          "description": "Prospect email address",
          "required": true
        },
        "update": {
          "label": "Update Existing",
          "description": "If enabled, updates existing prospect data. If disabled, existing prospects remain unchanged.",
          "type": "boolean",
          "defaultValue": "false"
        },
        "first_name": {
          "label": "First Name"
        },
        "last_name": {
          "label": "Last Name"
        },
        "company": {
          "label": "Company"
        },
        "website": {
          "label": "Website"
        },
        "linkedin_url": {
          "label": "LinkedIn URL"
        },
        "tags": {
          "label": "Tags",
          "description": "Tags starting with # separated by spaces (e.g. #VC #Startup). Appends to existing tags when updating."
        },
        "set_tags": {
          "label": "Replace Tags",
          "description": "Replaces all existing tags with these (only when updating). Use empty string to clear all tags."
        },
        "title": {
          "label": "Job Title"
        },
        "phone": {
          "label": "Phone"
        },
        "address": {
          "label": "Address"
        },
        "city": {
          "label": "City"
        },
        "state": {
          "label": "State"
        },
        "country": {
          "label": "Country"
        },
        "industry": {
          "label": "Industry"
        },
        "status": {
          "label": "Status",
          "description": "Prospect status",
          "type": "select",
          "options": [
            {
              "value": "ACTIVE",
              "label": "Active"
            },
            {
              "value": "BLACKLIST",
              "label": "Blacklist"
            },
            {
              "value": "BOUNCED",
              "label": "Bounced"
            },
            {
              "value": "INVALID",
              "label": "Invalid"
            },
            {
              "value": "REPLIED",
              "label": "Replied"
            }
          ]
        },
        "snippets": {
          "label": "Snippets",
          "description": "Custom snippets for personalization (supports HTML). Max 15 snippets.",
          "type": "json"
        },
        "file_name": {
          "label": "Import Batch Name",
          "description": "Name of the import batch (visible in the imported column)"
        }
      },
      "request": {
        "method": "POST",
        "url": "https://api.woodpecker.co/rest/v1/add_prospects_list",
        "body": {
          "prospects": [
            {
              "email": "{{email}}",
              "first_name": "{{first_name}}",
              "last_name": "{{last_name}}",
              "company": "{{company}}",
              "website": "{{website}}",
              "linkedin_url": "{{linkedin_url}}",
              "tags": "{{tags}}",
              "title": "{{title}}",
              "phone": "{{phone}}",
              "address": "{{address}}",
              "city": "{{city}}",
              "state": "{{state}}",
              "country": "{{country}}",
              "industry": "{{industry}}"
            }
          ],
          "file_name": "{{file_name}}"
        }
      }
    },
    "blacklist_domain": {
      "label": "Blacklist Domain",
      "description": "Add a domain to the blacklist to block sending to all prospects within that domain",
      "inputs": {
        "domain": {
          "label": "Domain",
          "description": "Domain to blacklist (e.g. example.com)",
          "required": true
        }
      },
      "request": {
        "method": "POST",
        "url": "https://api.woodpecker.co/rest/v2/blacklist/domains",
        "body": {
          "domains": [
            "{{domain}}"
          ]
        }
      }
    },
    "get_prospect_responses": {
      "label": "Get Prospect Responses",
      "description": "Fetch all responses from a specified prospect",
      "inputs": {
        "prospect_id": {
          "label": "Prospect ID",
          "description": "The unique ID of the prospect",
          "required": true,
          "type": "number"
        },
        "campaign_id": {
          "label": "Campaign",
          "description": "Filter responses by campaign (optional)"
        }
      },
      "request": {
        "method": "GET",
        "url": "https://api.woodpecker.co/rest/v2/prospects/{{prospect_id}}/responses",
        "query": {
          "campaign_id": "{{campaign_id}}"
        }
      }
    },
    "find_prospect_by_email": {
      "label": "Find Prospect by Email",
      "description": "Search for a prospect by their email address",
      "inputs": {
        "email": {
          "label": "Email",
          "description": "Email address to search for (exact match or partial)",
          "required": true
        },
        "include_campaign_details": {
          "label": "Include Campaign Details",
          "description": "Include information about campaigns the prospect is enrolled in",
          "type": "boolean",
          "defaultValue": "true"
        }
      },
      "request": {
        "method": "GET",
        "url": "https://api.woodpecker.co/rest/v1/prospects",
        "query": {
          "search": "email={{email}}"
        }
      }
    }
  },
  "triggers": {}
}
