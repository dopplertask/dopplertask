{
  "name": "mollie",
  "label": "Mollie",
  "description": "Automate Mollie payments, orders, refunds, customers, and invoices. Triggers on payment events and statuses.",
  "icon": "",
  "hosts": [
    "api.mollie.com"
  ],
  "upstream": {
    "package": "@activepieces/piece-mollie",
    "version": "0.1.7"
  },
  "credential": {
    "fields": {
      "token": {
        "label": "API Key",
        "description": "Enter your Mollie API key (starts with live_ or test_)",
        "secret": true,
        "required": true
      }
    },
    "headers": {
      "authorization": "Bearer {{credential.token}}"
    }
  },
  "actions": {
    "create_payment_link": {
      "label": "Create Payment Link",
      "description": "Generate a new payment link targeting a customer, product, or specific amount",
      "inputs": {
        "description": {
          "label": "Description",
          "description": "A short description of the payment link (max 255 characters)",
          "required": true
        },
        "includeAmount": {
          "label": "Include Fixed Amount",
          "description": "Whether to include a fixed amount or let customer enter amount",
          "type": "boolean",
          "defaultValue": "true"
        },
        "currency": {
          "label": "Currency",
          "description": "A three-character ISO 4217 currency code (e.g. EUR, USD)",
          "defaultValue": "EUR"
        },
        "amount": {
          "label": "Amount",
          "description": "The amount to charge (e.g. \"10.00\")"
        },
        "includeMinimumAmount": {
          "label": "Include Minimum Amount",
          "description": "Whether to set a minimum amount (only when no fixed amount)",
          "type": "boolean",
          "defaultValue": "false"
        },
        "minimumAmountCurrency": {
          "label": "Minimum Amount Currency",
          "description": "Currency for minimum amount",
          "defaultValue": "EUR"
        },
        "minimumAmount": {
          "label": "Minimum Amount",
          "description": "The minimum amount (e.g. \"5.00\")"
        },
        "redirectUrl": {
          "label": "Redirect URL",
          "description": "URL to redirect customer after payment completion",
          "type": "multiline"
        },
        "webhookUrl": {
          "label": "Webhook URL",
          "description": "URL for payment status updates",
          "type": "multiline"
        },
        "includeLines": {
          "label": "Include Order Lines",
          "description": "Whether to include detailed order line items",
          "type": "boolean",
          "defaultValue": "false"
        },
        "lines": {
          "label": "Order Lines",
          "description": "Order line items (required for certain payment methods)",
          "type": "json"
        },
        "includeBillingAddress": {
          "label": "Include Billing Address",
          "description": "Whether to include billing address details",
          "type": "boolean",
          "defaultValue": "false"
        },
        "billingTitle": {
          "label": "Billing Title",
          "description": "Title (e.g. Mr., Mrs.)"
        },
        "billingGivenName": {
          "label": "Billing Given Name",
          "description": "First name"
        },
        "billingFamilyName": {
          "label": "Billing Family Name",
          "description": "Last name"
        },
        "billingOrganizationName": {
          "label": "Billing Organization",
          "description": "Organization name"
        },
        "billingStreetAndNumber": {
          "label": "Billing Street and Number",
          "description": "Street address with number"
        },
        "billingStreetAdditional": {
          "label": "Billing Street Additional",
          "description": "Additional address details"
        },
        "billingPostalCode": {
          "label": "Billing Postal Code",
          "description": "Postal code"
        },
        "billingEmail": {
          "label": "Billing Email",
          "description": "Email address"
        },
        "billingPhone": {
          "label": "Billing Phone",
          "description": "Phone in E.164 format"
        },
        "billingCity": {
          "label": "Billing City",
          "description": "City name"
        },
        "billingRegion": {
          "label": "Billing Region",
          "description": "State or region"
        },
        "billingCountry": {
          "label": "Billing Country",
          "description": "ISO 3166-1 alpha-2 country code"
        },
        "includeShippingAddress": {
          "label": "Include Shipping Address",
          "description": "Whether to include shipping address details",
          "type": "boolean",
          "defaultValue": "false"
        },
        "shippingTitle": {
          "label": "Shipping Title",
          "description": "Title (e.g. Mr., Mrs.)"
        },
        "shippingGivenName": {
          "label": "Shipping Given Name",
          "description": "First name"
        },
        "shippingFamilyName": {
          "label": "Shipping Family Name",
          "description": "Last name"
        },
        "shippingOrganizationName": {
          "label": "Shipping Organization",
          "description": "Organization name"
        },
        "shippingStreetAndNumber": {
          "label": "Shipping Street and Number",
          "description": "Street address with number"
        },
        "shippingStreetAdditional": {
          "label": "Shipping Street Additional",
          "description": "Additional address details"
        },
        "shippingPostalCode": {
          "label": "Shipping Postal Code",
          "description": "Postal code"
        },
        "shippingEmail": {
          "label": "Shipping Email",
          "description": "Email address"
        },
        "shippingPhone": {
          "label": "Shipping Phone",
          "description": "Phone in E.164 format"
        },
        "shippingCity": {
          "label": "Shipping City",
          "description": "City name"
        },
        "shippingRegion": {
          "label": "Shipping Region",
          "description": "State or region"
        },
        "shippingCountry": {
          "label": "Shipping Country",
          "description": "ISO 3166-1 alpha-2 country code"
        },
        "reusable": {
          "label": "Reusable",
          "description": "Allow multiple payments using the same link",
          "type": "boolean",
          "defaultValue": "false"
        },
        "expiresAt": {
          "label": "Expires At",
          "description": "Expiry date in ISO 8601 format (e.g. 2024-12-31T23:59:59Z)"
        },
        "allowedMethods": {
          "label": "Allowed Payment Methods",
          "description": "Payment methods allowed for this link (empty = all enabled methods)",
          "type": "json"
        },
        "sequenceType": {
          "label": "Sequence Type",
          "description": "Type of payment sequence",
          "type": "select",
          "options": [
            {
              "value": "oneoff",
              "label": "One-off Payment"
            },
            {
              "value": "first",
              "label": "First Payment (establishes mandate)"
            }
          ],
          "defaultValue": "oneoff"
        },
        "customerId": {
          "label": "Customer ID",
          "description": "Customer ID (only relevant for first sequence type)"
        },
        "testmode": {
          "label": "Test Mode",
          "description": "Whether to create the payment link in test mode",
          "type": "boolean",
          "defaultValue": "false"
        }
      },
      "request": {
        "method": "POST",
        "url": "https://api.mollie.com/v2/payment-links",
        "body": {
          "description": "{{description}}",
          "redirectUrl": "{{redirectUrl}}",
          "webhookUrl": "{{webhookUrl}}",
          "expiresAt": "{{expiresAt}}",
          "customerId": "{{customerId}}"
        }
      }
    },
