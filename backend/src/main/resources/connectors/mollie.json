    "create_payment_refund": {
      "label": "Create Payment Refund",
      "description": "Creates refund for payment",
      "inputs": {
        "paymentId": {
          "label": "Payment",
          "description": "Select the payment to refund",
          "required": true
        },
        "description": {
          "label": "Description",
          "description": "The description of the refund (max 255 characters)"
        },
        "currency": {
          "label": "Currency",
          "description": "A three-character ISO 4217 currency code (e.g. EUR, USD)",
          "required": true,
          "defaultValue": "EUR"
        },
        "amount": {
          "label": "Refund Amount",
          "description": "The amount to refund (e.g. \"10.00\")",
          "required": true
        },
        "metadata": {
          "label": "Metadata",
          "description": "Additional data to save alongside the refund (JSON string)"
        },
        "includeExternalReference": {
          "label": "Include External Reference",
          "description": "Whether to include external reference details",
          "type": "boolean",
          "defaultValue": "false"
        },
        "externalReferenceType": {
          "label": "External Reference Type",
          "description": "Type of external reference",
          "type": "select",
          "options": [
            {
              "value": "acquirer-reference",
              "label": "Acquirer Reference"
            }
          ]
        },
        "externalReferenceId": {
          "label": "External Reference ID",
          "description": "Unique reference from the payment provider"
        },
        "reverseRouting": {
          "label": "Reverse Routing",
          "description": "Pull back funds routed to connected merchants (full refund only)",
          "type": "boolean",
          "defaultValue": "false"
        },
        "includeRoutingReversals": {
          "label": "Include Routing Reversals",
          "description": "Specify detailed routing reversals for partial refunds",
          "type": "boolean",
          "defaultValue": "false"
        },
        "routingReversals": {
          "label": "Routing Reversals",
          "description": "Detailed routing reversals for connected merchants",
          "type": "json"
        },
        "testmode": {
          "label": "Test Mode",
          "description": "Whether to create the refund in test mode",
          "type": "boolean",
          "defaultValue": "false"
        }
