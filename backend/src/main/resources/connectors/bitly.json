{
  "name": "bitly",
  "label": "Bitly",
  "description": "URL shortening and link management platform with analytics.",
  "icon": "bitly",
  "hosts": [
    "api-ssl.bitly.com"
  ],
  "upstream": {
    "package": "@activepieces/piece-bitly",
    "version": "0.2.3"
  },
  "credential": {
    "fields": {
      "accessToken": {
        "label": "Access Token",
        "description": "",
        "secret": true,
        "required": true
      }
    },
    "headers": {
      "authorization": "Bearer {{credential.accessToken}}"
    }
  },
  "actions": {
    "archive_bitlink": {
      "label": "Archive Bitlink",
      "description": "Archive a Bitlink to stop redirects.",
      "inputs": {
        "group_guid": {
          "label": "Group",
          "description": "The group where the item will be managed.",
          "required": true
        },
        "bitlink": {
          "label": "Bitlink",
          "description": "Select the Bitlink to modify.",
          "required": true
        }
      },
      "request": {
        "method": "PATCH",
        "url": "https://api-ssl.bitly.com/v4/bitlinks/{{bitlink}}",
        "body": {
          "archived": true
        }
      }
    },
    "create_qr_code": {
      "label": "Create QR Code",
      "description": "Generate a customized QR code for a Bitlink.",
      "inputs": {
        "group_guid": {
          "label": "Group",
          "description": "The group where the item will be managed.",
          "required": true
        },
        "destination_type": {
          "label": "Destination Type",
          "required": true,
          "type": "select",
          "options": [
            {
              "value": "long_url",
              "label": "Long URL"
            },
            {
              "value": "bitlink_id",
              "label": "Existing Bitlink"
            }
          ],
          "defaultValue": "long_url"
        },
        "title": {
          "label": "Title",
          "description": "Internal title for the QR Code."
        },
        "archived": {
          "label": "Archive on Create",
          "description": "Archive the QR code upon creation.",
          "type": "boolean"
        },
        "background_color": {
          "label": "Style: Background Color",
          "description": "Hex code (e.g., #FFFFFF)"
        },
        "dot_pattern_color": {
          "label": "Style: Dot Pattern Color",
          "description": "Hex code (e.g., #000000)"
        },
        "dot_pattern_type": {
          "label": "Style: Dot Pattern Type",
          "type": "select",
          "options": [
            {
              "value": "standard",
              "label": "Standard"
            },
            {
              "value": "circle",
              "label": "Circle"
            },
            {
              "value": "block",
              "label": "Block"
            },
            {
              "value": "blob",
              "label": "Blob"
            },
            {
              "value": "rounded",
              "label": "Rounded"
            },
            {
              "value": "vertical",
              "label": "Vertical"
            },
            {
              "value": "horizontal",
              "label": "Horizontal"
            },
            {
              "value": "triangle",
              "label": "Triangle"
            },
            {
              "value": "heart",
              "label": "Heart"
            },
            {
              "value": "star",
              "label": "Star"
            },
            {
              "value": "diamond",
              "label": "Diamond"
            }
          ]
        },
        "corner_1_shape": {
          "label": "Corner 1 (Top-Left): Shape",
          "type": "select",
          "options": [
            {
              "value": "standard",
              "label": "Standard"
            },
            {
              "value": "slightly_round",
              "label": "Slightly Round"
            },
            {
              "value": "rounded",
              "label": "Rounded"
            },
            {
              "value": "extra_round",
              "label": "Extra Round"
            },
            {
              "value": "leaf",
              "label": "Leaf"
            },
            {
              "value": "leaf_inner",
              "label": "Leaf Inner"
            },
            {
              "value": "leaf_outer",
              "label": "Leaf Outer"
            },
            {
              "value": "target",
              "label": "Target"
            },
            {
              "value": "concave",
              "label": "Concave"
            }
          ]
        },
        "corner_1_inner_color": {
          "label": "Corner 1 (Top-Left): Inner Color"
        },
        "corner_1_outer_color": {
          "label": "Corner 1 (Top-Left): Outer Color"
        },
        "corner_2_shape": {
          "label": "Corner 2 (Top-Right): Shape",
          "type": "select",
          "options": [
            {
              "value": "standard",
              "label": "Standard"
            },
            {
              "value": "slightly_round",
              "label": "Slightly Round"
            },
            {
              "value": "rounded",
              "label": "Rounded"
            },
            {
              "value": "extra_round",
              "label": "Extra Round"
            },
            {
              "value": "leaf",
              "label": "Leaf"
            },
            {
              "value": "leaf_inner",
              "label": "Leaf Inner"
            },
            {
              "value": "leaf_outer",
              "label": "Leaf Outer"
            },
            {
              "value": "target",
              "label": "Target"
            },
            {
              "value": "concave",
              "label": "Concave"
            }
          ]
        },
        "corner_2_inner_color": {
          "label": "Corner 2 (Top-Right): Inner Color"
        },
        "corner_2_outer_color": {
          "label": "Corner 2 (Top-Right): Outer Color"
        },
        "corner_3_shape": {
          "label": "Corner 3 (Bottom-Right): Shape",
          "type": "select",
          "options": [
            {
              "value": "standard",
              "label": "Standard"
            },
            {
              "value": "slightly_round",
              "label": "Slightly Round"
            },
            {
              "value": "rounded",
              "label": "Rounded"
            },
            {
              "value": "extra_round",
              "label": "Extra Round"
            },
            {
              "value": "leaf",
              "label": "Leaf"
            },
            {
              "value": "leaf_inner",
              "label": "Leaf Inner"
            },
            {
              "value": "leaf_outer",
              "label": "Leaf Outer"
            },
            {
              "value": "target",
              "label": "Target"
            },
            {
              "value": "concave",
              "label": "Concave"
            }
          ]
        },
        "corner_3_inner_color": {
          "label": "Corner 3 (Bottom-Right): Inner Color"
        },
        "corner_3_outer_color": {
          "label": "Corner 3 (Bottom-Right): Outer Color"
        },
        "gradient_style": {
          "label": "Gradient: Style",
          "type": "select",
          "options": [
            {
              "value": "no_gradient",
              "label": "No Gradient"
            },
            {
              "value": "linear",
              "label": "Linear"
            },
            {
              "value": "radial",
              "label": "Radial"
            }
          ]
        },
        "gradient_color_1": {
          "label": "Gradient: Color 1",
          "description": "First gradient color (hex code)"
        },
        "gradient_color_2": {
          "label": "Gradient: Color 2",
          "description": "Second gradient color (hex code)"
        },
        "gradient_angle": {
          "label": "Gradient: Angle (for Linear)",
          "type": "number"
        },
        "gradient_exclude_corners": {
          "label": "Gradient: Exclude Corners",
          "type": "boolean"
        },
        "frame_id": {
          "label": "Frame: Type",
          "type": "select",
          "options": [
            {
              "value": "none",
              "label": "None"
            },
            {
              "value": "border_only",
              "label": "Border Only"
            },
            {
              "value": "text_bottom",
              "label": "Text Bottom"
            },
            {
              "value": "tooltip_bottom",
              "label": "Tooltip Bottom"
            },
            {
              "value": "arrow",
              "label": "Arrow"
            },
            {
              "value": "text_top",
              "label": "Text Top"
            },
            {
              "value": "text_bottom_in_frame",
              "label": "Text Bottom In Frame"
            },
            {
              "value": "script",
              "label": "Script"
            },
            {
              "value": "text_top_and_bottom",
              "label": "Text Top and Bottom"
            },
            {
              "value": "url",
              "label": "URL"
            },
            {
              "value": "instagram",
              "label": "Instagram"
            }
          ]
        },
        "frame_primary_color": {
          "label": "Frame: Primary Color"
        },
        "frame_secondary_color": {
          "label": "Frame: Secondary Color"
        },
        "frame_background_color": {
          "label": "Frame: Background Color"
        },
        "frame_text": {
          "label": "Frame: Text",
          "description": "Primary text for frames that support it."
        },
        "logo_image_guid": {
          "label": "Branding: Logo Image GUID",
          "description": "A GUID for a logo image previously uploaded to Bitly."
        },
        "bitly_brand": {
          "label": "Branding: Show Bitly Logo",
          "description": "Show the Bitly logo in the bottom right corner.",
          "type": "boolean",
          "defaultValue": "true"
        },
        "error_correction": {
          "label": "Specs: Error Correction",
          "type": "select",
          "options": [
            {
              "value": 1,
              "label": "Low (1)"
            },
            {
              "value": 2,
              "label": "Medium (2)"
            },
            {
              "value": 3,
              "label": "Quartile (3)"
            },
            {
              "value": 4,
              "label": "High (4)"
            }
          ]
        }
      },
      "request": {
        "method": "POST",
        "url": "https://api-ssl.bitly.com/v4/qr-codes",
        "body": {
          "group_guid": "{{group_guid}}",
          "destination": {},
          "title": "{{title}}",
          "render_customizations": {
            "background_color": "{{background_color}}",
            "dot_pattern_color": "{{dot_pattern_color}}",
            "corners": {
              "corner_1": {
                "inner_color": "{{corner_1_inner_color}}",
                "outer_color": "{{corner_1_outer_color}}"
              },
              "corner_2": {
                "inner_color": "{{corner_2_inner_color}}",
                "outer_color": "{{corner_2_outer_color}}"
              },
              "corner_3": {
                "inner_color": "{{corner_3_inner_color}}",
                "outer_color": "{{corner_3_outer_color}}"
              }
            },
            "gradient": {
              "angle": "{{gradient_angle}}",
              "colors": [
                {
                  "color": "{{gradient_color_1}}",
                  "offset": 0
                },
                {
                  "color": "{{gradient_color_2}}",
                  "offset": 100
                }
              ]
            },
            "frame": {
              "colors": {
                "primary": "{{frame_primary_color}}",
                "secondary": "{{frame_secondary_color}}",
                "background": "{{frame_background_color}}"
              },
              "text": {
                "primary": {
                  "content": "{{frame_text}}"
                }
              }
            },
            "logo": {
              "image_guid": "{{logo_image_guid}}"
            }
          }
        }
      }
    },
    "get_bitlink_details": {
      "label": "Get Bitlink Details",
      "description": "Retrieve metadata for a Bitlink.",
      "inputs": {
        "group_guid": {
          "label": "Group",
          "description": "The group where the item will be managed.",
          "required": true
        },
        "bitlink": {
          "label": "Bitlink",
          "description": "Select the Bitlink to modify.",
          "required": true
        }
      },
      "request": {
        "method": "GET",
        "url": "https://api-ssl.bitly.com/v4/bitlinks/{{bitlink}}"
      }
    },
    "update_bitlink": {
      "label": "Update Bitlink",
      "description": "Modify properties of an existing Bitlink.",
      "inputs": {
        "group_guid": {
          "label": "Group",
          "description": "The group where the item will be managed.",
          "required": true
        },
        "bitlink": {
          "label": "Bitlink",
          "description": "Select the Bitlink to modify.",
          "required": true
        },
        "title": {
          "label": "Title",
          "description": "New title for the Bitlink."
        },
        "archived": {
          "label": "Archived",
          "description": "Archive or unarchive the Bitlink.",
          "type": "boolean"
        },
        "tags": {
          "label": "Tags",
          "description": "Tags to apply (overwrites existing tags).",
          "type": "json"
        },
        "app_uri_path": {
          "label": "App URI Path",
          "description": "Path within the mobile app (e.g., /product/123)."
        },
        "install_url": {
          "label": "App Install URL",
          "description": "URL where users can install the mobile app.",
          "type": "multiline"
        },
        "os": {
          "label": "Mobile OS",
          "description": "Target mobile operating system.",
          "type": "select",
          "options": [
            {
              "value": "ios",
              "label": "iOS"
            },
            {
              "value": "android",
              "label": "Android"
            }
          ]
        },
        "install_type": {
          "label": "Install Type",
          "description": "How to handle app installation.",
          "type": "select",
          "options": [
            {
              "value": "no_install",
              "label": "No Install"
            },
            {
              "value": "auto_install",
              "label": "Auto Install"
            },
            {
              "value": "promote_install",
              "label": "Promote Install"
            }
          ]
        }
      },
      "request": {
        "method": "PATCH",
        "url": "https://api-ssl.bitly.com/v4/bitlinks/{{bitlink}}",
        "body": {
          "title": "{{title}}",
          "deeplinks": [
            {
              "app_uri_path": "{{app_uri_path}}",
              "install_url": "{{install_url}}"
            }
          ]
        }
      }
    }
  },
  "triggers": {}
}
