{
  "name": "fireberry",
  "label": "Fireberry",
  "description": "",
  "icon": "",
  "hosts": [
    "api.fireberry.com"
  ],
  "upstream": {
    "package": "@activepieces/piece-fireberry",
    "version": "0.1.8"
  },
  "credential": {
    "fields": {
      "token": {
        "label": "API Key",
        "description": "Enter your Fireberry API Key. You can generate it from your Fireberry account settings.",
        "secret": true,
        "required": true
      }
    },
    "headers": {
      "tokenid": "{{credential.token}}"
    }
  },
  "actions": {
    "find_record": {
      "label": "Find Records",
      "description": "Search for records in Fireberry.",
      "inputs": {
        "objectType": {
          "label": "Object Type",
          "required": true
        },
        "searchQuery": {
          "label": "Search Query",
          "description": "Enter search criteria (e.g., \"accountname=John\" or \"email contains @example.com\"). Leave empty to get all records.",
          "type": "multiline"
        },
        "sortBy": {
          "label": "Sort By Field",
          "description": "System name of field to sort by (e.g., \"createdon\", \"accountname\")"
        },
        "sortOrder": {
          "label": "Sort Order",
          "type": "select",
          "options": [
            {
              "value": "desc",
              "label": "Descending (newest first)"
            },
            {
              "value": "asc",
              "label": "Ascending (oldest first)"
            }
          ],
          "defaultValue": "desc"
        },
        "pageSize": {
          "label": "Page Size",
          "description": "Number of records to return (max 50)",
          "type": "number",
          "defaultValue": "25"
        },
        "pageNumber": {
          "label": "Page Number",
          "description": "Page number to retrieve (max 10)",
          "type": "number",
          "defaultValue": "1"
        }
      },
      "request": {
        "method": "GET",
        "url": "https://api.fireberry.com/metadata/records"
      }
    }
  },
  "triggers": {}
}
