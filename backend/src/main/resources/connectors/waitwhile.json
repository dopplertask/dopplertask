{
  "name": "waitwhile",
  "label": "WaitWhile",
  "description": "WaitWhile is an appointment scheduling and queue management platform.",
  "icon": "",
  "hosts": [
    "api.waitwhile.com"
  ],
  "upstream": {
    "package": "@activepieces/piece-waitwhile",
    "version": "0.1.1"
  },
  "credential": {
    "fields": {
      "token": {
        "label": "API Key",
        "description": "\nTo get your Waitwhile API Key:\n\n1. Go to the [Integrations Settings](https://v2.waitwhile.com/account/integrations) page in your Waitwhile account\n2. Create a new API Key (or use an existing one)\n3. Copy the API Key and paste it here\n ",
        "secret": true,
        "required": true
      }
    },
    "headers": {
      "apikey": "{{credential.token}}"
    }
  },
  "actions": {
    "createACustomer": {
      "label": "Create a customer",
      "description": "Create a new customer in Waitwhile",
      "inputs": {
        "firstName": {
          "label": "First Name",
          "description": "Customer first name",
          "required": true
        },
        "lastName": {
          "label": "Last Name",
          "description": "Customer last name"
        },
        "phone": {
          "label": "Phone",
          "description": "Customer phone number"
        },
        "email": {
          "label": "Email",
          "description": "Customer email address"
        },
        "tags": {
          "label": "Tags",
          "description": "Tags associated with the customer",
          "type": "json"
        }
      },
      "request": {
        "method": "POST",
        "url": "https://api.waitwhile.com/v2/customers",
        "body": {
          "firstName": "{{firstName}}",
          "lastName": "{{lastName}}",
          "phone": "{{phone}}",
          "email": "{{email}}"
        }
      }
    },
    "createOrUpdateAVisit": {
      "label": "Create or Update a Visit",
      "description": "Create a new visit or update an existing visit in Waitwhile",
      "inputs": {
        "id": {
          "label": "Visit ID",
          "description": "Select a Visit ID"
        },
        "customerId": {
          "label": "Customer ID",
          "description": "Select a Customer ID",
          "required": true
        },
        "locationId": {
          "label": "Location",
          "description": "Select a Location",
          "required": true
        },
        "notes": {
          "label": "Notes",
          "description": "Visit notes",
          "type": "multiline"
        },
        "partySize": {
          "label": "Party Size",
          "description": "Number of people in the party",
          "type": "number"
        },
        "startDate": {
          "label": "Start Date",
          "description": "Start date/time in ISO format (e.g., 2024-01-01T10:00:00Z)"
        }
      },
      "request": {
        "method": "POST",
        "url": "https://api.waitwhile.com/v2/visits",
        "body": {
          "id": "{{id}}",
          "customerId": "{{customerId}}",
          "locationId": "{{locationId}}",
          "notes": "{{notes}}",
          "partySize": "{{partySize}}",
          "startDate": "{{startDate}}"
        }
      }
    },
    "deleteAVisit": {
      "label": "Delete a visit",
      "description": "Permanently remove a visit from the database. The visit will no longer be retrievable and will not be factored into analytics.",
      "inputs": {
        "visitId": {
          "label": "Visit ID",
          "description": "Select a Visit ID"
        }
      },
      "request": {
        "method": "DELETE",
        "url": "https://api.waitwhile.com/v2/visits/{{visitId}}"
      }
    },
    "searchCustomers": {
      "label": "Search customers",
      "description": "Search for customers by name, phone, email, or identifier",
      "inputs": {
        "q": {
          "label": "Search Query",
          "description": "Search query for name, phone, email, or customer identifier (prefix match)"
        },
        "locationId": {
          "label": "Location ID",
          "description": "Filter by location identifier"
        },
        "state": {
          "label": "Visit State",
          "description": "Filter by visit state",
          "type": "select",
          "options": [
            {
              "value": "PENDING",
              "label": "Pending"
            },
            {
              "value": "DRAFT",
              "label": "Draft"
            },
            {
              "value": "WAITING",
              "label": "Waiting"
            },
            {
              "value": "BOOKED",
              "label": "Cancelled"
            },
            {
              "value": "SERVING",
              "label": "Serving"
            },
            {
              "value": "COMPLETE",
              "label": "Completed"
            }
          ]
        },
        "tag": {
          "label": "Tag",
          "description": "Filter by tag associated with visit"
        },
        "limit": {
          "label": "Limit",
          "description": "Max number of results (1-100, defaults to 20)",
          "type": "number"
        },
        "page": {
          "label": "Page",
          "description": "Page in results (defaults to 1)",
          "type": "number"
        },
        "fromDate": {
          "label": "From Date",
          "description": "Start date in ISO-8601 format (e.g., 2024-01-01T00:00:00Z)"
        },
        "toDate": {
          "label": "To Date",
          "description": "End date in ISO-8601 format (e.g., 2024-12-31T23:59:59Z)"
        }
      },
      "request": {
        "method": "GET",
        "url": "https://api.waitwhile.com/v2/customers/search",
        "query": {
          "q": "{{q}}",
          "locationId": "{{locationId}}",
          "tag": "{{tag}}",
          "limit": "{{limit}}",
          "page": "{{page}}",
          "fromDate": "{{fromDate}}",
          "toDate": "{{toDate}}"
        }
      }
    }
  },
  "triggers": {}
}
