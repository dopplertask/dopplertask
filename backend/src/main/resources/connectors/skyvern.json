{
  "name": "skyvern",
  "label": "Skyvern",
  "description": "",
  "icon": "",
  "hosts": [
    "api.skyvern.com"
  ],
  "upstream": {
    "package": "@activepieces/piece-skyvern",
    "version": "0.2.2"
  },
  "credential": {
    "fields": {
      "token": {
        "label": "API Key",
        "description": "You can obtain your API key by navigating to [Settings](https://app.skyvern.com/settings).",
        "secret": true,
        "required": true
      }
    },
    "headers": {
      "x-api-key": "{{credential.token}}"
    }
  },
  "actions": {
    "run-agent-task": {
      "label": "Run Agent Task",
      "description": "Runs task with specified prompt.",
      "inputs": {
        "prompt": {
          "label": "Prompt",
          "description": "The goal or task description for Skyvern to accomplish.",
          "required": true
        },
        "url": {
          "label": "URL",
          "description": "The starting URL for the task."
        },
        "engine": {
          "label": "Engine",
          "type": "select",
          "options": [
            {
              "value": "skyvern-1.0",
              "label": "Skyvern 1.0"
            },
            {
              "value": "skyvern-2.0",
              "label": "Skyvern 2.0"
            },
            {
              "value": "openai-cua",
              "label": "OpenAI CUA"
            },
            {
              "value": "anthropic-cua",
              "label": "Anthropic CUA"
            }
          ]
        },
        "webhookUrl": {
          "label": "Webhook Callback URL",
          "description": "URL to send task status updates to after a run is finished."
        },
        "proxyLocation": {
          "label": "Proxy Location",
          "type": "select",
          "options": [
            {
              "value": "RESIDENTIAL",
              "label": "Residential"
            },
            {
              "value": "RESIDENTIAL_ES",
              "label": "Spain"
            },
            {
              "value": "RESIDENTIAL_IE",
              "label": "Ireland"
            },
            {
              "value": "RESIDENTIAL_GB",
              "label": "United Kingdom"
            },
            {
              "value": "RESIDENTIAL_IN",
              "label": "India"
            },
            {
              "value": "RESIDENTIAL_JP",
              "label": "Japan"
            },
            {
              "value": "RESIDENTIAL_FR",
              "label": "France"
            },
            {
              "value": "RESIDENTIAL_DE",
              "label": "Germany"
            },
            {
              "value": "RESIDENTIAL_NZ",
              "label": "New Zealand"
            },
            {
              "value": "RESIDENTIAL_ZA",
              "label": "South Africa"
            },
            {
              "value": "RESIDENTIAL_AR",
              "label": "Argentina"
            },
            {
              "value": "RESIDENTIAL_ISP",
              "label": "ISP Proxy"
            },
            {
              "value": "US-CA",
              "label": "California (US)"
            },
            {
              "value": "US-NY",
              "label": "New York (US)"
            },
            {
              "value": "US-TX",
              "label": "Texas (US)"
            },
            {
              "value": "US-FL",
              "label": "Florida (US)"
            },
            {
              "value": "US-WA",
              "label": "Washington (US)"
            },
            {
              "value": "NONE",
              "label": "No Proxy"
            }
          ]
        },
        "maxSteps": {
          "label": "Max Steps",
          "description": "Maximum number of steps the task can take. Task will fail if it exceeds this number.",
          "type": "number"
        },
        "dataExtractionSchema": {
          "label": "Data Extraction Schema",
          "description": "The schema for data to be extracted from the webpage.",
          "type": "json"
        }
      },
      "request": {
        "method": "POST",
        "url": "https://api.skyvern.com/v1/run/tasks",
        "body": {
          "prompt": "{{prompt}}",
          "url": "{{url}}",
          "max_steps": "{{maxSteps}}",
          "webhook_url": "{{webhookUrl}}"
        }
      }
    },
    "run-workflow": {
      "label": "Run Workflow",
      "description": "Runs the workflow.",
      "inputs": {
        "workflowId": {
          "label": "Workflow",
          "required": true
        },
        "title": {
          "label": "Workflow Run Title",
          "description": "The title for this workflow run."
        },
        "proxyLocation": {
          "label": "Proxy Location",
          "type": "select",
          "options": [
            {
              "value": "RESIDENTIAL",
              "label": "Residential"
            },
            {
              "value": "RESIDENTIAL_ES",
              "label": "Spain"
            },
            {
              "value": "RESIDENTIAL_IE",
              "label": "Ireland"
            },
            {
              "value": "RESIDENTIAL_GB",
              "label": "United Kingdom"
            },
            {
              "value": "RESIDENTIAL_IN",
              "label": "India"
            },
            {
              "value": "RESIDENTIAL_JP",
              "label": "Japan"
            },
            {
              "value": "RESIDENTIAL_FR",
              "label": "France"
            },
            {
              "value": "RESIDENTIAL_DE",
              "label": "Germany"
            },
            {
              "value": "RESIDENTIAL_NZ",
              "label": "New Zealand"
            },
            {
              "value": "RESIDENTIAL_ZA",
              "label": "South Africa"
            },
            {
              "value": "RESIDENTIAL_AR",
              "label": "Argentina"
            },
            {
              "value": "RESIDENTIAL_ISP",
              "label": "ISP Proxy"
            },
            {
              "value": "US-CA",
              "label": "California (US)"
            },
            {
              "value": "US-NY",
              "label": "New York (US)"
            },
            {
              "value": "US-TX",
              "label": "Texas (US)"
            },
            {
              "value": "US-FL",
              "label": "Florida (US)"
            },
            {
              "value": "US-WA",
              "label": "Washington (US)"
            },
            {
              "value": "NONE",
              "label": "No Proxy"
            }
          ]
        },
        "webhookUrl": {
          "label": "Webhook Callback URL"
        }
      },
      "request": {
        "method": "POST",
        "url": "https://api.skyvern.com/v1/run/workflows",
        "body": {
          "workflow_id": "{{workflowId}}",
          "webhook_url": "{{webhookUrl}}"
        }
      }
    },
    "cancel-run": {
      "label": "Cancel Run",
      "description": "Cancels a workflow or or task run by ID.",
      "inputs": {
        "runId": {
          "label": "Workflow/Task Run ID",
          "required": true
        }
      },
      "request": {
        "method": "POST",
        "url": "https://api.skyvern.com/v1/runs/{{runId}}/cancel"
      }
    },
    "get-run": {
      "label": "Get Workflow/Task Run",
      "description": "Retrieves a workflow or task run by ID.",
      "inputs": {
        "runId": {
          "label": "Workflow/Task Run ID",
          "required": true
        }
      },
      "request": {
        "method": "GET",
        "url": "https://api.skyvern.com/v1/runs/{{runId}}"
      }
    }
  },
  "triggers": {}
}
