{
  "name": "kimai",
  "label": "Kimai",
  "description": "Open-source time tracking software",
  "icon": "",
  "hosts": [
    "{{credential.base_url}}"
  ],
  "upstream": {
    "package": "@activepieces/piece-kimai",
    "version": "0.3.3"
  },
  "credential": {
    "fields": {
      "base_url": {
        "label": "Server URL",
        "description": "Kimai Instance URL (e.g. https://demo.kimai.org). The host only, without https://, such as name.example.com.",
        "required": true
      },
      "api_token": {
        "label": "API Token",
        "description": "Kimai API Token",
        "secret": true,
        "required": true
      }
    },
    "headers": {
      "authorization": "Bearer {{credential.api_token}}"
    }
  },
  "actions": {
    "create_timesheet": {
      "label": "Create Timesheet",
      "description": "Create a new timesheet",
      "inputs": {
        "project": {
          "label": "Project",
          "description": "Kimai project",
          "required": true
        },
        "activity": {
          "label": "Activity",
          "description": "Kimai activity",
          "required": true
        },
        "begin": {
          "label": "Begin Date",
          "description": "Begin Date of Timesheet",
          "required": true
        },
        "end": {
          "label": "End Date",
          "description": "End Date of Timesheet"
        },
        "description": {
          "label": "Description",
          "description": "Description of Timesheet",
          "type": "multiline"
        }
      },
      "request": {
        "method": "POST",
        "url": "https://{{credential.base_url}}/api/timesheets",
        "body": {
          "project": "{{project}}",
          "activity": "{{activity}}",
          "begin": "{{begin}}",
          "end": "{{end}}",
          "description": "{{description}}"
        }
      }
    }
  },
  "triggers": {}
}
