{
  "name": "invoiceninja",
  "label": "Invoice Ninja",
  "description": "Free open-source invoicing tool",
  "icon": "",
  "hosts": [
    "{{credential.base_url}}"
  ],
  "upstream": {
    "package": "@activepieces/piece-invoiceninja",
    "version": "0.5.3"
  },
  "credential": {
    "fields": {
      "base_url": {
        "label": "Base URL",
        "description": "https://invoicing.co for the hosted service, or your self-hosted address such as https://invoices.example.com. The host only, without https://, such as name.example.com.",
        "required": true
      },
      "access_token": {
        "label": "API Token",
        "description": "Settings > Account Management > API Tokens in Invoice Ninja.",
        "secret": true,
        "required": true
      }
    },
    "headers": {
      "x-api-token": "{{credential.access_token}}"
    }
  },
  "actions": {
    "get_client": {
      "label": "Get Client",
      "description": "Get one client by its ID.",
      "inputs": {
        "id": {
          "label": "Client ID",
          "description": "The Invoice Ninja ID of the client (letters and digits, e.g. VolejRejNm).",
          "required": true
        }
      },
      "request": {
        "method": "GET",
        "url": "https://{{credential.base_url}}/api/v1/clients/{{id}}",
        "headers": {
          "x-requested-with": "XMLHttpRequest"
        }
      }
    },
    "update_client": {
      "label": "Update Client",
      "description": "Change fields of an existing client. Empty fields are left unchanged.",
      "inputs": {
        "client_id": {
          "label": "Client ID",
          "required": true
        },
        "name": {
          "label": "Name"
        },
        "website": {
          "label": "Website"
        },
        "phone": {
          "label": "Phone"
        },
        "vat_number": {
          "label": "VAT Number"
        },
        "id_number": {
          "label": "ID Number"
        },
        "address1": {
          "label": "Address Line 1"
        },
        "address2": {
          "label": "Address Line 2"
        },
        "city": {
          "label": "City"
        },
        "state": {
          "label": "State"
        },
        "postal_code": {
          "label": "Postal Code"
        },
        "public_notes": {
          "label": "Public Notes",
          "type": "multiline"
        },
        "private_notes": {
          "label": "Private Notes",
          "type": "multiline"
        },
        "clear_fields": {
          "label": "Clear Fields",
          "description": "Fields to blank out. Fields you leave empty above are not changed.",
          "type": "json",
          "options": [
            {
              "value": "website",
              "label": "website"
            },
            {
              "value": "phone",
              "label": "phone"
            },
            {
              "value": "vat_number",
              "label": "vat_number"
            },
            {
              "value": "id_number",
              "label": "id_number"
            },
            {
              "value": "address1",
              "label": "address1"
            },
            {
              "value": "address2",
              "label": "address2"
            },
            {
              "value": "city",
              "label": "city"
            },
            {
              "value": "state",
              "label": "state"
            },
            {
              "value": "postal_code",
              "label": "postal_code"
            },
            {
              "value": "public_notes",
              "label": "public_notes"
            },
            {
              "value": "private_notes",
              "label": "private_notes"
            }
          ]
        }
      },
      "request": {
        "method": "PUT",
        "url": "https://{{credential.base_url}}/api/v1/clients/{{client_id}}",
        "headers": {
          "x-requested-with": "XMLHttpRequest"
        },
        "body": {
          "name": "{{name}}",
          "website": "{{website}}",
          "phone": "{{phone}}",
          "vat_number": "{{vat_number}}",
          "id_number": "{{id_number}}",
          "address1": "{{address1}}",
          "address2": "{{address2}}",
          "city": "{{city}}",
          "state": "{{state}}",
          "postal_code": "{{postal_code}}",
          "public_notes": "{{public_notes}}",
          "private_notes": "{{private_notes}}"
        }
      }
    },
    "archive_client": {
      "label": "Archive Client",
      "description": "Archive a client (hidden from lists, can be restored).",
      "inputs": {
        "id": {
          "label": "Client ID",
          "description": "The Invoice Ninja ID of the client.",
          "required": true
        }
      },
      "request": {
        "method": "POST",
        "url": "https://{{credential.base_url}}/api/v1/clients/bulk",
        "headers": {
          "x-requested-with": "XMLHttpRequest"
        },
        "body": {
          "action": "archive",
          "ids": [
            "{{id}}"
          ]
        }
      }
    },
    "restore_client": {
      "label": "Restore Client",
      "description": "Restore an archived or deleted client.",
      "inputs": {
        "id": {
          "label": "Client ID",
          "description": "The Invoice Ninja ID of the client.",
          "required": true
        }
      },
      "request": {
        "method": "POST",
        "url": "https://{{credential.base_url}}/api/v1/clients/bulk",
        "headers": {
          "x-requested-with": "XMLHttpRequest"
        },
        "body": {
          "action": "restore",
          "ids": [
            "{{id}}"
          ]
        }
      }
    },
    "delete_client": {
      "label": "Delete Client",
      "description": "Delete a client (soft delete, can be restored).",
      "inputs": {
        "id": {
          "label": "Client ID",
          "description": "The Invoice Ninja ID of the client.",
          "required": true
        }
      },
      "request": {
        "method": "POST",
        "url": "https://{{credential.base_url}}/api/v1/clients/bulk",
        "headers": {
          "x-requested-with": "XMLHttpRequest"
        },
        "body": {
          "action": "delete",
          "ids": [
            "{{id}}"
          ]
        }
      }
    },
