{
  "name": "knock",
  "label": "Knock",
  "description": "Notification infrastructure for developers. Manage users, trigger workflows, and track messages.",
  "icon": "",
  "hosts": [
    "api.knock.app"
  ],
  "upstream": {
    "package": "@activepieces/piece-knock",
    "version": "0.2.2"
  },
  "credential": {
    "fields": {
      "token": {
        "label": "Knock Secret API Key",
        "description": "Your Knock secret API key (starts with sk_). Found under Developer > API Keys in the Knock dashboard.",
        "secret": true,
        "required": true
      }
    },
    "headers": {
      "authorization": "Bearer {{credential.token}}"
    }
  },
  "actions": {
    "identify_user": {
      "label": "Identify User",
      "description": "Create or update a user in Knock.",
      "inputs": {
        "userId": {
          "label": "User ID",
          "description": "A unique identifier for the user in your system.",
          "required": true
        },
        "name": {
          "label": "Name",
          "description": "The user display name."
        },
        "email": {
          "label": "Email",
          "description": "The user email address."
        },
        "phoneNumber": {
          "label": "Phone Number",
          "description": "Phone number in E.164 format (e.g. +14155552671)."
        },
        "avatar": {
          "label": "Avatar URL",
          "description": "URL to the user avatar image."
        },
        "customProperties": {
          "label": "Custom Properties",
          "description": "Additional key-value properties to set on the user.",
          "type": "json"
        }
      },
      "request": {
        "method": "PUT",
        "url": "https://api.knock.app/v1/users/{{userId}}",
        "body": {
          "name": "{{name}}",
          "email": "{{email}}",
          "phone_number": "{{phoneNumber}}",
          "avatar": "{{avatar}}"
        }
      }
    },
    "get_user": {
      "label": "Get User",
      "description": "Retrieve a user from Knock by their ID.",
      "inputs": {
        "userId": {
          "label": "User ID",
          "description": "The unique identifier of the user to retrieve.",
          "required": true
        }
      },
      "request": {
        "method": "GET",
        "url": "https://api.knock.app/v1/users/{{userId}}"
      }
    },
    "delete_user": {
      "label": "Delete User",
      "description": "Delete a user from Knock by their ID.",
      "inputs": {
        "userId": {
          "label": "User ID",
          "description": "The unique identifier of the user to delete.",
          "required": true
        }
      },
      "request": {
        "method": "DELETE",
        "url": "https://api.knock.app/v1/users/{{userId}}"
      }
    },
    "get_message": {
      "label": "Get Message",
      "description": "Retrieve a Knock message by its ID.",
      "inputs": {
        "messageId": {
          "label": "Message ID",
          "description": "The unique identifier of the message.",
          "required": true
        }
      },
      "request": {
        "method": "GET",
        "url": "https://api.knock.app/v1/messages/{{messageId}}"
      }
    },
    "list_messages": {
      "label": "List Messages",
      "description": "List Knock messages with optional filters and pagination.",
      "inputs": {
        "channel_id": {
          "label": "Channel ID",
          "description": "Filter messages by channel ID."
        },
        "status": {
          "label": "Status",
          "description": "Filter messages by delivery status.",
          "type": "select",
          "options": [
            {
              "value": "queued",
              "label": "Queued"
            },
            {
              "value": "sent",
              "label": "Sent"
            },
            {
              "value": "delivered",
              "label": "Delivered"
            },
            {
              "value": "bounced",
              "label": "Bounced"
            },
            {
              "value": "undelivered",
              "label": "Undelivered"
            },
            {
              "value": "not_sent",
              "label": "Not sent"
            }
          ]
        },
        "source": {
          "label": "Workflow Key",
          "description": "Filter by the workflow that generated the message."
        },
        "tenant": {
          "label": "Tenant",
          "description": "Filter messages by tenant."
        },
        "page_size": {
          "label": "Page Size",
          "description": "Number of messages per page (1–50, default 50).",
          "type": "number",
          "defaultValue": "50"
        },
        "after": {
          "label": "After Cursor",
          "description": "Cursor for forward pagination."
        }
      },
      "request": {
        "method": "GET",
        "url": "https://api.knock.app/v1/messages",
        "query": {
          "channel_id": "{{channel_id}}",
          "source": "{{source}}",
          "tenant": "{{tenant}}",
          "page_size": "50",
          "after": "{{after}}"
        }
      }
    }
  },
  "triggers": {}
}
