{
  "name": "maileroo",
  "label": "Maileroo",
  "description": "Email Delivery Service with Real-Time Analytics and Reporting",
  "icon": "",
  "hosts": [
    "verify.maileroo.net"
  ],
  "upstream": {
    "package": "@activepieces/piece-maileroo",
    "version": "0.3.1"
  },
  "credential": {
    "fields": {
      "keyType": {
        "label": "Type",
        "description": "",
        "required": true
      },
      "apiKey": {
        "label": "API Key",
        "description": "",
        "secret": true,
        "required": true
      }
    },
    "headers": {
      "x-api-key": "{{credential.apiKey}}"
    }
  },
  "actions": {
    "verifyEmail": {
      "label": "Verify Email",
      "description": "Verifies an email address.",
      "inputs": {
        "content": {
          "label": "Email",
          "description": "Email to verify",
          "required": true
        }
      },
      "request": {
        "method": "POST",
        "url": "https://verify.maileroo.net/check",
        "body": {
          "email_address": "{{content}}"
        }
      }
    }
  },
  "triggers": {}
}
