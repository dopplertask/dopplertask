{
  "name": "respaid",
  "label": "Respaid",
  "description": "",
  "icon": "",
  "hosts": [
    "backend.widr.app"
  ],
  "upstream": {
    "package": "@activepieces/piece-respaid",
    "version": "0.1.7"
  },
  "credential": {
    "fields": {
      "token": {
        "label": "API Key",
        "description": "You can find API Key in your Respaid account",
        "secret": true,
        "required": true
      }
    },
    "headers": {
      "x-api-key": "{{credential.token}}"
    }
  },
  "actions": {
    "stop_collection_client_paid_directly": {
      "label": "Stop Collection for Direct Full Payment",
      "description": "Stops the collection process for a case and mark it as paid directly to the creditor.",
      "inputs": {
        "unique_identifier": {
          "label": "Unique Identifier"
        },
        "email": {
          "label": "Email"
        },
        "invoice_number": {
          "label": "Invoice Number"
        }
      },
      "request": {
        "method": "POST",
        "url": "https://backend.widr.app/api/workflow/actions/stop_collection_client_paid_directly",
        "body": {
          "type": "active_pieces",
          "payload": "{\"unique_identifier\":\"{{unique_identifier}}\",\"invoice_number\":\"{{invoice_number}}\",\"email\":\"{{email}}\"}"
        }
      }
    },
    "stop_collection_for_direct_partial_payment": {
      "label": "Stop Collection for Direct Partial Payment",
      "description": "Stops the collection process for a case and mark it as partially paid directly to the creditor.",
      "inputs": {
        "unique_identifier": {
          "label": "Unique Identifier"
        },
        "amount": {
          "label": "Amount"
        },
        "email": {
          "label": "Email"
        },
        "invoice_number": {
          "label": "Invoice Number"
        }
      },
      "request": {
        "method": "POST",
        "url": "https://backend.widr.app/api/workflow/actions/stop_collection_for_direct_partial_payment",
        "body": {
          "type": "active_pieces",
          "payload": "{\"unique_identifier\":\"{{unique_identifier}}\",\"invoice_number\":\"{{invoice_number}}\",\"amount\":\"{{amount}}\",\"email\":\"{{email}}\"}"
        }
      }
    },
    "stop_collection_for_direct_instalment_payment": {
      "label": "Stop Collection for Direct Instalment Payment",
      "description": "Stops the collection process for a case when an instalment plan is set up with the creditor.",
      "inputs": {
        "unique_identifier": {
          "label": "Unique Identifier"
        },
        "email": {
          "label": "Email"
        },
        "invoice_number": {
          "label": "Invoice Number"
        }
      },
      "request": {
        "method": "POST",
        "url": "https://backend.widr.app/api/workflow/actions/stop_collection_for_direct_instalment_payment",
        "body": {
          "type": "active_pieces",
          "payload": "{\"unique_identifier\":\"{{unique_identifier}}\",\"invoice_number\":\"{{invoice_number}}\",\"email\":\"{{email}}\"}"
        }
      }
    }
  },
  "triggers": {}
}
