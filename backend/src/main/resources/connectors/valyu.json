{
  "name": "valyu",
  "label": "Valyu",
  "description": "Search the web, research papers, and proprietary datasets with intelligent query processing.",
  "icon": "",
  "hosts": [
    "api.valyu.ai"
  ],
  "upstream": {
    "package": "@activepieces/piece-valyu",
    "version": "0.1.1"
  },
  "credential": {
    "fields": {
      "token": {
        "label": "API Key",
        "description": "Obtain your API key from [Valyu Platform](https://platform.valyu.ai/user/account/apikeys).",
        "secret": true,
        "required": true
      }
    },
    "headers": {
      "x-api-key": "{{credential.token}}"
    }
  },
  "actions": {
    "search": {
      "label": "Search",
      "description": "Search the web, research papers, and proprietary datasets to retrieve relevant context.",
      "inputs": {
        "query": {
          "label": "Query",
          "description": "The search query to find relevant content.",
          "required": true
        },
        "max_num_results": {
          "label": "Max Results",
          "description": "Maximum number of results to return (1-20 for standard API keys, up to 100 with special API key).",
          "type": "number",
          "defaultValue": "10"
        },
        "search_type": {
          "label": "Search Type",
          "description": "Type of search to perform. 'web' searches web content. 'proprietary' uses Valyu's full-text multimodal indices. 'news' returns only news articles.",
          "type": "select",
          "options": [
            {
              "value": "all",
              "label": "All"
            },
            {
              "value": "web",
              "label": "Web"
            },
            {
              "value": "proprietary",
              "label": "Proprietary"
            },
            {
              "value": "news",
              "label": "News"
            }
          ],
          "defaultValue": "all"
        },
        "fast_mode": {
          "label": "Fast Mode",
          "description": "Enable fast mode for reduced latency but shorter results. Best for general purpose queries.",
          "type": "boolean",
          "defaultValue": "false"
        },
        "max_price": {
          "label": "Max Price (CPM)",
          "description": "Maximum price in dollars for a thousand retrievals (CPM). Only applies when provided.",
          "type": "number"
        },
        "relevance_threshold": {
          "label": "Relevance Threshold",
          "description": "Minimum relevance score for results (0.0-1.0).",
          "type": "number",
          "defaultValue": "0.5"
        },
        "included_sources": {
          "label": "Included Sources",
          "description": "Specific sources to search (URLs, domains or dataset names).",
          "type": "json"
        },
        "excluded_sources": {
          "label": "Excluded Sources",
          "description": "Specific sources to exclude from search (URLs, domains, or dataset names).",
          "type": "json"
        },
        "category": {
          "label": "Category",
          "description": "Natural language category/guide phrase to help guide the search (e.g., \"agentic use-cases\")."
        },
        "response_length": {
          "label": "Response Length",
          "description": "Controls the length of content returned per result.",
          "type": "select",
          "options": [
            {
              "value": "short",
              "label": "Short (25k chars)"
            },
            {
              "value": "medium",
              "label": "Medium (50k chars)"
            },
            {
              "value": "large",
              "label": "Large (100k chars)"
            },
            {
              "value": "max",
              "label": "Max (full content)"
            }
          ],
          "defaultValue": "short"
        },
        "country_code": {
          "label": "Country Code",
          "description": "2-letter ISO country code to bias search results (e.g., US, GB, DE)."
        },
        "start_date": {
          "label": "Start Date",
          "description": "Start date for time-filtered searches (YYYY-MM-DD)."
        },
        "end_date": {
          "label": "End Date",
          "description": "End date for time-filtered searches (YYYY-MM-DD)."
        },
        "url_only": {
          "label": "URL Only",
          "description": "When set to true, only returns URLs for results (no content). Only applies when search_type is web or news.",
          "type": "boolean",
          "defaultValue": "false"
        }
      },
      "request": {
        "method": "POST",
        "url": "https://api.valyu.ai/v1/search",
        "body": {
          "query": "{{query}}",
          "max_num_results": "{{max_num_results}}",
          "max_price": "{{max_price}}",
          "relevance_threshold": "{{relevance_threshold}}",
          "category": "{{category}}",
          "country_code": "{{country_code}}",
          "start_date": "{{start_date}}",
          "end_date": "{{end_date}}"
        }
      }
    },
    "list_datasources": {
      "label": "List Datasources",
      "description": "List all available datasources with metadata, schemas, and pricing. Useful for discovering available data sources.",
      "inputs": {
        "category": {
          "label": "Category",
          "description": "Filter datasources by category.",
          "type": "select",
          "options": [
            {
              "value": "",
              "label": "All"
            },
            {
              "value": "research",
              "label": "Research & Academic"
            },
            {
              "value": "healthcare",
              "label": "Healthcare"
            },
            {
              "value": "patents",
              "label": "Patents"
            },
            {
              "value": "markets",
              "label": "Financial Markets"
            },
            {
              "value": "company",
              "label": "Company"
            },
            {
              "value": "economic",
              "label": "Economic"
            },
            {
              "value": "predictions",
              "label": "Predictions"
            },
            {
              "value": "transportation",
              "label": "Transportation"
            },
            {
              "value": "legal",
              "label": "Legal"
            },
            {
              "value": "politics",
              "label": "Politics"
            }
          ]
        }
      },
      "request": {
        "method": "GET",
        "url": "https://api.valyu.ai/v1/datasources"
      }
    }
  },
  "triggers": {}
}
