    "getDocumentAttachments": {
      "label": "Get Document Attachment",
      "description": "Retrieves details of a specific attachment from a document.",
      "inputs": {
        "document_id": {
          "label": "Document",
          "description": "Select a document. The newest documents are listed first; type to search by name.",
          "required": true
