{
  "name": "pandadoc",
  "label": "PandaDoc",
  "description": "Create, send and track documents, proposals and e-signatures.",
  "icon": "",
  "hosts": [
    "api.pandadoc.com"
  ],
  "upstream": {
    "package": "@activepieces/piece-pandadoc",
    "version": "0.3.2"
  },
  "credential": {
    "fields": {
      "token": {
        "label": "API Key",
        "description": "Your PandaDoc API key.\n\n1. In PandaDoc, open **Settings > Integrations > API** (the Developer Dashboard).\n2. Copy the **Sandbox** key for testing or the **Production** key for live documents.\n3. Paste it here.\n\nSandbox keys are limited to 10 requests per minute and can only send documents to email addresses in your own domain.",
        "secret": true,
        "required": true
      }
    },
    "headers": {
      "authorization": "API-Key {{credential.token}}"
    }
  },
  "actions": {
    "createAttachment": {
      "label": "Create Attachment",
      "description": "Adds an attachment to a document, from a file URL or an uploaded file.",
      "inputs": {
        "document_id": {
          "label": "Document",
          "description": "Select a document. The newest documents are listed first; type to search by name.",
          "required": true
        },
        "source": {
          "label": "File URL",
          "description": "Public URL of the file to attach. Leave empty when you use the File field instead."
        },
        "file": {
          "label": "File",
          "description": "A file from a previous step to attach. Used instead of the File URL when both are set.",
          "type": "file"
        },
        "name": {
          "label": "Attachment Name",
          "description": "Optional name to set for the uploaded file."
        }
      },
      "request": {
        "method": "POST",
        "url": "https://api.pandadoc.com/public/v1/documents/{{document_id}}/attachments",
        "body": {
          "source": "{{source}}",
          "name": "{{name}}"
        }
      }
    },
