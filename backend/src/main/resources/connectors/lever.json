{
  "name": "lever",
  "label": "Lever",
  "description": "Lever is a modern, collaborative recruiting platform that powers a more human approach to hiring.",
  "icon": "",
  "hosts": [
    "api.lever.co"
  ],
  "upstream": {
    "package": "@activepieces/piece-lever",
    "version": "0.2.1"
  },
  "credential": {
    "fields": {
      "apiKey": {
        "label": "API key",
        "description": "",
        "secret": true,
        "required": true
      }
    }
  },
  "actions": {
    "getOpportunity": {
      "label": "Get opportunity",
      "description": "Retrieve a single opportunity, i.e. an individual's unique candidacy or journey for a given job position",
      "inputs": {
        "opportunityId": {
          "label": "Opportunity ID",
          "required": true
        },
        "expand": {
          "label": "Expand",
          "type": "json"
        }
      },
      "request": {
        "method": "GET",
        "url": "https://api.lever.co/v1/opportunities/{{opportunityId}}",
        "headers": {
          "authorization": "Basic Y3JlZGVudGlhbDAwMHo6"
        }
      }
    },
    "updateOpportunityStage": {
      "label": "Update opportunity stage",
      "description": "Change an Opportunity's current stage",
      "inputs": {
        "opportunityId": {
          "label": "Opportunity ID",
          "required": true
        },
        "stage": {
          "label": "Stage",
          "required": true
        }
      },
      "request": {
        "method": "PUT",
        "url": "https://api.lever.co/v1/opportunities/{{opportunityId}}/stage",
        "headers": {
          "authorization": "Basic Y3JlZGVudGlhbDAwMHo6"
        },
        "body": {
          "stage": "{{stage}}"
        }
      }
    },
    "listOpportunityForms": {
      "label": "List opportunity forms",
      "description": "Get all forms for a given opportunity, optionally for a given form template",
      "inputs": {
        "opportunityId": {
          "label": "Opportunity ID",
          "required": true
        },
        "template": {
          "label": "Form template"
        }
      },
      "request": {
        "method": "GET",
        "url": "https://api.lever.co/v1/opportunities/{{opportunityId}}/forms",
        "headers": {
          "authorization": "Basic Y3JlZGVudGlhbDAwMHo6"
        }
      }
    },
    "listOpportunityFeedback": {
      "label": "List opportunity feedback",
      "description": "Get all feedback for a given opportunity, optionally for a given template",
      "inputs": {
        "opportunityId": {
          "label": "Opportunity ID",
          "required": true
        },
        "template": {
          "label": "Feedback template"
        }
      },
      "request": {
        "method": "GET",
        "url": "https://api.lever.co/v1/opportunities/{{opportunityId}}/feedback",
        "headers": {
          "authorization": "Basic Y3JlZGVudGlhbDAwMHo6"
        }
      }
    },
    "addFeedbackToOpportunity": {
      "label": "Add feedback to opportunity",
      "description": "Provide feedback to a candidate after an interview",
      "inputs": {
        "performAs": {
          "label": "Feedback author",
          "required": true
        },
        "opportunityId": {
          "label": "Opportunity ID",
          "required": true
        },
        "panelId": {
          "label": "Interview panel",
          "description": "If you select one, you must select an interview too"
        },
        "interviewId": {
          "label": "Interview",
          "description": "Mandatory is you select an interview panel"
        },
        "feedbackTemplateId": {
          "label": "Feedback template",
          "description": "Ignored if you select an interview panel and an interview"
        }
      },
      "request": {
        "method": "GET",
        "url": "https://api.lever.co/v1/opportunities/{{opportunityId}}/panels/{{panelId}}",
        "query": {
          "include": "interviews"
        },
        "headers": {
          "authorization": "Basic Y3JlZGVudGlhbDAwMHo6"
        }
      }
    }
  },
  "triggers": {}
}
