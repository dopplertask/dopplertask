{
  "name": "hume-ai",
  "label": "Hume AI",
  "description": "",
  "icon": "",
  "hosts": [
    "api.hume.ai"
  ],
  "upstream": {
    "package": "@activepieces/piece-hume-ai",
    "version": "0.1.10"
  },
  "credential": {
    "fields": {
      "token": {
        "label": "API Key",
        "description": "Enter your Hume AI API key from the Hume Portal (https://platform.hume.ai/settings/keys)",
        "secret": true,
        "required": true
      }
    },
    "headers": {
      "x-hume-api-key": "{{credential.token}}"
    }
  },
  "actions": {
    "get_emotion_results": {
      "label": "Get Emotion Results",
      "description": "Retrieve emotion analysis predictions from a completed batch job",
      "inputs": {
        "jobId": {
          "label": "Job ID",
          "description": "The ID of the emotion analysis job to retrieve results for",
          "required": true
        }
      },
      "request": {
        "method": "GET",
        "url": "https://api.hume.ai/v0/batch/jobs/{{jobId}}/predictions",
        "headers": {
          "x-fern-language": "JavaScript",
          "x-fern-runtime": "node",
          "x-fern-runtime-version": "26.13.0",
          "x-fern-sdk-name": "hume",
          "x-fern-sdk-version": "0.15.16",
          "x-hume-client-name": "typescript_sdk",
          "x-hume-client-version": "0.15.16"
        }
      }
    }
  },
  "triggers": {}
}
