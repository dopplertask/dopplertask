{
  "name": "contentful",
  "label": "Contentful",
  "description": "Content infrastructure for digital teams",
  "icon": "contentful",
  "hosts": [
    "api.contentful.com"
  ],
  "upstream": {
    "package": "@activepieces/piece-contentful",
    "version": "0.2.2"
  },
  "credential": {
    "fields": {
      "apiKey": {
        "label": "Contentful Access Token",
        "description": "",
        "required": true
      },
      "space": {
        "label": "Space",
        "description": "",
        "required": true
      },
      "environment": {
        "label": "Environment",
        "description": "",
        "required": true
      }
    },
    "headers": {
      "authorization": "Bearer {{credential.apiKey}}"
    }
  },
  "actions": {
    "contentful_record_get": {
      "label": "Get Record",
      "description": "Gets a Contentful record for a given Content Model",
      "inputs": {
        "entityId": {
          "label": "Entity ID",
          "description": "The ID of the record to get.",
          "required": true
        }
      },
      "request": {
        "method": "GET",
        "url": "https://api.contentful.com/spaces/{{credential.space}}/environments/{{credential.environment}}/entries/{{entityId}}",
        "headers": {
          "content-type": "application/vnd.contentful.management.v1+json",
          "x-contentful-user-agent": "sdk contentful-management-plain.js/11.48.1; platform node.js/v26.13.0; os macOS/v26.13.0;"
        }
      }
    },
    "contentful_record_create": {
      "label": "Create Record",
      "description": "Creates a new Contentful record for a given Content Model",
      "inputs": {
        "locale": {
          "label": "Content Locale",
          "required": true
        },
        "contentModel": {
          "label": "Content Model",
          "required": true
        },
        "publishOnCreate": {
          "label": "Publish after Creating",
          "description": "Whether or not to publish this record after creating it.",
          "required": true,
          "type": "boolean",
          "defaultValue": "false"
        }
      },
      "request": {
        "method": "GET",
        "url": "https://api.contentful.com/spaces/{{credential.space}}/environments/{{credential.environment}}/content_types/{{contentModel}}",
        "headers": {
          "content-type": "application/vnd.contentful.management.v1+json",
          "x-contentful-user-agent": "sdk contentful-management-plain.js/11.48.1; platform node.js/v26.13.0; os macOS/v26.13.0;"
        }
      }
    }
  },
  "triggers": {}
}
