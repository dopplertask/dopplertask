{
  "name": "clicksend",
  "label": "ClickSend SMS",
  "description": "Cloud-based messaging platform for sending SMS, MMS, voice, email, and more.",
  "icon": "",
  "hosts": [
    "rest.clicksend.com"
  ],
  "upstream": {
    "package": "@activepieces/piece-clicksend",
    "version": "0.2.1"
  },
  "credential": {
    "fields": {
      "username": {
        "label": "Username",
        "required": true
      },
      "password": {
        "label": "API Key",
        "secret": true,
        "required": true
      }
    },
    "basic": {
      "username": "{{credential.username}}",
      "password": "{{credential.password}}"
    }
  },
  "actions": {
    "send_mms": {
      "label": "Send MMS",
      "description": "Send one or more MMS messages.",
      "inputs": {
        "to": {
          "label": "To",
          "description": "The phone number (with country code, e.g., +1234567890)",
          "required": true
        },
        "body": {
          "label": "Message Body",
          "description": "The body of the message to send",
          "required": true
        },
        "subject": {
          "label": "Subject",
          "required": true
        },
        "from": {
          "label": "From",
          "required": true
        },
        "media_url": {
          "label": "Media URL",
          "description": "The URL of the media file to send (image, video, etc.)",
          "required": true
        }
      },
      "request": {
        "method": "POST",
        "url": "https://rest.clicksend.com/v3/mms/send",
        "body": {
          "media_file": "{{media_url}}",
          "messages": [
            {
              "subject": "{{subject}}",
              "from": "{{from}}",
              "body": "{{body}}",
              "to": "{{to}}"
            }
          ]
        }
      }
    },
    "create_contact_list": {
      "label": "Create Contact List",
      "description": "Creates a new contact list.",
      "inputs": {
        "list_name": {
          "label": "List Name",
          "required": true
        }
      },
      "request": {
        "method": "POST",
        "url": "https://rest.clicksend.com/v3/lists",
        "body": {
          "list_name": "{{list_name}}"
        }
      }
    }
  },
  "triggers": {}
}
