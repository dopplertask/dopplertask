{
  "name": "nocodb",
  "label": "NocoDB",
  "description": "",
  "icon": "",
  "hosts": [
    "{{credential.baseUrl}}"
  ],
  "upstream": {
    "package": "@activepieces/piece-nocodb",
    "version": "0.6.0"
  },
  "credential": {
    "fields": {
      "baseUrl": {
        "label": "NocoDB Base URL",
        "description": "The host only, without https://, such as name.example.com.",
        "required": true
      },
      "apiToken": {
        "label": "API Token",
        "description": "",
        "secret": true,
        "required": true
      },
      "version": {
        "label": "API Version",
        "description": "Required only for self-hosted instances. Not needed for the cloud version."
      }
    },
    "headers": {
      "xc-token": "{{credential.apiToken}}"
    }
  },
  "actions": {
    "nocodb-delete-record": {
      "label": "Delete a Record",
      "description": "Deletes a record with the given Record ID.",
      "inputs": {
        "workspaceId": {
          "label": "Workspace ID",
          "description": "For self-hosted instances,select \"No Workspace\"."
        },
        "baseId": {
          "label": "Base ID",
          "required": true
        },
        "tableId": {
          "label": "Table ID",
          "required": true
        },
        "recordId": {
          "label": "Record ID",
          "required": true,
          "type": "number"
        }
      },
      "request": {
        "method": "DELETE",
        "url": "https://{{credential.baseUrl}}/api/v1/db/data/noco/{{tableId}}/{{recordId}}"
      }
    },
    "nocodb-get-record": {
      "label": "Get a Record",
      "description": "Gets a record by the Record ID.",
      "inputs": {
        "workspaceId": {
          "label": "Workspace ID",
          "description": "For self-hosted instances,select \"No Workspace\"."
        },
        "baseId": {
          "label": "Base ID",
          "required": true
        },
        "tableId": {
          "label": "Table ID",
          "required": true
        },
        "recordId": {
          "label": "Record ID",
          "required": true,
          "type": "number"
        }
      },
      "request": {
        "method": "GET",
        "url": "https://{{credential.baseUrl}}/api/v1/db/data/noco/{{tableId}}/{{recordId}}"
      }
    },
    "nocodb-get-current-user": {
      "label": "Get Current User",
      "description": "Returns the profile and roles of the authenticated user.",
      "inputs": {
        "baseId": {
          "label": "Base ID"
        }
      },
      "request": {
        "method": "GET",
        "url": "https://{{credential.baseUrl}}/api/v1/auth/user/me",
        "query": {
          "base_id": "{{baseId}}"
        }
      }
    },
    "nocodb-list-workspaces": {
      "label": "List Workspaces",
      "description": "Returns the workspaces visible to the authenticated account.",
      "inputs": {},
      "request": {
        "method": "GET",
        "url": "https://{{credential.baseUrl}}/api/v1/workspaces/"
      }
    },
    "nocodb-list-bases": {
      "label": "List Bases",
      "description": "Returns the bases within the given workspace (or the instance, on self-hosted).",
      "inputs": {
        "workspaceId": {
          "label": "Workspace ID",
          "description": "Leave unset on self-hosted instances."
        }
      },
      "request": {
        "method": "GET",
        "url": "https://{{credential.baseUrl}}/api/v1/workspaces/{{workspaceId}}/bases/"
      }
    },
    "nocodb-get-table-schema": {
      "label": "Get Table Schema",
      "description": "Returns the columns and metadata of the given table.",
      "inputs": {
        "baseId": {
          "label": "Base ID",
          "required": true
        },
        "tableId": {
          "label": "Table ID",
          "required": true
        }
      },
      "request": {
        "method": "GET",
        "url": "https://{{credential.baseUrl}}/api/v1/db/meta/tables/{{tableId}}/"
      }
    },
    "nocodb-list-view-sorts": {
      "label": "List View Sorts",
      "description": "Returns the sort rules configured on the given view.",
      "inputs": {
        "viewId": {
          "label": "View ID",
          "required": true
        }
      },
      "request": {
        "method": "GET",
        "url": "https://{{credential.baseUrl}}/api/v1/db/meta/views/{{viewId}}/sorts"
      }
    },
    "nocodb-create-grid-view": {
      "label": "Create Grid View",
      "description": "Creates a new grid view on the given table.",
      "inputs": {
        "tableId": {
          "label": "Table ID",
          "required": true
        },
        "title": {
          "label": "Title",
          "required": true
        }
      },
      "request": {
        "method": "POST",
        "url": "https://{{credential.baseUrl}}/api/v1/db/meta/tables/{{tableId}}/grids",
        "body": {
          "title": "{{title}}"
        }
      }
    },
    "nocodb-list-view-columns": {
      "label": "List View Columns",
      "description": "Returns the columns configured on the given view, with their view-scoped column IDs.",
      "inputs": {
        "viewId": {
          "label": "View ID",
          "required": true
        }
      },
      "request": {
        "method": "GET",
        "url": "https://{{credential.baseUrl}}/api/v1/db/meta/views/{{viewId}}/columns"
      }
    },
    "nocodb-update-view-column": {
      "label": "Update View Column",
      "description": "Shows, hides, or reorders a column within a view.",
      "inputs": {
        "viewId": {
          "label": "View ID",
          "required": true
        },
        "columnId": {
          "label": "View Column ID",
          "description": "The view-scoped column ID from List View Columns, not the table column ID.",
          "required": true
        },
        "show": {
          "label": "Show",
          "description": "Whether the column is visible in the view. Leave empty or pick Leave unchanged to keep the current setting.",
          "type": "select",
          "options": [
            {
              "value": "yes",
              "label": "Yes"
            },
            {
              "value": "no",
              "label": "No"
            },
            {
              "value": "unchanged",
              "label": "Leave unchanged"
            }
          ]
        },
        "order": {
          "label": "Order",
          "type": "number"
        }
      },
      "request": {
        "method": "PATCH",
        "url": "https://{{credential.baseUrl}}/api/v1/db/meta/views/{{viewId}}/columns/{{columnId}}",
        "body": {
          "order": "{{order}}"
        }
      }
    },
    "nocodb-delete-view": {
      "label": "Delete View",
      "description": "Deletes the given view.",
      "inputs": {
        "viewId": {
          "label": "View ID",
          "required": true
        }
      },
      "request": {
        "method": "DELETE",
        "url": "https://{{credential.baseUrl}}/api/v1/db/meta/views/{{viewId}}"
      }
    },
    "nocodb-list-notifications": {
      "label": "List Notifications",
      "description": "Returns the authenticated user's notifications.",
      "inputs": {
        "isRead": {
          "label": "Read Only",
          "description": "When checked, returns only already-read notifications. Leave unchecked to return all notifications (read and unread) — there is no unread-only filter.",
          "type": "boolean"
        },
        "limit": {
          "label": "Limit",
          "type": "number",
          "defaultValue": "25"
        },
        "offset": {
          "label": "Offset",
          "type": "number",
          "defaultValue": "0"
        }
      },
      "request": {
        "method": "GET",
        "url": "https://{{credential.baseUrl}}/api/v1/notifications",
        "query": {
          "limit": "{{limit}}",
          "offset": "{{offset}}"
        }
      }
    },
    "nocodb-get-shared-view-grouped-data": {
      "label": "Get Shared View Grouped Data",
      "description": "Returns the records of a public shared view, grouped by the given column.",
      "inputs": {
        "sharedViewUuid": {
          "label": "Shared View UUID",
          "description": "The UUID from the view's public share link.",
          "required": true
        },
        "columnId": {
          "label": "Column ID",
          "description": "The table column ID to group records by.",
          "required": true
        },
        "password": {
          "label": "Share Password",
          "description": "Only required if the shared view link is password-protected."
        }
      },
      "request": {
        "method": "GET",
        "url": "https://{{credential.baseUrl}}/api/v1/db/public/shared-view/{{sharedViewUuid}}/group/{{columnId}}",
        "headers": {
          "xc-password": "{{password}}"
        }
      }
    },
    "nocodb-upload-attachment-by-url": {
      "label": "Upload Attachment By URL",
      "description": "Uploads a file to NocoDB storage from a public URL, for use in an attachment column.",
      "inputs": {
        "url": {
          "label": "File URL",
          "required": true
        },
        "path": {
          "label": "Target Path",
          "description": "The storage path to upload to, e.g. download/noco/<base>/<table>/attachment.",
          "required": true
        },
        "title": {
          "label": "Title",
          "description": "Display name for the attachment."
        },
        "mimetype": {
          "label": "MIME Type"
        }
      },
      "request": {
        "method": "POST",
        "url": "https://{{credential.baseUrl}}/api/v1/db/storage/upload-by-url",
        "query": {
          "path": "{{path}}"
        },
        "body": [
          {
            "url": "{{url}}",
            "title": "{{title}}",
            "mimetype": "{{mimetype}}"
          }
        ]
      }
    }
  },
  "triggers": {}
}
