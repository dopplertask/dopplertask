{
  "name": "klenty",
  "label": "Klenty",
  "description": "Sales engagement platform for managing prospects and adding them to outreach cadences.",
  "icon": "",
  "hosts": [
    "app.klenty.com"
  ],
  "upstream": {
    "package": "@activepieces/piece-klenty",
    "version": "0.1.1"
  },
  "credential": {
    "fields": {
      "username": {
        "label": "Username / Email",
        "description": "The Klenty username or email used in the API URL path (for example: you@company.com).",
        "required": true
      },
      "apiKey": {
        "label": "API Key",
        "description": "Your Klenty API key.",
        "secret": true,
        "required": true
      }
    },
    "headers": {
      "api_key": "{{credential.apiKey}}",
      "x-api-key": "{{credential.apiKey}}"
    }
  },
  "actions": {
    "create_prospect": {
      "label": "Create Prospect",
      "description": "Create a new prospect in Klenty.",
      "inputs": {
        "email": {
          "label": "Email",
          "required": true
        },
        "firstName": {
          "label": "First Name",
          "required": true
        },
        "company": {
          "label": "Company"
        },
        "fullName": {
          "label": "Full Name"
        },
        "lastName": {
          "label": "Last Name"
        },
        "middleName": {
          "label": "Middle Name"
        },
        "account": {
          "label": "Account"
        },
        "department": {
          "label": "Department"
        },
        "companyDomain": {
          "label": "Company Domain"
        },
        "title": {
          "label": "Title"
        },
        "location": {
          "label": "Location"
        },
        "phone": {
          "label": "Phone"
        },
        "twitterId": {
          "label": "Twitter ID"
        },
        "companyPhone": {
          "label": "Company Phone"
        },
        "companyEmail": {
          "label": "Company Email"
        },
        "linkedinURL": {
          "label": "LinkedIn URL"
        },
        "city": {
          "label": "City"
        },
        "country": {
          "label": "Country"
        },
        "listName": {
          "label": "List",
          "description": "Select a Klenty list."
        },
        "tags": {
          "label": "Tags",
          "description": "Pipe-separated tag names, for example: Tag1|Tag2"
        },
        "outcome": {
          "label": "Outcome",
          "description": "Klenty outcome value. Case-sensitive."
        },
        "owner": {
          "label": "Owner",
          "description": "Email address of the Klenty user to assign as prospect owner."
        },
        "customFields": {
          "label": "Custom Fields",
          "description": "Key/value pairs to send in Klenty CustomFields.",
          "type": "json"
        }
      },
      "request": {
        "method": "POST",
        "url": "https://app.klenty.com/apis/v1/user/{{credential.username}}/prospects",
        "body": {
          "Email": "{{email}}",
          "FirstName": "{{firstName}}",
          "Company": "{{company}}",
          "FullName": "{{fullName}}",
          "LastName": "{{lastName}}",
          "MiddleName": "{{middleName}}",
          "Account": "{{account}}",
          "Department": "{{department}}",
          "CompanyDomain": "{{companyDomain}}",
          "Title": "{{title}}",
          "Location": "{{location}}",
          "Phone": "{{phone}}",
          "TwitterId": "{{twitterId}}",
          "CompanyPhone": "{{companyPhone}}",
          "CompanyEmail": "{{companyEmail}}",
          "LinkedinURL": "{{linkedinURL}}",
          "City": "{{city}}",
          "Country": "{{country}}",
          "List": "{{listName}}",
          "Tags": "{{tags}}",
          "Outcome": "{{outcome}}",
          "Owner": "{{owner}}"
        }
      }
    },
    "update_prospect": {
      "label": "Update Prospect",
      "description": "Update an existing prospect in Klenty by email address.",
      "inputs": {
        "currentEmail": {
          "label": "Current Prospect Email",
          "description": "The current email used to identify the prospect in Klenty.",
          "required": true
        },
        "email": {
          "label": "New Email"
        },
        "firstName": {
          "label": "First Name"
        },
        "company": {
          "label": "Company"
        },
        "fullName": {
          "label": "Full Name"
        },
        "lastName": {
          "label": "Last Name"
        },
        "middleName": {
          "label": "Middle Name"
        },
        "account": {
          "label": "Account"
        },
        "department": {
          "label": "Department"
        },
        "companyDomain": {
          "label": "Company Domain"
        },
        "title": {
          "label": "Title"
        },
        "location": {
          "label": "Location"
        },
        "phone": {
          "label": "Phone"
        },
        "twitterId": {
          "label": "Twitter ID"
        },
        "companyPhone": {
          "label": "Company Phone"
        },
        "companyEmail": {
          "label": "Company Email"
        },
        "linkedinURL": {
          "label": "LinkedIn URL"
        },
        "city": {
          "label": "City"
        },
        "country": {
          "label": "Country"
        },
        "listName": {
          "label": "List",
          "description": "Select a Klenty list."
        },
        "tags": {
          "label": "Tags",
          "description": "Pipe-separated tag names, for example: Tag1|Tag2"
        },
        "outcome": {
          "label": "Outcome",
          "description": "Klenty outcome value. Case-sensitive."
        },
        "owner": {
          "label": "Owner",
          "description": "Email address of the Klenty user to assign as prospect owner."
        },
        "customFields": {
          "label": "Custom Fields",
          "description": "Key/value pairs to send in Klenty CustomFields.",
          "type": "json"
        }
      },
      "request": {
        "method": "POST",
        "url": "https://app.klenty.com/apis/v1/user/{{credential.username}}/prospects/{{currentEmail}}",
        "body": {
          "Email": "{{email}}",
          "FirstName": "{{firstName}}",
          "Company": "{{company}}",
          "FullName": "{{fullName}}",
          "LastName": "{{lastName}}",
          "MiddleName": "{{middleName}}",
          "Account": "{{account}}",
          "Department": "{{department}}",
          "CompanyDomain": "{{companyDomain}}",
          "Title": "{{title}}",
          "Location": "{{location}}",
          "Phone": "{{phone}}",
          "TwitterId": "{{twitterId}}",
          "CompanyPhone": "{{companyPhone}}",
          "CompanyEmail": "{{companyEmail}}",
          "LinkedinURL": "{{linkedinURL}}",
          "City": "{{city}}",
          "Country": "{{country}}",
          "List": "{{listName}}",
          "Tags": "{{tags}}",
          "Outcome": "{{outcome}}",
          "Owner": "{{owner}}"
        }
      }
    },
    "get_prospect": {
      "label": "Get Prospect by Email",
      "description": "Find a prospect by email address in Klenty.",
      "inputs": {
        "email": {
          "label": "Email",
          "description": "Email address of the prospect to find.",
          "required": true
        }
      },
      "request": {
        "method": "GET",
        "url": "https://app.klenty.com/apis/v1/user/{{credential.username}}/prospects",
        "query": {
          "Email": "{{email}}"
        }
      }
    },
    "add_prospect_to_campaign": {
      "label": "Add Prospect to Campaign",
      "description": "Add a prospect to a Klenty campaign/cadence using the startcadence endpoint.",
      "inputs": {
        "email": {
          "label": "Prospect Email",
          "required": true
        },
        "cadenceName": {
          "label": "Cadence",
          "description": "Select a Klenty cadence.",
          "required": true
        }
      },
      "request": {
        "method": "POST",
        "url": "https://app.klenty.com/apis/v1/user/{{credential.username}}/startcadence",
        "body": {
          "Email": "{{email}}",
          "cadenceName": "{{cadenceName}}"
        }
      }
    }
  },
  "triggers": {}
}
