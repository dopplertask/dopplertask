{
  "name": "softr",
  "label": "Softr",
  "description": "",
  "icon": "",
  "hosts": [
    "studio-api.softr.io",
    "tables-api.softr.io"
  ],
  "upstream": {
    "package": "@activepieces/piece-softr",
    "version": "0.3.2"
  },
  "credential": {
    "fields": {
      "token": {
        "label": "API Key",
        "description": "Create a personal access token in Softr under **Workspace settings → API tokens** (see [Softr API setup](https://docs.softr.io/softr-api/softr-database-api/authorisation)). The token needs access to the workspace whose databases and apps you want to use.",
        "secret": true,
        "required": true
      }
    },
    "headers": {
      "softr-api-key": "{{credential.token}}"
    }
  },
  "actions": {
    "createDatabaseRecord": {
      "label": "Create Database Record",
      "description": "Creates a new record.",
      "inputs": {
        "databaseId": {
          "label": "Database ID",
          "description": "Select the database.",
          "required": true
        },
        "tableId": {
          "label": "Table ID",
          "description": "Select the table.",
          "required": true
        }
      },
      "request": {
        "method": "GET",
        "url": "https://tables-api.softr.io/api/v1/databases/{{databaseId}}/tables/{{tableId}}"
      }
    },
    "findDatabaseRecord": {
      "label": "Find Database Record",
      "description": "Finds the first record where a field equals a value.",
      "inputs": {
        "databaseId": {
          "label": "Database ID",
          "description": "Select the database.",
          "required": true
        },
        "tableId": {
          "label": "Table ID",
          "description": "Select the table.",
          "required": true
        },
        "fieldId": {
          "label": "Field",
          "required": true
        },
        "fieldValue": {
          "label": "Field Value",
          "description": "The value to match exactly. Use \"true\" or \"false\" for checkbox fields.",
          "required": true
        }
      },
      "request": {
        "method": "GET",
        "url": "https://tables-api.softr.io/api/v1/databases/{{databaseId}}/tables/{{tableId}}"
      }
    },
    "getTable": {
      "label": "Get Table",
      "description": "Retrieves a table and its field definitions.",
      "inputs": {
        "databaseId": {
          "label": "Database ID",
          "description": "Select the database.",
          "required": true
        },
        "tableId": {
          "label": "Table ID",
          "description": "Select the table.",
          "required": true
        }
      },
      "request": {
        "method": "GET",
        "url": "https://tables-api.softr.io/api/v1/databases/{{databaseId}}/tables/{{tableId}}"
      }
    },
    "generateMagicLink": {
      "label": "Generate Magic Link",
      "description": "Generates a magic login link for a user of a Softr app.",
      "inputs": {
        "email": {
          "label": "User Email",
          "description": "The email address of the app user.",
          "required": true
        },
        "domain": {
          "label": "Softr Domain",
          "description": "The domain or subdomain of the published Softr app, e.g. myapp.softr.app or portal.example.com.",
          "required": true
        }
      },
      "request": {
        "method": "POST",
        "url": "https://studio-api.softr.io/v1/api/users/magic-link/generate/{{email}}",
        "headers": {
          "softr-domain": "{{domain}}"
        }
      }
    },
    "getDatabase": {
      "label": "Get Database",
      "description": "Retrieves a Softr database by its ID.",
      "inputs": {
        "databaseId": {
          "label": "Database ID",
          "description": "Select the database.",
          "required": true
        }
      },
      "request": {
        "method": "GET",
        "url": "https://tables-api.softr.io/api/v1/databases/{{databaseId}}"
      }
    },
    "createDatabase": {
      "label": "Create Database",
      "description": "Creates a new database in a Softr workspace.",
      "inputs": {
        "workspaceId": {
          "label": "Workspace ID",
          "description": "Copy it from the Softr Studio URL, after /workspaces/.",
          "required": true
        },
        "name": {
          "label": "Name",
          "required": true
        },
        "description": {
          "label": "Description",
          "type": "multiline"
        }
      },
      "request": {
        "method": "POST",
        "url": "https://tables-api.softr.io/api/v1/databases",
        "body": {
          "workspaceId": "{{workspaceId}}",
          "name": "{{name}}",
          "description": "{{description}}"
        }
      }
    },
    "updateDatabase": {
      "label": "Update Database",
      "description": "Renames a Softr database or changes its description.",
      "inputs": {
        "databaseId": {
          "label": "Database ID",
          "description": "Select the database.",
          "required": true
        },
        "name": {
          "label": "New Name",
          "description": "Leave empty to keep the current name."
        },
        "description": {
          "label": "New Description",
          "description": "Leave empty to keep the current description.",
          "type": "multiline"
        }
      },
      "request": {
        "method": "PUT",
        "url": "https://tables-api.softr.io/api/v1/databases/{{databaseId}}",
        "body": {
          "name": "{{name}}",
          "description": "{{description}}"
        }
      }
    },
    "createTable": {
      "label": "Create Table",
      "description": "Creates a new table in a Softr database.",
      "inputs": {
        "databaseId": {
          "label": "Database ID",
          "description": "Select the database.",
          "required": true
        },
        "name": {
          "label": "Table Name",
          "required": true
        },
        "description": {
          "label": "Description",
          "type": "multiline"
        },
        "primaryFieldName": {
          "label": "Primary Field Name",
          "description": "Additional field to use as the primary field. Defaults to the first."
        },
        "fields": {
          "label": "Additional Fields",
          "type": "json"
        }
      },
      "request": {
        "method": "POST",
        "url": "https://tables-api.softr.io/api/v1/databases/{{databaseId}}/tables",
        "body": {
          "name": "{{name}}",
          "description": "{{description}}",
          "primaryFieldName": "{{primaryFieldName}}"
        }
      }
    },
    "updateTable": {
      "label": "Update Table",
      "description": "Renames a Softr table or changes its description.",
      "inputs": {
        "databaseId": {
          "label": "Database ID",
          "description": "Select the database.",
          "required": true
        },
        "tableId": {
          "label": "Table ID",
          "description": "Select the table.",
          "required": true
        },
        "name": {
          "label": "New Name",
          "description": "Leave empty to keep the current name."
        },
        "description": {
          "label": "New Description",
          "description": "Leave empty to keep the current description.",
          "type": "multiline"
        },
        "clearDescription": {
          "label": "Clear Description",
          "type": "boolean",
          "defaultValue": "false"
        }
      },
      "request": {
        "method": "PUT",
        "url": "https://tables-api.softr.io/api/v1/databases/{{databaseId}}/tables/{{tableId}}",
        "body": {
          "name": "{{name}}",
          "description": "{{description}}"
        }
      }
    },
    "getTableField": {
      "label": "Get Table Field",
      "description": "Retrieves one field definition of a Softr table.",
      "inputs": {
        "databaseId": {
          "label": "Database ID",
          "description": "Select the database.",
          "required": true
        },
        "tableId": {
          "label": "Table ID",
          "description": "Select the table.",
          "required": true
        },
        "fieldId": {
          "label": "Field",
          "required": true
        }
      },
      "request": {
        "method": "GET",
        "url": "https://tables-api.softr.io/api/v1/databases/{{databaseId}}/tables/{{tableId}}/fields/{{fieldId}}"
      }
    },
    "updateTableField": {
      "label": "Update Table Field",
      "description": "Renames a field, changes its type, or changes its options.",
      "inputs": {
        "databaseId": {
          "label": "Database ID",
          "description": "Select the database.",
          "required": true
        },
        "tableId": {
          "label": "Table ID",
          "description": "Select the table.",
          "required": true
        },
        "fieldId": {
          "label": "Field",
          "required": true
        },
        "name": {
          "label": "New Name",
          "description": "Leave empty to keep the current name."
        },
        "type": {
          "label": "Field Type",
          "type": "select",
          "options": [
            {
              "value": "SINGLE_LINE_TEXT",
              "label": "SINGLE_LINE_TEXT"
            },
            {
              "value": "LONG_TEXT",
              "label": "LONG_TEXT"
            },
            {
              "value": "NUMBER",
              "label": "NUMBER"
            },
            {
              "value": "CURRENCY",
              "label": "CURRENCY"
            },
            {
              "value": "PERCENT",
              "label": "PERCENT"
            },
            {
              "value": "RATING",
              "label": "RATING"
            },
            {
              "value": "CHECKBOX",
              "label": "CHECKBOX"
            },
            {
              "value": "DATETIME",
              "label": "DATETIME"
            },
            {
              "value": "DURATION",
              "label": "DURATION"
            },
            {
              "value": "EMAIL",
              "label": "EMAIL"
            },
            {
              "value": "URL",
              "label": "URL"
            },
            {
              "value": "PHONE",
              "label": "PHONE"
            },
            {
              "value": "SELECT",
              "label": "SELECT"
            },
            {
              "value": "ATTACHMENT",
              "label": "ATTACHMENT"
            },
            {
              "value": "LINKED_RECORD",
              "label": "LINKED_RECORD"
            },
            {
              "value": "USER",
              "label": "USER"
            },
            {
              "value": "LOOKUP",
              "label": "LOOKUP"
            },
            {
              "value": "ROLLUP",
              "label": "ROLLUP"
            },
            {
              "value": "FORMULA",
              "label": "FORMULA"
            },
            {
              "value": "CREATED_AT",
              "label": "CREATED_AT"
            },
            {
              "value": "UPDATED_AT",
              "label": "UPDATED_AT"
            },
            {
              "value": "CREATED_BY",
              "label": "CREATED_BY"
            },
            {
              "value": "UPDATED_BY",
              "label": "UPDATED_BY"
            },
            {
              "value": "AUTONUMBER",
              "label": "AUTONUMBER"
            },
            {
              "value": "RECORD_ID",
              "label": "RECORD_ID"
            }
          ]
        },
        "options": {
          "label": "New Options",
          "description": "Leave empty to keep. When set, replaces all options and choices.",
          "type": "json"
        }
      },
      "request": {
        "method": "GET",
        "url": "https://tables-api.softr.io/api/v1/databases/{{databaseId}}/tables/{{tableId}}/fields/{{fieldId}}"
      }
    }
  },
  "triggers": {}
}
