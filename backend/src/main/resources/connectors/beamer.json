{
  "name": "beamer",
  "label": "Beamer",
  "description": "Engage users with targeted announcements",
  "icon": "",
  "hosts": [
    "api.getbeamer.com"
  ],
  "upstream": {
    "package": "@activepieces/piece-beamer",
    "version": "0.2.2"
  },
  "credential": {
    "fields": {
      "token": {
        "label": "API Key",
        "description": "API key acquired from your Beamer settings",
        "secret": true,
        "required": true
      }
    },
    "headers": {
      "beamer-api-key": "{{credential.token}}"
    }
  },
  "actions": {
    "create_new_comment": {
      "label": "Create a new comment",
      "description": "Create a new comment for a Feature request",
      "inputs": {
        "featureRequestId": {
          "label": "ID",
          "description": "ID of the feature request",
          "required": true,
          "type": "number"
        },
        "userId": {
          "label": "User ID",
          "description": "id of the user making the comment",
          "type": "number"
        },
        "text": {
          "label": "Text",
          "description": "Content of your comment",
          "required": true,
          "type": "multiline"
        },
        "userEmail": {
          "label": "User Email",
          "description": "Feature requested by.."
        }
      },
      "request": {
        "method": "POST",
        "url": "https://api.getbeamer.com/v0/requests/{{featureRequestId}}/comments",
        "body": {
          "text": "{{text}}",
          "userId": "{{userId}}",
          "userEmail": "{{userEmail}}",
          "visible": "true"
        }
      }
    },
    "create_vote": {
      "label": "Create a new vote ",
      "description": "Create a new vote on a feature request",
      "inputs": {
        "featureRequestId": {
          "label": "Feature ID",
          "description": "ID of the feature request to create a comment for",
          "required": true,
          "type": "number"
        },
        "userFirstname": {
          "label": "User Firstname",
          "description": "Feature requested by.."
        },
        "userEmail": {
          "label": "User Email",
          "description": "Feature requested by.."
        }
      },
      "request": {
        "method": "POST",
        "url": "https://api.getbeamer.com/v0/requests/{{featureRequestId}}/votes",
        "body": {
          "userFirstname": "{{userFirstname}}",
          "email": "{{userEmail}}"
        }
      }
    }
  },
  "triggers": {}
}
