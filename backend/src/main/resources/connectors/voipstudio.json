{
  "name": "voipstudio",
  "label": "VoIPstudio",
  "description": "VoIPstudio is a complete business phone system and scalable call center",
  "icon": "",
  "hosts": [
    "l7api.com"
  ],
  "upstream": {
    "package": "@activepieces/piece-voipstudio",
    "version": "0.2.3"
  },
  "credential": {
    "fields": {
      "token": {
        "label": "API Key",
        "description": "VoIPstudio API Key\n\n**Web Dashboard - Add API Key**\n\nFollow steps below to add API Key for a user:\n\n1. In Administration panel edit user for whom API Keys needs to be added.\n2. Go to API Keys section.\n3. Enter a name for your API Key, this can be anything you like. For example a name of your application that will use this API Key.\n4. Click \"Add\" button.\n5. Click \"Eye\" icon to retrieve the actual API Key",
        "secret": true,
        "required": true
      }
    },
    "headers": {
      "x-auth-token": "{{credential.token}}"
    }
  },
  "actions": {
    "createContact": {
      "label": "Create Contact",
      "description": "Creates a new Contact resource",
      "inputs": {
        "type": {
          "label": "Type",
          "description": "Contact type"
        },
        "dialler_source_id": {
          "label": "Dialler Source ID",
          "description": "Dialler source ID",
          "type": "number"
        },
        "outcome_id": {
          "label": "Outcome ID",
          "description": "Outcome ID",
          "type": "number"
        },
        "group_name": {
          "label": "Group Name",
          "description": "Group name"
        },
        "first_name": {
          "label": "First Name",
          "description": "Contact first name"
        },
        "last_name": {
          "label": "Last Name",
          "description": "Contact last name"
        },
        "email": {
          "label": "Email",
          "description": "Contact email address"
        },
        "company": {
          "label": "Company",
          "description": "Company name"
        },
        "tel": {
          "label": "Telephone",
          "description": "Primary telephone number"
        },
        "tel_1": {
          "label": "Telephone 1",
          "description": "Secondary telephone number"
        },
        "tel_2": {
          "label": "Telephone 2",
          "description": "Tertiary telephone number"
        },
        "speed_dial_phone": {
          "label": "Speed Dial Phone",
          "description": "Primary speed dial phone number"
        },
        "speed_dial_phone_1": {
          "label": "Speed Dial Phone 1",
          "description": "Secondary speed dial phone number"
        },
        "speed_dial_phone_2": {
          "label": "Speed Dial Phone 2",
          "description": "Tertiary speed dial phone number"
        },
        "mobile": {
          "label": "Mobile",
          "description": "Primary mobile number"
        },
        "mobile_1": {
          "label": "Mobile 1",
          "description": "Secondary mobile number"
        },
        "mobile_2": {
          "label": "Mobile 2",
          "description": "Tertiary mobile number"
        },
        "speed_dial_mobile": {
          "label": "Speed Dial Mobile",
          "description": "Primary speed dial mobile number"
        },
        "speed_dial_mobile_1": {
          "label": "Speed Dial Mobile 1",
          "description": "Secondary speed dial mobile number"
        },
        "speed_dial_mobile_2": {
          "label": "Speed Dial Mobile 2",
          "description": "Tertiary speed dial mobile number"
        },
        "notes": {
          "label": "Notes",
          "description": "Contact notes",
          "type": "multiline"
        },
        "labels": {
          "label": "Labels",
          "description": "Contact labels",
          "type": "json"
        },
        "groups": {
          "label": "Groups",
          "description": "Contact groups",
          "type": "json"
        },
        "transfer_list": {
          "label": "Transfer List",
          "description": "Whether to add to transfer list",
          "type": "boolean"
        },
        "user_id": {
          "label": "User ID",
          "description": "User ID",
          "type": "number"
        }
      },
      "request": {
        "method": "POST",
        "url": "https://l7api.com/v1.2/voipstudio/contacts",
        "body": {
          "type": "{{type}}",
          "dialler_source_id": "{{dialler_source_id}}",
          "outcome_id": "{{outcome_id}}",
          "group_name": "{{group_name}}",
          "first_name": "{{first_name}}",
          "last_name": "{{last_name}}",
          "email": "{{email}}",
          "company": "{{company}}",
          "tel": "{{tel}}",
          "tel_1": "{{tel_1}}",
          "tel_2": "{{tel_2}}",
          "speed_dial_phone": "{{speed_dial_phone}}",
          "speed_dial_phone_1": "{{speed_dial_phone_1}}",
          "speed_dial_phone_2": "{{speed_dial_phone_2}}",
          "mobile": "{{mobile}}",
          "mobile_1": "{{mobile_1}}",
          "mobile_2": "{{mobile_2}}",
          "speed_dial_mobile": "{{speed_dial_mobile}}",
          "speed_dial_mobile_1": "{{speed_dial_mobile_1}}",
          "speed_dial_mobile_2": "{{speed_dial_mobile_2}}",
          "notes": "{{notes}}",
          "user_id": "{{user_id}}"
        }
      }
    },
    "makeACallToLead": {
      "label": "Make a Call to Lead",
      "description": "Make a leadcall from user to e164 number",
      "inputs": {
        "caller_id": {
          "label": "Caller ID",
          "description": "Caller ID",
          "required": true
        },
        "to": {
          "label": "To",
          "description": "Destination number in e164 format or extension",
          "required": true
        },
        "tts": {
          "label": "Text to Speech",
          "description": "Text to speech content",
          "required": true
        }
      },
      "request": {
        "method": "POST",
        "url": "https://l7api.com/v1.2/voipstudio/leadcalls",
        "body": {
          "caller_id": "{{caller_id}}",
          "to": "{{to}}",
          "tts": "{{tts}}"
        }
      }
    },
    "makeACall": {
      "label": "Make a Call",
      "description": "Make a call to a number in e164 format",
      "inputs": {
        "to": {
          "label": "To",
          "description": "Destination number in e164 format",
          "required": true
        },
        "from": {
          "label": "From",
          "description": "User ID from which call should originate"
        },
        "caller_id": {
          "label": "Caller ID",
          "description": "Caller ID to use for the call. E164 number or 'anonymous'"
        }
      },
      "request": {
        "method": "POST",
        "url": "https://l7api.com/v1.2/voipstudio/calls",
        "body": {
          "to": "{{to}}",
          "from": "{{from}}",
          "caller_id": "{{caller_id}}"
        }
      }
    },
    "makeAWebcall": {
      "label": "Make a Webcall",
      "description": "Make a webcall from e164 number to other e164 number or extension",
      "inputs": {
        "from": {
          "label": "From",
          "description": "Source number in e164 format",
          "required": true
        },
        "to": {
          "label": "To",
          "description": "Destination number in e164 format or extension",
          "required": true
        }
      },
      "request": {
        "method": "POST",
        "url": "https://l7api.com/v1.2/voipstudio/webcalls",
        "body": {
          "from": "{{from}}",
          "to": "{{to}}"
        }
      }
    },
    "sendSms": {
      "label": "Send SMS",
      "description": "Send new SMS resource",
      "inputs": {
        "from": {
          "label": "From",
          "description": "From number in e164 format"
        },
        "to": {
          "label": "To",
          "description": "Destination number in e164 format",
          "required": true
        },
        "message": {
          "label": "Message",
          "description": "Message to send",
          "required": true
        }
      },
      "request": {
        "method": "POST",
        "url": "https://l7api.com/v1.2/voipstudio/sms",
        "body": {
          "to": "{{to}}",
          "message": "{{message}}",
          "from": "{{from}}"
        }
      }
    }
  },
  "triggers": {}
}
