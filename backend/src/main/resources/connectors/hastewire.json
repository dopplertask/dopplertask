{
  "name": "hastewire",
  "label": "Hastewire",
  "description": "",
  "icon": "",
  "hosts": [
    "hastewire.com"
  ],
  "upstream": {
    "package": "@activepieces/piece-hastewire",
    "version": "0.1.7"
  },
  "credential": {
    "fields": {
      "token": {
        "label": "API Key",
        "description": "You can obtain API key from [Settings](https://hastewire.com/humanizer/account/api-keys).",
        "secret": true,
        "required": true
      }
    },
    "headers": {
      "authorization": "Bearer {{credential.token}}"
    }
  },
  "actions": {
    "detect-text": {
      "label": "Detect Text",
      "description": "Analyzes text and returns the likelihood of it being AI-generated or human-written.",
      "inputs": {
        "text": {
          "label": "Input Text",
          "required": true,
          "type": "multiline"
        }
      },
      "request": {
        "method": "POST",
        "url": "https://hastewire.com/api/v1/detect",
        "body": {
          "text": "{{text}}"
        }
      }
    },
    "humanize-text": {
      "label": "Humanize Text",
      "description": "Rephrases a given AI-generated text to be more human like.",
      "inputs": {
        "text": {
          "label": "Input Text",
          "required": true,
          "type": "multiline"
        },
        "style": {
          "label": "Text Style",
          "description": "The desired writing style for the output.",
          "type": "select",
          "options": [
            {
              "value": "formal",
              "label": "formal"
            },
            {
              "value": "standard",
              "label": "standard"
            },
            {
              "value": "academic",
              "label": "academic"
            }
          ]
        }
      },
      "request": {
        "method": "POST",
        "url": "https://hastewire.com/api/v1/humanize",
        "body": {
          "text": "{{text}}"
        }
      }
    }
  },
  "triggers": {}
}
