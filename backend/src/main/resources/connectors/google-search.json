{
  "name": "google-search",
  "label": "Google Search",
  "description": "Search using Vertex AI Search (Discovery Engine)",
  "icon": "",
  "hosts": [
    "discoveryengine.googleapis.com"
  ],
  "upstream": {
    "package": "@activepieces/piece-google-search",
    "version": "0.0.9"
  },
  "credential": {
    "fields": {
      "apiKey": {
        "label": "API Key",
        "description": "Your Google Cloud API key with Vertex AI Search access.",
        "secret": true,
        "required": true
      },
      "projectId": {
        "label": "Project ID",
        "description": "Your Google Cloud project ID.",
        "required": true
      },
      "appId": {
        "label": "App ID",
        "description": "The Vertex AI Search app (engine) ID.",
        "required": true
      }
    },
    "query": {
      "key": "{{credential.apiKey}}"
    }
  },
  "actions": {
    "search": {
      "label": "Search",
      "description": "Search for content using Vertex AI Search (searchLite).",
      "inputs": {
        "query": {
          "label": "Search Query",
          "description": "The query text to search.",
          "required": true
        },
        "userPseudoId": {
          "label": "User Pseudo ID",
          "description": "A pseudonymized identifier for the user (max 128 chars). Improves personalization."
        }
      },
      "request": {
        "method": "POST",
        "url": "https://discoveryengine.googleapis.com/v1/projects/{{credential.projectId}}/locations/global/collections/default_collection/engines/{{credential.appId}}/servingConfigs/default_search:searchLite",
        "body": {
          "query": "{{query}}",
          "userPseudoId": "{{userPseudoId}}"
        }
      }
    }
  },
  "triggers": {}
}
