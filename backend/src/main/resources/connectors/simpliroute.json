{
  "name": "simpliroute",
  "label": "SimpliRoute",
  "description": "Connect with SimpliRoute, the last-mile delivery optimization platform. Manage clients, vehicles, visits, routes, and optimize your delivery operations.",
  "icon": "",
  "hosts": [
    "api.simpliroute.com"
  ],
  "baseUrl": "https://api.simpliroute.com",
  "upstream": {
    "package": "@activepieces/piece-simpliroute",
    "version": "0.2.2"
  },
  "credential": {
    "fields": {
      "apiKey": {
        "label": "API Key",
        "description": "Your SimpliRoute API token. You can find it in your SimpliRoute account settings, in the API section.",
        "secret": true,
        "required": true
      }
    },
    "headers": {
      "Authorization": "Token {{credential.apiKey}}"
    }
  },
  "lists": {
    "vehicles": {
      "request": {
        "method": "GET",
        "url": "https://api.simpliroute.com/v1/routes/vehicles/"
      }
    },
    "users": {
      "request": {
        "method": "GET",
        "url": "https://api.simpliroute.com/v1/accounts/drivers/"
      }
    }
  },
  "actions": {
    "get_me": {
      "label": "Get Account Details",
      "description": "Return the account details of the user who owns the API token.",
      "group": "Account",
      "request": {
        "method": "GET",
        "url": "https://api.simpliroute.com/v1/accounts/me/"
      },
      "afterResponse": "return {status: received.status, data: response ?? undefined};"
    },
    "get_clients": {
      "label": "Get Clients",
      "description": "Retrieve the clients of the account that have the given client key.",
      "group": "Clients",
      "inputs": {
        "key": {
          "label": "Client Key",
          "description": "Unique client key to filter results.",
          "required": true
        }
      },
      "request": {
        "method": "GET",
        "url": "https://api.simpliroute.com/v1/accounts/clients/",
        "query": {
          "key": "{{key}}"
        }
      },
      "afterResponse": "return {status: received.status, data: response ?? undefined};"
    },
    "create_clients": {
      "label": "Create Clients",
      "description": "Create one or multiple new clients in the account.",
      "group": "Clients",
      "inputs": {
        "clients": {
          "label": "Clients",
          "description": "Array of client objects to create.",
          "type": "json",
          "required": true
        }
      },
      "request": {
        "method": "POST",
        "url": "https://api.simpliroute.com/v1/accounts/clients/",
        "body": "{{clients}}"
      },
      "afterResponse": "return {status: received.status, data: response ?? undefined};"
    },
    "bulk_delete_clients": {
      "label": "Bulk Delete Clients",
      "description": "Delete multiple clients in a single call.",
      "group": "Clients",
      "inputs": {
        "ids": {
          "label": "IDs",
          "description": "List of client IDs to delete, such as [{\"id\": 101}].",
          "type": "json",
          "required": true
        }
      },
      "request": {
        "method": "DELETE",
        "url": "https://api.simpliroute.com/v1/accounts/clients/"
      },
      "beforeRequest": "request.body = JSON.parse(inputs.ids).map(client => client.id); return request;",
      "afterResponse": "return {status: received.status, data: response ?? undefined};"
    },
    "create_client_property": {
      "label": "Create Client Custom Property",
      "description": "Create a new custom attribute for clients.",
      "group": "Clients",
      "inputs": {
        "label": {
          "label": "Label",
          "description": "Label of the new custom property.",
          "required": true
        },
        "type": {
          "label": "Type",
          "description": "Property type (str, int, float or bool).",
          "required": true
        }
      },
      "request": {
        "method": "POST",
        "url": "https://api.simpliroute.com/v1/planner/client-properties/",
        "body": {
          "label": "{{label}}",
          "type": "{{type}}"
        }
      },
      "afterResponse": "return {status: received.status, data: response ?? undefined};"
    },
    "get_vehicles": {
      "label": "Get Vehicles",
      "description": "Retrieve the list of vehicles registered in the account.",
      "group": "Vehicles",
      "request": {
        "method": "GET",
        "url": "https://api.simpliroute.com/v1/routes/vehicles/"
      },
      "afterResponse": "return {status: received.status, data: response ?? undefined};"
    },
    "create_vehicle": {
      "label": "Create Vehicle",
      "description": "Register a new vehicle in the account.",
      "group": "Vehicles",
      "inputs": {
        "name": {
          "label": "Name",
          "description": "The name of the vehicle.",
          "required": true
        },
        "capacity": {
          "label": "Capacity",
          "description": "The maximum capacity of the vehicle.",
          "type": "number",
          "required": true
        },
        "default_driver": {
          "label": "Default Driver",
          "description": "The assigned driver ID or null if not assigned.",
          "list": "users"
        },
        "location_start_address": {
          "label": "Start Address",
          "description": "The starting address of the vehicle.",
          "required": true
        },
        "location_start_latitude": {
          "label": "Start Latitude",
          "description": "The latitude of the starting location.",
          "type": "number",
          "required": true
        },
        "location_start_longitude": {
          "label": "Start Longitude",
          "description": "The longitude of the starting location.",
          "type": "number",
          "required": true
        },
        "location_end_address": {
          "label": "End Address",
          "description": "The ending address of the vehicle.",
          "required": true
        },
        "location_end_latitude": {
          "label": "End Latitude",
          "description": "The latitude of the ending location.",
          "type": "number",
          "required": true
        },
        "location_end_longitude": {
          "label": "End Longitude",
          "description": "The longitude of the ending location.",
          "type": "number",
          "required": true
        },
        "skills": {
          "label": "Skills",
          "description": "A list of skill IDs, such as [1, 2].",
          "type": "json"
        },
        "capacity2": {
          "label": "Capacity 2",
          "description": "Secondary vehicle capacity."
        },
        "capacity3": {
          "label": "Capacity 3",
          "description": "Third vehicle capacity."
        },
        "cost": {
          "label": "Cost",
          "description": "Operational cost of the vehicle."
        },
        "shift_start": {
          "label": "Shift Start",
          "description": "Start time of the vehicle shift."
        },
        "shift_end": {
          "label": "Shift End",
          "description": "End time of the vehicle shift."
        },
        "reference_id": {
          "label": "Reference ID",
          "description": "External reference ID of the vehicle."
        },
        "license_plate": {
          "label": "License Plate",
          "description": "License plate or registration of the vehicle."
        },
        "min_load": {
          "label": "Minimum Load",
          "description": "Minimum load (unit 1) required to dispatch.",
          "type": "number"
        },
        "min_load_2": {
          "label": "Minimum Load 2",
          "description": "Minimum load (unit 2) required.",
          "type": "number"
        },
        "min_load_3": {
          "label": "Minimum Load 3",
          "description": "Minimum load (unit 3) required.",
          "type": "number"
        },
        "max_visit": {
          "label": "Maximum Visits",
          "description": "Maximum number of visits that the vehicle can perform.",
          "type": "number"
        },
        "max_time": {
          "label": "Maximum Time",
          "description": "Maximum duration of route (in seconds).",
          "type": "number"
        },
        "rest_time_start": {
          "label": "Rest Start",
          "description": "Start time of rest."
        },
        "rest_time_end": {
          "label": "Rest End",
          "description": "End time of rest."
        },
        "rest_time_duration": {
          "label": "Rest Duration",
          "description": "Duration of rest."
        }
      },
      "request": {
        "method": "POST",
        "url": "https://api.simpliroute.com/v1/routes/vehicles/",
        "body": {
          "name": "{{name}}",
          "capacity": "{{capacity}}",
          "default_driver": "{{default_driver}}",
          "location_start_address": "{{location_start_address}}",
          "location_start_latitude": "{{location_start_latitude}}",
          "location_start_longitude": "{{location_start_longitude}}",
          "location_end_address": "{{location_end_address}}",
          "location_end_latitude": "{{location_end_latitude}}",
          "location_end_longitude": "{{location_end_longitude}}",
          "skills": "{{skills}}",
          "capacity2": "{{capacity2}}",
          "capacity3": "{{capacity3}}",
          "cost": "{{cost}}",
          "shift_start": "{{shift_start}}",
          "shift_end": "{{shift_end}}",
          "reference_id": "{{reference_id}}",
          "license_plate": "{{license_plate}}",
          "min_load": "{{min_load}}",
          "min_load_2": "{{min_load_2}}",
          "min_load_3": "{{min_load_3}}",
          "max_visit": "{{max_visit}}",
          "max_time": "{{max_time}}",
          "rest_time_start": "{{rest_time_start}}",
          "rest_time_end": "{{rest_time_end}}",
          "rest_time_duration": "{{rest_time_duration}}"
        }
      },
      "afterResponse": "return {status: received.status, data: response ?? undefined};"
    },
    "get_vehicle": {
      "label": "Get Vehicle",
      "description": "Retrieve information of a specific vehicle.",
      "group": "Vehicles",
      "inputs": {
        "vehicle_id": {
          "label": "Vehicle ID",
          "description": "Vehicle ID.",
          "type": "number",
          "required": true,
          "list": "vehicles"
        }
      },
      "request": {
        "method": "GET",
        "url": "https://api.simpliroute.com/v1/routes/vehicles/{{vehicle_id}}/"
      },
      "afterResponse": "return {status: received.status, data: response ?? undefined};"
    },
    "delete_vehicle": {
      "label": "Delete Vehicle",
      "description": "Delete a vehicle by its ID.",
      "group": "Vehicles",
      "inputs": {
        "vehicle_id": {
          "label": "Vehicle ID",
          "description": "Vehicle ID to delete.",
          "type": "number",
          "required": true,
          "list": "vehicles"
        }
      },
      "request": {
        "method": "DELETE",
        "url": "https://api.simpliroute.com/v1/routes/vehicles/{{vehicle_id}}/"
      },
      "afterResponse": "return {status: received.status, data: response ?? undefined};"
    },
    "get_visits": {
      "label": "Get Visits",
      "description": "Retrieve the visits planned for a date.",
      "group": "Visits",
      "inputs": {
        "planned_date": {
          "label": "Planned Date",
          "description": "Filter visits by planned date (YYYY-MM-DD format).",
          "required": true
        }
      },
      "request": {
        "method": "GET",
        "url": "https://api.simpliroute.com/v1/routes/visits/",
        "query": {
          "planned_date": "{{planned_date}}"
        }
      },
      "afterResponse": "return {status: received.status, data: response ?? undefined};"
    },
    "create_visits": {
      "label": "Create Visits",
      "description": "Create visits. Multiple visits can be created in a single request.",
      "group": "Visits",
      "inputs": {
        "visits": {
          "label": "Visits",
          "description": "Array of visit objects to create.",
          "type": "json",
          "required": true
        }
      },
      "request": {
        "method": "POST",
        "url": "https://api.simpliroute.com/v1/routes/visits/",
        "body": "{{visits}}"
      },
      "afterResponse": "return {status: received.status, data: response ?? undefined};"
    },
    "get_visit": {
      "label": "Get Visit",
      "description": "Retrieve details of a specific visit by ID.",
      "group": "Visits",
      "inputs": {
        "visit_id": {
          "label": "Visit ID",
          "description": "Visit ID.",
          "type": "number",
          "required": true
        }
      },
      "request": {
        "method": "GET",
        "url": "https://api.simpliroute.com/v1/routes/visits/{{visit_id}}/"
      },
      "afterResponse": "return {status: received.status, data: response ?? undefined};"
    },
    "update_visit_partial": {
      "label": "Update Visit (Partial)",
      "description": "Partially update fields of an existing visit.",
      "group": "Visits",
      "inputs": {
        "visit_id": {
          "label": "Visit ID",
          "description": "ID of the visit to update.",
          "type": "number",
          "required": true
        },
        "title": {
          "label": "Title",
          "description": "Visit title (if you want to change it)."
        },
        "address": {
          "label": "Address",
          "description": "Visit address (if you want to change it)."
        },
        "load": {
          "label": "Load",
          "description": "Visit load (main unit).",
          "type": "number"
        },
        "load_2": {
          "label": "Load 2",
          "description": "Visit load (unit 2).",
          "type": "number"
        },
        "load_3": {
          "label": "Load 3",
          "description": "Visit load (unit 3).",
          "type": "number"
        },
        "duration": {
          "label": "Duration",
          "description": "Visit duration (HH:MM:SS)."
        },
        "contact_name": {
          "label": "Contact Name",
          "description": "Visit contact name."
        },
        "contact_phone": {
          "label": "Contact Phone",
          "description": "Visit contact phone."
        },
        "notes": {
          "label": "Notes",
          "description": "Visit notes."
        },
        "planned_date": {
          "label": "Planned Date",
          "description": "Visit planned date (YYYY-MM-DD)."
        }
      },
      "request": {
        "method": "PATCH",
        "url": "https://api.simpliroute.com/v1/routes/visits/{{visit_id}}/",
        "body": {
          "title": "{{title}}",
          "address": "{{address}}",
          "load": "{{load}}",
          "load_2": "{{load_2}}",
          "load_3": "{{load_3}}",
          "duration": "{{duration}}",
          "contact_name": "{{contact_name}}",
          "contact_phone": "{{contact_phone}}",
          "notes": "{{notes}}",
          "planned_date": "{{planned_date}}"
        }
      },
      "afterResponse": "return {status: received.status, data: response ?? undefined};"
    },
    "update_visit": {
      "label": "Update Visit (Complete)",
      "description": "Completely update an existing visit with all fields.",
      "group": "Visits",
      "inputs": {
        "visit_id": {
          "label": "Visit ID",
          "description": "ID of the visit to update.",
          "type": "number",
          "required": true
        },
        "title": {
          "label": "Title",
          "description": "Visit title.",
          "required": true
        },
        "address": {
          "label": "Address",
          "description": "Visit address.",
          "required": true
        },
        "latitude": {
          "label": "Latitude",
          "description": "Visit latitude.",
          "type": "number"
        },
        "longitude": {
          "label": "Longitude",
          "description": "Visit longitude.",
          "type": "number"
        },
        "load": {
          "label": "Load",
          "description": "Visit load (main unit).",
          "type": "number"
        },
        "load_2": {
          "label": "Load 2",
          "description": "Visit load (unit 2).",
          "type": "number"
        },
        "load_3": {
          "label": "Load 3",
          "description": "Visit load (unit 3).",
          "type": "number"
        },
        "duration": {
          "label": "Duration",
          "description": "Visit duration (HH:MM:SS)."
        },
        "contact_name": {
          "label": "Contact Name",
          "description": "Visit contact name."
        },
        "contact_phone": {
          "label": "Contact Phone",
          "description": "Visit contact phone."
        },
        "notes": {
          "label": "Notes",
          "description": "Visit notes."
        },
        "planned_date": {
          "label": "Planned Date",
          "description": "Visit planned date (YYYY-MM-DD).",
          "required": true
        }
      },
      "request": {
        "method": "PUT",
        "url": "https://api.simpliroute.com/v1/routes/visits/{{visit_id}}/",
        "body": {
          "title": "{{title}}",
          "address": "{{address}}",
          "latitude": "{{latitude}}",
          "longitude": "{{longitude}}",
          "load": "{{load}}",
          "load_2": "{{load_2}}",
          "load_3": "{{load_3}}",
          "duration": "{{duration}}",
          "contact_name": "{{contact_name}}",
          "contact_phone": "{{contact_phone}}",
          "notes": "{{notes}}",
          "planned_date": "{{planned_date}}"
        }
      },
      "afterResponse": "return {status: received.status, data: response ?? undefined};"
    },
    "delete_visit": {
      "label": "Delete Visit",
      "description": "Delete a visit by its ID.",
      "group": "Visits",
      "inputs": {
        "visit_id": {
          "label": "Visit ID",
          "description": "ID of the visit to delete.",
          "type": "number",
          "required": true
        }
      },
      "request": {
        "method": "DELETE",
        "url": "https://api.simpliroute.com/v1/routes/visits/{{visit_id}}/"
      },
      "afterResponse": "return {status: received.status, data: response ?? undefined};"
    },
    "add_visit_items": {
      "label": "Add Visit Items",
      "description": "Add items to an existing visit.",
      "group": "Visits",
      "inputs": {
        "visit_id": {
          "label": "Visit ID",
          "description": "ID of the visit to add items to.",
          "type": "number",
          "required": true
        },
        "items": {
          "label": "Items",
          "description": "Array of items to add to the visit.",
          "type": "json",
          "required": true
        }
      },
      "request": {
        "method": "POST",
        "url": "https://api.simpliroute.com/v1/routes/visits/{{visit_id}}/items/",
        "body": "{{items}}"
      },
      "afterResponse": "return {status: received.status, data: response ?? undefined};"
    },
    "get_routes": {
      "label": "Get Routes",
      "description": "Retrieve the routes planned for a date.",
      "group": "Routes",
      "inputs": {
        "planned_date": {
          "label": "Planned Date",
          "description": "Filter routes by planned date (YYYY-MM-DD).",
          "required": true
        }
      },
      "request": {
        "method": "GET",
        "url": "https://api.simpliroute.com/v1/routes/routes/",
        "query": {
          "planned_date": "{{planned_date}}"
        }
      },
      "afterResponse": "return {status: received.status, data: response ?? undefined};"
    },
    "create_route": {
      "label": "Create Route",
      "description": "Create a new route manually by assigning vehicle, driver and date.",
      "group": "Routes",
      "inputs": {
        "vehicle": {
          "label": "Vehicle",
          "description": "Vehicle ID for the route.",
          "type": "number",
          "required": true,
          "list": "vehicles"
        },
        "driver": {
          "label": "Driver",
          "description": "Driver ID for the route.",
          "type": "number",
          "required": true,
          "list": "users"
        },
        "planned_date": {
          "label": "Planned Date",
          "description": "Planned route date (YYYY-MM-DD).",
          "required": true
        },
        "estimated_time_start": {
          "label": "Estimated Start Time",
          "description": "Estimated start time (HH:MM:SS).",
          "required": true
        },
        "estimated_time_end": {
          "label": "Estimated End Time",
          "description": "Estimated end time (HH:MM:SS).",
          "required": true
        },
        "location_start_address": {
          "label": "Start Address",
          "description": "Route start address.",
          "required": true
        },
        "location_start_latitude": {
          "label": "Start Latitude",
          "description": "Route start latitude.",
          "required": true
        },
        "location_start_longitude": {
          "label": "Start Longitude",
          "description": "Route start longitude.",
          "required": true
        },
        "location_end_address": {
          "label": "End Address",
          "description": "Route end address.",
          "required": true
        },
        "location_end_latitude": {
          "label": "End Latitude",
          "description": "Route end latitude.",
          "required": true
        },
        "location_end_longitude": {
          "label": "End Longitude",
          "description": "Route end longitude.",
          "required": true
        },
        "plan": {
          "label": "Plan",
          "description": "Plan (execution) ID to associate the route (UUID).",
          "required": true
        }
      },
      "request": {
        "method": "POST",
        "url": "https://api.simpliroute.com/v1/routes/routes/",
        "body": {
          "vehicle": "{{vehicle}}",
          "driver": "{{driver}}",
          "planned_date": "{{planned_date}}",
          "estimated_time_start": "{{estimated_time_start}}",
          "estimated_time_end": "{{estimated_time_end}}",
          "location_start_address": "{{location_start_address}}",
          "location_start_latitude": "{{location_start_latitude}}",
          "location_start_longitude": "{{location_start_longitude}}",
          "location_end_address": "{{location_end_address}}",
          "location_end_latitude": "{{location_end_latitude}}",
          "location_end_longitude": "{{location_end_longitude}}",
          "plan": "{{plan}}"
        }
      },
      "afterResponse": "return {status: received.status, data: response ?? undefined};"
    },
    "get_route": {
      "label": "Get Route",
      "description": "Retrieve details of a specific route.",
      "group": "Routes",
      "inputs": {
        "route_id": {
          "label": "Route ID",
          "description": "Route ID (UUID).",
          "required": true
        }
      },
      "request": {
        "method": "GET",
        "url": "https://api.simpliroute.com/v1/routes/routes/{{route_id}}/"
      },
      "afterResponse": "return {status: received.status, data: response ?? undefined};"
    },
    "delete_route": {
      "label": "Delete Route",
      "description": "Delete a route by its ID.",
      "group": "Routes",
      "inputs": {
        "route_id": {
          "label": "Route ID",
          "description": "Route ID to delete (UUID).",
          "required": true
        }
      },
      "request": {
        "method": "DELETE",
        "url": "https://api.simpliroute.com/v1/routes/routes/{{route_id}}/"
      },
      "afterResponse": "return {status: received.status, data: response ?? undefined};"
    },
    "get_plans": {
      "label": "Get Plans",
      "description": "Retrieve the list of saved routing plans (executions).",
      "group": "Plans",
      "inputs": {
        "date": {
          "label": "Date",
          "description": "Planned date (YYYY-MM-DD).",
          "required": true
        }
      },
      "request": {
        "method": "GET",
        "url": "https://api.simpliroute.com/v1/plans/{{date}}/"
      },
      "afterResponse": "return {status: received.status, data: response ?? undefined};"
    },
    "create_plan": {
      "label": "Create Empty Plan",
      "description": "Create an empty plan (execution) without routes (reserve a planning day).",
      "group": "Plans",
      "inputs": {
        "name": {
          "label": "Name",
          "description": "Plan name.",
          "required": true
        },
        "start_date": {
          "label": "Start Date",
          "description": "Start date (YYYY-MM-DD).",
          "required": true
        },
        "end_date": {
          "label": "End Date",
          "description": "End date (YYYY-MM-DD).",
          "required": true
        }
      },
      "request": {
        "method": "POST",
        "url": "https://api.simpliroute.com/v1/plans/create-plan/",
        "body": {
          "name": "{{name}}",
          "start_date": "{{start_date}}",
          "end_date": "{{end_date}}"
