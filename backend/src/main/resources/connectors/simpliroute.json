{
  "name": "simpliroute",
  "label": "SimpliRoute",
  "description": "Connect with SimpliRoute, the last-mile delivery optimization platform. Manage clients, vehicles, visits, routes, and optimize your delivery operations.",
  "icon": "",
  "hosts": [
    "api.simpliroute.com"
  ],
  "baseUrl": "https://api.simpliroute.com",
  "upstream": {
    "package": "@activepieces/piece-simpliroute",
    "version": "0.2.2"
  },
  "credential": {
    "fields": {
      "apiKey": {
        "label": "API Key",
        "description": "Your SimpliRoute API token. You can find this in your SimpliRoute account settings under API section.",
        "secret": true,
        "required": true
      }
    },
    "headers": {
      "Authorization": "Token {{credential.apiKey}}"
    }
  },
  "actions": {
    "get_me": {
      "label": "Get Account Details",
      "description": "Returns account information of the authenticated user via API token.",
      "audience": "both",
      "request": {
        "method": "GET",
        "url": "https://api.simpliroute.com/v1/accounts/me/"
      },
      "afterResponse": "return {status: 200, data: response ?? undefined};"
    },
    "get_clients": {
      "label": "Get Clients",
      "description": "Retrieves the list of clients associated with the account. Can filter by client key.",
      "audience": "both",
      "inputs": {
        "key": {
          "label": "Client Key",
          "description": "Unique client key to filter results.",
          "required": true
        }
      },
      "request": {
        "method": "GET",
        "url": "https://api.simpliroute.com/v1/accounts/clients/",
        "query": {
          "key": "{{key}}"
        }
      },
      "afterResponse": "return {status: 200, data: response ?? undefined};"
    },
    "create_clients": {
      "label": "Create Clients",
      "description": "Create one or multiple new clients in the account.",
      "audience": "both",
      "inputs": {
        "clients": {
          "label": "Clients",
          "description": "Array of client objects to create.",
          "type": "json",
          "required": true
        }
      },
      "request": {
        "method": "POST",
        "url": "https://api.simpliroute.com/v1/accounts/clients/",
        "body": "{{clients}}"
      },
      "afterResponse": "return {status: 201, data: response ?? undefined};"
    },
    "create_client_property": {
      "label": "Create Client Custom Property",
      "description": "Create a new custom attribute for clients.",
      "audience": "both",
      "inputs": {
        "label": {
          "label": "label",
          "description": "Label of the new custom property.",
          "required": true
        },
        "type": {
          "label": "type",
          "description": "Property type (str, int, float or bool).",
          "required": true
        }
      },
      "request": {
        "method": "POST",
        "url": "https://api.simpliroute.com/v1/planner/client-properties/",
        "body": {
          "label": "{{label}}",
          "type": "{{type}}"
        }
      },
      "afterResponse": "return {status: 201, data: response ?? undefined};"
    },
    "get_vehicles": {
      "label": "Get Vehicles",
      "description": "Retrieve the list of vehicles registered in the account.",
      "audience": "both",
      "request": {
        "method": "GET",
        "url": "https://api.simpliroute.com/v1/routes/vehicles/"
      },
      "afterResponse": "return {status: 200, data: response ?? undefined};"
    },
    "create_vehicle": {
      "label": "Create Vehicle",
      "description": "Register a new vehicle in the account.",
      "audience": "both",
      "inputs": {
        "name": {
          "label": "name",
          "description": "The name of the vehicle.",
          "required": true
        },
        "capacity": {
          "label": "capacity",
          "description": "The maximum capacity of the vehicle.",
          "type": "number",
          "required": true
        },
        "default_driver": {
          "label": "default_driver",
          "description": "The assigned driver ID or null if not assigned."
        },
        "location_start_address": {
          "label": "location_start_address",
          "description": "The starting address of the vehicle.",
          "required": true
        },
        "location_start_latitude": {
          "label": "location_start_latitude",
          "description": "The latitude of the starting location.",
          "type": "number",
          "required": true
        },
        "location_start_longitude": {
          "label": "location_start_longitude",
          "description": "The longitude of the starting location.",
          "type": "number",
          "required": true
        },
        "location_end_address": {
          "label": "location_end_address",
          "description": "The ending address of the vehicle.",
          "required": true
        },
        "location_end_latitude": {
          "label": "location_end_latitude",
          "description": "The latitude of the ending location.",
          "type": "number",
          "required": true
        },
        "location_end_longitude": {
          "label": "location_end_longitude",
          "description": "The longitude of the ending location.",
          "type": "number",
          "required": true
        },
        "skills": {
          "label": "skills",
          "description": "a list of skill IDs (JSON format [1, 2]).",
          "type": "json"
        },
        "capacity2": {
          "label": "capacity2",
          "description": "Secondary vehicle capacity."
        },
        "capacity3": {
          "label": "capacity3",
          "description": "Third vehicle capacity."
        },
        "cost": {
          "label": "cost",
          "description": "Operational cost of the vehicle."
        },
        "shift_start": {
          "label": "shift_start",
          "description": "Start time of the vehicle shift."
        },
        "shift_end": {
          "label": "shift_end",
          "description": "End time of the vehicle shift."
        },
        "reference_id": {
          "label": "reference_id",
          "description": "External reference ID of the vehicle."
        },
        "license_plate": {
          "label": "license_plate",
          "description": "License plate or registration of the vehicle."
        },
        "min_load": {
          "label": "min_load",
          "description": "Minimum load (unit 1) required to dispatch.",
          "type": "number"
        },
        "min_load_2": {
          "label": "min_load_2",
          "description": "Minimum load (unit 2) required.",
          "type": "number"
        },
        "min_load_3": {
          "label": "min_load_3",
          "description": "Minimum load (unit 3) required.",
          "type": "number"
        },
        "max_visit": {
          "label": "max_visit",
          "description": "Maximum number of visits that the vehicle can perform.",
          "type": "number"
        },
        "max_time": {
          "label": "max_time",
          "description": "Maximum duration of route (in seconds).",
          "type": "number"
        },
        "rest_time_start": {
          "label": "rest_time_start",
          "description": "Start time of rest."
        },
        "rest_time_end": {
          "label": "rest_time_end",
          "description": "End time of rest."
        },
        "rest_time_duration": {
          "label": "rest_time_duration",
          "description": "Duration of rest."
        }
      },
      "request": {
        "method": "POST",
        "url": "https://api.simpliroute.com/v1/routes/vehicles/",
        "body": {
          "name": "{{name}}",
          "capacity": "{{capacity}}",
          "default_driver": "{{default_driver}}",
          "location_start_address": "{{location_start_address}}",
          "location_start_latitude": "{{location_start_latitude}}",
          "location_start_longitude": "{{location_start_longitude}}",
          "location_end_address": "{{location_end_address}}",
          "location_end_latitude": "{{location_end_latitude}}",
          "location_end_longitude": "{{location_end_longitude}}",
          "skills": "{{skills}}",
          "capacity2": "{{capacity2}}",
          "capacity3": "{{capacity3}}",
          "cost": "{{cost}}",
          "shift_start": "{{shift_start}}",
          "shift_end": "{{shift_end}}",
          "reference_id": "{{reference_id}}",
          "license_plate": "{{license_plate}}",
          "min_load": "{{min_load}}",
          "min_load_2": "{{min_load_2}}",
          "min_load_3": "{{min_load_3}}",
          "max_visit": "{{max_visit}}",
          "max_time": "{{max_time}}",
          "rest_time_start": "{{rest_time_start}}",
          "rest_time_end": "{{rest_time_end}}",
          "rest_time_duration": "{{rest_time_duration}}"
        }
      },
      "afterResponse": "return {status: 201, data: response ?? undefined};"
    },
    "get_vehicle": {
      "label": "Get Vehicle",
      "description": "Retrieve information of a specific vehicle.",
      "audience": "both",
      "inputs": {
        "vehicle_id": {
          "label": "vehicle_id",
          "description": "Vehicle ID.",
          "type": "number",
          "required": true
        }
      },
      "request": {
        "method": "GET",
        "url": "https://api.simpliroute.com/v1/routes/vehicles/{{vehicle_id}}/"
      },
      "afterResponse": "return {status: 200, data: response ?? undefined};"
    },
    "delete_vehicle": {
      "label": "Delete Vehicle",
      "description": "Delete a vehicle by its ID.",
      "audience": "both",
      "inputs": {
        "vehicle_id": {
          "label": "vehicle_id",
          "description": "Vehicle ID to delete.",
          "type": "number",
          "required": true
        }
      },
      "request": {
        "method": "DELETE",
        "url": "https://api.simpliroute.com/v1/routes/vehicles/{{vehicle_id}}/"
      },
      "afterResponse": "return {status: 200, data: response ?? undefined};"
    },
    "get_visits": {
      "label": "Get Visits",
      "description": "Retrieve all registered visits. Can be filtered by planned visit date.",
      "audience": "both",
      "inputs": {
        "planned_date": {
          "label": "planned_date",
          "description": "Filter visits by planned date (YYYY-MM-DD format).",
          "required": true
        }
      },
      "request": {
        "method": "GET",
        "url": "https://api.simpliroute.com/v1/routes/visits/",
        "query": {
          "planned_date": "{{planned_date}}"
        }
      },
      "afterResponse": "return {status: 200, data: response ?? undefined};"
    },
    "create_visits": {
      "label": "Create Visits",
      "description": "Create visits. Multiple visits can be created in a single request.",
      "audience": "both",
      "inputs": {
        "visits": {
          "label": "visits",
          "description": "Array of visit objects to create.",
          "type": "json",
          "required": true
        }
      },
      "request": {
        "method": "POST",
        "url": "https://api.simpliroute.com/v1/routes/visits/",
        "body": "{{visits}}"
      },
      "afterResponse": "return {status: 201, data: response ?? undefined};"
    },
    "get_visit": {
      "label": "Get Visit",
      "description": "Retrieve details of a specific visit by ID.",
      "audience": "both",
      "inputs": {
        "visit_id": {
          "label": "visit_id",
          "description": "Visit ID.",
          "type": "number",
          "required": true
        }
      },
      "request": {
        "method": "GET",
        "url": "https://api.simpliroute.com/v1/routes/visits/{{visit_id}}/"
      },
      "afterResponse": "return {status: 200, data: response ?? undefined};"
    },
    "update_visit_partial": {
      "label": "Update Visit (Partial)",
      "description": "Partially update fields of an existing visit.",
      "audience": "both",
      "inputs": {
        "visit_id": {
          "label": "visit_id",
          "description": "ID of the visit to update.",
          "type": "number",
          "required": true
        },
        "title": {
          "label": "title",
          "description": "Visit title (if you want to change it)."
        },
        "address": {
          "label": "address",
          "description": "Visit address (if you want to change it)."
        },
        "load": {
          "label": "load",
          "description": "Visit load (main unit).",
          "type": "number"
        },
        "load_2": {
          "label": "load_2",
          "description": "Visit load (unit 2).",
          "type": "number"
        },
        "load_3": {
          "label": "load_3",
          "description": "Visit load (unit 3).",
          "type": "number"
        },
        "duration": {
          "label": "duration",
          "description": "Visit duration (HH:MM:SS)."
        },
        "contact_name": {
          "label": "contact_name",
          "description": "Visit contact name."
        },
        "contact_phone": {
          "label": "contact_phone",
          "description": "Visit contact phone."
        },
        "notes": {
          "label": "notes",
          "description": "Visit notes."
        },
        "planned_date": {
          "label": "planned_date",
          "description": "Visit planned date (YYYY-MM-DD)."
        }
      },
      "request": {
        "method": "PATCH",
        "url": "https://api.simpliroute.com/v1/routes/visits/{{visit_id}}/",
        "body": {
          "title": "{{title}}",
          "address": "{{address}}",
          "load": "{{load}}",
          "load_2": "{{load_2}}",
          "load_3": "{{load_3}}",
          "duration": "{{duration}}",
          "contact_name": "{{contact_name}}",
          "contact_phone": "{{contact_phone}}",
          "notes": "{{notes}}",
          "planned_date": "{{planned_date}}"
        }
      },
      "afterResponse": "return {status: 200, data: response ?? undefined};"
    },
    "update_visit": {
      "label": "Update Visit (Complete)",
      "description": "Completely update an existing visit with all fields.",
      "audience": "both",
      "inputs": {
        "visit_id": {
          "label": "visit_id",
          "description": "ID of the visit to update.",
          "type": "number",
          "required": true
        },
        "title": {
          "label": "title",
          "description": "Visit title.",
          "required": true
        },
        "address": {
          "label": "address",
          "description": "Visit address.",
          "required": true
        },
        "latitude": {
          "label": "latitude",
          "description": "Visit latitude.",
          "type": "number"
        },
        "longitude": {
          "label": "longitude",
          "description": "Visit longitude.",
          "type": "number"
        },
        "load": {
          "label": "load",
          "description": "Visit load (main unit).",
          "type": "number"
        },
        "load_2": {
          "label": "load_2",
          "description": "Visit load (unit 2).",
          "type": "number"
        },
        "load_3": {
          "label": "load_3",
          "description": "Visit load (unit 3).",
          "type": "number"
        },
        "duration": {
          "label": "duration",
          "description": "Visit duration (HH:MM:SS)."
        },
        "contact_name": {
          "label": "contact_name",
          "description": "Visit contact name."
        },
        "contact_phone": {
          "label": "contact_phone",
          "description": "Visit contact phone."
        },
        "notes": {
          "label": "notes",
          "description": "Visit notes."
        },
        "planned_date": {
          "label": "planned_date",
          "description": "Visit planned date (YYYY-MM-DD).",
          "required": true
        }
      },
      "request": {
        "method": "PUT",
        "url": "https://api.simpliroute.com/v1/routes/visits/{{visit_id}}/",
        "body": {
          "title": "{{title}}",
          "address": "{{address}}",
          "latitude": "{{latitude}}",
          "longitude": "{{longitude}}",
          "load": "{{load}}",
          "load_2": "{{load_2}}",
          "load_3": "{{load_3}}",
          "duration": "{{duration}}",
          "contact_name": "{{contact_name}}",
          "contact_phone": "{{contact_phone}}",
          "notes": "{{notes}}",
          "planned_date": "{{planned_date}}"
        }
      },
      "afterResponse": "return {status: 200, data: response ?? undefined};"
    },
    "delete_visit": {
      "label": "Delete Visit",
      "description": "Delete a visit by its ID.",
      "audience": "both",
      "inputs": {
        "visit_id": {
          "label": "visit_id",
          "description": "ID of the visit to delete.",
          "type": "number",
          "required": true
        }
      },
      "request": {
        "method": "DELETE",
        "url": "https://api.simpliroute.com/v1/routes/visits/{{visit_id}}/"
      },
      "afterResponse": "return {status: 200, data: response ?? undefined};"
    },
    "add_visit_items": {
      "label": "Add Visit Items",
      "description": "Add items to an existing visit.",
      "audience": "both",
      "inputs": {
        "visit_id": {
          "label": "visit_id",
          "description": "ID of the visit to add items to.",
          "type": "number",
          "required": true
        },
        "items": {
          "label": "items",
          "description": "Array of items to add to the visit.",
          "type": "json",
          "required": true
        }
      },
      "request": {
        "method": "POST",
        "url": "https://api.simpliroute.com/v1/routes/visits/{{visit_id}}/items/",
        "body": "{{items}}"
      },
      "afterResponse": "return {status: 201, data: response ?? undefined};"
    },
    "get_routes": {
      "label": "Get Routes",
      "description": "Retrieve the list of existing routes.",
      "audience": "both",
      "inputs": {
        "planned_date": {
          "label": "planned_date",
          "description": "Visit planned date (YYYY-MM-DD).",
          "required": true
        }
      },
      "request": {
        "method": "GET",
        "url": "https://api.simpliroute.com/v1/routes/routes/",
        "query": {
          "planned_date": "{{planned_date}}"
        }
      },
      "afterResponse": "return {status: 200, data: response ?? undefined};"
    },
    "create_route": {
      "label": "Create Route",
      "description": "Create a new route manually by assigning vehicle, driver and date.",
      "audience": "both",
      "inputs": {
        "vehicle": {
          "label": "vehicle",
          "description": "Vehicle ID for the route.",
          "type": "number",
          "required": true
        },
        "driver": {
          "label": "driver",
          "description": "Driver ID for the route.",
          "type": "number",
          "required": true
        },
        "planned_date": {
          "label": "planned_date",
          "description": "Planned route date (YYYY-MM-DD).",
          "required": true
        },
        "estimated_time_start": {
          "label": "estimated_time_start",
          "description": "Estimated start time (HH:MM:SS).",
          "required": true
        },
        "estimated_time_end": {
          "label": "estimated_time_end",
          "description": "Estimated end time (HH:MM:SS).",
          "required": true
        },
        "location_start_address": {
          "label": "location_start_address",
          "description": "Route start address.",
          "required": true
        },
        "location_start_latitude": {
          "label": "location_start_latitude",
          "description": "Route start latitude.",
          "required": true
        },
        "location_start_longitude": {
          "label": "location_start_longitude",
          "description": "Route start longitude.",
          "required": true
        },
        "location_end_address": {
          "label": "location_end_address",
          "description": "Route end address.",
          "required": true
        },
        "location_end_latitude": {
          "label": "location_end_latitude",
          "description": "Route end latitude.",
          "required": true
        },
        "location_end_longitude": {
          "label": "location_end_longitude",
          "description": "Route end longitude.",
          "required": true
        },
        "plan": {
          "label": "plan",
          "description": "Plan (execution) ID to associate the route (UUID).",
          "required": true
        }
      },
      "request": {
        "method": "POST",
        "url": "https://api.simpliroute.com/v1/routes/routes/",
        "body": {
          "vehicle": "{{vehicle}}",
          "driver": "{{driver}}",
          "planned_date": "{{planned_date}}",
          "estimated_time_start": "{{estimated_time_start}}",
          "estimated_time_end": "{{estimated_time_end}}",
          "location_start_address": "{{location_start_address}}",
          "location_start_latitude": "{{location_start_latitude}}",
          "location_start_longitude": "{{location_start_longitude}}",
          "location_end_address": "{{location_end_address}}",
          "location_end_latitude": "{{location_end_latitude}}",
          "location_end_longitude": "{{location_end_longitude}}",
          "plan": "{{plan}}"
        }
      },
      "afterResponse": "return {status: 201, data: response ?? undefined};"
    },
    "get_route": {
      "label": "Get Route",
      "description": "Retrieve details of a specific route.",
      "audience": "both",
      "inputs": {
        "route_id": {
          "label": "route_id",
          "description": "Route ID (UUID).",
          "required": true
        }
      },
      "request": {
        "method": "GET",
        "url": "https://api.simpliroute.com/v1/routes/routes/{{route_id}}/"
      },
      "afterResponse": "return {status: 200, data: response ?? undefined};"
    },
    "delete_route": {
      "label": "Delete Route",
      "description": "Delete a route by its ID.",
      "audience": "both",
      "inputs": {
        "route_id": {
          "label": "route_id",
          "description": "Route ID to delete (UUID).",
          "required": true
        }
      },
      "request": {
        "method": "DELETE",
        "url": "https://api.simpliroute.com/v1/routes/routes/{{route_id}}/"
      },
      "afterResponse": "return {status: 200, data: response ?? undefined};"
    },
    "get_plans": {
      "label": "Get Plans",
      "description": "Retrieve the list of saved routing plans (executions).",
      "audience": "both",
      "inputs": {
        "date": {
          "label": "date",
          "description": "Planned date (YYYY-MM-DD).",
          "required": true
        }
      },
      "request": {
        "method": "GET",
        "url": "https://api.simpliroute.com/v1/plans/{{date}}/"
      },
      "afterResponse": "return {status: 200, data: response ?? undefined};"
    },
    "create_plan": {
      "label": "Create an empty plan",
      "description": "Create an empty plan (execution) without routes (reserve a planning day).",
      "audience": "both",
      "inputs": {
        "name": {
          "label": "name",
          "description": "Plan name.",
          "required": true
        },
        "start_date": {
          "label": "start_date",
          "description": "Start date (YYYY-MM-DD).",
          "required": true
        },
        "end_date": {
          "label": "end_date",
          "description": "End date (YYYY-MM-DD).",
          "required": true
        }
      },
      "request": {
        "method": "POST",
        "url": "https://api.simpliroute.com/v1/plans/create-plan/",
        "body": {
          "name": "{{name}}",
          "start_date": "{{start_date}}",
          "end_date": "{{end_date}}"
        }
      },
      "afterResponse": "return {status: 201, data: response ?? undefined};"
    },
    "get_plan_vehicles": {
      "label": "Get vehicles with routes on date",
      "description": "Returns the vehicles that have planned routes on the indicated date.",
      "audience": "both",
      "inputs": {
        "planned_date": {
          "label": "planned_date",
          "description": "Planned date (YYYY-MM-DD).",
          "required": true
        }
      },
      "request": {
        "method": "GET",
        "url": "https://api.simpliroute.com/v1/plans/{{planned_date}}/vehicles/"
      },
      "afterResponse": "return {status: 200, data: response ?? undefined};"
    },
    "get_visit_detail": {
      "label": "Get Visit Detail",
      "description": "Get detailed information about a specific visit.",
      "audience": "both",
      "inputs": {
        "visit_id": {
          "label": "visit_id",
          "description": "ID of the visit to get details for.",
          "type": "number",
          "required": true
        }
      },
