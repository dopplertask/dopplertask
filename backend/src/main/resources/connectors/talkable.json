{
  "name": "talkable",
  "label": "Talkable",
  "description": "Referral marketing programs that drive revenue",
  "icon": "",
  "hosts": [
    "www.talkable.com"
  ],
  "baseUrl": "https://www.talkable.com/api/v2",
  "upstream": {
    "package": "@activepieces/piece-talkable",
    "version": "0.3.3"
  },
  "credential": {
    "fields": {
      "site": {
        "label": "Talkable site ID",
        "required": true
      },
      "api_key": {
        "label": "API key",
        "required": true,
        "secret": true
      }
    },
    "headers": {
      "Authorization": "Bearer {{credential.api_key}}"
    },
    "body": {
      "site_slug": "{{credential.site}}"
    }
  },
  "actions": {
    "find_person": {
      "label": "Find person",
      "description": "Find person by email",
      "inputs": {
        "email": {
          "label": "Person email",
          "required": true
        },
        "scope": {
          "label": "Scope",
          "type": "select",
          "description": "Select scope",
          "options": [
            {
              "value": "",
              "label": "General information"
            },
            {
              "value": "referrals_as_advocate",
              "label": "Referrals as advocate"
            },
            {
              "value": "referrals_as_friend",
              "label": "Referrals as friend"
            },
            {
              "value": "rewards",
              "label": "Rewards"
            },
            {
              "value": "shares_by",
              "label": "Shares"
            },
            {
              "value": "personal_data",
              "label": "Personal data"
            }
          ]
        }
      },
      "request": {
        "method": "GET",
        "url": "https://www.talkable.com/api/v2/people/{{email}}/{{scope}}?site_slug={{credential.site}}"
      }
    },
    "find_coupon": {
      "label": "Find coupon",
      "description": "Find coupon code",
      "inputs": {
        "code": {
          "label": "Coupon code",
          "required": true
        }
      },
      "request": {
        "method": "GET",
        "url": "https://www.talkable.com/api/v2/coupons/{{code}}?site_slug={{credential.site}}"
      }
    },
    "update_person": {
      "label": "Update person",
      "description": "Update person by email",
      "inputs": {
        "email": {
          "label": "Person email",
          "required": true
        },
        "first_name": {
          "label": "Person first name"
        },
        "last_name": {
          "label": "Person last name"
        },
        "phone_number": {
          "label": "Person phone number"
        },
        "username": {
          "label": "Person username"
        },
        "customer_id": {
          "label": "Customer ID",
          "type": "number"
        },
        "custom_properties": {
          "label": "Custom properties",
          "type": "json"
        },
        "gated_param_subscribed": {
          "label": "Opt-in status",
          "type": "select",
          "description": "Opt-in status true/false",
          "options": [
            {
              "value": "true",
              "label": "true"
            },
            {
              "value": "false",
              "label": "false"
            }
          ]
        },
        "unsubscribed": {
          "label": "Unsubscribe status",
          "type": "select",
          "description": "Unsubscribe status true/false",
          "options": [
            {
              "value": "true",
              "label": "true"
            },
            {
              "value": "false",
              "label": "false"
            }
          ]
        },
        "unsubscribed_at": {
          "label": "Unsubscribed date"
        }
      },
      "request": {
        "method": "PUT",
        "url": "https://www.talkable.com/api/v2/people/{{email}}",
        "body": {
          "data": {
            "first_name": "{{first_name}}",
            "last_name": "{{last_name}}",
            "phone_number": "{{phone_number}}",
            "username": "{{username}}",
            "customer_id": "{{customer_id}}",
            "custom_properties": "{{custom_properties}}",
            "gated_param_subscribed": "{{gated_param_subscribed}}",
            "unsubscribed": "{{unsubscribed}}",
            "unsubscribed_at": "{{unsubscribed_at}}"
          }
        }
      }
    },
    "anonymize_person": {
      "label": "Anonymize person",
      "description": "Anonymize person by email",
      "inputs": {
        "email": {
          "label": "Person email",
          "required": true
        }
      },
      "request": {
        "method": "POST",
        "url": "https://www.talkable.com/api/v2/people/{{email}}/anonymize",
        "body": {}
      }
    },
    "unsubscribe_person": {
      "label": "Unsubscribe person",
      "description": "Unsubscribe person by email",
      "inputs": {
        "email": {
          "label": "Person email",
          "required": true
        }
      },
      "request": {
        "method": "POST",
        "url": "https://www.talkable.com/api/v2/people/{{email}}/unsubscribe",
        "body": {}
      }
    },
    "create_purchase": {
      "label": "Create purchase",
      "description": "Create purchase in Talkable",
      "inputs": {
        "email": {
          "label": "Email",
          "required": true
        },
        "order_number": {
          "label": "Order number",
          "required": true
        },
        "subtotal": {
          "label": "Subtotal",
          "type": "number",
          "required": true
        },
        "first_name": {
          "label": "First name"
        },
        "last_name": {
          "label": "Last name"
        },
        "username": {
          "label": "Username"
        },
        "customer_id": {
          "label": "Customer id"
        },
        "custom_properties": {
          "label": "Custom properties",
          "type": "json"
        },
        "phone_number": {
          "label": "Phone number"
        },
        "campaign_tags": {
          "label": "Campaign tags"
        },
        "sharing_channels": {
          "label": "Sharing channels",
          "type": "json"
        },
        "ip_address": {
          "label": "IP address"
        },
        "uuid": {
          "label": "UUID"
        },
        "created_at": {
          "label": "Created at"
        },
        "traffic_source": {
          "label": "Traffic source"
        },
        "coupon_codes": {
          "label": "Coupon codes",
          "type": "json"
        },
        "currency_iso_code": {
          "label": "Currency iso code",
          "description": "Required for multi-currency sites",
          "defaultValue": "USD"
        },
        "custom_field": {
          "label": "Custom field"
        },
        "shipping_address": {
          "label": "Shipping address"
        },
        "shipping_zip": {
          "label": "Shipping zip"
        },
        "items": {
          "label": "Items",
          "type": "json",
          "description": "You can pass items with purchase",
          "defaultValue": "[{\"price\":10,\"quantity\":1,\"product_id\":\"SKU1\"}]"
        }
      },
      "request": {
        "method": "POST",
        "url": "https://www.talkable.com/api/v2/origins/purchase",
        "body": {
          "data": {
            "email": "{{email}}",
            "order_number": "{{order_number}}",
            "subtotal": "{{subtotal}}",
            "first_name": "{{first_name}}",
            "last_name": "{{last_name}}",
            "username": "{{username}}",
            "customer_id": "{{customer_id}}",
            "custom_properties": "{{custom_properties}}",
            "phone_number": "{{phone_number}}",
            "campaign_tags": "{{campaign_tags}}",
            "sharing_channels": "{{sharing_channels}}",
            "ip_address": "{{ip_address}}",
            "uuid": "{{uuid}}",
            "created_at": "{{created_at}}",
            "traffic_source": "{{traffic_source}}",
            "coupon_codes": "{{coupon_codes}}",
            "currency_iso_code": "{{currency_iso_code}}",
            "custom_field": "{{custom_field}}",
            "shipping_address": "{{shipping_address}}",
            "shipping_zip": "{{shipping_zip}}",
            "items": "{{items}}"
          }
        }
      }
    },
    "create_purchases_batch": {
      "label": "Create batch of purchases",
      "description": "Create batch of purchases in Talkable",
      "inputs": {
        "create_offers": {
          "label": "Create offers",
          "type": "boolean",
          "description": "Create offers for campaign",
          "defaultValue": "false"
        },
        "purchases": {
          "label": "Purchases",
          "type": "json",
          "defaultValue": "[{\"email\":\"customer@store.com\",\"order_number\":\"20\",\"subtotal\":100.44,\"first_name\":\"John\",\"last_name\":\"Doe\",\"username\":\"johndoe1992\",\"customer_id\":\"1024\",\"custom_properties\":{\"country\":\"US\",\"eye_color\":\"brown\",\"person_occupation\":\"marketing\"},\"custom_field\":\"\",\"phone_number\":\"+12025551111\",\"campaign_tags\":\"post-purchase\",\"sharing_channels\":[\"facebook\",\"custom\"],\"ip_address\":\"192.0.2.255\",\"uuid\":\"123e4567-e89b-32d1-a456-426614174000\",\"created_at\":\"2023-04-27T11:30:42.769-07:00\",\"traffic_source\":\"in-store\",\"coupon_codes\":[\"C0001\",\"C0002\"],\"currency_iso_code\":\"USD\",\"shipping_address\":\"456 White Finch St., North Augusta, South Carolina, 29860, United States\",\"shipping_zip\":\"29860\",\"items\":[{\"price\":25.11,\"quantity\":4,\"product_id\":\"TSHIRT\"}]}]"
        }
      },
      "request": {
        "method": "POST",
        "url": "https://www.talkable.com/api/v2/origins/batch/purchases",
        "body": {
          "data": "{{purchases}}",
          "create_offers": "{{create_offers}}"
        }
      }
    },
    "create_event": {
      "label": "Create event",
      "description": "Create event in Talkable",
      "inputs": {
        "email": {
          "label": "Email",
          "required": true
        },
        "event_category": {
          "label": "Event category",
          "required": true
        },
        "event_number": {
          "label": "Event number",
          "required": true
        },
        "subtotal": {
          "label": "Subtotal",
          "type": "number",
          "required": true
        },
        "first_name": {
          "label": "First name"
        },
        "last_name": {
          "label": "Last name"
        },
        "username": {
          "label": "Username"
        },
        "customer_id": {
          "label": "Customer id"
        },
        "custom_properties": {
          "label": "Custom properties",
          "type": "json"
        },
        "phone_number": {
          "label": "Phone number"
        },
        "campaign_tags": {
          "label": "Campaign tags"
        },
        "sharing_channels": {
          "label": "Sharing channels",
          "type": "json"
        },
        "ip_address": {
          "label": "IP address"
        },
        "uuid": {
          "label": "UUID"
        },
        "created_at": {
          "label": "Created at"
        },
        "traffic_source": {
          "label": "Traffic source"
        },
        "coupon_codes": {
          "label": "Coupon codes",
          "type": "json"
        },
        "currency_iso_code": {
          "label": "Currency iso code",
          "description": "Required for multi-currency sites",
          "defaultValue": "USD"
        },
        "custom_field": {
          "label": "Custom field"
        },
        "shipping_address": {
          "label": "Shipping address"
        },
        "shipping_zip": {
          "label": "Shipping zip"
        },
        "items": {
          "label": "Items",
          "type": "json",
          "description": "You can pass items with event",
          "defaultValue": "[{\"price\":10,\"quantity\":1,\"product_id\":\"SKU1\"}]"
        }
      },
      "request": {
        "method": "POST",
        "url": "https://www.talkable.com/api/v2/origins/event",
        "body": {
          "data": {
            "email": "{{email}}",
            "event_category": "{{event_category}}",
            "event_number": "{{event_number}}",
            "subtotal": "{{subtotal}}",
            "first_name": "{{first_name}}",
            "last_name": "{{last_name}}",
            "username": "{{username}}",
            "customer_id": "{{customer_id}}",
            "custom_properties": "{{custom_properties}}",
            "phone_number": "{{phone_number}}",
            "campaign_tags": "{{campaign_tags}}",
            "sharing_channels": "{{sharing_channels}}",
            "ip_address": "{{ip_address}}",
            "uuid": "{{uuid}}",
            "created_at": "{{created_at}}",
            "traffic_source": "{{traffic_source}}",
            "coupon_codes": "{{coupon_codes}}",
            "currency_iso_code": "{{currency_iso_code}}",
            "custom_field": "{{custom_field}}",
            "shipping_address": "{{shipping_address}}",
            "shipping_zip": "{{shipping_zip}}",
            "items": "{{items}}"
          }
        }
      }
    },
    "create_events_batch": {
      "label": "Create batch of events",
      "description": "Create batch of events in Talkable",
      "inputs": {
        "create_offers": {
          "label": "Create offers",
          "type": "boolean",
          "description": "Create offers for campaign",
          "defaultValue": "false"
        },
        "events": {
          "label": "Events",
          "type": "json",
          "defaultValue": "[{\"email\":\"user@store.com\",\"event_category\":\"newsletter_subscription\",\"event_number\":\"42\",\"subtotal\":100.44,\"first_name\":\"John\",\"last_name\":\"Doe\",\"username\":\"johndoe1992\",\"customer_id\":\"1024\",\"custom_properties\":{\"country\":\"US\",\"eye_color\":\"brown\",\"person_occupation\":\"marketing\"},\"custom_field\":\"\",\"phone_number\":\"+12025551111\",\"campaign_tags\":\"post-purchase\",\"sharing_channels\":[\"facebook\",\"custom\"],\"ip_address\":\"192.0.2.255\",\"uuid\":\"123e4567-e89b-32d1-a456-426614174000\",\"created_at\":\"2023-04-27T11:30:42.769-07:00\",\"traffic_source\":\"in-store\",\"coupon_codes\":[\"C0001\",\"C0002\"],\"currency_iso_code\":\"USD\",\"shipping_address\":\"456 White Finch St., North Augusta, South Carolina, 29860, United States\",\"shipping_zip\":\"29860\",\"items\":[{\"price\":100.44,\"quantity\":1,\"product_id\":\"SUBSCRIPTION\"}]}]"
        }
      },
      "request": {
        "method": "POST",
        "url": "https://www.talkable.com/api/v2/origins/batch/events",
        "body": {
          "data": "{{events}}",
          "create_offers": "{{create_offers}}"
        }
      }
    },
    "refund": {
      "label": "Refund purchase/event",
      "description": "Mark origin as refund",
      "inputs": {
        "origin_slug": {
          "label": "Order or event number",
          "required": true
        },
        "refund_subtotal": {
          "label": "Refund subtotal",
          "type": "number"
        },
        "refunded_at": {
          "label": "Refunded date"
        }
      },
      "request": {
        "method": "POST",
        "url": "https://www.talkable.com/api/v2/origins/{{origin_slug}}/refund",
        "body": {
          "data": {
            "refunded_at": "{{refunded_at}}",
            "refund_subtotal": "{{refund_subtotal}}"
          }
        }
      }
    },
    "get_loyalty_redeem_actions": {
      "label": "Get loyalty actions",
      "description": "Get array of loyalty actions",
      "inputs": {
        "person_email": {
          "label": "Person email",
          "required": true
        }
      },
      "request": {
        "method": "GET",
        "url": "https://www.talkable.com/api/v2/loyalty/members/{{person_email}}/redeem_actions?site_slug={{credential.site}}"
      }
    },
    "update-referral-status": {
      "label": "Update referral status",
      "description": "You can void or approve referral",
      "inputs": {
        "origin_slug": {
          "label": "Order or event number",
          "required": true
        },
        "status": {
          "label": "Status",
          "type": "select",
          "required": true,
          "description": "Select referral status. Only \"approved\" or \"voided\" are accepted",
          "options": [
            {
              "value": "approved",
              "label": "approved"
            },
            {
              "value": "voided",
              "label": "voided"
            }
          ]
        }
      },
      "request": {
        "method": "POST",
        "url": "https://www.talkable.com/api/v2/origins/{{origin_slug}}/referral",
        "body": {
          "status": "{{status}}"
        }
      }
    },
    "claim-offer": {
      "label": "Share and claim offer",
      "description": "Using this action, you can share and get a friend's reward",
      "inputs": {
        "advocate_email": {
          "label": "Advocate email",
          "required": true,
          "description": "Example : advocate@example.com"
        },
        "friend_email": {
          "label": "Friend email",
          "required": true,
          "description": "Example : friend@example.com"
        },
        "campaign_tag": {
          "label": "Campaign tag",
          "required": true,
          "description": "Example : invite"
        }
      },
      "request": {
        "method": "POST",
        "url": "https://www.talkable.com/api/v2/offer_claims",
        "body": {
          "advocate_email": "{{advocate_email}}",
          "friend_email": "{{friend_email}}",
          "campaign_tag": "{{campaign_tag}}"
        }
      }
    }
  }
}
