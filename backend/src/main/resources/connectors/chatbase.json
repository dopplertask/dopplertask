{
  "name": "chatbase",
  "label": "Chatbase",
  "description": "Build and manage AI chatbots with custom sources.",
  "icon": "",
  "hosts": [
    "www.chatbase.co"
  ],
  "upstream": {
    "package": "@activepieces/piece-chatbase",
    "version": "0.2.1"
  },
  "credential": {
    "fields": {
      "token": {
        "label": "API Key",
        "description": "You can get your API key from your [Chatbase Account](https://www.chatbase.co/dashboard).",
        "secret": true,
        "required": true
      }
    },
    "headers": {
      "authorization": "Bearer {{credential.token}}"
    }
  },
  "actions": {
    "create_chatbot": {
      "label": "Create Chatbot",
      "description": "Creates a new chatbot.",
      "inputs": {
        "chatbotName": {
          "label": "Chatbot Name",
          "required": true
        },
        "sourceText": {
          "label": "Source Text",
          "description": "Optional text data for training the chatbot.",
          "type": "multiline"
        }
      },
      "request": {
        "method": "POST",
        "url": "https://www.chatbase.co/api/v1/create-chatbot",
        "body": {
          "chatbotName": "{{chatbotName}}",
          "sourceText": "{{sourceText}}"
        }
      }
    },
    "message_chatbot": {
      "label": "Send Prompt to Chatbot",
      "description": "Sends a prompt to the chatbot to generate a response.",
      "inputs": {
        "chatbotId": {
          "label": "Chatbot",
          "required": true
        },
        "message": {
          "label": "Prompt",
          "required": true,
          "type": "multiline"
        },
        "temperature": {
          "label": "Temperature",
          "description": "Higher values = more random output. Between 0 and 1.",
          "type": "number",
          "defaultValue": "0"
        },
        "conversationId": {
          "label": "Conversation ID",
          "description": "Unique ID for saving this conversation in Chatbase dashboard."
        },
        "model": {
          "label": "Model (Optional)",
          "type": "select",
          "options": [
            {
              "value": "o4-mini",
              "label": "o4-mini"
            },
            {
              "value": "o3",
              "label": "o3"
            },
            {
              "value": "gpt-4",
              "label": "gpt-4"
            },
            {
              "value": "gpt-4o",
              "label": "gpt-4o"
            },
            {
              "value": "gpt-4o-mini",
              "label": "gpt-4o-mini"
            },
            {
              "value": "gpt-4.1-mini",
              "label": "gpt-4.1-mini"
            },
            {
              "value": "gpt-4.1-nano",
              "label": "gpt-4.1-nano"
            },
            {
              "value": "gpt-4-turbo",
              "label": "gpt-4-turbo"
            },
            {
              "value": "o3-mini",
              "label": "o3-mini"
            },
            {
              "value": "gpt-4.1",
              "label": "gpt-4.1"
            },
            {
              "value": "gpt-4.5",
              "label": "gpt-4.5"
            },
            {
              "value": "claude-sonnet-4",
              "label": "claude-sonnet-4"
            },
            {
              "value": "claude-3-7-sonnet",
              "label": "claude-3-7-sonnet"
            },
            {
              "value": "claude-3-5-sonnet",
              "label": "claude-3-5-sonnet"
            },
            {
              "value": "claude-3-opus",
              "label": "claude-3-opus"
            },
            {
              "value": "claude-opus-4",
              "label": "claude-opus-4"
            },
            {
              "value": "claude-3-haiku",
              "label": "claude-3-haiku"
            },
            {
              "value": "gemini-2.0-flash",
              "label": "gemini-2.0-flash"
            },
            {
              "value": "gemini-1.5-flash",
              "label": "gemini-1.5-flash"
            },
            {
              "value": "gemini-1.5-pro",
              "label": "gemini-1.5-pro"
            },
            {
              "value": "gemini-2.0-pro",
              "label": "gemini-2.0-pro"
            },
            {
              "value": "command-r",
              "label": "command-r"
            },
            {
              "value": "command-r-plus",
              "label": "command-r-plus"
            },
            {
              "value": "DeepSeek-V3",
              "label": "DeepSeek-V3"
            },
            {
              "value": "DeepSeek-R1",
              "label": "DeepSeek-R1"
            },
            {
              "value": "Llama-4-Scout-17B-16E-Instruct",
              "label": "Llama-4-Scout-17B-16E-Instruct"
            },
            {
              "value": "Llama-4-Maverick-17B-128E-Instruct-FP8",
              "label": "Llama-4-Maverick-17B-128E-Instruct-FP8"
            },
            {
              "value": "grok-3",
              "label": "grok-3"
            },
            {
              "value": "grok-3-mini",
              "label": "grok-3-mini"
            }
          ]
        }
      },
      "request": {
        "method": "POST",
        "url": "https://www.chatbase.co/api/v1/chat",
        "body": {
          "chatbotId": "{{chatbotId}}",
          "messages": [
            {
              "content": "{{message}}",
              "role": "user"
            }
          ],
          "temperature": "{{temperature}}",
          "conversationId": "{{conversationId}}"
        }
      }
    },
    "search_conversations": {
      "label": "Search Conversations by Query",
      "description": "Searches for conversations from a specific chatbot.",
      "inputs": {
        "chatbotId": {
          "label": "Chatbot",
          "required": true
        },
        "filteredSources": {
          "label": "Sources",
          "description": "Filter by one or more conversation sources.",
          "type": "json",
          "options": [
            {
              "value": "API",
              "label": "API"
            },
            {
              "value": "Chatbase site",
              "label": "Chatbase site"
            },
            {
              "value": "Instagram",
              "label": "Instagram"
            },
            {
              "value": "Messenger",
              "label": "Messenger"
            },
            {
              "value": "Slack",
              "label": "Slack"
            },
            {
              "value": "Unspecified",
              "label": "Unspecified"
            },
            {
              "value": "WhatsApp",
              "label": "WhatsApp"
            },
            {
              "value": "Widget or Iframe",
              "label": "Widget or Iframe"
            }
          ]
        },
        "startDate": {
          "label": "Start Date"
        },
        "endDate": {
          "label": "End Date"
        },
        "page": {
          "label": "Page",
          "description": "Pagination page number (default = 1)",
          "type": "number"
        },
        "size": {
          "label": "Page Size",
          "description": "Number of results per page (default = 10, max = 100)",
          "type": "number"
        }
      },
      "request": {
        "method": "GET",
        "url": "https://www.chatbase.co/api/v1/get-conversations",
        "query": {
          "chatbotId": "{{chatbotId}}",
          "startDate": "{{startDate}}",
          "endDate": "{{endDate}}",
          "page": "{{page}}",
          "size": "{{size}}"
        }
      }
    },
    "list_chatbots": {
      "label": "List All Chatbots",
      "description": "Retrieves a list of all chatbots.",
      "inputs": {},
      "request": {
        "method": "GET",
        "url": "https://www.chatbase.co/api/v1/get-chatbots"
      }
    }
  },
  "triggers": {}
}
