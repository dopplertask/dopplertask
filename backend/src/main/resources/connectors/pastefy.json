{
  "name": "pastefy",
  "label": "Pastefy",
  "description": "Sharing code snippets platform",
  "icon": "",
  "hosts": [
    "{{credential.instance_url}}"
  ],
  "upstream": {
    "package": "@activepieces/piece-pastefy",
    "version": "0.4.2"
  },
  "credential": {
    "fields": {
      "instance_url": {
        "label": "Pastefy Instance URL",
        "description": "Base URL of your Pastefy server, for example https://pastefy.app. The host only, without https://, such as name.example.com."
      },
      "token": {
        "label": "API Key",
        "description": "Optional. Without a key you can only create and read pastes anonymously; folders, your own pastes, editing and deleting need a key.",
        "secret": true
      }
    },
    "headers": {
      "authorization": "Bearer {{credential.token}}"
    }
  },
  "actions": {
    "create_paste": {
      "label": "Create Paste",
      "description": "Creates a new paste.",
      "inputs": {
        "content": {
          "label": "Content",
          "required": true,
          "type": "multiline"
        },
        "title": {
          "label": "Title"
        },
        "password": {
          "label": "Encryption Password",
          "description": "Encrypts the content and title before upload. It cannot be recovered."
        },
        "folder_id": {
          "label": "Folder",
          "description": "Folder to put the paste in."
        },
        "visibility": {
          "label": "Visibility",
          "description": "Who can see the paste. Pastefy defaults to Unlisted.",
          "type": "select",
          "options": [
            {
              "value": "PUBLIC",
              "label": "Public"
            },
            {
              "value": "UNLISTED",
              "label": "Unlisted"
            },
            {
              "value": "PRIVATE",
              "label": "Private"
            }
          ]
        },
        "expiry": {
          "label": "Expiry Date",
          "description": "When Pastefy deletes the paste."
        },
        "tags": {
          "label": "Tags",
          "description": "Tags to add to the paste.",
          "type": "json"
        }
      },
      "request": {
        "method": "GET",
        "url": "https://{{credential.instance_url}}/api/v2/folder/{{folder_id}}",
        "query": {
          "hide_children": "true"
        }
      }
    },
    "edit_paste": {
      "label": "Edit Paste",
      "description": "Changes a paste you own. Empty fields stay unchanged.",
      "inputs": {
        "paste_id": {
          "label": "Paste ID",
          "description": "The 8-character paste ID, as in https://pastefy.app/<id>. Get it from List My Pastes or Search Public Pastes.",
          "required": true
        },
        "content": {
          "label": "Content",
          "type": "multiline"
        },
        "title": {
          "label": "Title"
        },
        "password": {
          "label": "Encryption Password",
          "description": "Needed to edit an encrypted paste; on a plain paste it encrypts it."
        },
        "folder_id": {
          "label": "Folder",
          "description": "Move the paste to this folder."
        },
        "visibility": {
          "label": "Visibility",
          "description": "New visibility.",
          "type": "select",
          "options": [
            {
              "value": "PUBLIC",
              "label": "Public"
            },
            {
              "value": "UNLISTED",
              "label": "Unlisted"
            },
            {
              "value": "PRIVATE",
              "label": "Private"
            }
          ]
        },
        "expiry": {
          "label": "Expiry Date"
        },
        "tags": {
          "label": "Tags",
          "description": "Replaces all tags of the paste.",
          "type": "json"
        },
        "clear_tags": {
          "label": "Clear Tags",
          "description": "Remove all tags (ignored when Tags is filled).",
          "type": "boolean",
          "defaultValue": "false"
        }
      },
      "request": {
        "method": "GET",
        "url": "https://{{credential.instance_url}}/api/v2/paste/{{paste_id}}"
      }
    },
    "get_folder": {
      "label": "Get Folder",
      "description": "Retrieves a folder with its subfolders and pastes.",
      "inputs": {
        "folder_id": {
          "label": "Folder",
          "description": "The folder to get.",
          "required": true
        },
        "include_contents": {
          "label": "Include Contents",
          "description": "Add pastes and subfolder contents.",
          "type": "boolean",
          "defaultValue": "true"
        }
      },
      "request": {
        "method": "GET",
        "url": "https://{{credential.instance_url}}/api/v2/folder/{{folder_id}}"
      }
    },
    "get_folder_hierarchy": {
      "label": "Get Folder Hierarchy",
      "description": "Retrieves the tree of all your folders.",
      "inputs": {
        "parent_id": {
          "label": "Start Folder",
          "description": "Only return the folders inside this folder."
        }
      },
      "request": {
        "method": "GET",
        "url": "https://{{credential.instance_url}}/api/v2/user/folders",
        "query": {
          "hide_pastes": "true"
        }
      }
    },
    "create_paste_ai": {
      "label": "Create Paste (by Folder ID)",
      "description": "Creates a paste, with the folder given by ID.",
      "inputs": {
        "content": {
          "label": "Content",
          "required": true,
          "type": "multiline"
        },
        "title": {
          "label": "Title"
        },
        "password": {
          "label": "Encryption Password",
          "description": "Encrypts content and title with this password."
        },
        "folder_id": {
          "label": "Folder ID",
          "description": "Folder ID from List Folders."
        },
        "visibility": {
          "label": "Visibility",
          "description": "PUBLIC, UNLISTED or PRIVATE. Default UNLISTED.",
          "type": "select",
          "options": [
            {
              "value": "PUBLIC",
              "label": "Public"
            },
            {
              "value": "UNLISTED",
              "label": "Unlisted"
            },
            {
              "value": "PRIVATE",
              "label": "Private"
            }
          ]
        },
        "expiry": {
          "label": "Expiry Date",
          "description": "ISO 8601 date-time, for example 2026-12-31T18:00:00Z."
        },
        "tags": {
          "label": "Tags",
          "description": "Tags to add.",
          "type": "json"
        }
      },
      "request": {
        "method": "GET",
        "url": "https://{{credential.instance_url}}/api/v2/folder/{{folder_id}}",
        "query": {
          "hide_children": "true"
        }
      }
    },
    "edit_paste_ai": {
      "label": "Update Paste (by IDs)",
      "description": "Changes a paste you own, with paste and folder given by ID.",
      "inputs": {
        "paste_id": {
          "label": "Paste ID",
          "description": "The 8-character paste ID, as in https://pastefy.app/<id>. Get it from List My Pastes or Search Public Pastes.",
          "required": true
        },
        "content": {
          "label": "Content",
          "type": "multiline"
        },
        "title": {
          "label": "Title"
        },
        "password": {
          "label": "Encryption Password"
        },
        "folder_id": {
          "label": "Folder ID",
          "description": "Move the paste to this folder (ID from List Folders)."
        },
        "visibility": {
          "label": "Visibility",
          "description": "PUBLIC, UNLISTED or PRIVATE.",
          "type": "select",
          "options": [
            {
              "value": "PUBLIC",
              "label": "Public"
            },
            {
              "value": "UNLISTED",
              "label": "Unlisted"
            },
            {
              "value": "PRIVATE",
              "label": "Private"
            }
          ]
        },
        "expiry": {
          "label": "Expiry Date",
          "description": "ISO 8601 date-time in the future."
        },
        "tags": {
          "label": "Tags",
          "description": "Replaces all tags.",
          "type": "json"
        },
        "clear_tags": {
          "label": "Clear Tags",
          "description": "Remove all tags (ignored when Tags is given).",
          "type": "boolean",
          "defaultValue": "false"
        }
      },
      "request": {
        "method": "GET",
        "url": "https://{{credential.instance_url}}/api/v2/paste/{{paste_id}}"
      }
    },
    "get_folder_ai": {
      "label": "Get Folder (by ID)",
      "description": "Gets a folder by ID with its subfolders and pastes.",
      "inputs": {
        "folder_id": {
          "label": "Folder ID",
          "description": "Folder ID from List Folders.",
          "required": true
        },
        "include_contents": {
          "label": "Include Contents",
          "description": "Add pastes and subfolder contents.",
          "type": "boolean",
          "defaultValue": "true"
        }
      },
      "request": {
        "method": "GET",
        "url": "https://{{credential.instance_url}}/api/v2/folder/{{folder_id}}"
      }
    }
  },
  "triggers": {}
}
