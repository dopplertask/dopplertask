{
  "name": "promotekit",
  "label": "PromoteKit",
  "description": "Affiliate marketing platform integrated with Stripe.",
  "icon": "",
  "hosts": [
    "www.promotekit.com"
  ],
  "baseUrl": "https://www.promotekit.com/api/v1",
  "upstream": {
    "package": "@activepieces/piece-promotekit",
    "version": "0.4.3"
  },
  "credential": {
    "fields": {
      "apiKey": {
        "label": "API Key",
        "description": "To get your API key:\n1. Log in to your PromoteKit dashboard.\n2. Go to **Settings > API Keys**.\n3. Click **Create API Key**.\n4. Copy the key and paste it here.\n",
        "secret": true,
        "required": true
      }
    },
    "headers": {
      "Authorization": "Bearer {{credential.apiKey}}"
    }
  },
  "lists": {
    "campaigns": {
      "request": {
        "url": "https://www.promotekit.com/api/v1/campaigns",
        "query": {
          "page": "1",
          "limit": "100"
        }
      },
      "items": "$.data",
      "label": "$.name",
      "value": "$.id"
    },
    "affiliates": {
      "request": {
        "url": "https://www.promotekit.com/api/v1/affiliates",
        "query": {
          "page": "1",
          "limit": "100"
        }
      },
      "items": "$.data",
      "label": "$.email",
      "value": "$.id"
    }
  },
  "actions": {
    "list_affiliates": {
      "label": "List Affiliates",
      "description": "List all affiliates in your PromoteKit account.",
      "inputs": {
        "page": {
          "label": "Page",
          "description": "Page number to retrieve. Defaults to 1.",
          "type": "number",
          "defaultValue": "1"
        },
        "limit": {
          "label": "Limit",
          "description": "Number of affiliates per page (max 100). Defaults to 10.",
          "type": "number",
          "defaultValue": "10"
        }
      },
      "request": {
        "method": "GET",
        "url": "https://www.promotekit.com/api/v1/affiliates",
        "query": {
          "page": "{{page}}",
          "limit": "{{limit}}"
        }
      },
      "beforeRequest": "const v=(x,d)=>x===undefined||x===null||x===''?d:String(x); request.query = {page: v(inputs.page,'1'), limit: v(inputs.limit,'10')}; return request;",
      "afterResponse": "const f=(a)=>{const c=a.campaign,l=a.links,p=a.promo_codes;return {id:a.id,email:a.email,first_name:a.first_name,last_name:a.last_name,payout_email:a.payout_email??null,clicks:a.clicks??0,approved:a.approved??false,banned:a.banned??false,links:l?l.map(x=>`${x.url} (${x.code})`).join(', '):null,promo_codes:p?p.map(x=>x.code).join(', '):null,campaign_id:c?.id??null,campaign_name:c?.name??null,campaign_commission_type:c?.commission_type??null,campaign_commission_amount:c?.commission_amount??null,created_at:a.created_at,updated_at:a.updated_at};}; return response.data.map(f);"
    },
    "find_affiliate": {
      "label": "Find Affiliate",
      "description": "Get details of a specific affiliate by ID.",
      "inputs": {
        "affiliate_id": {
          "label": "Affiliate ID",
          "description": "The ID of the affiliate to retrieve.",
          "required": true,
          "list": "affiliates"
        }
      },
      "request": {
        "method": "GET",
        "url": "https://www.promotekit.com/api/v1/affiliates/{{affiliate_id}}"
      },
      "afterResponse": "const f=(a)=>{const c=a.campaign,l=a.links,p=a.promo_codes;return {id:a.id,email:a.email,first_name:a.first_name,last_name:a.last_name,payout_email:a.payout_email??null,clicks:a.clicks??0,approved:a.approved??false,banned:a.banned??false,links:l?l.map(x=>`${x.url} (${x.code})`).join(', '):null,promo_codes:p?p.map(x=>x.code).join(', '):null,campaign_id:c?.id??null,campaign_name:c?.name??null,campaign_commission_type:c?.commission_type??null,campaign_commission_amount:c?.commission_amount??null,created_at:a.created_at,updated_at:a.updated_at};}; return f(response.data);"
    },
    "create_affiliate": {
      "label": "Create Affiliate",
      "description": "Create a new affiliate in PromoteKit.",
      "inputs": {
        "email": {
          "label": "Email",
          "description": "The email address of the new affiliate.",
          "required": true
        },
        "first_name": {
          "label": "First Name"
        },
        "last_name": {
          "label": "Last Name"
        },
        "campaign_id": {
          "label": "Campaign",
          "description": "Select the campaign for this affiliate.",
          "list": "campaigns"
        }
      },
      "request": {
        "method": "POST",
        "url": "https://www.promotekit.com/api/v1/affiliates",
        "body": {
          "email": "{{email}}",
          "first_name": "{{first_name}}",
          "last_name": "{{last_name}}",
          "campaign_id": "{{campaign_id}}"
        }
      },
      "afterResponse": "const f=(a)=>{const c=a.campaign,l=a.links,p=a.promo_codes;return {id:a.id,email:a.email,first_name:a.first_name,last_name:a.last_name,payout_email:a.payout_email??null,clicks:a.clicks??0,approved:a.approved??false,banned:a.banned??false,links:l?l.map(x=>`${x.url} (${x.code})`).join(', '):null,promo_codes:p?p.map(x=>x.code).join(', '):null,campaign_id:c?.id??null,campaign_name:c?.name??null,campaign_commission_type:c?.commission_type??null,campaign_commission_amount:c?.commission_amount??null,created_at:a.created_at,updated_at:a.updated_at};}; return f(response.data);"
    },
    "update_affiliate": {
      "label": "Update Affiliate",
      "description": "Update an existing affiliate in PromoteKit.",
      "inputs": {
        "affiliate_id": {
          "label": "Affiliate ID",
          "description": "The ID of the affiliate to update.",
          "required": true,
          "list": "affiliates"
        },
        "first_name": {
          "label": "First Name"
        },
        "last_name": {
          "label": "Last Name"
        },
        "payout_email": {
          "label": "Payout Email",
          "description": "The email address where the affiliate receives payouts."
        },
        "approved": {
          "label": "Approved",
          "description": "Whether the affiliate is approved.",
          "type": "boolean"
        },
        "banned": {
          "label": "Banned",
          "description": "Whether the affiliate is banned.",
          "type": "boolean"
        }
      },
      "request": {
        "method": "PUT",
        "url": "https://www.promotekit.com/api/v1/affiliates/{{affiliate_id}}",
        "body": {
          "first_name": "{{first_name}}",
          "last_name": "{{last_name}}",
          "payout_email": "{{payout_email}}",
          "approved": "{{approved}}",
          "banned": "{{banned}}"
        }
      },
      "afterResponse": "const f=(a)=>{const c=a.campaign,l=a.links,p=a.promo_codes;return {id:a.id,email:a.email,first_name:a.first_name,last_name:a.last_name,payout_email:a.payout_email??null,clicks:a.clicks??0,approved:a.approved??false,banned:a.banned??false,links:l?l.map(x=>`${x.url} (${x.code})`).join(', '):null,promo_codes:p?p.map(x=>x.code).join(', '):null,campaign_id:c?.id??null,campaign_name:c?.name??null,campaign_commission_type:c?.commission_type??null,campaign_commission_amount:c?.commission_amount??null,created_at:a.created_at,updated_at:a.updated_at};}; return f(response.data);"
    },
    "list_referrals": {
      "label": "List Referrals",
      "description": "List all referrals in your PromoteKit account.",
      "inputs": {
        "page": {
          "label": "Page",
          "description": "Page number to retrieve. Defaults to 1.",
          "type": "number",
          "defaultValue": "1"
        },
        "limit": {
          "label": "Limit",
          "description": "Number of referrals per page (max 100). Defaults to 10.",
          "type": "number",
          "defaultValue": "10"
        }
      },
      "request": {
        "method": "GET",
        "url": "https://www.promotekit.com/api/v1/referrals",
        "query": {
          "page": "{{page}}",
          "limit": "{{limit}}"
        }
      },
      "beforeRequest": "const v=(x,d)=>x===undefined||x===null||x===''?d:String(x); request.query = {page: v(inputs.page,'1'), limit: v(inputs.limit,'10')}; return request;",
      "afterResponse": "const f=(r)=>{const a=r.affiliate;return {id:r.id,email:r.email,subscription_status:r.subscription_status??null,signup_date:r.signup_date??null,stripe_customer_id:r.stripe_customer_id??null,affiliate_id:a?.id??null,affiliate_email:a?.email??null,affiliate_first_name:a?.first_name??null,affiliate_last_name:a?.last_name??null,created_at:r.created_at};}; return response.data.map(f);"
    },
    "find_referral": {
      "label": "Find Referral",
      "description": "Get details of a specific referral by ID.",
      "inputs": {
        "referral_id": {
          "label": "Referral ID",
          "description": "The ID of the referral to retrieve.",
          "required": true
        }
      },
      "request": {
        "method": "GET",
        "url": "https://www.promotekit.com/api/v1/referrals/{{referral_id}}"
      },
      "afterResponse": "const f=(r)=>{const a=r.affiliate;return {id:r.id,email:r.email,subscription_status:r.subscription_status??null,signup_date:r.signup_date??null,stripe_customer_id:r.stripe_customer_id??null,affiliate_id:a?.id??null,affiliate_email:a?.email??null,affiliate_first_name:a?.first_name??null,affiliate_last_name:a?.last_name??null,created_at:r.created_at};}; return f(response.data);"
    },
    "create_referral": {
      "label": "Create Referral",
      "description": "Create a new referral in PromoteKit.",
      "inputs": {
        "email": {
          "label": "Email",
          "description": "The email address of the referred person.",
          "required": true
        },
        "affiliate_id": {
          "label": "Affiliate",
          "description": "Select the affiliate.",
          "required": true,
          "list": "affiliates"
        }
      },
      "request": {
        "method": "POST",
        "url": "https://www.promotekit.com/api/v1/referrals",
        "body": {
          "email": "{{email}}",
          "affiliate_id": "{{affiliate_id}}"
        }
      },
      "afterResponse": "const f=(r)=>{const a=r.affiliate;return {id:r.id,email:r.email,subscription_status:r.subscription_status??null,signup_date:r.signup_date??null,stripe_customer_id:r.stripe_customer_id??null,affiliate_id:a?.id??null,affiliate_email:a?.email??null,affiliate_first_name:a?.first_name??null,affiliate_last_name:a?.last_name??null,created_at:r.created_at};}; return f(response.data);"
    },
    "list_commissions": {
      "label": "List Commissions",
      "description": "List all commissions in your PromoteKit account.",
      "inputs": {
        "page": {
          "label": "Page",
          "description": "Page number to retrieve. Defaults to 1.",
          "type": "number",
          "defaultValue": "1"
        },
        "limit": {
          "label": "Limit",
          "description": "Number of commissions per page (max 100). Defaults to 10.",
          "type": "number",
          "defaultValue": "10"
        }
      },
      "request": {
        "method": "GET",
        "url": "https://www.promotekit.com/api/v1/commissions",
        "query": {
          "page": "{{page}}",
          "limit": "{{limit}}"
        }
      },
      "beforeRequest": "const v=(x,d)=>x===undefined||x===null||x===''?d:String(x); request.query = {page: v(inputs.page,'1'), limit: v(inputs.limit,'10')}; return request;",
      "afterResponse": "const f=(c)=>{const a=c.affiliate,r=c.referral,p=c.payout;return {id:c.id,revenue_amount:c.revenue_amount??null,currency:c.currency??null,commission_amount:c.commission_amount??null,payout_status:c.payout_status??null,referral_date:c.referral_date??null,stripe_payment_id:c.stripe_payment_id??null,affiliate_id:a?.id??null,affiliate_email:a?.email??null,referral_id:r?.id??null,referral_email:r?.email??null,payout_id:p?.id??null,created_at:c.created_at,updated_at:c.updated_at};}; return response.data.map(f);"
    },
    "find_commission": {
      "label": "Find Commission",
      "description": "Get details of a specific commission by ID.",
      "inputs": {
        "commission_id": {
          "label": "Commission ID",
          "description": "The ID of the commission to retrieve.",
          "required": true
        }
      },
      "request": {
        "method": "GET",
        "url": "https://www.promotekit.com/api/v1/commissions/{{commission_id}}"
      },
      "afterResponse": "const f=(c)=>{const a=c.affiliate,r=c.referral,p=c.payout;return {id:c.id,revenue_amount:c.revenue_amount??null,currency:c.currency??null,commission_amount:c.commission_amount??null,payout_status:c.payout_status??null,referral_date:c.referral_date??null,stripe_payment_id:c.stripe_payment_id??null,affiliate_id:a?.id??null,affiliate_email:a?.email??null,referral_id:r?.id??null,referral_email:r?.email??null,payout_id:p?.id??null,created_at:c.created_at,updated_at:c.updated_at};}; return f(response.data);"
    },
    "list_campaigns": {
      "label": "List Campaigns",
      "description": "List all campaigns in your PromoteKit account.",
      "request": {
        "method": "GET",
        "url": "https://www.promotekit.com/api/v1/campaigns",
        "query": {
          "limit": "100"
        }
      },
      "afterResponse": "const f=(c)=>({id:c.id,name:c.name,commission_type:c.commission_type??null,commission_amount:c.commission_amount??null}); return response.data.map(f);"
    },
    "find_campaign": {
      "label": "Find Campaign",
      "description": "Get details of a specific campaign by ID.",
      "inputs": {
        "campaign_id": {
          "label": "Campaign ID",
          "description": "The ID of the campaign to retrieve.",
          "required": true,
          "list": "campaigns"
        }
      },
      "request": {
        "method": "GET",
        "url": "https://www.promotekit.com/api/v1/campaigns/{{campaign_id}}"
      },
      "afterResponse": "const f=(c)=>({id:c.id,name:c.name,commission_type:c.commission_type??null,commission_amount:c.commission_amount??null}); return f(response.data);"
    },
    "list_payouts": {
      "label": "List Payouts",
      "description": "List all payouts in your PromoteKit account.",
      "inputs": {
        "page": {
          "label": "Page",
          "description": "Page number to retrieve. Defaults to 1.",
          "type": "number",
          "defaultValue": "1"
        },
        "limit": {
          "label": "Limit",
          "description": "Number of payouts per page (max 100). Defaults to 10.",
          "type": "number",
          "defaultValue": "10"
        }
      },
      "request": {
        "method": "GET",
        "url": "https://www.promotekit.com/api/v1/payouts",
        "query": {
          "page": "{{page}}",
          "limit": "{{limit}}"
        }
      },
      "beforeRequest": "const v=(x,d)=>x===undefined||x===null||x===''?d:String(x); request.query = {page: v(inputs.page,'1'), limit: v(inputs.limit,'10')}; return request;",
      "afterResponse": "const f=(p)=>{const a=p.affiliate;return {id:p.id,amount:p.amount??null,currency:p.currency??null,status:p.status??null,affiliate_id:a?.id??null,affiliate_email:a?.email??null,affiliate_first_name:a?.first_name??null,affiliate_last_name:a?.last_name??null,created_at:p.created_at,updated_at:p.updated_at??null};}; return response.data.map(f);"
    },
    "find_payout": {
      "label": "Find Payout",
      "description": "Get details of a specific payout by ID.",
      "inputs": {
        "payout_id": {
          "label": "Payout ID",
          "description": "The ID of the payout to retrieve.",
          "required": true
        }
      },
      "request": {
        "method": "GET",
        "url": "https://www.promotekit.com/api/v1/payouts/{{payout_id}}"
      },
      "afterResponse": "const f=(p)=>{const a=p.affiliate;return {id:p.id,amount:p.amount??null,currency:p.currency??null,status:p.status??null,affiliate_id:a?.id??null,affiliate_email:a?.email??null,affiliate_first_name:a?.first_name??null,affiliate_last_name:a?.last_name??null,created_at:p.created_at,updated_at:p.updated_at??null};}; return f(response.data);"
