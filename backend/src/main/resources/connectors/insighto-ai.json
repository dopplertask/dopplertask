{
  "name": "insighto-ai",
  "label": "Insighto.ai",
  "description": "AI-powered platform for capturing forms, conversations, and data sources with automated processing and outbound communications",
  "icon": "",
  "hosts": [
    "api.insighto.ai"
  ],
  "upstream": {
    "package": "@activepieces/piece-insighto-ai",
    "version": "0.1.8"
  },
  "credential": {
    "fields": {
      "token": {
        "label": "API Key",
        "description": "Your Insighto.ai API key",
        "secret": true,
        "required": true
      }
    },
    "query": {
      "api_key": "{{credential.token}}"
    }
  },
  "actions": {
    "upsert_contact": {
      "label": "Upsert Contact",
      "description": "Create or update a contact using email or phone number",
      "inputs": {
        "first_name": {
          "label": "First Name"
        },
        "last_name": {
          "label": "Last Name"
        },
        "email": {
          "label": "Email",
          "description": "Email address of the contact"
        },
        "phone_number": {
          "label": "Phone Number",
          "description": "Phone number including country code (e.g., 16501111234)"
        }
      },
      "request": {
        "method": "POST",
        "url": "https://api.insighto.ai/api/v1/contact/upsert",
        "query": {
          "first_name": "{{first_name}}",
          "last_name": "{{last_name}}",
          "email": "{{email}}",
          "phone_number": "{{phone_number}}"
        }
      }
    },
    "make_outbound_call": {
      "label": "Make Outbound Call",
      "description": "Initiate an outbound call to a phone number using a configured widget",
      "inputs": {
        "widget_id": {
          "label": "Widget",
          "description": "Widget connected to Twilio, Plivo, or Telnyx for making calls",
          "required": true
        },
        "to": {
          "label": "Phone Number",
          "description": "Phone number in E.164 format (e.g., 16501234567)",
          "required": true
        },
        "prompt_dynamic_variables": {
          "label": "Dynamic Variables",
          "description": "Variables for call prompts (e.g., {\"name\": \"Bob\", \"appointment\": \"tomorrow\"})",
          "type": "json"
        }
      },
      "request": {
        "method": "POST",
        "url": "https://api.insighto.ai/api/v1/call/{{widget_id}}",
        "body": {
          "to": "{{to}}"
        }
      }
    }
  },
  "triggers": {}
}
