{
  "name": "flowlu",
  "label": "Flowlu",
  "description": "Business management software",
  "icon": "",
  "upstream": {"package": "@activepieces/piece-flowlu", "version": "0.2.2"},
  "hosts": ["{{credential.domain}}.flowlu.com"],
  "baseUrl": "https://{{credential.domain}}.flowlu.com/api/v1/module",
  "credential": {
    "fields": {
      "domain": {"label": "Domain", "required": true, "description": "Your company from your account URL: for https://example.flowlu.com it is example."},
      "apiKey": {"label": "API Key", "required": true, "secret": true, "description": "Portal Settings > API Settings in Flowlu."}
    },
    "query": {"api_key": "{{credential.apiKey}}"}
  },
  "actions": {
    "flowlu_delete_contact": {
      "label": "Delete CRM Account(Contact)",
      "description": "Deletes an existing contact in CRM.",
      "inputs": {
        "id": {"label": "Contact ID", "required": true, "optionsFrom": {
          "request": {"url": "https://{{credential.domain}}.flowlu.com/api/v1/module/crm/account/list", "query": {"filter[type]": "2"}},
          "list": "$.response.items"}}
      },
      "request": {"method": "GET", "url": "https://{{credential.domain}}.flowlu.com/api/v1/module/crm/account/delete/{{id}}"}
    },
    "flowlu_delete_opportunity": {
      "label": "Delete Opportunity",
      "description": "Deletes an existing opportunity.",
      "inputs": {
        "id": {"label": "Opportunity ID", "required": true, "optionsFrom": {
          "request": {"url": "https://{{credential.domain}}.flowlu.com/api/v1/module/crm/lead/list"},
          "list": "$.response.items"}}
      },
      "request": {"method": "GET", "url": "https://{{credential.domain}}.flowlu.com/api/v1/module/crm/lead/delete/{{id}}"}
    },
    "flowlu_get_task": {
      "label": "Get Task",
      "description": "Retrieves an existing task.",
      "inputs": {
        "task_id": {"label": "Task ID", "required": true, "optionsFrom": {
          "request": {"url": "https://{{credential.domain}}.flowlu.com/api/v1/module/task/tasks/list"},
          "list": "$.response.items"}}
      },
      "request": {"method": "GET", "url": "https://{{credential.domain}}.flowlu.com/api/v1/module/task/tasks/get/{{task_id}}"}
    },
    "flowlu_delete_task": {
      "label": "Delete Task",
      "description": "Deletes an existing task.",
      "inputs": {
        "task_id": {"label": "Task ID", "required": true, "optionsFrom": {
          "request": {"url": "https://{{credential.domain}}.flowlu.com/api/v1/module/task/tasks/list"},
          "list": "$.response.items"}}
      },
      "request": {"method": "GET", "url": "https://{{credential.domain}}.flowlu.com/api/v1/module/task/tasks/delete/{{task_id}}"}
    }
  }
}
