{
  "name": "retable",
  "label": "Retable",
  "description": "Turn your spreadsheets into smart database apps",
  "icon": "",
  "hosts": [
    "api.retable.io"
  ],
  "upstream": {
    "package": "@activepieces/piece-retable",
    "version": "0.2.1"
  },
  "credential": {
    "fields": {
      "token": {
        "label": "API Key",
        "description": "\nTo obtain your API key, follow these steps:\n\n1. Go to Account Overview by clicking your profile-pic (top-right).\n2. Go to API section and enable API key.\n3. Copy API key.",
        "secret": true,
        "required": true
      }
    },
    "headers": {
      "apikey": "{{credential.token}}"
    }
  },
  "actions": {
    "retable_get_workspaces": {
      "label": "Get Workspaces",
      "description": "Gets all workspaces",
      "inputs": {},
      "request": {
        "method": "GET",
        "url": "https://api.retable.io/v1/public/workspace"
      }
    },
    "retable_get_projects": {
      "label": "Get Projects",
      "description": "Gets all projects in given workspace",
      "inputs": {
        "workspace_id": {
          "label": "Workspace",
          "required": true
        }
      },
      "request": {
        "method": "GET",
        "url": "https://api.retable.io/v1/public/workspace/{{workspace_id}}/project"
      }
    },
    "retable_get_retables": {
      "label": "Get Retables",
      "description": "Gets all retables in given project",
      "inputs": {
        "workspace_id": {
          "label": "Workspace",
          "required": true
        },
        "project_id": {
          "label": "Project",
          "required": true
        }
      },
      "request": {
        "method": "GET",
        "url": "https://api.retable.io/v1/public/project/{{project_id}}/retable"
      }
    },
    "retable_create_workspace": {
      "label": "Create a Workspace",
      "description": "Creates a workspace",
      "inputs": {
        "name": {
          "label": "Workspace Name",
          "required": true
        },
        "desc": {
          "label": "Workspace Description",
          "type": "multiline"
        }
      },
      "request": {
        "method": "POST",
        "url": "https://api.retable.io/v1/public/workspace",
        "body": {
          "name": "{{name}}",
          "description": "{{desc}}"
        }
      }
    },
    "retable_create_project": {
      "label": "Create a Project",
      "description": "Creates a project in the given workspace",
      "inputs": {
        "workspace_id": {
          "label": "Workspace",
          "required": true
        },
        "name": {
          "label": "Project Name",
          "required": true
        },
        "desc": {
          "label": "Project Description",
          "type": "multiline"
        },
        "color": {
          "label": "Project Color"
        }
      },
      "request": {
        "method": "POST",
        "url": "https://api.retable.io/v1/public/workspace/{{workspace_id}}/project",
        "body": {
          "name": "{{name}}",
          "description": "{{desc}}",
          "color": "{{color}}"
        }
      }
    }
  },
  "triggers": {}
}
