{
  "name": "raia-ai",
  "label": "raia",
  "description": "",
  "icon": "",
  "hosts": [
    "api.raia2.com"
  ],
  "upstream": {
    "package": "@activepieces/piece-raia-ai",
    "version": "0.2.1"
  },
  "credential": {
    "fields": {
      "token": {
        "label": "API Key",
        "description": "\n    1. Open your agent in raiaAI Launch Pad and go to Agent → Skills.\n    2. Add/enable “API Skill” (toggle it Active).\n    3. In the API Skill settings, click “Generate Secret Key” (your agent’s API key).",
        "secret": true,
        "required": true
      }
    },
    "headers": {
      "agent-secret-key": "{{credential.token}}"
    }
  },
  "actions": {
    "prompt-agent": {
      "label": "Prompt Agent",
      "description": "Sends a prompt to a Raia Agent.",
      "inputs": {
        "prompt": {
          "label": "Prompt",
          "required": true,
          "type": "multiline"
        }
      },
      "request": {
        "method": "POST",
        "url": "https://api.raia2.com/external/prompts",
        "body": {
          "prompt": "{{prompt}}"
        }
      }
    }
  },
  "triggers": {}
}
