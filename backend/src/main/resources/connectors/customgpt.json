{
  "name": "customgpt",
  "label": "CustomGPT",
  "description": "CustomGPT allows you to create and deploy custom AI chatbots tailored to your specific needs.",
  "icon": "",
  "hosts": [
    "app.customgpt.ai"
  ],
  "upstream": {
    "package": "@activepieces/piece-customgpt",
    "version": "0.1.8"
  },
  "credential": {
    "fields": {
      "token": {
        "label": "API Key",
        "description": "\nTo get your CustomGPT API Key:\n\n1. Log in to [CustomGPT](https://app.customgpt.ai/login)\n2. Click the circle in the top right corner of the page and select **My Profile**\n3. Select the **API** tab\n4. Click the **Create API Key** button at the bottom of the page\n5. Copy your API key and paste it below\n\nFor more details, visit the [API Keys and Authentication guide](https://docs.customgpt.ai/reference/api-keys-and-authentication).\n",
        "secret": true,
        "required": true
      }
    },
    "headers": {
      "authorization": "Bearer {{credential.token}}"
    }
  },
  "actions": {
    "createAgent": {
      "label": "Create Agent",
      "description": "Create a new CustomGPT agent by importing data from a sitemap or file",
      "inputs": {
        "project_name": {
          "label": "Project Name",
          "description": "The name for your agent/project",
          "required": true
        },
        "sitemap_path": {
          "label": "Sitemap URL",
          "description": "URL to a sitemap for importing agent knowledge (leave empty if uploading a file)"
        },
        "file": {
          "label": "File",
          "description": "Upload a file (text, audio, or video format) for agent knowledge (leave empty if using sitemap)",
          "type": "file"
        }
      },
      "request": {
        "method": "POST",
        "url": "https://app.customgpt.ai/api/v1/projects",
        "body": {
          "project_name": "{{project_name}}",
          "sitemap_path": "{{sitemap_path}}"
        }
      }
    },
    "createConversation": {
      "label": "Create Conversation",
      "description": "Create a new conversation in a CustomGPT project",
      "inputs": {
        "projectId": {
          "label": "Agent",
          "description": "Select the agent to use",
          "required": true
        },
        "name": {
          "label": "Conversation Name",
          "description": "Optional name for the conversation"
        }
      },
      "request": {
        "method": "POST",
        "url": "https://app.customgpt.ai/api/v1/projects/{{projectId}}/conversations",
        "body": {
          "name": "{{name}}"
        }
      }
    },
    "deleteAgent": {
      "label": "Delete Agent",
      "description": "Delete a CustomGPT agent",
      "inputs": {
        "projectId": {
          "label": "Agent",
          "description": "Select the agent to use",
          "required": true
        }
      },
      "request": {
        "method": "DELETE",
        "url": "https://app.customgpt.ai/api/v1/projects/{{projectId}}"
      }
    },
    "export_conversation": {
      "label": "Export Conversation",
      "description": "Export a conversation with all messages, authors, feedbacks and metadata",
      "inputs": {
        "project_id": {
          "label": "Agent",
          "description": "Select the agent to use",
          "required": true
        },
        "session_id": {
          "label": "Session ID",
          "description": "The session ID of the conversation to export",
          "required": true
        }
      },
      "request": {
        "method": "GET",
        "url": "https://app.customgpt.ai/api/v1/projects/{{project_id}}/conversations/{{session_id}}/export"
      }
    },
    "findConversation": {
      "label": "Find Conversation",
      "description": "List and search conversations for an agent with optional filtering",
      "inputs": {
        "project_id": {
          "label": "Agent",
          "description": "Select the agent to use",
          "required": true
        },
        "name": {
          "label": "Conversation Name",
          "description": "Filter conversations by name (optional)"
        },
        "userFilter": {
          "label": "User Filter",
          "description": "Filter by user who created the conversation (default: all)",
          "type": "select",
          "options": [
            {
              "value": "all",
              "label": "All Users"
            },
            {
              "value": "anonymous",
              "label": "Anonymous Users"
            },
            {
              "value": "team_member",
              "label": "Team Members"
            },
            {
              "value": "me",
              "label": "Me"
            }
          ],
          "defaultValue": "all"
        },
        "lastUpdatedAfter": {
          "label": "Last Updated After",
          "description": "Only return conversations with messages after this date (optional) e.g. 2025-01-09T18:30:00Z"
        }
      },
      "request": {
        "method": "GET",
        "url": "https://app.customgpt.ai/api/v1/projects/{{project_id}}/conversations",
        "query": {
          "order": "desc",
          "orderBy": "created_at",
          "name": "{{name}}",
          "lastUpdatedAfter": "{{lastUpdatedAfter}}"
        }
      }
    },
    "sendMessage": {
      "label": "Send Message",
      "description": "Send a message to a conversation within an agent",
      "inputs": {
        "project_id": {
          "label": "Agent",
          "description": "Select the agent to use",
          "required": true
        },
        "session_id": {
          "label": "Session ID",
          "description": "The session ID of the conversation",
          "required": true
        },
        "prompt": {
          "label": "Prompt",
          "description": "The message/question to send",
          "required": true,
          "type": "multiline"
        },
        "stream": {
          "label": "Enable Streaming",
          "description": "Stream the response in real-time (default: false)",
          "type": "boolean",
          "defaultValue": "false"
        },
        "custom_persona": {
          "label": "Custom Persona",
          "description": "Custom persona/instructions for the agent (optional)",
          "type": "multiline"
        },
        "chatbot_model": {
          "label": "Agent Model",
          "description": "AI model to use for the conversation (optional)",
          "type": "select",
          "options": [
            {
              "value": "gpt-4o",
              "label": "GPT-4o"
            },
            {
              "value": "gpt-4o-mini",
              "label": "GPT-4o Mini"
            },
            {
              "value": "gpt-4-turbo",
              "label": "GPT-4 Turbo"
            },
            {
              "value": "gpt-4",
              "label": "GPT-4"
            },
            {
              "value": "gpt-3.5-turbo",
              "label": "GPT-3.5 Turbo"
            },
            {
              "value": "claude-3-5-sonnet-20240620",
              "label": "Claude 3.5 Sonnet"
            },
            {
              "value": "claude-3-opus-20240229",
              "label": "Claude 3 Opus"
            },
            {
              "value": "claude-3-sonnet-20240229",
              "label": "Claude 3 Sonnet"
            },
            {
              "value": "claude-3-haiku-20240307",
              "label": "Claude 3 Haiku"
            },
            {
              "value": "gemini-1.5-pro",
              "label": "Gemini 1.5 Pro"
            },
            {
              "value": "gemini-1.5-flash",
              "label": "Gemini 1.5 Flash"
            },
            {
              "value": "o1-preview",
              "label": "o1-preview"
            }
          ]
        },
        "response_source": {
          "label": "Response Source",
          "description": "Source for generating responses (default: use only your content)",
          "type": "select",
          "options": [
            {
              "value": "default",
              "label": "Default (Your Content Only)"
            },
            {
              "value": "own_content",
              "label": "Own Content"
            },
            {
              "value": "openai_content",
              "label": "OpenAI Content (Can improvise)"
            }
          ],
          "defaultValue": "default"
        },
        "agent_capability": {
          "label": "Agent Capability",
          "description": "Capability mode for the agent (default: fastest-responses)",
          "type": "select",
          "options": [
            {
              "value": "fastest-responses",
              "label": "Fastest Responses"
            },
            {
              "value": "optimal-choice",
              "label": "Optimal Choice"
            },
            {
              "value": "advanced-reasoning",
              "label": "Advanced Reasoning"
            },
            {
              "value": "complex-tasks",
              "label": "Complex Tasks"
            }
          ],
          "defaultValue": "fastest-responses"
        },
        "lang": {
          "label": "Language",
          "description": "Language code for the prompt (default: en)",
          "defaultValue": "en"
        },
        "custom_context": {
          "label": "Custom Context",
          "description": "Additional context for the conversation (optional)",
          "type": "multiline"
        },
        "file": {
          "label": "File",
          "description": "File to upload with the message (Max 5MB: pdf, docx, doc, odt, txt, jpg, jpeg, png, webp)",
          "type": "file"
        }
      },
      "request": {
        "method": "POST",
        "url": "https://app.customgpt.ai/api/v1/projects/{{project_id}}/conversations/{{session_id}}/messages",
        "query": {
          "stream": "false",
          "lang": "{{lang}}"
        },
        "body": {
          "prompt": "{{prompt}}",
          "custom_persona": "{{custom_persona}}",
          "custom_context": "{{custom_context}}"
        }
      }
    }
  },
  "triggers": {}
}
