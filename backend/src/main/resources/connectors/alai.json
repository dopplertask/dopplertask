{
  "name": "alai",
  "label": "Alai",
  "description": "AI-powered presentation generation API. Create, export, and manage professional presentations from text.",
  "icon": "",
  "hosts": [
    "slides-api.getalai.com"
  ],
  "upstream": {
    "package": "@activepieces/piece-alai",
    "version": "0.3.2"
  },
  "credential": {
    "fields": {
      "apiKey": {
        "label": "API Key",
        "description": "Your Alai API key.",
        "secret": true,
        "required": true
      }
    },
    "headers": {
      "authorization": "Bearer {{credential.apiKey}}"
    }
  },
  "actions": {
    "generate_presentation_ai": {
      "label": "Generate Presentation (Agent)",
      "description": "Start generating a new presentation from text.",
      "inputs": {
        "inputText": {
          "label": "Input Text",
          "description": "The content to turn into slides (plain text or markdown).",
          "required": true,
          "type": "multiline"
        },
        "title": {
          "label": "Title",
          "description": "Presentation title."
        },
        "additionalInstructions": {
          "label": "Additional Instructions",
          "description": "Extra guidance on style or focus.",
          "type": "multiline"
        },
        "slideRange": {
          "label": "Slide Range",
          "description": "Target slide count. \"auto\" decides from the input.",
          "type": "select",
          "options": [
            {
              "value": "auto",
              "label": "auto"
            },
            {
              "value": "1",
              "label": "1"
            },
            {
              "value": "2-5",
              "label": "2-5"
            },
            {
              "value": "6-10",
              "label": "6-10"
            },
            {
              "value": "11-15",
              "label": "11-15"
            },
            {
              "value": "16-20",
              "label": "16-20"
            },
            {
              "value": "21-25",
              "label": "21-25"
            },
            {
              "value": "26-50",
              "label": "26-50"
            }
          ]
        },
        "tone": {
          "label": "Tone",
          "description": "Tone of voice.",
          "type": "select",
          "options": [
            {
              "value": "DEFAULT",
              "label": "DEFAULT"
            },
            {
              "value": "PROFESSIONAL",
              "label": "PROFESSIONAL"
            },
            {
              "value": "CASUAL",
              "label": "CASUAL"
            },
            {
              "value": "TECHNICAL",
              "label": "TECHNICAL"
            },
            {
              "value": "EDUCATIONAL",
              "label": "EDUCATIONAL"
            },
            {
              "value": "INSPIRATIONAL",
              "label": "INSPIRATIONAL"
            },
            {
              "value": "NARRATIVE",
              "label": "NARRATIVE"
            },
            {
              "value": "PERSUASIVE",
              "label": "PERSUASIVE"
            },
            {
              "value": "AUTHORITATIVE",
              "label": "AUTHORITATIVE"
            },
            {
              "value": "EMPATHETIC",
              "label": "EMPATHETIC"
            }
          ]
        },
        "contentMode": {
          "label": "Content Mode",
          "description": "Keep, condense or enhance the input text.",
          "type": "select",
          "options": [
            {
              "value": "PRESERVE",
              "label": "PRESERVE"
            },
            {
              "value": "CONDENSE",
              "label": "CONDENSE"
            },
            {
              "value": "ENHANCE",
              "label": "ENHANCE"
            },
            {
              "value": "CUSTOM",
              "label": "CUSTOM"
            }
          ]
        },
        "amountMode": {
          "label": "Text Density",
          "description": "How much text per slide.",
          "type": "select",
          "options": [
            {
              "value": "MINIMAL",
              "label": "MINIMAL"
            },
            {
              "value": "ESSENTIAL",
              "label": "ESSENTIAL"
            },
            {
              "value": "BALANCED",
              "label": "BALANCED"
            },
            {
              "value": "DETAILED",
              "label": "DETAILED"
            }
          ]
        },
        "themeId": {
          "label": "Theme ID",
          "description": "Theme ID from List Themes."
        },
        "vibeId": {
          "label": "Vibe ID",
          "description": "Vibe ID from List Vibes."
        },
        "language": {
          "label": "Language",
          "description": "Output language; empty matches the input.",
          "type": "select",
          "options": [
            {
              "value": "English (US)",
              "label": "English (US)"
            },
            {
              "value": "English (UK)",
              "label": "English (UK)"
            },
            {
              "value": "Spanish (Latin America)",
              "label": "Spanish (Latin America)"
            },
            {
              "value": "Spanish (Mexico)",
              "label": "Spanish (Mexico)"
            },
            {
              "value": "Spanish (Spain)",
              "label": "Spanish (Spain)"
            },
            {
              "value": "French",
              "label": "French"
            },
            {
              "value": "German",
              "label": "German"
            },
            {
              "value": "Italian",
              "label": "Italian"
            },
            {
              "value": "Portuguese (Brazil)",
              "label": "Portuguese (Brazil)"
            },
            {
              "value": "Portuguese (Portugal)",
              "label": "Portuguese (Portugal)"
            },
            {
              "value": "Dutch",
              "label": "Dutch"
            },
            {
              "value": "Polish",
              "label": "Polish"
            },
            {
              "value": "Russian",
              "label": "Russian"
            },
            {
              "value": "Japanese",
              "label": "Japanese"
            },
            {
              "value": "Korean",
              "label": "Korean"
            },
            {
              "value": "Chinese (Simplified)",
              "label": "Chinese (Simplified)"
            },
            {
              "value": "Hindi",
              "label": "Hindi"
            },
            {
              "value": "Swedish",
              "label": "Swedish"
            },
            {
              "value": "Norwegian",
              "label": "Norwegian"
            },
            {
              "value": "Danish",
              "label": "Danish"
            },
            {
              "value": "Finnish",
              "label": "Finnish"
            },
            {
              "value": "Greek",
              "label": "Greek"
            },
            {
              "value": "Turkish",
              "label": "Turkish"
            },
            {
              "value": "Czech",
              "label": "Czech"
            },
            {
              "value": "Hungarian",
              "label": "Hungarian"
            },
            {
              "value": "Romanian",
              "label": "Romanian"
            },
            {
              "value": "Bulgarian",
              "label": "Bulgarian"
            },
            {
              "value": "Ukrainian",
              "label": "Ukrainian"
            },
            {
              "value": "Vietnamese",
              "label": "Vietnamese"
            },
            {
              "value": "Thai",
              "label": "Thai"
            },
            {
              "value": "Indonesian",
              "label": "Indonesian"
            },
            {
              "value": "Serbian",
              "label": "Serbian"
            },
            {
              "value": "Croatian",
              "label": "Croatian"
            },
            {
              "value": "Bosnian",
              "label": "Bosnian"
            },
            {
              "value": "Slovenian",
              "label": "Slovenian"
            },
            {
              "value": "Macedonian",
              "label": "Macedonian"
            },
            {
              "value": "Albanian",
              "label": "Albanian"
            },
            {
              "value": "Montenegrin",
              "label": "Montenegrin"
            },
            {
              "value": "Lithuanian",
              "label": "Lithuanian"
            }
          ]
        },
        "imageIds": {
          "label": "Image IDs",
          "description": "Image IDs uploaded to Alai earlier.",
          "type": "json"
        }
      },
      "request": {
        "method": "POST",
        "url": "https://slides-api.getalai.com/api/v1/generations",
        "body": {
          "input_text": "{{inputText}}",
          "export_formats": [
            "link"
          ],
          "additional_instructions": "{{additionalInstructions}}",
          "presentation_options": {
            "title": "{{title}}",
            "theme_id": "{{themeId}}",
            "vibe_id": "{{vibeId}}"
          }
        }
      }
    },
    "add_slide_ai": {
      "label": "Add Slide (Agent)",
      "description": "Start generating a new slide in an existing presentation.",
      "inputs": {
        "presentationId": {
          "label": "Presentation ID",
          "description": "The presentation ID, e.g. from List Presentations or the presentation_id of Get Generation.",
          "required": true
        },
        "slideContext": {
          "label": "Slide Content",
          "description": "What the slide should contain.",
          "required": true,
          "type": "multiline"
        },
        "slideOrder": {
          "label": "Slide Position",
          "description": "0-based position; omit to append at the end.",
          "type": "number"
        },
        "slideType": {
          "label": "Slide Type",
          "description": "classic (editable text) or creative (image-led).",
          "type": "select",
          "options": [
            {
              "value": "classic",
              "label": "classic"
            },
            {
              "value": "creative",
              "label": "creative"
            }
          ]
        },
        "includeAiImages": {
          "label": "Include Images",
          "description": "false asks Alai for a slide without images.",
          "type": "boolean",
          "defaultValue": "true"
        },
        "additionalInstructions": {
          "label": "Additional Instructions",
          "description": "Extra guidance for this slide.",
          "type": "multiline"
        }
      },
      "request": {
        "method": "POST",
        "url": "https://slides-api.getalai.com/api/v1/presentations/{{presentationId}}/slides",
        "body": {
          "slide_context": "{{slideContext}}",
          "options": {
            "additional_instructions": "{{additionalInstructions}}",
            "slide_order": "{{slideOrder}}"
          },
          "export_formats": [
            "link"
          ]
        }
      }
    },
    "generate_speaker_notes_ai": {
      "label": "Generate Speaker Notes (Agent)",
      "description": "Start generating speaker notes for a presentation.",
      "inputs": {
        "presentationId": {
          "label": "Presentation ID",
          "description": "The presentation ID, e.g. from List Presentations or the presentation_id of Get Generation.",
          "required": true
        },
        "slideIds": {
          "label": "Slide IDs",
          "description": "Only these slides; omit for all slides.",
          "type": "json"
        }
      },
      "request": {
        "method": "POST",
        "url": "https://slides-api.getalai.com/api/v1/presentations/{{presentationId}}/transcripts",
        "body": {}
      }
    },
    "getGeneration": {
      "label": "Get Generation",
      "description": "Get the status and result of a generation, slide, export or speaker-notes job.",
      "inputs": {
        "generationId": {
          "label": "Generation ID",
          "description": "The generation_id returned by another Alai action.",
          "required": true
        }
      },
      "request": {
        "method": "GET",
        "url": "https://slides-api.getalai.com/api/v1/generations/{{generationId}}"
      }
    },
    "listPresentations": {
      "label": "List Presentations",
      "description": "List your presentations, newest first, optionally filtered by title.",
      "inputs": {
        "titleContains": {
          "label": "Title Contains",
          "description": "Only titles containing this text (not case-sensitive)."
        },
        "limit": {
          "label": "Limit",
          "description": "Maximum number of presentations to return (default 100).",
          "type": "number",
          "defaultValue": "100"
        }
      },
      "request": {
        "method": "GET",
        "url": "https://slides-api.getalai.com/api/v1/presentations"
      }
    },
    "listThemes": {
      "label": "List Themes",
      "description": "List the themes you can use when generating a presentation.",
      "inputs": {},
      "request": {
        "method": "GET",
        "url": "https://slides-api.getalai.com/api/v1/themes"
      }
    },
    "listVibes": {
      "label": "List Vibes",
      "description": "List the vibes (visual styles) you can use when generating a presentation.",
      "inputs": {},
      "request": {
        "method": "GET",
        "url": "https://slides-api.getalai.com/api/v1/vibes"
      }
    },
    "generateSpeakerNotes": {
      "label": "Generate Speaker Notes",
      "description": "Generate speaker notes for the slides of a presentation.",
      "inputs": {
        "presentationId": {
          "label": "Presentation ID",
          "description": "The presentation to write speaker notes for. Use \"List Presentations\" or the presentation_id from \"Generate Presentation\".",
          "required": true
        },
        "slideIds": {
          "label": "Slide IDs",
          "description": "Only these slides. Leave empty for all slides.",
          "type": "json"
        },
        "waitForCompletion": {
          "label": "Wait for Completion",
          "description": "Wait until Alai finishes. If off, use \"Get Generation\" with the returned ID later.",
          "type": "boolean",
          "defaultValue": "false"
        },
        "maxWaitTime": {
          "label": "Max Wait Time (seconds)",
          "description": "How long to wait when waiting is on. Default 300, capped at 480.",
          "type": "number",
          "defaultValue": "300"
        }
      },
      "request": {
        "method": "POST",
        "url": "https://slides-api.getalai.com/api/v1/presentations/{{presentationId}}/transcripts",
        "body": {}
      }
    }
  },
  "triggers": {}
}
