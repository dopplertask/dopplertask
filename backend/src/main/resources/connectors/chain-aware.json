{
  "name": "chain-aware",
  "label": "ChainAware.AI",
  "description": "Detect risky wallet behavior",
  "icon": "",
  "hosts": [
    "enterprise.api.chainaware.ai"
  ],
  "upstream": {
    "package": "@activepieces/piece-chain-aware",
    "version": "0.1.1"
  },
  "credential": {
    "fields": {
      "token": {
        "label": "API Key",
        "description": "Enter your ChainAware API key.",
        "secret": true,
        "required": true
      }
    },
    "headers": {
      "x-api-key": "{{credential.token}}"
    }
  },
  "actions": {
    "auditWalletAddress": {
      "label": "Audit Wallet Address",
      "description": "Audit a wallet address for fraud risk",
      "inputs": {
        "network": {
          "label": "Network",
          "required": true
        },
        "walletAddress": {
          "label": "Wallet Address",
          "required": true
        }
      },
      "request": {
        "method": "POST",
        "url": "https://enterprise.api.chainaware.ai/fraud/audit",
        "body": {
          "network": "{{network}}",
          "walletAddress": "{{walletAddress}}"
        }
      }
    },
    "creditScore": {
      "label": "Credit Score",
      "description": "Get a user's credit score",
      "inputs": {
        "network": {
          "label": "Network",
          "required": true
        },
        "walletAddress": {
          "label": "Wallet Address",
          "required": true
        }
      },
      "request": {
        "method": "POST",
        "url": "https://enterprise.api.chainaware.ai/users/credit-score",
        "body": {
          "network": "{{network}}",
          "walletAddress": "{{walletAddress}}"
        }
      }
    },
    "fraudCheck": {
      "label": "Fraud Check",
      "description": "Calculate fraud probability for a wallet address",
      "inputs": {
        "network": {
          "label": "Network",
          "required": true
        },
        "walletAddress": {
          "label": "Wallet Address",
          "required": true
        },
        "onlyFraud": {
          "label": "Only Fraud",
          "type": "boolean",
          "defaultValue": "false"
        }
      },
      "request": {
        "method": "POST",
        "url": "https://enterprise.api.chainaware.ai/fraud/check",
        "body": {
          "network": "{{network}}",
          "walletAddress": "{{walletAddress}}",
          "onlyFraud": false
        }
      }
    },
    "rugPullCheck": {
      "label": "Rug Pull Check",
      "description": "Calculate fraud probability for a contract address",
      "inputs": {
        "network": {
          "label": "Network",
          "required": true
        },
        "contractAddress": {
          "label": "Contract Address",
          "required": true
        }
      },
      "request": {
        "method": "POST",
        "url": "https://enterprise.api.chainaware.ai/rug/pull-check",
        "body": {
          "network": "{{network}}",
          "contractAddress": "{{contractAddress}}"
        }
      }
    },
    "walletSegment": {
      "label": "Wallet Segment",
      "description": "Get wallet behaviour information",
      "inputs": {
        "network": {
          "label": "Network",
          "required": true
        },
        "walletAddress": {
          "label": "Wallet Address",
          "required": true
        }
      },
      "request": {
        "method": "POST",
        "url": "https://enterprise.api.chainaware.ai/segmentation/wallet-segment",
        "body": {
          "walletAddress": "{{walletAddress}}",
          "network": "{{network}}"
        }
      }
    }
  },
  "triggers": {}
}
