{
  "name": "predis-ai",
  "label": "Predis.ai",
  "description": "AI-powered social media content creation platform. Generate posts, videos, carousels, images, quotes, and memes with automated creation and webhook notifications.",
  "icon": "",
  "hosts": [
    "brain.predis.ai"
  ],
  "upstream": {
    "package": "@activepieces/piece-predis-ai",
    "version": "0.0.8"
  },
  "credential": {
    "fields": {
      "token": {
        "label": "API Key",
        "description": "In Predis.ai, go to Pricing & Account -> Rest API to generate an API key.",
        "secret": true,
        "required": true
      }
    },
    "headers": {
      "authorization": "{{credential.token}}"
    }
  },
  "actions": {
    "create_content": {
      "label": "Create Content",
      "description": "Generate posts including videos, carousels, images, quotes, and memes.",
      "inputs": {
        "brand_id": {
          "label": "Brand ID",
          "description": "Unique identifier of your brand. Find it in Predis.ai under your brand settings.",
          "required": true
        },
        "text": {
          "label": "Topic",
          "description": "The topic for your post. Must be at least 20 characters and 3 words.",
          "required": true,
          "type": "multiline"
        },
        "model_version": {
          "label": "Model Version",
          "description": "Version 4 offers higher quality but only supports single_image and carousel.",
          "type": "select",
          "options": [
            {
              "value": "4",
              "label": "Version 4 (Higher Quality, supports single_image & carousel)"
            },
            {
              "value": "2",
              "label": "Version 2 (Supports all media types)"
            }
          ],
          "defaultValue": "4"
        },
        "media_type": {
          "label": "Media Type",
          "description": "Type of media to generate. Video is only supported by model version 2.",
          "type": "select",
          "options": [
            {
              "value": "single_image",
              "label": "Single Image"
            },
            {
              "value": "carousel",
              "label": "Carousel"
            },
            {
              "value": "video",
              "label": "Video"
            }
          ],
          "defaultValue": "single_image"
        },
        "post_type": {
          "label": "Post Type",
          "description": "Type of post to generate. Only supported by model version 2.",
          "type": "select",
          "options": [
            {
              "value": "generic",
              "label": "Generic"
            },
            {
              "value": "meme",
              "label": "Meme"
            },
            {
              "value": "quotes",
              "label": "Quotes"
            }
          ],
          "defaultValue": "generic"
        },
        "n_posts": {
          "label": "Number of Posts",
          "description": "Number of posts to generate (1-10).",
          "type": "number",
          "defaultValue": "1"
        },
        "input_language": {
          "label": "Input Language",
          "description": "Language of your input text.",
          "type": "select",
          "options": [
            {
              "value": "english",
              "label": "English"
            },
            {
              "value": "malay",
              "label": "Malay"
            },
            {
              "value": "chinese (traditional)",
              "label": "Chinese (Traditional)"
            },
            {
              "value": "croatian",
              "label": "Croatian"
            },
            {
              "value": "dutch",
              "label": "Dutch"
            },
            {
              "value": "indonesian",
              "label": "Indonesian"
            },
            {
              "value": "vietnamese",
              "label": "Vietnamese"
            },
            {
              "value": "portuguese_br",
              "label": "Portuguese (BR)"
            },
            {
              "value": "finnish",
              "label": "Finnish"
            },
            {
              "value": "french",
              "label": "French"
            },
            {
              "value": "german",
              "label": "German"
            },
            {
              "value": "italian",
              "label": "Italian"
            },
            {
              "value": "norwegian",
              "label": "Norwegian"
            },
            {
              "value": "polish",
              "label": "Polish"
            },
            {
              "value": "romanian",
              "label": "Romanian"
            },
            {
              "value": "czech",
              "label": "Czech"
            },
            {
              "value": "spanish",
              "label": "Spanish"
            },
            {
              "value": "swedish",
              "label": "Swedish"
            },
            {
              "value": "turkish",
              "label": "Turkish"
            },
            {
              "value": "danish",
              "label": "Danish"
            },
            {
              "value": "hungarian",
              "label": "Hungarian"
            }
          ],
          "defaultValue": "english"
        },
        "output_language": {
          "label": "Output Language",
          "description": "Language for the generated post.",
          "type": "select",
          "options": [
            {
              "value": "english",
              "label": "English"
            },
            {
              "value": "malay",
              "label": "Malay"
            },
            {
              "value": "chinese (traditional)",
              "label": "Chinese (Traditional)"
            },
            {
              "value": "croatian",
              "label": "Croatian"
            },
            {
              "value": "dutch",
              "label": "Dutch"
            },
            {
              "value": "indonesian",
              "label": "Indonesian"
            },
            {
              "value": "vietnamese",
              "label": "Vietnamese"
            },
            {
              "value": "portuguese_br",
              "label": "Portuguese (BR)"
            },
            {
              "value": "finnish",
              "label": "Finnish"
            },
            {
              "value": "french",
              "label": "French"
            },
            {
              "value": "german",
              "label": "German"
            },
            {
              "value": "italian",
              "label": "Italian"
            },
            {
              "value": "norwegian",
              "label": "Norwegian"
            },
            {
              "value": "polish",
              "label": "Polish"
            },
            {
              "value": "romanian",
              "label": "Romanian"
            },
            {
              "value": "czech",
              "label": "Czech"
            },
            {
              "value": "spanish",
              "label": "Spanish"
            },
            {
              "value": "swedish",
              "label": "Swedish"
            },
            {
              "value": "turkish",
              "label": "Turkish"
            },
            {
              "value": "danish",
              "label": "Danish"
            },
            {
              "value": "hungarian",
              "label": "Hungarian"
            }
          ],
          "defaultValue": "english"
        },
        "video_duration": {
          "label": "Video Duration",
          "description": "Required when media type is video.",
          "type": "select",
          "options": [
            {
              "value": "short",
              "label": "Short"
            },
            {
              "value": "long",
              "label": "Long"
            }
          ]
        },
        "color_palette_type": {
          "label": "Color Palette",
          "description": "Color palette for generated content.",
          "type": "select",
          "options": [
            {
              "value": "ai_suggested",
              "label": "AI Suggested"
            },
            {
              "value": "brand",
              "label": "Brand"
            }
          ],
          "defaultValue": "ai_suggested"
        },
        "author": {
          "label": "Author",
          "description": "Author name. Required when post type is quotes."
        },
        "template_ids": {
          "label": "Template IDs",
          "description": "List of template IDs to use. Only supported by model version 2.",
          "type": "json"
        },
        "media_urls": {
          "label": "Media URLs",
          "description": "List of image/video URLs to use in your post. Only supported by model version 2.",
          "type": "json"
        }
      },
      "request": {
        "method": "POST",
        "url": "https://brain.predis.ai/predis_api/v1/create_content/",
        "body": {
          "brand_id": "{{brand_id}}",
          "text": "{{text}}",
          "n_posts": "{{n_posts}}",
          "author": "{{author}}"
        }
      }
    }
  },
  "triggers": {}
}
