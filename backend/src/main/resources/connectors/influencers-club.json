{
  "name": "influencers-club",
  "label": "Influencers.club",
  "description": "Connect to Influencers.club to enrich and find influencers for your marketing campaigns.",
  "icon": "",
  "hosts": [
    "api-dashboard.influencers.club"
  ],
  "upstream": {
    "package": "@activepieces/piece-influencers-club",
    "version": "0.1.1"
  },
  "credential": {
    "fields": {
      "token": {
        "label": "Influencers Club API Key",
        "description": "API Key for Influencers Club",
        "secret": true,
        "required": true
      }
    },
    "headers": {
      "authorization": "Bearer {{credential.token}}"
    }
  },
  "actions": {
    "enrichCreatorByEmail": {
      "label": "Enrich Creator by Email",
      "description": "Enrich creator data by email address with advanced mode including all social medias and full profile stats",
      "inputs": {
        "email": {
          "label": "Email",
          "description": "The email address of the creator to enrich",
          "required": true
        },
        "exclude_platforms": {
          "label": "Exclude Platforms",
          "description": "Platforms to exclude from enrichment (optional)",
          "type": "json",
          "options": [
            {
              "value": "instagram",
              "label": "Instagram"
            },
            {
              "value": "tiktok",
              "label": "TikTok"
            },
            {
              "value": "youtube",
              "label": "YouTube"
            },
            {
              "value": "twitter",
              "label": "Twitter"
            },
            {
              "value": "twitch",
              "label": "Twitch"
            },
            {
              "value": "onlyfans",
              "label": "OnlyFans"
            },
            {
              "value": "linkedin",
              "label": "LinkedIn"
            },
            {
              "value": "facebook",
              "label": "Facebook"
            },
            {
              "value": "snapchat",
              "label": "Snapchat"
            },
            {
              "value": "reddit",
              "label": "Reddit"
            },
            {
              "value": "pinterest",
              "label": "Pinterest"
            },
            {
              "value": "discord",
              "label": "Discord"
            }
          ]
        },
        "min_followers": {
          "label": "Minimum Followers",
          "description": "Minimum follower count filter (default: 1000)",
          "type": "number",
          "defaultValue": "1000"
        }
      },
      "request": {
        "method": "POST",
        "url": "https://api-dashboard.influencers.club/public/v1/creators/enrich/email/advanced",
        "body": {
          "email": "{{email}}",
          "min_followers": "{{min_followers}}"
        }
      }
    }
  },
  "triggers": {}
}
