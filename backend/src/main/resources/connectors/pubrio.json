          "linkedin_urls": "{{linkedin_urls}}",
          "locations": "{{locations}}",
          "exclude_locations": "{{exclude_locations}}",
          "places": "{{places}}",
          "exclude_places": "{{exclude_places}}",
          "keywords": "{{keywords}}",
          "verticals": "{{verticals}}",
          "vertical_categories": "{{vertical_categories}}",
          "vertical_sub_categories": "{{vertical_sub_categories}}",
          "technologies": "{{technologies}}",
          "categories": "{{categories}}",
          "companies": "{{companies}}",
          "is_enable_similarity_search": "{{is_enable_similarity_search}}",
          "similarity_score": "{{similarity_score}}",
          "exclude_fields": "{{exclude_fields}}",
          "job_titles": "{{job_titles}}",
          "job_locations": "{{job_locations}}",
          "job_exclude_locations": "{{job_exclude_locations}}",
          "job_posted_dates": "{{job_posted_dates}}",
          "news_categories": "{{news_categories}}",
          "news_published_dates": "{{news_published_dates}}",
          "news_galleries": "{{news_galleries}}",
          "news_gallery_ids": "{{news_gallery_ids}}",
          "advertisement_search_terms": "{{advertisement_search_terms}}",
          "advertisement_target_locations": "{{advertisement_target_locations}}",
          "advertisement_exclude_target_locations": "{{advertisement_exclude_target_locations}}",
          "advertisement_start_dates": "{{advertisement_start_dates}}",
          "advertisement_end_dates": "{{advertisement_end_dates}}",
          "page": "{{page}}",
          "per_page": "{{per_page}}"
        }
      },
      "beforeRequest": "function has(name) { return inputs[name] != null && inputs[name] !== ''; }\nfunction range(key, min, max, low, high) { if (has(min) || has(max)) request.body[key] = [has(min) ? Number(inputs[min]) : low, has(max) ? Number(inputs[max]) : high]; }\nrange('employees', 'employees_min', 'employees_max', 1, 1000000);\nrange('revenues', 'revenue_min', 'revenue_max', 0, 999999999);\nrange('founded_dates', 'founded_year_start', 'founded_year_end', 1800, new Date().getFullYear());\nObject.keys(request.body).forEach(function (key) { if (request.body[key] === false) delete request.body[key]; });\nif (request.body.page == null) request.body.page = 1;\nif (request.body.per_page == null) request.body.per_page = 25;\nreturn request;"
    },
    "lookup_company": {
      "label": "Lookup Company",
      "description": "Look up detailed company information by domain or LinkedIn URL",
      "inputs": {
        "lookup_type": {
          "label": "Lookup Type",
          "type": "select",
          "required": true,
          "options": [
            {
              "value": "domain",
              "label": "Domain"
            },
            {
              "value": "linkedin_url",
              "label": "LinkedIn URL"
            },
            {
              "value": "domain_search_id",
              "label": "Domain Search ID"
            },
            {
              "value": "domain_id",
              "label": "Domain ID"
            }
          ]
        },
        "value": {
          "label": "Value",
          "description": "Domain, LinkedIn URL, Domain Search ID, or Domain ID (integer)",
          "required": true
        }
      },
      "request": {
        "method": "POST",
        "url": "https://api.pubrio.com/companies/lookup"
      },
      "beforeRequest": "var value = inputs.value;\nif (inputs.lookup_type === 'domain_id') { value = parseInt(value, 10); if (isNaN(value)) throw new Error('domain_id must be a valid integer, got: \"' + inputs.value + '\"'); }\nrequest.body = {}; request.body[inputs.lookup_type] = value;\nreturn request;"
    },
