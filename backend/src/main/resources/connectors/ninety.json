{
  "name": "ninety",
  "label": "Ninety",
  "description": "Run the EOS operating system in Ninety: to-dos, issues, rocks, milestones and the scorecard",
  "icon": "",
  "hosts": [
    "api.public.ninety.io"
  ],
  "baseUrl": "https://api.public.ninety.io/v1",
  "upstream": {
    "package": "@activepieces/piece-ninety",
    "version": "0.1.2"
  },
  "credential": {
    "fields": {
      "token": {
        "label": "Personal Access Token",
        "description": "Generate a token in Ninety under **Settings > Developer Settings**.\n\nThe public API is part of Ninety's Thrive plan, and the token carries its owner's permissions — every step only ever sees the teams and records that user can see.",
        "secret": true,
        "required": true
      }
    },
    "headers": {
      "Authorization": "Bearer {{credential.token}}"
    }
  },
  "actions": {
    "create_todo": {
      "label": "Create To-Do",
      "description": "Add a to-do to a Ninety team or to your personal list",
      "inputs": {
        "title": {
          "label": "Title",
          "description": "What needs doing",
          "required": true
        },
        "teamId": {
          "label": "Team",
          "description": "Leave empty to create a personal to-do instead of a team one",
          "optionsFrom": {
            "request": {
              "url": "https://api.public.ninety.io/v1/teams"
            },
            "list": "$",
            "label": "$.name",
            "value": "$._id"
          }
        },
        "userId": {
          "label": "Owner",
          "description": "Defaults to the token owner when left empty",
          "optionsFrom": {
            "request": {
              "url": "https://api.public.ninety.io/v1/users"
            },
            "list": "$",
            "label": "$.primaryEmail",
            "value": "$.id"
          }
        },
        "dueDate": {
          "label": "Due Date",
          "description": "Ninety stores a to-do due date as a day, so the time is dropped"
        },
        "description": {
          "label": "Description",
          "type": "multiline"
        },
        "repeat": {
          "label": "Repeat",
          "description": "A Ninety recurrence pattern such as weekly or monthly. Leave empty for a one-off to-do."
        }
      },
      "request": {
        "method": "POST",
        "url": "https://api.public.ninety.io/v1/todos",
        "body": {
          "title": "{{title}}",
          "teamId": "{{teamId}}",
          "userId": "{{userId}}",
          "description": "{{description}}",
          "repeat": "{{repeat}}",
          "dueDate": "{{dueDate}}"
        }
      },
      "beforeRequest": "const b = request.body; if (b.dueDate !== undefined) b.dueDate = /^\\d{4}-\\d{2}-\\d{2}$/.test(b.dueDate.trim()) ? b.dueDate.trim() : new Date(b.dueDate.trim()).toISOString().slice(0, 10); return request;",
      "audience": "both"
    },
    "update_todo": {
      "label": "Update To-Do",
      "description": "Change a to-do, or mark it complete or archived",
      "inputs": {
        "todoId": {
          "label": "To-Do ID",
          "description": "The id of the to-do to update",
          "required": true
        },
        "title": {
          "label": "Title"
        },
        "description": {
          "label": "Description",
          "type": "multiline"
        },
        "dueDate": {
          "label": "Due Date",
          "description": "Ninety stores a to-do due date as a day, so the time is dropped"
        },
        "teamId": {
          "label": "Team",
          "description": "Move the record to this team. Leave empty to keep it where it is.",
          "optionsFrom": {
            "request": {
              "url": "https://api.public.ninety.io/v1/teams"
            },
            "list": "$",
            "label": "$.name",
            "value": "$._id"
          }
        },
        "userId": {
          "label": "Owner",
          "description": "Hand the record to this person. Leave empty to keep the current owner.",
          "optionsFrom": {
            "request": {
              "url": "https://api.public.ninety.io/v1/users"
            },
            "list": "$",
            "label": "$.primaryEmail",
            "value": "$.id"
          }
        },
        "completed": {
          "label": "Completed",
          "type": "select",
          "description": "Marking this Yes is how a record is finished in Ninety",
          "options": [
            {
              "value": "any",
              "label": "Leave unchanged"
            },
            {
              "value": "yes",
              "label": "Yes"
            },
            {
              "value": "no",
              "label": "No"
            }
          ]
        },
        "archived": {
          "label": "Archived",
          "type": "select",
          "description": "Archiving takes the record off the active list",
          "options": [
            {
              "value": "any",
              "label": "Leave unchanged"
            },
            {
              "value": "yes",
              "label": "Yes"
            },
            {
              "value": "no",
              "label": "No"
            }
          ]
        },
        "repeat": {
          "label": "Repeat",
          "description": "A Ninety recurrence pattern such as weekly or monthly"
        }
      },
      "request": {
        "method": "PATCH",
        "url": "https://api.public.ninety.io/v1/todos/{{todoId}}",
        "body": {
          "title": "{{title}}",
          "description": "{{description}}",
          "teamId": "{{teamId}}",
          "userId": "{{userId}}",
          "repeat": "{{repeat}}",
          "completed": "{{completed}}",
          "archived": "{{archived}}",
          "dueDate": "{{dueDate}}"
        }
      },
      "beforeRequest": "const b = request.body; const tri = (v) => v === 'yes' ? true : v === 'no' ? false : undefined; const set = (k, v) => { if (v === undefined) delete b[k]; else b[k] = v; }; set('completed', tri(b.completed)); set('archived', tri(b.archived)); if (b.dueDate !== undefined) b.dueDate = /^\\d{4}-\\d{2}-\\d{2}$/.test(b.dueDate.trim()) ? b.dueDate.trim() : new Date(b.dueDate.trim()).toISOString().slice(0, 10); return request;",
      "audience": "both"
    },
    "find_todos": {
      "label": "Find To-Dos",
      "description": "Search Ninety to-dos by team, owner, status, text or due date",
      "inputs": {
        "teamId": {
          "label": "Team",
          "description": "Leave empty to cover every team the token can see",
          "optionsFrom": {
            "request": {
              "url": "https://api.public.ninety.io/v1/teams"
            },
            "list": "$",
            "label": "$.name",
            "value": "$._id"
          }
        },
        "scope": {
          "label": "Scope",
          "type": "select",
          "description": "Ninety cannot return personal and team to-dos in one call. Leave empty to let Ninety apply its own default.",
          "options": [
            {
              "value": "team",
              "label": "Team to-dos"
            },
            {
              "value": "personal",
              "label": "Personal to-dos"
            }
          ]
        },
        "userIds": {
          "label": "Owners",
          "description": "Only return records owned by these people",
          "optionsFrom": {
            "request": {
              "url": "https://api.public.ninety.io/v1/users"
            },
            "list": "$",
            "label": "$.primaryEmail",
            "value": "$.id"
          },
          "type": "json"
        },
        "completed": {
          "label": "Completed",
          "type": "select",
          "description": "Leave on Any to return both completed and open records",
          "options": [
            {
              "value": "any",
              "label": "Any"
            },
            {
              "value": "yes",
              "label": "Yes"
            },
            {
              "value": "no",
              "label": "No"
            }
          ]
        },
        "archived": {
          "label": "Archived",
          "type": "select",
          "description": "Leave on Any to let Ninety apply its own default",
          "options": [
            {
              "value": "any",
              "label": "Any"
            },
            {
              "value": "yes",
              "label": "Yes"
            },
            {
              "value": "no",
              "label": "No"
            }
          ]
        },
        "searchText": {
          "label": "Search Text",
          "description": "Matches the title and description"
        },
        "title": {
          "label": "Exact Title",
          "description": "Matches the whole title only"
        },
        "dueDateFrom": {
          "label": "Due On Or After"
        },
        "dueDateTo": {
          "label": "Due On Or Before"
        },
        "sort": {
          "label": "Sort By",
          "type": "select",
          "description": "Ninety sorts to-dos by these fields only. Creation date is not one of them, so leave this empty to take the order Ninety returns.",
          "options": [
            {
              "value": "dueDate",
              "label": "Due date"
            },
            {
              "value": "title",
              "label": "Title"
            },
            {
              "value": "completedDate",
              "label": "Completed date"
            }
          ]
        },
        "order": {
          "label": "Order",
          "type": "select",
          "description": "Ignored unless Sort By is set",
          "options": [
            {
              "value": "desc",
              "label": "Descending"
            },
            {
              "value": "asc",
              "label": "Ascending"
            }
          ]
        },
        "page": {
          "label": "Page",
          "description": "One based. Leave empty for the first page.",
          "type": "number"
        },
        "pageSize": {
          "label": "Page Size",
          "description": "How many to-dos to return. Ninety allows up to 100.",
          "type": "number"
        }
      },
      "request": {
        "method": "POST",
        "url": "https://api.public.ninety.io/v1/todos/query",
        "body": {
          "teamId": "{{teamId}}",
          "userIds": "{{userIds}}",
          "completed": "{{completed}}",
          "archived": "{{archived}}",
          "searchText": "{{searchText}}",
          "title": "{{title}}",
          "dueDateFrom": "{{dueDateFrom}}",
          "dueDateTo": "{{dueDateTo}}",
          "sort": "{{sort}}",
          "order": "{{order}}",
          "page": "{{page}}",
          "pageSize": "{{pageSize}}"
        }
      },
      "beforeRequest": "const b = request.body; const tri = (v) => v === 'yes' ? true : v === 'no' ? false : undefined; const set = (k, v) => { if (v === undefined) delete b[k]; else b[k] = v; }; if (inputs.scope) b.isPersonal = inputs.scope === 'personal'; if (Array.isArray(b.userIds) && b.userIds.length === 0) delete b.userIds; set('completed', tri(b.completed)); set('archived', tri(b.archived)); if (b.dueDateFrom !== undefined) b.dueDateFrom = /^\\d{4}-\\d{2}-\\d{2}$/.test(b.dueDateFrom.trim()) ? b.dueDateFrom.trim() : new Date(b.dueDateFrom.trim()).toISOString().slice(0, 10); if (b.dueDateTo !== undefined) b.dueDateTo = /^\\d{4}-\\d{2}-\\d{2}$/.test(b.dueDateTo.trim()) ? b.dueDateTo.trim() : new Date(b.dueDateTo.trim()).toISOString().slice(0, 10); if (!inputs.sort) delete b.order; return request;",
      "afterResponse": "const items = Array.isArray(response) ? response : (response?.items ?? []); return {todos: items, count: items.length, totalCount: Array.isArray(response) || response == null ? items.length : (response.totalCount ?? items.length)};",
      "audience": "both"
    },
    "create_issue": {
      "label": "Create Issue",
      "description": "Raise an issue on a Ninety team issues list",
      "inputs": {
        "title": {
          "label": "Title",
          "description": "The issue headline",
          "required": true
        },
        "teamId": {
          "label": "Team",
          "description": "The Ninety team this record belongs to",
          "required": true,
          "optionsFrom": {
            "request": {
              "url": "https://api.public.ninety.io/v1/teams"
            },
            "list": "$",
            "label": "$.name",
            "value": "$._id"
          }
        },
        "interval": {
          "label": "Term",
          "type": "select",
          "description": "Short term issues sit on the weekly list, long term on the parking lot",
          "options": [
            {
              "value": "SHORT_TERM",
              "label": "Short term"
            },
            {
              "value": "LONG_TERM",
              "label": "Long term"
            }
          ]
        },
        "priority": {
          "label": "Priority",
          "type": "select",
          "description": "Ninety rates issues 0 to 5, where 0 is unrated and 5 is highest",
          "options": [
            {
              "value": "0",
              "label": "0 — unrated"
            },
            {
              "value": "1",
              "label": "1"
            },
            {
              "value": "2",
              "label": "2"
            },
            {
              "value": "3",
              "label": "3"
            },
            {
              "value": "4",
              "label": "4"
            },
            {
              "value": "5",
              "label": "5 — highest"
            }
          ]
        },
        "userId": {
          "label": "Owner",
          "description": "Defaults to the token owner when left empty",
          "optionsFrom": {
            "request": {
              "url": "https://api.public.ninety.io/v1/users"
            },
            "list": "$",
            "label": "$.primaryEmail",
            "value": "$.id"
          }
        },
        "description": {
          "label": "Description",
          "description": "Ninety renders this as HTML",
          "type": "multiline"
        }
      },
      "request": {
        "method": "POST",
        "url": "https://api.public.ninety.io/v1/issues",
        "body": {
          "title": "{{title}}",
          "teamId": "{{teamId}}",
          "interval": "{{interval}}",
          "description": "{{description}}",
          "userId": "{{userId}}",
          "priority": "{{priority}}"
        }
      },
      "beforeRequest": "const b = request.body; if (b.priority !== undefined) { const n = Number(b.priority.trim()); if (b.priority.trim() === '' || !Number.isFinite(n)) delete b.priority; else b.priority = n; } return request;",
      "audience": "both"
    },
    "update_issue": {
      "label": "Update Issue",
      "description": "Change an issue, move it between terms, or solve it",
      "inputs": {
        "issueId": {
          "label": "Issue ID",
          "description": "The id of the issue to update",
          "required": true
        },
        "title": {
          "label": "Title"
        },
        "teamId": {
          "label": "Team",
          "description": "Move the record to this team. Leave empty to keep it where it is.",
          "optionsFrom": {
            "request": {
              "url": "https://api.public.ninety.io/v1/teams"
            },
            "list": "$",
            "label": "$.name",
            "value": "$._id"
          }
        },
        "interval": {
          "label": "Term",
          "type": "select",
          "description": "Short term issues sit on the weekly list, long term on the parking lot",
          "options": [
            {
              "value": "SHORT_TERM",
              "label": "Short term"
            },
            {
              "value": "LONG_TERM",
              "label": "Long term"
            }
          ]
        },
        "priority": {
          "label": "Priority",
          "type": "select",
          "description": "Ninety rates issues 0 to 5, where 0 is unrated and 5 is highest",
          "options": [
            {
              "value": "0",
              "label": "0 — unrated"
            },
            {
              "value": "1",
              "label": "1"
            },
            {
              "value": "2",
              "label": "2"
            },
            {
              "value": "3",
              "label": "3"
            },
            {
              "value": "4",
              "label": "4"
            },
            {
              "value": "5",
              "label": "5 — highest"
            }
          ]
        },
        "completed": {
          "label": "Completed",
          "type": "select",
          "description": "Marking this Yes is how a record is finished in Ninety",
          "options": [
            {
              "value": "any",
              "label": "Leave unchanged"
            },
            {
              "value": "yes",
              "label": "Yes"
            },
            {
              "value": "no",
              "label": "No"
            }
          ]
        },
        "description": {
          "label": "Description",
          "description": "Ninety renders this as HTML",
          "type": "multiline"
        }
      },
      "request": {
        "method": "PATCH",
        "url": "https://api.public.ninety.io/v1/issues/{{issueId}}",
        "body": {
          "title": "{{title}}",
          "teamId": "{{teamId}}",
          "interval": "{{interval}}",
          "description": "{{description}}",
          "priority": "{{priority}}",
          "completed": "{{completed}}"
        }
      },
      "beforeRequest": "const b = request.body; const tri = (v) => v === 'yes' ? true : v === 'no' ? false : undefined; const set = (k, v) => { if (v === undefined) delete b[k]; else b[k] = v; }; if (b.priority !== undefined) { const n = Number(b.priority.trim()); if (b.priority.trim() === '' || !Number.isFinite(n)) delete b.priority; else b.priority = n; } set('completed', tri(b.completed)); return request;",
      "audience": "both"
    },
    "find_issues": {
      "label": "Find Issues",
      "description": "Search Ninety issues by team, term or text",
      "inputs": {
        "teamId": {
          "label": "Team",
          "description": "Leave empty to cover every team the token can see",
          "optionsFrom": {
            "request": {
              "url": "https://api.public.ninety.io/v1/teams"
            },
            "list": "$",
            "label": "$.name",
            "value": "$._id"
          }
        },
        "intervalCode": {
          "label": "Term",
          "type": "select",
          "description": "Short term issues sit on the weekly list, long term on the parking lot",
          "options": [
            {
              "value": "SHORT_TERM",
              "label": "Short term"
            },
            {
              "value": "LONG_TERM",
              "label": "Long term"
            }
          ]
        },
        "searchText": {
          "label": "Search Text",
          "description": "Matches the title, description and comments"
        },
        "sortField": {
          "label": "Sort By",
          "type": "select",
          "defaultValue": "createdDate",
          "options": [
            {
              "value": "createdDate",
              "label": "Created date"
            },
            {
              "value": "completedDate",
              "label": "Completed date"
            },
            {
              "value": "archivedDate",
              "label": "Archived date"
            },
            {
              "value": "dueDate",
              "label": "Due date"
            },
            {
              "value": "title",
              "label": "Title"
            },
            {
              "value": "priority",
              "label": "Priority"
            },
            {
              "value": "intervalCode",
              "label": "Term"
            },
            {
              "value": "numOfLikes",
              "label": "Likes"
            },
            {
              "value": "team",
              "label": "Team"
