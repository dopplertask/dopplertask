      "afterResponse": "const items = Array.isArray(response) ? response : (response?.items ?? []); return {issues: items, count: items.length, totalCount: Array.isArray(response) || response == null ? items.length : (response.totalCount ?? items.length)};",
      "audience": "both"
    },
    "create_rock": {
