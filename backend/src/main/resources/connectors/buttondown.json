{
  "name": "buttondown",
  "label": "Buttondown",
  "description": "Automate your Buttondown newsletter workflows.",
  "icon": "",
  "hosts": [
    "api.buttondown.com"
  ],
  "upstream": {
    "package": "@activepieces/piece-buttondown",
    "version": "0.0.9"
  },
  "credential": {
    "fields": {
      "token": {
        "label": "API Key",
        "description": "Create an API key from https://buttondown.com/keys and paste it here.",
        "secret": true,
        "required": true
      }
    },
    "headers": {
      "authorization": "Token {{credential.token}}"
    }
  },
  "actions": {
    "createSubscriber": {
      "label": "Create Subscriber",
      "description": "Create a new subscriber in Buttondown.",
      "inputs": {
        "email": {
          "label": "Email Address",
          "description": "The email address of the subscriber.",
          "required": true
        },
        "type": {
          "label": "Subscriber Type",
          "description": "Set the subscriber status. Use \"regular\" to bypass double opt-in.",
          "type": "select",
          "options": [
            {
              "value": "regular",
              "label": "Regular"
            },
            {
              "value": "premium",
              "label": "Premium"
            },
            {
              "value": "unactivated",
              "label": "Unactivated"
            },
            {
              "value": "paused",
              "label": "Paused"
            },
            {
              "value": "trialed",
              "label": "Trialed"
            },
            {
              "value": "upcoming",
              "label": "Upcoming"
            },
            {
              "value": "churning",
              "label": "Churning"
            },
            {
              "value": "churned",
              "label": "Churned"
            },
            {
              "value": "unsubscribed",
              "label": "Unsubscribed"
            },
            {
              "value": "undeliverable",
              "label": "Undeliverable"
            },
            {
              "value": "blocked",
              "label": "Blocked"
            },
            {
              "value": "complained",
              "label": "Complained"
            },
            {
              "value": "gifted",
              "label": "Gifted"
            },
            {
              "value": "past_due",
              "label": "Past Due"
            },
            {
              "value": "removed",
              "label": "Removed"
            },
            {
              "value": "unpaid",
              "label": "Unpaid"
            }
          ]
        },
        "notes": {
          "label": "Internal Notes",
          "type": "multiline"
        },
        "tags": {
          "label": "Tags",
          "description": "Add one or more tags to assign to the subscriber.",
          "type": "json"
        },
        "metadata": {
          "label": "Metadata",
          "description": "Custom metadata to store on the subscriber (JSON object).",
          "type": "json"
        },
        "referrerUrl": {
          "label": "Referrer URL"
        },
        "utmSource": {
          "label": "UTM Source"
        },
        "utmMedium": {
          "label": "UTM Medium"
        },
        "utmCampaign": {
          "label": "UTM Campaign"
        },
        "referringSubscriberId": {
          "label": "Referring Subscriber ID",
          "description": "ID of the subscriber who referred this contact."
        },
        "ipAddress": {
          "label": "IP Address",
          "description": "The original IP address of the subscriber. Helps Buttondown evaluate spam."
        },
        "collisionBehavior": {
          "label": "Collision Behavior",
          "description": "Control how Buttondown handles duplicate email addresses. Leave empty to keep the existing subscriber.",
          "type": "select",
          "options": [
            {
              "value": "overwrite",
              "label": "Overwrite existing subscriber"
            },
            {
              "value": "add",
              "label": "Merge tags with existing subscriber"
            }
          ]
        },
        "bypassFirewall": {
          "label": "Bypass Firewall",
          "description": "Set to true when the request originates from a trusted internal system without the subscriber's IP address.",
          "type": "boolean",
          "defaultValue": "false"
        }
      },
      "request": {
        "method": "POST",
        "url": "https://api.buttondown.com/v1/subscribers",
        "body": {
          "email_address": "{{email}}",
          "notes": "{{notes}}",
          "referrer_url": "{{referrerUrl}}",
          "utm_source": "{{utmSource}}",
          "utm_medium": "{{utmMedium}}",
          "utm_campaign": "{{utmCampaign}}",
          "referring_subscriber_id": "{{referringSubscriberId}}",
          "ip_address": "{{ipAddress}}"
        }
      }
    },
    "listSubscribers": {
      "label": "List Subscribers",
      "description": "Retrieve subscribers from Buttondown.",
      "inputs": {
        "limit": {
          "label": "Page Size",
          "description": "Maximum number of subscribers to return (1-1000).",
          "type": "number",
          "defaultValue": "100"
        },
        "cursor": {
          "label": "Cursor",
          "description": "Provide the cursor value from a previous response to fetch the next page."
        },
        "type": {
          "label": "Subscriber Type",
          "type": "select",
          "options": [
            {
              "value": "regular",
              "label": "Regular"
            },
            {
              "value": "premium",
              "label": "Premium"
            },
            {
              "value": "unactivated",
              "label": "Unactivated"
            },
            {
              "value": "paused",
              "label": "Paused"
            },
            {
              "value": "trialed",
              "label": "Trialed"
            },
            {
              "value": "upcoming",
              "label": "Upcoming"
            },
            {
              "value": "churning",
              "label": "Churning"
            },
            {
              "value": "churned",
              "label": "Churned"
            },
            {
              "value": "unsubscribed",
              "label": "Unsubscribed"
            },
            {
              "value": "undeliverable",
              "label": "Undeliverable"
            },
            {
              "value": "blocked",
              "label": "Blocked"
            },
            {
              "value": "complained",
              "label": "Complained"
            },
            {
              "value": "gifted",
              "label": "Gifted"
            },
            {
              "value": "past_due",
              "label": "Past Due"
            },
            {
              "value": "removed",
              "label": "Removed"
            },
            {
              "value": "unpaid",
              "label": "Unpaid"
            }
          ]
        },
        "source": {
          "label": "Source",
          "type": "select",
          "options": [
            {
              "value": "admin",
              "label": "Admin"
            },
            {
              "value": "api",
              "label": "API"
            },
            {
              "value": "carrd",
              "label": "Carrd"
            },
            {
              "value": "comment",
              "label": "Comment"
            },
            {
              "value": "embedded_form",
              "label": "Embedded form"
            },
            {
              "value": "form",
              "label": "Hosted form"
            },
            {
              "value": "import",
              "label": "Import"
            },
            {
              "value": "memberful",
              "label": "Memberful"
            },
            {
              "value": "organic",
              "label": "Organic"
            },
            {
              "value": "patreon",
              "label": "Patreon"
            },
            {
              "value": "stripe",
              "label": "Stripe"
            },
            {
              "value": "user",
              "label": "User portal"
            },
            {
              "value": "zapier",
              "label": "Zapier"
            }
          ]
        },
        "tags": {
          "label": "Tags",
          "description": "Filter by subscribers who have at least one of these tags.",
          "type": "json"
        },
        "emailAddress": {
          "label": "Email Contains",
          "description": "Return subscribers whose email address contains this value."
        },
        "referrerUrl": {
          "label": "Referrer URL Contains"
        },
        "ordering": {
          "label": "Ordering",
          "type": "select",
          "options": [
            {
              "value": "-creation_date",
              "label": "Newest first"
            },
            {
              "value": "creation_date",
              "label": "Oldest first"
            },
            {
              "value": "email_address",
              "label": "Email address (A-Z)"
            },
            {
              "value": "-email_address",
              "label": "Email address (Z-A)"
            },
            {
              "value": "-last_open_date",
              "label": "Last opened (recent first)"
            },
            {
              "value": "last_open_date",
              "label": "Last opened (oldest first)"
            }
          ]
        }
      },
      "request": {
        "method": "GET",
        "url": "https://api.buttondown.com/v1/subscribers",
        "query": {
          "page_size": "{{limit}}",
          "cursor": "{{cursor}}",
          "email_address": "{{emailAddress}}",
          "referrer_url": "{{referrerUrl}}"
        }
      }
    },
    "sendEmail": {
      "label": "Send Email",
      "description": "Send an email to your Buttondown subscribers.",
      "inputs": {
        "subject": {
          "label": "Subject",
          "required": true
        },
        "body": {
          "label": "Body",
          "description": "Write your email content in Markdown or HTML. Buttondown will detect the format automatically.",
          "required": true,
          "type": "multiline"
        },
        "status": {
          "label": "Delivery Status",
          "description": "Choose how Buttondown should treat this email after creation.",
          "type": "select",
          "options": [
            {
              "value": "about_to_send",
              "label": "Send immediately (about_to_send)"
            },
            {
              "value": "draft",
              "label": "Draft"
            },
            {
              "value": "scheduled",
              "label": "Scheduled"
            }
          ],
          "defaultValue": "about_to_send"
        },
        "publishDate": {
          "label": "Publish Date",
          "description": "Required when scheduling an email. Use ISO 8601 format."
        },
        "emailType": {
          "label": "Email Type",
          "type": "select",
          "options": [
            {
              "value": "public",
              "label": "Public"
            },
            {
              "value": "private",
              "label": "Private"
            },
            {
              "value": "premium",
              "label": "Premium"
            },
            {
              "value": "free",
              "label": "Free"
            },
            {
              "value": "churned",
              "label": "Churned"
            },
            {
              "value": "archival",
              "label": "Archival"
            }
          ],
          "defaultValue": "public"
        },
        "description": {
          "label": "Description",
          "type": "multiline"
        },
        "canonicalUrl": {
          "label": "Canonical URL"
        },
        "image": {
          "label": "Primary Image URL"
        },
        "slug": {
          "label": "Slug",
          "description": "Override the automatic slug used for the archive URL."
        },
        "metadata": {
          "label": "Metadata",
          "description": "Custom metadata to attach to the email (JSON object).",
          "type": "json"
        },
        "attachments": {
          "label": "Attachment IDs",
          "description": "IDs of attachments uploaded via the Buttondown API.",
          "type": "json"
        },
        "triggerBilling": {
          "label": "Trigger Pay-per-email Billing",
          "description": "Enable when this email should count against pay-per-email billing for paid subscribers.",
          "type": "boolean",
          "defaultValue": "false"
        }
      },
      "request": {
        "method": "POST",
        "url": "https://api.buttondown.com/v1/emails",
        "body": {
          "subject": "{{subject}}",
          "body": "{{body}}",
          "status": "about_to_send",
          "publish_date": "{{publishDate}}",
          "description": "{{description}}",
          "canonical_url": "{{canonicalUrl}}",
          "image": "{{image}}",
          "slug": "{{slug}}"
        }
      }
    }
  },
  "triggers": {}
}
