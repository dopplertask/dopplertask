{
  "name": "opportify",
  "label": "Opportify",
  "description": "",
  "icon": "",
  "hosts": [
    "api.opportify.ai"
  ],
  "upstream": {
    "package": "@activepieces/piece-opportify",
    "version": "0.1.7"
  },
  "credential": {
    "fields": {
      "token": {
        "label": "API Key",
        "description": "You can obtain your API key from [API Key List](https://app.opportify.ai/api-keys/list).",
        "secret": true,
        "required": true
      }
    },
    "headers": {
      "x-opportify-token": "{{credential.token}}"
    }
  },
  "actions": {
    "analyze-email": {
      "label": "Analyze Email",
      "description": "Validates an email address and returns its deliverability status.",
      "inputs": {
        "email": {
          "label": "Email",
          "required": true
        },
        "enableAutoCorrection": {
          "label": "Enable Auto Correction?",
          "type": "boolean"
        },
        "enableAI": {
          "label": "Enable AI?",
          "type": "boolean"
        }
      },
      "request": {
        "method": "POST",
        "url": "https://api.opportify.ai/insights/v1/email/analyze",
        "body": {
          "email": "{{email}}"
        }
      }
    },
    "analyze-ip-address": {
      "label": "Analyze IP Address",
      "description": "Provides comprehensive insights into a specified IP address.",
      "inputs": {
        "ip": {
          "label": "Ip Address",
          "required": true
        },
        "enableAI": {
          "label": "Enable AI?",
          "type": "boolean"
        }
      },
      "request": {
        "method": "POST",
        "url": "https://api.opportify.ai/insights/v1/ip/analyze",
        "body": {
          "ip": "{{ip}}"
        }
      }
    }
  },
  "triggers": {}
}
