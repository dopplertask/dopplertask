{
  "name": "peekshot",
  "label": "PeekShot",
  "description": "",
  "icon": "",
  "hosts": [
    "api.peekshot.com"
  ],
  "upstream": {
    "package": "@activepieces/piece-peekshot",
    "version": "0.2.2"
  },
  "credential": {
    "fields": {
      "token": {
        "label": "API Key",
        "description": "You can obtain your API key by navigating to [API Keys](https://dashboard.peekshot.com/dashboard/api-keys) menu.",
        "secret": true,
        "required": true
      }
    },
    "headers": {
      "x-api-key": "{{credential.token}}"
    }
  },
  "actions": {
    "captureScreenshot": {
      "label": "Capture Screenshot",
      "description": "Captures Screenshot of a URL.",
      "inputs": {
        "projectId": {
          "label": "Project",
          "required": true
        },
        "url": {
          "label": "Target URL",
          "required": true
        },
        "width": {
          "label": "Custom Screenshot Width"
        },
        "height": {
          "label": "Custom Screenshot Height"
        },
        "file_type": {
          "label": "Image Format",
          "description": "Output format for the screenshot.",
          "type": "select",
          "options": [
            {
              "value": "png",
              "label": "PNG"
            },
            {
              "value": "jpeg",
              "label": "JPEG"
            }
          ]
        },
        "inject_css": {
          "label": "Custom CSS",
          "description": "Custom CSS to apply.",
          "type": "multiline"
        },
        "inject_js": {
          "label": "Custom JavaScript",
          "description": "Custom JavaScript to apply.",
          "type": "multiline"
        },
        "full_page": {
          "label": "Full Page?",
          "description": "To capture the entire page.",
          "type": "boolean"
        }
      },
      "request": {
        "method": "POST",
        "url": "https://api.peekshot.com/api/v1/screenshots",
        "body": {
          "project_id": "{{projectId}}",
          "url": "{{url}}",
          "width": "{{width}}",
          "height": "{{height}}",
          "inject_css": "{{inject_css}}",
          "inject_js": "{{inject_js}}",
          "full_page": "false"
        }
      }
    }
  },
  "triggers": {}
}
