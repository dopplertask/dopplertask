{
  "name": "vtex",
  "label": "VTEX",
  "description": "Unified commerce platform",
  "icon": "",
  "category": "integration",
  "hosts": [
    "{{credential.hostUrl}}"
  ],
  "baseUrl": "https://{{credential.hostUrl}}",
  "upstream": {
    "package": "@activepieces/piece-vtex",
    "version": "0.3.1"
  },
  "credential": {
    "fields": {
      "hostUrl": {
        "label": "Host Url",
        "description": "The VTEX store host, such as {accountName}.{environment}.com",
        "required": true
      },
      "appKey": {
        "label": "App Key",
        "description": "VTEX App Key. In Account Settings, Account, Security, generate an access key and secret; the key is the App Key.",
        "secret": true,
        "required": true
      },
      "appToken": {
        "label": "App Token",
        "description": "VTEX App Token: the secret of that access key.",
        "secret": true,
        "required": true
      }
    },
    "headers": {
      "X-VTEX-API-AppKey": "{{credential.appKey}}",
      "X-VTEX-API-AppToken": "{{credential.appToken}}"
    }
  },
  "actions": {
    "get-product-by-id": {
      "label": "Get Product By ID",
      "description": "Find a product in your catalog by it's id",
      "inputs": {
        "productId": {
          "label": "Product ID",
          "description": "The product ID",
          "type": "number",
          "required": true
        }
      },
      "request": {
        "method": "GET",
        "url": "https://{{credential.hostUrl}}/api/catalog/pvt/product/{{productId}}"
      }
    },
    "create-product": {
      "label": "Create New Product",
      "description": "Create a new product in your catalog",
      "inputs": {
        "Name": {
          "label": "Name",
          "required": true
        },
        "Title": {
          "label": "Title",
          "required": true
        },
        "Description": {
          "label": "Description",
          "required": true
        },
        "BrandId": {
          "label": "Brand ID",
          "type": "number",
          "required": true
        },
        "CategoryId": {
          "label": "Category ID",
          "type": "number",
          "required": true
        },
        "LinkId": {
          "label": "Link ID"
        },
        "RefId": {
          "label": "Ref ID"
        },
        "Id": {
          "label": "Product ID",
          "description": "Set the product ID",
          "type": "number"
        },
        "IsVisible": {
          "label": "Is Visible",
          "type": "boolean"
        },
        "DescriptionShort": {
          "label": "Short Description"
        },
        "ReleaseDate": {
          "label": "Release Date"
        },
        "KeyWords": {
          "label": "Key Words",
          "description": "Similar words"
        },
        "IsActive": {
          "label": "Is Active",
          "type": "boolean"
        },
        "TaxCode": {
          "label": "Tax Code"
        },
        "MetaTagDescription": {
          "label": "Metatag description"
        },
        "ShowWithoutStock": {
          "label": "Show Without Stock",
          "type": "boolean"
        },
        "Score": {
          "label": "Score",
          "type": "number"
        }
      },
      "request": {
        "method": "POST",
        "url": "https://{{credential.hostUrl}}/api/catalog/pvt/product",
        "body": {
          "Name": "{{Name}}",
          "Title": "{{Title}}",
          "Description": "{{Description}}",
          "BrandId": "{{BrandId}}",
          "CategoryId": "{{CategoryId}}",
          "LinkId": "{{LinkId}}",
          "RefId": "{{RefId}}",
          "Id": "{{Id}}",
          "IsVisible": "{{IsVisible}}",
          "DescriptionShort": "{{DescriptionShort}}",
          "ReleaseDate": "{{ReleaseDate}}",
          "KeyWords": "{{KeyWords}}",
          "IsActive": "{{IsActive}}",
          "TaxCode": "{{TaxCode}}",
          "MetaTagDescription": "{{MetaTagDescription}}",
          "ShowWithoutStock": "{{ShowWithoutStock}}",
          "Score": "{{Score}}"
        }
      }
    },
    "update-product": {
      "label": "Update a Product",
      "description": "Update a product in your catalog",
      "inputs": {
        "productId": {
          "label": "Product ID",
          "description": "Set the product ID",
          "type": "number",
          "required": true
        },
        "Name": {
          "label": "Name",
          "required": true
        },
        "Title": {
          "label": "Title",
          "required": true
        },
        "Description": {
          "label": "Description",
          "required": true
        },
        "BrandId": {
          "label": "Brand ID",
          "type": "number",
          "required": true
        },
        "CategoryId": {
          "label": "Category ID",
          "type": "number",
          "required": true
        },
        "DepartmentId": {
          "label": "DepartmentId",
          "type": "number",
          "required": true
        },
        "LinkId": {
          "label": "Link ID"
        },
        "RefId": {
          "label": "Ref ID"
        },
        "BrandName": {
          "label": "Brand Name"
        },
        "IsVisible": {
          "label": "Is Visible",
          "type": "boolean"
        },
        "DescriptionShort": {
          "label": "Short Description"
        },
        "ReleaseDate": {
          "label": "Release Date"
        },
        "KeyWords": {
          "label": "Key Words",
          "description": "Similar words"
        },
        "IsActive": {
          "label": "Is Active",
          "type": "boolean"
        },
        "TaxCode": {
          "label": "Tax Code"
        },
        "MetaTagDescription": {
          "label": "Metatag description"
        },
        "ShowWithoutStock": {
          "label": "Show Without Stock",
          "type": "boolean"
        },
        "Score": {
          "label": "Score",
          "type": "number"
        }
      },
      "request": {
        "method": "PUT",
        "url": "https://{{credential.hostUrl}}/api/catalog/pvt/product/{{productId}}",
        "body": {
          "productId": "{{productId}}",
          "Name": "{{Name}}",
          "Title": "{{Title}}",
          "Description": "{{Description}}",
          "BrandId": "{{BrandId}}",
          "CategoryId": "{{CategoryId}}",
          "DepartmentId": "{{DepartmentId}}",
          "LinkId": "{{LinkId}}",
          "RefId": "{{RefId}}",
          "BrandName": "{{BrandName}}",
          "IsVisible": "{{IsVisible}}",
          "DescriptionShort": "{{DescriptionShort}}",
          "ReleaseDate": "{{ReleaseDate}}",
          "KeyWords": "{{KeyWords}}",
          "IsActive": "{{IsActive}}",
          "TaxCode": "{{TaxCode}}",
          "MetaTagDescription": "{{MetaTagDescription}}",
          "ShowWithoutStock": "{{ShowWithoutStock}}",
          "Score": "{{Score}}"
        }
      }
    },
    "get-brand-list": {
      "label": "Get Brand List",
      "description": "Find all Brands in your catalog",
      "request": {
        "method": "GET",
        "url": "https://{{credential.hostUrl}}/api/catalog_system/pvt/brand/list"
      }
    },
    "get-brand-by-id": {
      "label": "Get Brand By ID",
      "description": "Find a Brand in your catalog by it's id",
      "inputs": {
        "BrandId": {
          "label": "Brand ID",
          "description": "The Brand ID",
          "type": "number",
          "required": true
        }
      },
      "request": {
        "method": "GET",
        "url": "https://{{credential.hostUrl}}/api/catalog_system/pvt/brand/{{BrandId}}"
      }
    },
    "create-brand": {
      "label": "Create new Brand",
      "description": "Create a new Brand to your catalog",
      "inputs": {
        "Name": {
          "label": "Name",
          "required": true
        },
        "SiteTitle": {
          "label": "Site Title"
        },
        "LinkId": {
          "label": "Link ID"
        },
        "Id": {
          "label": "Brand ID",
          "description": "Set the brand ID",
          "type": "number"
        },
        "Text": {
          "label": "Text"
        },
        "MenuHome": {
          "label": "Menu Home",
          "type": "boolean"
        },
        "Keywords": {
          "label": "Keywords",
          "description": "Similar words"
        },
        "Active": {
          "label": "Active",
          "type": "boolean"
        },
        "Score": {
          "label": "Score",
          "type": "number"
        }
      },
      "request": {
        "method": "POST",
        "url": "https://{{credential.hostUrl}}/api/catalog/pvt/brand",
        "body": {
          "Id": "{{Id}}",
          "Name": "{{Name}}",
          "Text": "{{Text}}",
          "Keywords": "{{Keywords}}",
          "SiteTitle": "{{SiteTitle}}",
          "Active": "{{Active}}",
          "MenuHome": "{{MenuHome}}",
          "Score": "{{Score}}",
          "LinkId": "{{LinkId}}"
        }
      }
    },
    "update-brand": {
      "label": "Update Brand",
      "description": "Update a Brand in your catalog",
      "inputs": {
        "Id": {
          "label": "Brand ID",
          "description": "Set the brand ID",
          "type": "number",
          "required": true
        },
        "Name": {
          "label": "Name",
          "required": true
        },
        "SiteTitle": {
          "label": "Site Title",
          "required": true
        },
        "LinkId": {
          "label": "Link ID",
          "required": true
        },
        "Text": {
          "label": "Text",
          "required": true
        },
        "MenuHome": {
          "label": "Menu Home",
          "type": "boolean",
          "required": true
        },
        "Keywords": {
          "label": "Keywords",
          "description": "Similar words",
          "required": true
        },
        "Active": {
          "label": "Active",
          "type": "boolean",
          "required": true
        },
        "Score": {
          "label": "Score",
          "type": "number",
          "required": true
        }
      },
      "request": {
        "method": "PUT",
        "url": "https://{{credential.hostUrl}}/api/catalog/pvt/brand/{{Id}}",
        "body": {
          "Id": "{{Id}}",
          "Name": "{{Name}}",
          "SiteTitle": "{{SiteTitle}}",
          "LinkId": "{{LinkId}}",
          "Text": "{{Text}}",
          "MenuHome": "{{MenuHome}}",
          "Keywords": "{{Keywords}}",
          "Active": "{{Active}}",
          "Score": "{{Score}}"
        }
      }
    },
    "delete-brand": {
      "label": "Delete Brand",
      "description": "Delete a Brand in your catalog by it's id",
      "inputs": {
        "brandId": {
          "label": "Brand ID",
          "description": "The Brand ID",
          "type": "number",
          "required": true
        }
      },
      "request": {
        "method": "DELETE",
        "url": "https://{{credential.hostUrl}}/api/catalog/pvt/brand/{{brandId}}"
      }
    },
    "get-category-by-id": {
      "label": "Get Category",
      "description": "Find a Category in your catalog by it's id",
      "inputs": {
        "categoryId": {
          "label": "Category ID",
          "description": "The Category ID",
          "type": "number"
        }
      },
      "request": {
        "method": "GET",
        "url": "https://{{credential.hostUrl}}/api/catalog/pvt/category/"
      },
      "beforeRequest": "if (Number(inputs.categoryId)) request.url += encodeURIComponent(inputs.categoryId); return request;"
    },
    "get-sku-by-product-id": {
      "label": "Get SKU By Product ID",
      "description": "Find a Sku in your catalog by a Product id",
      "inputs": {
        "productId": {
          "label": "Product ID",
          "description": "The Product ID",
          "type": "number",
          "required": true
        }
      },
      "request": {
        "method": "GET",
        "url": "https://{{credential.hostUrl}}/api/catalog_system/pvt/sku/stockkeepingunitByProductId/{{productId}}"
      }
    },
    "create-sku": {
      "label": "Create New Sku",
      "description": "Create a new SKU to your catalog",
      "inputs": {
        "ProductId": {
          "label": "Product ID",
          "description": "ID of the product to be associated with this SKU",
          "type": "number",
          "required": true
        },
        "Name": {
          "label": "SKU Name",
          "description": "Name the variation of the product",
          "required": true
        },
        "PackagedHeight": {
          "label": "Package Height",
          "type": "number",
          "required": true
        },
        "PackagedLength": {
          "label": "Package Length",
          "type": "number",
          "required": true
        },
        "PackagedWidth": {
          "label": "Package Width",
          "type": "number",
          "required": true
        },
        "PackagedWeightKg": {
          "label": "Package Weight (Kg)",
          "type": "number",
          "required": true
        },
        "IsActive": {
          "label": "Is Active",
          "type": "boolean"
        },
        "IsKit": {
          "label": "Is Kit",
          "type": "boolean"
        },
        "Id": {
          "label": "Sku ID",
          "description": "Set the Sku ID",
          "type": "number"
        }
      },
      "request": {
        "method": "POST",
        "url": "https://{{credential.hostUrl}}/api/catalog/pvt/stockkeepingunit",
        "body": {
          "ProductId": "{{ProductId}}",
          "Name": "{{Name}}",
          "PackagedHeight": "{{PackagedHeight}}",
          "PackagedLength": "{{PackagedLength}}",
          "PackagedWidth": "{{PackagedWidth}}",
          "PackagedWeightKg": "{{PackagedWeightKg}}",
          "IsActive": "{{IsActive}}",
          "IsKit": "{{IsKit}}",
          "Id": "{{Id}}"
        }
      }
    },
    "create-sku-file": {
      "label": "Create New Sku File",
      "description": "Create a new SKU File to your catalog",
      "inputs": {
        "SkuId": {
          "label": "Sku ID",
          "description": "Set the Sku ID",
          "type": "number",
          "required": true
        },
        "Url": {
          "label": "Image Url",
          "required": true
        },
        "Name": {
          "label": "Image Name",
          "required": true
        },
        "IsMain": {
          "label": "Is Main Image",
          "type": "boolean",
          "required": true
        },
        "Label": {
          "label": "Image Label"
        },
        "Text": {
          "label": "Image Name",
          "description": "General text of the image"
        }
      },
      "request": {
        "method": "POST",
        "url": "https://{{credential.hostUrl}}/api/catalog/pvt/stockkeepingunit/{{SkuId}}/file",
        "body": {
          "Url": "{{Url}}",
          "Name": "{{Name}}",
          "IsMain": "{{IsMain}}",
          "Label": "{{Label}}",
          "Text": "{{Text}}"
        }
      }
    },
    "get-client-list": {
      "label": "Get Client List",
      "description": "Find all Clients",
      "request": {
        "method": "GET",
        "url": "https://{{credential.hostUrl}}/api/dataentities/CL/search"
      }
    },
    "get-client-by-id": {
      "label": "Get Client By ID",
      "description": "Find a Client by Id",
      "inputs": {
        "clientId": {
          "label": "Client ID",
          "description": "The Client ID",
          "type": "number",
          "required": true
        }
      },
      "request": {
        "method": "GET",
        "url": "https://{{credential.hostUrl}}/api/dataentities/CL/documents/{{clientId}}"
      }
    },
    "get-order-by-id": {
      "label": "Get Order By ID",
      "description": "Find a Order by Id",
      "inputs": {
        "OrderId": {
          "label": "Order ID",
          "description": "The Order ID",
          "type": "number",
          "required": true
        }
      },
      "request": {
        "method": "GET",
        "url": "https://{{credential.hostUrl}}/api/oms/pvt/orders/{{OrderId}}"
      }
    },
    "get-order-list": {
      "label": "Get Orders List",
      "description": "Find Orders",
      "inputs": {
        "fromYear": {
          "label": "From (Year)",
          "type": "number",
          "required": true
        },
        "toYear": {
          "label": "To (Year)",
          "required": true
        },
        "fromMonth": {
          "label": "From (Month)",
          "defaultValue": "01"
        },
        "toMonth": {
          "label": "To (Month)",
          "defaultValue": "12"
        },
        "fromDay": {
          "label": "From (Day)",
          "defaultValue": "01"
        },
        "toDay": {
          "label": "To (Day)",
          "defaultValue": "28"
        }
      },
      "request": {
        "method": "GET",
        "url": "https://{{credential.hostUrl}}/api/oms/pvt/orders"
      },
      "beforeRequest": "const day = (year, month, dayOfMonth) => new Date(`${year}-${month}-${dayOfMonth}`).toISOString(); const range = `creationDate:[${day(inputs.fromYear, inputs.fromMonth || '01', inputs.fromDay || '01')} TO ${day(inputs.toYear, inputs.toMonth || '12', inputs.toDay || '28')}]`; request.url += '?f_creationDate=' + encodeURIComponent(range).replace(/%20/g, '+'); return request;"
    }
  }
}
