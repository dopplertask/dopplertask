{
  "name": "pushbullet",
  "label": "Pushbullet",
  "description": "Cross-device notification service",
  "icon": "pushbullet",
  "hosts": [
    "api.pushbullet.com"
  ],
  "upstream": {
    "package": "@activepieces/piece-pushbullet",
    "version": "0.3.0"
  },
  "credential": {
    "fields": {
      "token": {
        "label": "API Token",
        "description": "\n1. Log in to your Pushbullet account.\n2. Go to **https://www.pushbullet.com/#settings/account**.\n3. Click **Create Access Token**, copy the token and paste it here.",
        "secret": true,
        "required": true
      }
    },
    "headers": {
      "authorization": "Bearer {{credential.token}}"
    }
  },
  "actions": {
    "ai_dismiss_push": {
      "label": "Dismiss Push",
      "description": "Marks a push as dismissed.",
      "inputs": {
        "iden": {
          "label": "Push ID",
          "description": "The iden of the push, from List Pushes or a send action.",
          "required": true
        }
      },
      "request": {
        "method": "POST",
        "url": "https://api.pushbullet.com/v2/pushes/{{iden}}",
        "body": {
          "dismissed": true
        }
      }
    },
    "ai_get_current_user": {
      "label": "Get Current User",
      "description": "Gets the connected Pushbullet user.",
      "inputs": {},
      "request": {
        "method": "GET",
        "url": "https://api.pushbullet.com/v2/users/me"
      }
    }
  },
  "triggers": {}
}
