{
  "name": "tl-dv",
  "label": "tl;dv",
  "description": "Record meetings, get transcripts, and access meeting notes automatically.",
  "icon": "",
  "hosts": [
    "pasta.tldv.io"
  ],
  "upstream": {
    "package": "@activepieces/piece-tl-dv",
    "version": "0.1.7"
  },
  "credential": {
    "fields": {
      "token": {
        "label": "API Key",
        "description": "Your tl;dv API key. You can find this at https://tldv.io/app/settings/personal-settings/api-keys",
        "secret": true,
        "required": true
      }
    },
    "headers": {
      "x-api-key": "{{credential.token}}"
    }
  },
  "actions": {
    "get_meeting": {
      "label": "Get Meeting",
      "description": "Get meeting details by ID",
      "inputs": {
        "meetingId": {
          "label": "Meeting",
          "description": "Select a meeting",
          "required": true
        }
      },
      "request": {
        "method": "GET",
        "url": "https://pasta.tldv.io/v1alpha1/meetings/{{meetingId}}"
      }
    },
    "get_transcript": {
      "label": "Get Transcript",
      "description": "Get meeting transcript by meeting ID",
      "inputs": {
        "meetingId": {
          "label": "Meeting",
          "description": "Select a meeting",
          "required": true
        }
      },
      "request": {
        "method": "GET",
        "url": "https://pasta.tldv.io/v1alpha1/meetings/{{meetingId}}/transcript"
      }
    },
    "get_highlights": {
      "label": "Get Highlights",
      "description": "Get meeting highlights (notes) by meeting ID",
      "inputs": {
        "meetingId": {
          "label": "Meeting",
          "description": "Select a meeting",
          "required": true
        }
      },
      "request": {
        "method": "GET",
        "url": "https://pasta.tldv.io/v1alpha1/meetings/{{meetingId}}/highlights"
      }
    }
  },
  "triggers": {}
}
