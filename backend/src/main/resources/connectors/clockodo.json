{
  "name": "clockodo",
  "label": "Clockodo",
  "description": "Time tracking made easy",
  "icon": "",
  "hosts": [
    "my.clockodo.com"
  ],
  "baseUrl": "https://my.clockodo.com/api",
  "upstream": {
    "package": "@activepieces/piece-clockodo",
    "version": "0.2.10"
  },
  "credential": {
    "fields": {
      "email": {
        "label": "E-Mail",
        "description": "The email of your clockodo user",
        "required": true
      },
      "token": {
        "label": "API-Token",
        "description": "Your api token (can be found in profile settings)",
        "secret": true,
        "required": true
      },
      "company_name": {
        "label": "Company Name",
        "description": "Your company name or app name",
        "required": true
      },
      "company_email": {
        "label": "Company E-Mail",
        "description": "A contact email for your company or app",
        "required": true
      }
    },
    "headers": {
      "X-ClockodoApiUser": "{{credential.email}}",
      "X-ClockodoApiKey": "{{credential.token}}",
      "X-Clockodo-External-Application": "{{credential.company_name}};{{credential.company_email}}",
      "Accept-Language": "en"
    }
  },
  "actions": {
    "create_entry": {
      "label": "Create Entry",
      "description": "Creates an entry in clockodo",
      "audience": "both",
      "inputs": {
        "customer_id": {
          "label": "Customer",
          "description": "The ID of the customer",
          "type": "number",
          "required": true,
          "optionsFrom": {
            "request": {
              "url": "https://my.clockodo.com/api/v2/customers",
              "query": {
                "filter[active]": "true"
              }
            },
            "list": "$.customers",
            "label": "$.name",
            "value": "$.id"
          }
        },
        "project_id": {
          "label": "Project",
          "description": "The ID of the project",
          "type": "number",
          "optionsFrom": {
            "request": {
              "url": "https://my.clockodo.com/api/v2/projects",
              "query": {
                "filter[active]": "true"
              }
            },
            "list": "$.projects",
            "label": "$.name",
            "value": "$.id"
          }
        },
        "service_id": {
          "label": "Service",
          "description": "The ID of the service",
          "type": "number",
          "required": true,
          "optionsFrom": {
            "request": {
              "url": "https://my.clockodo.com/api/v2/services"
            },
            "list": "$.services",
            "label": "$.name",
            "value": "$.id"
          }
        },
        "time_since": {
          "label": "Start Time",
          "required": true
        },
        "time_until": {
          "label": "End Time",
          "required": true
        },
        "text": {
          "label": "Description",
          "type": "multiline"
        },
        "hourly_rate": {
          "label": "Hourly Rate",
          "type": "number"
        },
        "user_id": {
          "label": "User",
          "description": "The ID of the user",
          "type": "number",
          "optionsFrom": {
            "request": {
              "url": "https://my.clockodo.com/api/v2/users"
            },
            "list": "$.users",
            "label": "$.name",
            "value": "$.id"
          }
        }
      },
      "request": {
        "method": "POST",
        "url": "https://my.clockodo.com/api/v2/entries",
        "body": {
          "customers_id": "{{customer_id}}",
          "projects_id": "{{project_id}}",
          "services_id": "{{service_id}}",
          "time_since": "{{time_since}}",
          "time_until": "{{time_until}}",
          "text": "{{text}}",
          "hourly_rate": "{{hourly_rate}}",
          "users_id": "{{user_id}}"
        }
      },
      "beforeRequest": "['time_since', 'time_until'].forEach(k => { if (request.body[k]) request.body[k] = request.body[k].replace(/\\.[0-9]{3}/, ''); }); return request;",
      "result": "$.entry"
    },
    "delete_entry": {
      "label": "Delete Entry",
      "description": "Deletes an entry in clockodo",
      "audience": "both",
      "inputs": {
        "entry_id": {
          "label": "Entry ID",
          "type": "number",
          "required": true
        }
      },
      "request": {
        "method": "DELETE",
        "url": "https://my.clockodo.com/api/v2/entries/{{entry_id}}"
      }
    },
    "get_entry": {
      "label": "Get Entry",
      "description": "Retrieves a single entry from clockodo",
      "audience": "both",
      "inputs": {
        "entry_id": {
          "label": "Entry ID",
          "type": "number",
          "required": true
        }
      },
      "request": {
        "method": "GET",
        "url": "https://my.clockodo.com/api/v2/entries/{{entry_id}}"
      },
      "result": "$.entry"
    },
    "update_entry": {
      "label": "Update Entry",
      "description": "Updates an entry in clockodo",
      "audience": "both",
      "inputs": {
        "entry_id": {
          "label": "Entry ID",
          "type": "number",
          "required": true
        },
        "customer_id": {
          "label": "Customer",
          "description": "The ID of the customer",
          "type": "number",
          "optionsFrom": {
            "request": {
              "url": "https://my.clockodo.com/api/v2/customers",
              "query": {
                "filter[active]": "true"
              }
            },
            "list": "$.customers",
            "label": "$.name",
            "value": "$.id"
          }
        },
        "project_id": {
          "label": "Project",
          "description": "The ID of the project",
          "type": "number",
          "optionsFrom": {
            "request": {
              "url": "https://my.clockodo.com/api/v2/projects",
              "query": {
                "filter[active]": "true"
              }
            },
            "list": "$.projects",
            "label": "$.name",
            "value": "$.id"
          }
        },
        "service_id": {
          "label": "Service",
          "description": "The ID of the service",
          "type": "number",
          "optionsFrom": {
            "request": {
              "url": "https://my.clockodo.com/api/v2/services"
            },
            "list": "$.services",
            "label": "$.name",
            "value": "$.id"
          }
        },
        "time_since": {
          "label": "Start Time"
        },
        "time_until": {
          "label": "End Time"
        },
        "text": {
          "label": "Description",
          "type": "multiline"
        },
        "user_id": {
          "label": "User",
          "description": "The ID of the user",
          "type": "number",
          "optionsFrom": {
            "request": {
              "url": "https://my.clockodo.com/api/v2/users"
            },
            "list": "$.users",
            "label": "$.name",
            "value": "$.id"
          }
        }
      },
      "request": {
        "method": "PUT",
        "url": "https://my.clockodo.com/api/v2/entries/{{entry_id}}",
        "body": {
          "customers_id": "{{customer_id}}",
          "projects_id": "{{project_id}}",
          "services_id": "{{service_id}}",
          "users_id": "{{user_id}}",
          "text": "{{text}}",
          "time_since": "{{time_since}}",
          "time_until": "{{time_until}}"
        }
      },
      "beforeRequest": "['time_since', 'time_until'].forEach(k => { if (request.body[k]) request.body[k] = request.body[k].replace(/\\.[0-9]{3}/, ''); }); return request;",
      "result": "$.entry"
    },
