      "afterResponse": "const has = v => v !== undefined && v !== null && String(v) !== '';\nconst q = {page: '1'};\nif (has(inputs.page)) q.page = String(inputs.page);\nif (has(inputs.active_filter)) q['filter[active]'] = String(inputs.active_filter);\nif (has(inputs.page)) return {pagination: response.paging, customers: response.customers};\nlet all = response.customers.slice();\nlet total = response.paging.count_pages;\nfor (let p = 2; p <= total; p++) {\n  q.page = String(p);\n  const next = call({method: 'GET', url: '/v2/customers', query: q});\n  total = next.paging.count_pages;\n  all = all.concat(next.customers);\n}\nreturn {customers: all};"
