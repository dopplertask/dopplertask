          "required": true
        }
      },
      "request": {
        "method": "GET",
        "url": "https://my.clockodo.com/api/v2/entries/{{entry_id}}"
      },
      "result": "$.entry"
    },
    "list_entries": {
      "label": "Get Entries",
      "description": "Fetches entries from clockodo",
      "inputs": {
        "time_since": {
          "label": "Start Date",
          "required": true
        },
        "time_until": {
          "label": "End Date",
          "required": true
        },
        "user_id_filter": {
          "label": "Customer ID Filter",
          "description": "Filter entries by their user",
          "type": "number",
          "list": "users"
        },
        "customer_id_filter": {
          "label": "Customer ID Filter",
          "description": "Filter entries by their customer",
          "type": "number",
          "list": "customers"
        },
        "project_id_filter": {
          "label": "Project ID Filter",
          "description": "Filter entries by their project",
          "type": "number",
          "list": "projects_3"
        },
        "service_id_filter": {
          "label": "Service ID Filter",
          "description": "Filter entries by their service",
          "type": "number",
          "list": "services"
        },
        "billable_filter": {
          "label": "Billable",
          "description": "Only show entries that are billable",
          "type": "boolean"
        },
        "billed_filter": {
          "label": "Billed",
          "description": "Only show entries that are already billed",
          "type": "boolean"
        },
        "enhanced_list": {
          "label": "Enhanced List",
          "description": "Retrieves additional information about the entries",
          "type": "boolean"
        },
        "page": {
          "label": "Page",
          "description": "Reads only the specified page",
          "type": "number"
        }
      },
      "request": {
        "method": "GET",
        "url": "https://my.clockodo.com/api/v2/entries"
      },
      "beforeRequest": "const has = v => v !== undefined && v !== null && String(v) !== '';\nconst q = {};\nif (!has(inputs.page)) q.page = '1';\nq.time_since = String(inputs.time_since).replace(/\\.[0-9]{3}/, '');\nq.time_until = String(inputs.time_until).replace(/\\.[0-9]{3}/, '');\nif (has(inputs.page)) {\n  if (has(inputs.enhanced_list)) q.enhanced_list = String(inputs.enhanced_list);\n  q.page = String(inputs.page);\n}\nconst filter = {users_id: inputs.user_id_filter, customers_id: inputs.customer_id_filter, projects_id: inputs.project_id_filter, services_id: inputs.service_id_filter};\nObject.keys(filter).forEach(k => { if (has(filter[k])) q['filter[' + k + ']'] = String(filter[k]); });\nif (has(inputs.billable_filter) || has(inputs.billed_filter)) q['filter[billable]'] = String(inputs.billed_filter) === 'true' ? '2' : String(inputs.billable_filter) === 'true' ? '1' : '0';\nrequest.query = q;\nreturn request;",
      "afterResponse": "const has = v => v !== undefined && v !== null && String(v) !== '';\nconst q = {};\nif (!has(inputs.page)) q.page = '1';\nq.time_since = String(inputs.time_since).replace(/\\.[0-9]{3}/, '');\nq.time_until = String(inputs.time_until).replace(/\\.[0-9]{3}/, '');\nif (has(inputs.page)) {\n  if (has(inputs.enhanced_list)) q.enhanced_list = String(inputs.enhanced_list);\n  q.page = String(inputs.page);\n}\nconst filter = {users_id: inputs.user_id_filter, customers_id: inputs.customer_id_filter, projects_id: inputs.project_id_filter, services_id: inputs.service_id_filter};\nObject.keys(filter).forEach(k => { if (has(filter[k])) q['filter[' + k + ']'] = String(filter[k]); });\nif (has(inputs.billable_filter) || has(inputs.billed_filter)) q['filter[billable]'] = String(inputs.billed_filter) === 'true' ? '2' : String(inputs.billable_filter) === 'true' ? '1' : '0';\nif (has(inputs.page)) return {pagination: response.paging, entries: response.entries};\nlet all = response.entries.slice();\nlet total = response.paging.count_pages;\nfor (let p = 2; p <= total; p++) {\n  q.page = String(p);\n  const next = call({method: 'GET', url: '/v2/entries', query: q});\n  total = next.paging.count_pages;\n  all = all.concat(next.entries);\n}\nreturn {entries: all};"
    },
