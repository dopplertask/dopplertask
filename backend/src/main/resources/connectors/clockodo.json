{
  "name": "clockodo",
  "label": "Clockodo",
  "description": "Time tracking made easy",
  "icon": "",
  "hosts": [
    "my.clockodo.com"
  ],
  "baseUrl": "https://my.clockodo.com/api",
  "upstream": {
    "package": "@activepieces/piece-clockodo",
    "version": "0.2.10"
  },
  "credential": {
    "fields": {
      "email": {
        "label": "E-Mail",
        "description": "The email of your clockodo user",
        "required": true
      },
      "token": {
        "label": "API-Token",
        "description": "Your api token (can be found in profile settings)",
        "secret": true,
        "required": true
      },
      "company_name": {
        "label": "Company Name",
        "description": "Your company name or app name",
        "required": true
      },
      "company_email": {
        "label": "Company E-Mail",
        "description": "A contact email for your company or app",
        "required": true
      }
    },
    "headers": {
      "X-ClockodoApiUser": "{{credential.email}}",
      "X-ClockodoApiKey": "{{credential.token}}",
      "X-Clockodo-External-Application": "{{credential.company_name}};{{credential.company_email}}",
      "Accept-Language": "en"
    }
  },
  "lists": {
    "customers": {
      "request": {
        "url": "https://my.clockodo.com/api/v2/customers",
        "query": {
          "filter[active]": "true"
        }
      },
      "items": "$.customers",
      "label": "$.name",
      "value": "$.id"
    },
    "projects": {
      "request": {
        "url": "https://my.clockodo.com/api/v2/projects",
        "query": {
          "filter[active]": "true"
        }
      },
      "items": "$.projects",
      "label": "$.name",
      "value": "$.id"
    },
    "services": {
      "request": {
        "url": "https://my.clockodo.com/api/v2/services"
      },
      "items": "$.services",
      "label": "$.name",
      "value": "$.id"
    },
    "users": {
      "request": {
        "url": "https://my.clockodo.com/api/v2/users"
      },
      "items": "$.users",
      "label": "$.name",
      "value": "$.id"
    },
    "customers_2": {
      "request": {
        "url": "https://my.clockodo.com/api/v2/customers",
        "query": {
          "filter[active]": "false"
        }
      },
      "items": "$.customers",
      "label": "$.name",
      "value": "$.id"
    },
    "projects_2": {
      "request": {
        "url": "https://my.clockodo.com/api/v2/projects",
        "query": {
          "filter[active]": "false"
        }
      },
      "items": "$.projects",
      "label": "$.name",
      "value": "$.id"
    },
    "projects_3": {
      "request": {
        "url": "https://my.clockodo.com/api/v2/projects"
      },
      "items": "$.projects",
      "label": "$.name",
      "value": "$.id"
    },
    "teams": {
      "request": {
        "url": "https://my.clockodo.com/api/v2/teams"
      },
      "items": "$.teams",
      "label": "$.name",
      "value": "$.id"
    }
  },
  "actions": {
    "create_entry": {
      "label": "Create Entry",
      "description": "Creates an entry in clockodo",
      "inputs": {
        "customer_id": {
          "label": "Customer",
          "description": "The ID of the customer",
          "type": "number",
          "required": true,
          "list": "customers"
        },
        "project_id": {
          "label": "Project",
          "description": "The ID of the project",
          "type": "number",
          "list": "projects"
        },
        "service_id": {
          "label": "Service",
          "description": "The ID of the service",
          "type": "number",
          "required": true,
          "list": "services"
        },
        "time_since": {
          "label": "Start Time",
          "required": true
        },
        "time_until": {
          "label": "End Time",
          "required": true
        },
        "text": {
          "label": "Description",
          "type": "multiline"
        },
        "hourly_rate": {
          "label": "Hourly Rate",
          "type": "number"
        },
        "user_id": {
          "label": "User",
          "description": "The ID of the user",
          "type": "number",
          "list": "users"
        }
      },
      "request": {
        "method": "POST",
        "url": "https://my.clockodo.com/api/v2/entries",
        "body": {
          "customers_id": "{{customer_id}}",
          "projects_id": "{{project_id}}",
          "services_id": "{{service_id}}",
          "time_since": "{{time_since}}",
          "time_until": "{{time_until}}",
          "text": "{{text}}",
          "hourly_rate": "{{hourly_rate}}",
          "users_id": "{{user_id}}"
        }
      },
      "beforeRequest": "['time_since', 'time_until'].forEach(k => { if (request.body[k]) request.body[k] = request.body[k].replace(/\\.[0-9]{3}/, ''); }); return request;",
      "result": "$.entry"
    },
    "delete_entry": {
      "label": "Delete Entry",
      "description": "Deletes an entry in clockodo",
      "inputs": {
        "entry_id": {
          "label": "Entry ID",
          "type": "number",
          "required": true
        }
      },
      "request": {
        "method": "DELETE",
        "url": "https://my.clockodo.com/api/v2/entries/{{entry_id}}"
      }
    },
    "get_entry": {
      "label": "Get Entry",
