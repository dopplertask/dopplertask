  "triggers": {
    "new_entry": {
      "label": "New Entry",
      "description": "Triggers when a new time entry is created",
      "inputs": {},
      "request": {
        "method": "GET",
        "url": "https://my.clockodo.com/api/v2/entries"
      },
      "beforeRequest": "const year = new Date().getFullYear();\nrequest.query = {time_since: (year - 1) + '-01-01T00:00:00Z', time_until: (year + 1) + '-12-31T23:59:59Z'};\nreturn request;",
      "afterResponse": "let res = response;\nif (res.paging && res.paging.count_pages > 1) {\n  const year = new Date().getFullYear();\n  res = call({method: 'GET', url: '/v2/entries', query: {time_since: (year - 1) + '-01-01T00:00:00Z', time_until: (year + 1) + '-12-31T23:59:59Z', page: String(res.paging.count_pages)}});\n}\nreturn (res.entries || []).slice().sort((a, b) => b.id - a.id);",
      "items": "$",
      "newBy": "lastItem",
      "key": "$.id"
    },
    "new_absence_enquiry": {
      "label": "New Absence Enquiry",
      "description": "Triggers when a new absence enquiry is created",
      "inputs": {},
      "request": {
        "method": "GET",
        "url": "https://my.clockodo.com/api/absences"
      },
      "beforeRequest": "request.query = {year: String(new Date().getFullYear())};\nreturn request;",
      "afterResponse": "return (response.absences || []).slice().sort((a, b) => b.id - a.id);",
      "items": "$",
      "newBy": "lastItem",
      "key": "$.id"
    }
  }
}
