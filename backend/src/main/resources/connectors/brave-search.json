{
  "name": "brave-search",
  "label": "Brave Search",
  "description": "Privacy-preserving search engine",
  "icon": "",
  "hosts": [
    "api.search.brave.com"
  ],
  "upstream": {
    "package": "@activepieces/piece-brave-search",
    "version": "0.1.1"
  },
  "credential": {
    "fields": {
      "token": {
        "label": "API Key",
        "description": "Your Brave Search API Key (get it from https://brave.com/search/api/)",
        "secret": true,
        "required": true
      }
    },
    "headers": {
      "x-subscription-token": "{{credential.token}}"
    }
  },
  "actions": {
    "web_search": {
      "label": "Web Search",
      "description": "Search the web using Brave Search",
      "inputs": {
        "query": {
          "label": "Query",
          "description": "The search query",
          "required": true
        },
        "count": {
          "label": "Count",
          "description": "Number of results (1-20)",
          "type": "number",
          "defaultValue": "10"
        }
      },
      "request": {
        "method": "GET",
        "url": "https://api.search.brave.com/res/v1/web/search",
        "query": {
          "q": "{{query}}",
          "count": "{{count}}"
        }
      }
    }
  },
  "triggers": {}
}
