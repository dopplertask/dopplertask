{
  "name": "devin",
  "label": "Devin AI",
  "description": "AI-powered engineering assistant for automating development tasks, code generation, and technical conversations.",
  "icon": "devin",
  "hosts": [
    "api.devin.ai"
  ],
  "upstream": {
    "package": "@activepieces/piece-devin",
    "version": "0.1.6"
  },
  "credential": {
    "fields": {
      "token": {
        "label": "API Key",
        "description": "Your Devin API key (used in the Authorization header).",
        "secret": true,
        "required": true
      }
    },
    "headers": {
      "authorization": "Bearer {{credential.token}}"
    }
  },
  "actions": {
    "create_session": {
      "label": "Create Session",
      "description": "Creates a new Devin session",
      "inputs": {
        "prompt": {
          "label": "Prompt",
          "required": true
        },
        "snapshotId": {
          "label": "Snapshot ID"
        },
        "playbookId": {
          "label": "Playbook ID"
        },
        "unlisted": {
          "label": "Unlisted",
          "type": "boolean"
        },
        "idempotent": {
          "label": "Idempotent",
          "type": "boolean"
        }
      },
      "request": {
        "method": "POST",
        "url": "https://api.devin.ai/v1/sessions",
        "body": {
          "prompt": "{{prompt}}",
          "snapshot_id": "{{snapshotId}}",
          "playbook_id": "{{playbookId}}"
        }
      }
    },
    "get_session_details": {
      "label": "Get Session Details",
      "description": "Retrieves details of a specific Devin session",
      "inputs": {
        "sessionId": {
          "label": "Session ID",
          "description": "The ID of the session to retrieve details for",
          "required": true
        }
      },
      "request": {
        "method": "GET",
        "url": "https://api.devin.ai/v1/session/{{sessionId}}"
      }
    },
    "send_message": {
      "label": "Send Message",
      "description": "Sends a message to a Devin session",
      "inputs": {
        "sessionId": {
          "label": "Session ID",
          "description": "The ID of the session to send the message to",
          "required": true
        },
        "message": {
          "label": "Message",
          "description": "The message to send to the session",
          "required": true,
          "type": "multiline"
        }
      },
      "request": {
        "method": "POST",
        "url": "https://api.devin.ai/v1/session/{{sessionId}}/messages",
        "body": {
          "message": "{{message}}"
        }
      }
    }
  },
  "triggers": {}
}
