{
  "name": "aircall",
  "label": "Aircall",
  "description": "",
  "icon": "aircall",
  "hosts": [
    "api.aircall.io"
  ],
  "upstream": {
    "package": "@activepieces/piece-aircall",
    "version": "0.2.2"
  },
  "credential": {
    "fields": {
      "username": {
        "label": "API ID",
        "required": true
      },
      "password": {
        "label": "API Token",
        "secret": true,
        "required": true
      }
    },
    "basic": {
      "username": "{{credential.username}}",
      "password": "{{credential.password}}"
    }
  },
  "actions": {
    "findContact": {
      "label": "Find Contact",
      "description": "Finds contact based on phone or email.",
      "inputs": {
        "phone_number": {
          "label": "Phone Number",
          "description": "Search by phone number (with country code, e.g., +1234567890)."
        },
        "email": {
          "label": "Email",
          "description": "Search by email address."
        }
      },
      "request": {
        "method": "GET",
        "url": "https://api.aircall.io/v1/contacts/search",
        "query": {
          "phone_number": "{{phone_number}}",
          "email": "{{email}}"
        }
      }
    },
    "getCall": {
      "label": "Get Call",
      "description": "Retrieves details about a specific call.",
      "inputs": {
        "callId": {
          "label": "Call",
          "required": true
        }
      },
      "request": {
        "method": "GET",
        "url": "https://api.aircall.io/v1/calls/{{callId}}",
        "query": {
          "fetch_contact": "true",
          "fetch_short_urls": "true",
          "fetch_call_timeline": "true"
        }
      }
    },
    "updateContact": {
      "label": "Update Contact",
      "description": "Update an existing contact.",
      "inputs": {
        "contactId": {
          "label": "Contact ID",
          "description": "Select the contact to update",
          "required": true
        },
        "first_name": {
          "label": "First Name"
        },
        "last_name": {
          "label": "Last Name",
          "description": "Last name of the contact"
        },
        "company_name": {
          "label": "Company Name"
        },
        "information": {
          "label": "Information",
          "description": "Additional information about the contact",
          "type": "multiline"
        }
      },
      "request": {
        "method": "POST",
        "url": "https://api.aircall.io/v1/contacts/{{contactId}}",
        "body": {
          "first_name": "{{first_name}}",
          "last_name": "{{last_name}}",
          "company_name": "{{company_name}}",
          "information": "{{information}}"
        }
      }
    }
  },
  "triggers": {}
}
