{
  "name": "elastic-email",
  "label": "Elastic Email",
  "description": "Email delivery and marketing platform for sending emails, managing contacts, campaigns, and segments.",
  "icon": "",
  "hosts": [
    "api.elasticemail.com"
  ],
  "upstream": {
    "package": "@activepieces/piece-elastic-email",
    "version": "0.3.3"
  },
  "credential": {
    "fields": {
      "token": {
        "label": "API Key",
        "description": "\nTo obtain your Elastic Email API key:\n1. Log in to your Elastic Email account\n2. Navigate to **Settings → Manage API Keys**\n3. Click **Create API Key**\n4. Ensure the key has the required permissions (Contacts, Campaigns, Emails, Segments)\n5. Copy the key and paste it here\n  ",
        "secret": true,
        "required": true
      }
    },
    "headers": {
      "x-elasticemail-apikey": "{{credential.token}}"
    }
  },
  "actions": {
    "add_contact": {
      "label": "Add Contact to Mailing List",
      "description": "Add a new contact to one or more mailing lists in Elastic Email.",
      "inputs": {
        "email": {
          "label": "Email",
          "description": "The email address of the contact.",
          "required": true
        },
        "listNames": {
          "label": "Mailing Lists",
          "description": "Select mailing lists.",
          "type": "json"
        },
        "status": {
          "label": "Status",
          "description": "Initial status of the contact.",
          "type": "select",
          "options": [
            {
              "value": "Transactional",
              "label": "Transactional"
            },
            {
              "value": "Engaged",
              "label": "Engaged"
            },
            {
              "value": "Active",
              "label": "Active"
            },
            {
              "value": "Bounced",
              "label": "Bounced"
            },
            {
              "value": "Unsubscribed",
              "label": "Unsubscribed"
            },
            {
              "value": "Abuse",
              "label": "Abuse"
            },
            {
              "value": "Inactive",
              "label": "Inactive"
            },
            {
              "value": "Stale",
              "label": "Stale"
            },
            {
              "value": "NotConfirmed",
              "label": "NotConfirmed"
            }
          ]
        },
        "firstName": {
          "label": "First Name"
        },
        "lastName": {
          "label": "Last Name"
        },
        "customFields": {
          "label": "Custom Fields",
          "description": "Key-value pairs of custom contact fields. Only existing custom fields will be saved.",
          "type": "json"
        },
        "consentIP": {
          "label": "Consent IP",
          "description": "IP address of consent. If not provided, your current public IP is used."
        },
        "consentDate": {
          "label": "Consent Date",
          "description": "ISO 8601 date of consent. If not provided, current date is used."
        },
        "consentTracking": {
          "label": "Consent Tracking",
          "description": "Consent tracking level. Defaults to \"Unknown\".",
          "type": "select",
          "options": [
            {
              "value": "Unknown",
              "label": "Unknown"
            },
            {
              "value": "Allow",
              "label": "Allow"
            },
            {
              "value": "Deny",
              "label": "Deny"
            }
          ]
        }
      },
      "request": {
        "method": "POST",
        "url": "https://api.elasticemail.com/v4/contacts",
        "query": {
          "listnames": "{{listNames}}"
        },
        "body": [
          {
            "Email": "{{email}}",
            "FirstName": "{{firstName}}",
            "LastName": "{{lastName}}",
            "Consent": {
              "ConsentIP": "{{consentIP}}",
              "ConsentDate": "{{consentDate}}"
            }
          }
        ]
      }
    },
    "create_contact": {
      "label": "Create Contact",
      "description": "Create a new contact in Elastic Email.",
      "inputs": {
        "email": {
          "label": "Email",
          "description": "The email address of the contact.",
          "required": true
        },
        "status": {
          "label": "Status",
          "description": "Initial status of the contact.",
          "type": "select",
          "options": [
            {
              "value": "Transactional",
              "label": "Transactional"
            },
            {
              "value": "Engaged",
              "label": "Engaged"
            },
            {
              "value": "Active",
              "label": "Active"
            },
            {
              "value": "Bounced",
              "label": "Bounced"
            },
            {
              "value": "Unsubscribed",
              "label": "Unsubscribed"
            },
            {
              "value": "Abuse",
              "label": "Abuse"
            },
            {
              "value": "Inactive",
              "label": "Inactive"
            },
            {
              "value": "Stale",
              "label": "Stale"
            },
            {
              "value": "NotConfirmed",
              "label": "NotConfirmed"
            }
          ]
        },
        "firstName": {
          "label": "First Name"
        },
        "lastName": {
          "label": "Last Name"
        },
        "customFields": {
          "label": "Custom Fields",
          "description": "Key-value pairs of custom contact fields. Only existing custom fields will be saved.",
          "type": "json"
        }
      },
      "request": {
        "method": "POST",
        "url": "https://api.elasticemail.com/v4/contacts",
        "body": [
          {
            "Email": "{{email}}",
            "FirstName": "{{firstName}}",
            "LastName": "{{lastName}}"
          }
        ]
      }
    },
    "create_segment": {
      "label": "Create Segment",
      "description": "Create a new contact segment in Elastic Email using a SQL-like rule.",
      "inputs": {
        "name": {
          "label": "Segment Name",
          "required": true
        },
        "rule": {
          "label": "Rule",
          "description": "SQL-like rule to determine which contacts belong to this segment. See https://help.elasticemail.com/en/articles/5162182-segment-rules",
          "required": true
        }
      },
      "request": {
        "method": "POST",
        "url": "https://api.elasticemail.com/v4/segments",
        "body": {
          "Name": "{{name}}",
          "Rule": "{{rule}}"
        }
      }
    },
    "list_campaigns": {
      "label": "List Campaigns",
      "description": "Fetch a paginated list of campaigns from Elastic Email.",
      "inputs": {
        "search": {
          "label": "Search",
          "description": "Filter campaigns by name."
        },
        "limit": {
          "label": "Limit",
          "description": "Maximum number of campaigns to return (max 100).",
          "type": "number",
          "defaultValue": "100"
        },
        "offset": {
          "label": "Offset",
          "description": "Number of campaigns to skip.",
          "type": "number",
          "defaultValue": "0"
        }
      },
      "request": {
        "method": "GET",
        "url": "https://api.elasticemail.com/v4/campaigns",
        "query": {
          "search": "{{search}}",
          "limit": "{{limit}}",
          "offset": "{{offset}}"
        }
      }
    },
    "list_contacts": {
      "label": "List Contacts",
      "description": "Fetch a paginated list of contacts from Elastic Email.",
      "inputs": {
        "limit": {
          "label": "Limit",
          "description": "Maximum number of contacts to return (max 100).",
          "type": "number",
          "defaultValue": "100"
        },
        "offset": {
          "label": "Offset",
          "description": "Number of contacts to skip.",
          "type": "number",
          "defaultValue": "0"
        }
      },
      "request": {
        "method": "GET",
        "url": "https://api.elasticemail.com/v4/contacts",
        "query": {
          "limit": "{{limit}}",
          "offset": "{{offset}}"
        }
      }
    },
    "update_contact": {
      "label": "Update Contact",
      "description": "Update an existing contact in Elastic Email.",
      "inputs": {
        "contact": {
          "label": "Contact Email",
          "description": "Select an existing contact by email address.",
          "required": true
        },
        "firstName": {
          "label": "First Name"
        },
        "lastName": {
          "label": "Last Name"
        },
        "customFields": {
          "label": "Custom Fields",
          "description": "Key-value pairs of custom contact fields. Only existing custom fields will be saved.",
          "type": "json"
        }
      },
      "request": {
        "method": "PUT",
        "url": "https://api.elasticemail.com/v4/contacts/{{contact}}",
        "body": {
          "FirstName": "{{firstName}}",
          "LastName": "{{lastName}}"
        }
      }
    }
  },
  "triggers": {}
}
