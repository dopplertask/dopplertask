{
  "name": "salesloft",
  "label": "Salesloft",
  "description": "Sales engagement platform for cadences, people, and revenue workflows.",
  "icon": "",
  "hosts": [
    "api.salesloft.com"
  ],
  "upstream": {
    "package": "@activepieces/piece-salesloft",
    "version": "0.1.1"
  },
  "credential": {
    "fields": {
      "token": {
        "label": "API Key",
        "description": "\nTo obtain your Salesloft API key:\n1. Log in to your Salesloft account.\n2. Navigate to **Settings → Integrations → API**.\n3. Click **Generate** to create a new API key.\n4. Copy the key and paste it here.\n  ",
        "secret": true,
        "required": true
      }
    },
    "headers": {
      "authorization": "Bearer {{credential.token}}"
    }
  },
  "actions": {
    "create_person": {
      "label": "Create Person",
      "description": "Create a new person in Salesloft.",
      "inputs": {
        "email_address": {
          "label": "Email Address",
          "description": "Primary email address. Either this or Phone + Last Name is required."
        },
        "first_name": {
          "label": "First Name"
        },
        "last_name": {
          "label": "Last Name"
        },
        "phone": {
          "label": "Phone",
          "description": "Phone number. Required along with Last Name when Email Address is not provided."
        },
        "title": {
          "label": "Job Title"
        },
        "company_name": {
          "label": "Company Name"
        },
        "city": {
          "label": "City"
        },
        "state": {
          "label": "State"
        },
        "country": {
          "label": "Country"
        },
        "linkedin_url": {
          "label": "LinkedIn URL"
        },
        "account_id": {
          "label": "Account",
          "description": "Salesloft account to associate with this person."
        },
        "owner_id": {
          "label": "User (Owner)",
          "description": "Salesloft user who will own this resource. Defaults to the authenticated user if not provided."
        }
      },
      "request": {
        "method": "POST",
        "url": "https://api.salesloft.com/v2/people",
        "body": {
          "email_address": "{{email_address}}",
          "first_name": "{{first_name}}",
          "last_name": "{{last_name}}",
          "phone": "{{phone}}",
          "title": "{{title}}",
          "company_name": "{{company_name}}",
          "city": "{{city}}",
          "state": "{{state}}",
          "country": "{{country}}",
          "linkedin_url": "{{linkedin_url}}",
          "account_id": null,
          "owner_id": null
        }
      }
    },
    "update_person": {
      "label": "Update Person",
      "description": "Update an existing person in Salesloft.",
      "inputs": {
        "person_id": {
          "label": "Person",
          "required": true
        },
        "email_address": {
          "label": "Email Address"
        },
        "first_name": {
          "label": "First Name"
        },
        "last_name": {
          "label": "Last Name"
        },
        "phone": {
          "label": "Phone"
        },
        "title": {
          "label": "Job Title"
        },
        "company_name": {
          "label": "Company Name"
        },
        "city": {
          "label": "City"
        },
        "state": {
          "label": "State"
        },
        "country": {
          "label": "Country"
        },
        "linkedin_url": {
          "label": "LinkedIn URL"
        },
        "account_id": {
          "label": "Account",
          "description": "Salesloft account to associate with this person."
        },
        "owner_id": {
          "label": "User (Owner)",
          "description": "Salesloft user who will own this resource. Defaults to the authenticated user if not provided."
        }
      },
      "request": {
        "method": "PUT",
        "url": "https://api.salesloft.com/v2/people/{{person_id}}",
        "body": {
          "email_address": "{{email_address}}",
          "first_name": "{{first_name}}",
          "last_name": "{{last_name}}",
          "phone": "{{phone}}",
          "title": "{{title}}",
          "company_name": "{{company_name}}",
          "city": "{{city}}",
          "state": "{{state}}",
          "country": "{{country}}",
          "linkedin_url": "{{linkedin_url}}",
          "account_id": null,
          "owner_id": null
        }
      }
    },
    "get_person": {
      "label": "Get Person",
      "description": "Fetch a single person by ID from Salesloft.",
      "inputs": {
        "person_id": {
          "label": "Person",
          "required": true
        }
      },
      "request": {
        "method": "GET",
        "url": "https://api.salesloft.com/v2/people/{{person_id}}"
      }
    },
    "list_people": {
      "label": "List People",
      "description": "Fetch a paginated list of people from Salesloft.",
      "inputs": {
        "email_addresses": {
          "label": "Filter by Email Address",
          "description": "An email address to filter results by. Returns only people matching this email."
        },
        "per_page": {
          "label": "Results Per Page",
          "description": "Number of results per page (max 100).",
          "type": "number",
          "defaultValue": "25"
        },
        "page": {
          "label": "Page",
          "description": "Page number (1-indexed).",
          "type": "number",
          "defaultValue": "1"
        }
      },
      "request": {
        "method": "GET",
        "url": "https://api.salesloft.com/v2/people",
        "query": {
          "per_page": "{{per_page}}",
          "page": "{{page}}",
          "email_addresses[]": "{{email_addresses}}"
        }
      }
    },
    "create_cadence_membership": {
      "label": "Add Person to Cadence",
      "description": "Add a person to a cadence. The person and cadence must be visible to the authenticated user.",
      "inputs": {
        "person_id": {
          "label": "Person",
          "required": true
        },
        "cadence_id": {
          "label": "Cadence",
          "required": true
        },
        "user_id": {
          "label": "User (Owner)",
          "description": "Salesloft user who will own this resource. Defaults to the authenticated user if not provided."
        }
      },
      "request": {
        "method": "POST",
        "url": "https://api.salesloft.com/v2/cadence_memberships",
        "body": {
          "person_id": null,
          "cadence_id": null,
          "user_id": null
        }
      }
    },
    "list_cadences": {
      "label": "List Cadences",
      "description": "Fetch a paginated list of cadences from Salesloft.",
      "inputs": {
        "per_page": {
          "label": "Results Per Page",
          "description": "Number of results per page (max 100).",
          "type": "number",
          "defaultValue": "25"
        },
        "page": {
          "label": "Page",
          "description": "Page number (1-indexed).",
          "type": "number",
          "defaultValue": "1"
        }
      },
      "request": {
        "method": "GET",
        "url": "https://api.salesloft.com/v2/cadences",
        "query": {
          "per_page": "{{per_page}}",
          "page": "{{page}}"
        }
      }
    }
  },
  "triggers": {}
}
