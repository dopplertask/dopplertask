{
  "name": "comfyicu",
  "label": "Comfy.ICU",
  "description": "",
  "icon": "",
  "hosts": [
    "comfy.icu"
  ],
  "upstream": {
    "package": "@activepieces/piece-comfyicu",
    "version": "0.1.7"
  },
  "credential": {
    "fields": {
      "token": {
        "label": "API Key",
        "description": "You can obtain API key from [Account Settings](https://comfy.icu/account).",
        "secret": true,
        "required": true
      }
    },
    "headers": {
      "authorization": "Bearer {{credential.token}}"
    }
  },
  "actions": {
    "get-run-output": {
      "label": "Get Run Output",
      "description": "Retrieves generated images or videos from a completed run.",
      "inputs": {
        "workflow_id": {
          "label": "Workflow ID",
          "required": true
        },
        "run_id": {
          "label": "Run ID",
          "required": true
        }
      },
      "request": {
        "method": "GET",
        "url": "https://comfy.icu/api/v1/workflows/{{workflow_id}}/runs/{{run_id}}"
      }
    },
    "get-run-status": {
      "label": "Get Run Status",
      "description": "Retrieves the status of workflow run.",
      "inputs": {
        "workflow_id": {
          "label": "Workflow ID",
          "required": true
        },
        "run_id": {
          "label": "Run ID",
          "required": true
        }
      },
      "request": {
        "method": "GET",
        "url": "https://comfy.icu/api/v1/workflows/{{workflow_id}}/runs/{{run_id}}"
      }
    },
    "list-workflows": {
      "label": "List Workflows",
      "description": "Retrieves available workflows for execution.",
      "inputs": {},
      "request": {
        "method": "GET",
        "url": "https://comfy.icu/api/v1/workflows"
      }
    }
  },
  "triggers": {}
}
