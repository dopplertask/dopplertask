{
  "name": "bigcommerce",
  "label": "BigCommerce",
  "description": "BigCommerce is a leading e-commerce platform that enables businesses to create and manage online stores.",
  "icon": "",
  "hosts": [
    "api.bigcommerce.com"
  ],
  "baseUrl": "https://api.bigcommerce.com/stores/{{credential.storeHash}}",
  "upstream": {
    "package": "@activepieces/piece-bigcommerce",
    "version": "0.2.2"
  },
  "credential": {
    "fields": {
      "storeHash": {
        "label": "Store Hash",
        "description": "Your BigCommerce store hash (e.g., abcd1234)",
        "required": true
      },
      "accessToken": {
        "label": "Access Token",
        "description": "Your BigCommerce API access token",
        "secret": true,
        "required": true
      }
    },
    "headers": {
      "X-Auth-Token": "{{credential.accessToken}}",
      "Content-Type": "application/json",
      "Accept": "application/json"
    }
  },
  "actions": {
    "createCustomer": {
      "label": "Create Customer",
      "description": "Creates a customer",
      "inputs": {
        "email": {
          "label": "Email",
          "description": "Customer email address",
          "required": true
        },
        "first_name": {
          "label": "First Name",
          "description": "Customer first name",
          "required": true
        },
        "last_name": {
          "label": "Last Name",
          "description": "Customer last name",
          "required": true
        },
        "company": {
          "label": "Company",
          "description": "Customer company name"
        },
        "phone": {
          "label": "Phone",
          "description": "Customer phone number"
        },
        "notes": {
          "label": "Notes",
          "description": "Customer notes",
          "type": "multiline"
        }
      },
      "request": {
        "method": "POST",
        "url": "https://api.bigcommerce.com/stores/{{credential.storeHash}}/v3/customers",
        "body": [
          {
            "email": "{{email}}",
            "first_name": "{{first_name}}",
            "last_name": "{{last_name}}",
            "company": "{{company}}",
            "phone": "{{phone}}",
            "notes": "{{notes}}"
          }
        ]
      },
      "outputs": {
        "id": "$.data[0].id",
        "email": "$.data[0].email"
      }
    },
    "createAProduct": {
      "label": "Create a Product",
      "description": "Creates a Product",
      "inputs": {
        "name": {
          "label": "Product Name",
          "description": "Name of the product",
          "required": true
        },
        "type": {
          "label": "Product Type",
          "description": "Type of product",
          "type": "select",
          "required": true,
          "options": [
            {
              "label": "Physical",
              "value": "physical"
            },
            {
              "label": "Digital",
              "value": "digital"
            }
          ]
        },
        "sku": {
          "label": "SKU",
          "description": "Product SKU"
        },
        "description": {
          "label": "Description",
          "description": "Product description",
          "type": "multiline"
        },
        "weight": {
          "label": "Weight",
          "description": "Product weight",
          "type": "number",
          "required": true
        },
        "price": {
          "label": "Price",
          "description": "Product price",
          "type": "number",
          "required": true
        },
        "brand_id": {
          "label": "Brand ID",
          "description": "Brand ID",
          "type": "number"
        }
      },
      "request": {
        "method": "POST",
        "url": "https://api.bigcommerce.com/stores/{{credential.storeHash}}/v3/catalog/products",
        "body": {
          "name": "{{name}}",
          "type": "{{type}}",
          "sku": "{{sku}}",
          "description": "{{description}}",
          "weight": "{{weight}}",
          "price": "{{price}}",
          "brand_id": "{{brand_id}}"
        }
      },
      "outputs": {
        "id": "$.data.id",
        "name": "$.data.name"
      }
    },
    "updateAProduct": {
      "label": "Update a Product",
      "description": "Updates an existing Product",
      "inputs": {
        "productId": {
          "label": "Product ID",
          "description": "The ID of the product to update",
          "required": true
        },
        "name": {
          "label": "Product Name",
          "description": "Name of the product"
        },
        "type": {
          "label": "Product Type",
          "description": "Type of product",
          "type": "select",
          "options": [
            {
              "label": "Physical",
              "value": "physical"
            },
            {
              "label": "Digital",
              "value": "digital"
            }
          ]
        },
        "sku": {
          "label": "SKU",
          "description": "Product SKU"
        },
        "description": {
          "label": "Description",
          "description": "Product description",
          "type": "multiline"
        },
        "weight": {
          "label": "Weight",
          "description": "Product weight",
          "type": "number"
        },
        "price": {
          "label": "Price",
          "description": "Product price",
          "type": "number"
        },
        "brand_id": {
          "label": "Brand ID",
          "description": "Brand ID",
          "type": "number"
        }
      },
      "request": {
        "method": "PUT",
        "url": "https://api.bigcommerce.com/stores/{{credential.storeHash}}/v3/catalog/products/{{productId}}",
        "body": {
          "name": "{{name}}",
          "type": "{{type}}",
          "sku": "{{sku}}",
          "description": "{{description}}",
          "weight": "{{weight}}",
          "price": "{{price}}",
          "brand_id": "{{brand_id}}"
        }
      },
      "outputs": {
        "id": "$.data.id",
        "name": "$.data.name"
      }
    },
    "deleteAProduct": {
      "label": "Delete a Product",
      "description": "Deletes an existing Product",
      "inputs": {
        "productId": {
          "label": "Product ID",
          "description": "The ID of the product to delete",
          "required": true
        }
      },
      "request": {
        "method": "DELETE",
        "url": "https://api.bigcommerce.com/stores/{{credential.storeHash}}/v3/catalog/products/{{productId}}"
      }
    },
    "getOrder": {
      "label": "Get Order",
      "description": "Gets details of an order",
      "inputs": {
        "orderId": {
          "label": "Order ID",
          "description": "The ID of the order to retrieve",
          "required": true
        }
      },
      "request": {
        "url": "https://api.bigcommerce.com/stores/{{credential.storeHash}}/v2/orders/{{orderId}}"
      },
      "outputs": {
        "id": "$.id",
        "status": "$.status"
      }
    },
    "listOrders": {
      "label": "List Orders",
      "description": "Lists all orders",
      "inputs": {
        "customer_id": {
          "label": "Customer ID",
          "description": "Filter by customer ID",
          "type": "number"
        },
        "status_id": {
          "label": "Status ID",
          "description": "Filter by status ID",
          "type": "number"
        }
      },
      "request": {
        "url": "https://api.bigcommerce.com/stores/{{credential.storeHash}}/v2/orders",
        "query": {
          "customer_id": "{{customer_id}}",
          "status_id": "{{status_id}}"
        }
      }
    },
    "listCategories": {
      "label": "List Categories",
      "description": "Lists all categories",
      "inputs": {
        "name": {
          "label": "Category Name",
          "description": "Filter by category name"
        }
      },
      "request": {
        "url": "https://api.bigcommerce.com/stores/{{credential.storeHash}}/v3/catalog/categories",
        "query": {
          "name": "{{name}}"
        }
      },
      "outputs": {
        "categories": "$.data"
      }
    },
    "createBlogPost": {
      "label": "Create Blog Post",
      "description": "Creates a blog post",
      "inputs": {
        "title": {
          "label": "Title",
          "description": "Blog post title",
          "required": true
        },
        "body": {
          "label": "Body",
          "description": "Blog post content (HTML supported)",
          "type": "multiline",
          "required": true
        },
        "author": {
          "label": "Author",
          "description": "Author name"
        },
        "url": {
          "label": "URL",
          "description": "URL for the public blog post. Example - /blog/welcome-bigcommerce/"
        },
        "published_date": {
          "label": "Published Date",
          "description": "Published Date for the blog post. Example - Wed, 10 Aug 2022 15:39:15 -0500"
        },
        "meta_description": {
          "label": "Meta Description",
          "description": "Description text for this blog post’s <meta/> element.",
          "type": "multiline"
        },
        "meta_keywords": {
          "label": "Meta Keywords",
          "description": "Comma seperated (,) Keywords for this blog post’s <meta/> element. Eg welcome, bigcommerce",
          "type": "multiline"
        },
        "tags": {
          "label": "Tags",
          "description": "Array of tags",
          "type": "json"
        },
        "is_published": {
          "label": "Is Published",
          "description": "Whether the post is published",
          "type": "boolean",
          "defaultValue": "true"
        }
      },
      "request": {
        "method": "POST",
        "url": "https://api.bigcommerce.com/stores/{{credential.storeHash}}/v2/blog/posts",
        "body": {
          "title": "{{title}}",
          "body": "{{body}}",
          "author": "{{author}}",
          "tags": "{{tags}}",
          "is_published": "{{is_published}}",
          "meta_description": "{{meta_description}}",
          "meta_keywords": "{{meta_keywords}}",
          "published_date": "{{published_date}}",
          "url": "{{url}}"
        }
      },
      "outputs": {
        "id": "$.id",
        "url": "$.url"
      }
    },
    "createCustomerAddress": {
      "label": "Create Customer Address",
      "description": "Creates a customer's address",
      "inputs": {
        "customer_id": {
          "label": "Customer",
          "description": "Select the customer",
          "type": "number",
          "required": true,
          "optionsFrom": {
            "request": {
              "url": "https://api.bigcommerce.com/stores/{{credential.storeHash}}/v3/customers"
            },
            "list": "$.data",
            "label": "$.email",
            "value": "$.id"
          }
        },
        "first_name": {
          "label": "First Name",
          "required": true
        },
        "last_name": {
          "label": "Last Name",
          "required": true
        },
        "address1": {
          "label": "Address Line 1",
          "required": true
        },
        "address2": {
          "label": "Address Line 2"
        },
        "city": {
          "label": "City",
          "required": true
        },
        "state_or_province": {
          "label": "State/Province",
          "required": true
        },
        "postal_code": {
          "label": "Postal Code",
          "required": true
        },
        "country_code": {
          "label": "Country Code",
          "description": "ISO 3166-1 alpha-2 country code",
          "required": true
        },
        "phone": {
          "label": "Phone"
        }
      },
      "request": {
        "method": "POST",
        "url": "https://api.bigcommerce.com/stores/{{credential.storeHash}}/v3/customers/addresses",
        "body": [
          {
            "customer_id": "{{customer_id}}",
            "first_name": "{{first_name}}",
            "last_name": "{{last_name}}",
            "address1": "{{address1}}",
            "address2": "{{address2}}",
            "city": "{{city}}",
            "state_or_province": "{{state_or_province}}",
            "postal_code": "{{postal_code}}",
            "country_code": "{{country_code}}",
            "phone": "{{phone}}"
          }
        ]
      },
      "outputs": {
        "id": "$.data[0].id"
      }
    },
    "searchCustomer": {
      "label": "Search Customer",
      "description": "Searches for a registered customer",
      "inputs": {
        "email": {
          "label": "Email",
          "description": "Customer email to search for"
        },
        "phone": {
          "label": "Phone Number",
          "description": "Phone Number to search for"
        },
        "name": {
          "label": "Name",
          "description": "Customer name to search for"
        }
      },
      "request": {
        "url": "https://api.bigcommerce.com/stores/{{credential.storeHash}}/v3/customers",
        "query": {
          "email:in": "{{email}}",
          "name:in": "{{name}}",
          "phone:in": "{{phone}}"
        }
      },
      "outputs": {
        "customers": "$.data"
      }
    },
    "searchProduct": {
      "label": "Search Product",
      "description": "Searches for a product in the catalog",
      "inputs": {
        "name": {
          "label": "Product Name",
          "description": "Product name to search for"
        },
        "sku": {
          "label": "SKU",
          "description": "Product SKU to search for"
        },
        "type": {
          "label": "Product Type",
          "type": "select",
          "options": [
            {
              "label": "Physical",
              "value": "physical"
            },
            {
              "label": "Digital",
              "value": "digital"
            }
          ]
        },
        "brand_id": {
          "label": "Brand ID",
          "description": "Brand ID to search for"
        },
        "weight": {
          "label": "Weight",
          "type": "number"
        },
        "price": {
          "label": "Price",
          "type": "number"
        }
      },
      "request": {
        "url": "https://api.bigcommerce.com/stores/{{credential.storeHash}}/v3/catalog/products",
        "query": {
          "name": "{{name}}",
          "sku": "{{sku}}",
          "brand_id": "{{brand_id}}",
          "type": "{{type}}",
          "price": "{{price}}",
          "weight": "{{weight}}"
        }
      },
      "beforeRequest": "['price', 'weight'].forEach(function (key) { if (key in request.query && !Number(request.query[key])) delete request.query[key]; }); return request;",
      "outputs": {
        "products": "$.data"
      }
    },
    "searchCustomerAddress": {
      "label": "Search Customer Address",
      "description": "Searches for a customer’s address",
      "inputs": {
        "customer_ids": {
          "label": "Customers",
          "description": "Select the customers",
          "type": "json",
          "optionsFrom": {
            "request": {
              "url": "https://api.bigcommerce.com/stores/{{credential.storeHash}}/v3/customers"
            },
            "list": "$.data",
            "label": "$.email",
            "value": "$.id"
          }
        },
        "name": {
          "label": "Name",
          "description": "Customer name to search for"
        }
      },
      "request": {
        "url": "https://api.bigcommerce.com/stores/{{credential.storeHash}}/v3/customers/addresses",
        "query": {
          "name:in": "{{name}}"
        }
      },
      "beforeRequest": "if (inputs.customer_ids) request.query['customer_ids:in'] = JSON.parse(inputs.customer_ids).join(','); return request;",
      "outputs": {
        "addresses": "$.data"
      }
    },
    "findOrCreateCustomer": {
      "label": "Find or Create Customer",
      "description": "Finds or creates a customer",
      "inputs": {
        "email": {
          "label": "Email",
          "description": "Customer email address",
          "required": true
        },
        "first_name": {
          "label": "First Name",
          "description": "Customer first name",
          "required": true
        },
        "last_name": {
          "label": "Last Name",
          "description": "Customer last name",
          "required": true
        },
        "company": {
          "label": "Company",
          "description": "Customer company name"
        },
        "phone": {
          "label": "Phone",
          "description": "Customer phone number"
        },
        "notes": {
          "label": "Notes",
          "description": "Customer notes",
          "type": "multiline"
        }
      },
      "request": {
        "url": "https://api.bigcommerce.com/stores/{{credential.storeHash}}/v3/customers"
      },
      "beforeRequest": "function form(params) { return Object.keys(params).filter(function (key) { return params[key] !== ''; }).map(function (key) { return [key, params[key]].map(function (part) { return encodeURIComponent(part).replace(/%20/g, '+').replace(/[!'()~]/g, function (c) { return '%' + c.charCodeAt(0).toString(16).toUpperCase(); }); }).join('='); }).join('&'); }\nrequest.url += '?' + form({'email:in': inputs.email, 'phone:in': inputs.phone || ''});\nreturn request;",
      "afterResponse": "if (response.data && response.data.length > 0) return {found: true, data: response.data};\nfunction filled(keys) { const body = {}; keys.forEach(function (key) { if (inputs[key] !== undefined && inputs[key] !== '') body[key] = [].indexOf(key) >= 0 ? Number(inputs[key]) : inputs[key]; }); return body; }\nconst created = call({method: 'POST', url: '/v3/customers', body: [filled(['email', 'first_name', 'last_name', 'company', 'phone', 'notes'])]});\nreturn {found: false, data: created.data};",
      "outputs": {
        "found": "$.found",
        "data": "$.data"
      }
    },
    "findOrCreateProduct": {
      "label": "Find or Create Product",
      "description": "Finds or creates a product",
      "inputs": {
        "name": {
          "label": "Product Name",
          "required": true
        },
        "sku": {
          "label": "SKU"
        },
        "type": {
          "label": "Product Type",
          "type": "select",
          "required": true,
          "options": [
            {
              "label": "Physical",
              "value": "physical"
            },
            {
              "label": "Digital",
              "value": "digital"
            }
          ]
        },
        "weight": {
          "label": "Weight",
          "type": "number",
          "required": true
        },
        "price": {
          "label": "Price",
          "type": "number",
          "required": true
        },
        "description": {
          "label": "Description",
          "type": "multiline"
        },
        "brand_id": {
          "label": "Brand ID",
          "description": "Brand ID",
          "type": "number"
        }
      },
      "request": {
        "url": "https://api.bigcommerce.com/stores/{{credential.storeHash}}/v3/catalog/products"
      },
      "beforeRequest": "function form(params) { return Object.keys(params).filter(function (key) { return params[key] !== ''; }).map(function (key) { return [key, params[key]].map(function (part) { return encodeURIComponent(part).replace(/%20/g, '+').replace(/[!'()~]/g, function (c) { return '%' + c.charCodeAt(0).toString(16).toUpperCase(); }); }).join('='); }).join('&'); }\nrequest.url += '?' + form({name: inputs.name});\nreturn request;",
      "afterResponse": "if (response.data && response.data.length > 0) return {found: true, data: response.data};\nfunction filled(keys) { const body = {}; keys.forEach(function (key) { if (inputs[key] !== undefined && inputs[key] !== '') body[key] = ['weight','price','brand_id'].indexOf(key) >= 0 ? Number(inputs[key]) : inputs[key]; }); return body; }\nconst created = call({method: 'POST', url: '/v3/catalog/products', body: filled(['name', 'type', 'sku', 'description', 'weight', 'price', 'brand_id'])});\nreturn {found: false, data: created.data};",
      "outputs": {
        "found": "$.found",
        "data": "$.data"
      }
    },
    "findOrCreateCustomersAddress": {
      "label": "Find or Create Customer’s Address",
      "description": "Finds or creates a customer’s address",
      "inputs": {
        "customer_id": {
          "label": "Customer",
          "description": "Select the customer",
          "type": "number",
          "required": true,
          "optionsFrom": {
            "request": {
              "url": "https://api.bigcommerce.com/stores/{{credential.storeHash}}/v3/customers"
            },
            "list": "$.data",
            "label": "$.email",
            "value": "$.id"
          }
        },
        "first_name": {
          "label": "First Name",
          "required": true
        },
        "last_name": {
          "label": "Last Name",
          "required": true
        },
        "address1": {
          "label": "Address Line 1",
          "required": true
        },
        "address2": {
          "label": "Address Line 2"
        },
        "city": {
          "label": "City",
          "required": true
        },
        "state_or_province": {
          "label": "State/Province",
          "required": true
        },
        "postal_code": {
          "label": "Postal Code",
          "required": true
        },
        "country_code": {
          "label": "Country Code",
          "description": "ISO 3166-1 alpha-2 country code",
          "required": true
        },
        "phone": {
          "label": "Phone"
        }
      },
      "request": {
        "url": "https://api.bigcommerce.com/stores/{{credential.storeHash}}/v3/customers/addresses"
      },
      "beforeRequest": "function form(params) { return Object.keys(params).filter(function (key) { return params[key] !== ''; }).map(function (key) { return [key, params[key]].map(function (part) { return encodeURIComponent(part).replace(/%20/g, '+').replace(/[!'()~]/g, function (c) { return '%' + c.charCodeAt(0).toString(16).toUpperCase(); }); }).join('='); }).join('&'); }\nrequest.url += '?' + form({'customer_id:in': inputs.customer_id});\nreturn request;",
      "afterResponse": "const existing = (response.data || []).find(function (address) { return address.address1 === inputs.address1 && address.city === inputs.city && address.postal_code === inputs.postal_code; });\nif (existing) return {found: true, data: existing};\nfunction filled(keys) { const body = {}; keys.forEach(function (key) { if (inputs[key] !== undefined && inputs[key] !== '') body[key] = ['customer_id'].indexOf(key) >= 0 ? Number(inputs[key]) : inputs[key]; }); return body; }\nconst created = call({method: 'POST', url: '/v3/customers/addresses', body: [filled(['customer_id', 'first_name', 'last_name', 'address1', 'address2', 'city', 'state_or_province', 'postal_code', 'country_code', 'phone'])]});\nreturn {found: false, data: created.data};",
      "outputs": {
        "found": "$.found",
        "data": "$.data"
      }
    }
  },
  "triggers": {
    "abandonedCart": {
      "label": "Abandoned Cart",
      "description": "Triggers when a cart is abandoned",
      "webhook": {
        "subscribe": {
          "method": "POST",
          "url": "https://api.bigcommerce.com/stores/{{credential.storeHash}}/v3/hooks",
          "body": {
            "scope": "store/cart/abandoned",
            "destination": "{{webhookUrl}}",
            "is_active": true
          }
        },
        "id": "$.data.id",
        "unsubscribe": {
          "method": "DELETE",
          "url": "https://api.bigcommerce.com/stores/{{credential.storeHash}}/v3/hooks/{{webhookId}}"
        }
      },
      "afterResponse": "return [response];",
      "items": "$"
    },
    "cartCreated": {
      "label": "Cart Created",
      "description": "Triggers when a new cart is created",
      "webhook": {
        "subscribe": {
          "method": "POST",
          "url": "https://api.bigcommerce.com/stores/{{credential.storeHash}}/v3/hooks",
          "body": {
            "scope": "store/cart/created",
            "destination": "{{webhookUrl}}",
            "is_active": true
          }
        },
        "id": "$.data.id",
        "unsubscribe": {
          "method": "DELETE",
          "url": "https://api.bigcommerce.com/stores/{{credential.storeHash}}/v3/hooks/{{webhookId}}"
        }
      },
      "afterResponse": "return [response];",
      "items": "$"
    },
    "customerAddressCreated": {
      "label": "Customer Address Created",
      "description": "Triggers when a new customer address is created",
      "webhook": {
        "subscribe": {
          "method": "POST",
          "url": "https://api.bigcommerce.com/stores/{{credential.storeHash}}/v3/hooks",
          "body": {
            "scope": "store/customer/address/created",
            "destination": "{{webhookUrl}}",
            "is_active": true
          }
