{
  "name": "leexi",
  "label": "Leexi",
  "description": "AI Notetaker",
  "icon": "",
  "hosts": [
    "public-api.leexi.ai"
  ],
  "upstream": {
    "package": "@activepieces/piece-leexi",
    "version": "0.3.1"
  },
  "credential": {
    "fields": {
      "username": {
        "label": "Key ID",
        "required": true
      },
      "password": {
        "label": "Key Secret",
        "secret": true,
        "required": true
      }
    },
    "basic": {
      "username": "{{credential.username}}",
      "password": "{{credential.password}}"
    }
  },
  "actions": {
    "get-call": {
      "label": "Get Call",
      "description": "Gets call details.",
      "inputs": {
        "callId": {
          "label": "Call ID",
          "description": "The UUID of the Leexi call.",
          "required": true
        }
      },
      "request": {
        "method": "GET",
        "url": "https://public-api.leexi.ai/v1/calls/{{callId}}"
      }
    },
    "fetch_call_transcript": {
      "label": "Fetch Call Transcript",
      "description": "Get the timestamped, speaker-labelled transcript of a Leexi call.",
      "inputs": {
        "call_uuid": {
          "label": "Call UUID",
          "description": "UUID of the call. Get it from Query Calls.",
          "required": true
        }
      },
      "request": {
        "method": "GET",
        "url": "https://public-api.leexi.ai/v1/calls/{{call_uuid}}"
      }
    },
    "list_users": {
      "label": "List Users",
      "description": "List the users of the Leexi workspace.",
      "inputs": {
        "items": {
          "label": "Results per Page",
          "description": "Number of users per page, 1-100. Defaults to 100.",
          "type": "number",
          "defaultValue": "100"
        },
        "page": {
          "label": "Page",
          "description": "Page number, starting at 1.",
          "type": "number",
          "defaultValue": "1"
        }
      },
      "request": {
        "method": "GET",
        "url": "https://public-api.leexi.ai/v1/users",
        "query": {
          "items": "100",
          "page": "{{page}}"
        }
      }
    }
  },
  "triggers": {}
}
