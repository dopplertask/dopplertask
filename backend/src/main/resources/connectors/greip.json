{
  "name": "greip",
  "label": "Greip",
  "description": "Detect and prevent fraud in your website or app with Greip's Fraud Prevention API. Protect your business from financial losses and gain better insights into your users.",
  "icon": "",
  "hosts": [
    "greipapi.com"
  ],
  "upstream": {
    "package": "@activepieces/piece-greip",
    "version": "0.1.8"
  },
  "credential": {
    "fields": {
      "token": {
        "label": "API Key",
        "description": "\nTo get your API Key:\n\n1. Go to your Greip account dashboard\n2. Navigate to API settings\n3. Copy your API key\n4. Paste it here\n",
        "secret": true,
        "required": true
      }
    },
    "headers": {
      "authorization": "Bearer {{credential.token}}"
    }
  },
  "actions": {
    "asn_lookup": {
      "label": "ASN Lookup",
      "description": "Look up details of an Autonomous System Number (ASN)",
      "inputs": {
        "asn": {
          "label": "AS Number",
          "description": "The AS Number to lookup (e.g., AS6167 or 6167)",
          "required": true
        },
        "format": {
          "label": "Response Format",
          "description": "Format of the response",
          "type": "select",
          "options": [
            {
              "value": "JSON",
              "label": "JSON"
            },
            {
              "value": "XML",
              "label": "XML"
            },
            {
              "value": "CSV",
              "label": "CSV"
            },
            {
              "value": "Newline",
              "label": "Newline"
            }
          ],
          "defaultValue": "JSON"
        },
        "mode": {
          "label": "Environment",
          "description": "Environment mode for testing or production",
          "type": "select",
          "options": [
            {
              "value": "live",
              "label": "Live"
            },
            {
              "value": "test",
              "label": "Test"
            }
          ],
          "defaultValue": "live"
        },
        "callback": {
          "label": "JSONP Callback",
          "description": "Function name for JSONP response format"
        }
      },
      "request": {
        "method": "GET",
        "url": "https://greipapi.com/lookup/asn",
        "query": {
          "asn": "{{asn}}",
          "callback": "{{callback}}"
        }
      }
    },
    "bin_lookup": {
      "label": "BIN Lookup",
      "description": "Look up details of a Bank Identification Number (BIN) or Issuer Identification Number (IIN)",
      "inputs": {
        "bin": {
          "label": "BIN/IIN",
          "description": "The BIN/IIN of the card (minimum 6 digits). Can be partial like \"456789\" or full card number",
          "required": true
        },
        "format": {
          "label": "Response Format",
          "description": "Format of the response",
          "type": "select",
          "options": [
            {
              "value": "JSON",
              "label": "JSON"
            },
            {
              "value": "XML",
              "label": "XML"
            },
            {
              "value": "CSV",
              "label": "CSV"
            },
            {
              "value": "Newline",
              "label": "Newline"
            }
          ],
          "defaultValue": "JSON"
        },
        "mode": {
          "label": "Environment",
          "description": "Environment mode for testing or production",
          "type": "select",
          "options": [
            {
              "value": "live",
              "label": "Live"
            },
            {
              "value": "test",
              "label": "Test"
            }
          ],
          "defaultValue": "live"
        },
        "userID": {
          "label": "User Identifier",
          "description": "Identify requests from specific users for monitoring (e.g., email, phone, user ID)"
        },
        "callback": {
          "label": "JSONP Callback",
          "description": "Function name for JSONP response format"
        }
      },
      "request": {
        "method": "GET",
        "url": "https://greipapi.com/lookup/bin",
        "query": {
          "bin": "{{bin}}",
          "userID": "{{userID}}",
          "callback": "{{callback}}"
        }
      }
    },
    "ip_lookup": {
      "label": "IP Lookup",
      "description": "Look up comprehensive information about an IP address including location, ISP, security, and risk factors",
      "inputs": {
        "ip": {
          "label": "IP Address",
          "description": "The IP address to lookup (IPv4 or IPv6)",
          "required": true
        },
        "params": {
          "label": "Modules",
          "description": "Comma-separated list of modules to include: security, currency, timezone, location (e.g., \"security,timezone,currency\")"
        },
        "format": {
          "label": "Response Format",
          "description": "Format of the response",
          "type": "select",
          "options": [
            {
              "value": "JSON",
              "label": "JSON"
            },
            {
              "value": "XML",
              "label": "XML"
            },
            {
              "value": "CSV",
              "label": "CSV"
            },
            {
              "value": "Newline",
              "label": "Newline"
            }
          ],
          "defaultValue": "JSON"
        },
        "lang": {
          "label": "Response Language",
          "description": "Language for the response",
          "type": "select",
          "options": [
            {
              "value": "EN",
              "label": "English"
            },
            {
              "value": "AR",
              "label": "Arabic"
            },
            {
              "value": "DE",
              "label": "German"
            },
            {
              "value": "FR",
              "label": "French"
            },
            {
              "value": "ES",
              "label": "Spanish"
            },
            {
              "value": "JA",
              "label": "Japanese"
            },
            {
              "value": "ZH",
              "label": "Chinese"
            },
            {
              "value": "RU",
              "label": "Russian"
            }
          ],
          "defaultValue": "EN"
        },
        "mode": {
          "label": "Environment",
          "description": "Environment mode for testing or production",
          "type": "select",
          "options": [
            {
              "value": "live",
              "label": "Live"
            },
            {
              "value": "test",
              "label": "Test"
            }
          ],
          "defaultValue": "live"
        },
        "userID": {
          "label": "User Identifier",
          "description": "Identify requests from specific users for monitoring (e.g., email, phone, user ID)"
        },
        "callback": {
          "label": "JSONP Callback",
          "description": "Function name for JSONP response format"
        }
      },
      "request": {
        "method": "GET",
        "url": "https://greipapi.com/lookup/ip",
        "query": {
          "ip": "{{ip}}",
          "params": "{{params}}",
          "userID": "{{userID}}",
          "callback": "{{callback}}"
        }
      }
    },
    "email_validation": {
      "label": "Email Validation",
      "description": "Validate email addresses by checking domain validity, detecting disposable emails, and assessing risk factors",
      "inputs": {
        "email": {
          "label": "Email Address",
          "description": "The email address to validate",
          "required": true
        },
        "format": {
          "label": "Response Format",
          "description": "Format of the response",
          "type": "select",
          "options": [
            {
              "value": "JSON",
              "label": "JSON"
            },
            {
              "value": "XML",
              "label": "XML"
            },
            {
              "value": "CSV",
              "label": "CSV"
            },
            {
              "value": "Newline",
              "label": "Newline"
            }
          ],
          "defaultValue": "JSON"
        },
        "mode": {
          "label": "Environment",
          "description": "Environment mode for testing or production",
          "type": "select",
          "options": [
            {
              "value": "live",
              "label": "Live"
            },
            {
              "value": "test",
              "label": "Test"
            }
          ],
          "defaultValue": "live"
        },
        "userID": {
          "label": "User Identifier",
          "description": "Identify requests from specific users for monitoring (e.g., email, phone, user ID)"
        },
        "callback": {
          "label": "JSONP Callback",
          "description": "Function name for JSONP response format"
        }
      },
      "request": {
        "method": "GET",
        "url": "https://greipapi.com/scoring/email",
        "query": {
          "email": "{{email}}",
          "userID": "{{userID}}",
          "callback": "{{callback}}"
        }
      }
    },
    "profanity_detection": {
      "label": "Detect Profanity",
      "description": "Detect offensive or inappropriate language in text using machine learning",
      "inputs": {
        "text": {
          "label": "Text",
          "description": "The text to check for profanity",
          "required": true,
          "type": "multiline"
        },
        "scoreOnly": {
          "label": "Score Only",
          "description": "Return only the score and safety status",
          "type": "select",
          "options": [
            {
              "value": "no",
              "label": "No"
            },
            {
              "value": "yes",
              "label": "Yes"
            }
          ],
          "defaultValue": "no"
        },
        "listBadWords": {
          "label": "List Bad Words",
          "description": "Include a list of bad words found in the text",
          "type": "select",
          "options": [
            {
              "value": "no",
              "label": "No"
            },
            {
              "value": "yes",
              "label": "Yes"
            }
          ],
          "defaultValue": "no"
        },
        "format": {
          "label": "Response Format",
          "description": "Format of the response",
          "type": "select",
          "options": [
            {
              "value": "JSON",
              "label": "JSON"
            },
            {
              "value": "XML",
              "label": "XML"
            },
            {
              "value": "CSV",
              "label": "CSV"
            }
          ],
          "defaultValue": "JSON"
        },
        "mode": {
          "label": "Environment",
          "description": "Environment mode for testing or production",
          "type": "select",
          "options": [
            {
              "value": "live",
              "label": "Live"
            },
            {
              "value": "test",
              "label": "Test"
            }
          ],
          "defaultValue": "live"
        },
        "callback": {
          "label": "JSONP Callback",
          "description": "Function name for JSONP response format"
        }
      },
      "request": {
        "method": "GET",
        "url": "https://greipapi.com/scoring/profanity",
        "query": {
          "text": "{{text}}",
          "callback": "{{callback}}"
        }
      }
    },
    "phone_validation": {
      "label": "Phone Validation",
      "description": "Validate phone numbers by checking syntax and assessing validity and operational status",
      "inputs": {
        "phone": {
          "label": "Phone Number",
          "description": "The phone number to validate (e.g., +12121234567, 0012121234567, 12121234567, or 2121234567)",
          "required": true
        },
        "countryCode": {
          "label": "Country Code",
          "description": "ISO 3166-1 alpha-2 country code (e.g., US, GB, FR)",
          "required": true
        },
        "format": {
          "label": "Response Format",
          "description": "Format of the response",
          "type": "select",
          "options": [
            {
              "value": "JSON",
              "label": "JSON"
            },
            {
              "value": "XML",
              "label": "XML"
            },
            {
              "value": "CSV",
              "label": "CSV"
            },
            {
              "value": "Newline",
              "label": "Newline"
            }
          ],
          "defaultValue": "JSON"
        },
        "mode": {
          "label": "Environment",
          "description": "Environment mode for testing or production",
          "type": "select",
          "options": [
            {
              "value": "live",
              "label": "Live"
            },
            {
              "value": "test",
              "label": "Test"
            }
          ],
          "defaultValue": "live"
        },
        "userID": {
          "label": "User Identifier",
          "description": "Identify requests from specific users for monitoring (e.g., email, phone, user ID)"
        },
        "callback": {
          "label": "JSONP Callback",
          "description": "Function name for JSONP response format"
        }
      },
      "request": {
        "method": "GET",
        "url": "https://greipapi.com/scoring/phone",
        "query": {
          "phone": "{{phone}}",
          "countryCode": "{{countryCode}}",
          "userID": "{{userID}}",
          "callback": "{{callback}}"
        }
      }
    }
  },
  "triggers": {}
}
