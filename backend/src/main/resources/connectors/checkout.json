{
  "name": "checkout",
  "label": "Checkout.com",
  "description": "",
  "icon": "",
  "hosts": [
    "api.checkout.com"
  ],
  "upstream": {
    "package": "@activepieces/piece-checkout",
    "version": "0.1.7"
  },
  "credential": {
    "fields": {
      "token": {
        "label": "Secret Key",
        "description": "Your Checkout.com secret key. Use sandbox key (sk_sbox_...) for testing or production key (sk_...) for live transactions. You can find it in the Checkout.com dashboard under Developers > API keys.",
        "secret": true,
        "required": true
      }
    },
    "headers": {
      "authorization": "Bearer {{credential.token}}"
    }
  },
  "actions": {
    "create_payment_link": {
      "label": "Create Payment Link",
      "description": "Create a Payment Link to accept and process payment details.",
      "inputs": {
        "amount": {
          "label": "Amount",
          "description": "The payment amount in minor units (e.g., cents for USD)",
          "required": true,
          "type": "number"
        },
        "currency": {
          "label": "Currency",
          "description": "The three-letter ISO currency code (e.g., USD, EUR)",
          "required": true
        },
        "reference": {
          "label": "Reference",
          "description": "A reference to identify the payment (e.g., order number)"
        },
        "description": {
          "label": "Description",
          "description": "A description of the payment",
          "type": "multiline"
        },
        "billing_country": {
          "label": "Billing Country",
          "description": "The two-letter ISO country code (e.g., US, GB)",
          "required": true
        },
        "billing_address_line1": {
          "label": "Billing Address Line 1",
          "description": "The first line of the billing address"
        },
        "billing_address_line2": {
          "label": "Billing Address Line 2",
          "description": "The second line of the billing address"
        },
        "billing_city": {
          "label": "Billing City",
          "description": "The billing address city"
        },
        "billing_state": {
          "label": "Billing State",
          "description": "The state or province (ISO 3166-2 code)"
        },
        "billing_zip": {
          "label": "Billing ZIP",
          "description": "The billing address zip or postal code"
        },
        "billing_phone_country_code": {
          "label": "Billing Phone Country Code",
          "description": "The international country calling code (e.g., +1)"
        },
        "billing_phone_number": {
          "label": "Billing Phone Number",
          "description": "The phone number (6-25 characters)"
        },
        "customer_email": {
          "label": "Customer Email",
          "description": "The customer's email address"
        },
        "customer_name": {
          "label": "Customer Name",
          "description": "The customer's name"
        },
        "customer_phone_country_code": {
          "label": "Customer Phone Country Code",
          "description": "The international country calling code (e.g., +1)"
        },
        "customer_phone_number": {
          "label": "Customer Phone Number",
          "description": "The customer's phone number"
        },
        "expires_in": {
          "label": "Expires In (seconds)",
          "description": "Time for which the link remains valid (default: 86400)",
          "type": "number"
        },
        "display_name": {
          "label": "Display Name",
          "description": "The merchant name to display to customers on the checkout page"
        },
        "return_url": {
          "label": "Return URL",
          "description": "URL to redirect customer after successful payment"
        },
        "locale": {
          "label": "Locale",
          "description": "Language and region for the payment page",
          "type": "select",
          "options": [
            {
              "value": "en-GB",
              "label": "English (GB)"
            },
            {
              "value": "ar",
              "label": "Arabic"
            },
            {
              "value": "da-DK",
              "label": "Danish (Denmark)"
            },
            {
              "value": "de-DE",
              "label": "German (Germany)"
            },
            {
              "value": "el",
              "label": "Greek"
            },
            {
              "value": "es-ES",
              "label": "Spanish (Spain)"
            },
            {
              "value": "fi-FI",
              "label": "Finnish (Finland)"
            },
            {
              "value": "fil-PH",
              "label": "Filipino (Philippines)"
            },
            {
              "value": "fr-FR",
              "label": "French (France)"
            },
            {
              "value": "hi-IN",
              "label": "Hindi (India)"
            },
            {
              "value": "id-ID",
              "label": "Indonesian (Indonesia)"
            },
            {
              "value": "it-IT",
              "label": "Italian (Italy)"
            },
            {
              "value": "ja-JP",
              "label": "Japanese (Japan)"
            },
            {
              "value": "ms-MY",
              "label": "Malay (Malaysia)"
            },
            {
              "value": "nb-NO",
              "label": "Norwegian (Norway)"
            },
            {
              "value": "nl-NL",
              "label": "Dutch (Netherlands)"
            },
            {
              "value": "pt-PT",
              "label": "Portuguese (Portugal)"
            },
            {
              "value": "sv-SE",
              "label": "Swedish (Sweden)"
            },
            {
              "value": "th-TH",
              "label": "Thai (Thailand)"
            },
            {
              "value": "vi-VN",
              "label": "Vietnamese (Vietnam)"
            },
            {
              "value": "zh-CN",
              "label": "Chinese (China)"
            },
            {
              "value": "zh-HK",
              "label": "Chinese (Hong Kong)"
            },
            {
              "value": "zh-TW",
              "label": "Chinese (Taiwan)"
            }
          ]
        },
        "allow_payment_methods": {
          "label": "Allow Payment Methods",
          "description": "Specific payment methods to present to customers",
          "type": "json",
          "options": [
            {
              "value": "card",
              "label": "Card"
            },
            {
              "value": "paypal",
              "label": "PayPal"
            },
            {
              "value": "applepay",
              "label": "Apple Pay"
            },
            {
              "value": "googlepay",
              "label": "Google Pay"
            },
            {
              "value": "klarna",
              "label": "Klarna"
            },
            {
              "value": "alipay_cn",
              "label": "Alipay CN"
            },
            {
              "value": "bancontact",
              "label": "Bancontact"
            },
            {
              "value": "ideal",
              "label": "iDEAL"
            },
            {
              "value": "sepa",
              "label": "SEPA"
            },
            {
              "value": "benefit",
              "label": "Benefit"
            },
            {
              "value": "knet",
              "label": "KNet"
            },
            {
              "value": "stcpay",
              "label": "STC Pay"
            },
            {
              "value": "tabby",
              "label": "Tabby"
            },
            {
              "value": "tamara",
              "label": "Tamara"
            }
          ]
        },
        "disabled_payment_methods": {
          "label": "Disabled Payment Methods",
          "description": "Payment methods to NOT present to customers",
          "type": "json",
          "options": [
            {
              "value": "card",
              "label": "Card"
            },
            {
              "value": "paypal",
              "label": "PayPal"
            },
            {
              "value": "applepay",
              "label": "Apple Pay"
            },
            {
              "value": "googlepay",
              "label": "Google Pay"
            },
            {
              "value": "klarna",
              "label": "Klarna"
            },
            {
              "value": "alipay_cn",
              "label": "Alipay CN"
            },
            {
              "value": "bancontact",
              "label": "Bancontact"
            },
            {
              "value": "ideal",
              "label": "iDEAL"
            },
            {
              "value": "sepa",
              "label": "SEPA"
            },
            {
              "value": "benefit",
              "label": "Benefit"
            },
            {
              "value": "knet",
              "label": "KNet"
            },
            {
              "value": "stcpay",
              "label": "STC Pay"
            },
            {
              "value": "tabby",
              "label": "Tabby"
            },
            {
              "value": "tamara",
              "label": "Tamara"
            }
          ]
        },
        "products": {
          "label": "Products",
          "description": "Details about the products in the order",
          "type": "json"
        },
        "shipping_country": {
          "label": "Shipping Country",
          "description": "The two-letter ISO country code for shipping"
        },
        "shipping_address_line1": {
          "label": "Shipping Address Line 1",
          "description": "The first line of the shipping address"
        },
        "shipping_address_line2": {
          "label": "Shipping Address Line 2",
          "description": "The second line of the shipping address"
        },
        "shipping_city": {
          "label": "Shipping City",
          "description": "The shipping address city"
        },
        "shipping_state": {
          "label": "Shipping State",
          "description": "The state or province for shipping"
        },
        "shipping_zip": {
          "label": "Shipping ZIP",
          "description": "The shipping address zip or postal code"
        },
        "payment_type": {
          "label": "Payment Type",
          "description": "Type of payment for card transactions",
          "type": "select",
          "options": [
            {
              "value": "Regular",
              "label": "Regular"
            },
            {
              "value": "Recurring",
              "label": "Recurring"
            }
          ]
        },
        "processing_channel_id": {
          "label": "Processing Channel ID",
          "description": "The processing channel to be used for the payment. Find this in your Checkout.com dashboard under Settings > Processing Channels. Format: pc_xxxxxxxxxxxxxxxxxxxxxxxxxx",
          "required": true
        },
        "capture": {
          "label": "Capture Payment",
          "description": "Whether to capture the payment immediately",
          "type": "boolean"
        },
        "enable_3ds": {
          "label": "Enable 3D Secure",
          "description": "Whether to process as 3D Secure payment",
          "type": "boolean"
        },
        "challenge_3ds": {
          "label": "3DS Challenge Preference",
          "description": "Preference for 3DS challenge",
          "type": "select",
          "options": [
            {
              "value": "no_preference",
              "label": "No Preference"
            },
            {
              "value": "no_challenge_requested",
              "label": "No Challenge Requested"
            },
            {
              "value": "challenge_requested",
              "label": "Challenge Requested"
            }
          ]
        },
        "metadata": {
          "label": "Metadata",
          "description": "Additional key-value pairs for transaction information",
          "type": "json"
        }
      },
      "request": {
        "method": "POST",
        "url": "https://api.checkout.com/payment-links",
        "body": {
          "amount": "{{amount}}",
          "currency": "{{currency}}",
          "billing": {
            "address": {
              "country": "{{billing_country}}",
              "address_line1": "{{billing_address_line1}}",
              "address_line2": "{{billing_address_line2}}",
              "city": "{{billing_city}}",
              "state": "{{billing_state}}",
              "zip": "{{billing_zip}}"
            },
            "phone": {
              "country_code": "{{billing_phone_country_code}}",
              "number": "{{billing_phone_number}}"
            }
          },
          "reference": "{{reference}}",
          "description": "{{description}}",
          "display_name": "{{display_name}}",
          "return_url": "{{return_url}}",
          "expires_in": "{{expires_in}}",
          "processing_channel_id": "{{processing_channel_id}}",
          "customer": {
            "email": "{{customer_email}}",
            "name": "{{customer_name}}",
            "phone": {
              "country_code": "{{customer_phone_country_code}}",
              "number": "{{customer_phone_number}}"
            }
          },
          "shipping": {
            "address": {
              "country": "{{shipping_country}}",
              "address_line1": "{{shipping_address_line1}}",
              "address_line2": "{{shipping_address_line2}}",
              "city": "{{shipping_city}}",
              "state": "{{shipping_state}}",
              "zip": "{{shipping_zip}}"
            }
          }
        }
      }
    },
    "refund_payment": {
      "label": "Refund a Payment",
      "description": "Issue a refund (full or partial) for a captured payment. Supports split refunds, line items, and bank account destinations.",
      "inputs": {
        "reference": {
          "label": "Reference",
          "description": "A reference, such as an order ID, that can be used to identify the payment",
          "required": true
        },
        "payment_id": {
          "label": "Payment ID",
          "description": "Select the payment to refund",
          "required": true
        },
        "amount": {
          "label": "Refund Amount",
          "description": "The amount to refund in minor units. If not specified, full payment amount will be refunded.",
          "type": "number"
        },
        "refund_reference": {
          "label": "Refund Reference",
          "description": "Your reference for the refund (max 80 chars, 30 for Amex, 50 for TWINT)"
        },
        "capture_action_id": {
          "label": "Capture Action ID",
          "description": "The action ID of the capture to refund (only for PayPal and Riverty)"
        },
        "amount_allocations": {
          "label": "Amount Allocations",
          "description": "Split refund allocations for sub-entities",
          "type": "json"
        },
        "items": {
          "label": "Line Items",
          "description": "Order line items for the refund",
          "type": "json"
        },
        "destination_country": {
          "label": "Destination Country",
          "description": "Two-letter ISO country code for bank account (required for giropay/EPS)"
        },
        "destination_account_number": {
          "label": "Account Number",
          "description": "The bank account number"
        },
        "destination_bank_code": {
          "label": "Bank Code",
          "description": "The code that identifies the bank"
        },
        "destination_iban": {
          "label": "IBAN",
          "description": "International Bank Account Number"
        },
        "destination_swift_bic": {
          "label": "SWIFT BIC",
          "description": "8 or 11-digit code identifying the bank"
        },
        "account_holder_first_name": {
          "label": "Account Holder First Name",
          "description": "The account holder's first name"
        },
        "account_holder_last_name": {
          "label": "Account Holder Last Name",
          "description": "The account holder's last name"
        },
        "account_holder_type": {
          "label": "Account Holder Type",
          "description": "The type of account holder",
          "type": "select",
          "options": [
            {
              "value": "individual",
              "label": "Individual"
            },
            {
              "value": "corporate",
              "label": "Corporate"
            },
            {
              "value": "government",
              "label": "Government"
            }
          ]
        },
        "account_holder_company_name": {
          "label": "Company Name",
          "description": "Company name for corporate account holders"
        },
        "account_holder_email": {
          "label": "Account Holder Email",
          "description": "The account holder's email address"
        },
        "account_holder_phone_country_code": {
          "label": "Phone Country Code",
          "description": "International country calling code"
        },
        "account_holder_phone_number": {
          "label": "Phone Number",
          "description": "The account holder's phone number"
        },
        "account_holder_address_line1": {
          "label": "Address Line 1",
          "description": "First line of the account holder's address"
        },
        "account_holder_address_line2": {
          "label": "Address Line 2",
          "description": "Second line of the account holder's address"
        },
        "account_holder_city": {
          "label": "City",
          "description": "Account holder's city"
        },
        "account_holder_state": {
          "label": "State",
          "description": "Account holder's state or province"
        },
        "account_holder_zip": {
          "label": "ZIP Code",
          "description": "Account holder's ZIP or postal code"
        },
        "account_holder_country": {
          "label": "Country",
          "description": "Two-letter ISO country code"
        },
        "bank_name": {
          "label": "Bank Name",
          "description": "The name of the bank"
        },
        "bank_branch": {
          "label": "Bank Branch",
          "description": "The name of the bank branch"
        },
        "bank_address_line1": {
          "label": "Bank Address Line 1",
          "description": "First line of the bank's address"
        },
        "bank_address_line2": {
          "label": "Bank Address Line 2",
          "description": "Second line of the bank's address"
        },
        "bank_city": {
          "label": "Bank City",
          "description": "The bank's city"
        },
        "bank_country": {
          "label": "Bank Country",
          "description": "Two-letter ISO country code for the bank"
        },
        "metadata": {
          "label": "Metadata",
          "description": "Additional key-value pairs for the refund request",
          "type": "json"
        }
      },
      "request": {
        "method": "POST",
        "url": "https://api.checkout.com/payments/{{payment_id}}/refunds",
        "body": {
          "amount": "{{amount}}",
          "reference": "{{refund_reference}}",
          "capture_action_id": "{{capture_action_id}}",
          "destination": {
            "country": "{{destination_country}}",
            "account_number": "{{destination_account_number}}",
            "bank_code": "{{destination_bank_code}}",
            "iban": "{{destination_iban}}",
            "swift_bic": "{{destination_swift_bic}}",
            "account_holder": {
              "first_name": "{{account_holder_first_name}}",
              "last_name": "{{account_holder_last_name}}",
              "company_name": "{{account_holder_company_name}}",
              "email": "{{account_holder_email}}",
              "phone": {
                "country_code": "{{account_holder_phone_country_code}}",
                "number": "{{account_holder_phone_number}}"
              },
              "billing_address": {
                "address_line1": "{{account_holder_address_line1}}",
                "address_line2": "{{account_holder_address_line2}}",
                "city": "{{account_holder_city}}",
                "state": "{{account_holder_state}}",
                "zip": "{{account_holder_zip}}",
                "country": "{{account_holder_country}}"
              }
            },
            "bank": {
              "name": "{{bank_name}}",
              "branch": "{{bank_branch}}",
              "address": {
                "address_line1": "{{bank_address_line1}}",
                "address_line2": "{{bank_address_line2}}",
                "city": "{{bank_city}}",
                "country": "{{bank_country}}"
              }
            }
          }
        }
      }
    }
  },
  "triggers": {}
}
