{
  "name": "ask-handle",
  "label": "AskHandle",
  "description": "",
  "icon": "",
  "hosts": [
    "dashboard.askhandle.com"
  ],
  "upstream": {
    "package": "@activepieces/piece-ask-handle",
    "version": "0.1.8"
  },
  "credential": {
    "fields": {
      "token": {
        "label": "API Key",
        "description": "\nTo get your API Key:\n\n1. Go to https://dashboard.askhandle.com\n2. Sign in to your account\n3. Navigate to API settings\n4. Create or copy your API token\n5. Paste it here\n",
        "secret": true,
        "required": true
      }
    },
    "headers": {
      "authorization": "Token {{credential.token}}"
    }
  },
  "actions": {
    "create_message": {
      "label": "Create Message",
      "description": "Send a message to a room",
      "inputs": {
        "room": {
          "label": "Room",
          "description": "Select a room",
          "required": true
        },
        "body": {
          "label": "Message",
          "description": "The message content",
          "required": true,
          "type": "multiline"
        },
        "nickname": {
          "label": "Nickname",
          "description": "Sender nickname"
        },
        "email": {
          "label": "Email",
          "description": "Sender email"
        },
        "phone_number": {
          "label": "Phone Number",
          "description": "Sender phone number"
        }
      },
      "request": {
        "method": "POST",
        "url": "https://dashboard.askhandle.com/api/v1/messages/",
        "body": {
          "body": "{{body}}",
          "room": {
            "uuid": "{{room}}"
          },
          "nickname": "{{nickname}}",
          "email": "{{email}}",
          "phone_number": "{{phone_number}}"
        }
      }
    },
    "create_lead": {
      "label": "Create Lead",
      "description": "Create a new lead",
      "inputs": {
        "nickname": {
          "label": "Nickname",
          "description": "Lead nickname"
        },
        "email": {
          "label": "Email",
          "description": "Lead email"
        },
        "phone_number": {
          "label": "Phone Number",
          "description": "Lead phone number"
        },
        "device": {
          "label": "Device",
          "description": "Device information"
        },
        "from_page_title": {
          "label": "From Page Title",
          "description": "Page title where lead originated"
        },
        "referrer": {
          "label": "Referrer",
          "description": "Referrer URL"
        }
      },
      "request": {
        "method": "POST",
        "url": "https://dashboard.askhandle.com/api/v1/leads/",
        "body": {
          "nickname": "{{nickname}}",
          "email": "{{email}}",
          "phone_number": "{{phone_number}}",
          "device": "{{device}}",
          "from_page_title": "{{from_page_title}}",
          "referrer": "{{referrer}}"
        }
      }
    },
    "list_rooms": {
      "label": "List Rooms",
      "description": "Get a list of all rooms",
      "inputs": {},
      "request": {
        "method": "GET",
        "url": "https://dashboard.askhandle.com/api/v1/rooms/"
      }
    }
  },
  "triggers": {}
}
