{
  "name": "zeplin",
  "label": "Zeplin",
  "description": "",
  "icon": "",
  "hosts": [
    "api.zeplin.dev"
  ],
  "upstream": {
    "package": "@activepieces/piece-zeplin",
    "version": "0.1.1"
  },
  "credential": {
    "fields": {
      "token": {
        "label": "Zeplin Personal Access Token",
        "description": "Zeplin Personal Access Token",
        "secret": true,
        "required": true
      }
    },
    "headers": {
      "authorization": "Bearer {{credential.token}}"
    }
  },
  "actions": {
    "findProject": {
      "label": "Find Project",
      "description": "Find a project by name or retrieve all projects",
      "inputs": {
        "projectName": {
          "label": "Project Name",
          "description": "Optional project name to search for (partial match)"
        }
      },
      "request": {
        "method": "GET",
        "url": "https://api.zeplin.dev/v1/projects"
      }
    },
    "findScreen": {
      "label": "Find Screen",
      "description": "Find a screen by name or retrieve all screens in a project",
      "inputs": {
        "projectId": {
          "label": "Project",
          "description": "Select the Zeplin project",
          "required": true
        },
        "screenName": {
          "label": "Screen Name",
          "description": "Optional screen name to search for (partial match)"
        }
      },
      "request": {
        "method": "GET",
        "url": "https://api.zeplin.dev/v1/projects/{{projectId}}/screens"
      }
    },
    "updateScreen": {
      "label": "Update Screen",
      "description": "Update a screen's description",
      "inputs": {
        "projectId": {
          "label": "Project",
          "description": "Select the Zeplin project",
          "required": true
        },
        "screenId": {
          "label": "Screen",
          "description": "Select the Zeplin screen",
          "required": true
        },
        "description": {
          "label": "Description",
          "description": "The new description for the screen",
          "required": true,
          "type": "multiline"
        }
      },
      "request": {
        "method": "PATCH",
        "url": "https://api.zeplin.dev/v1/projects/{{projectId}}/screens/{{screenId}}",
        "body": {
          "description": "{{description}}"
        }
      }
    }
  },
  "triggers": {}
}
