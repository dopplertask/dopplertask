{
  "name": "fragment",
  "label": "Fragment",
  "description": "",
  "icon": "",
  "hosts": [
    "api.onfragment.com"
  ],
  "upstream": {
    "package": "@activepieces/piece-fragment",
    "version": "0.1.9"
  },
  "credential": {
    "fields": {
      "token": {
        "label": "API Token",
        "description": "You can obtain your API token by navigating to [Developer Settings](https://app.onfragment.com/settings/account/developers).",
        "secret": true,
        "required": true
      }
    },
    "headers": {
      "authorization": "Bearer {{credential.token}}"
    }
  },
  "actions": {
    "create_task": {
      "label": "Create Task",
      "description": "Creates a new task in Fragment.",
      "inputs": {
        "title": {
          "label": "Title",
          "description": "The title of the task",
          "required": true
        },
        "url": {
          "label": "URL",
          "description": "A URL associated with the task (e.g., link to a ticket or resource)"
        },
        "due_at": {
          "label": "Due Date",
          "description": "When the task is due"
        },
        "assignee": {
          "label": "Assignee",
          "description": "Email of the person to assign this task to."
        },
        "tags": {
          "label": "Tags",
          "description": "Tags to categorize the task",
          "type": "json"
        },
        "custom_fields": {
          "label": "Custom Fields",
          "description": "Additional custom fields for the task",
          "type": "json"
        }
      },
      "request": {
        "method": "POST",
        "url": "https://api.onfragment.com/api/v1/tasks",
        "body": {
          "fields": {
            "title": "{{title}}",
            "url": "{{url}}"
          },
          "due_at": "{{due_at}}",
          "assignee_email": "{{assignee}}"
        }
      }
    },
    "update_task": {
      "label": "Update Task",
      "description": "Updates an existing task.",
      "inputs": {
        "task_uid": {
          "label": "Task UID",
          "description": "The unique identifier of the task to update",
          "required": true
        },
        "title": {
          "label": "Title",
          "description": "The updated title of the task"
        },
        "url": {
          "label": "URL",
          "description": "The updated URL for the task"
        },
        "due_at": {
          "label": "Due Date",
          "description": "The updated due date"
        },
        "status": {
          "label": "Status",
          "description": "The status of the task",
          "type": "select",
          "options": [
            {
              "value": "TODO",
              "label": "TODO"
            },
            {
              "value": "STARTED",
              "label": "STARTED"
            },
            {
              "value": "DONE",
              "label": "DONE"
            }
          ]
        },
        "assignee": {
          "label": "Assignee",
          "description": "Email of the person to assign this task to"
        },
        "tags": {
          "label": "Tags",
          "description": "Updated tags for the task",
          "type": "json"
        },
        "custom_fields": {
          "label": "Custom Fields",
          "description": "Updated custom fields",
          "type": "json"
        }
      },
      "request": {
        "method": "PATCH",
        "url": "https://api.onfragment.com/api/v1/tasks/{{task_uid}}",
        "body": {
          "due_at": "{{due_at}}",
          "assignee_email": "{{assignee}}",
          "fields": {
            "title": "{{title}}",
            "url": "{{url}}"
          }
        }
      }
    },
    "get_task": {
      "label": "Get Task",
      "description": "Retrieves details of a specific task.",
      "inputs": {
        "task_uid": {
          "label": "Task UID",
          "description": "The unique identifier of the task to retrieve",
          "required": true
        }
      },
      "request": {
        "method": "GET",
        "url": "https://api.onfragment.com/api/v1/tasks/{{task_uid}}"
      }
    },
    "list_tasks": {
      "label": "List Tasks",
      "description": "Retrieves a list of tasks from.",
      "inputs": {
        "status": {
          "label": "Status",
          "description": "Filter tasks by status",
          "type": "select",
          "options": [
            {
              "value": "TODO",
              "label": "TODO"
            },
            {
              "value": "STARTED",
              "label": "STARTED"
            },
            {
              "value": "DONE",
              "label": "DONE"
            }
          ]
        },
        "assignee": {
          "label": "Assignee",
          "description": "Filter tasks by assignee email or ID"
        },
        "limit": {
          "label": "Limit",
          "description": "Maximum number of tasks to return (default: 50)",
          "type": "number",
          "defaultValue": "50"
        }
      },
      "request": {
        "method": "GET",
        "url": "https://api.onfragment.com/api/v1/tasks",
        "query": {
          "assignee_uid": "{{assignee}}",
          "limit": "{{limit}}"
        }
      }
    },
    "delete_task": {
      "label": "Delete Task",
      "description": "Deletes an existing task.",
      "inputs": {
        "task_uid": {
          "label": "Task UID",
          "description": "The unique identifier of the task to delete",
          "required": true
        }
      },
      "request": {
        "method": "DELETE",
        "url": "https://api.onfragment.com/api/v1/tasks/{{task_uid}}"
      }
    }
  },
  "triggers": {}
}
