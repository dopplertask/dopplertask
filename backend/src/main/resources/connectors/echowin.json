{
  "name": "echowin",
  "label": "Echowin",
  "description": "",
  "icon": "",
  "hosts": [
    "echo.win"
  ],
  "upstream": {
    "package": "@activepieces/piece-echowin",
    "version": "0.1.8"
  },
  "credential": {
    "fields": {
      "token": {
        "label": "Echowin API Key",
        "description": "API Key for Echowin. Get it from [Echowin Settings](https://echo.win/portal/settings/integrations)",
        "secret": true,
        "required": true
      }
    },
    "headers": {
      "x-api-key": "{{credential.token}}"
    }
  },
  "actions": {
    "createContact": {
      "label": "Create Contact",
      "description": "Create a new contact with optional tags, custom fields, notes, and board assignments",
      "inputs": {
        "firstName": {
          "label": "First Name",
          "description": "Contact's first name"
        },
        "lastName": {
          "label": "Last Name",
          "description": "Contact's last name"
        },
        "email": {
          "label": "Email",
          "description": "Contact's email address"
        },
        "number": {
          "label": "Phone Number",
          "description": "Contact phone number (will be automatically cleaned)",
          "required": true
        },
        "carrier": {
          "label": "Phone Carrier",
          "description": "Phone carrier name"
        }
      },
      "request": {
        "method": "POST",
        "url": "https://echo.win/api/v1/contacts",
        "body": {
          "number": "{{number}}",
          "firstName": "{{firstName}}",
          "lastName": "{{lastName}}",
          "email": "{{email}}",
          "carrier": "{{carrier}}"
        }
      }
    },
    "deleteContact": {
      "label": "Delete Contact",
      "description": "Delete a contact by ID",
      "inputs": {
        "contactId": {
          "label": "Contact ID",
          "description": "The unique identifier of the contact to delete",
          "required": true
        }
      },
      "request": {
        "method": "DELETE",
        "url": "https://echo.win/api/v1/contacts/{{contactId}}"
      }
    },
    "findContactByName": {
      "label": "Find Contact ",
      "description": "Get a paginated list of contacts and search by name, email, or phone number",
      "inputs": {
        "search": {
          "label": "Search",
          "description": "Search contacts by name, email, or phone number"
        }
      },
      "request": {
        "method": "GET",
        "url": "https://echo.win/api/v1/contacts",
        "query": {
          "search": "{{search}}"
        }
      }
    }
  },
  "triggers": {}
}
