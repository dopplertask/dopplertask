{
  "name": "onfleet",
  "label": "Onfleet",
  "description": "Last mile delivery software",
  "icon": "",
  "hosts": [
    "onfleet.com"
  ],
  "upstream": {
    "package": "@activepieces/piece-onfleet",
    "version": "0.2.1"
  },
  "credential": {
    "fields": {
      "token": {
        "label": "API Key",
        "description": "\nTo get an API key, follow the steps below:\n1. Go to settings -> API & Webhooks.\n2. Click the plus sign under API Keys.\n3. Enter API key name and click create key.\n4. Copy the generated key to the input below.\n",
        "secret": true,
        "required": true
      }
    }
  },
  "actions": {
    "create_recipient": {
      "label": "Create Recipient",
      "description": "Creates a recipient",
      "inputs": {
        "name": {
          "label": "Name",
          "description": "The recipient's full name",
          "required": true
        },
        "phone": {
          "label": "Phone",
          "description": "A unique, valid phone number as per the organization's country if there's no leading + sign. If a phone number has a leading + sign, it will disregard the organization's country setting.",
          "required": true
        },
        "notes": {
          "label": "Notes"
        },
        "skipSMSNotifications": {
          "label": "Skip SMS Notifications",
          "type": "boolean",
          "defaultValue": "false"
        },
        "skipPhoneNumberValidation": {
          "label": "Skip Phone Number Validation",
          "type": "boolean",
          "defaultValue": "false"
        },
        "useLongCodeForText": {
          "label": "Use Long Code for Text - Canadian Organizations Only",
          "description": "Checking this option will default the Onfleet system to use a toll-free long code number for SMS communication.",
          "type": "boolean",
          "defaultValue": "false"
        }
      },
      "request": {
        "method": "POST",
        "url": "https://onfleet.com/api/v2/recipients",
        "headers": {
          "authorization": "Basic Y3JlZGVudGlhbDAwMHo="
        },
        "body": {
          "name": "{{name}}",
          "phone": "{{phone}}",
          "notes": "{{notes}}"
        }
      }
    },
    "update_recipient": {
      "label": "Update Recipient",
      "description": "Updates a recipient",
      "inputs": {
        "id": {
          "label": "Recipient ID",
          "description": "The ID of the recipient you want to update",
          "required": true
        },
        "name": {
          "label": "Name",
          "description": "The recipient's full name"
        },
        "notes": {
          "label": "Notes"
        },
        "skipSMSNotifications": {
          "label": "Skip SMS Notifications",
          "type": "boolean"
        }
      },
      "request": {
        "method": "PUT",
        "url": "https://onfleet.com/api/v2undefined",
        "headers": {
          "authorization": "Basic Y3JlZGVudGlhbDAwMHo="
        },
        "body": {
          "name": "{{name}}",
          "notes": "{{notes}}"
        }
      }
    },
    "get_recipient": {
      "label": "Get Recipient",
      "description": "Gets a single recipient",
      "inputs": {
        "id": {
          "label": "Recipient ID",
          "description": "The recipient's ID",
          "required": true
        }
      },
      "request": {
        "method": "GET",
        "url": "https://onfleet.com/api/v2undefined",
        "headers": {
          "authorization": "Basic Y3JlZGVudGlhbDAwMHo="
        }
      }
    },
    "complete_task": {
      "label": "Force Complete Task",
      "description": "Force completes a task",
      "inputs": {
        "task": {
          "label": "Task ID",
          "description": "The ID of the task you want to complete",
          "required": true
        },
        "success": {
          "label": "Complete as Success",
          "description": "Whether to complete the task as a success or not",
          "required": true,
          "type": "boolean",
          "defaultValue": "true"
        },
        "notes": {
          "label": "Notes"
        }
      },
      "request": {
        "method": "POST",
        "url": "https://onfleet.com/api/v2/tasks/:taskId/complete",
        "headers": {
          "authorization": "Basic Y3JlZGVudGlhbDAwMHo="
        },
        "body": "{{task}}"
      }
    },
    "clone_task": {
      "label": "Clone Task",
      "description": "Clones a task",
      "inputs": {
        "task": {
          "label": "Task ID",
          "description": "ID of the task you want to clone",
          "required": true
        }
      },
      "request": {
        "method": "POST",
        "url": "https://onfleet.com/api/v2/tasks/:taskId/clone",
        "headers": {
          "authorization": "Basic Y3JlZGVudGlhbDAwMHo="
        },
        "body": "{{task}}"
      }
    },
    "update_task": {
      "label": "Update Task",
      "description": "Updates a task",
      "inputs": {
        "task": {
          "label": "Task ID",
          "description": "ID of the task you want to update",
          "required": true
        },
        "merchant": {
          "label": "Merchant ID",
          "description": "ID of the organization that will be displayed on the task"
        },
        "executor": {
          "label": "Executor ID",
          "description": "ID of the organization that will be executing the task"
        },
        "completeAfter": {
          "label": "Complete After",
          "description": "The earliest time the task should be completed"
        },
        "completeBefore": {
          "label": "Complete Before",
          "description": "The latest time the task should be completed"
        },
        "pickupTask": {
          "label": "Pickup",
          "description": "Whether the task is pickup",
          "type": "boolean"
        },
        "quantity": {
          "label": "Quantity",
          "description": "The number of units to be dropped off",
          "type": "number"
        },
        "serviceTime": {
          "label": "Service Time",
          "description": "The number of minutes to be spent by the worker on arrival at this task's destination",
          "type": "number"
        }
      },
      "request": {
        "method": "PUT",
        "url": "https://onfleet.com/api/v2undefined",
        "headers": {
          "authorization": "Basic Y3JlZGVudGlhbDAwMHo="
        },
        "body": {
          "merchant": "{{merchant}}",
          "executor": "{{executor}}",
          "quantity": "{{quantity}}",
          "serviceTime": "{{serviceTime}}",
          "completeAfter": null,
          "completeBefore": null
        }
      }
    },
    "get_task": {
      "label": "Get Task",
      "description": "Get a specific task",
      "inputs": {
        "task": {
          "label": "Task ID",
          "description": "The ID of the task you want to delete",
          "required": true
        }
      },
      "request": {
        "method": "GET",
        "url": "https://onfleet.com/api/v2/tasks/all",
        "headers": {
          "authorization": "Basic Y3JlZGVudGlhbDAwMHo="
        }
      }
    },
    "get_destination": {
      "label": "Get Destination",
      "description": "Get a specific destination",
      "inputs": {
        "destination": {
          "label": "Destination ID",
          "description": "The ID of the destination you want to delete",
          "required": true
        }
      },
      "request": {
        "method": "GET",
        "url": "https://onfleet.com/api/v2undefined",
        "headers": {
          "authorization": "Basic Y3JlZGVudGlhbDAwMHo="
        }
      }
    },
    "get_hubs": {
      "label": "Get Hubs",
      "description": "Get many hubs",
      "inputs": {},
      "request": {
        "method": "GET",
        "url": "https://onfleet.com/api/v2/hubs",
        "headers": {
          "authorization": "Basic Y3JlZGVudGlhbDAwMHo="
        }
      }
    },
    "get_organization": {
      "label": "Get Organization",
      "description": "Get your organization details",
      "inputs": {},
      "request": {
        "method": "GET",
        "url": "https://onfleet.com/api/v2/organization",
        "headers": {
          "authorization": "Basic Y3JlZGVudGlhbDAwMHo="
        }
      }
    },
    "get_delegatee_details": {
      "label": "Get Delegatee Details",
      "description": "Get details of a connected organization",
      "inputs": {
        "organization": {
          "label": "Organization ID",
          "description": "ID of the connected organization",
          "required": true
        }
      },
      "request": {
        "method": "GET",
        "url": "https://onfleet.com/api/v2/organization",
        "headers": {
          "authorization": "Basic Y3JlZGVudGlhbDAwMHo="
        }
      }
    },
    "create_admin": {
      "label": "Create Administrator",
      "description": "Create a new administrator",
      "inputs": {
        "name": {
          "label": "Name",
          "description": "Full name",
          "required": true
        },
        "email": {
          "label": "Email",
          "required": true
        },
        "phone": {
          "label": "Phone Number"
        },
        "isReadOnly": {
          "label": "Read Only",
          "description": "Whether this administrator can perform write operations.",
          "type": "boolean"
        }
      },
      "request": {
        "method": "POST",
        "url": "https://onfleet.com/api/v2/admins",
        "headers": {
          "authorization": "Basic Y3JlZGVudGlhbDAwMHo="
        },
        "body": {
          "name": "{{name}}",
          "email": "{{email}}",
          "phone": "{{phone}}"
        }
      }
    },
    "update_admin": {
      "label": "Update Administrator",
      "description": "Update an existing administrator",
      "inputs": {
        "admin": {
          "label": "Administrator",
          "required": true
        },
        "name": {
          "label": "Name",
          "description": "Full name"
        }
      },
      "request": {
        "method": "PUT",
        "url": "https://onfleet.com/api/v2undefined",
        "headers": {
          "authorization": "Basic Y3JlZGVudGlhbDAwMHo="
        },
        "body": {
          "name": "{{name}}"
        }
      }
    },
    "get_admins": {
      "label": "Get Administrators",
      "description": "Get many administrators",
      "inputs": {},
      "request": {
        "method": "GET",
        "url": "https://onfleet.com/api/v2/admins",
        "headers": {
          "authorization": "Basic Y3JlZGVudGlhbDAwMHo="
        }
      }
    },
    "get_worker": {
      "label": "Get Worker",
      "description": "Get an existing worker's details",
      "inputs": {
        "worker": {
          "label": "Worker",
          "required": true
        }
      },
      "request": {
        "method": "GET",
        "url": "https://onfleet.com/api/v2/workers",
        "headers": {
          "authorization": "Basic Y3JlZGVudGlhbDAwMHo="
        }
      }
    },
    "get_worker_schedule": {
      "label": "Get Worker Schedule",
      "description": "Get an existing worker's schedule",
      "inputs": {
        "worker": {
          "label": "Worker",
          "required": true
        }
      },
      "request": {
        "method": "GET",
        "url": "https://onfleet.com/api/v2undefined",
        "headers": {
          "authorization": "Basic Y3JlZGVudGlhbDAwMHo="
        }
      }
    },
    "get_team": {
      "label": "Get Team",
      "description": "Gets an existing team",
      "inputs": {
        "team": {
          "label": "Team",
          "required": true
        }
      },
      "request": {
        "method": "GET",
        "url": "https://onfleet.com/api/v2/teams",
        "headers": {
          "authorization": "Basic Y3JlZGVudGlhbDAwMHo="
        }
      }
    },
    "get_teams": {
      "label": "Get Teams",
      "description": "Gets many existing team",
      "inputs": {},
      "request": {
        "method": "GET",
        "url": "https://onfleet.com/api/v2/teams",
        "headers": {
          "authorization": "Basic Y3JlZGVudGlhbDAwMHo="
        }
      }
    },
    "get_container": {
      "label": "Get Container",
      "description": "Get a specific container",
      "inputs": {
        "containerType": {
          "label": "Container Type",
          "required": true
        },
        "containerId": {
          "label": "Container ID",
          "required": true
        }
      },
      "request": {
        "method": "GET",
        "url": "https://onfleet.com/api/v2undefined",
        "headers": {
          "authorization": "Basic Y3JlZGVudGlhbDAwMHo="
        }
      }
    }
  },
  "triggers": {}
}
