{
  "name": "convertkit",
  "label": "ConvertKit",
  "description": "Email marketing for creators",
  "hosts": [
    "api.convertkit.com"
  ],
  "upstream": {
    "package": "@activepieces/piece-convertkit",
    "version": "0.4.2"
  },
  "credential": {
    "fields": {
      "apiSecret": {
        "label": "API Secret",
        "secret": true,
        "required": true,
        "description": "Enter your API Secret key. In Kit, go to Settings > Developer, open the V3 Key section and copy the API Secret."
      }
    },
    "query": {
      "api_secret": "{{credential.apiSecret}}"
    }
  },
  "actions": {
    "custom_fields_create_field": {
      "label": "Create Custom Field",
      "description": "Create a new custom field",
      "audience": "human",
      "inputs": {
        "fields": {
          "label": "Fields",
          "description": "The custom fields",
          "type": "json",
          "required": true
        }
      },
      "request": {
        "method": "POST",
        "url": "https://api.convertkit.com/v3/custom_fields",
        "body": {
          "label": "{{fields}}"
        }
      },
      "outputs": {
        "id": "$.id",
        "key": "$.key",
        "label": "$.label"
      }
    },
    "tags_create_tag": {
      "label": "Create Tag",
      "description": "Create a tag",
      "audience": "human",
      "inputs": {
        "name": {
          "label": "Name",
          "description": "The name of the tag",
          "required": true
        }
      },
      "request": {
        "method": "POST",
        "url": "https://api.convertkit.com/v3/tags",
        "body": {
          "tag": {
            "name": "{{name}}"
          }
        }
      },
      "outputs": {
        "id": "$.id",
        "name": "$.name"
      }
    },
    "tags_remove_tag_from_subscriber_by_email": {
      "label": "Remove Tag From Subscriber By Email",
      "description": "Remove a tag from a subscriber by email",
      "audience": "human",
      "inputs": {
        "email": {
          "label": "Email",
          "description": "The email of the subscriber",
          "required": true
        },
        "tagId": {
          "label": "Tag ID",
          "description": "The tag to remove",
          "required": true
        }
      },
      "request": {
        "method": "POST",
        "url": "https://api.convertkit.com/v3/tags/{{tagId}}/unsubscribe",
        "body": {
          "email": "{{email}}"
        }
      },
      "outputs": {
        "id": "$.id",
        "name": "$.name"
      }
    },
    "tags_remove_tag_from_subscriber_by_id": {
      "label": "Remove Tag From Subscriber By Id",
      "description": "Remove a tag from a subscriber by id",
      "audience": "human",
      "inputs": {
        "subscriberId": {
          "label": "Subscriber ID",
          "description": "The subscriber ID",
          "required": true
        },
        "tagId": {
          "label": "Tag ID",
          "description": "The tag to remove",
          "required": true
        }
      },
      "request": {
        "method": "DELETE",
        "url": "https://api.convertkit.com/v3/subscribers/{{subscriberId}}/tags/{{tagId}}"
      },
      "outputs": {
        "id": "$.id",
        "name": "$.name"
      }
    },
    "purchases_get_purchase_by_id": {
      "label": "Get Purchase By Id",
      "description": "Returns data for a single purchase",
      "audience": "human",
      "inputs": {
        "purchaseId": {
          "label": "Purchase ID",
          "description": "The purchase ID",
          "required": true
        }
      },
      "request": {
        "method": "GET",
        "url": "https://api.convertkit.com/v3/purchases/{{purchaseId}}"
      },
      "outputs": {
        "id": "$.id",
        "transaction_id": "$.transaction_id",
        "email_address": "$.email_address",
        "total": "$.total"
      }
    },
    "purchases_create_purchase": {
      "label": "Create Purchase",
      "description": "Creates a new purchase",
      "inputs": {
        "transactionId": {
          "label": "Transaction ID",
          "description": "The transaction ID",
          "type": "number",
          "required": true
        },
        "transactionTime": {
          "label": "Transaction Time",
          "description": "The transaction time"
        },
        "emailAddress": {
          "label": "Email Address",
          "description": "The email address of the subscriber",
          "required": true
        },
        "firstName": {
          "label": "First Name",
          "description": "The first name of the subscriber"
        },
        "status": {
          "label": "Status",
          "description": "The status of the purchase",
          "type": "select",
          "options": [
            {
              "value": "paid",
              "label": "paid"
            },
            {
              "value": "pending",
              "label": "pending"
            },
            {
              "value": "failed",
              "label": "failed"
            }
          ]
        },
        "currency": {
          "label": "Currency",
