    "kit_get_account": {
      "label": "Get Account",
      "description": "Get the name and primary email address of the connected Kit account.",
      "audience": "ai",
      "request": {
        "method": "GET",
        "url": "https://api.convertkit.com/v3/account"
      },
      "outputs": {
        "name": "$.name",
        "primary_email_address": "$.primary_email_address",
        "plan_type": "$.plan_type"
      }
    }
