              "value": "ZAR",
              "label": "ZAR"
            }
          ]
        },
        "subtotal": {
          "label": "Subtotal",
          "description": "The subtotal",
          "type": "number"
        },
        "shipping": {
          "label": "Shipping",
          "description": "The shipping",
          "type": "number"
        },
        "discount": {
          "label": "Discount",
          "description": "The discount",
          "type": "number"
        },
        "tax": {
          "label": "Tax",
          "description": "The tax",
          "type": "number"
        },
        "total": {
          "label": "Total",
          "description": "The total",
          "type": "number"
        },
        "pid": {
          "label": "Product ID",
          "description": "The product ID",
          "type": "number",
          "required": true
        },
        "lid": {
          "label": "Line Item ID",
          "description": "The line item ID",
          "type": "number",
          "required": true
        },
        "name": {
          "label": "Name",
          "description": "The name of the product",
          "required": true
        },
        "sku": {
          "label": "SKU",
          "description": "The SKU of the product"
        },
        "unit_price": {
          "label": "Unit Price",
          "description": "The unit price of the product",
          "type": "number",
          "required": true
        },
        "quantity": {
          "label": "Quantity",
          "description": "The quantity of the product",
          "type": "number",
          "required": true
        }
      },
      "request": {
        "method": "POST",
        "url": "https://api.convertkit.com/v3/purchases",
        "body": {
          "purchase": {
            "transaction_id": "{{transactionId}}",
            "status": "{{status}}",
            "first_name": "{{firstName}}",
            "email_address": "{{emailAddress}}",
            "currency": "{{currency}}",
            "transaction_time": "{{transactionTime}}",
            "subtotal": "{{subtotal}}",
            "shipping": "{{shipping}}",
            "discount": "{{discount}}",
            "tax": "{{tax}}",
            "total": "{{total}}",
            "products": [
              {
                "pid": "{{pid}}",
                "lid": "{{lid}}",
                "name": "{{name}}",
                "sku": "{{sku}}",
                "unit_price": "{{unit_price}}",
                "quantity": "{{quantity}}"
              }
            ]
          }
        }
      },
      "outputs": {
        "id": "$.id",
        "transaction_id": "$.transaction_id",
        "email_address": "$.email_address",
        "total": "$.total"
      }
    },
