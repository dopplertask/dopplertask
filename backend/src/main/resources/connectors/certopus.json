{
  "name": "certopus",
  "label": "Certopus",
  "description": "Your certificates, made simple",
  "icon": "",
  "hosts": [
    "api.certopus.com"
  ],
  "upstream": {
    "package": "@activepieces/piece-certopus",
    "version": "0.3.1"
  },
  "credential": {
    "fields": {
      "token": {
        "label": "API Key",
        "description": "API key acquired from your Certopus profile",
        "secret": true,
        "required": true
      }
    },
    "headers": {
      "x-api-key": "{{credential.token}}"
    }
  },
  "actions": {
    "create_credential": {
      "label": "Create Credential",
      "description": "Create a credential",
      "inputs": {
        "organisation": {
          "label": "Organisations",
          "required": true
        },
        "event": {
          "label": "Event",
          "required": true
        },
        "category": {
          "label": "Category",
          "required": true
        },
        "generate": {
          "label": "Generate",
          "description": "Automatically generate the crentials",
          "required": true,
          "type": "boolean",
          "defaultValue": "false"
        },
        "publish": {
          "label": "Publish",
          "description": "Automatically publish the crentials",
          "required": true,
          "type": "boolean",
          "defaultValue": "false"
        },
        "email": {
          "label": "Recipient Email",
          "description": "Email address of the recipient",
          "required": true
        }
      },
      "request": {
        "method": "POST",
        "url": "https://api.certopus.com/v1/certificates",
        "body": {
          "organisationId": "{{organisation}}",
          "eventId": "{{event}}",
          "categoryId": "{{category}}",
          "recipients": [
            {
              "email": "{{email}}"
            }
          ]
        }
      }
    }
  },
  "triggers": {}
}
