{
  "name": "trust",
  "label": "Trust",
  "description": "Collect and manage video and text testimonials from your customers.",
  "icon": "",
  "hosts": [
    "api.usetrust.app"
  ],
  "upstream": {
    "package": "@activepieces/piece-trust",
    "version": "0.1.1"
  },
  "credential": {
    "fields": {
      "workspace_id": {
        "label": "Workspace ID",
        "description": "Your Trust workspace ID. Find it in your Trust dashboard URL: https://app.usetrust.io/workspace/{workspaceId}/...",
        "required": true
      },
      "api_key": {
        "label": "API Key",
        "description": "Go to your Trust dashboard > Settings > API to generate an API key.",
        "secret": true,
        "required": true
      }
    },
    "body": {
      "workspaceId": "{{credential.workspace_id}}"
    }
  },
  "actions": {
    "create_testimonial": {
      "label": "Create Testimonial",
      "description": "Creates a new testimonial in the system.",
      "inputs": {
        "firstname": {
          "label": "First Name"
        },
        "lastname": {
          "label": "Last Name"
        },
        "email": {
          "label": "Email"
        },
        "title": {
          "label": "Job Title",
          "description": "The testimonial author's job title (e.g. CEO, Marketing Manager)."
        },
        "subtitle": {
          "label": "Subtitle"
        },
        "company": {
          "label": "Company"
        },
        "testimonialText": {
          "label": "Testimonial Text",
          "description": "The written testimonial content.",
          "type": "multiline"
        },
        "stars": {
          "label": "Star Rating",
          "description": "Rating from 1 to 5.",
          "type": "number"
        },
        "imageUrl": {
          "label": "Profile Image URL",
          "description": "URL of the author profile image."
        },
        "videoUrl": {
          "label": "Video URL",
          "description": "URL of the testimonial video."
        },
        "externalVideoHtml": {
          "label": "External Video HTML",
          "description": "Embed HTML for an external video (e.g. YouTube or Vimeo embed code).",
          "type": "multiline"
        },
        "published": {
          "label": "Published",
          "description": "Whether this testimonial is publicly visible.",
          "type": "boolean",
          "defaultValue": "false"
        },
        "gaveConsent": {
          "label": "Gave Consent",
          "description": "Whether the author gave consent to publish this testimonial.",
          "type": "boolean",
          "defaultValue": "false"
        },
        "consentDateTime": {
          "label": "Consent Date & Time"
        }
      },
      "request": {
        "method": "POST",
        "url": "https://api.usetrust.app/v1/testimonial",
        "headers": {
          "authorization": "Basic YXBpa2V5OmNyZWRlbnRpYWwwMDF6"
        },
        "body": {
          "firstname": "{{firstname}}",
          "lastname": "{{lastname}}",
          "email": "{{email}}",
          "title": "{{title}}",
          "subtitle": "{{subtitle}}",
          "company": "{{company}}",
          "testimonialText": "{{testimonialText}}",
          "stars": "{{stars}}",
          "imageUrl": "{{imageUrl}}",
          "videoUrl": "{{videoUrl}}",
          "externalVideoHtml": "{{externalVideoHtml}}",
          "consentDateTime": "{{consentDateTime}}"
        }
      }
    },
    "update_testimonial": {
      "label": "Update Testimonial",
      "description": "Updates an existing testimonial in the system.",
      "inputs": {
        "testimonialId": {
          "label": "Testimonial ID",
          "description": "The ID of the testimonial to update.",
          "required": true
        },
        "firstname": {
          "label": "First Name"
        },
        "lastname": {
          "label": "Last Name"
        },
        "email": {
          "label": "Email",
          "description": "Required by the Trust API to identify the testimonial.",
          "required": true
        },
        "title": {
          "label": "Job Title"
        },
        "subtitle": {
          "label": "Subtitle"
        },
        "company": {
          "label": "Company"
        },
        "testimonialText": {
          "label": "Testimonial Text",
          "type": "multiline"
        },
        "stars": {
          "label": "Star Rating",
          "description": "Rating from 1 to 5.",
          "type": "number"
        },
        "imageUrl": {
          "label": "Profile Image URL"
        },
        "videoUrl": {
          "label": "Video URL"
        },
        "externalVideoHtml": {
          "label": "External Video HTML",
          "type": "multiline"
        },
        "published": {
          "label": "Published",
          "type": "boolean"
        },
        "gaveConsent": {
          "label": "Gave Consent",
          "type": "boolean"
        },
        "consentDateTime": {
          "label": "Consent Date & Time"
        }
      },
      "request": {
        "method": "PUT",
        "url": "https://api.usetrust.app/v1/testimonial/{{testimonialId}}",
        "headers": {
          "authorization": "Basic YXBpa2V5OmNyZWRlbnRpYWwwMDF6"
        },
        "body": {
          "email": "{{email}}",
          "firstname": "{{firstname}}",
          "lastname": "{{lastname}}",
          "title": "{{title}}",
          "subtitle": "{{subtitle}}",
          "company": "{{company}}",
          "testimonialText": "{{testimonialText}}",
          "stars": "{{stars}}",
          "imageUrl": "{{imageUrl}}",
          "videoUrl": "{{videoUrl}}",
          "externalVideoHtml": "{{externalVideoHtml}}",
          "consentDateTime": "{{consentDateTime}}"
        }
      }
    },
    "delete_testimonial": {
      "label": "Delete Testimonial",
      "description": "Deletes a testimonial by ID.",
      "inputs": {
        "testimonialId": {
          "label": "Testimonial ID",
          "description": "The ID of the testimonial to delete.",
          "required": true
        }
      },
      "request": {
        "method": "DELETE",
        "url": "https://api.usetrust.app/v1/testimonial/{{testimonialId}}",
        "headers": {
          "authorization": "Basic YXBpa2V5OmNyZWRlbnRpYWwwMDF6"
        }
      }
    },
    "find_testimonial": {
      "label": "Find Testimonial",
      "description": "Finds a testimonial by ID.",
      "inputs": {
        "testimonialId": {
          "label": "Testimonial ID",
          "description": "The ID of the testimonial to retrieve.",
          "required": true
        }
      },
      "request": {
        "method": "GET",
        "url": "https://api.usetrust.app/v1/testimonial/{{testimonialId}}",
        "headers": {
          "authorization": "Basic YXBpa2V5OmNyZWRlbnRpYWwwMDF6"
        }
      }
    },
    "create_contact": {
      "label": "Create Contact",
      "description": "Creates a new contact in the system.",
      "inputs": {
        "firstname": {
          "label": "First Name"
        },
        "lastname": {
          "label": "Last Name"
        },
        "email": {
          "label": "Email"
        },
        "phone": {
          "label": "Phone Number"
        },
        "imageUrl": {
          "label": "Profile Image URL",
          "description": "URL of the contact profile image."
        }
      },
      "request": {
        "method": "POST",
        "url": "https://api.usetrust.app/v1/contacts",
        "headers": {
          "authorization": "Basic YXBpa2V5OmNyZWRlbnRpYWwwMDF6"
        },
        "body": {
          "firstname": "{{firstname}}",
          "lastname": "{{lastname}}",
          "email": "{{email}}",
          "phone": "{{phone}}",
          "imageUrl": "{{imageUrl}}"
        }
      }
    },
    "update_contact": {
      "label": "Update Contact",
      "description": "Updates an existing contact in the system.",
      "inputs": {
        "contactId": {
          "label": "Contact ID",
          "description": "The ID of the contact to update.",
          "required": true
        },
        "firstname": {
          "label": "First Name"
        },
        "lastname": {
          "label": "Last Name"
        },
        "email": {
          "label": "Email",
          "description": "Required by the Trust API to identify the contact.",
          "required": true
        },
        "phone": {
          "label": "Phone Number"
        },
        "imageUrl": {
          "label": "Profile Image URL"
        }
      },
      "request": {
        "method": "PUT",
        "url": "https://api.usetrust.app/v1/contacts/{{contactId}}",
        "headers": {
          "authorization": "Basic YXBpa2V5OmNyZWRlbnRpYWwwMDF6"
        },
        "body": {
          "firstname": "{{firstname}}",
          "lastname": "{{lastname}}",
          "email": "{{email}}",
          "phone": "{{phone}}",
          "imageUrl": "{{imageUrl}}"
        }
      }
    },
    "delete_contact": {
      "label": "Delete Contact",
      "description": "Deletes a contact by ID.",
      "inputs": {
        "contactId": {
          "label": "Contact ID",
          "description": "The ID of the contact to delete.",
          "required": true
        }
      },
      "request": {
        "method": "DELETE",
        "url": "https://api.usetrust.app/v1/contacts/{{contactId}}",
        "headers": {
          "authorization": "Basic YXBpa2V5OmNyZWRlbnRpYWwwMDF6"
        }
      }
    },
    "find_contact": {
      "label": "Find Contact",
      "description": "Finds a contact by ID or email address.",
      "inputs": {
        "contactId": {
          "label": "Contact ID",
          "description": "The ID of the contact to find. Provide either Contact ID or Email — ID takes priority."
        },
        "email": {
          "label": "Email",
          "description": "Search for a contact by email address. Used only if Contact ID is not provided."
        }
      },
      "request": {
        "method": "GET",
        "url": "https://api.usetrust.app/v1/contacts/{{contactId}}",
        "headers": {
          "authorization": "Basic YXBpa2V5OmNyZWRlbnRpYWwwMDF6"
        }
      }
    }
  },
  "triggers": {}
}
