{
  "name": "straico",
  "label": "Straico",
  "description": "All-in-one generative AI platform",
  "icon": "",
  "hosts": [
    "api.straico.com"
  ],
  "upstream": {
    "package": "@activepieces/piece-straico",
    "version": "0.3.2"
  },
  "credential": {
    "fields": {
      "token": {
        "label": "API Key",
        "description": "\nFollow these instructions to get your Straico API Key:\n\n1. Visit the following website: https://platform.straico.com/user-settings.\n2. Once on the website, locate \"Connect with Straico API\" and click on the copy API Key.\n",
        "secret": true,
        "required": true
      }
    },
    "headers": {
      "authorization": "Bearer {{credential.token}}"
    }
  },
  "actions": {
    "image_generation": {
      "label": "Image Generation",
      "description": "Enables users to generate high-quality images based on textual descriptions.",
      "inputs": {
        "variations": {
          "label": "Number of Images",
          "description": "Number of images to generate.",
          "required": true,
          "type": "select",
          "options": [
            {
              "value": 1,
              "label": "1"
            },
            {
              "value": 2,
              "label": "2"
            },
            {
              "value": 3,
              "label": "3"
            },
            {
              "value": 4,
              "label": "4"
            }
          ],
          "defaultValue": "1"
        },
        "model": {
          "label": "Model",
          "description": "Select the image generation model.",
          "required": true,
          "defaultValue": "openai/dall-e-3"
        },
        "size": {
          "label": "Image Dimensions",
          "description": "The desired image dimensions.",
          "required": true,
          "type": "select",
          "options": [
            {
              "value": "square",
              "label": "square"
            },
            {
              "value": "landscape",
              "label": "landscape"
            },
            {
              "value": "portrait",
              "label": "portrait"
            }
          ],
          "defaultValue": "square"
        },
        "description": {
          "label": "Description",
          "description": "A detailed textual description of the image to be generated.",
          "required": true,
          "type": "multiline"
        }
      },
      "request": {
        "method": "POST",
        "url": "https://api.straico.com/v0/image/generation",
        "body": {
          "model": "{{model}}",
          "description": "{{description}}"
        }
      }
    },
    "list_rags": {
      "label": "List RAGs",
      "description": "List all RAG (Retrieval-Augmented Generation) bases for a user.",
      "inputs": {},
      "request": {
        "method": "GET",
        "url": "https://api.straico.com/v0/rag/user"
      }
    },
    "get_rag_by_id": {
      "label": "Get RAG by ID",
      "description": "Retrieve a specific RAG (Retrieval-Augmented Generation) base by its ID.",
      "inputs": {
        "ragId": {
          "label": "RAG ID",
          "description": "The ID of the RAG base to retrieve.",
          "required": true
        }
      },
      "request": {
        "method": "GET",
        "url": "https://api.straico.com/v0/rag/{{ragId}}"
      }
    },
    "delete_rag": {
      "label": "Delete RAG",
      "description": "Delete a specific RAG (Retrieval-Augmented Generation) base by its ID.",
      "inputs": {
        "ragId": {
          "label": "RAG ID",
          "description": "The ID of the RAG base to delete",
          "required": true
        }
      },
      "request": {
        "method": "DELETE",
        "url": "https://api.straico.com/v0/rag/{{ragId}}"
      }
    },
    "rag_prompt_completion": {
      "label": "RAG Prompt Completion",
      "description": "Send a prompt to a specific RAG (Retrieval-Augmented Generation) model.",
      "inputs": {
        "ragId": {
          "label": "RAG ID",
          "description": "The ID of the RAG base to query",
          "required": true
        },
        "prompt": {
          "label": "Prompt",
          "description": "A text prompt for the RAG model",
          "required": true,
          "type": "multiline"
        },
        "model": {
          "label": "Model",
          "description": "The specific LLM to be used",
          "required": true,
          "defaultValue": "openai/gpt-4o-mini"
        },
        "searchType": {
          "label": "Search Type",
          "description": "Type of search to perform",
          "type": "select",
          "options": [
            {
              "value": "similarity",
              "label": "Similarity"
            },
            {
              "value": "mmr",
              "label": "MMR"
            },
            {
              "value": "similarity_score_threshold",
              "label": "Similarity Score Threshold"
            }
          ]
        },
        "k": {
          "label": "Number of Documents",
          "description": "Number of documents to return",
          "type": "number"
        },
        "fetchK": {
          "label": "Fetch K",
          "description": "Amount of documents to pass to MMR algorithm",
          "type": "number"
        },
        "lambdaMult": {
          "label": "Lambda Mult",
          "description": "Diversity of results return by MMR (1 for minimum and 0 for maximum)",
          "type": "number"
        },
        "scoreThreshold": {
          "label": "Score Threshold",
          "description": "Minimum relevance threshold for similarity_score_threshold",
          "type": "number"
        }
      },
      "request": {
        "method": "POST",
        "url": "https://api.straico.com/v0/rag/{{ragId}}/prompt",
        "body": {
          "prompt": "{{prompt}}",
          "model": "{{model}}",
          "k": "{{k}}",
          "fetch_k": "{{fetchK}}",
          "lambda_mult": "{{lambdaMult}}",
          "score_threshold": "{{scoreThreshold}}"
        }
      }
    },
    "agent-create": {
      "label": "Create Agent",
      "description": "Creates a new agent in the database for the user.",
      "inputs": {
        "name": {
          "label": "Name",
          "description": "A name for the agent",
          "required": true
        },
        "description": {
          "label": "Description",
          "description": "A brief description of what the model does",
          "required": true,
          "type": "multiline"
        },
        "custom_prompt": {
          "label": "Custom Prompt",
          "description": "A model that the agent will use for processing prompts",
          "required": true,
          "type": "multiline"
        },
        "default_llm": {
          "label": "Default LLM",
          "description": "The language model which the agent will use for processing prompts",
          "required": true,
          "defaultValue": "openai/gpt-4o-mini"
        },
        "tags": {
          "label": "Tags",
          "description": "An array of tags for the agent. Example: [\"assistant\",\"tag\"]",
          "type": "json"
        }
      },
      "request": {
        "method": "POST",
        "url": "https://api.straico.com/v0/agent",
        "body": {
          "name": "{{name}}",
          "description": "{{description}}",
          "custom_prompt": "{{custom_prompt}}",
          "default_llm": "{{default_llm}}"
        }
      }
    },
    "agent-add-rag": {
      "label": "Add RAG to Agent",
      "description": "Adds a new RAG to an agent in the database for the user.",
      "inputs": {
        "agent_id": {
          "label": "Agent",
          "description": "The agent to add the RAG to.",
          "required": true
        },
        "rag_id": {
          "label": "RAG ID",
          "description": "The ID of the RAG to add to the agent",
          "required": true
        }
      },
      "request": {
        "method": "POST",
        "url": "https://api.straico.com/v0/agent/{{agent_id}}/rag",
        "body": {
          "rag": "{{rag_id}}"
        }
      }
    },
    "agent-list": {
      "label": "List Agents",
      "description": "Retrieves the list of agents created by and available to the user.",
      "inputs": {},
      "request": {
        "method": "GET",
        "url": "https://api.straico.com/v0/agent"
      }
    },
    "agent_delete": {
      "label": "Delete Agent",
      "description": "Delete a specific agent by its ID",
      "inputs": {
        "agentId": {
          "label": "Agent",
          "description": "Select the agent to delete",
          "required": true
        }
      },
      "request": {
        "method": "DELETE",
        "url": "https://api.straico.com/v0/agent/{{agentId}}"
      }
    },
    "agent_update": {
      "label": "Update Agent",
      "description": "Update the details of a specific agent",
      "inputs": {
        "agentId": {
          "label": "Agent",
          "description": "Select the agent to update",
          "required": true
        },
        "name": {
          "label": "Name",
          "description": "New name for the agent"
        },
        "description": {
          "label": "Description",
          "description": "New description for the agent",
          "type": "multiline"
        },
        "customPrompt": {
          "label": "Custom Prompt",
          "description": "New custom prompt for the agent",
          "type": "multiline"
        },
        "defaultLlm": {
          "label": "Default LLM",
          "description": "New default LLM for the agent",
          "defaultValue": "openai/gpt-4o-mini"
        },
        "status": {
          "label": "Status",
          "description": "New status for the agent",
          "type": "select",
          "options": [
            {
              "value": "active",
              "label": "Active"
            },
            {
              "value": "inactive",
              "label": "Inactive"
            }
          ]
        },
        "visibility": {
          "label": "Visibility",
          "description": "New visibility setting for the agent",
          "type": "select",
          "options": [
            {
              "value": "private",
              "label": "Private"
            },
            {
              "value": "public",
              "label": "Public"
            }
          ]
        }
      },
      "request": {
        "method": "PUT",
        "url": "https://api.straico.com/v0/agent/{{agentId}}",
        "body": {
          "name": "{{name}}",
          "description": "{{description}}",
          "custom_prompt": "{{customPrompt}}",
          "default_llm": "{{defaultLlm}}"
        }
      }
    },
    "agent_get": {
      "label": "Get Agent Details",
      "description": "Retrieve details of a specific agent",
      "inputs": {
        "agentId": {
          "label": "Agent",
          "description": "Select the agent to get details for.",
          "required": true
        }
      },
      "request": {
        "method": "GET",
        "url": "https://api.straico.com/v0/agent/{{agentId}}"
      }
    },
    "agent_prompt_completion": {
      "label": "Agent Prompt Completion",
      "description": "Prompt an agent with a message and get a response",
      "inputs": {
        "agentId": {
          "label": "Agent",
          "description": "Select the agent to prompt.",
          "required": true
        },
        "prompt": {
          "label": "Prompt",
          "description": "The text prompt for the agent",
          "required": true,
          "type": "multiline"
        },
        "searchType": {
          "label": "Search Type",
          "description": "The search type to use for RAG model",
          "type": "select",
          "options": [
            {
              "value": "similarity",
              "label": "Similarity"
            },
            {
              "value": "mmr",
              "label": "MMR"
            },
            {
              "value": "similarity_score_threshold",
              "label": "Similarity Score Threshold"
            }
          ]
        },
        "k": {
          "label": "Number of Documents",
          "description": "Number of documents to return",
          "type": "number"
        },
        "fetchK": {
          "label": "Fetch K",
          "description": "Amount of documents to pass to MMR algorithm",
          "type": "number"
        },
        "lambdaMult": {
          "label": "Lambda Mult",
          "description": "Diversity of results returned by MMR (0 for minimum, 1 for maximum)",
          "type": "number"
        },
        "scoreThreshold": {
          "label": "Score Threshold",
          "description": "Minimum relevance threshold for similarity_score_threshold",
          "type": "number"
        }
      },
      "request": {
        "method": "POST",
        "url": "https://api.straico.com/v0/agent/{{agentId}}/prompt",
        "body": {
          "prompt": "{{prompt}}",
          "k": "{{k}}",
          "fetch_k": "{{fetchK}}",
          "lambda_mult": "{{lambdaMult}}",
          "score_threshold": "{{scoreThreshold}}"
        }
      }
    }
  },
  "triggers": {}
}
