{
  "name": "motion",
  "label": "Motion",
  "description": "",
  "icon": "",
  "hosts": [
    "api.usemotion.com"
  ],
  "upstream": {
    "package": "@activepieces/piece-motion",
    "version": "0.2.3"
  },
  "credential": {
    "fields": {
      "token": {
        "label": "API Key",
        "description": "You can obtain API key from [API Settings](https://app.usemotion.com/web/settings/api).",
        "secret": true,
        "required": true
      }
    },
    "headers": {
      "x-api-key": "{{credential.token}}"
    }
  },
  "actions": {
    "create-task": {
      "label": "Create Task",
      "description": "Creates a new task.",
      "inputs": {
        "workspaceId": {
          "label": "Workspace ID",
          "required": true
        },
        "name": {
          "label": "Task Name",
          "required": true
        },
        "description": {
          "label": "Description",
          "type": "multiline"
        },
        "dueDate": {
          "label": "Due Date"
        },
        "duration": {
          "label": "Duration",
          "description": "Duration in minutes.",
          "type": "number"
        },
        "statusId": {
          "label": "Status"
        },
        "priority": {
          "label": "Priority",
          "type": "select",
          "options": [
            {
              "value": "ASAP",
              "label": "ASAP"
            },
            {
              "value": "HIGH",
              "label": "HIGH"
            },
            {
              "value": "MEDIUM",
              "label": "MEDIUM"
            },
            {
              "value": "LOW",
              "label": "LOW"
            }
          ]
        },
        "projectId": {
          "label": "Project"
        },
        "assigneeId": {
          "label": "Assignee"
        },
        "labels": {
          "label": "Labels",
          "description": "The names of the labels to be added to the task.",
          "type": "json"
        }
      },
      "request": {
        "method": "POST",
        "url": "https://api.usemotion.com/v1/tasks",
        "body": {
          "name": "{{name}}",
          "workspaceId": "{{workspaceId}}",
          "description": "{{description}}",
          "dueDate": "{{dueDate}}",
          "duration": "{{duration}}",
          "status": "{{statusId}}",
          "projectId": "{{projectId}}",
          "assigneeId": "{{assigneeId}}",
          "labels": []
        }
      }
    },
    "update-task": {
      "label": "Update Task",
      "description": "Update an existing task in Motion",
      "inputs": {
        "workspaceId": {
          "label": "Workspace ID",
          "required": true
        },
        "taskId": {
          "label": "Task ID",
          "required": true
        },
        "name": {
          "label": "Task Name"
        },
        "description": {
          "label": "Description",
          "type": "multiline"
        },
        "dueDate": {
          "label": "Due Date"
        },
        "duration": {
          "label": "Duration",
          "description": "Duration in minutes.",
          "type": "number"
        },
        "statusId": {
          "label": "Status"
        },
        "priority": {
          "label": "Priority",
          "type": "select",
          "options": [
            {
              "value": "ASAP",
              "label": "ASAP"
            },
            {
              "value": "HIGH",
              "label": "HIGH"
            },
            {
              "value": "MEDIUM",
              "label": "MEDIUM"
            },
            {
              "value": "LOW",
              "label": "LOW"
            }
          ]
        },
        "projectId": {
          "label": "Project"
        },
        "assigneeId": {
          "label": "Assignee"
        },
        "labels": {
          "label": "Labels",
          "description": "The names of the labels to be added to the task",
          "type": "json"
        }
      },
      "request": {
        "method": "PATCH",
        "url": "https://api.usemotion.com/v1/tasks/{{taskId}}",
        "body": {
          "name": "{{name}}",
          "workspaceId": "{{workspaceId}}",
          "description": "{{description}}",
          "dueDate": "{{dueDate}}",
          "duration": "{{duration}}",
          "staus": "{{statusId}}",
          "assigneeId": "{{assigneeId}}"
        }
      }
    },
    "create-project": {
      "label": "Create Project",
      "description": "Create a new project in Motion",
      "inputs": {
        "workspaceId": {
          "label": "Workspace ID",
          "required": true
        },
        "name": {
          "label": "Project Name",
          "required": true
        },
        "description": {
          "label": "Description",
          "type": "multiline"
        },
        "dueDate": {
          "label": "Due Date",
          "description": "ISO 8601 Due date on the project"
        },
        "priority": {
          "label": "Priority",
          "type": "select",
          "options": [
            {
              "value": "ASAP",
              "label": "ASAP"
            },
            {
              "value": "HIGH",
              "label": "HIGH"
            },
            {
              "value": "MEDIUM",
              "label": "MEDIUM"
            },
            {
              "value": "LOW",
              "label": "LOW"
            }
          ]
        },
        "labels": {
          "label": "Labels",
          "type": "json"
        }
      },
      "request": {
        "method": "POST",
        "url": "https://api.usemotion.com/v1/projects",
        "body": {
          "name": "{{name}}",
          "workspaceId": "{{workspaceId}}",
          "description": "{{description}}",
          "dueDate": "{{dueDate}}",
          "labels": []
        }
      }
    },
    "get-task": {
      "label": "Get Task",
      "description": "Get details of a specific task by ID.",
      "inputs": {
        "taskId": {
          "label": "Task ID",
          "required": true
        }
      },
      "request": {
        "method": "GET",
        "url": "https://api.usemotion.com/v1/tasks/{{taskId}}"
      }
    },
    "moveTask": {
      "label": "Move Task",
      "description": "Moves a task to a different workspace.",
      "inputs": {
        "workspaceId": {
          "label": "Current Workspace",
          "required": true
        },
        "taskId": {
          "label": "Task ID",
          "required": true
        },
        "newWorkspaceId": {
          "label": "Target Workspace",
          "required": true
        }
      },
      "request": {
        "method": "PATCH",
        "url": "https://api.usemotion.com/v1/tasks/{{taskId}}/move",
        "body": {
          "workspaceId": "{{newWorkspaceId}}"
        }
      }
    },
    "find-task": {
      "label": "Find Task",
      "description": "Finds an existing task.",
      "inputs": {
        "workspaceId": {
          "label": "Workspace ID",
          "required": true
        },
        "includeAllStatuses": {
          "label": "Include All Statuses",
          "type": "boolean"
        },
        "name": {
          "label": "Task Name",
          "required": true
        },
        "status": {
          "label": "Status"
        },
        "assigneeId": {
          "label": "Assignee"
        },
        "projectId": {
          "label": "Project"
        }
      },
      "request": {
        "method": "GET",
        "url": "https://api.usemotion.com/v1/tasks",
        "query": {
          "name": "{{name}}",
          "workspaceId": "{{workspaceId}}",
          "includeAllStatuses": "false",
          "status": "{{status}}",
          "projectId": "{{projectId}}",
          "assigneeId": "{{assigneeId}}"
        }
      }
    }
  },
  "triggers": {}
}
