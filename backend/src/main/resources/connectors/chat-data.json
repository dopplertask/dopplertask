{
  "name": "chat-data",
  "label": "Chat Data",
  "description": "Build AI-chatbots with support for live chat escalation, knowledge bases, or custom backend endpoints.",
  "icon": "",
  "hosts": [
    "api.chat-data.com"
  ],
  "upstream": {
    "package": "@activepieces/piece-chat-data",
    "version": "0.1.8"
  },
  "credential": {
    "fields": {
      "token": {
        "label": "API Key",
        "description": "Enter your Chat Data API key",
        "secret": true,
        "required": true
      }
    },
    "headers": {
      "authorization": "Bearer {{credential.token}}"
    }
  },
  "actions": {
    "delete_chatbot": {
      "label": "Delete Chatbot",
      "description": "Delete a chatbot and all its associated data (training data, conversations, leads, etc.). This action is irreversible.",
      "inputs": {
        "chatbotId": {
          "label": "Chatbot",
          "description": "Select the chatbot to delete",
          "required": true
        }
      },
      "request": {
        "method": "DELETE",
        "url": "https://api.chat-data.com/api/v2/delete-chatbot/{{chatbotId}}"
      }
    },
    "send_message": {
      "label": "Send Message to Chatbot",
      "description": "Send messages to a chatbot and receive a response with support for streaming and OpenAI-compatible formats",
      "inputs": {
        "chatbotId": {
          "label": "Chatbot",
          "description": "Select the chatbot to send message to",
          "required": true
        },
        "messageContent": {
          "label": "Message Content",
          "description": "The text content of the message to send",
          "required": true,
          "type": "multiline"
        },
        "messageRole": {
          "label": "Message Role",
          "description": "The role of the message sender",
          "type": "select",
          "options": [
            {
              "value": "user",
              "label": "User"
            },
            {
              "value": "assistant",
              "label": "Assistant"
            }
          ],
          "defaultValue": "user"
        },
        "conversationId": {
          "label": "Conversation",
          "description": "Select an existing conversation or leave empty to start a new one"
        },
        "includeReasoning": {
          "label": "Include Reasoning",
          "description": "Include reasoning in the response (overrides chatbot settings)",
          "type": "boolean"
        },
        "baseModel": {
          "label": "Base Model",
          "description": "Override the chatbot's base model for this request",
          "type": "select",
          "options": [
            {
              "value": "gpt-4o-mini",
              "label": "GPT-4o Mini"
            },
            {
              "value": "gpt-4o",
              "label": "GPT-4o"
            },
            {
              "value": "gpt-4",
              "label": "GPT-4"
            },
            {
              "value": "gpt-4.1-nano",
              "label": "GPT-4.1 Nano"
            },
            {
              "value": "gpt-4.1-mini",
              "label": "GPT-4.1 Mini"
            },
            {
              "value": "gpt-4.1",
              "label": "GPT-4.1"
            },
            {
              "value": "gpt-5-nano",
              "label": "GPT-5 Nano"
            },
            {
              "value": "gpt-5-mini",
              "label": "GPT-5 Mini"
            },
            {
              "value": "gpt-5",
              "label": "GPT-5"
            },
            {
              "value": "gpt-o1",
              "label": "GPT-O1"
            },
            {
              "value": "gpt-o3-mini",
              "label": "GPT-O3 Mini"
            },
            {
              "value": "gpt-o3",
              "label": "GPT-O3"
            },
            {
              "value": "gpt-o4-mini",
              "label": "GPT-O4 Mini"
            },
            {
              "value": "claude-3-5-sonnet",
              "label": "Claude 3.5 Sonnet"
            },
            {
              "value": "claude-3-7-sonnet",
              "label": "Claude 3.7 Sonnet"
            },
            {
              "value": "claude-4-sonnet",
              "label": "Claude 4 Sonnet"
            },
            {
              "value": "claude-4-5-sonnet",
              "label": "Claude 4.5 Sonnet"
            },
            {
              "value": "claude-3-5-haiku",
              "label": "Claude 3.5 Haiku"
            },
            {
              "value": "claude-3-haiku",
              "label": "Claude 3 Haiku"
            },
            {
              "value": "claude-4-opus",
              "label": "Claude 4 Opus"
            },
            {
              "value": "claude-4.1-opus",
              "label": "Claude 4.1 Opus"
            },
            {
              "value": "gemini-2.5-flash",
              "label": "Gemini 2.5 Flash"
            },
            {
              "value": "gemini-2.0-flash",
              "label": "Gemini 2.0 Flash"
            },
            {
              "value": "gemini-1.5-flash",
              "label": "Gemini 1.5 Flash"
            },
            {
              "value": "gemini-2.5-pro",
              "label": "Gemini 2.5 Pro"
            },
            {
              "value": "deepseek-r1",
              "label": "DeepSeek R1"
            }
          ]
        },
        "basePrompt": {
          "label": "Base Prompt Override",
          "description": "Override the chatbot's base prompt for this request",
          "type": "multiline"
        },
        "openAIFormat": {
          "label": "OpenAI Format",
          "description": "Return response in OpenAI-compatible format",
          "type": "boolean"
        },
        "appendMessages": {
          "label": "Append to Conversation",
          "description": "Append this message to previous messages with the same conversationId",
          "type": "boolean"
        },
        "attachedFiles": {
          "label": "Attached Files",
          "description": "Files to attach to the message (max 3 files)",
          "type": "json"
        }
      },
      "request": {
        "method": "POST",
        "url": "https://api.chat-data.com/api/v2/chat",
        "body": {
          "messages": [
            {
              "role": "user",
              "content": "{{messageContent}}"
            }
          ],
          "chatbotId": "{{chatbotId}}",
          "basePrompt": "{{basePrompt}}",
          "stream": false,
          "openAIFormat": false,
          "appendMessages": false,
          "conversationId": "{{conversationId}}"
        }
      }
    },
    "retrain_chatbot": {
      "label": "Retrain Chatbot",
      "description": "Retrain an existing chatbot with new data or remove existing data (custom-data-upload model only)",
      "inputs": {
        "chatbotId": {
          "label": "Chatbot",
          "description": "Select the chatbot to retrain",
          "required": true
        },
        "sourceText": {
          "label": "Source Text",
          "description": "New text data for training the chatbot",
          "type": "multiline"
        },
        "urlsToScrape": {
          "label": "URLs to Scrape",
          "description": "List of URLs to extract content from (existing URLs will be recrawled)",
          "type": "json"
        },
        "cookies": {
          "label": "Cookies",
          "description": "Cookies for authorization (semicolon-separated: \"cookie1=value1; cookie2=value2\")",
          "type": "multiline"
        },
        "extractMainContent": {
          "label": "Extract Main Content",
          "description": "Automatically remove headers, footers, nav, sidebar, and ads",
          "type": "boolean"
        },
        "includeOnlyTags": {
          "label": "Include Only Tags",
          "description": "CSS selectors to exclusively extract (comma-separated)"
        },
        "excludeTags": {
          "label": "Exclude Tags",
          "description": "CSS selectors to exclude from scraping (comma-separated)"
        },
        "products": {
          "label": "Products",
          "description": "List of products for training (existing products with same ID will be overwritten)",
          "type": "json"
        },
        "qAndAs": {
          "label": "Q&As",
          "description": "List of questions and answers for the chatbot to learn",
          "type": "json"
        },
        "deletes": {
          "label": "Knowledge to Delete",
          "description": "List of knowledge sources to remove from the chatbot",
          "type": "json"
        }
      },
      "request": {
        "method": "POST",
        "url": "https://api.chat-data.com/api/v2/retrain-chatbot",
        "body": {
          "chatbotId": "{{chatbotId}}",
          "sourceText": "{{sourceText}}",
          "options": {
            "Cookies": "{{cookies}}",
            "includeOnlyTags": "{{includeOnlyTags}}",
            "excludeTags": "{{excludeTags}}"
          }
        }
      }
    }
  },
  "triggers": {}
}
