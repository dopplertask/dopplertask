{
  "name": "bookedin",
  "label": "Bookedin",
  "description": "AI agents for lead conversion and appointment booking.",
  "icon": "",
  "hosts": [
    "api.bookedin.ai"
  ],
  "upstream": {
    "package": "@activepieces/piece-bookedin",
    "version": "0.2.2"
  },
  "credential": {
    "fields": {
      "token": {
        "label": "API Key",
        "description": "To connect your Bookedin account, please follow these steps to retrieve your API Key:\n\n    1. Log in to your Bookedin Dashboard: dashboard.bookedin.ai\n    2. From the left menu, go to **Business**\n    3. Open **Settings**\n    4. Click on **API Key**\n    5. Copy your API Key (starts with **sk_…**)\n    6. Paste the key below to authorize the integration\n\n    Your API Key allows Activepieces to securely access your Bookedin leads, agents, and booking data.\n    ",
        "secret": true,
        "required": true
      }
    },
    "headers": {
      "x-api-key": "{{credential.token}}"
    }
  },
  "actions": {
    "getLeads": {
      "label": "Get Leads",
      "description": "Get all leads for the current business with pagination metadata.",
      "inputs": {
        "search": {
          "label": "Search",
          "description": "Search text in name, email, or phone number"
        },
        "source": {
          "label": "Source",
          "description": "Filter by lead source (e.g., \"API\", \"Import\")"
        },
        "email": {
          "label": "Email",
          "description": "Filter by exact email address"
        },
        "phone": {
          "label": "Phone",
          "description": "Filter by phone number"
        },
        "limit": {
          "label": "Limit",
          "description": "Number of leads to return",
          "type": "number",
          "defaultValue": "100"
        },
        "skip": {
          "label": "Skip",
          "description": "Number of leads to skip (pagination)",
          "type": "number",
          "defaultValue": "0"
        }
      },
      "request": {
        "method": "GET",
        "url": "https://api.bookedin.ai/api/v1/leads/",
        "query": {
          "limit": "{{limit}}",
          "skip": "{{skip}}",
          "search": "{{search}}",
          "source": "{{source}}",
          "email": "{{email}}",
          "phone": "{{phone}}"
        }
      }
    },
    "createLead": {
      "label": "Create Lead",
      "description": "Creates a new lead in Bookedin AI",
      "inputs": {
        "firstName": {
          "label": "First Name",
          "required": true
        },
        "lastName": {
          "label": "Last Name",
          "required": true
        },
        "email": {
          "label": "Email",
          "required": true
        },
        "phone": {
          "label": "Phone Number",
          "required": true
        }
      },
      "request": {
        "method": "POST",
        "url": "https://api.bookedin.ai/api/v1/leads/",
        "body": {
          "contact": {
            "name": {
              "last": "{{lastName}}",
              "first": "{{firstName}}"
            },
            "email": "{{email}}",
            "number": "{{phone}}"
          }
        }
      }
    },
    "getLead": {
      "label": "Get Lead",
      "description": "Get a specific lead by ID.",
      "inputs": {
        "lead_id": {
          "label": "Lead",
          "description": "Select a lead",
          "required": true
        }
      },
      "request": {
        "method": "GET",
        "url": "https://api.bookedin.ai/api/v1/leads/{{lead_id}}"
      }
    },
    "deleteLead": {
      "label": "Delete Lead",
      "description": "Delete a lead.",
      "inputs": {
        "lead_id": {
          "label": "Lead",
          "description": "Select a lead",
          "required": true
        }
      },
      "request": {
        "method": "DELETE",
        "url": "https://api.bookedin.ai/api/v1/leads/{{lead_id}}"
      }
    },
    "getLeadStats": {
      "label": "Get Lead Stats",
      "description": "Get lead statistics (Hot, Warm, Cold, Objectives Met, Total).",
      "inputs": {},
      "request": {
        "method": "GET",
        "url": "https://api.bookedin.ai/api/v1/leads/stats"
      }
    },
    "updateLead": {
      "label": "Update Lead",
      "description": "Update a lead.",
      "inputs": {
        "lead_id": {
          "label": "Lead",
          "description": "Select a lead",
          "required": true
        },
        "firstName": {
          "label": "First Name"
        },
        "lastName": {
          "label": "Last Name"
        },
        "email": {
          "label": "Email"
        },
        "phone": {
          "label": "Phone Number"
        },
        "handling_status": {
          "label": "Handling Status"
        },
        "update_json": {
          "label": "Update Payload (JSON)",
          "description": "Optional JSON body for complex updates. Merges with individual fields above.",
          "type": "json"
        }
      },
      "request": {
        "method": "PUT",
        "url": "https://api.bookedin.ai/api/v1/leads/{{lead_id}}",
        "body": {
          "contact": {
            "name": {
              "first": "{{firstName}}",
              "last": "{{lastName}}"
            },
            "email": "{{email}}",
            "number": "{{phone}}"
          },
          "handling_status": "{{handling_status}}"
        }
      }
    }
  },
  "triggers": {}
}
