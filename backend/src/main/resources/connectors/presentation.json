{
  "name": "presentation",
  "label": "Presenton",
  "description": "Generate AI-powered presentations using Presenton (https://presenton.ai). Supports templates, themes, images, synchronous and asynchronous generation, status polling, and export to PPTX/PDF.",
  "icon": "",
  "hosts": [
    "api.presenton.ai"
  ],
  "upstream": {
    "package": "@activepieces/piece-presentation",
    "version": "0.3.2"
  },
  "credential": {
    "fields": {
      "token": {
        "label": "Presenton API Key",
        "description": "Your Presenton API key. Create one from your account at https://presenton.ai.",
        "secret": true,
        "required": true
      }
    },
    "headers": {
      "authorization": "Bearer {{credential.token}}"
    }
  },
  "actions": {
    "generate_presentations": {
      "label": "Generate Presentations (async)",
      "description": "Create an asynchronous presentation generation task at Presenton and return the created task.",
      "inputs": {
        "content": {
          "label": "Content",
          "description": "The content for generating the presentation",
          "type": "multiline"
        },
        "instructions": {
          "label": "Instructions",
          "description": "Instruction for generating the presentation (optional).",
          "type": "multiline"
        },
        "tone": {
          "label": "Tone",
          "description": "Tone to use for the text",
          "type": "select",
          "options": [
            {
              "value": "default",
              "label": "Default"
            },
            {
              "value": "casual",
              "label": "Casual"
            },
            {
              "value": "professional",
              "label": "Professional"
            },
            {
              "value": "funny",
              "label": "Funny"
            },
            {
              "value": "educational",
              "label": "Educational"
            },
            {
              "value": "sales_pitch",
              "label": "Sales pitch"
            }
          ],
          "defaultValue": "default"
        },
        "verbosity": {
          "label": "Verbosity",
          "description": "How verbose the text should be",
          "type": "select",
          "options": [
            {
              "value": "concise",
              "label": "Concise"
            },
            {
              "value": "standard",
              "label": "Standard"
            },
            {
              "value": "text-heavy",
              "label": "Text-heavy"
            }
          ],
          "defaultValue": "standard"
        },
        "slides_markdown": {
          "label": "Slides markdown",
          "description": "An array of markdown strings for each slide (optional).",
          "type": "json"
        },
        "markdown_emphasis": {
          "label": "Markdown emphasis",
          "description": "Whether to emphasize the markdown",
          "type": "boolean",
          "defaultValue": "true"
        },
        "web_search": {
          "label": "Enable web search",
          "description": "Whether to enable web search",
          "type": "boolean",
          "defaultValue": "false"
        },
        "image_type": {
          "label": "Image type",
          "description": "Type of image to generate",
          "type": "select",
          "options": [
            {
              "value": "stock",
              "label": "Stock"
            },
            {
              "value": "ai-generated",
              "label": "AI generated"
            }
          ],
          "defaultValue": "stock"
        },
        "theme": {
          "label": "Theme",
          "description": "Theme to use for the presentation (e.g. edge-yellow, light-rose)"
        },
        "n_slides": {
          "label": "Number of slides",
          "description": "Number of slides to generate",
          "type": "number",
          "defaultValue": "8"
        },
        "language": {
          "label": "Language",
          "description": "Language for the presentation",
          "defaultValue": "English"
        },
        "template": {
          "label": "Template",
          "description": "Template to use for the presentation",
          "type": "select",
          "options": [
            {
              "value": "general",
              "label": "General"
            },
            {
              "value": "modern",
              "label": "Modern"
            },
            {
              "value": "standard",
              "label": "Standard"
            },
            {
              "value": "swift",
              "label": "Swift"
            }
          ],
          "defaultValue": "general"
        },
        "include_table_of_contents": {
          "label": "Include table of contents",
          "description": "Whether to include a table of contents",
          "type": "boolean",
          "defaultValue": "false"
        },
        "include_title_slide": {
          "label": "Include title slide",
          "description": "Whether to include a title slide",
          "type": "boolean",
          "defaultValue": "true"
        },
        "allow_access_to_user_info": {
          "label": "Allow access to user's info",
          "description": "Whether to allow access to user's info",
          "type": "boolean",
          "defaultValue": "true"
        },
        "files": {
          "label": "Files",
          "description": "Array of file identifiers uploaded via Presenton files API (optional).",
          "type": "json"
        },
        "export_as": {
          "label": "Export as",
          "description": "Export format",
          "type": "select",
          "options": [
            {
              "value": "pptx",
              "label": "PPTX"
            },
            {
              "value": "pdf",
              "label": "PDF"
            }
          ],
          "defaultValue": "pptx"
        },
        "trigger_webhook": {
          "label": "Trigger webhook",
          "description": "Whether to trigger subscribed webhooks",
          "type": "boolean",
          "defaultValue": "false"
        }
      },
      "request": {
        "method": "POST",
        "url": "https://api.presenton.ai/api/v1/ppt/presentation/generate/async",
        "body": {
          "content": "{{content}}",
          "instructions": "{{instructions}}",
          "markdown_emphasis": true,
          "web_search": false,
          "theme": "{{theme}}",
          "n_slides": "{{n_slides}}",
          "language": "{{language}}",
          "template": "general",
          "include_table_of_contents": false,
          "include_title_slide": true,
          "allow_access_to_user_info": true,
          "export_as": "pptx",
          "trigger_webhook": false
        }
      }
    },
    "presentation_get_standard_template": {
      "label": "Get Standard Template",
      "description": "Get a standard template with its layouts and schemas.",
      "inputs": {
        "template_id": {
          "label": "Template ID",
          "required": true
        }
      },
      "request": {
        "method": "GET",
        "url": "https://api.presenton.ai/api/v3/standard-template/{{template_id}}"
      }
    },
    "presentation_get_task_status": {
      "label": "Get Task Status",
      "description": "Check the status of an asynchronous Presenton task.",
      "inputs": {
        "id": {
          "label": "Task ID",
          "description": "Task id returned by presentation_generate_presentation.",
          "required": true
        }
      },
      "request": {
        "method": "GET",
        "url": "https://api.presenton.ai/api/v3/async-task/status/{{id}}"
      }
    },
    "presentation_get_template_example": {
      "label": "Get Template Example",
      "description": "Get an example deck for a standard template.",
      "inputs": {
        "template_id": {
          "label": "Template ID",
          "required": true
        }
      },
      "request": {
        "method": "GET",
        "url": "https://api.presenton.ai/api/v3/standard-template/{{template_id}}/example"
      }
    },
    "presentation_list_presentations": {
      "label": "List Presentations",
      "description": "List presentations in the Presenton account.",
      "inputs": {
        "type": {
          "label": "Type",
          "type": "select",
          "options": [
            {
              "value": "standard",
              "label": "Standard"
            },
            {
              "value": "smart",
              "label": "Smart"
            }
          ]
        },
        "page": {
          "label": "Page",
          "type": "number"
        },
        "page_size": {
          "label": "Page Size",
          "type": "number"
        }
      },
      "request": {
        "method": "GET",
        "url": "https://api.presenton.ai/api/v3/presentation/all",
        "query": {
          "page": "{{page}}",
          "page_size": "{{page_size}}"
        }
      }
    },
    "presentation_list_smart_designs": {
      "label": "List Smart Designs",
      "description": "List Smart Designs available to the account.",
      "inputs": {
        "default": {
          "label": "Default Designs Only",
          "type": "boolean"
        },
        "page": {
          "label": "Page",
          "type": "number"
        },
        "page_size": {
          "label": "Page Size",
          "type": "number"
        }
      },
      "request": {
        "method": "GET",
        "url": "https://api.presenton.ai/api/v3/smart-design/all",
        "query": {
          "page": "{{page}}",
          "page_size": "{{page_size}}"
        }
      }
    },
    "presentation_list_standard_templates": {
      "label": "List Standard Templates",
      "description": "List standard presentation templates.",
      "inputs": {
        "page": {
          "label": "Page",
          "type": "number"
        },
        "page_size": {
          "label": "Page Size",
          "type": "number"
        },
        "default": {
          "label": "Default Templates Only",
          "type": "boolean"
        }
      },
      "request": {
        "method": "GET",
        "url": "https://api.presenton.ai/api/v3/standard-template/all",
        "query": {
          "page": "{{page}}",
          "page_size": "{{page_size}}"
        }
      }
    }
  },
  "triggers": {}
}
