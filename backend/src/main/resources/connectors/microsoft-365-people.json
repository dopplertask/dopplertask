          "label": "Contact Folder Name",
          "required": true
        },
        "parentFolder": {
          "label": "Parent Folder",
          "description": "Select a parent folder"
        }
      },
      "request": {
        "method": "POST",
        "url": "https://graph.microsoft.com/v1.0/me/contactFolders",
        "headers": {
          "sdkversion": "graph-js/3.0.7 (featureUsage=7)"
        },
