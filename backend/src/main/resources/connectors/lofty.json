{
  "name": "lofty",
  "label": "Lofty",
  "description": "Lofty is a product of the technology company Lofty Inc, which offers a complete tech solution for real estate agents.",
  "icon": "",
  "hosts": [
    "api.lofty.com"
  ],
  "upstream": {
    "package": "@activepieces/piece-lofty",
    "version": "0.2.2"
  },
  "credential": {
    "fields": {
      "token": {
        "label": "API Key",
        "description": "API Key for Lofty",
        "secret": true,
        "required": true
      }
    },
    "headers": {
      "authorization": "token {{credential.token}}"
    }
  },
  "actions": {
    "createTransaction": {
      "label": "Create Transaction",
      "description": "Create a transaction for a Lofty lead",
      "inputs": {
        "leadId": {
          "label": "Lead",
          "description": "Select a lead",
          "required": true
        },
        "transactionDate": {
          "label": "Transaction Date",
          "description": "YYYY-MM-DD"
        },
        "amount": {
          "label": "Amount",
          "type": "number"
        },
        "transactionType": {
          "label": "Transaction Type",
          "description": "e.g., sale, rent"
        },
        "propertyAddress": {
          "label": "Property Address"
        },
        "propertyCity": {
          "label": "Property City"
        },
        "propertyState": {
          "label": "Property State"
        },
        "propertyZipcode": {
          "label": "Property Zipcode"
        },
        "beds": {
          "label": "Beds",
          "type": "number"
        },
        "baths": {
          "label": "Baths",
          "type": "number"
        },
        "sqft": {
          "label": "SqFt",
          "type": "number"
        },
        "mlsNumber": {
          "label": "MLS Number"
        },
        "closingDate": {
          "label": "Closing Date",
          "description": "YYYY-MM-DD"
        },
        "agentId": {
          "label": "Agent ID"
        },
        "agentName": {
          "label": "Agent Name"
        },
        "agentEmail": {
          "label": "Agent Email"
        },
        "source": {
          "label": "Source"
        },
        "note": {
          "label": "Note",
          "type": "multiline"
        }
      },
      "request": {
        "method": "POST",
        "url": "https://api.lofty.com/v1.0/leads/{{leadId}}/transaction",
        "body": {
          "transaction_date": "{{transactionDate}}",
          "amount": "{{amount}}",
          "transaction_type": "{{transactionType}}",
          "property_address": "{{propertyAddress}}",
          "property_city": "{{propertyCity}}",
          "property_state": "{{propertyState}}",
          "property_zipcode": "{{propertyZipcode}}",
          "beds": "{{beds}}",
          "baths": "{{baths}}",
          "sqft": "{{sqft}}",
          "mls_number": "{{mlsNumber}}",
          "closing_date": "{{closingDate}}",
          "agent_id": "{{agentId}}",
          "agent_name": "{{agentName}}",
          "agent_email": "{{agentEmail}}",
          "source": "{{source}}",
          "note": "{{note}}"
        }
      }
    },
    "updateLead": {
      "label": "Update Lead",
      "description": "Update a lead in Lofty",
      "inputs": {
        "leadId": {
          "label": "Lead",
          "description": "Select a lead",
          "required": true
        },
        "firstName": {
          "label": "First name"
        },
        "lastName": {
          "label": "Last name"
        },
        "emails": {
          "label": "Email",
          "description": "Lead email address(s)",
          "type": "json"
        },
        "phone": {
          "label": "Phone"
        },
        "birthday": {
          "label": "Birthday",
          "description": "YYYY-MM-DD"
        },
        "mailingAddress": {
          "label": "Street or Complete Address (Mailing Address)"
        },
        "mailingCity": {
          "label": "City (Mailing Address)"
        },
        "mailingState": {
          "label": "State (Mailing Address)"
        },
        "mailingZipcode": {
          "label": "Zip Code (Mailing Address)"
        },
        "leadType": {
          "label": "Lead Type"
        },
        "leadOwnershipLevel": {
          "label": "Lead Ownership Level"
        },
        "source": {
          "label": "Source"
        },
        "segment": {
          "label": "Segment"
        },
        "tags": {
          "label": "Tag(s)",
          "type": "json"
        },
        "note": {
          "label": "Note",
          "type": "multiline"
        },
        "subscriptionSmartPlans": {
          "label": "Subscription - Smart Plans",
          "type": "boolean"
        },
        "subscriptionPropertyAlert": {
          "label": "Subscription - Property Alert",
          "type": "boolean"
        },
        "subscriptionMarketReport": {
          "label": "Subscription - Market Report",
          "type": "boolean"
        },
        "minPriceBuyer": {
          "label": "Min Price (Buyer)",
          "type": "number"
        },
        "maxPriceBuyer": {
          "label": "Max Price (Buyer)",
          "type": "number"
        },
        "locationDeprecated": {
          "label": "Location (Deprecated)"
        },
        "buyerCity": {
          "label": "City (Buyer)"
        },
        "buyerState": {
          "label": "State (Buyer)"
        },
        "buyerZipcode": {
          "label": "Zipcode (Buyer)"
        },
        "buyerAddress": {
          "label": "Address (Buyer)"
        },
        "minBedsBuyer": {
          "label": "Min Beds (Buyer)",
          "type": "number"
        },
        "minBathsBuyer": {
          "label": "Min Baths (Buyer)",
          "type": "number"
        },
        "bedsSeller": {
          "label": "Beds (Seller)",
          "type": "number"
        },
        "bathsSeller": {
          "label": "Baths (Seller)",
          "type": "number"
        },
        "priceSeller": {
          "label": "Price (Seller)",
          "type": "number"
        },
        "addressSeller": {
          "label": "Address (Seller)"
        },
        "sqftSeller": {
          "label": "SqFt (Seller)",
          "type": "number"
        },
        "citySeller": {
          "label": "City (Seller)"
        },
        "stateSeller": {
          "label": "State (Seller)"
        },
        "zipcodeSeller": {
          "label": "Zipcode (Seller)"
        },
        "sendWelcomeEmail": {
          "label": "Send Welcome Email",
          "type": "boolean"
        },
        "callOptIn": {
          "label": "Call Opt In",
          "type": "boolean"
        },
        "textOptIn": {
          "label": "Text Opt In",
          "type": "boolean"
        },
        "emailOptIn": {
          "label": "Email Opt In",
          "type": "boolean"
        },
        "numberConsent": {
          "label": "Number Consent",
          "type": "boolean"
        }
      },
      "request": {
        "method": "PUT",
        "url": "https://api.lofty.com/v1.0/leads/{{leadId}}",
        "body": {
          "first_name": "{{firstName}}",
          "last_name": "{{lastName}}",
          "phone": "{{phone}}",
          "source": "{{source}}",
          "birthday": "{{birthday}}",
          "mailing_address": "{{mailingAddress}}",
          "mailing_city": "{{mailingCity}}",
          "mailing_state": "{{mailingState}}",
          "mailing_zipcode": "{{mailingZipcode}}",
          "lead_type": "{{leadType}}",
          "lead_ownership_level": "{{leadOwnershipLevel}}",
          "segment": "{{segment}}",
          "note": "{{note}}",
          "min_price_buyer": "{{minPriceBuyer}}",
          "max_price_buyer": "{{maxPriceBuyer}}",
          "location_deprecated": "{{locationDeprecated}}",
          "buyer_city": "{{buyerCity}}",
          "buyer_state": "{{buyerState}}",
          "buyer_zipcode": "{{buyerZipcode}}",
          "buyer_address": "{{buyerAddress}}",
          "min_beds_buyer": "{{minBedsBuyer}}",
          "min_baths_buyer": "{{minBathsBuyer}}",
          "beds_seller": "{{bedsSeller}}",
          "baths_seller": "{{bathsSeller}}",
          "price_seller": "{{priceSeller}}",
          "address_seller": "{{addressSeller}}",
          "sqft_seller": "{{sqftSeller}}",
          "city_seller": "{{citySeller}}",
          "state_seller": "{{stateSeller}}",
          "zipcode_seller": "{{zipcodeSeller}}"
        }
      }
    },
    "updateTransaction": {
      "label": "Update Transaction",
      "description": "Update a transaction for a Lofty lead",
      "inputs": {
        "leadId": {
          "label": "Lead",
          "description": "Select a lead",
          "required": true
        },
        "transactionId": {
          "label": "Transaction",
          "description": "Select a transaction",
          "required": true
        },
        "transactionDate": {
          "label": "Transaction Date",
          "description": "YYYY-MM-DD"
        },
        "amount": {
          "label": "Amount",
          "type": "number"
        },
        "transactionType": {
          "label": "Transaction Type",
          "description": "e.g., sale, rent"
        },
        "propertyAddress": {
          "label": "Property Address"
        },
        "propertyCity": {
          "label": "Property City"
        },
        "propertyState": {
          "label": "Property State"
        },
        "propertyZipcode": {
          "label": "Property Zipcode"
        },
        "beds": {
          "label": "Beds",
          "type": "number"
        },
        "baths": {
          "label": "Baths",
          "type": "number"
        },
        "sqft": {
          "label": "SqFt",
          "type": "number"
        },
        "mlsNumber": {
          "label": "MLS Number"
        },
        "closingDate": {
          "label": "Closing Date",
          "description": "YYYY-MM-DD"
        },
        "agentId": {
          "label": "Agent ID"
        },
        "agentName": {
          "label": "Agent Name"
        },
        "agentEmail": {
          "label": "Agent Email"
        },
        "source": {
          "label": "Source"
        },
        "note": {
