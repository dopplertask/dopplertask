{
  "name": "katana",
  "label": "Katana",
  "description": "Katana is a cloud-based manufacturing ERP software for inventory, production, and order management.",
  "icon": "",
  "hosts": [
    "api.katanamrp.com"
  ],
  "upstream": {
    "package": "@activepieces/piece-katana",
    "version": "0.2.1"
  },
  "credential": {
    "fields": {
      "token": {
        "label": "API Key",
        "description": "\nTo generate your API key:\n\n1. Log in to your Katana account\n2. Go to **Settings > API**\n3. Select **Add new API key**\n4. Copy and paste the key here\n",
        "secret": true,
        "required": true
      }
    },
    "headers": {
      "authorization": "Bearer {{credential.token}}"
    }
  },
  "actions": {
    "create_sales_order": {
      "label": "Create Sales Order",
      "description": "Creates a new sales order in Katana.",
      "inputs": {
        "order_no": {
          "label": "Order Number",
          "description": "Unique order number.",
          "required": true
        },
        "customer_id": {
          "label": "Customer",
          "description": "Select the customer.",
          "required": true
        },
        "variant_id": {
          "label": "Product Variant",
          "description": "Select the product variant.",
          "required": true
        },
        "quantity": {
          "label": "Quantity",
          "description": "Quantity for the product variant.",
          "required": true,
          "type": "number"
        },
        "price_per_unit": {
          "label": "Price Per Unit",
          "description": "Override price per unit.",
          "type": "number"
        },
        "total_discount": {
          "label": "Total Discount",
          "description": "Discount amount for this line.",
          "type": "number"
        },
        "tax_rate_id": {
          "label": "Tax Rate"
        },
        "additional_order_rows": {
          "label": "Additional Order Lines (JSON)",
          "description": "Add more line items as JSON array. Each object needs: variant_id, quantity. Optional: price_per_unit, total_discount, tax_rate_id, location_id.",
          "type": "json"
        },
        "status": {
          "label": "Status",
          "description": "Order status. Use PENDING for quotes.",
          "type": "select",
          "options": [
            {
              "value": "NOT_SHIPPED",
              "label": "Not Shipped"
            },
            {
              "value": "PENDING",
              "label": "Pending (Quote)"
            }
          ]
        },
        "location_id": {
          "label": "Location"
        },
        "currency": {
          "label": "Currency",
          "description": "Currency code (ISO 4217), e.g. USD, EUR."
        },
        "order_created_date": {
          "label": "Order Created Date"
        },
        "delivery_date": {
          "label": "Delivery Date"
        },
        "customer_ref": {
          "label": "Customer Reference",
          "description": "Customer reference number (max 255 characters)."
        },
        "additional_info": {
          "label": "Additional Info",
          "description": "Additional notes for this order.",
          "type": "multiline"
        },
        "tracking_number": {
          "label": "Tracking Number",
          "description": "Shipping tracking number (max 256 characters)."
        },
        "tracking_number_url": {
          "label": "Tracking URL",
          "description": "URL to track the shipment."
        },
        "addresses": {
          "label": "Addresses",
          "type": "json"
        },
        "ecommerce_order_type": {
          "label": "E-commerce Order Type",
          "description": "Source platform (e.g. shopify)."
        },
        "ecommerce_store_name": {
          "label": "E-commerce Store Name",
          "description": "Store identifier."
        },
        "ecommerce_order_id": {
          "label": "E-commerce Order ID",
          "description": "External order ID from the e-commerce platform."
        }
      },
      "request": {
        "method": "POST",
        "url": "https://api.katanamrp.com/v1/sales_orders",
        "body": {
          "order_no": "{{order_no}}",
          "customer_id": "{{customer_id}}",
          "sales_order_rows": [
            {
              "variant_id": "{{variant_id}}",
              "quantity": "{{quantity}}",
              "price_per_unit": "{{price_per_unit}}",
              "total_discount": "{{total_discount}}",
              "tax_rate_id": "{{tax_rate_id}}",
              "location_id": "{{location_id}}"
            }
          ],
          "location_id": "{{location_id}}",
          "currency": "{{currency}}",
          "order_created_date": "{{order_created_date}}",
          "delivery_date": "{{delivery_date}}",
          "customer_ref": "{{customer_ref}}",
          "additional_info": "{{additional_info}}",
          "tracking_number": "{{tracking_number}}",
          "tracking_number_url": "{{tracking_number_url}}",
          "ecommerce_order_type": "{{ecommerce_order_type}}",
          "ecommerce_store_name": "{{ecommerce_store_name}}",
          "ecommerce_order_id": "{{ecommerce_order_id}}"
        }
      }
    },
    "find_customer": {
      "label": "Find Customer",
      "description": "Find a customer by name, email, or phone number.",
      "inputs": {
        "name": {
          "label": "Name",
          "description": "Filters customers by name."
        },
        "first_name": {
          "label": "First Name",
          "description": "Filters customers by first name."
        },
        "last_name": {
          "label": "Last Name",
          "description": "Filters customers by last name."
        },
        "company": {
          "label": "Company",
          "description": "Filters customers by company."
        },
        "email": {
          "label": "Email",
          "description": "Filters customers by email."
        },
        "phone": {
          "label": "Phone",
          "description": "Filters customers by phone number."
        },
        "currency": {
          "label": "Currency",
          "description": "Filters customers by currency."
        },
        "reference_id": {
          "label": "Reference ID",
          "description": "Filters customers by reference ID."
        },
        "category": {
          "label": "Category",
          "description": "Filters customers by category."
        },
        "include_deleted": {
          "label": "Include Deleted",
          "description": "Include soft-deleted customers in results.",
          "type": "boolean"
        },
        "limit": {
          "label": "Limit",
          "description": "Maximum number of results to return (default is 50).",
          "type": "number"
        },
        "page": {
          "label": "Page",
          "description": "Page number for pagination (default is 1).",
          "type": "number"
        }
      },
      "request": {
        "method": "GET",
        "url": "https://api.katanamrp.com/v1/customers",
        "query": {
          "name": "{{name}}",
          "first_name": "{{first_name}}",
          "last_name": "{{last_name}}",
          "company": "{{company}}",
          "email": "{{email}}",
          "phone": "{{phone}}",
          "currency": "{{currency}}",
          "reference_id": "{{reference_id}}",
          "category": "{{category}}",
          "limit": "{{limit}}",
          "page": "{{page}}"
        }
      }
    }
  },
  "triggers": {}
}
