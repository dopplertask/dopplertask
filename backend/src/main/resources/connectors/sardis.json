{
  "name": "sardis",
  "label": "Sardis",
  "description": "Policy-controlled payments for AI agents.",
  "icon": "",
  "hosts": [
    "api.sardis.sh"
  ],
  "upstream": {
    "package": "@activepieces/piece-sardis",
    "version": "0.2.1"
  },
  "credential": {
    "fields": {
      "token": {
        "label": "API Key",
        "description": "To get your Sardis API key:\n1. Log in to your [Sardis Dashboard](https://sardis.sh/dashboard).\n2. Navigate to **Settings** -> **API Keys**.\n3. Copy your API key (starts with `sk_`).",
        "secret": true,
        "required": true
      }
    },
    "headers": {
      "x-api-key": "{{credential.token}}"
    }
  },
  "actions": {
    "check_balance": {
      "label": "Check Balance",
      "description": "Check wallet balance and spending limits.",
      "inputs": {
        "walletId": {
          "label": "Wallet ID",
          "description": "Your Sardis wallet ID (starts with wal_)",
          "required": true
        },
        "token": {
          "label": "Token",
          "description": "Stablecoin to use for the transaction",
          "type": "select",
          "options": [
            {
              "value": "USDC",
              "label": "USDC"
            },
            {
              "value": "USDT",
              "label": "USDT"
            },
            {
              "value": "PYUSD",
              "label": "PYUSD"
            },
            {
              "value": "EURC",
              "label": "EURC"
            }
          ],
          "defaultValue": "USDC"
        },
        "chain": {
          "label": "Chain",
          "description": "Blockchain network",
          "type": "select",
          "options": [
            {
              "value": "base",
              "label": "Base"
            },
            {
              "value": "ethereum",
              "label": "Ethereum"
            },
            {
              "value": "polygon",
              "label": "Polygon"
            },
            {
              "value": "arbitrum",
              "label": "Arbitrum"
            },
            {
              "value": "optimism",
              "label": "Optimism"
            }
          ],
          "defaultValue": "base"
        }
      },
      "request": {
        "method": "GET",
        "url": "https://api.sardis.sh/api/v2/wallets/{{walletId}}/balance",
        "query": {
          "chain": "base",
          "token": "USDC"
        }
      }
    },
    "set_policy": {
      "label": "Set Spending Policy",
      "description": "Set or update spending policies on a Sardis agent using natural language.",
      "inputs": {
        "agentId": {
          "label": "Agent ID",
          "description": "Your Sardis agent ID",
          "required": true
        },
        "policyText": {
          "label": "Policy (Natural Language)",
          "description": "Describe the spending rules in plain English. e.g. \"Max $50 per transaction, daily limit $500, block gambling merchants\"",
          "required": true,
          "type": "multiline"
        }
      },
      "request": {
        "method": "POST",
        "url": "https://api.sardis.sh/api/v2/policies/apply",
        "body": {
          "natural_language": "{{policyText}}",
          "agent_id": "{{agentId}}",
          "confirm": true
        }
      }
    },
    "list_transactions": {
      "label": "List Transactions",
      "description": "Retrieve transaction history from a Sardis wallet ledger.",
      "inputs": {
        "walletId": {
          "label": "Wallet ID",
          "description": "Your Sardis wallet ID (starts with wal_)",
          "required": true
        },
        "limit": {
          "label": "Limit",
          "description": "Maximum number of transactions to return (default: 50)",
          "type": "number",
          "defaultValue": "50"
        }
      },
      "request": {
        "method": "GET",
        "url": "https://api.sardis.sh/api/v2/ledger/entries",
        "query": {
          "wallet_id": "{{walletId}}",
          "limit": "500"
        }
      }
    }
  },
  "triggers": {}
}
