{
  "name": "zerobounce",
  "label": "ZeroBounce",
  "description": "ZeroBounce is an email validation service that helps you reduce bounces, improve email deliverability and increase email marketing ROI.",
  "icon": "",
  "hosts": [
    "api.zerobounce.net"
  ],
  "upstream": {
    "package": "@activepieces/piece-zerobounce",
    "version": "0.1.7"
  },
  "credential": {
    "fields": {
      "token": {
        "label": "API Key",
        "description": "",
        "secret": true,
        "required": true
      }
    },
    "query": {
      "api_key": "{{credential.token}}"
    }
  },
  "actions": {
    "validateEmail": {
      "label": "Validate Email",
      "description": "",
      "inputs": {
        "email": {
          "label": "Email",
          "required": true
        },
        "cacheResponse": {
          "label": "Cache Response",
          "description": "Store the response in the project store for future use.",
          "type": "boolean",
          "defaultValue": "true"
        }
      },
      "request": {
        "method": "GET",
        "url": "https://api.zerobounce.net/v2/validate",
        "query": {
          "email": "{{email}}"
        }
      }
    }
  },
  "triggers": {}
}
