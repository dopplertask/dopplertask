{
  "name": "denser-ai",
  "label": "Denser.ai",
  "description": "",
  "icon": "",
  "hosts": [
    "denser.ai"
  ],
  "upstream": {
    "package": "@activepieces/piece-denser-ai",
    "version": "0.1.7"
  },
  "credential": {
    "fields": {
      "chatbotId": {
        "label": "Chatbot ID",
        "description": "The Chatbot ID is available on the [main dashboard of Denser Chatbot](https://denser.ai/u/chatbots). Simply choose the ID of the chatbot you want",
        "required": true
      },
      "apiKey": {
        "label": "API key",
        "description": "",
        "required": true
      }
    },
    "body": {
      "key": "{{credential.apiKey}}",
      "chatbotId": "{{credential.chatbotId}}"
    }
  },
  "actions": {
    "processInputText": {
      "label": "Process input text",
      "description": "Input text processed by the chatbot",
      "inputs": {
        "question": {
          "label": "Question",
          "description": "The question to be processed by the chatbot",
          "required": true,
          "type": "multiline"
        },
        "prompt": {
          "label": "Prompt",
          "description": "The prompt to be used by the chatbot e.g., \"Please provide your answer in the following format: ...\"",
          "type": "multiline"
        },
        "model": {
          "label": "Model",
          "description": "The model to be used by the chatbot (e.g., gpt-3.5, gpt-4)",
          "type": "select",
          "options": [
            {
              "value": "gpt-3.5",
              "label": "gpt-3.5"
            },
            {
              "value": "gpt-4o-mini",
              "label": "gpt-4o-mini"
            },
            {
              "value": "gpt-4",
              "label": "gpt-4"
            },
            {
              "value": "gpt-4o",
              "label": "gpt-4o"
            },
            {
              "value": "claude-3-5-sonnet",
              "label": "claude-3-5-sonnet"
            },
            {
              "value": "claude-3-5-haiku",
              "label": "claude-3-5-haiku"
            },
            {
              "value": "claude-3-7-sonnet",
              "label": "claude-3-7-sonnet"
            }
          ],
          "defaultValue": " gpt-4o-mini"
        },
        "citation": {
          "label": "Citations",
          "description": "Whether to include citations in the response",
          "type": "boolean",
          "defaultValue": "false"
        }
      },
      "request": {
        "method": "POST",
        "url": "https://denser.ai/api/query",
        "body": {
          "question": "{{question}}",
          "prompt": "{{prompt}}"
        }
      }
    }
  },
  "triggers": {}
}
