{
  "name": "seven",
  "label": "seven",
  "description": "Business Messaging Gateway",
  "icon": "",
  "hosts": [
    "gateway.seven.io"
  ],
  "upstream": {
    "package": "@activepieces/piece-seven",
    "version": "0.1.8"
  },
  "credential": {
    "fields": {
      "token": {
        "label": "API key",
        "description": "You can find your API key in [Developer Menu](https://app.seven.io/developer).",
        "secret": true,
        "required": true
      }
    },
    "headers": {
      "x-api-key": "{{credential.token}}"
    }
  },
  "actions": {
    "send-voice-call": {
      "label": "Send Voice Call",
      "description": "Creates a new Text-To-Speech call to a number.",
      "inputs": {
        "to": {
          "label": "To",
          "description": "Recipient number(s) of the voice calls.",
          "required": true
        },
        "from": {
          "label": "From"
        },
        "text": {
          "label": "Message Body",
          "description": "Text message to be read out.",
          "required": true,
          "type": "multiline"
        }
      },
      "request": {
        "method": "POST",
        "url": "https://gateway.seven.io/api/voice",
        "headers": {
          "sentwith": "Activepieces"
        },
        "body": {
          "from": "{{from}}",
          "text": "{{text}}",
          "to": "{{to}}"
        }
      }
    }
  },
  "triggers": {}
}
