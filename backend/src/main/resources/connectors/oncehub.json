{
  "name": "oncehub",
  "label": "Oncehub",
  "description": "Build meaningful on-brand scheduling experiences with OnceHubs online appointment booking software",
  "icon": "",
  "hosts": [
    "api.oncehub.com"
  ],
  "upstream": {
    "package": "@activepieces/piece-oncehub",
    "version": "0.2.2"
  },
  "credential": {
    "fields": {
      "token": {
        "label": "API Key",
        "description": "Oncehub API Key",
        "secret": true,
        "required": true
      }
    },
    "headers": {
      "api-key": "{{credential.token}}"
    }
  },
  "actions": {
    "findContact": {
      "label": "Find Contact",
      "description": "Search for contacts in Oncehub by various criteria",
      "inputs": {
        "email": {
          "label": "Email",
          "description": "Filter contacts by email address",
          "required": true
        }
      },
      "request": {
        "method": "GET",
        "url": "https://api.oncehub.com/v2/contacts",
        "query": {
          "email": "{{email}}"
        }
      }
    },
    "createContact": {
      "label": "Create Contact",
      "description": "Create a new contact in Oncehub. Either email or mobile_phone is required.",
      "inputs": {
        "first_name": {
          "label": "First Name",
          "description": "First name of the contact",
          "required": true
        },
        "last_name": {
          "label": "Last Name",
          "description": "Last name of the contact",
          "required": true
        },
        "email": {
          "label": "Email",
          "description": "Email address of the contact (at least email or mobile_phone required)"
        },
        "mobile_phone": {
          "label": "Mobile Phone",
          "description": "Mobile phone number in E.164 format (at least email or mobile_phone required)"
        },
        "phone": {
          "label": "Phone",
          "description": "Phone number in E.164 format"
        },
        "company": {
          "label": "Company",
          "description": "Company name"
        },
        "job_title": {
          "label": "Job Title",
          "description": "Job title of the contact"
        },
        "street_address": {
          "label": "Street Address",
          "description": "Street address"
        },
        "city": {
          "label": "City",
          "description": "City of the contact"
        },
        "state": {
          "label": "State",
          "description": "State or province"
        },
        "post_code": {
          "label": "Postal Code",
          "description": "Postal code"
        },
        "country": {
          "label": "Country",
          "description": "Country of the contact"
        },
        "company_size": {
          "label": "Company Size",
          "description": "Size of the contact's company"
        },
        "employees": {
          "label": "Employees",
          "description": "Number of employees",
          "type": "number"
        },
        "salutation": {
          "label": "Salutation",
          "description": "Salutation (e.g., Mr., Ms., Dr.)"
        },
        "status": {
          "label": "Status",
          "description": "Status of the contact",
          "type": "select",
          "options": [
            {
              "value": "Qualified",
              "label": "Qualified"
            },
            {
              "value": "Sales qualified",
              "label": "Sales qualified"
            },
            {
              "value": "Marketing qualified",
              "label": "Marketing qualified"
            },
            {
              "value": "Disqualified",
              "label": "Disqualified"
            }
          ]
        }
      },
      "request": {
        "method": "POST",
        "url": "https://api.oncehub.com/v2/contacts",
        "body": {
          "first_name": "{{first_name}}",
          "last_name": "{{last_name}}",
          "email": "{{email}}",
          "mobile_phone": "{{mobile_phone}}",
          "phone": "{{phone}}",
          "company": "{{company}}",
          "job_title": "{{job_title}}",
          "street_address": "{{street_address}}",
          "city": "{{city}}",
          "state": "{{state}}",
          "post_code": "{{post_code}}",
          "country": "{{country}}",
          "company_size": "{{company_size}}",
          "employees": "{{employees}}",
          "salutation": "{{salutation}}"
        }
      }
    }
  },
  "triggers": {}
}
