{
  "name": "fountain",
  "label": "Fountain",
  "description": "Automate your complete HR hiring and onboarding workflow. Manage applicants, job openings, interview scheduling, and track progress through hiring stages with real-time webhooks.",
  "icon": "",
  "hosts": [
    "{{credential.baseUrl}}"
  ],
  "upstream": {
    "package": "@activepieces/piece-fountain",
    "version": "0.1.7"
  },
  "credential": {
    "fields": {
      "apiKey": {
        "label": "API Key",
        "description": "Enter your Fountain API key from Profile > Manage API Keys or Settings > Integrations & API Keys",
        "secret": true,
        "required": true
      },
      "baseUrl": {
        "label": "Base URL",
        "description": "The base URL for your Fountain API (default: https://api.fountain.com). For example: us-2.fountain.com/api/v2. The host only, without https://, such as name.example.com."
      }
    },
    "headers": {
      "authorization": "Bearer {{credential.apiKey}}"
    }
  },
  "actions": {
    "create_applicant": {
      "label": "Create Applicant",
      "description": "Add a new applicant to your hiring pipeline",
      "inputs": {
        "name": {
          "label": "Full Name",
          "description": "Applicant's full name",
          "required": true
        },
        "email": {
          "label": "Email",
          "description": "Applicant's email address",
          "required": true
        },
        "phone_number": {
          "label": "Phone Number",
          "description": "Applicant's complete phone number",
          "required": true
        },
        "check_if_applicant_is_duplicate": {
          "label": "Check for Duplicates",
          "description": "Apply additional duplicate applicant blocking rules specified in company duplicate settings",
          "type": "boolean",
          "defaultValue": "false"
        }
      },
      "request": {
        "method": "POST",
        "url": "https://{{credential.baseUrl}}/v2/applicants",
        "body": {
          "name": "{{name}}",
          "email": "{{email}}",
          "phone_number": "{{phone_number}}"
        }
      }
    },
    "get_applicant_details": {
      "label": "Get Applicant Details",
      "description": "Get complete applicant information",
      "inputs": {
        "id": {
          "label": "Applicant",
          "description": "The applicant to delete (shows 50 most recent applicants)",
          "required": true
        }
      },
      "request": {
        "method": "GET",
        "url": "https://{{credential.baseUrl}}/v2/applicants/{{id}}"
      }
    },
    "get_interview_sessions": {
      "label": "Get Interview Sessions",
      "description": "Returns the applicant's interview sessions",
      "inputs": {
        "id": {
          "label": "Applicant",
          "description": "The applicant to get interview sessions for (shows 50 most recent applicants)",
          "required": true
        }
      },
      "request": {
        "method": "GET",
        "url": "https://{{credential.baseUrl}}/v2/applicants/{{id}}/booked_slots"
      }
    },
    "get_opening": {
      "label": "Get Opening",
      "description": "Get details for a specific job opening",
      "inputs": {
        "id": {
          "label": "Opening",
          "description": "The opening to retrieve details for",
          "required": true
        }
      },
      "request": {
        "method": "GET",
        "url": "https://{{credential.baseUrl}}/v2/funnels/{{id}}"
      }
    },
    "get_stage": {
      "label": "Get Stage",
      "description": "Retrieves a specific Stage",
      "inputs": {
        "funnel_id": {
          "label": "Opening",
          "description": "The opening that contains the stage",
          "required": true
        },
        "id": {
          "label": "Stage",
          "description": "The stage to retrieve details for",
          "required": true
        }
      },
      "request": {
        "method": "GET",
        "url": "https://{{credential.baseUrl}}/v2/stages/{{id}}"
      }
    },
    "list_applicants": {
      "label": "List All Applicant Details",
      "description": "List applicants with optional filters",
      "inputs": {
        "funnel_id": {
          "label": "Opening",
          "description": "Filter applicants by opening"
        },
        "location_id": {
          "label": "Location",
          "description": "Filter applicants by location"
        },
        "stage_id": {
          "label": "Stage",
          "description": "Filter applicants by stage"
        },
        "stage": {
          "label": "Stage",
          "description": "Filter applicants by stage name"
        },
        "labels": {
          "label": "Labels",
          "description": "Filter applicants by labels"
        },
        "phone": {
          "label": "Phone Number",
          "description": "Filter applicants by phone number"
        },
        "exclude_temporary": {
          "label": "Exclude Temporary",
          "description": "Whether to exclude temporary/test applicants",
          "type": "boolean",
          "defaultValue": "false"
        },
        "per_page": {
          "label": "Results Per Page",
          "description": "Number of results per page (default: 25)",
          "type": "number",
          "defaultValue": "25"
        },
        "cursor": {
          "label": "Cursor",
          "description": "Cursor for pagination"
        },
        "include_subaccounts": {
          "label": "Include Sub-accounts",
          "description": "Whether to include applicants from sub-accounts",
          "type": "boolean",
          "defaultValue": "false"
        }
      },
      "request": {
        "method": "GET",
        "url": "https://{{credential.baseUrl}}/v2/applicants",
        "query": {
          "funnel_id": "{{funnel_id}}",
          "location_id": "{{location_id}}",
          "stage_id": "{{stage_id}}",
          "stage": "{{stage}}",
          "labels": "{{labels}}",
          "phone": "{{phone}}",
          "per_page": "{{per_page}}",
          "cursor": "{{cursor}}"
        }
      }
    },
    "list_openings": {
      "label": "List All Opening Details",
      "description": "List job openings with optional filters",
      "inputs": {
        "active": {
          "label": "Active Only",
          "description": "Filter to only active openings",
          "type": "boolean"
        },
        "location_id": {
          "label": "Location",
          "description": "Filter openings by location"
        },
        "is_hiring_funnel": {
          "label": "Hiring Funnels Only",
          "description": "Filter to only hiring funnels",
          "type": "boolean"
        },
        "is_sourcing_funnel": {
          "label": "Sourcing Funnels Only",
          "description": "Filter to only sourcing funnels",
          "type": "boolean"
        },
        "is_private": {
          "label": "Private Only",
          "description": "Filter to only private openings",
          "type": "boolean"
        },
        "owner_id": {
          "label": "Owner",
          "description": "Filter openings by owner"
        },
        "per_page": {
          "label": "Results Per Page",
          "description": "Number of results per page (default: 25)",
          "type": "number",
          "defaultValue": "25"
        },
        "cursor": {
          "label": "Cursor",
          "description": "Cursor for pagination"
        }
      },
      "request": {
        "method": "GET",
        "url": "https://{{credential.baseUrl}}/v2/funnels",
        "query": {
          "location_id": "{{location_id}}",
          "owner_id": "{{owner_id}}",
          "per_page": "{{per_page}}",
          "cursor": "{{cursor}}"
        }
      }
    },
    "list_stages": {
      "label": "List All Stages",
      "description": "Retrieves an Opening's stages",
      "inputs": {
        "funnel_id": {
          "label": "Opening",
          "description": "The opening to get stages for",
          "required": true
        }
      },
      "request": {
        "method": "GET",
        "url": "https://{{credential.baseUrl}}/v2/funnels/{{funnel_id}}/stages"
      }
    },
    "update_applicant": {
      "label": "Update Applicant Info",
      "description": "Update an applicant's information",
      "inputs": {
        "id": {
          "label": "Applicant",
          "description": "The applicant to update (shows 50 most recent applicants)",
          "required": true
        },
        "name": {
          "label": "Name",
          "description": "Applicant's full name"
        },
        "email": {
          "label": "Email",
          "description": "Applicant's email address"
        },
        "phone_number": {
          "label": "Phone Number",
          "description": "Applicant's complete phone number"
        },
        "data": {
          "label": "Custom Data",
          "description": "Custom data fields to update (key-value pairs)",
          "type": "json"
        },
        "secure_data": {
          "label": "Secure Data",
          "description": "Secure data fields to update (key-value pairs like SSN, etc.)",
          "type": "json"
        },
        "rejection_reason": {
          "label": "Rejection Reason",
          "description": "Manually set reason for rejection"
        }
      },
      "request": {
        "method": "PUT",
        "url": "https://{{credential.baseUrl}}/v2/applicants/{{id}}",
        "body": {
          "name": "{{name}}",
          "email": "{{email}}",
          "phone_number": "{{phone_number}}",
          "rejection_reason": "{{rejection_reason}}"
        }
      }
    }
  },
  "triggers": {}
}
