{
  "name": "emailit",
  "label": "Emailit",
  "description": "Send transactional emails with Emailit",
  "icon": "",
  "hosts": [
    "api.emailit.com"
  ],
  "upstream": {
    "package": "@activepieces/piece-emailit",
    "version": "0.2.3"
  },
  "credential": {
    "fields": {
      "token": {
        "label": "API Key",
        "description": "Get your API key from your [Emailit Workspace Settings](https://app.emailit.com/settings/api-keys). A **Full Access** key works with every action. A **Sending Only** key can send, reschedule, cancel, retry and forward emails, but not read emails or manage domains, audiences, contacts or suppressions.",
        "secret": true,
        "required": true
      }
    },
    "headers": {
      "authorization": "Bearer {{credential.token}}"
    }
  },
  "actions": {
    "get_email": {
      "label": "Get Email",
      "description": "Get one sent or received email with its status, headers, body and attachment list.",
      "inputs": {
        "email_id": {
          "label": "Email ID",
          "description": "The Emailit email ID, e.g. em_4KYof1ZzXndZE2VPi0DgULiekG8 (from a Send Email step or Find Emails).",
          "required": true
        }
      },
      "request": {
        "method": "GET",
        "url": "https://api.emailit.com/v2/emails/{{email_id}}"
      }
    },
    "retry_email": {
      "label": "Retry Email",
      "description": "Send a bounced, failed, suppressed or held email again as a new email.",
      "inputs": {
        "email_id": {
          "label": "Email ID",
          "description": "ID of the bounced, failed, suppressed or held email.",
          "required": true
        }
      },
      "request": {
        "method": "POST",
        "url": "https://api.emailit.com/v2/emails/{{email_id}}/retry"
      }
    },
    "get_domain": {
      "label": "Get Sending Domain",
      "description": "Get a sending domain with its verification status and the DNS records to publish.",
      "inputs": {
        "domain": {
          "label": "Domain",
          "description": "The sending domain.",
          "required": true
        }
      },
      "request": {
        "method": "GET",
        "url": "https://api.emailit.com/v2/domains/{{domain}}"
      }
    },
    "get_domain_by_id": {
      "label": "Get Sending Domain (by ID)",
      "description": "Get a sending domain by ID or name.",
      "inputs": {
        "domain": {
          "label": "Domain",
          "description": "Domain ID (dom_…) or domain name, e.g. acme.com.",
          "required": true
        }
      },
      "request": {
        "method": "GET",
        "url": "https://api.emailit.com/v2/domains/{{domain}}"
      }
    },
    "verify_domain": {
      "label": "Check Domain Verification",
      "description": "Re-check a sending domain's DNS records now and update its verification status.",
      "inputs": {
        "domain": {
          "label": "Domain",
          "description": "The sending domain.",
          "required": true
        }
      },
      "request": {
        "method": "POST",
        "url": "https://api.emailit.com/v2/domains/{{domain}}/verify"
      }
    },
    "verify_domain_by_id": {
      "label": "Check Domain Verification (by ID)",
      "description": "Re-check a sending domain given by ID or name.",
      "inputs": {
        "domain": {
          "label": "Domain",
          "description": "Domain ID (dom_…) or domain name.",
          "required": true
        }
      },
      "request": {
        "method": "POST",
        "url": "https://api.emailit.com/v2/domains/{{domain}}/verify"
      }
    },
    "update_subscriber": {
      "label": "Update Subscriber",
      "description": "Subscribe or unsubscribe someone from an audience, or change their name.",
      "inputs": {
        "audience": {
          "label": "Audience",
          "description": "The audience (subscriber list).",
          "required": true
        },
        "subscriber": {
          "label": "Subscriber",
          "description": "Subscriber ID (sub_…) or email address.",
          "required": true
        },
        "subscribed": {
          "label": "Subscribed",
          "type": "select",
          "options": [
            {
              "value": "keep",
              "label": "Keep as is"
            },
            {
              "value": "yes",
              "label": "Subscribed"
            },
            {
              "value": "no",
              "label": "Unsubscribed"
            }
          ],
          "defaultValue": "keep"
        },
        "first_name": {
          "label": "First Name",
          "description": "Leave empty to keep."
        },
        "last_name": {
          "label": "Last Name",
          "description": "Leave empty to keep."
        }
      },
      "request": {
        "method": "POST",
        "url": "https://api.emailit.com/v2/audiences/{{audience}}/subscribers/{{subscriber}}",
        "body": {
          "first_name": "{{first_name}}",
          "last_name": "{{last_name}}"
        }
      }
    },
    "update_subscriber_by_id": {
      "label": "Update Subscriber (by ID)",
      "description": "Update a subscriber of an audience given by ID or name.",
      "inputs": {
        "audience": {
          "label": "Audience",
          "description": "The audience ID (aud_…) or its exact name. Use List Audiences to find it.",
          "required": true
        },
        "subscriber": {
          "label": "Subscriber",
          "description": "Subscriber ID (sub_…) or email address.",
          "required": true
        },
        "subscribed": {
          "label": "Subscribed",
          "type": "select",
          "options": [
            {
              "value": "keep",
              "label": "Keep as is"
            },
            {
              "value": "yes",
              "label": "Subscribed"
            },
            {
              "value": "no",
              "label": "Unsubscribed"
            }
          ],
          "defaultValue": "keep"
        },
        "first_name": {
          "label": "First Name",
          "description": "Leave empty to keep."
        },
        "last_name": {
          "label": "Last Name",
          "description": "Leave empty to keep."
        }
      },
      "request": {
        "method": "POST",
        "url": "https://api.emailit.com/v2/audiences/{{audience}}/subscribers/{{subscriber}}",
        "body": {
          "first_name": "{{first_name}}",
          "last_name": "{{last_name}}"
        }
      }
    },
    "verify_email_address": {
      "label": "Verify Email Address",
      "description": "Check whether an address is valid and safe to send to. Costs 5 credits per check.",
      "inputs": {
        "email": {
          "label": "Email",
          "required": true
        },
        "mode": {
          "label": "Mode",
          "type": "select",
          "options": [
            {
              "value": "fast",
              "label": "Fast (syntax, domain, MX)"
            },
            {
              "value": "full",
              "label": "Full (also checks the mailbox)"
            }
          ],
          "defaultValue": "fast"
        }
      },
      "request": {
        "method": "POST",
        "url": "https://api.emailit.com/v2/email-verifications",
        "body": {
          "email": "{{email}}",
          "mode": "fast"
        }
      }
    }
  },
  "triggers": {}
}
