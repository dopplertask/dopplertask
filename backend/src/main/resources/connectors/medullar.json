{
  "name": "medullar",
  "label": "Medullar",
  "description": "AI-powered discovery & insight platform that acts as your extended digital mind",
  "icon": "",
  "hosts": [
    "api.medullar.com"
  ],
  "upstream": {
    "package": "@activepieces/piece-medullar",
    "version": "0.3.7"
  },
  "credential": {
    "fields": {
      "token": {
        "label": "API Key",
        "description": "Please use your personal **API KEY**. You can generate one in your [Medullar account profile](https://my.medullar.com/my-account), under the **API Keys** section.",
        "secret": true,
        "required": true
      }
    },
    "headers": {
      "authorization": "Bearer {{credential.token}}"
    }
  },
  "actions": {
    "renameSpace": {
      "label": "Rename Space",
      "description": "Rename an existing Space.",
      "inputs": {
        "spaceId": {
          "label": "Space",
          "description": "Select an Space",
          "required": true
        },
        "space_name": {
          "label": "Space Name",
          "required": true
        }
      },
      "request": {
        "method": "PATCH",
        "url": "https://api.medullar.com/ai/v1/spaces/{{spaceId}}/",
        "body": {
          "name": "{{space_name}}"
        }
      }
    }
  },
  "triggers": {}
}
