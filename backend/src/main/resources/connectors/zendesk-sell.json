{
  "name": "zendesk-sell",
  "label": "Zendesk-sell",
  "description": "Sales CRM for pipeline management, lead tracking, and contact organization.",
  "icon": "",
  "hosts": [
    "api.getbase.com"
  ],
  "upstream": {
    "package": "@activepieces/piece-zendesk-sell",
    "version": "0.2.4"
  },
  "credential": {
    "fields": {
      "email": {
        "label": "Email Address",
        "description": "Your Zendesk login email address.",
        "required": true
      },
      "api_token": {
        "label": "API Token",
        "description": "Your Zendesk Sell API Token.",
        "secret": true,
        "required": true
      }
    }
  },
  "actions": {
    "find_deal": {
      "label": "Find Deal",
      "description": "Look up a deal by ID or name.",
      "inputs": {
        "deal_id": {
          "label": "Deal ID",
          "description": "Find a deal by its unique ID. (Prioritized over Name)",
          "type": "number"
        },
        "deal_name": {
          "label": "Deal Name",
          "description": "Find a deal by its exact name. (Used if Deal ID is not provided)"
        }
      },
      "request": {
        "method": "GET",
        "url": "https://api.getbase.com/v2/deals/{{deal_id}}",
        "headers": {
          "authorization": "Basic Y3JlZGVudGlhbDAwMHovdG9rZW46Y3JlZGVudGlhbDAwMXo="
        }
      }
    },
    "find_user": {
      "label": "Find User",
      "description": "Finds a user by ID, email, name, or status.",
      "inputs": {
        "user_id": {
          "label": "User ID",
          "description": "Find a user by their unique ID. (Prioritized over other fields)",
          "type": "number"
        },
        "name": {
          "label": "Name",
          "description": "Find a user by their full name."
        },
        "email": {
          "label": "Email",
          "description": "Find a user by their email address."
        },
        "role": {
          "label": "Role",
          "type": "select",
          "options": [
            {
              "value": "user",
              "label": "User"
            },
            {
              "value": "admin",
              "label": "Admin"
            }
          ]
        },
        "status": {
          "label": "Status",
          "type": "select",
          "options": [
            {
              "value": "active",
              "label": "Active"
            },
            {
              "value": "inactive",
              "label": "Inactive"
            }
          ]
        }
      },
      "request": {
        "method": "GET",
        "url": "https://api.getbase.com/v2/users/{{user_id}}",
        "headers": {
          "authorization": "Basic Y3JlZGVudGlhbDAwMHovdG9rZW46Y3JlZGVudGlhbDAwMXo="
        }
      }
    }
  },
  "triggers": {}
}
