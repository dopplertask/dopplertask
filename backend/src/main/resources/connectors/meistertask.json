{
  "name": "meistertask",
  "label": "MeisterTask",
  "description": "Intuitive online task manager for teams, personal productivity, and everything in between.",
  "icon": "",
  "hosts": [
    "www.meistertask.com"
  ],
  "upstream": {
    "package": "@activepieces/piece-meistertask",
    "version": "0.2.3"
  },
  "credential": {
    "oauth2": {
      "authUrl": "https://www.mindmeister.com/oauth2/authorize",
      "tokenUrl": "https://www.mindmeister.com/oauth2/token",
      "scope": "userinfo.profile userinfo.email meistertask"
    }
  },
  "actions": {
    "create_label": {
      "label": "Create Label",
      "description": "Creates a new label",
      "inputs": {
        "project": {
          "label": "Project",
          "required": true
        },
        "name": {
          "label": "Label Name",
          "required": true
        },
        "color": {
          "label": "Color",
          "description": "Hex color code (e.g., #FF0000)"
        }
      },
      "request": {
        "method": "POST",
        "url": "https://www.meistertask.com/api/projects/{{project}}/labels",
        "body": {
          "name": "{{name}}",
          "color": "{{color}}"
        }
      }
    },
    "create_task_label": {
      "label": "Create Task Label",
      "description": "Creates a new task label",
      "inputs": {
        "project": {
          "label": "Project",
          "required": true
        },
        "task_id": {
          "label": "Task",
          "required": true
        },
        "label": {
          "label": "Label",
          "required": true
        }
      },
      "request": {
        "method": "POST",
        "url": "https://www.meistertask.com/api/tasks/{{task_id}}/task_labels",
        "body": {
          "label_id": "{{label}}"
        }
      }
    },
    "create_task": {
      "label": "Create Task",
      "description": "Creates a new task",
      "inputs": {
        "project": {
          "label": "Project",
          "required": true
        },
        "section": {
          "label": "Section",
          "required": true
        },
        "name": {
          "label": "Task Name",
          "required": true
        },
        "notes": {
          "label": "Notes",
          "type": "multiline"
        },
        "assigned_to": {
          "label": "Person"
        },
        "due_date": {
          "label": "Due Date"
        }
      },
      "request": {
        "method": "POST",
        "url": "https://www.meistertask.com/api/tasks",
        "body": {
          "name": "{{name}}",
          "section_id": "{{section}}",
          "notes": "{{notes}}",
          "assigned_to_id": "{{assigned_to}}",
          "due": "{{due_date}}"
        }
      }
    },
    "update_task": {
      "label": "Update Task",
      "description": "Updates an existing task",
      "inputs": {
        "Project": {
          "label": "Project",
          "required": true
        },
        "task_id": {
          "label": "Task",
          "required": true
        },
        "name": {
          "label": "Task Name"
        },
        "notes": {
          "label": "Notes",
          "type": "multiline"
        },
        "status": {
          "label": "Status",
          "type": "select",
          "options": [
            {
              "value": 1,
              "label": "Open"
            },
            {
              "value": 2,
              "label": "Completed"
            },
            {
              "value": 18,
              "label": "Trashed"
            }
          ]
        },
        "assigned_to": {
          "label": "Person"
        },
        "due_date": {
          "label": "Due Date"
        }
      },
      "request": {
        "method": "PUT",
        "url": "https://www.meistertask.com/api/tasks/{{task_id}}",
        "body": {
          "name": "{{name}}",
          "notes": "{{notes}}",
          "assigned_to_id": "{{assigned_to}}",
          "due": "{{due_date}}"
        }
      }
    },
    "find_attachment": {
      "label": "Find Attachment",
      "description": "Finds an attachment by searching",
      "inputs": {
        "task_id": {
          "label": "Task",
          "required": true
        },
        "name": {
          "label": "Attachment Name"
        }
      },
      "request": {
        "method": "GET",
        "url": "https://www.meistertask.com/api/tasks/{{task_id}}/attachments"
      }
    },
    "find_label": {
      "label": "Find Label",
      "description": "Finds a label by searching",
      "inputs": {
        "project": {
          "label": "Project",
          "required": true
        },
        "name": {
          "label": "Label Name",
          "required": true
        }
      },
      "request": {
        "method": "GET",
        "url": "https://www.meistertask.com/api/projects/{{project}}/labels"
      }
    },
    "find_person": {
      "label": "Find Person",
      "description": "Finds a person based on person_id",
      "inputs": {
        "person_id": {
          "label": "Person ID",
          "required": true,
          "type": "number"
        }
      },
      "request": {
        "method": "GET",
        "url": "https://www.meistertask.com/api/persons/{{person_id}}"
      }
    },
    "find_task": {
      "label": "Find Task",
      "description": "Finds a task by searching",
      "inputs": {
        "project": {
          "label": "Project",
          "required": true
        },
        "section": {
          "label": "Section",
          "required": true
        },
        "name": {
          "label": "Task Name"
        }
      },
      "request": {
        "method": "GET",
        "url": "https://www.meistertask.com/api/sections/{{section}}/tasks"
      }
    },
    "find_or_create_task": {
      "label": "Find or Create Task",
      "description": "Finds a task by searching, or creates one if it doesn't exist",
      "inputs": {
        "project": {
          "label": "Project",
          "required": true
        },
        "section": {
          "label": "Section",
          "required": true
        },
        "name": {
          "label": "Task Name",
          "required": true
        },
        "notes": {
          "label": "Notes",
          "description": "Notes for the task (used if creating)",
          "type": "multiline"
        },
        "assigned_to": {
          "label": "Person"
        },
        "due_date": {
          "label": "Due Date",
          "description": "Due date for the task (used if creating)"
        }
      },
      "request": {
        "method": "GET",
        "url": "https://www.meistertask.com/api/sections/{{section}}/tasks"
      }
    },
    "find_or_create_label": {
      "label": "Find or Create Label",
      "description": "Finds a label by searching, or creates one if it doesn't exist",
      "inputs": {
        "project": {
          "label": "Project",
          "required": true
        },
        "name": {
          "label": "Label Name",
          "required": true
        },
        "color": {
          "label": "Color",
          "description": "Hex color code (e.g., #FF0000) - used if creating"
        }
      },
      "request": {
        "method": "GET",
        "url": "https://www.meistertask.com/api/projects/{{project}}/labels"
      }
    }
  },
  "triggers": {}
}
