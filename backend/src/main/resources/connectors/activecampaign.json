        },
        "id": "$.webhook.id",
        "unsubscribe": {
          "method": "DELETE",
          "url": "https://{{credential.apiUrl}}/api/3/webhooks/{{webhookId}}"
        }
      },
      "afterResponse": "return [response];",
      "items": "$"
    },
    "activecampaign_new_or_updated_account": {
      "label": "New or Updated Account",
      "description": "Triggers when a new account is added or an existing account’s details are updated",
      "webhook": {
        "subscribe": {
          "method": "POST",
          "url": "https://{{credential.apiUrl}}/api/3/webhooks",
