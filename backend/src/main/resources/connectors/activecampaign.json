          "method": "DELETE",
          "url": "https://{{credential.apiUrl}}/api/3/webhooks/{{webhookId}}"
        }
      },
      "afterResponse": "return [response];",
      "items": "$"
    },
    "activecampaign_new_deal_task": {
      "label": "New Deal Task",
      "description": "Triggers when a new deal task is created.",
      "webhook": {
        "subscribe": {
          "method": "POST",
          "url": "https://{{credential.apiUrl}}/api/3/webhooks",
