{
  "name": "activecampaign",
  "label": "ActiveCampaign",
  "description": "Email marketing, marketing automation, and CRM tools you need to create incredible customer experiences.",
  "icon": "",
  "hosts": [
    "{{credential.apiUrl}}"
  ],
  "baseUrl": "https://{{credential.apiUrl}}/api/3",
  "upstream": {
    "package": "@activepieces/piece-activecampaign",
    "version": "0.1.9"
  },
  "credential": {
    "fields": {
      "apiUrl": {
        "label": "API URL",
        "description": "The host of your API URL, such as youraccount.api-us1.com. Find your API URL and Key in ActiveCampaign under Settings > Developer > API Access.",
        "required": true
      },
      "apiKey": {
        "label": "API Key",
        "required": true,
        "secret": true
      }
    },
    "headers": {
      "Api-Token": "{{credential.apiKey}}"
    }
  },
  "actions": {
    "activecampaign_add_contact_to_account": {
      "label": "Add Contact to Account",
      "description": "Adds a contact to an ActiveCampaign account.",
      "inputs": {
        "contactId": {
          "label": "Contact ID",
          "required": true,
          "optionsFrom": {
            "request": {
              "url": "https://{{credential.apiUrl}}/api/3/contacts"
            },
            "list": "$.contacts",
            "label": "$.email",
            "value": "$.id"
          }
        },
        "accountId": {
          "label": "Account ID",
          "required": true,
          "optionsFrom": {
            "request": {
              "url": "https://{{credential.apiUrl}}/api/3/accounts"
            },
            "list": "$.accounts",
            "label": "$.name",
            "value": "$.id"
          }
        },
        "jobTitle": {
          "label": "Job Title"
        }
      },
      "request": {
        "method": "POST",
        "url": "https://{{credential.apiUrl}}/api/3/accountContacts",
        "body": {
          "accountContact": {
            "contact": "{{contactId}}",
            "account": "{{accountId}}",
            "jobTitle": "{{jobTitle}}"
          }
        }
      },
      "beforeRequest": "const link = request.body.accountContact; link.contact = Number(link.contact); link.account = Number(link.account); return request;"
    },
    "activecampaign_add_tag_to_contact": {
      "label": "Add Tag to Contact",
      "description": "Adds a tag to contact.",
      "inputs": {
        "contactId": {
          "label": "Contact ID",
          "required": true,
          "optionsFrom": {
            "request": {
              "url": "https://{{credential.apiUrl}}/api/3/contacts"
            },
            "list": "$.contacts",
            "label": "$.email",
            "value": "$.id"
          }
        },
        "tagId": {
          "label": "Tag ID",
          "required": true,
          "optionsFrom": {
            "request": {
              "url": "https://{{credential.apiUrl}}/api/3/tags"
            },
            "list": "$.tags",
            "label": "$.tag",
            "value": "$.id"
          }
        }
      },
      "request": {
        "method": "POST",
        "url": "https://{{credential.apiUrl}}/api/3/contactTags",
        "body": {
          "contactTag": {
            "contact": "{{contactId}}",
            "tag": "{{tagId}}"
          }
        }
      }
    },
    "activecampaign_create_account": {
      "label": "Create Account",
      "description": "Creates a new account.",
      "inputs": {
        "name": {
          "label": "Account Name",
          "required": true
        },
        "accountUrl": {
          "label": "Account URL"
        },
        "accountCustomFields": {
          "label": "Account Custom Fields",
          "type": "json",
          "required": true,
          "description": "Custom field values by custom field ID, such as {\"1\": \"Retail\"}."
        }
      },
      "request": {
        "method": "POST",
        "url": "https://{{credential.apiUrl}}/api/3/accounts",
        "body": {
          "account": {
            "name": "{{name}}",
            "accountUrl": "{{accountUrl}}",
            "fields": []
          }
        }
      },
      "beforeRequest": "const fields = JSON.parse(inputs.accountCustomFields || '{}'); request.body.account.fields = Object.entries(fields).map(([key, value]) => ({customFieldId: Number(key), fieldValue: value})); return request;"
    },
    "activecampaign_create_contact": {
      "label": "Create Contact",
      "description": "Creates a new contact.",
      "inputs": {
        "email": {
          "label": "Email",
          "required": true
        },
        "firstName": {
          "label": "First Name"
        },
        "lastName": {
          "label": "Last Name"
        },
        "phone": {
          "label": "Phone"
        },
        "contactCustomFields": {
          "label": "Contact Custom Fields",
          "type": "json",
          "required": true,
          "description": "Custom field values by field ID, such as {\"3\": \"Blue\"}."
        }
      },
      "request": {
        "method": "POST",
        "url": "https://{{credential.apiUrl}}/api/3/contacts",
        "body": {
          "contact": {
            "email": "{{email}}",
            "firstName": "{{firstName}}",
            "lastName": "{{lastName}}",
            "phone": "{{phone}}",
            "fieldValues": []
          }
        }
      },
      "beforeRequest": "const fields = JSON.parse(inputs.contactCustomFields || '{}'); request.body.contact.fieldValues = Object.entries(fields).map(([key, value]) => ({field: key, value: value})); return request;"
    },
    "activecampaign_update_account": {
      "label": "Update Account",
      "description": "Updates an account.",
      "inputs": {
        "accountId": {
          "label": "Account ID",
          "required": true,
          "optionsFrom": {
            "request": {
              "url": "https://{{credential.apiUrl}}/api/3/accounts"
            },
            "list": "$.accounts",
            "label": "$.name",
            "value": "$.id"
          }
        },
        "name": {
          "label": "Account Name"
        },
        "accountUrl": {
          "label": "Account URL"
        },
        "accountCustomFields": {
          "label": "Account Custom Fields",
          "type": "json",
          "required": true,
          "description": "Custom field values by custom field ID, such as {\"1\": \"Retail\"}."
        }
      },
      "request": {
        "method": "PUT",
        "url": "https://{{credential.apiUrl}}/api/3/accounts/{{accountId}}",
        "body": {
          "account": {
            "name": "{{name}}",
            "accountUrl": "{{accountUrl}}",
            "fields": []
          }
        }
      },
      "beforeRequest": "const fields = JSON.parse(inputs.accountCustomFields || '{}'); request.body.account.fields = Object.entries(fields).map(([key, value]) => ({customFieldId: Number(key), fieldValue: value})); return request;"
    },
    "activecampaign_update_contact": {
      "label": "Update Contact",
      "description": "Updates an existing contact.",
      "inputs": {
        "contactId": {
          "label": "Contact ID",
          "required": true,
          "optionsFrom": {
            "request": {
              "url": "https://{{credential.apiUrl}}/api/3/contacts"
            },
            "list": "$.contacts",
            "label": "$.email",
            "value": "$.id"
          }
        },
        "email": {
          "label": "Email",
          "required": false
        },
        "firstName": {
          "label": "First Name"
        },
        "lastName": {
          "label": "Last Name"
        },
        "phone": {
          "label": "Phone"
        },
        "contactCustomFields": {
          "label": "Contact Custom Fields",
          "type": "json",
          "required": true,
          "description": "Custom field values by field ID, such as {\"3\": \"Blue\"}."
        }
      },
      "request": {
        "method": "PUT",
        "url": "https://{{credential.apiUrl}}/api/3/contacts/{{contactId}}",
        "body": {
          "contact": {
            "email": "{{email}}",
            "firstName": "{{firstName}}",
            "lastName": "{{lastName}}",
            "phone": "{{phone}}",
            "fieldValues": []
          }
        }
      },
      "beforeRequest": "const fields = JSON.parse(inputs.contactCustomFields || '{}'); request.body.contact.fieldValues = Object.entries(fields).map(([key, value]) => ({field: key, value: value})); return request;"
    },
    "activecampaign_subscribe_or_unsubscribe_contact_from_list": {
      "label": "Subscribe or Unsubscribe Contact From List",
      "description": "Subscribes a Contact to a List it is not currently associated with, or Unsubscribes a Contact from a list is currently associated with.",
      "inputs": {
        "listId": {
          "label": "List",
          "required": true,
          "optionsFrom": {
            "request": {
              "url": "https://{{credential.apiUrl}}/api/3/lists",
              "query": {
                "limit": "20"
              }
            },
            "list": "$.lists",
            "label": "$.name",
            "value": "$.id"
          }
        },
        "status": {
          "label": "Action",
          "type": "select",
          "required": true,
          "options": [
            {
              "value": "1",
              "label": "Subscribe"
            },
            {
              "value": "2",
              "label": "Unsubscribe"
            }
          ]
        },
        "contactId": {
          "label": "Contact ID",
          "required": true
        }
      },
      "request": {
        "method": "POST",
        "url": "https://{{credential.apiUrl}}/api/3/contactLists",
        "body": {
          "contactList": {
            "list": "{{listId}}",
            "contact": "{{contactId}}",
            "status": "{{status}}"
          }
        }
      }
    }
  }
}