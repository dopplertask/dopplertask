                "api",
                "system"
              ]
            }
          }
        },
        "id": "$.webhook.id",
        "unsubscribe": {
          "method": "DELETE",
          "url": "https://{{credential.apiUrl}}/api/3/webhooks/{{webhookId}}"
        }
      },
      "afterResponse": "return [response];",
      "items": "$"
    },
    "activecampaign_new_deal_note": {
      "label": "New Deal Note",
      "description": "Triggers when a new deal note is created.",
      "webhook": {
        "subscribe": {
          "method": "POST",
          "url": "https://{{credential.apiUrl}}/api/3/webhooks",
