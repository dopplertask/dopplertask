    },
    "activecampaign_new_tag_added_or_removed_from_contact": {
      "label": "Tag Added or Removed From Contact",
      "description": "Triggers when a a Tag is added or removed from a Contact",
      "webhook": {
        "subscribe": {
          "method": "POST",
          "url": "https://{{credential.apiUrl}}/api/3/webhooks",
          "body": {
            "webhook": {
              "name": "Activepieces Contact Tag Hook",
              "url": "{{webhookUrl}}",
              "events": [
                "contact_tag_added",
                "contact_tag_removed"
              ],
              "sources": [
                "public",
                "admin",
                "api",
                "system"
              ]
            }
          }
        },
        "id": "$.webhook.id",
        "unsubscribe": {
          "method": "DELETE",
          "url": "https://{{credential.apiUrl}}/api/3/webhooks/{{webhookId}}"
        }
      },
      "afterResponse": "return [response];",
      "items": "$"
    },
    "activecampaign_updated_contact": {
      "label": "Updated Contact",
      "description": "Triggers when an existing contact details are updated.",
      "webhook": {
        "subscribe": {
          "method": "POST",
          "url": "https://{{credential.apiUrl}}/api/3/webhooks",
          "body": {
            "webhook": {
              "name": "Activepieces Updated Contact Hook",
              "url": "{{webhookUrl}}",
              "events": [
