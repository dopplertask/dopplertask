{
  "name": "retell-ai",
  "label": "Retell AI",
  "description": "",
  "icon": "",
  "hosts": [
    "api.retellai.com"
  ],
  "upstream": {
    "package": "@activepieces/piece-retell-ai",
    "version": "0.3.1"
  },
  "credential": {
    "fields": {
      "apiKey": {
        "label": "API Key",
        "description": "Your Retell AI API Key.",
        "secret": true,
        "required": true
      }
    },
    "headers": {
      "authorization": "Bearer {{credential.apiKey}}"
    }
  },
  "actions": {
    "get_call": {
      "label": "Get Call",
      "description": "Retrieve detailed data of a specific call (e.g., transcript), given a Call ID.",
      "inputs": {
        "callId": {
          "label": "Call ID",
          "description": "The 100 most recent calls. Map a Call ID from an earlier step for older calls.",
          "required": true
        }
      },
      "request": {
        "method": "GET",
        "url": "https://api.retellai.com/v2/get-call/{{callId}}"
      }
    },
    "get_voice": {
      "label": "Get Voice",
      "description": "Retrieve details for a specific voice model or configuration by ID in Retell AI.",
      "inputs": {
        "voiceId": {
          "label": "Voice",
          "required": true
        }
      },
      "request": {
        "method": "GET",
        "url": "https://api.retellai.com/get-voice/{{voiceId}}"
      }
    },
    "get_agent": {
      "label": "Get Agent",
      "description": "Fetch details of a Retell AI agent by Agent ID.",
      "inputs": {
        "agentId": {
          "label": "Agent ID",
          "description": "Select the Retell AI agent.",
          "required": true
        },
        "version": {
          "label": "Version",
          "description": "Agent version to return. Leave empty for the latest version.",
          "type": "number"
        }
      },
      "request": {
        "method": "GET",
        "url": "https://api.retellai.com/get-agent/{{agentId}}",
        "query": {
          "version": "{{version}}"
        }
      }
    }
  },
  "triggers": {}
}
