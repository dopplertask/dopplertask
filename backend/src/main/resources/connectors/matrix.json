{
  "name": "matrix",
  "label": "Matrix",
  "description": "Open standard for interoperable, decentralized, real-time communication",
  "icon": "",
  "hosts": [
    "{{credential.base_url}}"
  ],
  "upstream": {
    "package": "@activepieces/piece-matrix",
    "version": "0.6.3"
  },
  "credential": {
    "fields": {
      "base_url": {
        "label": "Home Server",
        "description": "The client API address of your homeserver, e.g. https://matrix-client.matrix.org (shown under Help & About in Element). The host only, without https://, such as name.example.com.",
        "required": true
      },
      "access_token": {
        "label": "Access Token",
        "description": "",
        "secret": true,
        "required": true
      }
    },
    "headers": {
      "authorization": "Bearer {{credential.access_token}}"
    }
  },
  "actions": {
    "create_room": {
      "label": "Create Room",
      "description": "Create a new room, optionally public, with invites.",
      "inputs": {
        "name": {
          "label": "Name"
        },
        "topic": {
          "label": "Topic",
          "type": "multiline"
        },
        "preset": {
          "label": "Preset",
          "type": "select",
          "options": [
            {
              "value": "private_chat",
              "label": "Private (invite only)"
            },
            {
              "value": "public_chat",
              "label": "Public (anyone can join)"
            },
            {
              "value": "trusted_private_chat",
              "label": "Trusted private (invitees are admins)"
            }
          ],
          "defaultValue": "private_chat"
        },
        "publishToDirectory": {
          "label": "Publish to Room Directory",
          "type": "boolean",
          "defaultValue": "false"
        },
        "aliasName": {
          "label": "Alias (local part)",
          "description": "e.g. team-ops for #team-ops:yourserver"
        },
        "invite": {
          "label": "Invite User IDs",
          "description": "User IDs like @alice:example.org",
          "type": "json"
        }
      },
      "request": {
        "method": "POST",
        "url": "https://{{credential.base_url}}/_matrix/client/v3/createRoom",
        "body": {
          "preset": "private_chat",
          "visibility": "private",
          "name": "{{name}}",
          "topic": "{{topic}}",
          "room_alias_name": "{{aliasName}}"
        }
      }
    }
  },
  "triggers": {}
}
