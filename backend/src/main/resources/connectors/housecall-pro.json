{
  "name": "housecall-pro",
  "label": "Housecall Pro",
  "description": "Manage your home service business with Housecall Pro CRM integration",
  "icon": "",
  "hosts": [
    "api.housecallpro.com"
  ],
  "upstream": {
    "package": "@activepieces/piece-housecall-pro",
    "version": "0.2.3"
  },
  "credential": {
    "fields": {
      "token": {
        "label": "API Key",
        "description": "Your Housecall Pro API Key. You can find it in your Housecall Pro account settings under API.",
        "secret": true,
        "required": true
      }
    },
    "headers": {
      "authorization": "Token {{credential.token}}"
    }
  },
  "actions": {
    "get_customers": {
      "label": "Get Customers",
      "description": "Retrieves a list of customers from Housecall Pro.",
      "inputs": {
        "page": {
          "label": "Page",
          "description": "Page number for pagination (starts from 1)",
          "type": "number",
          "defaultValue": "1"
        },
        "page_size": {
          "label": "Page Size",
          "description": "Number of customers per page (max 100)",
          "type": "number",
          "defaultValue": "50"
        },
        "q": {
          "label": "Search Query",
          "description": "Search customers by name, email, mobile number, and address"
        },
        "expand": {
          "label": "Expand",
          "description": "Expand related data",
          "type": "json",
          "options": [
            {
              "value": "attachments",
              "label": "Attachments"
            },
            {
              "value": "do_not_service",
              "label": "Do Not Service"
            }
          ]
        },
        "location_ids": {
          "label": "Location IDs",
          "description": "IDs of locations from which to pull customers",
          "type": "json"
        },
        "sort_by": {
          "label": "Sort By",
          "description": "The customer attribute by which to sort the results",
          "type": "select",
          "options": [
            {
              "value": "created_at",
              "label": "Created At"
            },
            {
              "value": "updated_at",
              "label": "Updated At"
            },
            {
              "value": "last_name",
              "label": "Last Name"
            }
          ]
        },
        "sort_direction": {
          "label": "Sort Direction",
          "description": "The order of sorting (ascending or descending)",
          "type": "select",
          "options": [
            {
              "value": "asc",
              "label": "Ascending"
            },
            {
              "value": "desc",
              "label": "Descending"
            }
          ]
        }
      },
      "request": {
        "method": "GET",
        "url": "https://api.housecallpro.com/customers",
        "query": {
          "page": "{{page}}",
          "page_size": "{{page_size}}",
          "q": "{{q}}"
        }
      }
    },
    "get_customer": {
      "label": "Get Customer",
      "description": "Retrieves the customer by ID.",
      "inputs": {
        "customer_id": {
          "label": "Customer ID",
          "description": "The ID of the customer to retrieve.",
          "required": true
        },
        "expand": {
          "label": "Expand",
          "description": "Expand related data",
          "type": "json",
          "options": [
            {
              "value": "attachments",
              "label": "Attachments"
            },
            {
              "value": "do_not_service",
              "label": "Do Not Service"
            }
          ]
        }
      },
      "request": {
        "method": "GET",
        "url": "https://api.housecallpro.com/customers/{{customer_id}}"
      }
    },
    "get_customer_addresses": {
      "label": "Get All of a Customer's Addresses",
      "description": "Retrieves all of a customer's addresses.",
      "inputs": {
        "customer_id": {
          "label": "Customer ID",
          "description": "The ID of the customer",
          "required": true
        },
        "page": {
          "label": "Page",
          "description": "Paginated page number",
          "type": "number",
          "defaultValue": "1"
        },
        "page_size": {
          "label": "Page Size",
          "description": "Number of addresses returned per page",
          "type": "number",
          "defaultValue": "50"
        },
        "sort_by": {
          "label": "Sort By",
          "description": "Address attribute to sort by",
          "type": "select",
          "options": [
            {
              "value": "created_at",
              "label": "Created At"
            },
            {
              "value": "updated_at",
              "label": "Updated At"
            }
          ]
        },
        "sort_direction": {
          "label": "Sort Direction",
          "description": "Ascending or descending",
          "type": "select",
          "options": [
            {
              "value": "asc",
              "label": "Ascending"
            },
            {
              "value": "desc",
              "label": "Descending"
            }
          ]
        }
      },
      "request": {
        "method": "GET",
        "url": "https://api.housecallpro.com/customers/{{customer_id}}/addresses",
        "query": {
          "page": "{{page}}",
          "page_size": "{{page_size}}"
        }
      }
    },
    "create_customer_address": {
      "label": "Create an Address on a Customer",
      "description": "Creates an address on a customer.",
      "inputs": {
        "customer_id": {
          "label": "Customer ID",
          "description": "The ID of the customer to add address to",
          "required": true
        },
        "street": {
          "label": "Street",
          "description": "Street address",
          "required": true
        },
        "street_line_2": {
          "label": "Street Line 2",
          "description": "Additional street address line"
        },
        "city": {
          "label": "City",
          "description": "City",
          "required": true
        },
        "state": {
          "label": "State",
          "description": "State",
          "required": true
        },
        "zip": {
          "label": "ZIP",
          "description": "ZIP code",
          "required": true
        },
        "country": {
          "label": "Country",
          "description": "Country",
          "required": true
        },
        "latitude": {
          "label": "Latitude",
          "description": "Latitude (one of number)",
          "type": "number"
        },
        "longitude": {
          "label": "Longitude",
          "description": "Longitude (one of number)",
          "type": "number"
        }
      },
      "request": {
        "method": "POST",
        "url": "https://api.housecallpro.com/customers/{{customer_id}}/addresses",
        "body": {
          "street": "{{street}}",
          "city": "{{city}}",
          "state": "{{state}}",
          "zip": "{{zip}}",
          "country": "{{country}}",
          "street_line_2": "{{street_line_2}}",
          "latitude": "{{latitude}}",
          "longitude": "{{longitude}}"
        }
      }
    },
    "get_customer_address": {
      "label": "Get a Customer's Address",
      "description": "Retrieves a customer's address by customer ID and address ID.",
      "inputs": {
        "customer_id": {
          "label": "Customer ID",
          "description": "The ID of the customer",
          "required": true
        },
        "address_id": {
          "label": "Address ID",
          "description": "The ID of the address",
          "required": true
        }
      },
      "request": {
        "method": "GET",
        "url": "https://api.housecallpro.com/customers/{{customer_id}}/addresses/{{address_id}}"
      }
    },
    "create_job": {
      "label": "Create Job",
      "description": "Creates a job with the ID for an already existing address and customer.",
      "inputs": {
        "customer_id": {
          "label": "Customer ID",
          "description": "The ID of the customer this job is for",
          "required": true
        },
        "address_id": {
          "label": "Address ID",
          "description": "The ID of the address for this job",
          "required": true
        },
        "invoice_number": {
          "label": "Invoice Number",
          "description": "Invoice number must be unique across all of a company's jobs. If left blank, one will be automatically generated.",
          "type": "number"
        },
        "scheduled_start": {
          "label": "Scheduled Start",
          "description": "Start time of job in ISO8601 format (e.g., 2021-01-14T20:14:00)"
        },
        "scheduled_end": {
          "label": "Scheduled End",
          "description": "End time of job in ISO8601 format (e.g., 2021-01-14T21:14:00)"
        },
        "arrival_window": {
          "label": "Arrival Window (minutes)",
          "description": "Integer value in minutes of arrival window",
          "type": "number"
        },
        "assigned_employee_ids": {
          "label": "Assigned Employee IDs",
          "description": "Array of employee IDs to assign to the job",
          "type": "json"
        },
        "tags": {
          "label": "Tags",
          "description": "Array of tags to assign to the job",
          "type": "json"
        },
        "lead_source": {
          "label": "Lead Source"
        },
        "notes": {
          "label": "Notes",
          "type": "multiline"
        },
        "line_items": {
          "label": "Line Items",
          "description": "Array of line items for the job",
          "type": "json"
        },
        "pricing_form": {
          "label": "Pricing Form",
          "description": "Pricing form object with fields and options (use UUIDs from GET price form endpoint)",
          "type": "json"
        },
        "job_fields": {
          "label": "Job Fields",
          "description": "Job fields object (e.g., job_type_id, business_unit_id)",
          "type": "json"
        }
      },
      "request": {
        "method": "POST",
        "url": "https://api.housecallpro.com/jobs",
        "body": {
          "customer_id": "{{customer_id}}",
          "address_id": "{{address_id}}",
          "invoice_number": "{{invoice_number}}",
          "schedule": {
            "scheduled_start": "{{scheduled_start}}",
            "scheduled_end": "{{scheduled_end}}",
            "arrival_window": "{{arrival_window}}"
          },
          "lead_source": "{{lead_source}}",
          "notes": "{{notes}}"
        }
      }
    },
    "get_jobs": {
      "label": "Get Jobs",
      "description": "Retrieve a list of jobs from Housecall Pro.",
      "inputs": {
        "customer_id": {
          "label": "Customer ID",
          "description": "Filters jobs by a single customer ID"
        },
        "employee_ids": {
          "label": "Employee IDs",
          "description": "Array of employee IDs to filter jobs",
          "type": "json"
        },
        "expand": {
          "label": "Expand",
          "description": "Array of strings to expand response body",
          "type": "json",
          "options": [
            {
              "value": "attachments",
              "label": "Attachments"
            },
            {
              "value": "appointments",
              "label": "Appointments"
            }
          ]
        },
        "location_ids": {
          "label": "Location IDs",
          "description": "IDs of locations to retrieve jobs from",
          "type": "json"
        },
        "page": {
          "label": "Page",
          "description": "The paginated page number",
          "type": "number",
          "defaultValue": "1"
        },
        "page_size": {
          "label": "Page Size",
          "description": "The number of jobs returned per page",
          "type": "number",
          "defaultValue": "10"
        },
        "scheduled_start_min": {
          "label": "Scheduled Start Min",
          "description": "Filters jobs with a starting time greater than or equal to the date sent"
        },
        "scheduled_start_max": {
          "label": "Scheduled Start Max",
          "description": "Filters jobs with a starting time less than or equal to the date sent"
        },
        "scheduled_end_min": {
          "label": "Scheduled End Min",
          "description": "Filters jobs with an end time greater than or equal to the date sent"
        },
        "scheduled_end_max": {
          "label": "Scheduled End Max",
          "description": "Filters jobs with an end time less than or equal to the date sent"
        },
        "sort_by": {
          "label": "Sort By",
          "description": "The attribute to sort the results by",
          "type": "select",
          "options": [
            {
              "value": "created_at",
              "label": "Created At"
            },
            {
              "value": "updated_at",
              "label": "Updated At"
            },
            {
              "value": "invoice_number",
              "label": "Invoice Number"
            },
            {
              "value": "id",
              "label": "ID"
            },
            {
              "value": "description",
              "label": "Description"
            },
            {
              "value": "work_status",
              "label": "Work Status"
            }
          ]
        },
        "sort_direction": {
          "label": "Sort Direction",
          "description": "The sorting order",
          "type": "select",
          "options": [
            {
              "value": "asc",
              "label": "Ascending"
            },
            {
              "value": "desc",
              "label": "Descending"
            }
          ],
          "defaultValue": "desc"
        },
        "work_status": {
          "label": "Work Status",
          "description": "Filters jobs by their work status. If empty, returns jobs from all statuses",
          "type": "json",
          "options": [
            {
              "value": "unscheduled",
              "label": "Unscheduled"
            },
            {
              "value": "scheduled",
              "label": "Scheduled"
            },
            {
              "value": "in_progress",
              "label": "In Progress"
            },
            {
              "value": "completed",
              "label": "Completed"
            },
            {
              "value": "canceled",
              "label": "Canceled"
            }
          ]
        }
      },
      "request": {
        "method": "GET",
        "url": "https://api.housecallpro.com/jobs",
        "query": {
          "customer_id": "{{customer_id}}",
          "page": "{{page}}",
          "page_size": "{{page_size}}",
          "scheduled_start_min": "{{scheduled_start_min}}",
          "scheduled_start_max": "{{scheduled_start_max}}",
          "scheduled_end_min": "{{scheduled_end_min}}",
          "scheduled_end_max": "{{scheduled_end_max}}"
        }
      }
    },
    "get_job": {
      "label": "Get a Job",
      "description": "Retrieves a single job by ID from Housecall Pro.",
      "inputs": {
        "job_id": {
          "label": "Job ID",
          "description": "The ID of the job to retrieve",
          "required": true
        },
        "expand": {
          "label": "Expand",
          "description": "Expand related data (attachments, appointments)",
          "type": "json",
          "options": [
            {
              "value": "attachments",
              "label": "Attachments"
            },
            {
              "value": "appointments",
              "label": "Appointments"
            }
          ]
        }
      },
      "request": {
        "method": "GET",
        "url": "https://api.housecallpro.com/jobs/{{job_id}}"
      }
    },
    "update_job_schedule": {
      "label": "Update Job Schedule",
      "description": "Updates a job's schedule. Jobs with multi days feature containing more than 1 appointment can't be updated through this action.",
      "inputs": {
        "job_id": {
          "label": "Job ID",
          "description": "The ID of the job to update schedule for",
          "required": true
        },
        "start_time": {
          "label": "Start Time",
          "description": "Start time of job in ISO8601 format (e.g., 2021-01-14T20:14:00)",
          "required": true
        },
        "end_time": {
          "label": "End Time",
          "description": "End time of job in ISO8601 format (e.g., 2021-01-14T21:14:00)",
          "required": true
        },
        "arrival_window_in_minutes": {
          "label": "Arrival Window (minutes)",
          "description": "Integer value in minutes of arrival window",
          "type": "number"
        },
        "notify": {
          "label": "Notify",
          "description": "Notify the customer of the update schedule",
          "type": "boolean",
          "defaultValue": "true"
        },
        "notify_pro": {
          "label": "Notify Pro",
          "description": "Notify the pros of the update schedule",
          "type": "boolean",
          "defaultValue": "true"
        },
        "expand": {
          "label": "Expand",
          "description": "Expand related entities",
          "type": "json",
          "options": [
            {
              "value": "assigned_employees",
              "label": "Assigned Employees"
            }
          ]
        },
        "dispatched_employees": {
          "label": "Dispatched Employees",
          "description": "Array of employee objects with employee_id",
          "type": "json"
        }
      },
      "request": {
        "method": "PUT",
        "url": "https://api.housecallpro.com/jobs/{{job_id}}/schedule",
        "body": {
          "start_time": "{{start_time}}",
          "end_time": "{{end_time}}",
          "arrival_window_in_minutes": "{{arrival_window_in_minutes}}"
        }
      }
    },
    "delete_job_schedule": {
      "label": "Delete Job Schedule",
      "description": "Deletes schedule on a job.",
      "inputs": {
        "job_id": {
          "label": "Job ID",
          "description": "The ID of the job to delete schedule from.",
          "required": true
        }
      },
      "request": {
        "method": "DELETE",
        "url": "https://api.housecallpro.com/jobs/{{job_id}}/schedule"
      }
    },
    "get_job_appointments": {
      "label": "Get Appointments",
      "description": "Get all of the appointments for a job",
      "inputs": {
        "job_id": {
          "label": "Job ID",
          "description": "The ID of the job",
          "required": true
        }
      },
      "request": {
        "method": "GET",
        "url": "https://api.housecallpro.com/jobs/{{job_id}}/appointments"
      }
    },
    "delete_job_appointment": {
      "label": "Delete appointment",
      "description": "Delete a job appointment",
      "inputs": {
        "appointment_id": {
          "label": "Appointment ID",
          "description": "The ID of the appointment",
          "required": true
        },
        "job_id": {
          "label": "Job ID",
          "description": "The ID of the job",
          "required": true
        }
      },
      "request": {
        "method": "DELETE",
        "url": "https://api.housecallpro.com/jobs/{{job_id}}/appointments/{{appointment_id}}"
      }
    },
    "add_job_note": {
      "label": "Add job note",
      "description": "Add a note to a job",
      "inputs": {
        "job_id": {
          "label": "Job ID",
          "description": "The ID of the job",
          "required": true
        },
        "content": {
          "label": "Content",
          "description": "The content of the note",
          "required": true,
          "type": "multiline"
        }
      },
      "request": {
        "method": "POST",
        "url": "https://api.housecallpro.com/jobs/{{job_id}}/notes",
        "body": {
          "content": "{{content}}"
        }
      }
    },
    "delete_job_note": {
      "label": "Delete job note",
      "description": "Delete a specific job note",
      "inputs": {
        "job_id": {
          "label": "Job ID",
          "description": "The ID of the job",
          "required": true
        },
        "note_id": {
          "label": "Note ID",
          "description": "The ID of the note to delete",
          "required": true
        }
      },
      "request": {
        "method": "DELETE",
        "url": "https://api.housecallpro.com/jobs/{{job_id}}/notes/{{note_id}}"
      }
    },
    "add_job_line_item": {
      "label": "Add a line item to a job",
      "description": "Add a line item to a job. This is a rate limited request.",
      "inputs": {
        "job_id": {
          "label": "Job ID",
          "description": "The ID of the job",
          "required": true
        },
        "name": {
          "label": "Name",
          "description": "The name of the line item",
          "required": true
        },
        "description": {
          "label": "Description",
          "description": "The description of the line item"
        },
        "unit_price": {
          "label": "Unit Price",
          "description": "The unit price of the line item",
          "type": "number"
        },
        "unit_cost": {
          "label": "Unit Cost",
          "description": "The unit cost of the line item",
          "type": "number"
        },
        "quantity": {
          "label": "Quantity",
          "description": "The number of items being sold. This can be a float up to two decimal places",
          "type": "number"
        },
        "tax_surcharge_type": {
          "label": "Tax/Surcharge Type",
          "description": "The type of tax or surcharge",
          "type": "select",
          "options": [
            {
              "value": "material",
              "label": "Material"
            },
            {
              "value": "labor",
              "label": "Labor"
            },
            {
              "value": "flat_quantity",
              "label": "Flat Quantity"
            },
            {
              "value": "fixed_discount",
              "label": "Fixed Discount"
            },
            {
              "value": "percent_discount",
              "label": "Percent Discount"
            }
          ]
        },
        "kind": {
          "label": "Kind",
          "description": "The kind of line item",
          "type": "select",
          "options": [
            {
              "value": "material",
              "label": "Material"
            },
            {
              "value": "labor",
              "label": "Labor"
            },
            {
              "value": "flat_quantity",
              "label": "Flat Quantity"
            },
            {
              "value": "fixed_discount",
              "label": "Fixed Discount"
            },
            {
              "value": "percent_discount",
              "label": "Percent Discount"
            }
          ]
        },
        "taxable": {
          "label": "Taxable",
          "description": "Whether the line item is taxable",
          "type": "boolean"
        },
        "service_line_id": {
          "label": "Service Line ID",
          "description": "The ID of the service line"
        },
        "service_line_type": {
          "label": "Service Line Type",
          "description": "The type of service line",
          "type": "select",
          "options": [
            {
              "value": "custom_place",
              "label": "Custom Place"
            },
            {
              "value": "organization",
              "label": "Organization"
            },
            {
              "value": "pricebok_material",
              "label": "PriceBook Material"
            }
          ]
        }
      },
      "request": {
        "method": "POST",
        "url": "https://api.housecallpro.com/jobs/{{job_id}}/line_items",
        "body": {
          "name": "{{name}}",
          "description": "{{description}}",
          "unit_price": "{{unit_price}}",
          "unit_cost": "{{unit_cost}}",
          "quantity": "{{quantity}}",
          "service_line_id": "{{service_line_id}}"
        }
      }
    },
    "update_job_line_item": {
      "label": "Update a single line item for a job",
      "description": "Update a specific line item for a job",
      "inputs": {
        "job_id": {
          "label": "Job ID",
          "description": "The ID of the job",
          "required": true
        },
        "id": {
          "label": "Line Item ID",
          "description": "The ID of the line item",
          "required": true
        },
        "service_line_id": {
          "label": "Service Line ID",
          "description": "The ID of the service line"
        },
        "service_line_type": {
          "label": "Service Line Type",
          "description": "The type of service line",
          "type": "select",
          "options": [
            {
              "value": "custom_place",
              "label": "Custom Place"
            },
            {
              "value": "organization",
              "label": "Organization"
            },
            {
              "value": "pricebok_material",
              "label": "PriceBook Material"
            }
          ]
        },
        "name": {
          "label": "Name",
          "description": "The name of the line item"
        },
        "unit_price": {
          "label": "Unit Price",
          "description": "The unit price of the line item",
          "type": "number"
        },
        "unit_cost": {
          "label": "Unit Cost",
          "description": "The unit cost of the line item",
          "type": "number"
        },
        "quantity": {
          "label": "Quantity",
          "description": "The number of items being sold",
          "type": "number"
        },
        "kind": {
          "label": "Kind",
