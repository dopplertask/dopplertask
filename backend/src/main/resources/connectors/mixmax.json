{
  "name": "mixmax",
  "label": "Mixmax",
  "description": "Email productivity and automation platform for Gmail — sequences, tracking, templates, and integrations",
  "icon": "mixmax",
  "hosts": [
    "api.mixmax.com"
  ],
  "upstream": {
    "package": "@activepieces/piece-mixmax",
    "version": "0.1.1"
  },
  "credential": {
    "fields": {
      "token": {
        "label": "API Token",
        "description": "Your Mixmax API token (X-API-Token). Find it at Settings > API in Mixmax.",
        "secret": true,
        "required": true
      }
    },
    "headers": {
      "x-api-token": "{{credential.token}}"
    }
  },
  "actions": {
    "create_contact": {
      "label": "Create Contact",
      "description": "Create a new contact in Mixmax. [See the documentation](https://developer.mixmax.com/reference/contacts-1)",
      "inputs": {
        "email": {
          "label": "Email",
          "description": "The contact email address",
          "required": true
        },
        "name": {
          "label": "Name",
          "description": "The contact full name"
        },
        "enrich": {
          "label": "Enrich Contact",
          "description": "Merge third-party data for this contact if enrichment sources are connected",
          "type": "boolean",
          "defaultValue": "false"
        }
      },
      "request": {
        "method": "POST",
        "url": "https://api.mixmax.com/v1/contacts",
        "body": {
          "email": "{{email}}",
          "name": "{{name}}"
        }
      }
    },
    "find_contact": {
      "label": "Find Contact",
      "description": "Search for a contact in Mixmax. [See the documentation](https://developer.mixmax.com/reference/contactsquery)",
      "inputs": {
        "query": {
          "label": "Search Query",
          "description": "Email address or name to search for",
          "required": true
        },
        "includeSalesforceContacts": {
          "label": "Include Salesforce Contacts",
          "description": "Include Salesforce contacts in search results",
          "type": "boolean",
          "defaultValue": "false"
        }
      },
      "request": {
        "method": "GET",
        "url": "https://api.mixmax.com/v1/contacts/query",
        "query": {
          "q": "{{query}}"
        }
      }
    },
    "list_contacts": {
      "label": "List Contacts",
      "description": "List contacts in Mixmax. [See the documentation](https://developer.mixmax.com/reference/contacts)",
      "inputs": {
        "search": {
          "label": "Search",
          "description": "Filter contacts by name or email"
        },
        "sort": {
          "label": "Sort By",
          "description": "Field to sort results by",
          "type": "select",
          "options": [
            {
              "value": "name",
              "label": "Name"
            },
            {
              "value": "email",
              "label": "Email"
            },
            {
              "value": "timestamp",
              "label": "Last Used"
            },
            {
              "value": "usedCount",
              "label": "Used Count"
            }
          ]
        }
      },
      "request": {
        "method": "GET",
        "url": "https://api.mixmax.com/v1/contacts",
        "query": {
          "search": "{{search}}"
        }
      }
    },
    "create_code_snippet": {
      "label": "Create Code Snippet",
      "description": "Create a new code snippet in Mixmax. [See the documentation](https://developer.mixmax.com/reference/codesnippets-1)",
      "inputs": {
        "title": {
          "label": "Title",
          "description": "The code snippet title"
        },
        "html": {
          "label": "HTML",
          "description": "The HTML content of the code snippet (as it appears in the editor)",
          "required": true,
          "type": "multiline"
        },
        "language": {
          "label": "Language",
          "description": "Programming language for syntax highlighting",
          "type": "select",
          "options": [
            {
              "value": "javascript",
              "label": "JavaScript"
            },
            {
              "value": "python",
              "label": "Python"
            },
            {
              "value": "html",
              "label": "HTML"
            },
            {
              "value": "css",
              "label": "CSS"
            },
            {
              "value": "typescript",
              "label": "TypeScript"
            },
            {
              "value": "java",
              "label": "Java"
            },
            {
              "value": "ruby",
              "label": "Ruby"
            },
            {
              "value": "php",
              "label": "PHP"
            },
            {
              "value": "golang",
              "label": "Go"
            },
            {
              "value": "bash",
              "label": "Bash"
            },
            {
              "value": "sql",
              "label": "SQL"
            },
            {
              "value": "json",
              "label": "JSON"
            },
            {
              "value": "xml",
              "label": "XML"
            },
            {
              "value": "markdown",
              "label": "Markdown"
            }
          ]
        },
        "background": {
          "label": "Background Color",
          "description": "RGB background color (e.g., rgb(255, 255, 255))",
          "defaultValue": "rgb(255, 255, 255)"
        },
        "theme": {
          "label": "Editor Theme",
          "description": "Code editor color theme",
          "type": "select",
          "options": [
            {
              "value": "ambiance",
              "label": "Ambiance"
            },
            {
              "value": "monokai",
              "label": "Monokai"
            },
            {
              "value": "github",
              "label": "GitHub"
            },
            {
              "value": "solarized_dark",
              "label": "Solarized Dark"
            },
            {
              "value": "solarized_light",
              "label": "Solarized Light"
            },
            {
              "value": "tomorrow",
              "label": "Tomorrow"
            },
            {
              "value": "twilight",
              "label": "Twilight"
            }
          ]
        }
      },
      "request": {
        "method": "POST",
        "url": "https://api.mixmax.com/v1/codesnippets",
        "body": {
          "html": "{{html}}",
          "background": "{{background}}",
          "theme": "ambiance",
          "language": "javascript",
          "title": "{{title}}"
        }
      }
    },
    "list_code_snippets": {
      "label": "List Code Snippets",
      "description": "List all code snippets in Mixmax. [See the documentation](https://developer.mixmax.com/reference/codesnippets)",
      "inputs": {},
      "request": {
        "method": "GET",
        "url": "https://api.mixmax.com/v1/codesnippets"
      }
    }
  },
  "triggers": {}
}
