{
  "name": "vimeo",
  "label": "Vimeo",
  "description": "",
  "icon": "vimeo",
  "hosts": [
    "api.vimeo.com"
  ],
  "upstream": {
    "package": "@activepieces/piece-vimeo",
    "version": "0.2.3"
  },
  "credential": {
    "oauth2": {
      "authUrl": "https://api.vimeo.com/oauth/authorize",
      "tokenUrl": "https://api.vimeo.com/oauth/access_token",
      "scope": "public private edit upload delete interact"
    }
  },
  "actions": {
    "upload_video": {
      "label": "Upload Video",
      "description": "Upload a video to your Vimeo account",
      "inputs": {
        "videoUrl": {
          "label": "Video URL",
          "description": "URL of the video file to upload",
          "required": true
        },
        "name": {
          "label": "Video Name",
          "description": "Name for the video",
          "required": true
        },
        "description": {
          "label": "Description",
          "description": "Description for the video",
          "type": "multiline"
        },
        "privacy": {
          "label": "Privacy",
          "description": "Privacy setting for the video",
          "type": "select",
          "options": [
            {
              "value": "anybody",
              "label": "Everybody"
            },
            {
              "value": "contacts",
              "label": "Contacts"
            },
            {
              "value": "disable",
              "label": "Embeddable but hidden"
            },
            {
              "value": "nobody",
              "label": "Only you"
            },
            {
              "value": "password",
              "label": "Password protected"
            },
            {
              "value": "unlisted",
              "label": "Only can be accessed with private link"
            },
            {
              "value": "users",
              "label": "Vimeo users"
            }
          ],
          "defaultValue": "anybody"
        },
        "allowEmbed": {
          "label": "Allow Embedding",
          "description": "Allow others to embed this video",
          "type": "boolean",
          "defaultValue": "true"
        },
        "allowDownload": {
          "label": "Allow Download",
          "description": "Allow others to download this video (not available for free Vimeo users)",
          "type": "boolean",
          "defaultValue": "false"
        },
        "contentRating": {
          "label": "Content Rating",
          "description": "Content rating for the video"
        },
        "folderId": {
          "label": "Folder ID",
          "description": "ID of the folder to add the video to"
        },
        "language": {
          "label": "Language",
          "description": "Language code for the video"
        },
        "license": {
          "label": "License",
          "description": "License for the video",
          "type": "select",
          "options": [
            {
              "value": "",
              "label": "All Right Reserved"
            },
            {
              "value": "by",
              "label": "Attribution Required"
            },
            {
              "value": "by-sa",
              "label": "Attribution-ShareAlike"
            },
            {
              "value": "by-nd",
              "label": "Attribution-NoDerivs"
            },
            {
              "value": "by-nc",
              "label": "Attribution-NonCommercial"
            },
            {
              "value": "by-nc-sa",
              "label": "Attribution-NonCommercial-ShareAlike"
            },
            {
              "value": "by-nc-nd",
              "label": "Attribution-NonCommercial-NoDerivs"
            },
            {
              "value": "cc0",
              "label": "Public Domain"
            }
          ],
          "defaultValue": ""
        }
      },
      "request": {
        "method": "POST",
        "url": "https://api.vimeo.com/me/videos",
        "body": {
          "upload": {
            "approach": "pull",
            "link": "{{videoUrl}}"
          },
          "name": "{{name}}",
          "privacy": {
            "embed": "private"
          },
          "description": "{{description}}",
          "content_rating": "{{contentRating}}",
          "locale": "{{language}}",
          "folder_uri": "/me/projects/{{folderId}}"
        }
      }
    }
  },
  "triggers": {}
}
