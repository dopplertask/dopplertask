{
  "name": "teamleader",
  "label": "Teamleader",
  "description": "",
  "icon": "",
  "hosts": [
    "api.focus.teamleader.eu"
  ],
  "upstream": {
    "package": "@activepieces/piece-teamleader",
    "version": "0.2.1"
  },
  "credential": {
    "oauth2": {
      "authUrl": "https://focus.teamleader.eu/oauth2/authorize",
      "tokenUrl": "https://focus.teamleader.eu/oauth2/access_token",
      "scope": ""
    }
  },
  "actions": {
    "create_contact": {
      "label": "Create Contact",
      "description": "Create a new contact record",
      "inputs": {
        "first_name": {
          "label": "First Name",
          "description": "First name of the contact",
          "required": true
        },
        "last_name": {
          "label": "Last Name",
          "description": "Last name of the contact",
          "required": true
        },
        "salutation": {
          "label": "Salutation",
          "description": "Salutation (e.g., Mr, Mrs, Dr)"
        },
        "emails": {
          "label": "Emails",
          "description": "Email addresses for the contact",
          "type": "json"
        },
        "telephones": {
          "label": "Phone Numbers",
          "description": "Phone numbers for the contact",
          "type": "json"
        },
        "website": {
          "label": "Website",
          "description": "Website URL"
        },
        "addresses": {
          "label": "Addresses",
          "description": "Contact addresses",
          "type": "json"
        },
        "language": {
          "label": "Language",
          "description": "Language code (e.g., en, nl, fr)"
        },
        "gender": {
          "label": "Gender",
          "description": "Gender of the contact",
          "type": "select",
          "options": [
            {
              "value": "female",
              "label": "Female"
            },
            {
              "value": "male",
              "label": "Male"
            },
            {
              "value": "non_binary",
              "label": "Non-binary"
            },
            {
              "value": "prefers_not_to_say",
              "label": "Prefers not to say"
            },
            {
              "value": "unknown",
              "label": "Unknown"
            }
          ]
        },
        "birthdate": {
          "label": "Birth Date",
          "description": "Birth date (YYYY-MM-DD format)"
        },
        "iban": {
          "label": "IBAN",
          "description": "International Bank Account Number"
        },
        "bic": {
          "label": "BIC",
          "description": "Bank Identifier Code"
        },
        "national_identification_number": {
          "label": "National ID Number",
          "description": "National identification number"
        },
        "remarks": {
          "label": "Remarks",
          "description": "Additional notes (supports Markdown)",
          "type": "multiline"
        },
        "tags": {
          "label": "Tags",
          "description": "Contact tags",
          "type": "json"
        },
        "custom_fields": {
          "label": "Custom Fields",
          "description": "Custom field values",
          "type": "json"
        },
        "marketing_mails_consent": {
          "label": "Marketing Consent",
          "description": "Allow marketing emails",
          "type": "boolean"
        }
      },
      "request": {
        "method": "POST",
        "url": "https://api.focus.teamleader.eu/contacts.add",
        "body": {
          "first_name": "{{first_name}}",
          "last_name": "{{last_name}}",
          "salutation": "{{salutation}}",
          "website": "{{website}}",
          "language": "{{language}}",
          "birthdate": "{{birthdate}}",
          "iban": "{{iban}}",
          "bic": "{{bic}}",
          "national_identification_number": "{{national_identification_number}}",
          "remarks": "{{remarks}}"
        }
      }
    },
    "create_company": {
      "label": "Create Company",
      "description": "Add a new company record",
      "inputs": {
        "name": {
          "label": "Company Name",
          "description": "Name of the company",
          "required": true
        },
        "country_for_business_type": {
          "label": "Country Code",
          "description": "Two-letter country code (e.g., BE, NL, US) for business type selection"
        },
        "business_type_id": {
          "label": "Business Type",
          "description": "Legal structure of the company"
        },
        "vat_number": {
          "label": "VAT Number",
          "description": "VAT/tax identification number"
        },
        "national_identification_number": {
          "label": "National ID Number",
          "description": "National identification number"
        },
        "emails": {
          "label": "Emails",
          "description": "Email addresses for the company",
          "type": "json"
        },
        "telephones": {
          "label": "Phone Numbers",
          "description": "Phone numbers for the company",
          "type": "json"
        },
        "website": {
          "label": "Website",
          "description": "Company website URL"
        },
        "addresses": {
          "label": "Addresses",
          "description": "Company addresses",
          "type": "json"
        },
        "iban": {
          "label": "IBAN",
          "description": "International Bank Account Number"
        },
        "bic": {
          "label": "BIC",
          "description": "Bank Identifier Code"
        },
        "language": {
          "label": "Language",
          "description": "Language code (e.g., en, nl, fr)"
        },
        "responsible_user_id": {
          "label": "Responsible User ID",
          "description": "ID of the user responsible for this company"
        },
        "remarks": {
          "label": "Remarks",
          "description": "Additional notes (supports Markdown)",
          "type": "multiline"
        },
        "tags": {
          "label": "Tags",
          "description": "Company tags",
          "type": "json"
        },
        "custom_fields": {
          "label": "Custom Fields",
          "description": "Custom field values",
          "type": "json"
        },
        "marketing_mails_consent": {
          "label": "Marketing Consent",
          "description": "Allow marketing emails",
          "type": "boolean"
        },
        "preferred_currency": {
          "label": "Preferred Currency",
          "description": "Preferred currency for this company",
          "type": "select",
          "options": [
            {
              "value": "EUR",
              "label": "Euro (EUR)"
            },
            {
              "value": "USD",
              "label": "US Dollar (USD)"
            },
            {
              "value": "GBP",
              "label": "British Pound (GBP)"
            },
            {
              "value": "CAD",
              "label": "Canadian Dollar (CAD)"
            },
            {
              "value": "CHF",
              "label": "Swiss Franc (CHF)"
            },
            {
              "value": "DKK",
              "label": "Danish Krone (DKK)"
            },
            {
              "value": "NOK",
              "label": "Norwegian Krone (NOK)"
            },
            {
              "value": "SEK",
              "label": "Swedish Krona (SEK)"
            },
            {
              "value": "JPY",
              "label": "Japanese Yen (JPY)"
            },
            {
              "value": "CNY",
              "label": "Chinese Yuan (CNY)"
            },
            {
              "value": "CZK",
              "label": "Czech Koruna (CZK)"
            },
            {
              "value": "PLN",
              "label": "Polish Zloty (PLN)"
            },
            {
              "value": "RON",
              "label": "Romanian Leu (RON)"
            },
            {
              "value": "TRY",
              "label": "Turkish Lira (TRY)"
            },
            {
              "value": "ZAR",
              "label": "South African Rand (ZAR)"
            },
            {
              "value": "INR",
              "label": "Indian Rupee (INR)"
            },
            {
              "value": "MXN",
              "label": "Mexican Peso (MXN)"
            },
            {
              "value": "CLP",
              "label": "Chilean Peso (CLP)"
            },
            {
              "value": "COP",
              "label": "Colombian Peso (COP)"
            },
            {
              "value": "PEN",
              "label": "Peruvian Sol (PEN)"
            },
            {
              "value": "MAD",
              "label": "Moroccan Dirham (MAD)"
            },
            {
              "value": "ISK",
              "label": "Icelandic Krona (ISK)"
            },
            {
              "value": "BAM",
              "label": "Bosnia and Herzegovina Mark (BAM)"
            }
          ]
        }
      },
      "request": {
        "method": "POST",
        "url": "https://api.focus.teamleader.eu/companies.add",
        "body": {
          "name": "{{name}}",
          "business_type_id": "{{business_type_id}}",
          "vat_number": "{{vat_number}}",
          "national_identification_number": "{{national_identification_number}}",
          "website": "{{website}}",
          "iban": "{{iban}}",
          "bic": "{{bic}}",
          "language": "{{language}}",
          "responsible_user_id": "{{responsible_user_id}}",
          "remarks": "{{remarks}}"
        }
      }
    }
  },
  "triggers": {}
}
