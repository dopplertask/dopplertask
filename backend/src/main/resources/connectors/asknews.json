{
  "name": "asknews",
  "label": "AskNews",
  "description": "AskNews piece allows you to search and retrieve enriched real-time and historical news articles using AskNews API.",
  "icon": "",
  "hosts": [
    "api.asknews.app"
  ],
  "upstream": {
    "package": "@activepieces/piece-asknews",
    "version": "0.1.2"
  },
  "credential": {
    "fields": {
      "token": {
        "label": "API Key",
        "description": "\nTo obtain your AskNews API key:\n\n1. Visit [AskNews](https://asknews.app)\n2. Sign up or log in to your account\n3. Click on your profile and navigate to 'Settings' > 'API Credentials'\n4. Generate a new API key\n5. Copy and paste the key here\n",
        "secret": true,
        "required": true
      }
    },
    "headers": {
      "authorization": "Bearer {{credential.token}}"
    }
  },
  "actions": {
    "searchNews": {
      "label": "Search News",
      "description": "Search for enriched real-time news articles from the past 48 hours or historical archive",
      "inputs": {
        "query": {
          "label": "Query",
          "description": "Search query - can be a phrase, keyword, question, or paragraph. Leave empty to search by filters only.",
          "required": true
        },
        "nArticles": {
          "label": "Number of Articles",
          "description": "Number of articles to return",
          "type": "number",
          "defaultValue": "10"
        },
        "method": {
          "label": "Search Method",
          "description": "Search method to use. \"kw\" for keyword matching, \"nl\" for semantic/natural language search, \"both\" for hybrid",
          "type": "select",
          "options": [
            {
              "value": "kw",
              "label": "Keyword (kw)"
            },
            {
              "value": "nl",
              "label": "Natural Language (nl)"
            },
            {
              "value": "both",
              "label": "Both (kw + nl)"
            }
          ],
          "defaultValue": "kw"
        },
        "returnType": {
          "label": "Return Type",
          "description": "Format of returned articles. \"string\" is prompt-optimized, \"dicts\" is structured data, \"both\" returns both",
          "type": "select",
          "options": [
            {
              "value": "string",
              "label": "String (prompt-optimized)"
            },
            {
              "value": "dicts",
              "label": "Dicts (structured)"
            },
            {
              "value": "both",
              "label": "Both"
            }
          ],
          "defaultValue": "string"
        },
        "historical": {
          "label": "Search Historical Archive",
          "description": "Search in historical archive (60+ days back) instead of just recent news (48 hours)",
          "type": "boolean",
          "defaultValue": "false"
        },
        "hoursBack": {
          "label": "Hours Back",
          "description": "Number of hours back to search from current time. Defaults to 24.",
          "type": "number",
          "defaultValue": "24"
        },
        "categories": {
          "label": "Categories",
          "description": "Filter articles by news categories",
          "type": "json",
          "options": [
            {
              "value": "Business",
              "label": "Business"
            },
            {
              "value": "Crime",
              "label": "Crime"
            },
            {
              "value": "Politics",
              "label": "Politics"
            },
            {
              "value": "Science",
              "label": "Science"
            },
            {
              "value": "Sports",
              "label": "Sports"
            },
            {
              "value": "Technology",
              "label": "Technology"
            },
            {
              "value": "Military",
              "label": "Military"
            },
            {
              "value": "Health",
              "label": "Health"
            },
            {
              "value": "Entertainment",
              "label": "Entertainment"
            },
            {
              "value": "Finance",
              "label": "Finance"
            },
            {
              "value": "Culture",
              "label": "Culture"
            },
            {
              "value": "Climate",
              "label": "Climate"
            },
            {
              "value": "Environment",
              "label": "Environment"
            },
            {
              "value": "World",
              "label": "World"
            }
          ]
        },
        "similarityScoreThreshold": {
          "label": "Similarity Score Threshold",
          "description": "Minimum similarity score (0-1) for results. Lower = more lenient matches.",
          "type": "number",
          "defaultValue": "0.5"
        }
      },
      "request": {
        "method": "GET",
        "url": "https://api.asknews.app/v1/news/search",
        "query": {
          "query": "{{query}}",
          "n_articles": "{{nArticles}}",
          "hours_back": "{{hoursBack}}",
          "similarity_score_threshold": "{{similarityScoreThreshold}}"
        }
      }
    },
    "generateNewsKnowledgeGraph": {
      "label": "Generate News Knowledge Graph",
      "description": "Build a custom mega-news-knowledge graph with fully disambiguated entities and relationships",
      "inputs": {
        "query": {
          "label": "Query",
          "description": "Natural language query for building the graph",
          "required": true
        },
        "returnArticles": {
          "label": "Return Articles",
          "description": "Include articles in the response",
          "type": "boolean",
          "defaultValue": "false"
        },
        "minClusterProbability": {
          "label": "Min Cluster Probability",
          "description": "Minimum cluster probability for disambiguation (0-1)",
          "type": "number",
          "defaultValue": "0.9"
        },
        "geoDiambiguation": {
          "label": "Geo Disambiguation",
          "description": "Use geographic disambiguation for entities",
          "type": "boolean",
          "defaultValue": "false"
        },
        "queryMethod": {
          "label": "Query Method",
          "description": "Search method for the query",
          "type": "select",
          "options": [
            {
              "value": "kw",
              "label": "Keyword"
            },
            {
              "value": "nl",
              "label": "Natural Language"
            },
            {
              "value": "both",
              "label": "Both"
            }
          ],
          "defaultValue": "kw"
        },
        "nArticles": {
          "label": "Number of Articles",
          "description": "Number of articles to use for building the graph",
          "type": "number",
          "defaultValue": "10"
        },
        "historical": {
          "label": "Search Historical",
          "description": "Search historical archive instead of recent news",
          "type": "boolean",
          "defaultValue": "false"
        },
        "hoursBack": {
          "label": "Hours Back",
          "description": "Number of hours back to search",
          "type": "number",
          "defaultValue": "24"
        },
        "categories": {
          "label": "Categories",
          "description": "Filter by news categories",
          "type": "json",
          "options": [
            {
              "value": "Business",
              "label": "Business"
            },
            {
              "value": "Technology",
              "label": "Technology"
            },
            {
              "value": "Science",
              "label": "Science"
            },
            {
              "value": "Politics",
              "label": "Politics"
            },
            {
              "value": "Sports",
              "label": "Sports"
            },
            {
              "value": "Entertainment",
              "label": "Entertainment"
            },
            {
              "value": "Health",
              "label": "Health"
            },
            {
              "value": "Finance",
              "label": "Finance"
            }
          ]
        },
        "visualizeWith": {
          "label": "Visualize With",
          "description": "Request a visualization format (e.g., mermaid, svg)"
        }
      },
      "request": {
        "method": "POST",
        "url": "https://api.asknews.app/v1/news/graph",
        "body": {
          "query": "{{query}}",
          "min_cluster_probability": "{{minClusterProbability}}",
          "filter_params": {
            "n_articles": "{{nArticles}}",
            "hours_back": "{{hoursBack}}"
          },
          "visualize_with": "{{visualizeWith}}"
        }
      }
    },
    "asknewsChatCompletion": {
      "label": "Chat Completion",
      "description": "Get chat completions from a news-infused AI assistant powered by OpenAI API",
      "inputs": {
        "userMessage": {
          "label": "User Message",
          "description": "The user message to send to the chat model",
          "required": true,
          "type": "multiline"
        },
        "model": {
          "label": "Model",
          "description": "The model to use for chat completion",
          "type": "select",
          "options": [
            {
              "value": "gpt-4o",
              "label": "GPT-4o"
            },
            {
              "value": "gpt-4o-mini",
              "label": "GPT-4o Mini"
            },
            {
              "value": "gpt-4.1-2025-04-14",
              "label": "GPT-4.1"
            },
            {
              "value": "claude-3-5-sonnet-latest",
              "label": "Claude 3.5 Sonnet"
            }
          ],
          "defaultValue": "gpt-4o-mini"
        },
        "temperature": {
          "label": "Temperature",
          "description": "Sampling temperature (0-2, higher = more creative)",
          "type": "number",
          "defaultValue": "0.9"
        },
        "maxTokens": {
          "label": "Max Tokens",
          "description": "Maximum number of tokens in response",
          "type": "number",
          "defaultValue": "9999"
        },
        "journalistMode": {
          "label": "Journalist Mode",
          "description": "Activate AP styling, citations, and fair reporting prompting",
          "type": "boolean",
          "defaultValue": "true"
        },
        "inlineCitations": {
          "label": "Inline Citations",
          "description": "How to format citations in results",
          "type": "select",
          "options": [
            {
              "value": "markdown_link",
              "label": "Markdown Links"
            },
            {
              "value": "numbered",
              "label": "Numbered"
            },
            {
              "value": "none",
              "label": "None"
            }
          ],
          "defaultValue": "markdown_link"
        },
        "appendReferences": {
          "label": "Append References",
          "description": "Append full references at the end",
          "type": "boolean",
          "defaultValue": "true"
        },
        "asknewsWatermark": {
          "label": "Include AskNews Watermark",
          "description": "Include AskNews branding in response",
          "type": "boolean",
          "defaultValue": "true"
        },
        "conversationalAwareness": {
          "label": "Conversational Awareness",
          "description": "Enable context awareness for conversational flow",
          "type": "boolean",
          "defaultValue": "true"
        },
        "systemPrompt": {
          "label": "System Prompt",
          "description": "Optional custom system prompt for the model",
          "type": "multiline",
          "defaultValue": "You are a helpful AI assistant with access to real-time news and current information."
        }
      },
      "request": {
        "method": "POST",
        "url": "https://api.asknews.app/v1/openai/chat/completions",
        "body": {
          "messages": [
            {
              "role": "system",
              "content": "{{systemPrompt}}"
            },
            {
              "role": "user",
              "content": "{{userMessage}}"
            }
          ],
          "temperature": "{{temperature}}",
          "max_tokens": "{{maxTokens}}"
        }
      }
    },
    "searchStories": {
      "label": "Search Stories (Narrative Clusters)",
      "description": "Filter and search for top news narratives and story clusters",
      "inputs": {
        "query": {
          "label": "Query",
          "description": "Natural language or keyword query for search"
        },
        "method": {
          "label": "Search Method",
          "description": "nl: semantic search, kw: keyword search, both: combined",
          "type": "select",
          "options": [
            {
              "value": "kw",
              "label": "Keyword"
            },
            {
              "value": "nl",
              "label": "Natural Language"
            },
            {
              "value": "both",
              "label": "Both"
            }
          ],
          "defaultValue": "kw"
        },
        "categories": {
          "label": "Categories",
          "description": "Filter stories by categories",
          "type": "json",
          "options": [
            {
              "value": "Politics",
              "label": "Politics"
            },
            {
              "value": "Economy",
              "label": "Economy"
            },
            {
              "value": "Finance",
              "label": "Finance"
            },
            {
              "value": "Science",
              "label": "Science"
            },
            {
              "value": "Technology",
              "label": "Technology"
            },
            {
              "value": "Sports",
              "label": "Sports"
            },
            {
              "value": "Climate",
              "label": "Climate"
            },
            {
              "value": "Environment",
              "label": "Environment"
            },
            {
              "value": "Culture",
              "label": "Culture"
            },
            {
              "value": "Entertainment",
              "label": "Entertainment"
            },
            {
              "value": "Business",
              "label": "Business"
            },
            {
              "value": "Health",
              "label": "Health"
            },
            {
              "value": "International",
              "label": "International"
            }
          ]
        },
        "expand_updates": {
          "label": "Expand Updates",
          "description": "Include story updates in results",
          "type": "boolean",
          "defaultValue": "false"
        },
        "sort_by": {
          "label": "Sort By",
          "description": "Sort results by field",
          "type": "select",
          "options": [
            {
              "value": "published",
              "label": "Published Date"
            },
            {
              "value": "coverage",
              "label": "Coverage"
            },
            {
              "value": "sentiment",
              "label": "Sentiment"
            },
            {
              "value": "relevance",
              "label": "Relevance"
            }
          ],
          "defaultValue": "published"
        }
      },
      "request": {
        "method": "GET",
        "url": "https://api.asknews.app/v1/stories",
        "query": {
          "query": "{{query}}"
        }
      }
    },
    "createANewsletter": {
      "label": "Create a Newsletter",
      "description": "Create an automated newsletter powered by news and AI",
      "inputs": {
        "name": {
          "label": "Newsletter Name",
          "description": "Name of the newsletter",
          "required": true
        },
        "query": {
          "label": "Query",
          "description": "Natural language query to define newsletter content",
          "required": true,
          "type": "multiline"
        },
        "cron": {
          "label": "Cron Schedule",
          "description": "Cron expression for newsletter schedule (e.g., \"0 0 * * *\" for daily at midnight UTC)",
          "required": true
        },
        "model": {
          "label": "Model",
          "description": "AI model to use for newsletter generation",
          "required": true,
          "type": "select",
          "options": [
            {
              "value": "gpt-4o",
              "label": "GPT-4o"
            },
            {
              "value": "gpt-4o-mini",
              "label": "GPT-4o Mini"
            },
            {
              "value": "claude-3-5-sonnet-latest",
              "label": "Claude 3.5 Sonnet"
            },
            {
              "value": "meta-llama/Meta-Llama-3.1-405B-Instruct",
              "label": "Meta Llama 3.1 405B"
            },
            {
              "value": "meta-llama/Meta-Llama-3.3-70B-Instruct",
              "label": "Meta Llama 3.3 70B"
            }
          ],
          "defaultValue": "gpt-4o"
        },
        "sender": {
          "label": "Sender Email",
          "description": "Email address of the newsletter sender",
          "required": true
        },
        "subject": {
          "label": "Subject",
          "description": "Newsletter email subject (auto-generated if not provided)"
        },
        "logoUrl": {
          "label": "Logo URL",
          "description": "URL of the newsletter logo"
        },
        "replyTo": {
          "label": "Reply-To Email",
          "description": "Email address for replies (defaults to sender if not provided)"
        },
        "audienceId": {
          "label": "Audience ID",
          "description": "Existing audience ID (creates new audience if not provided)"
        },
        "resendApiKey": {
          "label": "Resend API Key",
          "description": "API key for Resend email service (required to send newsletter)"
        },
        "isPublic": {
          "label": "Is Public",
          "description": "Make newsletter publicly discoverable",
          "type": "boolean",
          "defaultValue": "true"
        },
        "isActive": {
          "label": "Is Active",
          "description": "Activate the newsletter immediately",
          "type": "boolean",
          "defaultValue": "true"
        },
        "expiresAt": {
          "label": "Expiration Date",
          "description": "Newsletter expiration date (ISO format: YYYY-MM-DDTHH:MM:SS)"
        }
      },
      "request": {
        "method": "POST",
        "url": "https://api.asknews.app/v1/chat/newsletters",
        "body": {
          "name": "{{name}}",
          "query": "{{query}}",
          "cron": "{{cron}}",
          "sender": "{{sender}}",
          "subject": "{{subject}}",
          "logo_url": "{{logoUrl}}",
          "reply_to": "{{replyTo}}",
          "audience_id": "{{audienceId}}",
          "resend_api_key": "{{resendApiKey}}",
          "expires_at": "{{expiresAt}}"
        }
      }
    },
    "updateANewsletter": {
      "label": "Update a Newsletter",
      "description": "Update an existing automated newsletter",
      "inputs": {
        "newsletterId": {
          "label": "Newsletter ID",
          "description": "UUID of the newsletter to update",
          "required": true
        },
        "name": {
          "label": "Newsletter Name",
          "description": "Name of the newsletter"
        },
        "query": {
          "label": "Query",
          "description": "Natural language query to define newsletter content",
          "type": "multiline"
        },
        "cron": {
          "label": "Cron Schedule",
          "description": "Cron expression for newsletter schedule (e.g., \"0 0 * * *\" for daily at midnight UTC)"
        },
        "model": {
          "label": "Model",
          "description": "AI model to use for newsletter generation",
          "type": "select",
          "options": [
            {
              "value": "gpt-4o",
              "label": "GPT-4o"
            },
            {
              "value": "gpt-4o-mini",
              "label": "GPT-4o Mini"
            },
            {
              "value": "claude-3-5-sonnet-latest",
              "label": "Claude 3.5 Sonnet"
            },
            {
              "value": "meta-llama/Meta-Llama-3.3-70B-Instruct",
              "label": "Meta Llama 3.3 70B"
            }
          ]
        },
        "subject": {
          "label": "Subject",
          "description": "Newsletter email subject"
        },
        "sender": {
          "label": "Sender Email",
          "description": "Email address of the newsletter sender"
        },
        "logoUrl": {
          "label": "Logo URL",
          "description": "URL of the newsletter logo"
        },
        "replyTo": {
          "label": "Reply-To Email",
          "description": "Email address for replies"
        },
        "audienceId": {
          "label": "Audience ID",
          "description": "Audience ID for the newsletter"
        },
        "resendApiKey": {
          "label": "Resend API Key",
          "description": "API key for Resend email service"
        },
        "isPublic": {
          "label": "Is Public",
          "description": "Make newsletter publicly discoverable",
          "type": "boolean"
        },
        "isActive": {
          "label": "Is Active",
          "description": "Activate or deactivate the newsletter",
          "type": "boolean"
        },
        "expiresAt": {
          "label": "Expiration Date",
          "description": "Newsletter expiration date (ISO format: YYYY-MM-DDTHH:MM:SS)"
        }
      },
      "request": {
        "method": "PUT",
        "url": "https://api.asknews.app/v1/chat/newsletters/{{newsletterId}}",
        "body": {
          "name": "{{name}}",
          "query": "{{query}}",
          "cron": "{{cron}}",
          "subject": "{{subject}}",
          "sender": "{{sender}}",
          "logo_url": "{{logoUrl}}",
          "reply_to": "{{replyTo}}",
          "audience_id": "{{audienceId}}",
          "resend_api_key": "{{resendApiKey}}",
          "expires_at": "{{expiresAt}}"
        }
      }
    }
  },
  "triggers": {}
}
