{
  "name": "slidespeak",
  "label": "SlideSpeak",
  "description": "",
  "icon": "",
  "hosts": [
    "api.slidespeak.co"
  ],
  "upstream": {
    "package": "@activepieces/piece-slidespeak",
    "version": "0.2.2"
  },
  "credential": {
    "fields": {
      "token": {
        "label": "API Key",
        "description": "You can obtain your API key by navigating to [API Settings](https://app.slidespeak.co/settings/developer).",
        "secret": true,
        "required": true
      }
    },
    "headers": {
      "x-api-key": "{{credential.token}}"
    }
  },
  "actions": {
    "create-presentation": {
      "label": "Create Presentation",
      "description": "Creates a new presentation.",
      "inputs": {
        "plain_text": {
          "label": "Topic",
          "description": "Topic of presentation.",
          "required": true
        },
        "length": {
          "label": "Number of Slides",
          "type": "number"
        },
        "document_uuids": {
          "label": "Documents",
          "description": "Uploaded docuemts to use in presentation.",
          "type": "json"
        },
        "template": {
          "label": "Dropdown"
        },
        "language": {
          "label": "Language"
        },
        "custom_user_instructions": {
          "label": "Custom User Instructions",
          "type": "multiline"
        },
        "fetch_images": {
          "label": "Fetch Images",
          "description": "Whether to include stock images.",
          "type": "boolean"
        },
        "tone": {
          "label": "Tone",
          "description": "The tone to use for the text.",
          "type": "select",
          "options": [
            {
              "value": "default",
              "label": "default"
            },
            {
              "value": "casual",
              "label": "casual"
            },
            {
              "value": "professional",
              "label": "professional"
            },
            {
              "value": "funny",
              "label": "funny"
            },
            {
              "value": "educational",
              "label": "educational"
            },
            {
              "value": "sales_pitch",
              "label": "sales_pitch"
            }
          ]
        },
        "verbosity": {
          "label": "Verbosity",
          "description": "How verbose, or long, the text should be.",
          "type": "select",
          "options": [
            {
              "value": "concise",
              "label": "concise"
            },
            {
              "value": "standard",
              "label": "standard"
            },
            {
              "value": "text-heavy",
              "label": "text-heavy"
            }
          ]
        },
        "include_cover": {
          "label": "include the ‘cover’ slide.",
          "type": "boolean"
        },
        "include_table_of_contents": {
          "label": " include the ‘table of contents’ slides.",
          "type": "boolean"
        },
        "response_format": {
          "label": "Response Format",
          "type": "select",
          "options": [
            {
              "value": "powerpoint",
              "label": "powerpoint"
            },
            {
              "value": "pdf",
              "label": "pdf"
            }
          ]
        }
      },
      "request": {
        "method": "POST",
        "url": "https://api.slidespeak.co/api/v1/presentation/generate",
        "body": {
          "plain_text": "{{plain_text}}",
          "length": "{{length}}",
          "template": "{{template}}",
          "language": "{{language}}",
          "custom_user_instructions": "{{custom_user_instructions}}"
        }
      }
    },
    "get-task-status": {
      "label": "Get Task Status",
      "description": "Gets status of task by id.",
      "inputs": {
        "taskId": {
          "label": "Task ID",
          "required": true
        }
      },
      "request": {
        "method": "GET",
        "url": "https://api.slidespeak.co/api/v1/task_status/{{taskId}}"
      }
    }
  },
  "triggers": {}
}
