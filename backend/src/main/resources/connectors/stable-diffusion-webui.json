{
  "name": "stable-diffusion-webui",
  "label": "Stable Dffusion web UI",
  "description": "A web interface for Stable Diffusion",
  "icon": "",
  "hosts": [
    "{{credential.baseUrl}}"
  ],
  "upstream": {
    "package": "@activepieces/piece-stable-diffusion-webui",
    "version": "0.1.6"
  },
  "credential": {
    "fields": {
      "baseUrl": {
        "label": "Stable Diffusion web UI API base URL",
        "description": "The host only, without https://, such as name.example.com.",
        "required": true
      }
    }
  },
  "actions": {
    "textToImage": {
      "label": "Text to Image",
      "description": "",
      "inputs": {
        "prompt": {
          "label": "Prompt",
          "required": true,
          "type": "multiline"
        },
        "model": {
          "label": "Model",
          "required": true
        },
        "advancedParameters": {
          "label": "Advanced parameters (key/value)",
          "description": "Refer to API documentation",
          "type": "json"
        }
      },
      "request": {
        "method": "POST",
        "url": "https://{{credential.baseUrl}}/sdapi/v1/txt2img",
        "body": {
          "prompt": "{{prompt}}",
          "override_settings": {
            "sd_model_checkpoint": "{{model}}"
          },
          "override_settings_restore_afterwards": true
        }
      }
    }
  },
  "triggers": {}
}
