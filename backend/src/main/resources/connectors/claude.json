{
  "name": "claude",
  "label": "Anthropic Claude",
  "description": "",
  "icon": "",
  "hosts": [
    "api.anthropic.com"
  ],
  "upstream": {
    "package": "@activepieces/piece-claude",
    "version": "0.9.0"
  },
  "credential": {
    "fields": {
      "token": {
        "label": "API Key",
        "description": "Follow these instructions to get your Claude API Key:\n\n1. Visit the following website: https://console.anthropic.com/settings/keys.\n2. Once on the website, locate and click on the option to obtain your Claude API Key.\n",
        "secret": true,
        "required": true
      }
    },
    "headers": {
      "x-api-key": "{{credential.token}}"
    }
  },
  "actions": {
    "get_model": {
      "label": "Get Model",
      "description": "Reads details for a single Claude model, or resolves a model alias to its ID.",
      "inputs": {
        "modelId": {
          "label": "Model ID",
          "description": "The model ID or alias to look up.",
          "required": true
        }
      },
      "request": {
        "method": "GET",
        "url": "https://api.anthropic.com/v1/models/{{modelId}}",
        "headers": {
          "anthropic-version": "2023-06-01",
          "x-stainless-arch": "arm64",
          "x-stainless-lang": "js",
          "x-stainless-os": "MacOS",
          "x-stainless-package-version": "0.39.0",
          "x-stainless-retry-count": "0",
          "x-stainless-runtime": "node",
          "x-stainless-runtime-version": "v26.13.0",
          "x-stainless-timeout": "600000"
        }
      }
    },
    "get_message_batch": {
      "label": "Get Message Batch",
      "description": "Reads the status and request counts of a message batch, to poll for completion.",
      "inputs": {
        "messageBatchId": {
          "label": "Message Batch ID",
          "required": true
        }
      },
      "request": {
        "method": "GET",
        "url": "https://api.anthropic.com/v1/messages/batches/{{messageBatchId}}",
        "headers": {
          "anthropic-version": "2023-06-01",
          "x-stainless-arch": "arm64",
          "x-stainless-lang": "js",
          "x-stainless-os": "MacOS",
          "x-stainless-package-version": "0.39.0",
          "x-stainless-retry-count": "0",
          "x-stainless-runtime": "node",
          "x-stainless-runtime-version": "v26.13.0",
          "x-stainless-timeout": "600000"
        }
      }
    },
    "cancel_message_batch": {
      "label": "Cancel Message Batch",
      "description": "Cancels an in-progress message batch. Already-completed requests in the batch are not undone.",
      "inputs": {
        "messageBatchId": {
          "label": "Message Batch ID",
          "required": true
        }
      },
      "request": {
        "method": "POST",
        "url": "https://api.anthropic.com/v1/messages/batches/{{messageBatchId}}/cancel",
        "headers": {
          "anthropic-version": "2023-06-01",
          "x-stainless-arch": "arm64",
          "x-stainless-lang": "js",
          "x-stainless-os": "MacOS",
          "x-stainless-package-version": "0.39.0",
          "x-stainless-retry-count": "0",
          "x-stainless-runtime": "node",
          "x-stainless-runtime-version": "v26.13.0",
          "x-stainless-timeout": "600000"
        }
      }
    },
    "delete_message_batch": {
      "label": "Delete Message Batch",
      "description": "Deletes a message batch and its results. The batch must have finished processing first.",
      "inputs": {
        "messageBatchId": {
          "label": "Message Batch ID",
          "required": true
        }
      },
      "request": {
        "method": "DELETE",
        "url": "https://api.anthropic.com/v1/messages/batches/{{messageBatchId}}",
        "headers": {
          "anthropic-version": "2023-06-01",
          "x-stainless-arch": "arm64",
          "x-stainless-lang": "js",
          "x-stainless-os": "MacOS",
          "x-stainless-package-version": "0.39.0",
          "x-stainless-retry-count": "0",
          "x-stainless-runtime": "node",
          "x-stainless-runtime-version": "v26.13.0",
          "x-stainless-timeout": "600000"
        }
      }
    },
    "get_message_batch_results": {
      "label": "Get Message Batch Results",
      "description": "Reads the per-request results of a finished message batch.",
      "inputs": {
        "messageBatchId": {
          "label": "Message Batch ID",
          "required": true
        },
        "maxResults": {
          "label": "Max Results",
          "description": "Maximum number of results to return (default 100).",
          "type": "number"
        }
      },
      "request": {
        "method": "GET",
        "url": "https://api.anthropic.com/v1/messages/batches/{{messageBatchId}}",
        "headers": {
          "anthropic-version": "2023-06-01",
          "x-stainless-arch": "arm64",
          "x-stainless-lang": "js",
          "x-stainless-os": "MacOS",
          "x-stainless-package-version": "0.39.0",
          "x-stainless-retry-count": "0",
          "x-stainless-runtime": "node",
          "x-stainless-runtime-version": "v26.13.0",
          "x-stainless-timeout": "600000"
        }
      }
    },
    "count_tokens": {
      "label": "Count Tokens",
      "description": "Counts how many input tokens a prompt would use for a given model, without generating a response.",
      "inputs": {
        "model": {
          "label": "Model",
          "description": "The Claude model to use. Newest models are listed first.",
          "required": true
        },
        "systemPrompt": {
          "label": "System Prompt",
          "type": "multiline"
        },
        "prompt": {
          "label": "Prompt",
          "required": true,
          "type": "multiline"
        }
      },
      "request": {
        "method": "POST",
        "url": "https://api.anthropic.com/v1/messages/count_tokens",
        "headers": {
          "anthropic-version": "2023-06-01",
          "x-stainless-arch": "arm64",
          "x-stainless-lang": "js",
          "x-stainless-os": "MacOS",
          "x-stainless-package-version": "0.39.0",
          "x-stainless-retry-count": "0",
          "x-stainless-runtime": "node",
          "x-stainless-runtime-version": "v26.13.0",
          "x-stainless-timeout": "600000"
        },
        "body": {
          "model": "{{model}}",
          "system": "{{systemPrompt}}",
          "messages": [
            {
              "role": "user",
              "content": "{{prompt}}"
            }
          ]
        }
      }
    }
  },
  "triggers": {}
}
