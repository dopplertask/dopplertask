{
  "name": "bluesky",
  "label": "Bluesky",
  "description": "Decentralized social network built on the AT Protocol.",
  "icon": "",
  "hosts": [
    "{{credential.pdsHost}}"
  ],
  "upstream": {
    "package": "@activepieces/piece-bluesky",
    "version": "0.2.2"
  },
  "credential": {
    "fields": {
      "pdsHost": {
        "label": "PDS Host",
        "description": "The Personal Data Server host. Leave empty for default Bluesky network (https://bsky.social). The host only, without https://, such as name.example.com."
      },
      "identifier": {
        "label": "Identifier",
        "description": "Your Bluesky handle or email address",
        "required": true
      },
      "password": {
        "label": "Password",
        "description": "A Bluesky app password (recommended) or your account password",
        "secret": true,
        "required": true
      }
    },
    "body": {
      "identifier": "{{credential.identifier}}",
      "password": "{{credential.password}}"
    }
  },
  "actions": {
    "createPost": {
      "label": "Create Post",
      "description": "Create a new post on Bluesky",
      "inputs": {
        "postType": {
          "label": "Post Type",
          "description": "Informational only. To quote a post, fill in \"Quote Post URL\"; to reply, fill in \"Reply to Post\".",
          "type": "select",
          "options": [
            {
              "value": "text",
              "label": "Text Post"
            },
            {
              "value": "photo",
              "label": "Photo Post"
            },
            {
              "value": "link",
              "label": "Link Share"
            },
            {
              "value": "reply",
              "label": "Reply"
            },
            {
              "value": "quote",
              "label": "Repost with Comment"
            }
          ],
          "defaultValue": "text"
        },
        "text": {
          "label": "Post Text",
          "description": "What do you want to post? (Max 300 characters, counted as visible characters so emoji and non-Latin text count once each)",
          "required": true,
          "type": "multiline"
        },
        "language": {
          "label": "Post Language",
          "description": "Language of your post",
          "type": "select",
          "options": [
            {
              "value": "en",
              "label": "English"
            },
            {
              "value": "es",
              "label": "Spanish"
            },
            {
              "value": "fr",
              "label": "French"
            },
            {
              "value": "de",
              "label": "German"
            },
            {
              "value": "it",
              "label": "Italian"
            },
            {
              "value": "pt",
              "label": "Portuguese"
            },
            {
              "value": "ja",
              "label": "Japanese"
            },
            {
              "value": "ko",
              "label": "Korean"
            },
            {
              "value": "zh",
              "label": "Chinese"
            },
            {
              "value": "ru",
              "label": "Russian"
            },
            {
              "value": "ar",
              "label": "Arabic"
            },
            {
              "value": "hi",
              "label": "Hindi"
            },
            {
              "value": "nl",
              "label": "Dutch"
            },
            {
              "value": "sv",
              "label": "Swedish"
            },
            {
              "value": "other",
              "label": "Other"
            }
          ],
          "defaultValue": "en"
        },
        "imageUrls": {
          "label": "Image URLs",
          "description": "Add up to 4 images by URL (PNG, JPEG, GIF or WebP, max 1 MB each)",
          "type": "json"
        },
        "imageDescriptions": {
          "label": "Image Descriptions",
          "description": "Describe each image for accessibility",
          "type": "json"
        },
        "videoUrl": {
          "label": "Video URL",
          "description": "Link to a video file (MP4, max 50 MB). Bluesky only accepts videos from accounts with a verified email address."
        },
        "videoAltText": {
          "label": "Video Description",
          "description": "Describe the video for accessibility",
          "type": "multiline"
        },
        "videoCaptions": {
          "label": "Video Captions",
          "description": "Caption file URLs in WebVTT (.vtt) format (optional)",
          "type": "json"
        },
        "videoCaptionLanguage": {
          "label": "Video Caption Language",
          "description": "Language code of the caption files, for example en or de. Defaults to en.",
          "defaultValue": "en"
        },
        "linkUrl": {
          "label": "Link to Share",
          "description": "URL to share with your post"
        },
        "replyToPost": {
          "label": "Reply to Post",
          "description": "URL of post to reply to"
        },
        "quotePostUrl": {
          "label": "Quote Post URL",
          "description": "Link or at:// URI of a post to quote (embed) in this post. Works together with images, video or a link."
        },
        "threadContent": {
          "label": "Thread Posts",
          "description": "Create additional connected posts. Each must be 300 characters or fewer.",
          "type": "json"
        },
        "additionalHashtags": {
          "label": "Hashtags",
          "description": "Add hashtags (e.g., tech,bluesky). At most 8."
        },
        "contentWarnings": {
          "label": "Content Warnings",
          "description": "Self-labels Bluesky shows as content warnings. \"Adult Content\" is sent as Bluesky's Adult (porn) label, \"Violence\" as Graphic Media, \"Sensitive Topic\" as Suggestive (sexual); \"Spam/Promotional\" has no Bluesky label and is ignored.",
          "type": "json",
          "options": [
            {
              "value": "adult",
              "label": "Adult Content"
            },
            {
              "value": "graphic-media",
              "label": "Graphic Content"
            },
            {
              "value": "sensitive",
              "label": "Sensitive Topic"
            },
            {
              "value": "violence",
              "label": "Violence"
            },
            {
              "value": "spam",
              "label": "Spam/Promotional"
            },
            {
              "value": "sexual",
              "label": "Suggestive (sexual)"
            },
            {
              "value": "nudity",
              "label": "Nudity"
            },
            {
              "value": "porn",
              "label": "Adult (porn)"
            }
          ]
        },
        "audience": {
          "label": "Audience",
          "description": "Bluesky posts are always public; this setting has no effect and is kept only for older flows.",
          "type": "select",
          "options": [
            {
              "value": "public",
              "label": "Everyone (Public)"
            },
            {
              "value": "followers",
              "label": "Followers only"
            },
            {
              "value": "unlisted",
              "label": "Private/Unlisted"
            }
          ],
          "defaultValue": "public"
        }
      },
      "request": {
        "method": "POST",
        "url": "https://{{credential.pdsHost}}/xrpc/com.atproto.server.createSession",
        "body": {}
      }
    },
    "get_profile": {
      "label": "Get Profile",
      "description": "Get a Bluesky profile with follower and post counts",
      "inputs": {
        "actor": {
          "label": "Account",
          "description": "Handle (alice.bsky.social), DID or profile link. Leave empty for your own profile."
        }
      },
      "request": {
        "method": "POST",
        "url": "https://{{credential.pdsHost}}/xrpc/com.atproto.server.createSession",
        "body": {}
      }
    },
    "follow_user": {
      "label": "Follow User",
      "description": "Follow a Bluesky account",
      "inputs": {
        "actor": {
          "label": "Account",
          "description": "Handle (alice.bsky.social), DID or profile link of the account to follow.",
          "required": true
        }
      },
      "request": {
        "method": "POST",
        "url": "https://{{credential.pdsHost}}/xrpc/com.atproto.server.createSession",
        "body": {}
      }
    },
    "unfollow_user": {
      "label": "Unfollow User",
      "description": "Stop following a Bluesky account",
      "inputs": {
        "actor": {
          "label": "Account",
          "description": "Handle (alice.bsky.social), DID or profile link of the account to unfollow.",
          "required": true
        }
      },
      "request": {
        "method": "POST",
        "url": "https://{{credential.pdsHost}}/xrpc/com.atproto.server.createSession",
        "body": {}
      }
    },
    "block_user": {
      "label": "Block User",
      "description": "Block a Bluesky account",
      "inputs": {
        "actor": {
          "label": "Account",
          "description": "Handle (alice.bsky.social), DID or profile link of the account to block.",
          "required": true
        }
      },
      "request": {
        "method": "POST",
        "url": "https://{{credential.pdsHost}}/xrpc/com.atproto.server.createSession",
        "body": {}
      }
    },
    "unblock_user": {
      "label": "Unblock User",
      "description": "Unblock a Bluesky account",
      "inputs": {
        "actor": {
          "label": "Account",
          "description": "Handle (alice.bsky.social), DID or profile link of the account to unblock.",
          "required": true
        }
      },
      "request": {
        "method": "POST",
        "url": "https://{{credential.pdsHost}}/xrpc/com.atproto.server.createSession",
        "body": {}
      }
    },
    "mute_user": {
      "label": "Mute User",
      "description": "Mute a Bluesky account (private)",
      "inputs": {
        "actor": {
          "label": "Account",
          "description": "Handle (alice.bsky.social), DID or profile link of the account to mute.",
          "required": true
        }
      },
      "request": {
        "method": "POST",
        "url": "https://{{credential.pdsHost}}/xrpc/com.atproto.server.createSession",
        "body": {}
      }
    },
    "unmute_user": {
      "label": "Unmute User",
      "description": "Unmute a Bluesky account",
      "inputs": {
        "actor": {
          "label": "Account",
          "description": "Handle (alice.bsky.social), DID or profile link of the account to unmute.",
          "required": true
        }
      },
      "request": {
        "method": "POST",
        "url": "https://{{credential.pdsHost}}/xrpc/com.atproto.server.createSession",
        "body": {}
      }
    },
    "update_profile": {
      "label": "Update Profile",
      "description": "Change your display name, bio or avatar",
      "inputs": {
        "displayName": {
          "label": "Display Name",
          "description": "New display name. Leave empty to keep the current one."
        },
        "clearDisplayName": {
          "label": "Clear Display Name",
          "description": "Remove the display name.",
          "type": "boolean",
          "defaultValue": "false"
        },
        "description": {
          "label": "Bio",
          "description": "New bio. Leave empty to keep the current one.",
          "type": "multiline"
        },
        "clearDescription": {
          "label": "Clear Bio",
          "description": "Remove the bio.",
          "type": "boolean",
          "defaultValue": "false"
        },
        "avatarUrl": {
          "label": "Avatar Image URL",
          "description": "PNG or JPEG, max 1 MB. Leave empty to keep the current avatar."
        }
      },
      "request": {
        "method": "POST",
        "url": "https://{{credential.pdsHost}}/xrpc/com.atproto.server.createSession",
        "body": {}
      }
    },
    "bluesky_resolve_handle": {
      "label": "Resolve Handle (AI)",
      "description": "Turn a Bluesky handle into its permanent DID",
      "inputs": {
        "handle": {
          "label": "Handle",
          "description": "For example alice.bsky.social, @alice or https://bsky.app/profile/alice.bsky.social.",
          "required": true
        }
      },
      "request": {
        "method": "POST",
        "url": "https://{{credential.pdsHost}}/xrpc/com.atproto.server.createSession",
        "body": {}
      }
    },
    "bluesky_get_unread_count": {
      "label": "Get Unread Notification Count (AI)",
      "description": "Count unread notifications",
      "inputs": {},
      "request": {
        "method": "POST",
        "url": "https://{{credential.pdsHost}}/xrpc/com.atproto.server.createSession",
        "body": {}
      }
    }
  },
  "triggers": {}
}
