{
  "name": "sessions-us",
  "label": "Sessions.us",
  "description": "Video conferencing platform for businesses and professionals",
  "icon": "",
  "hosts": [
    "api.app.sessions.us"
  ],
  "upstream": {
    "package": "@activepieces/piece-sessions-us",
    "version": "0.2.2"
  },
  "credential": {
    "fields": {
      "token": {
        "label": "API Key",
        "description": "",
        "secret": true,
        "required": true
      }
    },
    "headers": {
      "x-api-key": "{{credential.token}}"
    }
  },
  "actions": {
    "create_session": {
      "label": "Create Session",
      "description": "Quickly create a session.",
      "inputs": {
        "name": {
          "label": "Session Name",
          "description": "The name of the session",
          "required": true
        },
        "startAt": {
          "label": "Starts At",
          "description": "Select a date and time",
          "required": true,
          "defaultValue": "2026-11-09T22:34:30.406Z"
        },
        "plannedEnd": {
          "label": "Ends At",
          "description": "Select a date and time",
          "required": true,
          "defaultValue": "2026-11-09T22:34:30.406Z"
        },
        "timezone": {
          "label": "Timezone",
          "description": "The timezone which the session will take place.",
          "required": true
        }
      },
      "request": {
        "method": "POST",
        "url": "https://api.app.sessions.us/api/sessions",
        "body": {
          "name": "{{name}}",
          "startAt": "{{startAt}}",
          "plannedEnd": "{{plannedEnd}}",
          "timeZone": "{{timezone}}"
        }
      }
    },
    "create_event": {
      "label": "Create Event",
      "description": "Quickly create an event.",
      "inputs": {
        "name": {
          "label": "Event Name",
          "description": "The name of the event",
          "required": true
        },
        "startAt": {
          "label": "Starts At",
          "description": "Select a date and time",
          "required": true,
          "defaultValue": "2026-11-09T22:34:30.406Z"
        },
        "plannedEnd": {
          "label": "Ends At",
          "description": "Select a date and time",
          "required": true,
          "defaultValue": "2026-11-09T22:34:30.406Z"
        },
        "timezone": {
          "label": "Timezone",
          "description": "The timezone which the session will take place.",
          "required": true
        }
      },
      "request": {
        "method": "POST",
        "url": "https://api.app.sessions.us/api/events",
        "body": {
          "name": "{{name}}",
          "slug": "{{name}}",
          "startAt": "{{startAt}}",
          "plannedEnd": "{{plannedEnd}}",
          "timeZone": "{{timezone}}"
        }
      }
    },
    "publish_event": {
      "label": "Publish Event",
      "description": "Quickly publish an event.",
      "inputs": {
        "event": {
          "label": "Event",
          "description": "The event you want to publish.",
          "required": true
        }
      },
      "request": {
        "method": "POST",
        "url": "https://api.app.sessions.us/api/events/{{event}}/publish"
      }
    }
  },
  "triggers": {}
}
