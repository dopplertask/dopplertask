{
  "name": "connectuc",
  "label": "ConnectUC",
  "description": "",
  "icon": "",
  "hosts": [
    "api.connectuc.io",
    "auth.uc-technologies.com"
  ],
  "upstream": {
    "package": "@activepieces/piece-connectuc",
    "version": "0.0.13"
  },
  "credential": {
    "oauth2": {
      "authUrl": "https://auth.uc-technologies.com/oauth2/authorize",
      "tokenUrl": "https://auth.uc-technologies.com/oauth2/token",
      "scope": "offline_access"
    }
  },
  "actions": {
    "initiate-call": {
      "label": "Initiate Call",
      "description": "Initiate an outbound call from a ConnectUC extension",
      "inputs": {
        "domain": {
          "label": "Domain",
          "description": "Select domain to which this trigger applies"
        },
        "user": {
          "label": "User",
          "description": "Select the user who owns this contact",
          "required": true
        },
        "device": {
          "label": "Device",
          "description": "Select the device to use for the call",
          "required": true
        },
        "toNumber": {
          "label": "To Number",
          "description": "The destination number of the call",
          "required": true
        }
      },
      "request": {
        "method": "POST",
        "url": "https://api.connectuc.io/users/{{user}}/activepieces/initiate-call",
        "body": {
          "fromUid": "{{device}}",
          "toNumber": "{{toNumber}}"
        }
      }
    }
  },
  "triggers": {}
}
