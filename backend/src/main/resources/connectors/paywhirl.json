{
  "name": "paywhirl",
  "label": "Paywhirl",
  "description": "PayWhirls intuitive tools make recurring billing easy. Sell subscriptions, pre-orders, payment plans, or whatever billing arrangements you can dream up.",
  "icon": "",
  "hosts": [
    "api.paywhirl.com"
  ],
  "upstream": {
    "package": "@activepieces/piece-paywhirl",
    "version": "0.1.1"
  },
  "credential": {
    "fields": {
      "api_key": {
        "label": "API Key",
        "description": "Your Paywhirl API Key",
        "required": true
      },
      "api_secret": {
        "label": "API Secret",
        "description": "Your Paywhirl API Secret",
        "required": true
      }
    },
    "headers": {
      "api-key": "{{credential.api_key}}",
      "api-secret": "{{credential.api_secret}}"
    }
  },
  "actions": {
    "cancelSubscription": {
      "label": "Cancel Subscription",
      "description": "Cancel a customer's existing subscription. This will prevent the subscription from making any additional charges and unbind the customer from the plan.",
      "inputs": {
        "subscription_id": {
          "label": "Subscription ID",
          "description": "Subscription ID",
          "type": "number"
        },
        "customer_id": {
          "label": "Customer ID",
          "description": "Customer ID (can be used instead of subscription_id)"
        }
      },
      "request": {
        "method": "POST",
        "url": "https://api.paywhirl.com/unsubscribe/customer",
        "body": {
          "subscription_id": "{{subscription_id}}",
          "customer_id": "{{customer_id}}"
        }
      }
    },
    "createCustomer": {
      "label": "Create Customer",
      "description": "Create a new customer. This is required before binding a customer to a plan via a subscription.",
      "inputs": {
        "first_name": {
          "label": "First Name",
          "description": "First name",
          "required": true
        },
        "last_name": {
          "label": "Last Name",
          "description": "Last name",
          "required": true
        },
        "email": {
          "label": "Email",
          "description": "Email address",
          "required": true
        },
        "currency": {
          "label": "Currency",
          "description": "Currency code (ex. USD, GBP, AUD, CAD, EUR, etc)",
          "required": true
        },
        "password": {
          "label": "Password",
          "description": "Password (leave blank to let customer assign via secure link in welcome email)"
        },
        "phone": {
          "label": "Phone Number",
          "description": "Phone number",
          "type": "number"
        },
        "address": {
          "label": "Street Address",
          "description": "Street address",
          "type": "multiline"
        },
        "city": {
          "label": "City",
          "description": "City"
        },
        "state": {
          "label": "State / Region",
          "description": "State / Region"
        },
        "zip": {
          "label": "Zip / Postal Code",
          "description": "Zip / Postal Code"
        },
        "country": {
          "label": "Country Code",
          "description": "Country Code (ex. US, GB, CA, AU, etc)"
        },
        "gateway_id": {
          "label": "Payment Gateway ID",
          "description": "PayWhirl ID of payment gateway to attach to customer. If left blank, first loaded gateway will be used."
        },
        "utm_source": {
          "label": "UTM Source",
          "description": "Acquisition source (ex. google, bing, email, fall_campaign, etc)"
        },
        "utm_medium": {
          "label": "UTM Medium",
          "description": "Acquisition medium (ex. CPC, banner, text_ad, etc)"
        },
        "utm_term": {
          "label": "UTM Term",
          "description": "Acquisition keyword"
        },
        "utm_content": {
          "label": "UTM Content",
          "description": "Acquisition Ad Content"
        },
        "utm_campaign": {
          "label": "UTM Campaign",
          "description": "Acquisition Ad Campaign"
        },
        "utm_group": {
          "label": "UTM Group",
          "description": "Acquisition Ad Group"
        }
      },
      "request": {
        "method": "POST",
        "url": "https://api.paywhirl.com/create/customer",
        "body": {
          "first_name": "{{first_name}}",
          "last_name": "{{last_name}}",
          "email": "{{email}}",
          "currency": "{{currency}}",
          "password": "{{password}}",
          "phone": "{{phone}}",
          "address": "{{address}}",
          "city": "{{city}}",
          "state": "{{state}}",
          "zip": "{{zip}}",
          "country": "{{country}}",
          "gateway_id": "{{gateway_id}}",
          "utm_source": "{{utm_source}}",
          "utm_medium": "{{utm_medium}}",
          "utm_term": "{{utm_term}}",
          "utm_content": "{{utm_content}}",
          "utm_campaign": "{{utm_campaign}}",
          "utm_group": "{{utm_group}}"
        }
      }
    },
    "getCustomer": {
      "label": "Get Customers",
      "description": "Retrieve a selection of customers. Useful for keeping track of customers in a local database.",
      "inputs": {
        "limit": {
          "label": "Limit",
          "description": "Number of entries to return. Limit 100.",
          "type": "number"
        },
        "order_key": {
          "label": "Order Key",
          "description": "Field to sort by. Default: id"
        },
        "order_direction": {
          "label": "Order Direction",
          "description": "Direction to order results",
          "type": "select",
          "options": [
            {
              "value": "asc",
              "label": "Ascending"
            },
            {
              "value": "desc",
              "label": "Descending"
            }
          ]
        },
        "before_id": {
          "label": "Before ID",
          "description": "All customers returned will have an ID less than this value",
          "type": "number"
        },
        "after_id": {
          "label": "After ID",
          "description": "All customers returned will have an ID greater than this value",
          "type": "number"
        },
        "keyword": {
          "label": "Keyword",
          "description": "Filter by keyword"
        }
      },
      "request": {
        "method": "GET",
        "url": "https://api.paywhirl.com/customers",
        "query": {
          "limit": "{{limit}}",
          "order_key": "{{order_key}}",
          "before_id": "{{before_id}}",
          "after_id": "{{after_id}}",
          "keyword": "{{keyword}}"
        }
      }
    },
    "searchCustomersSubscription": {
      "label": "Get Customer Subscriptions",
      "description": "Get a list of subscriptions associated with a given customer. Useful for determining which services a customer is currently expecting.",
      "inputs": {
        "customer_id": {
          "label": "Customer ID",
          "description": "Customer ID",
          "required": true,
          "type": "number"
        },
        "status": {
          "label": "Status",
          "description": "Filter by subscription status. Active (default) excludes canceled; Canceled shows only canceled; All shows all subscriptions.",
          "type": "select",
          "options": [
            {
              "value": "active",
              "label": "Active"
            },
            {
              "value": "canceled",
              "label": "Canceled"
            },
            {
              "value": "all",
              "label": "All"
            }
          ]
        }
      },
      "request": {
        "method": "GET",
        "url": "https://api.paywhirl.com/subscriptions/{{customer_id}}"
      }
    },
    "subscribeCustomer": {
      "label": "Subscribe Customer",
      "description": "Enroll a customer in an existing plan. The customer must have a valid payment method on file.",
      "inputs": {
        "customer_id": {
          "label": "Customer ID",
          "description": "Customer ID",
          "required": true,
          "type": "number"
        },
        "plan_id": {
          "label": "Plan ID",
          "description": "Plan ID",
          "required": true,
          "type": "number"
        },
        "trial_end": {
          "label": "Trial End",
          "description": "UNIX timestamp in the future (UTC timezone)",
          "type": "number"
        },
        "promo_id": {
          "label": "Promo ID",
          "description": "ID of promo code to apply",
          "type": "number"
        },
        "quantity": {
          "label": "Quantity",
          "description": "Quantity (Default: 1)",
          "type": "number"
        }
      },
      "request": {
        "method": "POST",
        "url": "https://api.paywhirl.com/subscribe/customer",
        "body": {
          "customer_id": "{{customer_id}}",
          "plan_id": "{{plan_id}}",
          "trial_end": "{{trial_end}}",
          "promo_id": "{{promo_id}}",
          "quantity": "{{quantity}}"
        }
      }
    }
  },
  "triggers": {}
}
