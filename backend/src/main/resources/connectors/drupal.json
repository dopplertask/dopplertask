{
  "name": "drupal",
  "label": "Drupal",
  "description": "",
  "icon": "",
  "hosts": [
    "{{credential.website_url}}"
  ],
  "upstream": {
    "package": "@activepieces/piece-drupal",
    "version": "1.1.12"
  },
  "credential": {
    "fields": {
      "website_url": {
        "label": "Website URL",
        "description": "URL of your Drupal site without a trailing \"/\" character. The host only, without https://, such as name.example.com.",
        "required": true
      },
      "username": {
        "label": "Username",
        "description": "",
        "required": true
      },
      "password": {
        "label": "Password",
        "description": "",
        "required": true
      }
    }
  },
  "actions": {
    "drupal-call-service": {
      "label": "Call Service",
      "description": "Call a service on the Drupal site",
      "inputs": {
        "service": {
          "label": "Service",
          "description": "The service to call.",
          "required": true
        }
      },
      "request": {
        "method": "POST",
        "url": "https://{{credential.website_url}}/orchestration/service/execute",
        "headers": {
          "authorization": "Basic Y3JlZGVudGlhbDAwMXo6Y3JlZGVudGlhbDAwMno="
        },
        "body": {}
      }
    }
  },
  "triggers": {}
}
