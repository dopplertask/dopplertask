{
  "name": "metatext",
  "label": "Metatext",
  "description": "AI content moderation and safety guard API",
  "icon": "",
  "hosts": [
    "api.metatext.ai"
  ],
  "upstream": {
    "package": "@activepieces/piece-metatext",
    "version": "0.1.7"
  },
  "credential": {
    "fields": {
      "token": {
        "label": "API Key",
        "description": "Contact support@metatext.io to get your API key.",
        "secret": true,
        "required": true
      }
    },
    "headers": {
      "x-api-key": "{{credential.token}}",
      "authorization": "Bearer {{credential.token}}"
    }
  },
  "actions": {
    "extract_text": {
      "label": "Extract Text",
      "description": "Extract information from text (entities, keywords, custom models)",
      "inputs": {
        "project_id": {
          "label": "Project ID",
          "description": "The ID of your extraction project",
          "required": true
        },
        "text": {
          "label": "Text",
          "description": "The text to extract information from",
          "required": true,
          "type": "multiline"
        },
        "model": {
          "label": "Model",
          "description": "The model to use for extraction"
        },
        "refresh": {
          "label": "Refresh",
          "description": "Force refresh the extraction",
          "type": "boolean",
          "defaultValue": "false"
        },
        "version": {
          "label": "Version",
          "description": "Model version to use"
        }
      },
      "request": {
        "method": "POST",
        "url": "https://api.metatext.ai/v2/extract/{{project_id}}",
        "body": {
          "text": "{{text}}",
          "model": "{{model}}",
          "options": {
            "version": "{{version}}"
          }
        }
      }
    },
    "classify_text": {
      "label": "Classify Text",
      "description": "Classify text into categories (sentiment, intent, topic, custom models)",
      "inputs": {
        "project_id": {
          "label": "Project ID",
          "description": "The ID of your classification project",
          "required": true
        },
        "text": {
          "label": "Text",
          "description": "The text to classify",
          "required": true,
          "type": "multiline"
        },
        "model": {
          "label": "Model",
          "description": "The model to use for classification"
        },
        "threshold": {
          "label": "Threshold",
          "description": "Minimum confidence score for predictions",
          "type": "number"
        },
        "top_labels": {
          "label": "Top Labels",
          "description": "Maximum number of labels to return",
          "type": "number"
        },
        "refresh": {
          "label": "Refresh",
          "description": "Force refresh the classification",
          "type": "boolean",
          "defaultValue": "false"
        },
        "version": {
          "label": "Version",
          "description": "Model version to use"
        }
      },
      "request": {
        "method": "POST",
        "url": "https://api.metatext.ai/v2/classify/{{project_id}}",
        "body": {
          "text": "{{text}}",
          "model": "{{model}}",
          "options": {
            "threshold": "{{threshold}}",
            "top_labels": "{{top_labels}}",
            "version": "{{version}}"
          }
        }
      }
    }
  },
  "triggers": {}
}
