{
  "name": "griptape",
  "label": "Griptape Cloud",
  "description": "",
  "icon": "",
  "hosts": [
    "cloud.griptape.ai"
  ],
  "upstream": {
    "package": "@activepieces/piece-griptape",
    "version": "0.2.2"
  },
  "credential": {
    "fields": {
      "token": {
        "label": "API Key",
        "description": "",
        "secret": true,
        "required": true
      }
    },
    "headers": {
      "authorization": "Bearer {{credential.token}}"
    }
  },
  "actions": {
    "getAssistantRun": {
      "label": "Get Assistant Run",
      "description": "Get details of a specific assistant run",
      "inputs": {
        "assistant_id": {
          "label": "Assistant",
          "description": "Select the assistant",
          "required": true
        },
        "assistant_run_id": {
          "label": "Assistant Run",
          "description": "Select the assistant run",
          "required": true
        }
      },
      "request": {
        "method": "GET",
        "url": "https://cloud.griptape.ai/api/assistant-runs/{{assistant_run_id}}"
      }
    },
    "getStructureRun": {
      "label": "Get Structure Run",
      "description": "Get details of a specific structure run",
      "inputs": {
        "structure_id": {
          "label": "Structure",
          "description": "Select the structure",
          "required": true
        },
        "structure_run_id": {
          "label": "Structure Run",
          "description": "Select the structure run",
          "required": true
        }
      },
      "request": {
        "method": "GET",
        "url": "https://cloud.griptape.ai/api/structure-runs/{{structure_run_id}}"
      }
    }
  },
  "triggers": {}
}
