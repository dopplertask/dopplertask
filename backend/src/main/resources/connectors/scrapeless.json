{
  "name": "scrapeless",
  "label": "Scrapeless",
  "description": "Scrapeless is an all-in-one and highly scalable web scraping toolkit for enterprises and developers.",
  "icon": "",
  "hosts": [
    "api.scrapeless.com"
  ],
  "upstream": {
    "package": "@activepieces/piece-scrapeless",
    "version": "0.2.2"
  },
  "credential": {
    "fields": {
      "token": {
        "label": "API Key",
        "description": "You can obtain your API key from [Dashboard](https://app.scrapeless.com).",
        "secret": true,
        "required": true
      }
    },
    "headers": {
      "x-api-key": "{{credential.token}}"
    }
  },
  "actions": {
    "crawl_scrape": {
      "label": "Scrape Webpage Data",
      "description": "Extracts data from a single webpage.",
      "inputs": {
        "url": {
          "label": "URL to Crawl",
          "description": "The URL of the webpage to scrape.",
          "required": true
        }
      },
      "request": {
        "method": "POST",
        "url": "https://api.scrapeless.com/api/v1/crawler/scrape",
        "body": {
          "url": "{{url}}",
          "browserOptions": {
            "proxy_country": "ANY",
            "session_name": "Crawl",
            "session_recording": true,
            "session_ttl": 900
          }
        }
      }
    },
    "crawl_crawl": {
      "label": "Crawl Data from All Pages",
      "description": "Crawls a website and its linked pages to extract comprehensive data.",
      "inputs": {
        "url": {
          "label": "URL to Crawl",
          "description": "The URL of the webpage to crawl.",
          "required": true
        },
        "limit": {
          "label": "Limit",
          "description": "Number Of Subpages",
          "required": true,
          "type": "number",
          "defaultValue": "5"
        }
      },
      "request": {
        "method": "POST",
        "url": "https://api.scrapeless.com/api/v1/crawler/crawl",
        "body": {
          "url": "{{url}}",
          "browserOptions": {
            "proxy_country": "ANY",
            "session_name": "Crawl",
            "session_recording": true,
            "session_ttl": 900
          },
          "limit": "{{limit}}"
        }
      }
    }
  },
  "triggers": {}
}
